"""MCP tools for ABAP repository discovery operations."""

from typing import List, Dict, Any
from mcp.server.fastmcp import FastMCP
from pydantic import Field

from app.services.discovery_service import DiscoveryService


def register_discovery_tools(mcp: FastMCP, service_getter: Callable[[], DiscoveryService]):
    """
    Register discovery-related tools with the MCP server.

    Args:
        mcp: FastMCP server instance
        discovery_service: DiscoveryService instance for repository discovery operations
    """

    @mcp.tool(
        name="get_object_types",
        description="Get list of all ABAP object types available in the SAP repository. "
        "Returns type definitions, categories, and metadata for all supported object types "
        "(classes, programs, function groups, etc.).",
    )
    def get_object_types() -> List[Dict[str, Any]]:
        """
        Retrieve list of all ABAP object types.

        Returns a comprehensive list of object types supported by the SAP system,
        including classes, programs, function groups, interfaces, and more.

        Example usage:
        - get_object_types()
        """
        return service_getter().get_object_types()

    @mcp.tool(
        name="adt_discovery",
        description="Get ADT (ABAP Development Tools) discovery information. "
        "Returns capabilities, features, and endpoints available in the SAP system's ADT layer. "
        "Useful for understanding what operations are supported.",
    )
    def adt_discovery() -> Dict[str, Any]:
        """
        Retrieve ADT discovery information.

        Returns comprehensive information about ADT capabilities, including:
        - Available features
        - Supported operations
        - API endpoints
        - Version information

        Example usage:
        - adt_discovery()
        """
        return service_getter().adt_discovery()

    @mcp.tool(
        name="get_feature_details",
        description="Get detailed information about a specific ADT feature. "
        "Provides comprehensive details about feature capabilities, operations, and metadata. "
        "Common features: 'activation', 'transportchecks', 'syntax', 'prettyprinter'.",
    )
    def get_feature_details(
        feature_name: str = Field(
            description="Name of the ADT feature (e.g., 'activation', 'transportchecks', 'syntax', 'prettyprinter')"
        )
    ) -> Dict[str, Any]:
        """
        Retrieve detailed information about a specific ADT feature.

        Provides information about:
        - Feature capabilities
        - Supported operations
        - Configuration options
        - Version and availability

        Example usage:
        - get_feature_details("activation")
        - get_feature_details("transportchecks")
        - get_feature_details("syntax")
        """
        return service_getter().get_feature_details(feature_name)
