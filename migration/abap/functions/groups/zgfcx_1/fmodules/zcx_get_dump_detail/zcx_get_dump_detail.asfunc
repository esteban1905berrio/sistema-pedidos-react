FUNCTION ZCX_GET_DUMP_DETAIL
  IMPORTING
    VALUE(IV_DATUM) TYPE SNAP-DATUM OPTIONAL
    VALUE(IV_UZEIT) TYPE SNAP-UZEIT OPTIONAL
    VALUE(IV_UNAME) TYPE SNAP-UNAME OPTIONAL
    VALUE(IV_MANDT) TYPE SNAP-MANDT OPTIONAL
    VALUE(IV_AHOST) TYPE SNAP-AHOST OPTIONAL
    VALUE(IV_MODNO) TYPE SNAP-MODNO OPTIONAL
  EXPORTING
    VALUE(EV_SUCCESS) TYPE CHAR1
    VALUE(EV_MESSAGE) TYPE STRING
    VALUE(EV_DUMP_JSON) TYPE STRING.



  DATA: lt_ft         TYPE rsdump_ft_it,
        ls_ft         TYPE rsdump_ft,
        lv_datum      TYPE snap-datum,
        lv_uzeit      TYPE snap-uzeit,
        lv_uname      TYPE snap-uname,
        lv_mandt      TYPE snap-mandt,
        lv_ahost      TYPE snap-ahost,
        lv_modno      TYPE snap-modno.

  DATA: lv_error_id       TYPE string,
        lv_program        TYPE string,
        lv_include        TYPE string,
        lv_line           TYPE string,
        lv_tcode          TYPE string,
        lv_short_text     TYPE string,
        lv_what_happened  TYPE string,
        lv_error_analysis TYPE string,
        lv_how_to_fix     TYPE string,
        lv_exception_class TYPE string,
        lv_active_module  TYPE string,
        lv_event          TYPE string,
        lv_operation      TYPE string,
        lv_fm_name        TYPE string,
        lv_fm_param       TYPE string,
        lv_fm_param2      TYPE string,
        lv_fm_param4      TYPE string,
        lv_runtime_ts     TYPE string,
        lv_environment    TYPE string,
        lv_user_system    TYPE string,
        lv_exception_key  TYPE string,
        lv_debug_info     TYPE string,
        lt_call_stack     TYPE STANDARD TABLE OF string,
        lt_source_code    TYPE STANDARD TABLE OF string,
        lt_variables      TYPE STANDARD TABLE OF string,
        lt_programs       TYPE STANDARD TABLE OF string,
        lt_sys_vars       TYPE STANDARD TABLE OF string,
        lv_stack_line     TYPE string,
        lv_source_line    TYPE string,
        lv_var_line       TYPE string,
        lv_prg_line       TYPE string,
        lv_sys_line       TYPE string,
        lv_escaped        TYPE string,
        lv_last_var_name  TYPE string,
        lv_errid          TYPE snapt-errid.

  lv_datum = COND #( WHEN iv_datum IS INITIAL THEN sy-datum ELSE iv_datum ).
  lv_uzeit = COND #( WHEN iv_uzeit IS INITIAL THEN sy-uzeit ELSE iv_uzeit ).
  lv_uname = COND #( WHEN iv_uname IS INITIAL THEN sy-uname ELSE iv_uname ).
  lv_mandt = COND #( WHEN iv_mandt IS INITIAL THEN sy-mandt ELSE iv_mandt ).
  lv_ahost = COND #( WHEN iv_ahost IS INITIAL THEN sy-host ELSE iv_ahost ).
  lv_modno = COND #( WHEN iv_modno IS INITIAL THEN 0 ELSE iv_modno ).

  TRY.
      CALL FUNCTION 'RS_ST22_GET_FT'
        EXPORTING
          datum = lv_datum
          uzeit = lv_uzeit
          uname = lv_uname
          ahost = lv_ahost
          modno = lv_modno
          mandt = lv_mandt
        IMPORTING
          ft    = lt_ft.

      IF lt_ft IS INITIAL.
        ev_success = abap_false.
        ev_message = |No dump found for DATUM={ lv_datum } UZEIT={ lv_uzeit } USER={ lv_uname }|.
        RETURN.
      ENDIF.

      LOOP AT lt_ft INTO ls_ft.
        CASE ls_ft-id.
          WHEN 'FC'.
            lv_error_id = ls_ft-value.
            lv_errid = ls_ft-value.
          WHEN 'AP'.
            lv_program = ls_ft-value.
          WHEN 'AI'.
            lv_include = ls_ft-value.
          WHEN 'AL'.
            lv_line = ls_ft-value.
          WHEN 'TC'.
            lv_tcode = ls_ft-value.
          WHEN 'PS'.
            lv_short_text = ls_ft-value.
          WHEN 'XC'.
            lv_exception_class = ls_ft-value.
          WHEN 'XK'.
            lv_exception_key = ls_ft-value.
          WHEN 'DG'.
            lv_debug_info = ls_ft-value.
          WHEN 'AM'.
            lv_active_module = ls_ft-value.
          WHEN 'EV'.
            lv_event = ls_ft-value.
          WHEN 'OP'.
            lv_operation = ls_ft-value.
          WHEN 'P1'.
            lv_fm_name = ls_ft-value.
          WHEN 'P2'.
            lv_fm_param = ls_ft-value.
          WHEN 'P3'.
            IF lv_fm_param2 IS NOT INITIAL.
              lv_fm_param2 = lv_fm_param2 && `, ` && ls_ft-value.
            ELSE.
              lv_fm_param2 = ls_ft-value.
            ENDIF.
          WHEN 'P4'.
            lv_fm_param4 = ls_ft-value.
          WHEN 'RT'.
            lv_runtime_ts = ls_ft-value.
          WHEN 'EN'.
            lv_environment = ls_ft-value.
          WHEN 'US'.
            lv_user_system = ls_ft-value.
          WHEN 'W0' OR 'W1' OR 'W2' OR 'W3' OR 'W4'.
            IF lv_what_happened IS NOT INITIAL.
              lv_what_happened = lv_what_happened && ` ` && ls_ft-value.
            ELSE.
              lv_what_happened = ls_ft-value.
            ENDIF.
          WHEN 'W5' OR 'W6' OR 'W7' OR 'W8' OR 'W9'.
            IF lv_error_analysis IS NOT INITIAL.
              lv_error_analysis = lv_error_analysis && ` ` && ls_ft-value.
            ELSE.
              lv_error_analysis = ls_ft-value.
            ENDIF.
          WHEN 'ES'.
            lv_stack_line = ls_ft-value.
            APPEND lv_stack_line TO lt_call_stack.
          WHEN 'SO'.
            lv_source_line = ls_ft-value.
            APPEND lv_source_line TO lt_source_code.
          WHEN 'CO'.
            lv_source_line = ls_ft-value.
            APPEND lv_source_line TO lt_source_code.
          WHEN 'PG'.
            lv_prg_line = ls_ft-value.
            APPEND lv_prg_line TO lt_programs.
          WHEN 'SY'.
            lv_sys_line = ls_ft-value.
            APPEND lv_sys_line TO lt_sys_vars.
          WHEN 'N0' OR 'N1'.
            lv_last_var_name = ls_ft-value.
          WHEN 'V0' OR 'V1'.
            IF lv_last_var_name IS NOT INITIAL.
              lv_var_line = lv_last_var_name && `=` && ls_ft-value.
              APPEND lv_var_line TO lt_variables.
              CLEAR lv_last_var_name.
            ENDIF.
        ENDCASE.
      ENDLOOP.

      " Read texts from SNAPT table if not found in FT
      IF lv_errid IS NOT INITIAL.
        " Short Text (K = Kurztext)
        IF lv_short_text IS INITIAL.
          SELECT SINGLE tline INTO @DATA(lv_snapt_k)
            FROM snapt
            WHERE langu = @sy-langu
              AND ttype = 'K'
              AND errid = @lv_errid.
          IF sy-subrc = 0.
            lv_short_text = lv_snapt_k.
          ELSE.
            " Try English
            SELECT SINGLE tline INTO @lv_snapt_k
              FROM snapt
              WHERE langu = 'E'
                AND ttype = 'K'
                AND errid = @lv_errid.
            IF sy-subrc = 0.
              lv_short_text = lv_snapt_k.
            ENDIF.
          ENDIF.
        ENDIF.

        " What Happened (W = Explanation)
        IF lv_what_happened IS INITIAL.
          SELECT tline INTO TABLE @DATA(lt_snapt_w)
            FROM snapt
            WHERE langu = @sy-langu
              AND ttype = 'W'
              AND errid = @lv_errid.
          IF sy-subrc <> 0.
            SELECT tline INTO TABLE @lt_snapt_w
              FROM snapt
              WHERE langu = 'E'
                AND ttype = 'W'
                AND errid = @lv_errid.
          ENDIF.
          LOOP AT lt_snapt_w INTO DATA(lv_w_line).
            IF lv_what_happened IS INITIAL.
              lv_what_happened = lv_w_line.
            ELSE.
              lv_what_happened = lv_what_happened && ` ` &&  CONV string( lv_w_line ).
            ENDIF.
          ENDLOOP.
        ENDIF.

        " How to Fix (T = User hints)
        SELECT tline INTO TABLE @DATA(lt_snapt_t)
          FROM snapt
          WHERE langu = @sy-langu
            AND ttype = 'T'
            AND errid = @lv_errid.
        IF sy-subrc <> 0.
          SELECT tline INTO TABLE @lt_snapt_t
            FROM snapt
            WHERE langu = 'E'
              AND ttype = 'T'
              AND errid = @lv_errid.
        ENDIF.
        LOOP AT lt_snapt_t INTO DATA(lv_t_line).
          IF lv_how_to_fix IS INITIAL.
            lv_how_to_fix = lv_t_line.
          ELSE.
            lv_how_to_fix = lv_how_to_fix && ` ` && CONV string( lv_t_line ).
          ENDIF.
        ENDLOOP.

        " Error Analysis / Description (U)
        IF lv_error_analysis IS INITIAL.
          SELECT tline INTO TABLE @DATA(lt_snapt_u)
            FROM snapt
            WHERE langu = @sy-langu
              AND ttype = 'U'
              AND errid = @lv_errid.
          IF sy-subrc <> 0.
            SELECT tline INTO TABLE @lt_snapt_u
              FROM snapt
              WHERE langu = 'E'
                AND ttype = 'U'
                AND errid = @lv_errid.
          ENDIF.
          LOOP AT lt_snapt_u INTO DATA(lv_u_line).
            IF lv_error_analysis IS INITIAL.
              lv_error_analysis = lv_u_line.
            ELSE.
              lv_error_analysis = lv_error_analysis && ` ` && CONV string( lv_u_line ).
            ENDIF.
          ENDLOOP.
        ENDIF.
      ENDIF.

      " Fallback: Generate texts from available data
      IF lv_short_text IS INITIAL AND lv_exception_class IS NOT INITIAL.
        lv_short_text = lv_exception_class.
        REPLACE ALL OCCURRENCES OF `CX_SY_` IN lv_short_text WITH ``.
        REPLACE ALL OCCURRENCES OF `CX_` IN lv_short_text WITH ``.
        REPLACE ALL OCCURRENCES OF `_` IN lv_short_text WITH ` `.
      ENDIF.

      IF lv_what_happened IS INITIAL.
        IF lv_fm_name IS NOT INITIAL AND lv_fm_param IS NOT INITIAL.
          lv_what_happened = |Error calling function '{ lv_fm_name }' with parameter '{ lv_fm_param }'|.
          IF lv_fm_param4 IS NOT INITIAL.
            lv_what_happened = lv_what_happened && | (positions { lv_fm_param4 })|.
          ENDIF.
        ELSEIF lv_exception_class IS NOT INITIAL.
          lv_what_happened = |Exception { lv_exception_class } raised|.
          IF lv_operation IS NOT INITIAL.
            lv_what_happened = lv_what_happened && | during { lv_operation } operation|.
          ENDIF.
        ELSEIF lv_error_id IS NOT INITIAL.
          lv_what_happened = |Runtime error { lv_error_id } occurred|.
        ENDIF.
      ENDIF.

      IF lv_error_analysis IS INITIAL AND lv_exception_class IS NOT INITIAL.
        lv_error_analysis = |The system raised exception { lv_exception_class }|.
        IF lv_event IS NOT INITIAL.
          lv_error_analysis = lv_error_analysis && | at event { lv_event }|.
        ENDIF.
        IF lv_active_module IS NOT INITIAL.
          lv_error_analysis = lv_error_analysis && | in module { lv_active_module }|.
        ENDIF.
      ENDIF.

      ev_dump_json = `{`.
      ev_dump_json = ev_dump_json && `"datum":"` && lv_datum && `",`.
      ev_dump_json = ev_dump_json && `"uzeit":"` && lv_uzeit && `",`.
      ev_dump_json = ev_dump_json && `"uname":"` && lv_uname && `",`.
      ev_dump_json = ev_dump_json && `"mandt":"` && lv_mandt && `",`.
      ev_dump_json = ev_dump_json && `"ahost":"` && lv_ahost && `",`.

      lv_escaped = lv_error_id.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"runtimeError":"` && lv_escaped && `",`.

      lv_escaped = lv_program.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"program":"` && lv_escaped && `",`.

      lv_escaped = lv_include.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"include":"` && lv_escaped && `",`.

      ev_dump_json = ev_dump_json && `"line":"` && lv_line && `",`.

      lv_escaped = lv_tcode.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"transactionCode":"` && lv_escaped && `",`.

      lv_escaped = lv_short_text.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"shortText":"` && lv_escaped && `",`.

      lv_escaped = lv_exception_class.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"exceptionClass":"` && lv_escaped && `",`.

      lv_escaped = lv_exception_key.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"exceptionKey":"` && lv_escaped && `",`.

      lv_escaped = lv_debug_info.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"debugInfo":"` && lv_escaped && `",`.

      lv_escaped = lv_active_module.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"activeModule":"` && lv_escaped && `",`.

      lv_escaped = lv_event.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"event":"` && lv_escaped && `",`.

      lv_escaped = lv_operation.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"operation":"` && lv_escaped && `",`.

      lv_escaped = lv_fm_name.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"functionModule":"` && lv_escaped && `",`.

      lv_escaped = lv_fm_param.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"fmParameter":"` && lv_escaped && `",`.

      lv_escaped = lv_fm_param4.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"fmParamDetails":"` && lv_escaped && `",`.

      lv_escaped = lv_runtime_ts.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"runtimeTimestamp":"` && lv_escaped && `",`.

      lv_escaped = lv_what_happened.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"whatHappened":"` && lv_escaped && `",`.

      lv_escaped = lv_error_analysis.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"errorAnalysis":"` && lv_escaped && `",`.

      lv_escaped = lv_how_to_fix.
      REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
      REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
      ev_dump_json = ev_dump_json && `"howToFix":"` && lv_escaped && `",`.

      ev_dump_json = ev_dump_json && `"callStack":[`.
      DATA(lv_first) = abap_true.
      LOOP AT lt_call_stack INTO lv_stack_line.
        IF lv_first = abap_false.
          ev_dump_json = ev_dump_json && `,`.
        ENDIF.
        lv_escaped = lv_stack_line.
        REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
        REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
        ev_dump_json = ev_dump_json && `"` && lv_escaped && `"`.
        lv_first = abap_false.
      ENDLOOP.
      ev_dump_json = ev_dump_json && `],`.

      ev_dump_json = ev_dump_json && `"sourceCode":[`.
      lv_first = abap_true.
      LOOP AT lt_source_code INTO lv_source_line.
        IF lv_first = abap_false.
          ev_dump_json = ev_dump_json && `,`.
        ENDIF.
        lv_escaped = lv_source_line.
        REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
        REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
        ev_dump_json = ev_dump_json && `"` && lv_escaped && `"`.
        lv_first = abap_false.
      ENDLOOP.
      ev_dump_json = ev_dump_json && `],`.

      ev_dump_json = ev_dump_json && `"variables":[`.
      lv_first = abap_true.
      LOOP AT lt_variables INTO lv_var_line.
        IF lv_first = abap_false.
          ev_dump_json = ev_dump_json && `,`.
        ENDIF.
        lv_escaped = lv_var_line.
        REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
        REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
        ev_dump_json = ev_dump_json && `"` && lv_escaped && `"`.
        lv_first = abap_false.
      ENDLOOP.
      ev_dump_json = ev_dump_json && `],`.

      ev_dump_json = ev_dump_json && `"systemVariables":[`.
      lv_first = abap_true.
      LOOP AT lt_sys_vars INTO lv_sys_line.
        IF lv_first = abap_false.
          ev_dump_json = ev_dump_json && `,`.
        ENDIF.
        lv_escaped = lv_sys_line.
        REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
        REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
        ev_dump_json = ev_dump_json && `"` && lv_escaped && `"`.
        lv_first = abap_false.
      ENDLOOP.
      ev_dump_json = ev_dump_json && `],`.

      ev_dump_json = ev_dump_json && `"programs":[`.
      lv_first = abap_true.
      LOOP AT lt_programs INTO lv_prg_line.
        IF lv_first = abap_false.
          ev_dump_json = ev_dump_json && `,`.
        ENDIF.
        lv_escaped = lv_prg_line.
        REPLACE ALL OCCURRENCES OF `\` IN lv_escaped WITH `\\`.
        REPLACE ALL OCCURRENCES OF `"` IN lv_escaped WITH `\"`.
        ev_dump_json = ev_dump_json && `"` && lv_escaped && `"`.
        lv_first = abap_false.
      ENDLOOP.
      ev_dump_json = ev_dump_json && `],`.

      DATA(cant_entries) = lines( lt_ft ).
      ev_dump_json = ev_dump_json && `"totalFtEntries":` && cant_entries.
      ev_dump_json = ev_dump_json && `}`.

      ev_success = abap_true.
      ev_message = |Dump detail retrieved successfully. { lines( lt_ft ) } FT entries processed.|.

    CATCH cx_root INTO DATA(lx_error).
      ev_success = abap_false.
      ev_message = |Error reading dump: { lx_error->get_text( ) }|.
      ev_dump_json = `{}`.
  ENDTRY.

ENDFUNCTION.