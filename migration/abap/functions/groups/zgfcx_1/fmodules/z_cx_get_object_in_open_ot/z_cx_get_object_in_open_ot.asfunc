FUNCTION Z_CX_GET_OBJECT_IN_OPEN_OT
  IMPORTING
    VALUE(IV_OBJECT_NAME) TYPE STRING
    VALUE(IV_OBJECT_TYPE) TYPE STRING OPTIONAL
  EXPORTING
    VALUE(EV_SUCCESS) TYPE CHAR1
    VALUE(EV_MESSAGE) TYPE STRING
    VALUE(EV_RESULTS_JSON) TYPE STRING.



  " Local data declarations
  DATA: lt_e071         TYPE STANDARD TABLE OF e071,
        lt_e070         TYPE STANDARD TABLE OF e070,
        ls_e071         TYPE e071,
        ls_e070         TYPE e070,
        lv_search       TYPE string,
        lv_trkorr       TYPE trkorr,
        lv_json         TYPE string,
        lv_count        TYPE i,
        lt_unique_ot    TYPE STANDARD TABLE OF trkorr,
        ls_result       TYPE string,
        lt_results      TYPE STANDARD TABLE OF string,
        lv_obj_json     TYPE string,
        lv_transport_json TYPE string,
        lv_status_desc  TYPE string,
        lv_type_desc    TYPE string,
        lv_date_fmt     TYPE string,
        lv_time_fmt     TYPE string.

  FIELD-SYMBOLS: <fs_e071> TYPE e071,
                 <fs_e070> TYPE e070.

  TRY.
      " Build search pattern
      CONCATENATE '%' iv_object_name '%' INTO lv_search.

      " Step 1: Query E071 for objects matching name pattern
      " NOTE: We search ALL object types to include methods, definitions, etc.
      SELECT * FROM e071
        INTO TABLE lt_e071
        UP TO 1000 ROWS
        WHERE obj_name LIKE lv_search
        ORDER BY trkorr.

      IF sy-subrc <> 0.
        ev_success = 'X'.
        ev_message = 'No objects found in E071'.
        ev_results_json = '{"success":true,"objectName":"' && iv_object_name &&
                         '","searchPattern":"' && lv_search &&
                         '","transports":[],"totalTransports":0}'.
        RETURN.
      ENDIF.

      " Step 2: Get unique transport numbers and query E070
      CLEAR lt_unique_ot.
      LOOP AT lt_e071 INTO ls_e071.
        READ TABLE lt_unique_ot TRANSPORTING NO FIELDS WITH KEY table_line = ls_e071-trkorr.
        IF sy-subrc <> 0.
          APPEND ls_e071-trkorr TO lt_unique_ot.
        ENDIF.
      ENDLOOP.

      " Query E070 for all unique transports
      IF lt_unique_ot IS NOT INITIAL.
        SELECT * FROM e070
          INTO TABLE lt_e070
          FOR ALL ENTRIES IN lt_unique_ot
          WHERE trkorr = lt_unique_ot-table_line
            AND ( trstatus = 'D' OR trstatus = 'L' ). " Only open transports
      ENDIF.

      IF lt_e070 IS INITIAL.
        ev_success = 'X'.
        ev_message = 'Objects found but not in open transports'.
        ev_results_json = '{"success":true,"objectName":"' && iv_object_name &&
                         '","searchPattern":"' && lv_search &&
                         '","transports":[],"totalTransports":0}'.
        RETURN.
      ENDIF.

      " Step 3: Build JSON result
      CLEAR lt_results.
      lv_count = 0.

      LOOP AT lt_e070 INTO ls_e070.
        " Find corresponding E071 entry
        READ TABLE lt_e071 INTO ls_e071 WITH KEY trkorr = ls_e070-trkorr.
        IF sy-subrc <> 0.
          CONTINUE.
        ENDIF.

        " Map status description
        CASE ls_e070-trstatus.
          WHEN 'D'.
            lv_status_desc = 'Modifiable'.
          WHEN 'L'.
            lv_status_desc = 'Protected'.
          WHEN 'R'.
            lv_status_desc = 'Released'.
          WHEN OTHERS.
            lv_status_desc = ls_e070-trstatus.
        ENDCASE.

        " Map transport type description
        CASE ls_e070-trfunction.
          WHEN 'K'.
            lv_type_desc = 'Workbench'.
          WHEN 'S'.
            lv_type_desc = 'Task'.
          WHEN 'T'.
            lv_type_desc = 'Transport of Copies'.
          WHEN 'W'.
            lv_type_desc = 'Workbench Request'.
          WHEN OTHERS.
            lv_type_desc = ls_e070-trfunction.
        ENDCASE.

        " Format date: YYYYMMDD -> YYYY-MM-DD
        IF ls_e070-as4date IS NOT INITIAL.
          CONCATENATE ls_e070-as4date(4) '-' ls_e070-as4date+4(2) '-' ls_e070-as4date+6(2)
                      INTO lv_date_fmt.
        ELSE.
          lv_date_fmt = ''.
        ENDIF.

        " Format time: HHMMSS -> HH:MM:SS
        IF ls_e070-as4time IS NOT INITIAL.
          CONCATENATE ls_e070-as4time(2) ':' ls_e070-as4time+2(2) ':' ls_e070-as4time+4(2)
                      INTO lv_time_fmt.
        ELSE.
          lv_time_fmt = ''.
        ENDIF.

        " Build object info JSON
        lv_obj_json = '{"objName":"' && ls_e071-obj_name &&
                      '","objectType":"' && ls_e071-object &&
                      '","pgmid":"' && ls_e071-pgmid && '"}'.

        " Build transport JSON
        CONCATENATE '{"transportNumber":"' ls_e070-trkorr
                    '","transportType":"' ls_e070-trfunction
                    '","transportTypeDesc":"' lv_type_desc
                    '","status":"' ls_e070-trstatus
                    '","statusDesc":"' lv_status_desc
                    '","owner":"' ls_e070-as4user
                    '","createdDate":"' lv_date_fmt
                    '","createdTime":"' lv_time_fmt
                    '","isLocked":' INTO lv_transport_json SEPARATED BY space.

        IF ls_e071-lockflag = 'X'.
          CONCATENATE lv_transport_json 'true' INTO lv_transport_json.
        ELSE.
          CONCATENATE lv_transport_json 'false' INTO lv_transport_json.
        ENDIF.

        CONCATENATE lv_transport_json ',"objectInfo":' lv_obj_json
                    ',"parentTransport":null}' INTO lv_transport_json.

        APPEND lv_transport_json TO lt_results.
        lv_count = lv_count + 1.
      ENDLOOP.

      " Build final JSON array
      IF lt_results IS NOT INITIAL.
        CONCATENATE LINES OF lt_results INTO lv_json SEPARATED BY ','.
        ev_results_json = '{"success":true,"objectName":"' && iv_object_name &&
                    '","searchPattern":"' && lv_search &&
                    '","transports":[' && lv_json &&
                    '],"totalTransports":' && lv_count && '}'.
      ELSE.
        ev_results_json = '{"success":true,"objectName":"' && iv_object_name &&
                         '","searchPattern":"' && lv_search &&
                         '","transports":[],"totalTransports":0}'.
      ENDIF.

      ev_success = 'X'.
      ev_message = 'Query successful'.

    CATCH cx_root INTO DATA(lx_error).
      ev_success = ''.
      ev_message = lx_error->get_text( ).
      ev_results_json = '{"success":false,"error":"' && lx_error->get_text( ) && '"}'.
  ENDTRY.

ENDFUNCTION.