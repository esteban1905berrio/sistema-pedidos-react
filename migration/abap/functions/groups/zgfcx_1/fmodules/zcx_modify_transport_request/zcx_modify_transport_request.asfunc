FUNCTION ZCX_MODIFY_TRANSPORT_REQUEST
  IMPORTING
    VALUE(IV_OPERATION) TYPE STRING
    VALUE(IV_TRKORR) TYPE TRKORR
    VALUE(IV_DESCRIPTION) TYPE AS4TEXT OPTIONAL
    VALUE(IV_OBJECTS_JSON) TYPE STRING OPTIONAL
    VALUE(IV_CONFIRMED) TYPE CHAR1 OPTIONAL
  EXPORTING
    VALUE(EV_SUCCESS) TYPE CHAR1
    VALUE(EV_TRANSPORT_NUMBER) TYPE TRKORR
    VALUE(EV_TASK_NUMBER) TYPE TRKORR
    VALUE(EV_MESSAGE) TYPE STRING
    VALUE(EV_OBJECTS_ADDED) TYPE I
    VALUE(EV_TASKS_JSON) TYPE STRING.



*----------------------------------------------------------------------*
* Simplified interface: IV_TRKORR accepts both OT or Task numbers.
* The FM auto-detects the type from E070-TRFUNCTION:
*   'K' = Workbench OT (main transport)
*   'W' = Customizing OT
*   'S' = Task (subtask of an OT)
*
* For ADD_OBJECTS:
*   - If TASK passed: Objects are added directly to that task
*   - If OT passed: Finds user's modifiable task in that OT, or reports error
*   - Uses TR_APPEND_TO_COMM_OBJS_KEYS (assigns to task, not OT)
*   - Returns ob_locked_by_other if object is locked in another transport
*   - Supports DMEE objects: If not found in TADIR, searches DMEE_TREE
*   - Supports partial name matching with LIKE '%name%'
*
* For ADD_OBJECTS_FORCE:
*   - Same as ADD_OBJECTS but bypasses lock validation
*   - Uses TRINT_APPEND_COMM directly (no lock check)
*   - WARNING: Object will exist in multiple OTs if already locked elsewhere
*
* For RELEASE_TASK: Validates that IV_TRKORR is a task.
* For RELEASE_TRANSPORT: Validates that IV_TRKORR is an OT.
*----------------------------------------------------------------------*

  TYPES: BEGIN OF ty_object_input,
           pgmid    TYPE pgmid,
           object   TYPE trobjtype,
           obj_name TYPE sobj_name,
         END OF ty_object_input,
         tt_object_input TYPE STANDARD TABLE OF ty_object_input WITH DEFAULT KEY.

  TYPES: tt_tasks TYPE STANDARD TABLE OF trkorr WITH DEFAULT KEY.

  TYPES: BEGIN OF ty_tadir_result,
           pgmid    TYPE pgmid,
           object   TYPE trobjtype,
           obj_name TYPE sobj_name,
         END OF ty_tadir_result.

  TYPES: BEGIN OF ty_dmee_result,
           tree_type TYPE dmee_treetype,
           tree_id   TYPE dmee_treeid,
         END OF ty_dmee_result.

  DATA: lv_operation    TYPE string,
        lv_is_task      TYPE abap_bool,
        lv_is_ot        TYPE abap_bool,
        lv_main_ot      TYPE trkorr,
        lv_target_task  TYPE trkorr,
        lv_lock_trkorr  TYPE trkorr,
        lt_tasks        TYPE tt_tasks,
        ls_e070         TYPE e070,
        ls_e070_mod     TYPE e070,
        ls_e070_task    TYPE e070,
        ls_e07t         TYPE e07t,
        lt_e070         TYPE TABLE OF e070,
        lt_objects      TYPE tt_object_input,
        ls_object       TYPE ty_object_input,
        lv_count        TYPE i,
        lt_e071         TYPE tr_objects,
        ls_e071         TYPE e071,
        lt_e071k        TYPE tr_keys,
        ls_request      TYPE trwbo_request,
        lt_deleted      TYPE trwbo_t_e070,
        lt_messages     TYPE ctsgerrmsgs,
        ls_message      TYPE ctsgerrmsg,
        lv_error_text   TYPE string,
        lv_msg_description TYPE string,
        lv_locked_info  TYPE string,
        lv_search_pattern TYPE string,
        lv_dmee_obj_name  TYPE sobj_name,
        lt_tadir_results  TYPE TABLE OF ty_tadir_result,
        ls_tadir_result   TYPE ty_tadir_result,
        lt_dmee_results   TYPE TABLE OF ty_dmee_result,
        ls_dmee_result    TYPE ty_dmee_result,
        lv_objects_appended TYPE trpari-w_append,
        lv_keys_appended    TYPE trpari-w_append.

  " Initialize exports
  CLEAR: ev_success, ev_transport_number, ev_task_number,
         ev_message, ev_objects_added, ev_tasks_json.

  " Validate required parameter
  IF iv_trkorr IS INITIAL.
    ev_message = 'Transport/Task number (IV_TRKORR) is required'.
    RETURN.
  ENDIF.

  " Get transport/task info and detect type
  SELECT SINGLE * FROM e070 INTO ls_e070
    WHERE trkorr = iv_trkorr.
  IF sy-subrc <> 0.
    ev_message = |{ iv_trkorr } not found in system|.
    RETURN.
  ENDIF.

  " Detect if it's a task or main OT
  " TRFUNCTION: 'K'=Workbench OT, 'W'=Customizing OT, 'S'=Task
  IF ls_e070-trfunction = 'S'.
    lv_is_task = abap_true.
    lv_is_ot = abap_false.
    lv_main_ot = ls_e070-strkorr.  " Parent OT
  ELSE.
    lv_is_task = abap_false.
    lv_is_ot = abap_true.
    lv_main_ot = iv_trkorr.  " It's already the main OT
  ENDIF.

  lv_operation = to_upper( iv_operation ).

  CASE lv_operation.

*----------------------------------------------------------------------*
* ADD_OBJECTS: Add objects to transport TASK
* - If TASK passed: Objects are added directly to that task
* - If OT passed: Finds user's modifiable task in that OT
* - Uses TR_APPEND_TO_COMM_OBJS_KEYS (assigns to task, not OT)
* - Handles ob_locked_by_other to inform about lock conflicts
* - Supports DMEE objects (searches DMEE_TREE if not in TADIR)
* - Supports partial name matching with LIKE '%name%'
*----------------------------------------------------------------------*
    WHEN 'ADD_OBJECTS'.
      " Validate transport/task is modifiable
      IF ls_e070-trstatus <> 'D'.
        ev_message = |{ iv_trkorr } is not modifiable (status: { ls_e070-trstatus })|.
        RETURN.
      ENDIF.

      " Determine target task
      IF lv_is_task = abap_true.
        " Task was passed directly - use it
        lv_target_task = iv_trkorr.
      ELSE.
        " OT was passed - find user's modifiable task
        SELECT SINGLE * FROM e070 INTO ls_e070_task
          WHERE strkorr = iv_trkorr
            AND as4user = sy-uname
            AND trstatus = 'D'.
        IF sy-subrc <> 0.
          " No modifiable task found for current user
          " Check if there are any tasks at all
          SELECT COUNT(*) FROM e070
            WHERE strkorr = iv_trkorr
              AND trstatus = 'D'.
          IF sy-dbcnt > 0.
            ev_message = |No modifiable task found for user { sy-uname } in OT { iv_trkorr }. | &&
                         |There are { sy-dbcnt } task(s) owned by other users.|.
          ELSE.
            ev_message = |No modifiable tasks in OT { iv_trkorr }. All tasks may be released.|.
          ENDIF.
          RETURN.
        ENDIF.
        lv_target_task = ls_e070_task-trkorr.
      ENDIF.

      " Parse JSON objects
      /ui2/cl_json=>deserialize(
        EXPORTING
          json        = iv_objects_json
          pretty_name = /ui2/cl_json=>pretty_mode-camel_case
        CHANGING
          data        = lt_objects ).

      IF lt_objects IS INITIAL.
        ev_message = 'No valid objects found in JSON'.
        RETURN.
      ENDIF.

      " Process each object and build E071 table
      LOOP AT lt_objects INTO ls_object.
        IF ls_object-obj_name IS INITIAL.
          ev_message = 'Object name (obj_name) is required for each object'.
          RETURN.
        ENDIF.

        ls_object-obj_name = to_upper( ls_object-obj_name ).

        " Auto-detect PGMID/OBJECT from TADIR if not provided
        IF ls_object-pgmid IS INITIAL OR ls_object-object IS INITIAL.
          " Step 1: Exact match in TADIR
          SELECT SINGLE pgmid object FROM tadir
            INTO (ls_object-pgmid, ls_object-object)
            WHERE obj_name = ls_object-obj_name.

          IF sy-subrc <> 0.
            " Step 2: Partial match in TADIR (LIKE '%name%')
            lv_search_pattern = |%{ ls_object-obj_name }%|.
            CLEAR lt_tadir_results.
            SELECT pgmid object obj_name FROM tadir
              INTO TABLE lt_tadir_results
              UP TO 1 ROWS
              WHERE obj_name LIKE lv_search_pattern.

            IF lines( lt_tadir_results ) > 0.
              READ TABLE lt_tadir_results INTO ls_tadir_result INDEX 1.
              ls_object-pgmid    = ls_tadir_result-pgmid.
              ls_object-object   = ls_tadir_result-object.
              ls_object-obj_name = ls_tadir_result-obj_name.
            ELSE.
              " Step 3: Search in DMEE_TREE table for DMEE format trees
              " DMEE objects in TADIR have OBJ_NAME = TREE_TYPE + TREE_ID (concatenated)
              CLEAR lt_dmee_results.
              SELECT tree_type tree_id FROM dmee_tree
                INTO TABLE lt_dmee_results
                UP TO 1 ROWS
                WHERE tree_id LIKE lv_search_pattern.

              IF lines( lt_dmee_results ) > 0.
                READ TABLE lt_dmee_results INTO ls_dmee_result INDEX 1.
                " Found in DMEE_TREE - build TADIR OBJ_NAME
                " Format: TREE_TYPE (4 chars) + TREE_ID (up to 30 chars)
                lv_dmee_obj_name = ls_dmee_result-tree_type && ls_dmee_result-tree_id.
                CONDENSE lv_dmee_obj_name NO-GAPS.

                " Verify it exists in TADIR with type DMEE
                SELECT SINGLE pgmid object obj_name FROM tadir
                  INTO (ls_object-pgmid, ls_object-object, ls_object-obj_name)
                  WHERE pgmid = 'R3TR'
                    AND object = 'DMEE'
                    AND obj_name = lv_dmee_obj_name.

                IF sy-subrc <> 0.
                  " DMEE found in DMEE_TREE but not in TADIR - use defaults
                  ls_object-pgmid = 'R3TR'.
                  ls_object-object = 'DMEE'.
                  ls_object-obj_name = lv_dmee_obj_name.
                ENDIF.
              ELSE.
                " Not found anywhere - report error with search info
                ev_message = |Object { ls_object-obj_name } not found. | &&
                             |Searched: TADIR (exact), TADIR (LIKE '%{ ls_object-obj_name }%'), | &&
                             |DMEE_TREE (LIKE '%{ ls_object-obj_name }%')|.
                RETURN.
              ENDIF.
            ENDIF.
          ENDIF.
        ELSE.
          ls_object-pgmid  = to_upper( ls_object-pgmid ).
          ls_object-object = to_upper( ls_object-object ).
        ENDIF.

        " Build E071 entry
        CLEAR ls_e071.
        ls_e071-trkorr   = lv_target_task.
        ls_e071-pgmid    = ls_object-pgmid.
        ls_e071-object   = ls_object-object.
        ls_e071-obj_name = ls_object-obj_name.
        APPEND ls_e071 TO lt_e071.
      ENDLOOP.

      " Use TR_APPEND_TO_COMM_OBJS_KEYS to add objects to TASK
      " This FM accepts task number directly (unlike TR_REQUEST_CHOICE)
      CALL FUNCTION 'TR_APPEND_TO_COMM_OBJS_KEYS'
        EXPORTING
          wi_trkorr                   = lv_target_task
          wi_suppress_key_check       = 'X'
          iv_dialog                   = abap_false
        TABLES
          wt_e071                     = lt_e071
          wt_e071k                    = lt_e071k
        EXCEPTIONS
          ob_locked_by_other          = 1
          tr_enqueue_failed           = 2
          tr_not_owner                = 3
          tr_order_not_exist          = 4
          tr_order_released           = 5
          ob_check_obj_error          = 6
          ob_no_tadir                 = 7
          tr_lock_enqueue_failed      = 8
          OTHERS                      = 99.

      IF sy-subrc = 0.
        ev_success = 'X'.
        ev_transport_number = lv_main_ot.
        ev_task_number = lv_target_task.
        ev_objects_added = lines( lt_e071 ).
        " Include resolved object names in success message
        CLEAR lv_error_text.
        LOOP AT lt_e071 INTO ls_e071.
          IF lv_error_text IS NOT INITIAL.
            lv_error_text = lv_error_text && ', '.
          ENDIF.
          lv_error_text = lv_error_text && |{ ls_e071-object }:{ ls_e071-obj_name }|.
        ENDLOOP.
        ev_message = |{ ev_objects_added } object(s) added to task { lv_target_task }: { lv_error_text }|.
      ELSE.

        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
              INTO lv_error_text.

        CASE sy-subrc.
          WHEN 1. " ob_locked_by_other
            " Object is locked in another transport - search in E071 for existing locks
            CLEAR lv_locked_info.
            LOOP AT lt_e071 INTO ls_e071.
              " Find which transport has this object locked (in E071 with modifiable status)
              SELECT SINGLE e071~trkorr FROM e071
                INNER JOIN e070 ON e070~trkorr = e071~trkorr
                INTO lv_lock_trkorr
                WHERE e071~pgmid    = ls_e071-pgmid
                  AND e071~object   = ls_e071-object
                  AND e071~obj_name = ls_e071-obj_name
                  AND e070~trstatus = 'D'
                  AND e071~trkorr  <> lv_target_task.
              IF sy-subrc = 0.
                IF lv_locked_info IS NOT INITIAL.
                  lv_locked_info = lv_locked_info && ', '.
                ENDIF.
                lv_locked_info = lv_locked_info &&
                  |{ ls_e071-obj_name } locked in { lv_lock_trkorr }|.
              ENDIF.
            ENDLOOP.
            IF lv_locked_info IS INITIAL.
              lv_locked_info = |Object locked in another transport. Check SE03.|.
            ENDIF.
            ev_message = |Object(s) locked in another transport: { lv_locked_info }. | &&
                         |Use ADD_OBJECTS_FORCE to bypass lock check.|.
          WHEN 2.
            ev_message = |Enqueue failed for task { lv_target_task }|.
          WHEN 3.
            ev_message = |User { sy-uname } is not owner of task { lv_target_task }|.
          WHEN 4.
            ev_message = |Task { lv_target_task } does not exist|.
          WHEN 5.
            ev_message = |Task { lv_target_task } is already released|.
          WHEN 6.
            ev_message = |Object check error: { lv_error_text }|.
          WHEN 7.
            ev_message = |Object not found in TADIR: { sy-msgv1 }|.
          WHEN 8.
            ev_message = |Lock enqueue failed for task { lv_target_task }|.
          WHEN OTHERS.
            ev_message = |Error adding objects (RC:{ sy-subrc }): { lv_error_text }|.
        ENDCASE.
      ENDIF.

*----------------------------------------------------------------------*
* ADD_OBJECTS_FORCE: Add objects bypassing lock validation
* - Same object resolution as ADD_OBJECTS (TADIR/DMEE search)
* - Uses TRINT_APPEND_COMM directly (no lock check)
* - WARNING: Object will exist in multiple OTs if already locked elsewhere
* - Use when ADD_OBJECTS returns ob_locked_by_other error
*----------------------------------------------------------------------*
    WHEN 'ADD_OBJECTS_FORCE'.
      " Validate transport/task is modifiable
      IF ls_e070-trstatus <> 'D'.
        ev_message = |{ iv_trkorr } is not modifiable (status: { ls_e070-trstatus })|.
        RETURN.
      ENDIF.

      " Determine target task
      IF lv_is_task = abap_true.
        " Task was passed directly - use it
        lv_target_task = iv_trkorr.
      ELSE.
        " OT was passed - find user's modifiable task
        SELECT SINGLE * FROM e070 INTO ls_e070_task
          WHERE strkorr = iv_trkorr
            AND as4user = sy-uname
            AND trstatus = 'D'.
        IF sy-subrc <> 0.
          " No modifiable task found for current user
          SELECT COUNT(*) FROM e070
            WHERE strkorr = iv_trkorr
              AND trstatus = 'D'.
          IF sy-dbcnt > 0.
            ev_message = |No modifiable task found for user { sy-uname } in OT { iv_trkorr }. | &&
                         |There are { sy-dbcnt } task(s) owned by other users.|.
          ELSE.
            ev_message = |No modifiable tasks in OT { iv_trkorr }. All tasks may be released.|.
          ENDIF.
          RETURN.
        ENDIF.
        lv_target_task = ls_e070_task-trkorr.
      ENDIF.

      " Parse JSON objects
      /ui2/cl_json=>deserialize(
        EXPORTING
          json        = iv_objects_json
          pretty_name = /ui2/cl_json=>pretty_mode-camel_case
        CHANGING
          data        = lt_objects ).

      IF lt_objects IS INITIAL.
        ev_message = 'No valid objects found in JSON'.
        RETURN.
      ENDIF.

      " Process each object and build E071 table (same logic as ADD_OBJECTS)
      LOOP AT lt_objects INTO ls_object.
        IF ls_object-obj_name IS INITIAL.
          ev_message = 'Object name (obj_name) is required for each object'.
          RETURN.
        ENDIF.

        ls_object-obj_name = to_upper( ls_object-obj_name ).

        " Auto-detect PGMID/OBJECT from TADIR if not provided
        IF ls_object-pgmid IS INITIAL OR ls_object-object IS INITIAL.
          " Step 1: Exact match in TADIR
          SELECT SINGLE pgmid object FROM tadir
            INTO (ls_object-pgmid, ls_object-object)
            WHERE obj_name = ls_object-obj_name.

          IF sy-subrc <> 0.
            " Step 2: Partial match in TADIR (LIKE '%name%')
            lv_search_pattern = |%{ ls_object-obj_name }%|.
            CLEAR lt_tadir_results.
            SELECT pgmid object obj_name FROM tadir
              INTO TABLE lt_tadir_results
              UP TO 1 ROWS
              WHERE obj_name LIKE lv_search_pattern.

            IF lines( lt_tadir_results ) > 0.
              READ TABLE lt_tadir_results INTO ls_tadir_result INDEX 1.
              ls_object-pgmid    = ls_tadir_result-pgmid.
              ls_object-object   = ls_tadir_result-object.
              ls_object-obj_name = ls_tadir_result-obj_name.
            ELSE.
              " Step 3: Search in DMEE_TREE table for DMEE format trees
              CLEAR lt_dmee_results.
              SELECT tree_type tree_id FROM dmee_tree
                INTO TABLE lt_dmee_results
                UP TO 1 ROWS
                WHERE tree_id LIKE lv_search_pattern.

              IF lines( lt_dmee_results ) > 0.
                READ TABLE lt_dmee_results INTO ls_dmee_result INDEX 1.
                lv_dmee_obj_name = ls_dmee_result-tree_type && ls_dmee_result-tree_id.
                CONDENSE lv_dmee_obj_name NO-GAPS.

                SELECT SINGLE pgmid object obj_name FROM tadir
                  INTO (ls_object-pgmid, ls_object-object, ls_object-obj_name)
                  WHERE pgmid = 'R3TR'
                    AND object = 'DMEE'
                    AND obj_name = lv_dmee_obj_name.

                IF sy-subrc <> 0.
                  ls_object-pgmid = 'R3TR'.
                  ls_object-object = 'DMEE'.
                  ls_object-obj_name = lv_dmee_obj_name.
                ENDIF.
              ELSE.
                ev_message = |Object { ls_object-obj_name } not found. | &&
                             |Searched: TADIR (exact), TADIR (LIKE '%{ ls_object-obj_name }%'), | &&
                             |DMEE_TREE (LIKE '%{ ls_object-obj_name }%')|.
                RETURN.
              ENDIF.
            ENDIF.
          ENDIF.
        ELSE.
          ls_object-pgmid  = to_upper( ls_object-pgmid ).
          ls_object-object = to_upper( ls_object-object ).
        ENDIF.

        " Build E071 entry - IMPORTANT: Set LOCKFLAG = space to avoid lock issues
        CLEAR ls_e071.
        ls_e071-trkorr   = lv_target_task.
        ls_e071-pgmid    = ls_object-pgmid.
        ls_e071-object   = ls_object-object.
        ls_e071-obj_name = ls_object-obj_name.
        ls_e071-lockflag = space.  " No lock - bypass lock validation
        APPEND ls_e071 TO lt_e071.
      ENDLOOP.

      " Use TRINT_APPEND_COMM directly - NO lock validation
      " This is the internal FM that TRINT_COPY_COMM uses
      " wi_exclusive = 'X' prevents duplicate entries
      CALL FUNCTION 'TRINT_APPEND_COMM'
        EXPORTING
          wi_exclusive                  = 'X'
          wi_sel_e071                   = 'X'
          wi_sel_e071k                  = ' '
          wi_trkorr                     = lv_target_task
        IMPORTING
          we_objects_physical_appended  = lv_objects_appended
          we_keys_physical_appended     = lv_keys_appended
        TABLES
          wt_e071                       = lt_e071
          wt_e071k                      = lt_e071k
        EXCEPTIONS
          e071k_append_error            = 1
          e071_append_error             = 2
          trkorr_empty                  = 3
          OTHERS                        = 99.

      IF sy-subrc = 0.
        ev_success = 'X'.
        ev_transport_number = lv_main_ot.
        ev_task_number = lv_target_task.
        ev_objects_added = lines( lt_e071 ).

        " Build success message with resolved object names
        CLEAR lv_error_text.
        LOOP AT lt_e071 INTO ls_e071.
          IF lv_error_text IS NOT INITIAL.
            lv_error_text = lv_error_text && ', '.
          ENDIF.
          lv_error_text = lv_error_text && |{ ls_e071-object }:{ ls_e071-obj_name }|.
        ENDLOOP.

        IF lv_objects_appended = 'X'.
          ev_message = |{ ev_objects_added } object(s) FORCE-added to task { lv_target_task }: { lv_error_text }. | &&
                       |WARNING: Objects may exist in other OTs - no lock validation performed.|.
        ELSE.
          ev_message = |Objects already exist in task { lv_target_task } (no duplicates added): { lv_error_text }|.
        ENDIF.

        " Update E070 timestamp (as TRINT_COPY_COMM does)
        UPDATE e070 SET as4date = sy-datum
                        as4time = sy-uzeit
                        as4user = sy-uname
          WHERE trkorr = lv_target_task.
        COMMIT WORK.
      ELSE.
        CASE sy-subrc.
          WHEN 1.
            ev_message = |E071K append error for task { lv_target_task }|.
          WHEN 2.
            ev_message = |E071 append error for task { lv_target_task }|.
          WHEN 3.
            ev_message = |Task number is empty|.
          WHEN OTHERS.
            MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
              INTO lv_error_text.
            ev_message = |Force-add failed (RC:{ sy-subrc }): { lv_error_text }|.
        ENDCASE.
      ENDIF.

*----------------------------------------------------------------------*
* MODIFY_DESCRIPTION: Change transport/task description
* - Accepts OT or Task number
* - Uses TRINT_MODIFY_COMM with E070/E07T structures
*----------------------------------------------------------------------*
    WHEN 'MODIFY_DESCRIPTION'.
      IF ls_e070-trstatus <> 'D'.
        ev_message = |{ iv_trkorr } is not modifiable|.
        RETURN.
      ENDIF.

      " Prepare E070 structure for modification
      ls_e070_mod = ls_e070.

      " Prepare E07T structure with new description
      CLEAR ls_e07t.
      ls_e07t-trkorr   = iv_trkorr.
      ls_e07t-langu    = sy-langu.
      ls_e07t-as4text  = iv_description.

      " Call TRINT_MODIFY_COMM with correct structures
      " WI_SEL_E07T = 'X' indicates we want to update description
      CALL FUNCTION 'TRINT_MODIFY_COMM'
        EXPORTING
          wi_e070      = ls_e070_mod
          wi_e07t      = ls_e07t
          wi_sel_e07t  = 'X'
        EXCEPTIONS
          OTHERS       = 1.

      IF sy-subrc = 0.
        ev_success = 'X'.
        IF lv_is_task = abap_true.
          ev_task_number = iv_trkorr.
          ev_transport_number = lv_main_ot.
        ELSE.
          ev_transport_number = iv_trkorr.
        ENDIF.
        ev_message = |Description updated for { iv_trkorr }|.
      ELSE.
        ev_message = |Error modifying description (RC: { sy-subrc })|.
      ENDIF.

*----------------------------------------------------------------------*
* RELEASE_TASK: Release a single task
* - Validates that IV_TRKORR is a task (not an OT)
* - Uses TRINT_RELEASE_REQUEST for detailed error messages
*----------------------------------------------------------------------*
    WHEN 'RELEASE_TASK'.
      IF lv_is_ot = abap_true.
        ev_message = |{ iv_trkorr } is an OT, not a task. Use RELEASE_TRANSPORT instead.|.
        RETURN.
      ENDIF.

      IF ls_e070-trstatus = 'R'.
        ev_message = |Task { iv_trkorr } is already released|.
        RETURN.
      ENDIF.

      " Use TRINT_RELEASE_REQUEST to get detailed error messages
      CLEAR: lt_messages, ls_request, lt_deleted.
      CALL FUNCTION 'TRINT_RELEASE_REQUEST'
        EXPORTING
          iv_trkorr                   = iv_trkorr
          iv_dialog                   = abap_false
          iv_success_message          = abap_false
          iv_without_objects_check    = abap_true
          iv_without_locking          = abap_true
          iv_ignore_warnings          = abap_true
        IMPORTING
          es_request                  = ls_request
          et_deleted_tasks            = lt_deleted
          et_messages                 = lt_messages
        EXCEPTIONS
          cts_initialization_failure  = 1
          enqueue_failed              = 2
          no_authorization            = 3
          invalid_request             = 4
          request_already_released    = 5
          repeat_too_early            = 6
          object_lock_error           = 7
          object_check_error          = 8
          docu_missing                = 9
          db_access_error             = 10
          action_aborted_by_user      = 11
          export_failed               = 12
          execute_objects_check       = 13
          release_in_bg_mode          = 14
          release_in_bg_mode_w_objchk = 15
          error_in_export_methods     = 16
          object_lang_error           = 17
          OTHERS                      = 99.

      IF sy-subrc = 0.
        ev_success = 'X'.
        ev_task_number = iv_trkorr.
        ev_transport_number = lv_main_ot.
        ev_message = |Task { iv_trkorr } released successfully|.
      ELSE.
        " Build detailed error message from ET_MESSAGES
        CLEAR lv_error_text.
        LOOP AT lt_messages INTO ls_message WHERE msgty CA 'EAX'.
          IF lv_error_text IS NOT INITIAL.
            lv_error_text = lv_error_text && '; '.
          ENDIF.
          " Format: [MSGID-MSGNO] Object: MSG
          lv_error_text = lv_error_text &&
            |[{ ls_message-msgid }-{ ls_message-msgno }]|.
          IF ls_message-k_objname IS NOT INITIAL.
            lv_error_text = lv_error_text &&
              | { ls_message-k_object }:{ ls_message-k_objname }|.
          ENDIF.

          MESSAGE ID ls_message-msgid TYPE ls_message-msgty NUMBER ls_message-msgno
            WITH ls_message-msgv1 ls_message-msgv2 ls_message-msgv3 ls_message-msgv4
            INTO lv_msg_description.

          lv_error_text = lv_error_text && | { lv_msg_description }|.
        ENDLOOP.

        " Fallback to sy-msg if no messages collected
        IF lv_error_text IS INITIAL.
          MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
            INTO lv_error_text.
        ENDIF.

        ev_message = |Release failed (RC:{ sy-subrc }): { lv_error_text }|.
      ENDIF.

*----------------------------------------------------------------------*
* GET_TASKS_FOR_RELEASE: Get modifiable tasks of an OT
* - Accepts OT or Task (if task, uses parent OT)
*----------------------------------------------------------------------*
    WHEN 'GET_TASKS_FOR_RELEASE'.
      SELECT trkorr FROM e070 INTO TABLE lt_tasks
        WHERE strkorr = lv_main_ot
          AND trstatus = 'D'.

      ev_success = 'X'.
      ev_transport_number = lv_main_ot.

      IF lt_tasks IS INITIAL.
        ev_message = |No modifiable tasks found for { lv_main_ot }|.
        ev_tasks_json = '[]'.
      ELSE.
        ev_tasks_json = /ui2/cl_json=>serialize(
          data        = lt_tasks
          pretty_name = /ui2/cl_json=>pretty_mode-low_case ).
        ev_message = |{ lines( lt_tasks ) } task(s) pending release|.
      ENDIF.

*----------------------------------------------------------------------*
* RELEASE_TRANSPORT: Release OT with all child tasks
* - Validates that IV_TRKORR is an OT (not a task)
* - Requires confirmation (IV_CONFIRMED = 'X')
* - Uses TRINT_RELEASE_REQUEST for detailed error messages
*----------------------------------------------------------------------*
    WHEN 'RELEASE_TRANSPORT'.
      IF lv_is_task = abap_true.
        ev_message = |{ iv_trkorr } is a task, not an OT. Use RELEASE_TASK instead.|.
        RETURN.
      ENDIF.

      IF iv_confirmed <> 'X'.
        ev_message = 'Confirmation required. Call with IV_CONFIRMED = X'.
        RETURN.
      ENDIF.

      " Get all modifiable tasks
      SELECT * FROM e070 INTO TABLE lt_e070
        WHERE strkorr = iv_trkorr
          AND trstatus = 'D'.

      CLEAR lt_tasks.
      lv_count = 0.

      " Release each task first using TRINT_RELEASE_REQUEST
      LOOP AT lt_e070 INTO ls_e070.
        CLEAR: lt_messages, ls_request.
        CALL FUNCTION 'TRINT_RELEASE_REQUEST'
          EXPORTING
            iv_trkorr                   = ls_e070-trkorr
            iv_dialog                   = abap_false
            iv_success_message          = abap_false
          IMPORTING
            es_request                  = ls_request
            et_messages                 = lt_messages
          EXCEPTIONS
            OTHERS                      = 99.

        IF sy-subrc = 0.
          lv_count = lv_count + 1.
          APPEND ls_e070-trkorr TO lt_tasks.
        ELSE.
          " Collect error for this task
          CLEAR lv_error_text.
          LOOP AT lt_messages INTO ls_message WHERE msgty CA 'EAX'.
            IF lv_error_text IS NOT INITIAL.
              lv_error_text = lv_error_text && '; '.
            ENDIF.
            lv_error_text = lv_error_text &&
              |[{ ls_message-msgid }-{ ls_message-msgno }]|.
            IF ls_message-k_objname IS NOT INITIAL.
              lv_error_text = lv_error_text &&
                | { ls_message-k_object }:{ ls_message-k_objname }|.
            ENDIF.
            lv_error_text = lv_error_text &&
              | { ls_message-msgv1 } { ls_message-msgv2 }|.
          ENDLOOP.

          IF lv_error_text IS INITIAL.
            MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
              INTO lv_error_text.
          ENDIF.

          " Report task release failure but continue with others
          ev_message = |Task { ls_e070-trkorr } failed: { lv_error_text }|.
        ENDIF.
      ENDLOOP.

      " Refresh OT status
      SELECT SINGLE * FROM e070 INTO ls_e070
        WHERE trkorr = iv_trkorr.

      " Release main OT
      IF ls_e070-trstatus = 'D'.
        CLEAR: lt_messages, ls_request.
        CALL FUNCTION 'TRINT_RELEASE_REQUEST'
          EXPORTING
            iv_trkorr                   = iv_trkorr
            iv_dialog                   = abap_false
            iv_success_message          = abap_false
          IMPORTING
            es_request                  = ls_request
            et_messages                 = lt_messages
          EXCEPTIONS
            OTHERS                      = 99.

        IF sy-subrc = 0.
          ev_success = 'X'.
          ev_transport_number = iv_trkorr.
          ev_tasks_json = /ui2/cl_json=>serialize(
            data        = lt_tasks
            pretty_name = /ui2/cl_json=>pretty_mode-low_case ).
          ev_message = |OT { iv_trkorr } released with { lv_count } task(s)|.
        ELSE.
          " Build detailed error message
          CLEAR lv_error_text.
          LOOP AT lt_messages INTO ls_message WHERE msgty CA 'EAX'.
            IF lv_error_text IS NOT INITIAL.
              lv_error_text = lv_error_text && '; '.
            ENDIF.
            lv_error_text = lv_error_text &&
              |[{ ls_message-msgid }-{ ls_message-msgno }]|.
            IF ls_message-k_objname IS NOT INITIAL.
              lv_error_text = lv_error_text &&
                | { ls_message-k_object }:{ ls_message-k_objname }|.
            ENDIF.
            lv_error_text = lv_error_text &&
              | { ls_message-msgv1 } { ls_message-msgv2 } { ls_message-msgv3 } { ls_message-msgv4 }|.
          ENDLOOP.

          IF lv_error_text IS INITIAL.
            MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
              INTO lv_error_text.
          ENDIF.

          ev_tasks_json = /ui2/cl_json=>serialize(
            data        = lt_tasks
            pretty_name = /ui2/cl_json=>pretty_mode-low_case ).
          ev_message = |Tasks released ({ lv_count }) but OT failed: { lv_error_text }|.
        ENDIF.
      ELSE.
        ev_success = 'X'.
        ev_transport_number = iv_trkorr.
        ev_tasks_json = /ui2/cl_json=>serialize(
          data        = lt_tasks
          pretty_name = /ui2/cl_json=>pretty_mode-low_case ).
        ev_message = |{ lv_count } task(s) released. OT was already released.|.
      ENDIF.

    WHEN OTHERS.
      ev_message = |Unknown operation: { iv_operation }. Valid: ADD_OBJECTS, ADD_OBJECTS_FORCE, MODIFY_DESCRIPTION, RELEASE_TASK, GET_TASKS_FOR_RELEASE, RELEASE_TRANSPORT|.

  ENDCASE.

ENDFUNCTION.