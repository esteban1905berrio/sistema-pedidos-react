FUNCTION Z_CX_GET_PACKAGE_HIERARCHY
  IMPORTING
    VALUE(IV_PACKAGE_NAME) TYPE DEVCLASS
    VALUE(IV_MODE) TYPE CHAR1 DEFAULT 'C'
    VALUE(IV_RECURSIVE) TYPE CHAR1 DEFAULT ''
  EXPORTING
    VALUE(EV_SUCCESS) TYPE CHAR1
    VALUE(EV_MESSAGE) TYPE STRING
    VALUE(EV_HIERARCHY_JSON) TYPE STRING
  EXCEPTIONS
    PACKAGE_NOT_FOUND
    QUERY_ERROR.



  TYPES: BEGIN OF ty_package,
           devclass TYPE devclass,
           parentcl TYPE devclass,
           ctext    TYPE tdevc-ctext,
           level    TYPE i,
         END OF ty_package.

  DATA: lt_packages      TYPE STANDARD TABLE OF ty_package,
        lt_all_packages  TYPE STANDARD TABLE OF ty_package,
        lt_temp_packages TYPE STANDARD TABLE OF ty_package,
        ls_package       TYPE ty_package,
        lv_json          TYPE string,
        lv_package_json  TYPE string,
        lv_current_pkg   TYPE devclass,
        lv_level         TYPE i,
        lv_count         TYPE i,
        lv_first         TYPE abap_bool VALUE abap_true,
        lv_check         TYPE devclass,
        lv_has_children  TYPE abap_bool,
        lv_mode_desc     TYPE string,
        lv_recursive_str TYPE string.

  CLEAR: ev_success, ev_message, ev_hierarchy_json.

  " Validate input
  IF iv_package_name IS INITIAL.
    ev_success = ''.
    ev_message = 'Package name required'.
    ev_hierarchy_json = '{"success":false,"error":"Package name required"}'.
    RETURN.
  ENDIF.

  " Verify package exists
  SELECT SINGLE devclass
    FROM tdevc
    INTO @lv_check
    WHERE devclass = @iv_package_name.

  IF sy-subrc <> 0.
    RAISE package_not_found.
  ENDIF.

  " MODE: Children
  IF iv_mode = 'C'.
    lv_mode_desc = 'children'.

    " Get direct children
    SELECT devclass, parentcl, ctext
      FROM tdevc
      INTO CORRESPONDING FIELDS OF TABLE @lt_packages
      WHERE parentcl = @iv_package_name.

    IF sy-subrc = 0.
      " Assign level 1
      LOOP AT lt_packages ASSIGNING FIELD-SYMBOL(<fs_pkg>).
        <fs_pkg>-level = 1.
      ENDLOOP.

      APPEND LINES OF lt_packages TO lt_all_packages.

      " Recursive mode
      IF iv_recursive = 'X'.
        lv_level = 1.
        CLEAR lt_temp_packages.

        WHILE lt_packages IS NOT INITIAL.
          CLEAR lt_temp_packages.

          " For each package at current level, find its children
          LOOP AT lt_packages INTO ls_package.
            SELECT devclass, parentcl, ctext
              FROM tdevc
              APPENDING CORRESPONDING FIELDS OF TABLE @lt_temp_packages
              WHERE parentcl = @ls_package-devclass.
          ENDLOOP.

          IF lt_temp_packages IS INITIAL.
            EXIT.
          ENDIF.

          " Assign next level
          lv_level = lv_level + 1.
          LOOP AT lt_temp_packages ASSIGNING <fs_pkg>.
            <fs_pkg>-level = lv_level.
          ENDLOOP.

          " Add children to result
          APPEND LINES OF lt_temp_packages TO lt_all_packages.

          " Move to next level
          lt_packages = lt_temp_packages.
        ENDWHILE.
      ENDIF.
    ENDIF.

  " MODE: Parents
  ELSEIF iv_mode = 'P'.
    lv_mode_desc = 'parents'.
    lv_current_pkg = iv_package_name.
    lv_level = 1.

    " Navigate up the hierarchy
    WHILE lv_current_pkg IS NOT INITIAL.
      SELECT SINGLE devclass, parentcl, ctext
        FROM tdevc
        INTO CORRESPONDING FIELDS OF @ls_package
        WHERE devclass = @lv_current_pkg.

      IF sy-subrc <> 0.
        EXIT.
      ENDIF.

      " Only add parent (not the starting package)
      IF lv_current_pkg <> iv_package_name.
        ls_package-level = lv_level.
        APPEND ls_package TO lt_all_packages.
        lv_level = lv_level + 1.
      ENDIF.

      " Move to parent
      lv_current_pkg = ls_package-parentcl.

      " Exit if no parent or non-recursive
      IF lv_current_pkg IS INITIAL OR iv_recursive <> 'X'.
        EXIT.
      ENDIF.
    ENDWHILE.

  ELSE.
    ev_success = ''.
    ev_message = |Invalid mode: { iv_mode }. Use 'C' or 'P'|.
    ev_hierarchy_json = |\{"success":false,"error":"Invalid mode { iv_mode }"\}|.
    RETURN.
  ENDIF.

  " Build JSON
  lv_recursive_str = COND string( WHEN iv_recursive = 'X' THEN 'true' ELSE 'false' ).
  lv_count = lines( lt_all_packages ).

  lv_json = |\{| &&
            |"success":true,| &&
            |"mode":"{ lv_mode_desc }",| &&
            |"recursive":{ lv_recursive_str },| &&
            |"packageName":"{ iv_package_name }",| &&
            |"hierarchy":[|.

  LOOP AT lt_all_packages INTO ls_package.
    IF lv_first = abap_false.
      lv_json = lv_json && ','.
    ENDIF.

    " Check if package has children
    SELECT SINGLE devclass
      FROM tdevc
      INTO @lv_check
      WHERE parentcl = @ls_package-devclass.

    lv_has_children = COND abap_bool( WHEN sy-subrc = 0 THEN abap_true ELSE abap_false ).

    " Build package JSON object
    lv_package_json = |\{| &&
                      |"packageName":"{ ls_package-devclass }",| &&
                      |"parentPackage":"{ ls_package-parentcl }",| &&
                      |"description":"{ escape( val = ls_package-ctext format = cl_abap_format=>e_json_string ) }",| &&
                      |"level":{ ls_package-level },| &&
                      |"hasChildren":{ COND string( WHEN lv_has_children = abap_true THEN 'true' ELSE 'false' ) }| &&
                      |\}|.

    lv_json = lv_json && lv_package_json.
    lv_first = abap_false.
  ENDLOOP.

  lv_json = lv_json && |],| &&
            |"totalPackages":{ lv_count }| &&
            |\}|.

  " Return success
  ev_success = 'X'.
  ev_message = 'Query successful'.
  ev_hierarchy_json = lv_json.

ENDFUNCTION.