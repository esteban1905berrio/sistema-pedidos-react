# Python requirements files
requirements*.txt text eol=lf

# Python source files
*.py text eol=lf diff=python

# Shell scripts
*.sh text eol=lf

# Configuration files
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.env* text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Exclude files from exporting
.gitattributes export-ignore
.gitignore export-ignore
