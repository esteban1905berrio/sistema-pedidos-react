FUNCTION ZCX_UTIL_GET_BADI_IMPL
  IMPORTING
    VALUE(IV_IMP_NAME) TYPE STRING
    VALUE(IV_MAX_RESULTS) TYPE I DEFAULT 100
  EXPORTING
    VALUE(EV_HEADER_JSON) TYPE STRING
    VALUE(EV_DEFINITIONS_JSON) TYPE STRING
    VALUE(EV_CLASSES_JSON) TYPE STRING
    VALUE(EV_RESULTS_JSON) TYPE STRING
    VALUE(EV_RCODE) TYPE CHAR1
    VALUE(EV_MESSAGE) TYPE STRING.



  TYPES: BEGIN OF ty_header,
           imp_name      TYPE exit_imp,
           description   TYPE cus_text,
           active        TYPE abap_bool,
           devclass      TYPE devclass,
           author        TYPE unam,
           created_on    TYPE datum,
           changed_by    TYPE unam,
           changed_on    TYPE datum,
           mig_enhname   TYPE enhname,
         END OF ty_header.

  TYPES: BEGIN OF ty_definition,
           badi_name        TYPE exit_def,
           description      TYPE cus_text,
           filter_value     TYPE filtname,
           interfaces       TYPE string_table,
           multiple_use     TYPE abap_bool,
           filter_dependent TYPE abap_bool,
         END OF ty_definition,
         tt_definitions TYPE STANDARD TABLE OF ty_definition WITH DEFAULT KEY.

  TYPES: BEGIN OF ty_class,
           interface_name TYPE seoitfname,
           class_name     TYPE seoclsname,
         END OF ty_class,
         tt_classes TYPE STANDARD TABLE OF ty_class WITH DEFAULT KEY.

  TYPES: BEGIN OF ty_search_result,
           imp_name    TYPE exit_imp,
           active      TYPE abap_bool,
           devclass    TYPE devclass,
         END OF ty_search_result,
         tt_search_results TYPE STANDARD TABLE OF ty_search_result WITH DEFAULT KEY.

  DATA: ls_header      TYPE ty_header,
        lt_definitions TYPE tt_definitions,
        lt_classes     TYPE tt_classes,
        lt_results     TYPE tt_search_results,
        ls_result      TYPE ty_search_result,
        lv_pattern     TYPE string,
        lv_imp_name    TYPE exit_imp,
        lv_is_wildcard TYPE abap_bool.

  DATA: ls_sxc_attr  TYPE sxc_attr,
        ls_sxc_attrt TYPE sxc_attrt,
        lt_sxc_exit  TYPE STANDARD TABLE OF sxc_exit,
        lt_sxc_class TYPE STANDARD TABLE OF sxc_class,
        ls_sxs_attr  TYPE sxs_attr,
        ls_sxs_attrt TYPE sxs_attrt,
        lt_sxs_inter TYPE STANDARD TABLE OF sxs_inter,
        ls_tadir     TYPE tadir.

  DATA: ls_definition TYPE ty_definition,
        ls_class      TYPE ty_class,
        lv_interface  TYPE seoitfname.

  DATA: lt_interfaces TYPE STANDARD TABLE OF seoitfname.

  CLEAR: ev_header_json, ev_definitions_json, ev_classes_json,
         ev_results_json, ev_rcode, ev_message.

  " Validate input
  IF iv_imp_name IS INITIAL.
    ev_rcode = '1'.
    ev_message = 'Implementation name is required'.
    RETURN.
  ENDIF.

  " Detect wildcard search
  IF iv_imp_name CS '*'.
    lv_is_wildcard = abap_true.
  ELSE.
    lv_is_wildcard = abap_false.
  ENDIF.

  " === WILDCARD SEARCH MODE ===
  IF lv_is_wildcard = abap_true.
    " Replace * with % for LIKE operator
    lv_pattern = iv_imp_name.
    REPLACE ALL OCCURRENCES OF '*' IN lv_pattern WITH '%'.
    TRANSLATE lv_pattern TO UPPER CASE.

    " Query SXC_ATTR table for matching implementations
    SELECT imp_name active
      FROM sxc_attr
      INTO CORRESPONDING FIELDS OF TABLE lt_results
      UP TO iv_max_results ROWS
      WHERE imp_name LIKE lv_pattern.

    IF sy-subrc <> 0 OR lt_results IS INITIAL.
      ev_rcode = '2'.
      ev_message = |No BAdI implementations found matching pattern: { iv_imp_name }|.
      RETURN.
    ENDIF.

    " Get package for each result
    LOOP AT lt_results ASSIGNING FIELD-SYMBOL(<ls_result>).
      SELECT SINGLE devclass FROM tadir INTO <ls_result>-devclass
        WHERE pgmid = 'R3TR'
          AND object = 'SXCI'
          AND obj_name = <ls_result>-imp_name.
    ENDLOOP.

    " Return search results as JSON
    ev_results_json = /ui2/cl_json=>serialize(
      data        = lt_results
      pretty_name = /ui2/cl_json=>pretty_mode-low_case ).

    ev_rcode = '0'.
    ev_message = |Found { lines( lt_results ) } BAdI implementations matching pattern|.
    RETURN.
  ENDIF.

  " === EXACT MATCH MODE (original behavior) ===
  lv_imp_name = iv_imp_name.
  TRANSLATE lv_imp_name TO UPPER CASE.

  " Get implementation attributes from SXC_ATTR
  SELECT SINGLE * FROM sxc_attr INTO ls_sxc_attr
    WHERE imp_name = lv_imp_name.
  IF sy-subrc <> 0.
    ev_rcode = '2'.
    ev_message = |BAdI implementation { lv_imp_name } not found|.
    RETURN.
  ENDIF.

  " Get implementation text from SXC_ATTRT
  SELECT SINGLE * FROM sxc_attrt INTO ls_sxc_attrt
    WHERE imp_name = lv_imp_name
      AND sprsl = sy-langu.
  IF sy-subrc <> 0.
    SELECT SINGLE * FROM sxc_attrt INTO ls_sxc_attrt
      WHERE imp_name = lv_imp_name.
  ENDIF.

  " Get package from TADIR
  SELECT SINGLE * FROM tadir INTO ls_tadir
    WHERE pgmid = 'R3TR'
      AND object = 'SXCI'
      AND obj_name = lv_imp_name.

  " Build header
  ls_header-imp_name = ls_sxc_attr-imp_name.
  ls_header-description = ls_sxc_attrt-text.
  ls_header-active = COND #( WHEN ls_sxc_attr-active = 'X' THEN abap_true ELSE abap_false ).
  ls_header-devclass = ls_tadir-devclass.
  ls_header-author = ls_sxc_attr-aname.
  ls_header-created_on = ls_sxc_attr-adate.
  ls_header-changed_by = ls_sxc_attr-uname.
  ls_header-changed_on = ls_sxc_attr-udate.
  ls_header-mig_enhname = ls_sxc_attr-mig_enhname.

  " Serialize header to JSON
  ev_header_json = /ui2/cl_json=>serialize(
    data = ls_header
    pretty_name = /ui2/cl_json=>pretty_mode-low_case ).

  " Get BAdI definitions from SXC_EXIT
  SELECT * FROM sxc_exit INTO TABLE lt_sxc_exit
    WHERE imp_name = lv_imp_name.

  LOOP AT lt_sxc_exit INTO DATA(ls_sxc_exit).
    CLEAR ls_definition.
    ls_definition-badi_name = ls_sxc_exit-exit_name.
    ls_definition-filter_value = ls_sxc_exit-flt_val.

    " Get BAdI definition text
    SELECT SINGLE text FROM sxs_attrt INTO ls_definition-description
      WHERE exit_name = ls_sxc_exit-exit_name
        AND sprsl = sy-langu.
    IF sy-subrc <> 0.
      SELECT SINGLE text FROM sxs_attrt INTO ls_definition-description
        WHERE exit_name = ls_sxc_exit-exit_name.
    ENDIF.

    " Get BAdI definition attributes
    SELECT SINGLE * FROM sxs_attr INTO ls_sxs_attr
      WHERE exit_name = ls_sxc_exit-exit_name.
    IF sy-subrc = 0.
      ls_definition-multiple_use = COND #( WHEN ls_sxs_attr-mltp_use = 'X' THEN abap_true ELSE abap_false ).
      ls_definition-filter_dependent = COND #( WHEN ls_sxs_attr-flt_type IS NOT INITIAL THEN abap_true ELSE abap_false ).
    ENDIF.

    " Get interfaces for this BAdI
    CLEAR lt_interfaces.
    SELECT inter_name FROM sxs_inter INTO TABLE lt_interfaces
      WHERE exit_name = ls_sxc_exit-exit_name.
    LOOP AT lt_interfaces INTO lv_interface.
      APPEND lv_interface TO ls_definition-interfaces.
    ENDLOOP.

    APPEND ls_definition TO lt_definitions.
  ENDLOOP.

  " Serialize definitions to JSON
  ev_definitions_json = /ui2/cl_json=>serialize(
    data = lt_definitions
    pretty_name = /ui2/cl_json=>pretty_mode-low_case ).

  " Get implementing classes from SXC_CLASS
  SELECT * FROM sxc_class INTO TABLE lt_sxc_class
    WHERE imp_name = lv_imp_name.

  LOOP AT lt_sxc_class INTO DATA(ls_sxc_class_wa).
    ls_class-interface_name = ls_sxc_class_wa-inter_name.
    ls_class-class_name = ls_sxc_class_wa-imp_class.
    APPEND ls_class TO lt_classes.
  ENDLOOP.

  " Serialize classes to JSON
  ev_classes_json = /ui2/cl_json=>serialize(
    data = lt_classes
    pretty_name = /ui2/cl_json=>pretty_mode-low_case ).

  ev_rcode = '0'.

ENDFUNCTION.