FUNCTION ZCX_GETDDICSOURCE
  IMPORTING
    VALUE(OBJECT_NAME) TYPE TABNAME
  EXPORTING
    VALUE(OBJECT_TYPE) TYPE CHAR10
    VALUE(OBJECT_STATUS) TYPE CHAR10
    VALUE(FIELDS_JSON) TYPE STRING
  EXCEPTIONS
    OBJECT_NOT_FOUND
    INVALID_OBJECT_TYPE.

   DATA: lv_tabclass   TYPE dd02l-tabclass,
         lt_fields     TYPE STANDARD TABLE OF dd03l,
         ls_field      TYPE dd03l,
         lv_json       TYPE string,
         lv_field_json TYPE string,
         lv_first      TYPE abap_bool VALUE abap_true.

   CLEAR: object_type, object_status, fields_json.

   SELECT SINGLE tabclass
     FROM dd02l
     INTO lv_tabclass
     WHERE tabname = object_name
       AND as4local = 'A'.

   IF sy-subrc <> 0.
     RAISE object_not_found.
   ENDIF.

   CASE lv_tabclass.
     WHEN 'TRANSP'.
       object_type = 'TABLE'.
     WHEN 'INTTAB'.
       object_type = 'STRUCTURE'.
     WHEN 'VIEW'.
       object_type = 'VIEW'.
     WHEN 'APPEND'.
       object_type = 'APPEND'.
     WHEN OTHERS.
       object_type = 'UNKNOWN'.
   ENDCASE.

   object_status = 'ACTIVE'.

   SELECT fieldname position rollname mandatory checktable
          adminfield inttype intlen datatype keyflag reffield
     FROM dd03l
     INTO CORRESPONDING FIELDS OF TABLE lt_fields
     WHERE tabname = object_name
       AND as4local = 'A'
       AND fieldname <> '.INCLUDE'
     ORDER BY position.

   IF sy-subrc <> 0.
     RAISE invalid_object_type.
   ENDIF.

   lv_json = '['.

   LOOP AT lt_fields INTO ls_field.
     IF lv_first = abap_false.
       CONCATENATE lv_json ',' INTO lv_json.
     ENDIF.

     CONCATENATE '{'
                 '"fieldname":"' ls_field-fieldname '",'
                 '"position":' ls_field-position ','
                 '"rollname":"' ls_field-rollname '",'
                 '"mandatory":"' ls_field-mandatory '",'
                 '"checktable":"' ls_field-checktable '",'
                 '"adminfield":"' ls_field-adminfield '",'
                 '"inttype":"' ls_field-inttype '",'
                 '"intlen":' ls_field-intlen ','
                 '"datatype":"' ls_field-datatype '",'
                 '"keyflag":"' ls_field-keyflag '",'
                 '"reffield":"' ls_field-reffield '"'
                 '}'
       INTO lv_field_json.

     CONCATENATE lv_json lv_field_json INTO lv_json.
     lv_first = abap_false.
   ENDLOOP.

   CONCATENATE lv_json ']' INTO fields_json.

ENDFUNCTION.
