FUNCTION ZCX_GETDDICSOURCE
  IMPORTING
    VALUE(OBJECT_NAME) TYPE TABNAME
  EXPORTING
    VALUE(OBJECT_TYPE) TYPE CHAR10
    VALUE(OBJECT_STATUS) TYPE CHAR10
    VALUE(FIELDS_JSON) TYPE STRING
  EXCEPTIONS
    OBJECT_NOT_FOUND
    INVALID_OBJECT_TYPE.



  " Structure for JSON output (matches Java DdicField)
  TYPES: BEGIN OF ty_field,
           fieldname  TYPE dd03l-fieldname,
           position   TYPE dd03l-position,
           rollname   TYPE dd03l-rollname,
           mandatory  TYPE dd03l-mandatory,
           checktable TYPE dd03l-checktable,
           adminfield TYPE dd03l-adminfield,
           inttype    TYPE dd03l-inttype,
           intlen     TYPE dd03l-intlen,
           datatype   TYPE dd03l-datatype,
           keyflag    TYPE dd03l-keyflag,
           reffield   TYPE dd03l-reffield,
         END OF ty_field,
         tt_fields TYPE STANDARD TABLE OF ty_field WITH DEFAULT KEY.

  DATA: lv_tabclass TYPE dd02l-tabclass,
        lt_dd03l    TYPE STANDARD TABLE OF dd03l,
        ls_dd03l    TYPE dd03l,
        lt_fields   TYPE tt_fields,
        ls_field    TYPE ty_field.

  CLEAR: object_type, object_status, fields_json.

  " Get object type from DD02L
  SELECT SINGLE tabclass
    FROM dd02l
    INTO lv_tabclass
    WHERE tabname = object_name
      AND as4local = 'A'.

  IF sy-subrc <> 0.
    RAISE object_not_found.
  ENDIF.

  " Map tabclass to readable type
  CASE lv_tabclass.
    WHEN 'TRANSP'.
      object_type = 'TABLE'.
    WHEN 'INTTAB'.
      object_type = 'STRUCTURE'.
    WHEN 'VIEW'.
      object_type = 'VIEW'.
    WHEN 'APPEND'.
      object_type = 'APPEND'.
    WHEN OTHERS.
      object_type = 'UNKNOWN'.
  ENDCASE.

  object_status = 'ACTIVE'.

  " Get fields from DD03L
  SELECT fieldname position rollname mandatory checktable
         adminfield inttype intlen datatype keyflag reffield
    FROM dd03l
    INTO CORRESPONDING FIELDS OF TABLE lt_dd03l
    WHERE tabname = object_name
      AND as4local = 'A'
      AND fieldname <> '.INCLUDE'
    ORDER BY position.

  IF sy-subrc <> 0.
    RAISE invalid_object_type.
  ENDIF.

  " Convert to output structure (removes trailing spaces)
  LOOP AT lt_dd03l INTO ls_dd03l.
    CLEAR ls_field.
    ls_field-fieldname  = ls_dd03l-fieldname.
    ls_field-position   = ls_dd03l-position.
    ls_field-rollname   = ls_dd03l-rollname.
    ls_field-mandatory  = ls_dd03l-mandatory.
    ls_field-checktable = ls_dd03l-checktable.
    ls_field-adminfield = ls_dd03l-adminfield.
    ls_field-inttype    = ls_dd03l-inttype.
    ls_field-intlen     = ls_dd03l-intlen.
    ls_field-datatype   = ls_dd03l-datatype.
    ls_field-keyflag    = ls_dd03l-keyflag.
    ls_field-reffield   = ls_dd03l-reffield.
    APPEND ls_field TO lt_fields.
  ENDLOOP.

  " Serialize to JSON using /ui2/cl_json
  fields_json = /ui2/cl_json=>serialize(
    data        = lt_fields
    pretty_name = /ui2/cl_json=>pretty_mode-low_case ).

ENDFUNCTION.