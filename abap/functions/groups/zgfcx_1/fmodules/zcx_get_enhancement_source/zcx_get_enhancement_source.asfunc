FUNCTION ZCX_GET_ENHANCEMENT_SOURCE
  IMPORTING
    VALUE(IV_ENHANCEMENT_NAME) TYPE STRING
    VALUE(IV_VERSION) TYPE VERSNO DEFAULT 00000
    VALUE(IV_MAX_RESULTS) TYPE I DEFAULT 100
  EXPORTING
    VALUE(EV_HEADER_JSON) TYPE STRING
    VALUE(EV_ELEMENTS_JSON) TYPE STRING
    VALUE(EV_RESULTS_JSON) TYPE STRING
    VALUE(EV_RCODE) TYPE SY-SUBRC
    VALUE(EV_MESSAGE) TYPE STRING
  EXCEPTIONS
    ENHANCEMENT_NOT_FOUND
    PERMISSION_DENIED
    INTERNAL_ERROR.



  TYPES: BEGIN OF ty_header,
           enhancement_name TYPE enhname,
           description      TYPE string,
           tool_type        TYPE enhspottooltype,
           tool_type_text   TYPE string,
           devclass         TYPE devclass,
           author           TYPE uname,
           created_on       TYPE dats,
           changed_by       TYPE uname,
           changed_on       TYPE dats,
         END OF ty_header.

  TYPES: BEGIN OF ty_element,
           element_type   TYPE string,
           spot_name      TYPE string,
           program_name   TYPE string,
           full_name      TYPE string,
           badi_name      TYPE string,
           badi_impl      TYPE string,
           impl_class     TYPE string,
           interface_name TYPE string,
           active         TYPE abap_bool,
           source_code    TYPE string,
         END OF ty_element,
         tt_elements TYPE STANDARD TABLE OF ty_element WITH DEFAULT KEY.

  TYPES: BEGIN OF ty_search_result,
           enhancement_name TYPE enhname,
           obj_type         TYPE enhspottooltype,
           source_name      TYPE enhobj-main_name,
         END OF ty_search_result,
         tt_search_results TYPE STANDARD TABLE OF ty_search_result WITH DEFAULT KEY.

  DATA: lo_enhancement TYPE REF TO if_enh_tool,
        lo_badi_impl   TYPE REF TO cl_enh_tool_badi_impl,
        lo_hook_impl   TYPE REF TO cl_enh_tool_hook_impl,
        ls_header      TYPE ty_header,
        lt_elements    TYPE tt_elements,
        ls_element     TYPE ty_element,
        lv_state       TYPE r3state,
        lv_enhname     TYPE enhname,
        lv_pattern     TYPE string,
        lt_results     TYPE tt_search_results,
        ls_result      TYPE ty_search_result,
        lv_is_wildcard TYPE abap_bool.

  DATA: lt_badi_data TYPE enh_badi_impl_data_it,
        ls_badi_data TYPE enh_badi_impl_data,
        lt_hook_data TYPE enh_hook_impl_it,
        ls_hook_data TYPE enh_hook_impl.

  CLEAR: ev_header_json, ev_elements_json, ev_results_json, ev_rcode, ev_message.

  " Detect wildcard search
  IF iv_enhancement_name CS '*'.
    lv_is_wildcard = abap_true.
  ELSE.
    lv_is_wildcard = abap_false.
  ENDIF.

  " === WILDCARD SEARCH MODE ===
  IF lv_is_wildcard = abap_true.
    " Replace * with % for LIKE operator
    lv_pattern = iv_enhancement_name.
    REPLACE ALL OCCURRENCES OF '*' IN lv_pattern WITH '%'.
    TRANSLATE lv_pattern TO UPPER CASE.

    " Query ENHO table for matching enhancements
    SELECT enhname obj_type main_name
      FROM enhobj
      INTO TABLE lt_results
      UP TO iv_max_results ROWS
      WHERE enhname LIKE lv_pattern.

    IF sy-subrc <> 0 OR lt_results IS INITIAL.
      ev_rcode = 4.
      ev_message = |No enhancements found matching pattern: { iv_enhancement_name }|.
      RAISE enhancement_not_found.
    ENDIF.

    " Return search results as JSON
    ev_results_json = /ui2/cl_json=>serialize(
      data        = lt_results
      pretty_name = /ui2/cl_json=>pretty_mode-low_case ).

    ev_rcode = 0.
    ev_message = |Found { lines( lt_results ) } enhancements matching pattern|.
    RETURN.
  ENDIF.

  " === EXACT MATCH MODE (original behavior) ===
  IF iv_version = 00000.
    lv_state = 'A'.
  ELSE.
    lv_state = 'I'.
  ENDIF.

  lv_enhname = iv_enhancement_name.
  TRANSLATE lv_enhname TO UPPER CASE.

  TRY.
      cl_enh_factory=>get_enhancement(
        EXPORTING
          enhancement_id = lv_enhname
          versno         = iv_version
        RECEIVING
          enhancement    = lo_enhancement ).
    CATCH cx_enh_io_error.
      ev_rcode = 4.
      ev_message = |Enhancement not found: { lv_enhname }|.
      RAISE enhancement_not_found.
    CATCH cx_enh_permission_denied.
      ev_rcode = 8.
      ev_message = |Permission denied for: { lv_enhname }|.
      RAISE permission_denied.
    CATCH cx_root INTO DATA(lx_error).
      ev_rcode = 16.
      ev_message = lx_error->get_text( ).
      RAISE internal_error.
  ENDTRY.

  ls_header-enhancement_name = lv_enhname.
  ls_header-description = lo_enhancement->if_enh_object_docu~get_shorttext( lv_state ).
  ls_header-tool_type = lo_enhancement->get_tool( ).
  ls_header-devclass = lo_enhancement->if_enh_object~get_devclass( ).

  SELECT SINGLE text FROM enhtoolst INTO ls_header-tool_type_text
    WHERE tool_type = ls_header-tool_type
      AND langu = sy-langu.

  SELECT SINGLE loguser logdate FROM enhlog
    INTO (ls_header-author, ls_header-created_on)
    WHERE enhname = lv_enhname
      AND version = 'A'
      AND logid = 1.

  SELECT SINGLE loguser logdate FROM enhlog
    INTO (ls_header-changed_by, ls_header-changed_on)
    WHERE enhname = lv_enhname
      AND version = 'A'
      AND logid = ( SELECT MAX( logid ) FROM enhlog
                    WHERE enhname = lv_enhname
                      AND version = 'A' ).

  ev_header_json = /ui2/cl_json=>serialize(
    data        = ls_header
    pretty_name = /ui2/cl_json=>pretty_mode-low_case ).

  CASE ls_header-tool_type.
    WHEN 'BADI_IMPL'.
      lo_badi_impl ?= lo_enhancement.
      TRY.
          lt_badi_data = lo_badi_impl->get_implementations( version = lv_state ).
        CATCH cx_root.
      ENDTRY.

      LOOP AT lt_badi_data INTO ls_badi_data.
        CLEAR ls_element.
        ls_element-element_type = 'BADI_IMPL'.
        ls_element-badi_name = ls_badi_data-badi_name.
        ls_element-badi_impl = ls_badi_data-impl_name.
        ls_element-impl_class = ls_badi_data-impl_class.
        ls_element-active = ls_badi_data-active.

        SELECT SINGLE interface_name FROM badi_main
          INTO ls_element-interface_name
          WHERE badi_name = ls_badi_data-badi_name.

        APPEND ls_element TO lt_elements.
      ENDLOOP.

    WHEN 'HOOK_IMPL'.
      lo_hook_impl ?= lo_enhancement.
      TRY.
          lt_hook_data = lo_hook_impl->get_hook_impls( version = lv_state ).
        CATCH cx_enh_no_valid_input_type.
        CATCH cx_root.
      ENDTRY.

      LOOP AT lt_hook_data INTO ls_hook_data.
        CLEAR ls_element.
        ls_element-element_type = 'HOOK_IMPL'.
        ls_element-spot_name = ls_hook_data-spotname.
        ls_element-program_name = ls_hook_data-programname.
        ls_element-full_name = ls_hook_data-full_name.

        " Concatenate source lines into single string with newlines
        CONCATENATE LINES OF ls_hook_data-source INTO ls_element-source_code SEPARATED BY cl_abap_char_utilities=>newline.

        APPEND ls_element TO lt_elements.
      ENDLOOP.
  ENDCASE.

  ev_elements_json = /ui2/cl_json=>serialize(
    data        = lt_elements
    pretty_name = /ui2/cl_json=>pretty_mode-low_case ).

  ev_rcode = 0.

ENDFUNCTION.