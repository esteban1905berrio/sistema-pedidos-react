CLASS zclcx_transport_management DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun.

    CONSTANTS: gc_icono_copia TYPE char4 VALUE '@CP@'.

    TYPES: gtp_ti_e070  TYPE STANDARD TABLE OF e070 WITH DEFAULT KEY,
           gtp_ti_e071  TYPE STANDARD TABLE OF e071 WITH DEFAULT KEY,
           gtp_ti_e071k TYPE STANDARD TABLE OF e071k WITH DEFAULT KEY.
    TYPES:
      gtp_r_string TYPE RANGE OF string,
      gtp_r_ot     TYPE RANGE OF e070-trkorr.

    " Estructura para resultado detallado de cada paso
    TYPES: BEGIN OF gts_step_result,
             success TYPE abap_bool,
             message TYPE string,
           END OF gts_step_result.

    " Estructura para resultado completo del proceso
    TYPES: BEGIN OF gts_workflow_result,
             orden_copia       TYPE trkorr,
             creacion          TYPE gts_step_result,
             documentacion     TYPE gts_step_result,
             inclusion_objetos TYPE gts_step_result,
             liberacion        TYPE gts_step_result,
             log_liberacion    TYPE string,
           END OF gts_workflow_result.

    CLASS-DATA: g_ok_code           TYPE sy-ucomm,
                go_editor           TYPE REF TO cl_gui_textedit,
                go_editor_container TYPE REF TO cl_gui_custom_container,
                gti_documentacion   TYPE TABLE OF tdline.

    CLASS-METHODS:
      pai_documentacion,
      pbo_documentacion.

    "! Convierte el contenido de una tabla interna
    "! en una cadena de texto (String)
    "!
    "! @parameter i_es |
    "! @parameter i_r_excluir_columnas | Nombre de columnas a excluir
    "! @parameter i_caracter_exc_columna | Caracter que identifica las columnas que no se tendran en cuenta en la conversion
    "! @parameter i_separador | Caracter mediante el cual se separaran los valores en cada columna
    "! @parameter i_incluir_encabezado | Incluye en la primera línea el texto de las columnas o descripciones
    "! @parameter i_longitud_texto_columna | El tamaño de los textos de las columnas a incluir (Large, Medium, Small, Otro:Nombre Columna)
    "! @parameter r_str | Cadena de texto con contendio de tabla interna
    "! @parameter i_ti_componente_estructura | Nombres de las columnas
    CLASS-METHODS es_a_string
      IMPORTING
        !i_es                       TYPE any
        !i_r_excluir_columnas       TYPE gtp_r_string OPTIONAL
        !i_caracter_exc_columna     TYPE string OPTIONAL
        !i_separador                TYPE string DEFAULT ';'
        !i_incluir_encabezado       TYPE flag DEFAULT abap_false
        !i_longitud_texto_columna   TYPE char01 OPTIONAL
        !i_ti_componente_estructura TYPE cl_abap_structdescr=>component_table OPTIONAL
      RETURNING
        VALUE(r_str)                TYPE string .

    CLASS-METHODS ti_a_string
      IMPORTING
        !i_ti                         TYPE ANY TABLE
        !i_r_excluir_columnas         TYPE gtp_r_string OPTIONAL
        !i_omitir_salto_linea         TYPE flag DEFAULT abap_false
        !i_caracter_exc_columna       TYPE string OPTIONAL
        !i_separador                  TYPE string DEFAULT ';'
        !i_separador_como_salto_linea TYPE flag DEFAULT abap_false
        !i_incluir_encabezado         TYPE flag DEFAULT abap_false
        !i_tam_txt_columna            TYPE char01 OPTIONAL
      RETURNING
        VALUE(r_str)                  TYPE string .

    " Genera orden de transporte de copia con resultado detallado
    "! @parameter i_sistema | Sistema destino
    "! @parameter i_r_orden_origen | Rango de OTs origen
    "! @parameter i_descripcion | Descripción de la OT
    "! @parameter i_prefijo | Prefijo para descripción
    "! @parameter i_auto_release | Liberar automáticamente (default: true)
    "! @parameter e_resultado | Resultado detallado del workflow
    METHODS:
      generar_orden_copia
        IMPORTING
          i_sistema            TYPE trexreqhd-target
          i_r_orden_origen     TYPE gtp_r_ot
          VALUE(i_descripcion) TYPE as4text
          i_prefijo            TYPE string
          i_auto_release       TYPE abap_bool DEFAULT abap_true
          i_visualizar_log     TYPE abap_bool DEFAULT abap_false
        EXPORTING
          e_resultado          TYPE gts_workflow_result
          VALUE(e_orden_copia) TYPE trkorr.

  PRIVATE SECTION.

    CLASS-METHODS:
      salir_documentacion.

    METHODS:
      crear_orden_copia
        IMPORTING
          i_sistema            TYPE trexreqhd-target
          i_autor              TYPE trexreqhd-author DEFAULT sy-uname
          i_texto_orden        TYPE trexreqhd-text
        EXPORTING
          VALUE(es_msg)        TYPE char200
          VALUE(e_orden_copia) TYPE trkorr,
      incluir_objetos_en_copia
        IMPORTING
          i_r_orden_origen TYPE gtp_r_ot
          i_orden_copia    TYPE trkorr
        EXPORTING
          e_sy_subrc       TYPE sy-subrc
          e_msg            TYPE string,
      obtener_objetos_de_orden
        IMPORTING
          i_r_orden_origen TYPE gtp_r_ot
        EXPORTING
          e_ti_e071        TYPE gtp_ti_e071
          e_ti_e071k       TYPE gtp_ti_e071k,
      liberar_orden
        IMPORTING
          i_orden           TYPE e070-trkorr
        EXPORTING
          e_msg             TYPE string
          VALUE(e_sy_subrc) TYPE sy-subrc,
      obtener_ordenes_relacionadas
        IMPORTING
          i_r_orden_origen TYPE gtp_r_ot
        RETURNING
          VALUE(r_ti_e070) TYPE gtp_ti_e070,
      obtener_objetos_ordenes
        IMPORTING
          VALUE(i_ti_e070) TYPE gtp_ti_e070
        RETURNING
          VALUE(r_ti_e071) TYPE gtp_ti_e071,
      obtener_objetos_tabla
        IMPORTING
          VALUE(i_ti_e070)  TYPE gtp_ti_e070
        RETURNING
          VALUE(r_ti_e071k) TYPE gtp_ti_e071k,
      visualizar_log
        IMPORTING
          i_orden TYPE protname
        EXPORTING
          e_msg   TYPE string,
      borrar_orden
        IMPORTING
          i_orden TYPE e070-trkorr,
      aniadir_documentacion
        IMPORTING
          i_orden            TYPE e070-trkorr
          i_ti_documentacion TYPE tline_t.
ENDCLASS.



CLASS zclcx_transport_management IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.
    out->write( 'Hello from my executable class!' ).
    DATA(lv_number) = 10.
    out->write( |The number is: { lv_number }| ).
  ENDMETHOD.

  METHOD generar_orden_copia.

    CLEAR e_resultado.

    IF i_descripcion IS INITIAL.
      i_descripcion = |{ gc_icono_copia } { i_prefijo }-{ i_r_orden_origen[ 1 ]-low } Transporte de copia|.
    ELSEIF lines( i_r_orden_origen ) > 1.
      i_descripcion = |{ gc_icono_copia } { i_descripcion }|.
    ENDIF.

    " PASO 1: Crear orden de copia
    crear_orden_copia( EXPORTING
                        i_sistema     = i_sistema
                        i_texto_orden = i_descripcion
                       IMPORTING
                        es_msg        = DATA(e_msg_crear_ot)
                        e_orden_copia = DATA(orden_copia) ).

    IF orden_copia IS NOT INITIAL.
      e_resultado-creacion-success = abap_true.
      e_resultado-creacion-message = e_msg_crear_ot.
      e_resultado-orden_copia = orden_copia.
    ELSE.
      e_resultado-creacion-success = abap_false.
      e_resultado-creacion-message = e_msg_crear_ot.
      RETURN.
    ENDIF.

    " PASO 2: Añadir documentación (opcional)
    IF gti_documentacion IS NOT INITIAL.
      aniadir_documentacion( i_orden            = orden_copia
                             i_ti_documentacion = VALUE #( FOR wa IN gti_documentacion ( tdline = wa ) ) ).
      e_resultado-documentacion-success = abap_true.
      e_resultado-documentacion-message = 'Documentación añadida'.
    ELSE.
      e_resultado-documentacion-success = abap_true.
      e_resultado-documentacion-message = 'Sin documentación (no requerida)'.
    ENDIF.

    " PASO 3: Incluir objetos en copia
    incluir_objetos_en_copia( EXPORTING
                                i_r_orden_origen = i_r_orden_origen
                                i_orden_copia    = orden_copia
                              IMPORTING
                                e_msg      = DATA(lv_msg_objetos)
                                e_sy_subrc = DATA(lv_subrc_objetos) ).

    IF lv_subrc_objetos = 0.
      e_resultado-inclusion_objetos-success = abap_true.
      e_resultado-inclusion_objetos-message = 'Objetos incluidos exitosamente'.
    ELSE.
      e_resultado-inclusion_objetos-success = abap_false.
      e_resultado-inclusion_objetos-message = lv_msg_objetos.
      " La orden ya fue borrada en incluir_objetos_en_copia
      e_resultado-orden_copia = ''.
      e_orden_copia = ''.
      RETURN.
    ENDIF.

    " PASO 4: Liberar orden (si auto_release = true)
    IF i_auto_release = abap_true.
      liberar_orden( EXPORTING
                       i_orden = orden_copia
                     IMPORTING
                       e_msg      = DATA(lv_msg_release)
                       e_sy_subrc = DATA(lv_subrc_release) ).

      IF lv_subrc_release = 0.
        e_resultado-liberacion-success = abap_true.
        e_resultado-liberacion-message = |Orden { orden_copia } liberada exitosamente|.
      ELSE.
        e_resultado-liberacion-success = abap_false.
        e_resultado-liberacion-message = lv_msg_release.

        " Obtener log de liberación para diagnóstico
        IF i_visualizar_log = abap_true.
          visualizar_log( EXPORTING
                            i_orden = CONV #( orden_copia )
                          IMPORTING
                            e_msg   = e_resultado-log_liberacion ).
        ENDIF.
      ENDIF.

    ELSE.
      e_resultado-liberacion-success = abap_true.
      e_resultado-liberacion-message = 'Liberación omitida (auto_release = false)'.
    ENDIF.

    " Retornar número de OT creada
    e_orden_copia = orden_copia.

  ENDMETHOD.

  METHOD crear_orden_copia.

    CALL FUNCTION 'TR_EXT_CREATE_REQUEST'
      EXPORTING
        iv_request_type = 'T'
        iv_target       = i_sistema
        iv_author       = i_autor
        iv_text         = i_texto_orden
      IMPORTING
        es_req_id       = e_orden_copia
        es_msg          = es_msg.

  ENDMETHOD.

  METHOD incluir_objetos_en_copia.

    DATA: ti_fm_e071  TYPE tr_objects,
          ti_fm_e071k TYPE tr_keys.

    obtener_objetos_de_orden( EXPORTING i_r_orden_origen    = i_r_orden_origen
                              IMPORTING e_ti_e071  = DATA(ti_e071)
                                        e_ti_e071k = DATA(ti_e071k) ).

    ti_fm_e071  = CORRESPONDING #( ti_e071 ).
    ti_fm_e071k = CORRESPONDING #( ti_e071k ).

    "Omitir los objetos de referencia de la tarea que se haya liberado
    "Si no se omiten, genera un erorr
    DELETE ti_fm_e071 WHERE pgmid  = 'CORR'.

    CALL FUNCTION 'TR_REQUEST_CHOICE'
      EXPORTING
        iv_suppress_dialog   = abap_true
        iv_request           = i_orden_copia
        it_e071              = ti_fm_e071
        it_e071k             = ti_fm_e071k
      EXCEPTIONS
        invalid_request      = 1
        invalid_request_type = 2
        user_not_owner       = 3
        no_objects_appended  = 4
        enqueue_error        = 5
        cancelled_by_user    = 6
        recursive_call       = 7
        OTHERS               = 8.

    e_sy_subrc = sy-subrc.

    IF sy-subrc <> 0.

      MESSAGE ID sy-msgid TYPE 'S' NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 INTO e_msg.

      "Borrar la orden de copia si genera algun error
      borrar_orden( i_orden = i_orden_copia ).

    ENDIF.

  ENDMETHOD.

  METHOD obtener_objetos_de_orden.

    DATA(ti_e070) = obtener_ordenes_relacionadas( i_r_orden_origen = i_r_orden_origen ).
    e_ti_e071 = obtener_objetos_ordenes( i_ti_e070 = ti_e070 ).
    e_ti_e071k = obtener_objetos_tabla( i_ti_e070 = ti_e070 ).

  ENDMETHOD.

  METHOD liberar_orden.

    CALL FUNCTION 'TR_RELEASE_REQUEST'
      EXPORTING
        iv_trkorr                  = i_orden
        iv_dialog                  = ' '
        iv_display_export_log      = ' '
        iv_simulation              = ' '
        iv_without_locking         = 'X'
      EXCEPTIONS
        cts_initialization_failure = 1
        enqueue_failed             = 2
        no_authorization           = 3
        invalid_request            = 4
        request_already_released   = 5
        repeat_too_early           = 6
        error_in_export_methods    = 7
        object_check_error         = 8
        docu_missing               = 9
        db_access_error            = 10
        action_aborted_by_user     = 11
        export_failed              = 12
        OTHERS                     = 13.

    e_sy_subrc = sy-subrc.

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE 'S' NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 INTO e_msg.
    ENDIF.

  ENDMETHOD.

  METHOD obtener_ordenes_relacionadas.

    SELECT trkorr
    FROM e070
    WHERE trkorr IN @i_r_orden_origen
       OR strkorr IN @i_r_orden_origen
    INTO TABLE @r_ti_e070.

  ENDMETHOD.

  METHOD obtener_objetos_ordenes.

    SELECT e071~*
        FROM e071
        FOR ALL ENTRIES IN @i_ti_e070
        WHERE  e071~trkorr = @i_ti_e070-trkorr
    INTO TABLE @r_ti_e071.

  ENDMETHOD.

  METHOD obtener_objetos_tabla.

    SELECT e071k~*
          FROM e071k
          FOR ALL ENTRIES IN @i_ti_e070
          WHERE  e071k~trkorr = @i_ti_e070-trkorr
      INTO TABLE @r_ti_e071k.

  ENDMETHOD.

  METHOD visualizar_log.

    DATA: t_msg TYPE rs_t_msg.

    CALL FUNCTION 'RSDG_TR_GET_PROTOCOL'
      EXPORTING
        i_protnm               = i_orden
        i_detlevel             = '4'
      IMPORTING
        e_t_msg                = t_msg
      EXCEPTIONS
        error_reading_protocol = 1
        OTHERS                 = 2.

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE 'S' NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 INTO e_msg.
      RETURN.
    ENDIF.

    e_msg = ti_a_string( i_ti = t_msg ).

  ENDMETHOD.

  METHOD borrar_orden.

    CALL FUNCTION 'TRINT_DELETE_COMM'
      EXPORTING
        wi_dialog                     = space
        wi_trkorr                     = i_orden
      EXCEPTIONS
        file_access_error             = 1
        order_already_released        = 2
        order_contains_c_member       = 3
        order_contains_locked_entries = 4
        order_is_refered              = 5
        repair_order                  = 6
        user_not_owner                = 7
        delete_was_cancelled          = 8
        objects_free_but_still_locks  = 9
        order_lock_failed             = 10
        wrong_client                  = 11
        project_still_referenced      = 12
        successors_already_released   = 13
        OTHERS                        = 14.

    IF sy-subrc <> 0.
    ENDIF.

  ENDMETHOD.

  METHOD aniadir_documentacion.

    CALL FUNCTION 'TRINT_DOCU_INTERFACE'
      EXPORTING
        iv_object           = i_orden
        iv_action           = 'M'
        iv_modify_appending = ' '
      TABLES
        tt_line             = i_ti_documentacion
      EXCEPTIONS
        error               = 1
        OTHERS              = 2.

    IF sy-subrc <> 0.
    ENDIF.

  ENDMETHOD.

  METHOD pai_documentacion.

    CASE g_ok_code.

      WHEN 'EXIT' OR 'CANCEL'.
        salir_documentacion( ).

      WHEN 'SAVE'.

        CALL METHOD go_editor->get_text_as_r3table
          IMPORTING
            table  = gti_documentacion
          EXCEPTIONS
            OTHERS = 1.

        IF sy-subrc NE 0.
        ENDIF.
        MESSAGE 'Se almacenado la documentación' TYPE 'S'.
        salir_documentacion( ).

      WHEN 'LOAD'.

        CALL METHOD go_editor->set_text_as_r3table
          EXPORTING
            table  = gti_documentacion
          EXCEPTIONS
            OTHERS = 1.

        IF sy-subrc NE 0.
        ENDIF.

    ENDCASE.

    CLEAR g_ok_code.

  ENDMETHOD.

  METHOD salir_documentacion.

    IF NOT go_editor IS INITIAL.

      CALL METHOD go_editor->free
        EXCEPTIONS
          OTHERS = 1.

      IF sy-subrc NE 0.
      ENDIF.

      FREE go_editor.
    ENDIF.

    IF NOT go_editor_container IS INITIAL.

      CALL METHOD go_editor_container->free
        EXCEPTIONS
          OTHERS = 1.

      IF sy-subrc <> 0.
      ENDIF.

      FREE go_editor_container.
    ENDIF.

    CALL METHOD cl_gui_cfw=>flush
      EXCEPTIONS
        OTHERS = 1.

    IF sy-subrc NE 0.
    ENDIF.

    LEAVE TO SCREEN 0.

  ENDMETHOD.

  METHOD pbo_documentacion.

    IF go_editor IS INITIAL.

      SET PF-STATUS 'SG_DOCUMENTACION'.
      DATA(g_repid) = sy-repid.

      CREATE OBJECT go_editor_container
        EXPORTING
          container_name              = 'CUSTOM_CONTROL'
        EXCEPTIONS
          cntl_error                  = 1
          cntl_system_error           = 2
          create_error                = 3
          lifetime_error              = 4
          lifetime_dynpro_dynpro_link = 5.

      IF sy-subrc NE 0.
        MESSAGE 'Error en la generación del area de texto' TYPE 'S' DISPLAY LIKE 'E'.
      ENDIF.

      CREATE OBJECT go_editor
        EXPORTING
          parent                     = go_editor_container
          wordwrap_mode              = cl_gui_textedit=>wordwrap_at_fixed_position
          wordwrap_to_linebreak_mode = cl_gui_textedit=>true
        EXCEPTIONS
          OTHERS                     = 1.

      IF sy-subrc NE 0.
        MESSAGE 'Error en la generación del area de texto' TYPE 'S' DISPLAY LIKE 'E'.
      ENDIF.

      IF gti_documentacion IS NOT INITIAL.

        CALL METHOD go_editor->set_text_as_r3table
          EXPORTING
            table           = gti_documentacion
          EXCEPTIONS
            error_dp        = 1
            error_dp_create = 2
            OTHERS          = 3.

        IF sy-subrc <> 0.
        ENDIF.
      ENDIF.

    ENDIF.

  ENDMETHOD.

  METHOD ti_a_string.

    DATA: str_line            TYPE string,
          o_stdescribe        TYPE REF TO cl_abap_structdescr,
          o_tabledescr        TYPE REF TO cl_abap_tabledescr,
          o_elm_des           TYPE REF TO cl_abap_elemdescr,
          ti_columnas_tabla_d TYPE cl_abap_structdescr=>component_table.

    FIELD-SYMBOLS: <fs_es_datos> TYPE any,
                   <fs_dato>     TYPE any,
                   <fs_ti_datos> TYPE ANY TABLE.

    TRY.

        o_tabledescr ?= cl_abap_structdescr=>describe_by_data( i_ti ).

        TRY.
            o_stdescribe ?= o_tabledescr->get_table_line_type( ).
            DATA(ti_columnas_tabla) = o_stdescribe->get_components( ).
          CATCH cx_sy_move_cast_error INTO DATA(o_cx_cast) ##NO_HANDLER.

            o_elm_des ?= o_tabledescr->get_table_line_type( ).

            APPEND VALUE cl_abap_structdescr=>component( name = 'TABLE_LINE'
                                                         type = o_tabledescr->get_table_line_type( )    )
            TO ti_columnas_tabla.

        ENDTRY.

        "busca estructuras anidadas
        LOOP AT ti_columnas_tabla INTO DATA(es_componente) WHERE name = space OR as_include EQ abap_true.
          o_stdescribe ?=  es_componente-type.
          APPEND LINES OF o_stdescribe->get_components( ) TO ti_columnas_tabla_d.
        ENDLOOP..

        DELETE ti_columnas_tabla_d WHERE name = space.
        "agrega componenes anidados
        APPEND LINES OF ti_columnas_tabla_d TO ti_columnas_tabla.

        DELETE ti_columnas_tabla WHERE name = space.

      CATCH cx_sy_move_cast_error ##NO_HANDLER.

    ENDTRY.

    LOOP AT i_ti ASSIGNING <fs_es_datos>.

      str_line = es_a_string( i_es                       = <fs_es_datos>
                              i_r_excluir_columnas       = i_r_excluir_columnas
                              i_caracter_exc_columna     = i_caracter_exc_columna
                              i_separador                = i_separador
                              i_incluir_encabezado       = abap_false
                              i_ti_componente_estructura = ti_columnas_tabla ).

      IF i_omitir_salto_linea = abap_true.
        r_str = r_str && str_line.
      ELSE.
        IF i_separador_como_salto_linea = abap_true.
          r_str = r_str && str_line && i_separador.
        ELSE.
          r_str = r_str && str_line && cl_abap_char_utilities=>cr_lf.
        ENDIF.
      ENDIF.

    ENDLOOP.
    "Eliminar ultimo caracter
    IF i_separador_como_salto_linea = abap_true.
      DATA(longitud_cadena) = strlen( r_str ) - 1.
      IF longitud_cadena > 1.
        r_str = r_str(longitud_cadena).
      ENDIF.
    ENDIF.

    """""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
    "Funcionalidad para incluir el encabezado de la tabla
    IF i_incluir_encabezado = abap_true.
      CLEAR str_line.

      "Recorrer los campos de la tabla
      LOOP AT ti_columnas_tabla ASSIGNING FIELD-SYMBOL(<fs_es_componentes_tabla>).

        IF i_r_excluir_columnas IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name IN i_r_excluir_columnas.
          CONTINUE.
        ENDIF.
        "columnas que se excluyen
        IF i_caracter_exc_columna IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name(2) EQ i_caracter_exc_columna.
          CONTINUE.
        ENDIF.

        TRY.
            "Asigna la referencia del tipo del campo
            o_elm_des ?= <fs_es_componentes_tabla>-type.
          CATCH  cx_sy_move_cast_error cx_root INTO DATA(o_cx).
            CONTINUE.
        ENDTRY.

        CASE i_tam_txt_columna.
          WHEN 'L'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_l }|.
          WHEN 'M'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_m }|.
          WHEN 'S'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_s }|.
          WHEN OTHERS.
            str_line = |{ str_line }{ i_separador }{ <fs_es_componentes_tabla>-name }|.
        ENDCASE.

      ENDLOOP.

      REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

      IF i_omitir_salto_linea = abap_true.
        r_str = str_line && r_str.
      ELSE.
        r_str = str_line && cl_abap_char_utilities=>cr_lf && r_str.
      ENDIF.

    ENDIF.

  ENDMETHOD.

  METHOD es_a_string.

    DATA: str_line                 TYPE string,
          o_stdescribe             TYPE REF TO cl_abap_structdescr,
          o_tabledescr             TYPE REF TO cl_abap_tabledescr,
          o_elm_des                TYPE REF TO cl_abap_elemdescr,
          ti_columnas_tabla_d      TYPE cl_abap_structdescr=>component_table,
          indice_columna           TYPE i,
          r_tipo_no_dato_permitido TYPE RANGE OF c.

    FIELD-SYMBOLS: <fs_dato>     TYPE any,
                   <fs_ti_datos> TYPE ANY TABLE.

    r_tipo_no_dato_permitido = VALUE #( sign = 'I' option = 'EQ' ( low = 'h' )
                                                                 ( low = 'u' )
                                                                 ( low = 'v' ) ).

    IF i_ti_componente_estructura IS INITIAL.
      TRY.

          o_stdescribe ?= cl_abap_structdescr=>describe_by_data( i_es ).

          DATA(ti_componente_estructura) = o_stdescribe->get_components( ).

          "busca estructuras anidadas
          LOOP AT ti_componente_estructura INTO DATA(es_componente) WHERE name = space OR as_include EQ abap_true.
            o_stdescribe ?=  es_componente-type.
            APPEND LINES OF o_stdescribe->get_components( ) TO ti_columnas_tabla_d.
          ENDLOOP..

          DELETE ti_columnas_tabla_d WHERE name = space.
          "agrega componenes anidados
          APPEND LINES OF ti_columnas_tabla_d TO ti_componente_estructura.

          DELETE ti_componente_estructura WHERE name = space.

        CATCH cx_sy_move_cast_error ##NO_HANDLER.

      ENDTRY.

    ELSE.
      ti_componente_estructura = i_ti_componente_estructura.
    ENDIF.

    DO.

      indice_columna = sy-index.

      UNASSIGN <fs_dato>.

      ASSIGN COMPONENT indice_columna OF STRUCTURE i_es TO <fs_dato>.

      IF sy-subrc IS NOT INITIAL.
        IF lines( ti_componente_estructura ) = 1 AND i_es IS NOT INITIAL.
          ASSIGN i_es TO <fs_dato>.

          IF <fs_dato> IS NOT ASSIGNED OR indice_columna > lines( ti_componente_estructura ).
            EXIT.
          ENDIF.

        ELSE.
          EXIT.
        ENDIF.
      ENDIF.

      IF i_r_excluir_columnas IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name IN i_r_excluir_columnas.
        CONTINUE.
      ENDIF.
      "columnas que se excluyen
      IF i_caracter_exc_columna IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name(2) EQ i_caracter_exc_columna.
        CONTINUE.
      ENDIF.

      TRY.
          DESCRIBE FIELD <fs_dato> TYPE DATA(tp_componente).

          CHECK tp_componente NOT IN r_tipo_no_dato_permitido.

          str_line = |{ str_line }{ i_separador }{ <fs_dato> }|.
        CATCH cx_root.

      ENDTRY.

    ENDDO.

    REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

    r_str = str_line.

    """""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
    "Funcionalidad para incluir el encabezado de la tabla
    IF i_incluir_encabezado = abap_true.
      CLEAR str_line.

      "Recorrer los campos de la tabla
      LOOP AT ti_componente_estructura ASSIGNING FIELD-SYMBOL(<fs_es_componentes_tabla>).

        IF i_r_excluir_columnas IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name IN i_r_excluir_columnas.
          CONTINUE.
        ENDIF.
        "columnas que se excluyen
        IF i_caracter_exc_columna IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name(2) EQ i_caracter_exc_columna.
          CONTINUE.
        ENDIF.

        "Asigna la referencia del tipo del campo
        o_elm_des ?= <fs_es_componentes_tabla>-type.

        CASE i_longitud_texto_columna.
          WHEN 'L'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_l }|.
          WHEN 'M'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_m }|.
          WHEN 'S'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_s }|.
          WHEN OTHERS.
            str_line = |{ str_line }{ i_separador }{ <fs_es_componentes_tabla>-name }|.
        ENDCASE.

      ENDLOOP.

      REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

      r_str = str_line && cl_abap_char_utilities=>cr_lf && r_str.

    ENDIF.

  ENDMETHOD.

ENDCLASS.
