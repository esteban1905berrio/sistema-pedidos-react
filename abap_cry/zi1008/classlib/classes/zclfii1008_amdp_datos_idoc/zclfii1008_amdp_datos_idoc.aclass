        SELECT mandt, numero_idoc, mestyp, segnam, status, sociedad, belnr, gjahr, vrgng as tipo_doc, bldat, budat
        from :ti_datos_cebe;

        RETURN SELECT
        mandt,
        numero_idoc,
        mestyp,
        segnam,
        status,
        sociedad,
        belnr,
        gjahr,
        tipo_doc,
        bldat,
        budat
        from :ti_documentos;
  ENDMETHOD.

  METHOD log_idoc BY DATABASE FUNCTION FOR HDB
                LANGUAGE SQLSCRIPT
                OPTIONS READ-ONLY
                USING edidc edids.

    declare client varchar(3) := session_context ('CLIENT');

    ti_log_idoc = SELECT k.mandt, k.docnum, MAX( countr ) as countr
                  from edidc as k
                  inner join edids as d
                  ON d.mandt = k.mandt
                  and d.docnum = k.docnum
                  where k.mestyp IN ( 'FIDCC2', 'CODCMT', 'PRCDOC' )
                  group by  k.mandt, k.docnum;

    return select
             k.mandt,
             k.docnum as numero_idoc,
             mestyp,
             k.status,
             d.statyp,
             d.statxt,
             d.stapa1,
             d.stapa2,
             d.stapa3,
             d.stapa4,
             d.stamid,
             d.stamno,
             d.uname,
             logdat,
             logtim,
             d.countr
                from edidc as k
