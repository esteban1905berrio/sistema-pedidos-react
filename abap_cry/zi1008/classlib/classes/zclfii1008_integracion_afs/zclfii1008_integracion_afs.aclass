CLASS zclfii1008_integracion_afs IMPLEMENTATION.

  METHOD class_constructor.

    go_parametros = NEW zclcxr1000_parametros( i_modulo = 'FI' i_ricefw = 'I1008' ).

  ENDMETHOD.

  METHOD homologar_segmento_idoc.

    DATA: r_es_segmento             TYPE REF TO data,
          es_datos_idoc             LIKE LINE OF i_ti_datos_idoc,
          es_segmento_bkpf          TYPE  e1fikpf,
          es_segmento_bseg_sociedad TYPE gtp_es_segmento_bseg_sociedad.

    DATA(o_homologacion) = NEW zclmmi1009_homologacion_campos( i_c_ricefw = 'I1008'  ).

    CREATE DATA: r_es_segmento TYPE (i_nombre_segmento).
    CHECK sy-subrc IS INITIAL.

    ASSIGN: r_es_segmento->* TO FIELD-SYMBOL(<fs_es_segmento>).
    CHECK <fs_es_segmento> IS ASSIGNED.

    TRY.

        <fs_es_segmento> = c_es_datos_idoc-sdata.
        "Caso especial - Omitir documento CO con elementos PEP
        IF c_es_datos_idoc-segnam = 'E1COEP'.
          verificar_elemento_pep( <fs_es_segmento> ).
        ENDIF.

        "Caso especial - Homologar retenciones
        IF c_es_datos_idoc-segnam = 'E1FIXWT'.
          homologar_retencion( EXPORTING i_es_control_idoc = i_es_control_idoc
                                              i_o_homologacion  = o_homologacion
                                              i_ti_datos_idoc   = i_ti_datos_idoc
                                              i_nombre_segmento = i_nombre_segmento
                                    CHANGING  c_es_segmento_retenciones = <fs_es_segmento>
                                              c_ti_log_homologacion = c_ti_log_homologacion ).
        ELSE.
          "Caso especial -Agregar sociedad para completar homologaciones
          IF c_es_datos_idoc-segnam =  gc_segmento_bseg.

            es_segmento_bseg_sociedad = CORRESPONDING #( <fs_es_segmento> ).
            READ TABLE  i_ti_datos_idoc INTO es_datos_idoc WITH KEY segnam = gc_segmento_cabecera_docfi.
            es_segmento_bkpf = es_datos_idoc-sdata.
            es_segmento_bseg_sociedad-bukrs = es_segmento_bkpf-bukrs.

            ASSIGN es_segmento_bseg_sociedad TO <fs_es_segmento>.

          ENDIF.

          o_homologacion->homologar_campo( EXPORTING i_es_control_idoc = i_es_control_idoc
                                                     i_nombre_segmento = i_nombre_segmento
                                                     i_contador_segmento        = c_es_datos_idoc-segnum
                                                     i_r_excluir_varible_origen = i_r_excluir_varible_origen
                                           CHANGING  c_es = <fs_es_segmento>
                                                     c_ti_log_homologacion = c_ti_log_homologacion ).
        ENDIF.

        "asigna de nuevo los valores a la estructura origen
        IF es_segmento_bseg_sociedad IS NOT INITIAL.
          ASSIGN: r_es_segmento->* TO <fs_es_segmento>.
          <fs_es_segmento> = CORRESPONDING #( es_segmento_bseg_sociedad ).
        ENDIF.

        c_es_datos_idoc-sdata = <fs_es_segmento>.

        IF c_r_verificar_campo_lleno IS NOT INITIAL.
          LOOP AT c_r_verificar_campo_lleno ASSIGNING FIELD-SYMBOL(<fs_es_verificar_campo_lleno>).
            ASSIGN COMPONENT <fs_es_verificar_campo_lleno>-nombre_del_campo OF STRUCTURE <fs_es_segmento>
            TO FIELD-SYMBOL(<fs_valor_campo>).
            CHECK sy-subrc IS INITIAL AND <fs_valor_campo> IS NOT INITIAL.

            <fs_es_verificar_campo_lleno>-valor = <fs_valor_campo>.
            <fs_es_verificar_campo_lleno>-docnum = i_es_control_idoc-docnum.

          ENDLOOP.
        ENDIF.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.


  METHOD derivar_segmento_co.

    DATA: segmento         TYPE cepc-segment.

    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'I1008' ) = abap_true.

    LOOP AT c_ti_coep ASSIGNING FIELD-SYMBOL(<fs_es_coep>).

      SELECT SINGLE segment
        FROM cepc
        WHERE prctr = @<fs_es_coep>-prctr
        AND   kokrs = @<fs_es_coep>-kokrs
        INTO @segmento.

      IF sy-subrc IS INITIAL.
        <fs_es_coep>-segment = segmento.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD modifica_segmentos_idoc_codcmt.

    DATA: r_es_segmento    TYPE REF TO data,
          es_segmento_cobk TYPE e1cobk.

    FIELD-SYMBOLS: <fs_es_segmento_coep> TYPE e1coep.

    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'I1008' ) = abap_true.

    TRY.
        es_segmento_cobk = c_ti_datos_idoc[ segnam = 'E1COBK' ]-sdata.

        LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_idoc_data>) WHERE segnam = 'E1COEP'.

          CREATE DATA: r_es_segmento TYPE (<fs_es_idoc_data>-segnam).
          CHECK sy-subrc IS INITIAL.

          ASSIGN: r_es_segmento->* TO <fs_es_segmento_coep>.

          CHECK <fs_es_segmento_coep> IS ASSIGNED.

          TRY.
              <fs_es_segmento_coep> = <fs_es_idoc_data>-sdata.

              "Modificar datos necesarios de segmento E1COEP

            CATCH cx_sy_itab_line_not_found.
          ENDTRY.

        ENDLOOP.

      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

  ENDMETHOD.


  METHOD modificar_idoc_activo_fijo.

    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'I1008' ) = abap_true.

    "eliminar segmento
    DELETE c_ti_datos_idoc WHERE segnam = 'E2BP1022_GLO_RUS_TTX'.

  ENDMETHOD.


  METHOD homologar_idoccreateondatabase.

    DATA: r_excluir_varible_origen TYPE zclmmi1009_homologacion_campos=>gtp_r_variable_origen.

    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'I1008' ) = abap_true.
    "Evitar que se homologuen los codigo de BP para estos idoc
    IF c_es_control_idoc-mestyp = 'DEBMAS' OR c_es_control_idoc-mestyp = 'CREMAS'.
      r_excluir_varible_origen = VALUE #( sign = 'I' option = 'EQ' ( low = 'KUNNR' ) ( low = 'LIFNR' ) ).
    ENDIF.

    "Homologar campos
    LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_dato_idoc>).

      homologar_segmento_idoc(
        EXPORTING
          i_es_control_idoc     = c_es_control_idoc
          i_nombre_segmento     = <fs_es_dato_idoc>-segnam
          i_ti_datos_idoc       = c_ti_datos_idoc "Parametro necesario para lograr relacionar datos
          i_r_excluir_varible_origen = r_excluir_varible_origen
        CHANGING
          c_es_datos_idoc       = <fs_es_dato_idoc>
          c_ti_log_homologacion = e_ti_log_homologacion
          c_r_verificar_campo_lleno = c_r_verificar_campo_lleno ).

    ENDLOOP.
    "Homologaciones particulares
    CASE c_es_control_idoc-mestyp.
      WHEN 'DEBMAS'.
        procesar_idoc_debmas(
          CHANGING
            c_ti_datos_idoc   = c_ti_datos_idoc
            c_es_control_idoc = c_es_control_idoc  ).
      WHEN 'CREMAS'.
        procesar_idoc_cremas(
          CHANGING
            c_ti_datos_idoc   = c_ti_datos_idoc
            c_es_control_idoc = c_es_control_idoc  ).
      WHEN 'GLMAST'.
        procesar_idoc_glmast(
          CHANGING
            c_ti_datos_idoc   = c_ti_datos_idoc
            c_es_control_idoc = c_es_control_idoc  ).
      WHEN 'COACTV'.
        procesar_idoc_coactv(
          CHANGING
            c_ti_datos_idoc   = c_ti_datos_idoc
            c_es_control_idoc = c_es_control_idoc  ).
      WHEN 'COAMAS'.
        procesar_idoc_coamas(
          CHANGING
            c_ti_datos_idoc   = c_ti_datos_idoc
            c_es_control_idoc = c_es_control_idoc  ).
      WHEN 'PRCMAS'.
        procesar_idoc_prcmas(
          CHANGING
            c_ti_datos_idoc   = c_ti_datos_idoc
            c_es_control_idoc = c_es_control_idoc  ).
      WHEN 'COSMAS'.
        procesar_idoc_cosmas(
          CHANGING
            c_ti_datos_idoc   = c_ti_datos_idoc
            c_es_control_idoc = c_es_control_idoc  ).
    ENDCASE.

    SORT e_ti_log_homologacion BY docnum mestyp segnam var_origen val_varorigen var_destino val_vardestino.
    DELETE ADJACENT DUPLICATES FROM  e_ti_log_homologacion
    COMPARING docnum mestyp segnam var_origen val_varorigen var_destino val_vardestino.

    IF e_ti_log_homologacion IS NOT INITIAL AND i_escribir_log_en_bd = abap_true.
      "-SLS 17/08/2022 - Ya no es necesario mantener este LOG
***      MODIFY ztfii1008_3 FROM TABLE e_ti_log_homologacion.
    ENDIF.

  ENDMETHOD.


  METHOD procesar_idoc_cosmas.

    CONSTANTS c_segmento_registro_maestro TYPE string VALUE 'E1CSKSM'.

    DATA: r_es_segmento       TYPE REF TO data,
          es_registro_maestro TYPE e1csksm,
          r_cecos_excluir     TYPE RANGE OF coep-kostl.

    FIELD-SYMBOLS: <fs_es_segmento> TYPE any,
                   <fs_kostl>       TYPE kostl.

    go_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'EXC_CECO'
      IMPORTING
        e_ti_valrango           = r_cecos_excluir
      EXCEPTIONS
        parametro_no_encontrado = 1
        OTHERS                  = 2 ).

    zclcxr1002_util=>completar_rango(
      EXPORTING
        i_convertir_in  = abap_true
      CHANGING
        c_ti_rango      = r_cecos_excluir   ).


    LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_dato_idoc>).

      CREATE DATA: r_es_segmento TYPE (<fs_es_dato_idoc>-segnam).

      CHECK sy-subrc IS INITIAL.

      ASSIGN: r_es_segmento->* TO <fs_es_segmento>.

      CHECK <fs_es_segmento> IS ASSIGNED.


      <fs_es_segmento> = <fs_es_dato_idoc>-sdata.

      ASSIGN COMPONENT 'KOSTL' OF STRUCTURE <fs_es_segmento> TO <fs_kostl>.

      IF <fs_kostl> IS ASSIGNED AND <fs_kostl> IN r_cecos_excluir
                                AND r_cecos_excluir IS NOT INITIAL.

        RAISE EXCEPTION TYPE cx_t100_msg
          EXPORTING
            t100_msgid = 'ZFI01'
            t100_msgno = '019'
            t100_msgv1 = |{ <fs_kostl> ALPHA = OUT }|.
      ENDIF.

      TRY.
          "Homologar OBJNR, dado que es un valor compuesto por la sociedad CO y el CeCo
          IF <fs_es_dato_idoc>-segnam = c_segmento_registro_maestro.
            es_registro_maestro = <fs_es_dato_idoc>-sdata.

            IF es_registro_maestro-objnr(2) = 'KS'.

              CONCATENATE es_registro_maestro-objnr(6) es_registro_maestro-kostl
              INTO es_registro_maestro-objnr.

              <fs_es_dato_idoc>-sdata = es_registro_maestro.

            ENDIF.

          ENDIF.

        CATCH cx_root.

      ENDTRY.

    ENDLOOP.

  ENDMETHOD.


  METHOD procesar_idoc_glmast.

    DATA: r_es_segmento    TYPE REF TO data,
          r_cuenta_excluir TYPE RANGE OF bseg-prctr.

    FIELD-SYMBOLS: <fs_es_segmento> TYPE any,
                   <fs_saknr>       TYPE e1ska1m-saknr.

    go_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'EXC_CUENTA'
      IMPORTING
        e_ti_valrango           = r_cuenta_excluir
      EXCEPTIONS
        parametro_no_encontrado = 1
        OTHERS                  = 2 ).

    zclcxr1002_util=>completar_rango(
      EXPORTING
        i_convertir_in  = abap_true
      CHANGING
        c_ti_rango      = r_cuenta_excluir   ).


    LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_dato_idoc>).

      CREATE DATA: r_es_segmento TYPE (<fs_es_dato_idoc>-segnam).

      CHECK sy-subrc IS INITIAL.

      ASSIGN: r_es_segmento->* TO <fs_es_segmento>.

      CHECK <fs_es_segmento> IS ASSIGNED.


      <fs_es_segmento> = <fs_es_dato_idoc>-sdata.

      ASSIGN COMPONENT 'SAKNR' OF STRUCTURE <fs_es_segmento> TO <fs_saknr>.

      IF <fs_saknr> IS ASSIGNED AND <fs_saknr> IN r_cuenta_excluir
                                AND r_cuenta_excluir IS NOT INITIAL.

        RAISE EXCEPTION TYPE cx_t100_msg
          EXPORTING
            t100_msgid = 'ZFI01'
            t100_msgno = '021'
            t100_msgv1 = |{ <fs_saknr> ALPHA = OUT }|.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD procesar_idoc_prcmas.

    DATA: r_es_segmento  TYPE REF TO data,
          r_cebe_excluir TYPE RANGE OF bseg-prctr.

    FIELD-SYMBOLS: <fs_es_segmento> TYPE any,
                   <fs_prctr>       TYPE bseg-prctr.

    go_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'EXC_CEBE'
      IMPORTING
        e_ti_valrango           = r_cebe_excluir
      EXCEPTIONS
        parametro_no_encontrado = 1
        OTHERS                  = 2 ).

    zclcxr1002_util=>completar_rango(
      EXPORTING
        i_convertir_in  = abap_true
      CHANGING
        c_ti_rango      = r_cebe_excluir   ).


    LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_dato_idoc>).

      CREATE DATA: r_es_segmento TYPE (<fs_es_dato_idoc>-segnam).

      CHECK sy-subrc IS INITIAL.

      ASSIGN: r_es_segmento->* TO <fs_es_segmento>.

      CHECK <fs_es_segmento> IS ASSIGNED.


      <fs_es_segmento> = <fs_es_dato_idoc>-sdata.

      ASSIGN COMPONENT 'PRCTR' OF STRUCTURE <fs_es_segmento> TO <fs_prctr>.

      IF <fs_prctr> IS ASSIGNED AND <fs_prctr> IN r_cebe_excluir
                                AND r_cebe_excluir IS NOT INITIAL.

        RAISE EXCEPTION TYPE cx_t100_msg
          EXPORTING
            t100_msgid = 'ZFI01'
            t100_msgno = '020'
            t100_msgv1 = |{ <fs_prctr> ALPHA = OUT }|.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD enviar_idoc_activo_fijo.

    DATA: ti_bdi_logsys         TYPE STANDARD TABLE OF bdi_logsys,
          ti_bapi_sysv          TYPE STANDARD TABLE OF bapi_sysv,
          es_generaldata        TYPE bapi1022_feglg001,
          es_generaldatax       TYPE bapi1022_feglg001x,
          es_timedependentdata  TYPE bapi1022_feglg003,
          es_timedependentdatax TYPE bapi1022_feglg003x,
          es_allocations        TYPE bapi1022_feglg004,
          es_allocationsx       TYPE bapi1022_feglg004x,
          ti_depreciationareas  TYPE STANDARD TABLE OF bapi1022_dep_areas,
          es_depreciationareas  LIKE LINE OF ti_depreciationareas,
          ti_depreciationareasx TYPE STANDARD TABLE OF bapi1022_dep_areasx,
          es_depreciationareasx LIKE LINE OF ti_depreciationareasx,
          es_anlz               LIKE LINE OF i_ti_anlz,
          es_anla               LIKE LINE OF i_ti_anla,
          logsys                TYPE logsys.

    CASE i_evento.
      WHEN cl_faa_aa_services=>gc_event_project.
*     validate and check data
      WHEN cl_faa_aa_services=>gc_event_post."process data before DB update

        CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'I1008' ) = abap_true.

        "Tomar sistema destino
        CALL FUNCTION 'OWN_LOGICAL_SYSTEM_GET'
          IMPORTING
            own_logical_system             = logsys
          EXCEPTIONS
            own_logical_system_not_defined = 1
            OTHERS                         = 2.

        CALL FUNCTION 'BAPI_ALE_MODEL_GET'
          TABLES
            systemsinviews = ti_bapi_sysv.

        LOOP AT ti_bapi_sysv INTO DATA(es_bapi_sysv) WHERE cust_model = 'ZDATMAST' AND
                                                           logsystem NE logsys.
          ti_bdi_logsys = VALUE #( (  logsys = es_bapi_sysv-logsystem ) ).

          EXIT.
        ENDLOOP.


        CHECK ti_bdi_logsys IS NOT INITIAL.

        DATA(o_homologar) = NEW zclmmi1009_homologacion_campos(  ).

        LOOP AT i_ti_anlh INTO DATA(es_anlh).

          TRY.
              es_anla = i_ti_anla[ bukrs = es_anlh-bukrs anln1 = es_anlh-anln1 ].

              o_homologar->homologar_campo( CHANGING c_es = es_anlh ).
              o_homologar->homologar_campo( CHANGING c_es = es_anla ).

              es_generaldata = VALUE #( assetclass = es_anla-anlkl descript  = es_anla-txt50 descript2  = es_anla-txa50
                                      acct_detrm  = es_anla-ktogr  "Determinación de cuentas
                                      serial_no  = es_anla-sernr "Número de serie
                                      invent_no =  es_anla-invnr " Número de inventario
                                      quantity  = es_anla-menge base_uom  = es_anla-meins
                                      history  = es_anla-aneqk  "Se gestiona históricamente el activo fijo
                                      main_descript = es_anlh-anlhtxt ).

              es_allocations = VALUE #( evalgroup1 = es_anla-ord41 evalgroup2 = es_anla-ord42 evalgroup3 = es_anla-ord43
                                        evalgroup4 = es_anla-ord44 inv_reason = es_anla-izwek envir_invest = es_anla-umwkz
                                        assetsupno = es_anla-anlue ).

              "valoración
              LOOP AT i_ti_anlb INTO DATA(es_anlb) WHERE anln1 = es_anlh-anln1 AND bukrs = es_anlh-bukrs.

                o_homologar->homologar_campo( CHANGING c_es = es_anlb ).

                CLEAR: es_depreciationareas, es_depreciationareasx.

                es_depreciationareas =  VALUE
                bapi1022_dep_areas( area = es_anlb-afabe descript = es_anlb-ernam deactivate = es_anlb-xafbe
                                    dep_key = es_anlb-afasl ulife_yrs = es_anlb-ndjar ulife_prds = es_anlb-ndper
                                    orig_ulife_yrs = es_anlb-ndurj orig_ulife_prds = es_anlb-ndurp
                                    change_yr = es_anlb-umjar odep_start_date = es_anlb-afabg
                                    sdep_start_date  = es_anlb-safbg interest_start_date = es_anlb-zinbg
                                    readiness = es_anlb-inbda index = es_anlb-wbind age_index = es_anlb-alind
                                    var_dep_portion = es_anlb-aprop scrapvalue = es_anlb-schrw neg_values = es_anlb-xnega
                                    grp_asset = es_anlb-anlgr grp_asset_subno = es_anlb-anlgr2 acq_yr = es_anlb-vyear
                                    acq_prd = es_anlb-vmnth scrapvalue_prctg = es_anlb-schrw_proz from_date = es_anlb-adatu
                                    to_date = es_anlb-bdatu
                                  ).
                APPEND es_depreciationareas TO ti_depreciationareas.

                zclcxr1002_util=>asignar_marcado_estructura( EXPORTING  i_es_origen  = es_depreciationareas
                                                             CHANGING c_es_destino = es_depreciationareasx ).

                APPEND es_depreciationareasx TO ti_depreciationareasx.

              ENDLOOP.


              zclcxr1002_util=>asignar_marcado_estructura( EXPORTING  i_es_origen  = es_generaldata
                                                           CHANGING c_es_destino = es_generaldatax ).

              zclcxr1002_util=>asignar_marcado_estructura( EXPORTING  i_es_origen  = es_timedependentdata
                                                           CHANGING c_es_destino = es_timedependentdatax ).

              zclcxr1002_util=>asignar_marcado_estructura( EXPORTING  i_es_origen  = es_allocations
                                                           CHANGING c_es_destino = es_allocationsx ).

              es_anlz = i_ti_anlz[ anln1 = es_anlh-anln1 bukrs = es_anlh-bukrs ].

              o_homologar->homologar_campo( CHANGING c_es = es_anlz ).

              es_timedependentdata = VALUE #( to_date = es_anlz-bdatu from_date = es_anlz-adatu bus_area = es_anlz-gsber
                                          costcenter = es_anlz-kostl acttype = es_anlz-lstar
                                          profit_ctr = es_anlz-prctr resp_cctr = es_anlz-kostlv plant = es_anlz-werks
                                          location = es_anlz-stort room = es_anlz-raumn segment = es_anlz-segment ).

            CATCH cx_sy_itab_line_not_found cx_sy_itab_error.
          ENDTRY.

          CALL FUNCTION 'ALE_FIXEDASSET_CREATE'
            EXPORTING
              companycode          = es_anlh-bukrs
              asset                = es_anlh-anln1
              subnumber            = es_anlh-luntn
*             reference            =
*             createsubnumber      =
              generaldata          = es_generaldata
              generaldatax         = es_generaldatax
*             inventory            = es_inventory
*             inventoryx           = es_inventoryx
*             postinginformation   =
*             postinginformationx  =
              timedependentdata    = es_timedependentdata
              timedependentdatax   = es_timedependentdatax
              allocations          = es_allocations
              allocationsx         = es_allocationsx
*             origin               =
*             originx              =
*             investacctassignmnt  =
*             investacctassignmntx =
*             networthvaluation    =
*             networthvaluationx   =
*             realestate           =
*             realestatex          =
*             insurance            =
*             insurancex           =
*             leasing              =
*             leasingx             =
*             obj_type             = 'BUS1022'
*             serial_id            = '0'
            TABLES
              depreciationareas    = ti_depreciationareas
              depreciationareasx   = ti_depreciationareasx
*             extensionin          =
              receivers            = ti_bdi_logsys
*             communication_documents =
*             application_objects  =
            EXCEPTIONS
              error_creating_idocs = 1
              OTHERS               = 2.

          IF sy-subrc <> 0.
            MESSAGE ID sy-msgid TYPE 'I' NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
          ENDIF.

          COMMIT WORK AND WAIT.
        ENDLOOP.
    ENDCASE.
  ENDMETHOD.

  METHOD habilitar_doc_co_idoc_ficc2.

    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'I1008' ) = abap_true.

    c_comp = space.
    c_comp_check = space.
  ENDMETHOD.

  METHOD asignar_documento_anulacion.

    CONSTANTS: c_segmento_detalle TYPE string VALUE 'E1FINBU'.

    DATA: es_segmento_ekpf    TYPE e1fikpf,
          es_segmento_e1finbu TYPE e1finbu,
          ti_bkpf             TYPE bkpf_t,
          ti_bseg             TYPE bseg_t.

    TRY.
        es_segmento_ekpf = c_ti_datos_idoc[ segnam = gc_segmento_cabecera_docfi ]-sdata.

        "Para documentos de caja que se asigna documento de referencia
        IF es_segmento_ekpf-awtyp NE 'BKPF' AND es_segmento_ekpf-blart = 'SL'.
          es_segmento_ekpf-xblnr = es_segmento_ekpf-belnr.
          c_ti_datos_idoc[ segnam = gc_segmento_cabecera_docfi ]-sdata = es_segmento_ekpf.
        ENDIF.

        CHECK  es_segmento_ekpf-stblg IS NOT INITIAL.

        CALL FUNCTION 'FI_DOCUMENT_READ'
          EXPORTING
            i_awtyp     = es_segmento_ekpf-awtyp_rev
            i_awref     = es_segmento_ekpf-awref_rev
            i_aworg     = es_segmento_ekpf-aworg_rev
            i_awsys     = es_segmento_ekpf-awsys
          TABLES
            t_bkpf      = ti_bkpf
            t_bseg      = ti_bseg
          EXCEPTIONS
            wrong_input = 1
            not_found   = 2
            OTHERS      = 3.

        IF ti_bkpf IS NOT INITIAL.
          es_segmento_ekpf-stblg = ti_bkpf[ 1 ]-belnr.
          es_segmento_ekpf-stjah = ti_bkpf[ 1 ]-gjahr.

          c_ti_datos_idoc[ segnam = gc_segmento_cabecera_docfi ]-sdata = es_segmento_ekpf.
          "modificar segmento de posicion
          IF line_exists( c_ti_datos_idoc[ segnam = c_segmento_detalle ] ).
            es_segmento_e1finbu = c_ti_datos_idoc[ segnam = c_segmento_detalle ]-sdata.
            es_segmento_e1finbu-rebzg = es_segmento_ekpf-stblg.
            c_ti_datos_idoc[ segnam = c_segmento_detalle ]-sdata = es_segmento_e1finbu.
          ENDIF.

        ENDIF.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.

  METHOD completar_datos_cabecera_bp.

    CONSTANTS: c_segmento_cabecera_c TYPE string VALUE 'E1KNA1M',
               c_segmento_cabecera_p TYPE string VALUE 'E1LFA1M'.

    DATA: es_segmento_e1kna1m TYPE e1kna1m,
          es_segmento_e1lfa1m TYPE e1lfa1m,
          nombre_segmento     TYPE edidd-segnam,
          partner             TYPE but000-partner.

    CHECK i_nombre_segmento = c_segmento_cabecera_c  OR
          i_nombre_segmento = c_segmento_cabecera_p.

    DATA(o_homologacion) = NEW zclmmi1009_homologacion_campos( i_c_ricefw = 'I1008' ).

    TRY.

        IF i_cliente = abap_true.

          es_segmento_e1kna1m = c_ti_datos_idoc[ segnam = c_segmento_cabecera_c ]-sdata.
          partner = es_segmento_e1kna1m-kunnr.
          nombre_segmento = c_segmento_cabecera_c.

        ELSEIF i_proveedor = abap_true.

          es_segmento_e1lfa1m = c_ti_datos_idoc[ segnam = c_segmento_cabecera_p ]-sdata.
          partner = es_segmento_e1lfa1m-lifnr.
          nombre_segmento = c_segmento_cabecera_p.

        ENDIF.

        "Consultar clase_interlocutor
        SELECT SINGLE bp~partner, bpkind, tx~taxtype, tx~taxnum, bu_group AS ktokk, bu_group AS ktokd
        FROM but000 AS bp
        LEFT JOIN dfkkbptaxnum  AS tx
        ON tx~partner = bp~partner
        WHERE bp~partner = @partner
        INTO @DATA(es_datos_bp).

        IF sy-subrc IS INITIAL.
          "Regla para NIT vacio en KNA1/LFA1
          IF es_segmento_e1kna1m-stcd1 IS INITIAL.
            es_segmento_e1kna1m-stcd1 = es_datos_bp-taxnum.
          ENDIF.

          IF es_segmento_e1lfa1m-stcd1 IS INITIAL.
            es_segmento_e1lfa1m-stcd1 = es_datos_bp-taxnum.
          ENDIF.
          "Modificar NIT China{
***          IF es_datos_bp-taxtype = 'CN0' OR es_datos_bp-taxtype = 'CN5'.
***
***            IF es_segmento_e1kna1m-land1 = 'CN'.
***              es_segmento_e1kna1m-stcd5 = es_segmento_e1kna1m-stcd.
***              es_segmento_e1kna1m-stcd1 = es_datos_bp-taxnum.
***            ENDIF.
***
***            IF es_segmento_e1lfa1m-land1 = 'CN'.
***              es_segmento_e1lfa1m-stcd1 = es_segmento_e1lfa1m-stcd.
***              es_segmento_e1lfa1m-stcd1 = es_datos_bp-taxnum.
***            ENDIF.
***          ENDIF.
          "}
          "Numero de BP S4 para relacionar en AFS en campo STCD4
          es_segmento_e1kna1m-stcd4 = es_segmento_e1lfa1m-stcd4 = partner.

          "Para tiendas propias este campo debe tener el mismo numero en AFS
          IF es_datos_bp-ktokd = 'Z002'.
            es_segmento_e1kna1m-locco = |{ partner ALPHA = OUT }|.
          ENDIF.

          "El centro NO aplica en AFS por eso se limpia
          es_segmento_e1lfa1m-werks = es_segmento_e1kna1m-werks = space.

          "se actualiza el valor, para que en la proxima homologacion lo ejecute
          es_segmento_e1lfa1m-ktokk = es_datos_bp-ktokk.
          es_segmento_e1kna1m-ktokd = es_datos_bp-ktokd.
          "Solo homologar campos propios de BP, tablas BUTXXX
          o_homologacion->homologar_campo( EXPORTING i_es_control_idoc = VALUE #( mestyp = i_tipo_mensaje )
                                           CHANGING c_es = es_datos_bp ).

          es_segmento_e1kna1m-kukla = es_datos_bp-bpkind.

          c_ti_datos_idoc[ segnam = nombre_segmento ]-sdata = COND #( WHEN i_cliente = abap_true THEN
                                                                        es_segmento_e1kna1m
                                                                      ELSE
                                                                        es_segmento_e1lfa1m
                                                                     ).

        ENDIF.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.

  METHOD compensar_documento_anulado.

    DATA:
      tipo_registro_k          TYPE  stype_pi VALUE 'K',
      es_mensaje_retorno       TYPE bapiret2,
      ti_blntab                TYPE STANDARD TABLE OF blntab,
      ti_ftclear               TYPE STANDARD TABLE OF ftclear,
      ti_ftpost                TYPE STANDARD TABLE OF ftpost,
      ti_fttax                 TYPE STANDARD TABLE OF fttax,
      es_bkpf_documento_anular TYPE gtp_es_documento,
      codigo_retorno           TYPE i.


    "Ejecutar Commit para escribir documento en db
    COMMIT WORK AND WAIT.

    "buscar documento anulador
    SELECT SINGLE *
    FROM bkpf
    WHERE bukrs = @c_es_datos_documento-bukrs AND
          belnr = @c_es_datos_documento-belnr AND
          gjahr = @c_es_datos_documento-gjahr
    INTO @DATA(es_bkpf).

    CHECK sy-subrc IS INITIAL AND es_bkpf-stblg IS NOT INITIAL.

    "buscar documento que se anulara
    SELECT SINGLE k~bukrs, k~belnr, k~gjahr, k~blart, k~bldat, k~budat, k~monat, k~xblnr, k~stblg, koart, k~awkey
      FROM bkpf AS k
      INNER JOIN bseg AS i
      ON i~bukrs = k~bukrs
      AND i~belnr = k~belnr
      AND i~gjahr = i~gjahr
      AND i~buzei = '001'
      WHERE k~bukrs = @c_es_datos_documento-bukrs AND
            k~belnr = @es_bkpf-stblg AND
            k~gjahr = @c_es_datos_documento-gjahr
      INTO CORRESPONDING FIELDS OF @es_bkpf_documento_anular.

    CHECK sy-subrc IS INITIAL.

    asignar_xref2_doc_caja( i_es_bkpf_documento_anular = es_bkpf_documento_anular
                            i_es_bkpf_doc_anulador = es_bkpf ).

    "Datos para la conpensacion
    APPEND VALUE #( agkoa  = es_bkpf_documento_anular-koart
                    agbuk  = c_es_datos_documento-bukrs
                    xnops  = abap_true
                    selfd  = 'XBLNR'
                    selvon = es_bkpf_documento_anular-xblnr )
    TO ti_ftclear.

    "Datos en posicion
    APPEND LINES OF VALUE trty_tdia_ftpost( stype = tipo_registro_k count = '001'
                                              ( fnam = 'BKPF-BLDAT' fval = |{ es_bkpf-bldat+6(2) }{ es_bkpf-bldat+4(2) }{ es_bkpf-bldat(4) }| )
                                              "Clase de documento de compensacion
                                              ( fnam = 'BKPF-BLART'
                                                fval = |{ es_bkpf_documento_anular-koart }X|
                                              )
                                              ( fnam = 'BKPF-BUKRS' fval = c_es_datos_documento-bukrs )
                                              ( fnam = 'BKPF-BUDAT' fval = |{ sy-datum+6(2) }{ sy-datum+4(2) }{ sy-datum(4) }| )
                                              ( fnam = 'BKPF-MONAT' fval = es_bkpf-monat )
                                              ( fnam = 'BKPF-WAERS' fval = es_bkpf-waers )
                                              ( fnam = 'FS006-DOCID' fval = '*' )
                                              ( fnam = 'RF05A-XPOS1' fval = abap_true )
                                              ( fnam = 'BKPF-XBLNR' fval = es_bkpf-belnr )
                                              ( fnam = 'BKPF-AWTYP' fval = es_bkpf-awtyp )
                                              ( fnam = 'BKPF-AWKEY' fval = es_bkpf_documento_anular-awkey )
                                          )
    TO ti_ftpost.

    "Los siguientes FM se deben llamar en el orden indicado
    CALL FUNCTION 'POSTING_INTERFACE_START'
      EXPORTING
        i_client           = sy-mandt
        i_function         = 'C' "( Function: BDC, Call Trans. Using, internal interface)
        i_mode             = 'N' "( N - no screen, A - all screen, E - Error -> Mode we use in Call transaction)
        i_user             = sy-uname
      EXCEPTIONS
        client_incorrect   = 1
        function_invalid   = 2
        group_name_missing = 3
        mode_invalid       = 4
        update_invalid     = 5
        OTHERS             = 6.

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    "Compensar partidas
    CALL FUNCTION 'POSTING_INTERFACE_CLEARING'
      EXPORTING
        i_auglv                    = 'EINGZAHL'
        i_tcode                    = 'FB05'
        i_sgfunct                  = 'C'
      IMPORTING
        e_msgid                    = es_mensaje_retorno-id
        e_msgno                    = es_mensaje_retorno-number
        e_msgty                    = es_mensaje_retorno-type
        e_msgv1                    = es_mensaje_retorno-message_v1
        e_msgv2                    = es_mensaje_retorno-message_v2
        e_msgv3                    = es_mensaje_retorno-message_v3
        e_msgv4                    = es_mensaje_retorno-message_v4
        e_subrc                    = codigo_retorno
      TABLES
        t_blntab                   = ti_blntab
        t_ftclear                  = ti_ftclear
        t_ftpost                   = ti_ftpost
        t_fttax                    = ti_fttax
      EXCEPTIONS
        clearing_procedure_invalid = 1
        clearing_procedure_missing = 2
        table_t041a_empty          = 3
        transaction_code_invalid   = 4
        amount_format_error        = 5
        too_many_line_items        = 6
        company_code_invalid       = 7
        screen_not_found           = 8
        no_authorization           = 9
        OTHERS                     = 10.

    CALL FUNCTION 'POSTING_INTERFACE_END'
      EXPORTING
        i_bdcimmed              = 'X'
      EXCEPTIONS
        session_not_processable = 1
        OTHERS                  = 2.



  ENDMETHOD.

  METHOD validar_cl_impuesto_bp.

    DATA: es_segmento_retenciones TYPE e1fixwt,
          es_segmento_ekpf        TYPE e1fikpf,
          es_segmento_detalle     TYPE e1finbu,
          tipo_retencion          TYPE lfbw-witht.

    TRY.

        es_segmento_ekpf = c_ti_datos_idoc[ segnam = gc_segmento_cabecera_docfi ]-sdata.
        es_segmento_detalle = c_ti_datos_idoc[ segnam = gc_segmento_detalle_bseg_sub ]-sdata.

        LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_segmento_idoc>) WHERE segnam = gc_segmento_retenciones.

          CLEAR: tipo_retencion, es_segmento_retenciones.

          es_segmento_retenciones = <fs_segmento_idoc>-sdata.
          es_segmento_detalle-lifnr = |{ es_segmento_detalle-lifnr ALPHA = IN }|.
          es_segmento_detalle-kunnr = |{ es_segmento_detalle-kunnr ALPHA = IN }|.

          IF es_segmento_detalle-lifnr IS NOT INITIAL.

            SELECT SINGLE witht
            FROM lfbw
            WHERE lifnr = @es_segmento_detalle-lifnr
            AND   bukrs = @es_segmento_ekpf-bukrs
            AND   witht = @es_segmento_retenciones-witht
            INTO @tipo_retencion.

          ELSEIF es_segmento_detalle-kunnr IS NOT INITIAL.
            SELECT SINGLE witht
            FROM knbw
            WHERE kunnr = @es_segmento_detalle-kunnr
            AND   bukrs = @es_segmento_ekpf-bukrs
            AND   witht = @es_segmento_retenciones-witht
            INTO @tipo_retencion.
          ELSE.
            CONTINUE.
          ENDIF.

          IF tipo_retencion IS INITIAL.

            DELETE TABLE c_ti_datos_idoc FROM <fs_segmento_idoc>.
            CONTINUE.
***            es_segmento_detalle-lifnr = |{ es_segmento_detalle-lifnr ALPHA = OUT }|.
***            es_segmento_detalle-kunnr = |{ es_segmento_detalle-kunnr ALPHA = OUT }|.
***            MESSAGE e018(zfi01) WITH es_segmento_retenciones-witht COND #( WHEN es_segmento_detalle-lifnr IS NOT INITIAL THEN
***                                                                              es_segmento_detalle-lifnr
***                                                                           ELSE
***                                                                              es_segmento_detalle-kunnr ).

          ENDIF.

        ENDLOOP.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.

  METHOD vf_limite_credito_cliente.

    DATA: es_reultado_vf       TYPE ukm_s_query_result,
          grupo_credito_cumple TYPE flag.

    i_cliente = |{ i_cliente ALPHA = IN }|.

    SELECT SINGLE c~partner, limit_rule, check_rule, s~credit_sgmnt, sc~currency
    FROM ukmbp_cms AS c
    INNER JOIN ukmbp_cms_sgm AS s
    ON s~partner = c~partner
    INNER JOIN ukmcred_sgm0c AS sc
    ON sc~credit_sgmnt = s~credit_sgmnt
    AND sc~currency = @i_moneda
    WHERE c~partner = @i_cliente
    INTO @DATA(es_datos_maestros_creditos).

    CHECK sy-subrc IS INITIAL.

    IF i_clase_pedido IS NOT INITIAL.

      IF i_grupo_de_credito = 'Z2' OR i_grupo_de_credito = 'Z6' OR i_grupo_de_credito = 'Z1'.
        grupo_credito_cumple = abap_true.
      ENDIF.

    ENDIF.

    IF i_clase_entrega IS NOT INITIAL.

      IF i_grupo_de_credito = 'Z3' OR i_grupo_de_credito = 'Z7'.
        grupo_credito_cumple = abap_true.
      ENDIF.
    ENDIF.
    "Indiador para acotar proceso unicamente cuando la verifiacion se realice desde AFS
    g_verificacion_desde_afs = abap_true.

    CALL FUNCTION 'UKM_CREDIT_CHECK_SIMU'
      EXPORTING
        i_partner    = i_cliente
        i_segment    = es_datos_maestros_creditos-credit_sgmnt
        i_limit_rule = es_datos_maestros_creditos-limit_rule
        i_check_rule = es_datos_maestros_creditos-check_rule
        i_amount     = i_valor_pedido
        i_currency   = i_moneda
        i_no_dialog  = abap_true.
    "parametro no necesario ya que se importa resultado de memoria, por falla en el FM estandar
*      IMPORTING
*       e_check_result = es_reultado_vf.

    IMPORT es_resultado_verificacion = es_reultado_vf
    FROM DATABASE indx(sc) ID 'RESULTADO_VERIFICACION'.

    DELETE FROM DATABASE indx(sc) ID 'RESULTADO_VERIFICACION'.

    IF i_clase_pedido IS NOT INITIAL.
      e_bloquear_pedido = COND #( WHEN grupo_credito_cumple = abap_true AND
                                     ( es_reultado_vf-risk_class = 'D' OR es_reultado_vf-risk_class = 'E' ) THEN
                                          abap_true
                                  WHEN ( es_reultado_vf-risk_class = 'C' OR es_reultado_vf-risk_class = 'B' ) AND
                                         line_exists( es_reultado_vf-denial_reasons[ msgty = 'E' ] ) THEN
                                          abap_true
                                  ).
    ENDIF.

    IF i_clase_entrega IS NOT INITIAL.
      e_bloquear_entrega = COND #( WHEN grupo_credito_cumple = abap_true AND
                                     ( es_reultado_vf-risk_class = 'D' OR es_reultado_vf-risk_class = 'E' ) THEN
                                          abap_true
                                  WHEN ( es_reultado_vf-risk_class = 'C' OR es_reultado_vf-risk_class = 'B' ) AND
                                         line_exists( es_reultado_vf-denial_reasons[ msgty = 'E' ] ) THEN
                                          abap_true
                                  ).
    ENDIF.

    IF  line_exists( es_reultado_vf-denial_reasons[ msgty = 'E' ] ).
      e_limite_exedido = abap_true.
      e_ti_msg_resultado = VALUE #( FOR es_msg IN es_reultado_vf-denial_reasons
                                      ( id = es_msg-msgid number = es_msg-msgno type = es_msg-msgty
                                        message_v1 = es_msg-msgv1 message_v2 = es_msg-msgv2
                                        message_v3 = es_msg-msgv3 message_v4 = es_msg-msgv4 )
                                  ).

      LOOP AT e_ti_msg_resultado ASSIGNING FIELD-SYMBOL(<fs_es_msg>).
        MESSAGE ID <fs_es_msg>-id   TYPE <fs_es_msg>-type NUMBER <fs_es_msg>-number
        WITH <fs_es_msg>-message_v1 <fs_es_msg>-message_v2 <fs_es_msg>-message_v3 <fs_es_msg>-message_v4
        INTO <fs_es_msg>-message.
      ENDLOOP.
    ENDIF.

  ENDMETHOD.

  METHOD exporta_resultadolimitecredito.
*    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'I1008' ) = abap_true.
    "Debido a que el FM estandar no retorna el valor se exporta a memoria para realizar la validacion

    CHECK g_verificacion_desde_afs = abap_true.

    EXPORT es_resultado_verificacion = c_es_resultado_verificacion
    TO DATABASE indx(sc) ID 'RESULTADO_VERIFICACION'.

    g_verificacion_desde_afs = abap_false.

  ENDMETHOD.

  METHOD completa_documento_anular_caja.
    LOOP AT c_ti_accit ASSIGNING FIELD-SYMBOL(<fs_es_accit>) WHERE awtyp = gc_operacion_caja.
      <fs_es_accit>-follow_on = abap_true.
    ENDLOOP.
  ENDMETHOD.


  METHOD asignar_xref2_doc_caja.

    DATA: ti_accchg  TYPE STANDARD TABLE OF accchg.

    CHECK i_es_bkpf_doc_anulador-awtyp = gc_operacion_caja.

    "Asignar numero de documento anulador a documento anulado
    APPEND VALUE #( newval = i_es_bkpf_doc_anulador-belnr fdname = 'XREF2' ) TO ti_accchg.
    "consultar posiciones para modificar BSEG
    SELECT bukrs, belnr, gjahr, buzei
    FROM bseg
    WHERE bukrs  = @i_es_bkpf_documento_anular-bukrs
      AND belnr  = @i_es_bkpf_documento_anular-belnr
      AND gjahr  = @i_es_bkpf_documento_anular-gjahr
    INTO TABLE @DATA(ti_bseg_anular).

    LOOP AT ti_bseg_anular ASSIGNING FIELD-SYMBOL(<fs_es_bseg>).
      CALL FUNCTION 'FI_DOCUMENT_CHANGE'
        EXPORTING
          i_bukrs              = i_es_bkpf_documento_anular-bukrs
          i_belnr              = i_es_bkpf_documento_anular-belnr
          i_gjahr              = i_es_bkpf_documento_anular-gjahr
          i_buzei              = <fs_es_bseg>-buzei
        TABLES
          t_accchg             = ti_accchg
        EXCEPTIONS
          no_reference         = 1
          no_document          = 2
          many_documents       = 3
          wrong_input          = 4
          overwrite_creditcard = 5
          OTHERS               = 6.

      IF sy-subrc = 0.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
          EXPORTING
            wait = abap_true.
      ENDIF.

    ENDLOOP.

    CLEAR: ti_bseg_anular.
    "consultar posiciones para modificar BSEG
    SELECT bukrs, belnr, gjahr, buzei
    FROM bseg
    WHERE bukrs  = @i_es_bkpf_doc_anulador-bukrs
      AND belnr  = @i_es_bkpf_doc_anulador-belnr
      AND gjahr  = @i_es_bkpf_doc_anulador-gjahr
    INTO TABLE @ti_bseg_anular.

    LOOP AT ti_bseg_anular ASSIGNING <fs_es_bseg>.
      "Asignar numero de documento anulado a documento anulador
      CALL FUNCTION 'FI_DOCUMENT_CHANGE'
        EXPORTING
          i_bukrs              = i_es_bkpf_doc_anulador-bukrs
          i_belnr              = i_es_bkpf_doc_anulador-belnr
          i_gjahr              = i_es_bkpf_doc_anulador-gjahr
          i_buzei              = <fs_es_bseg>-buzei
        TABLES
          t_accchg             = ti_accchg
        EXCEPTIONS
          no_reference         = 1
          no_document          = 2
          many_documents       = 3
          wrong_input          = 4
          overwrite_creditcard = 5
          OTHERS               = 6.

      IF sy-subrc = 0.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
          EXPORTING
            wait = abap_true.
      ENDIF.
    ENDLOOP.

  ENDMETHOD.


  METHOD procesar_idoc_debmas.

    CONSTANTS: c_segmento_retencion_c       TYPE string VALUE 'E1KNBWM',
               c_segmento_datos_comerciales TYPE string VALUE 'E1KNVVM',
               c_segmento_cabecera_c        TYPE string VALUE 'E1KNA1M',
               "{Inicio SGR
               c_segmento_interlocutor      TYPE string VALUE 'E1KNVPM'.
*              "{Fin SGR

    DATA: es_segmento_retencion_c  TYPE e1knbwm,
          es_segmento_e1kna1m      TYPE e1kna1m,
          es_segmento_e1knvvm      TYPE e1knvvm,
          es_retenciones           TYPE gtp_es_retenciones,
          "{Inicio SGR
          es_segmento_interlocutor TYPE e1knvpm.
*         "{Fin SGR


    DATA(o_homologacion) = NEW zclmmi1009_homologacion_campos( i_c_ricefw = 'I1008' ).

    TRY.
        "asignar campo KALKS_NEW en KALKS, debido a que el campo tiene una longitud inferior en AFS
        es_segmento_e1knvvm = c_ti_datos_idoc[ segnam = c_segmento_datos_comerciales ]-sdata.
        es_segmento_e1knvvm-kalks = es_segmento_e1knvvm-kalks_new.
        c_ti_datos_idoc[ segnam = c_segmento_datos_comerciales ]-sdata = es_segmento_e1knvvm.

      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    TRY.
        es_segmento_e1kna1m = c_ti_datos_idoc[ segnam = c_segmento_cabecera_c ]-sdata.

        "{Inicio SGR
        LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_retenciones_c>). "WHERE segnam = c_segmento_retencion_c.
          "homolocacion de retenciones cliente
          IF <fs_retenciones_c>-segnam = c_segmento_retencion_c.
            es_segmento_retencion_c = <fs_retenciones_c>-sdata.

            es_retenciones = VALUE #( land1 = es_segmento_e1kna1m-land1
                                      witht = es_segmento_retencion_c-witht wt_withcd = es_segmento_retencion_c-wt_withcd  ).

            o_homologacion->homologar_campo( CHANGING c_es = es_retenciones ).

            es_segmento_retencion_c-witht = es_retenciones-witht.
            es_segmento_retencion_c-wt_withcd = es_retenciones-wt_withcd.

            <fs_retenciones_c>-sdata = es_segmento_retencion_c.
          ENDIF.

          "Funciones de interlocutor cliente
          IF <fs_retenciones_c>-segnam = c_segmento_interlocutor.

            es_segmento_interlocutor = <fs_retenciones_c>-sdata.

            IF es_segmento_interlocutor-parvw EQ 'RG' AND es_segmento_interlocutor-kunn2 EQ '0000001100'.
              es_segmento_interlocutor-kunn2 = '0000004000'.
            ENDIF.

            <fs_retenciones_c>-sdata = es_segmento_interlocutor.

          ENDIF.
          "{Fin SGR
        ENDLOOP.

      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    "asignar numero de cliente/acreedor correspondiente en AFS segun valor en campo KNB1-ALTKN y LFB1-ALTKN
    asignar_numero_cliente_afs( CHANGING c_ti_datos_idoc = c_ti_datos_idoc c_es_control_idoc = c_es_control_idoc ).

  ENDMETHOD.


  METHOD procesar_idoc_cremas.

    CONSTANTS: c_segmento_retencion_p  TYPE string VALUE 'E1LFBWM',
               c_segmento_interlocutor TYPE string VALUE 'E1WYT3M',
               c_segmento_cabecera_p   TYPE string VALUE 'E1LFA1M'.

    DATA: es_segmento_e1lfa1m            TYPE e1lfa1m,
          es_segmento_retencion_p        TYPE e1lfbwm,
          es_segmento_interlocutor       TYPE e1wyt3m,
          es_segmento_org_compra         TYPE e1lfm1m,
          es_retenciones                 TYPE gtp_es_retenciones,
          r_excluir_funcion_interlocutor TYPE RANGE OF knvp-parvw.

    DATA(o_homologacion) = NEW zclmmi1009_homologacion_campos( i_c_ricefw = 'I1008' ).

    go_parametros->get_parametro( EXPORTING
                                    i_idparam               = 'EXC_FINT'
                                  IMPORTING
                                    e_ti_valrango           = r_excluir_funcion_interlocutor
                                  EXCEPTIONS
                                    parametro_no_encontrado = 1
                                    OTHERS                  = 2 ).
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    TRY.
        es_segmento_e1lfa1m = c_ti_datos_idoc[ segnam = c_segmento_cabecera_p ]-sdata.
        "Consultamos los datos de retenciones para el proveedor
        SELECT *
        FROM lfbw
        WHERE lifnr = @es_segmento_e1lfa1m-lifnr
        INTO TABLE @DATA(ti_tp_retencion).

        LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_retenciones_p>).
          "Para Grupo de compras que empiezan por 2, se debe asignar Org.compras 1002 para eviar hacia AFS
          IF <fs_retenciones_p>-segnam = 'E1LFM1M'.

            es_segmento_org_compra = <fs_retenciones_p>-sdata.

            IF es_segmento_org_compra-ekgrp(1) = '2'.
              es_segmento_org_compra-ekorg = '1002'.
            ENDIF.

            es_segmento_org_compra-kalsk = space."+SLS 01.07.2022 - Cambio soliitado por Lili

            <fs_retenciones_p>-sdata = es_segmento_org_compra.

          ENDIF.

          "excluir funciones de interlocutor proveedor
          IF <fs_retenciones_p>-segnam = c_segmento_interlocutor.
            es_segmento_interlocutor = <fs_retenciones_p>-sdata.

            IF es_segmento_interlocutor-parvw IN r_excluir_funcion_interlocutor AND
               r_excluir_funcion_interlocutor IS NOT INITIAL.

              DELETE TABLE c_ti_datos_idoc FROM <fs_retenciones_p>.
              CONTINUE.

            ENDIF.

          ENDIF.
          "homolocacion de retenciones proveedor
          IF <fs_retenciones_p>-segnam = c_segmento_retencion_p.
            es_segmento_retencion_p = <fs_retenciones_p>-sdata.

            es_retenciones = VALUE #( land1 = es_segmento_e1lfa1m-land1
                                      witht = es_segmento_retencion_p-witht
                                      wt_withcd = COND #( WHEN es_segmento_retencion_p-wt_withcd IS NOT INITIAL THEN
                                                            es_segmento_retencion_p-wt_withcd
                                                          WHEN line_exists( ti_tp_retencion[ lifnr = es_segmento_retencion_p-lifnr
                                                                                             bukrs = es_segmento_retencion_p-bukrs
                                                                                             witht = es_segmento_retencion_p-witht
                                                                                           ] ) THEN
                                                             ti_tp_retencion[ lifnr = es_segmento_retencion_p-lifnr
                                                                              bukrs = es_segmento_retencion_p-bukrs
                                                                              witht = es_segmento_retencion_p-witht ]-wt_withcd
                                                        )
                                     ).

            o_homologacion->homologar_campo( CHANGING c_es = es_retenciones ).

            es_segmento_retencion_p-witht = es_retenciones-witht.
            es_segmento_retencion_p-wt_withcd = es_retenciones-wt_withcd.

            <fs_retenciones_p>-sdata = es_segmento_retencion_p.

          ENDIF.

        ENDLOOP.

      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    "asignar numero de cliente/acreedor correspondiente en AFS segun valor en campo KNB1-ALTKN y LFB1-ALTKN
    asignar_numero_proveedor_afs( CHANGING c_ti_datos_idoc = c_ti_datos_idoc c_es_control_idoc = c_es_control_idoc ).

  ENDMETHOD.

  METHOD procesar_idoc_coactv.

    DATA: es_registro_maestro TYPE e1cssl.



    SELECT *
    FROM ztfii1008_2
    INTO TABLE @DATA(ti_excluir_tarifa).

    TRY.

        es_registro_maestro = c_ti_datos_idoc[ segnam = 'E1CSSL' ]-sdata.

        IF line_exists( ti_excluir_tarifa[ kokrs = es_registro_maestro-kokrs
                                           kostl = es_registro_maestro-kostl
                                           lstar = es_registro_maestro-lstar
                                           gjahr = es_registro_maestro-gjahr
                                         ] ).

          RAISE EXCEPTION TYPE cx_t100_msg
            EXPORTING
              t100_msgid = 'ZFI01'
              t100_msgno = '022'
              t100_msgv1 = |{ es_registro_maestro-kokrs ALPHA = OUT }|
              t100_msgv2 = |{ es_registro_maestro-kostl ALPHA = OUT }|
              t100_msgv3 = |{ es_registro_maestro-lstar ALPHA = OUT }|
              t100_msgv4 = |{ es_registro_maestro-gjahr ALPHA = OUT }|.
        ENDIF.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.

  METHOD procesar_idoc_coamas.

    DATA: es_registro_maestro TYPE e1cslam.



    SELECT *
    FROM ztfii1008_1
    INTO TABLE @DATA(ti_excluir_clase_actividad).

    TRY.

        es_registro_maestro = c_ti_datos_idoc[ segnam = 'E1CSLAM' ]-sdata.

        IF line_exists( ti_excluir_clase_actividad[ kokrs = es_registro_maestro-kokrs
                                                    lstar = es_registro_maestro-lstar
                                                  ] ).

          RAISE EXCEPTION TYPE cx_t100_msg
            EXPORTING
              t100_msgid = 'ZFI01'
              t100_msgno = '023'
              t100_msgv1 = |{ es_registro_maestro-kokrs ALPHA = OUT }|
              t100_msgv2 = |{ es_registro_maestro-lstar ALPHA = OUT }|.
        ENDIF.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.


  METHOD asignar_numero_cliente_afs.

    CONSTANTS: c_segmento_cabecera TYPE string VALUE 'E1KNA1M'.

    DATA: es_segmento_e1kna1m TYPE e1kna1m,
          numero_cliente_afs  TYPE kna1-kunnr,
          r_es_segmento       TYPE REF TO data.

    FIELD-SYMBOLS: <fs_kunnr>       TYPE kunnr,
                   <fs_es_segmento> TYPE any.

    TRY.

        es_segmento_e1kna1m = c_ti_datos_idoc[ segnam = c_segmento_cabecera ]-sdata.
        "consulta datos a nivel de sociedad
        SELECT SINGLE *
        FROM knb1
        WHERE kunnr = @es_segmento_e1kna1m-kunnr AND
              altkn IS NOT INITIAL
        INTO @DATA(es_knb1).

        CHECK es_knb1  IS NOT INITIAL.

        numero_cliente_afs = |{ es_knb1-altkn ALPHA = IN }|.

        LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_dato_idoc>).
          FREE: r_es_segmento.
          UNASSIGN: <fs_es_segmento>.

          CREATE DATA r_es_segmento TYPE (<fs_es_dato_idoc>-segnam).
          CHECK r_es_segmento IS NOT INITIAL.

          ASSIGN: r_es_segmento->* TO <fs_es_segmento>.
          CHECK sy-subrc IS INITIAL.

          <fs_es_segmento> = <fs_es_dato_idoc>-sdata.

          UNASSIGN: <fs_kunnr>.

          ASSIGN COMPONENT 'KUNNR' OF STRUCTURE <fs_es_segmento> TO <fs_kunnr>.
          IF sy-subrc IS INITIAL.
            <fs_kunnr> = numero_cliente_afs.
          ENDIF.

          ASSIGN COMPONENT 'KUNN2' OF STRUCTURE <fs_es_segmento> TO <fs_kunnr>.
          IF sy-subrc IS INITIAL AND
            <fs_kunnr> = numero_cliente_afs.
          ENDIF.

          ASSIGN COMPONENT 'KNKLI' OF STRUCTURE <fs_es_segmento> TO <fs_kunnr>.
          IF sy-subrc IS INITIAL AND
             <fs_kunnr> = numero_cliente_afs.
          ENDIF.

          CHECK <fs_kunnr> IS ASSIGNED.

          <fs_es_dato_idoc>-sdata = <fs_es_segmento>.

        ENDLOOP.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.


  ENDMETHOD.

  METHOD asignar_numero_proveedor_afs.

    CONSTANTS: c_segmento_cabecera_p TYPE string VALUE 'E1LFA1M'.

    DATA: es_segmento_e1lfa1m  TYPE e1lfa1m,
          numero_proveedor_afs TYPE lfa1-lifnr,
          r_es_segmento        TYPE REF TO data.

    FIELD-SYMBOLS: <fs_lifnr>       TYPE lifnr,
                   <fs_es_segmento> TYPE any.

    TRY.

        es_segmento_e1lfa1m = c_ti_datos_idoc[ segnam = c_segmento_cabecera_p ]-sdata.

        SELECT SINGLE *
        FROM lfb1
        WHERE lifnr = @es_segmento_e1lfa1m-lifnr AND
              altkn IS NOT INITIAL
        INTO @DATA(es_lfb1).

        CHECK es_lfb1 IS NOT INITIAL.

        numero_proveedor_afs = |{ es_lfb1-altkn ALPHA = IN }|.

        LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_dato_idoc>).
          FREE: r_es_segmento.
          UNASSIGN: <fs_es_segmento>.

          CREATE DATA r_es_segmento TYPE (<fs_es_dato_idoc>-segnam).
          CHECK r_es_segmento IS NOT INITIAL.

          ASSIGN: r_es_segmento->* TO <fs_es_segmento>.
          CHECK sy-subrc IS INITIAL.

          <fs_es_segmento> = <fs_es_dato_idoc>-sdata.

          UNASSIGN: <fs_lifnr>.

          ASSIGN COMPONENT 'LIFNR' OF STRUCTURE <fs_es_segmento> TO <fs_lifnr>.
          IF sy-subrc IS INITIAL.
            <fs_lifnr> = numero_proveedor_afs.
          ENDIF.

          ASSIGN COMPONENT 'LIFN2' OF STRUCTURE <fs_es_segmento> TO <fs_lifnr>.
          IF sy-subrc IS INITIAL.
            <fs_lifnr> = numero_proveedor_afs.
          ENDIF.

          CHECK <fs_lifnr> IS ASSIGNED.

          <fs_es_dato_idoc>-sdata = <fs_es_segmento>.

        ENDLOOP.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.

  METHOD envia_idoc_acreedor_modificado.

    CONSTANTS: c_tipo_mensaje TYPE bdcp2-mestype VALUE 'CREMAS'.

    DATA: ti_proveedor  TYPE RANGE OF lifnr,
          ti_bdicpident TYPE STANDARD TABLE OF  bdicpident.

    "Consultar punteros de moficicacion activos
    SELECT *
    FROM bdcp2
    WHERE mestype = @c_tipo_mensaje
    AND   process = @abap_false
    INTO TABLE @DATA(ti_proveedor_modificados).

    CHECK sy-subrc IS INITIAL.

    LOOP AT ti_proveedor_modificados INTO DATA(es_proveedor_modificado).
      APPEND VALUE #( sign = 'I' option = 'EQ' low = es_proveedor_modificado-tabkey+3(10) )
      TO ti_proveedor.

      APPEND VALUE #( cpident = es_proveedor_modificado-cpident )
      TO  ti_bdicpident.
    ENDLOOP.

    SORT ti_proveedor BY low.
    DELETE ADJACENT DUPLICATES FROM ti_proveedor COMPARING ALL FIELDS.

    CHECK ti_bdicpident IS NOT INITIAL.
    "Cerrar puntero de modificacion
    CALL FUNCTION 'CHANGE_POINTERS_STATUS_WRITE'
      EXPORTING
        message_type           = c_tipo_mensaje
      TABLES
        change_pointers_idents = ti_bdicpident.

    SUBMIT rbdsecre WITH sellifnr IN ti_proveedor
                    WITH mestyp = c_tipo_mensaje.

  ENDMETHOD.

  METHOD envia_idoc_cliente_modificado.

    CONSTANTS: c_tipo_mensaje TYPE bdcp2-mestype VALUE 'DEBMAS'.

    DATA: ti_clientes      TYPE RANGE OF kunnr,
          r_tablas_centros TYPE RANGE OF bdcp2-tabname,
          ti_bdicpident    TYPE STANDARD TABLE OF  bdicpident.

    r_tablas_centros = VALUE #( sign = 'I' option = 'EQ' ( low = 'WRF1' )
                                                         ( low = 'WRF3' )
                                                         ( low = 'WRF4' )
                                                         ( low = 'WRF5' )
                                                         ( low = 'WRF6' )
                                                         ( low = 'WRF12' )
                                                         ( low = 'T023X' )
                                                         ( low = 'T023W' )
                                                         ( low = 'T001W' )
                              ).

    "Consultar punteros de moficicacion activos
    SELECT *
    FROM bdcp2
    WHERE mestype = @c_tipo_mensaje
    AND   process = @abap_false
    INTO TABLE @DATA(ti_clientes_modificados).

    CHECK sy-subrc IS INITIAL.

    LOOP AT ti_clientes_modificados INTO DATA(es_cliente_modificado).
      APPEND VALUE #( sign = 'I' option = 'EQ' low = es_cliente_modificado-tabkey+3(10) )
      TO ti_clientes.

      APPEND VALUE #( cpident = es_cliente_modificado-cpident )
      TO  ti_bdicpident.
    ENDLOOP.

    SORT ti_clientes BY low.
    DELETE ADJACENT DUPLICATES FROM ti_clientes COMPARING ALL FIELDS.

    CHECK ti_bdicpident IS NOT INITIAL.

    "Cerrar puntero de modificacion
    CALL FUNCTION 'CHANGE_POINTERS_STATUS_WRITE'
      EXPORTING
        message_type           = c_tipo_mensaje
      TABLES
        change_pointers_idents = ti_bdicpident.
    "Valida que no se envien Idoc cuando son modificaciones a centros
    LOOP AT ti_clientes_modificados TRANSPORTING NO FIELDS WHERE tabname IN r_tablas_centros.
      EXIT.
    ENDLOOP.

    IF sy-subrc IS NOT INITIAL.
      SUBMIT rbdsedeb WITH selkunnr IN ti_clientes
                      WITH mestyp = c_tipo_mensaje.
    ENDIF.
  ENDMETHOD.

  METHOD validar_bp_homologado_en_afs.

    DATA: es_segmento_ekpf TYPE e1fikpf,
          bp_afs           TYPE kna1-kunnr.

    TRY.
        es_segmento_ekpf = c_ti_datos_idoc[ segnam = gc_segmento_cabecera_docfi ]-sdata.
        bp_afs = |{ es_segmento_ekpf-xref2_hd ALPHA = OUT }|.
        "AFS indica que el BP requiere homologacion
        "Si se encuentra en el Log que el BP fue homologado no genera error
        IF bp_afs IS NOT INITIAL AND
           NOT ( line_exists( c_ti_log_homologacion[ var_origen = 'LIFNR' val_varorigen = bp_afs ] )
                 OR
                 line_exists( c_ti_log_homologacion[ var_origen = 'KUNNR' val_varorigen = bp_afs ] )
               ).
          DELETE c_ti_verificar_campo_lleno WHERE valor = space.

          IF c_ti_verificar_campo_lleno IS NOT INITIAL.
            MESSAGE e029(zfi01) WITH es_segmento_ekpf-xref2_hd.
          ENDIF.
        ENDIF.
        "Se limpia el campo para no dejarlo con informacion inecesaria
        es_segmento_ekpf-xref2_hd = space.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.
  ENDMETHOD.

  METHOD validar_fecha_contab_doc_fi.
    DATA: es_segmento_ekpf      TYPE e1fikpf,
          r_fecha_valida_doc_fi TYPE RANGE OF bkpf-budat.

    go_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'FECHA_CNTB'
      IMPORTING
        e_ti_valrango           = r_fecha_valida_doc_fi
      EXCEPTIONS
        parametro_no_encontrado = 1
        OTHERS                  = 2 ).

    IF r_fecha_valida_doc_fi IS  INITIAL.
      MESSAGE e031(zfi01).
    ENDIF.

    TRY.
        es_segmento_ekpf = c_ti_datos_idoc[ segnam = gc_segmento_cabecera_docfi ]-sdata.

        IF ( line_exists( r_fecha_valida_doc_fi[ option = 'EQ' ] ) AND es_segmento_ekpf-budat >= r_fecha_valida_doc_fi[ 1 ]-low )
           OR ( es_segmento_ekpf-budat NOT IN r_fecha_valida_doc_fi ).
          MESSAGE e030(zfi01) WITH es_segmento_ekpf-budat.
        ENDIF.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.
  ENDMETHOD.

  METHOD validar_fecha_contab_doc_co.
    DATA: es_segmento_cobk      TYPE e1cobk,
          r_fecha_valida_doc_co TYPE RANGE OF cobk-budat.

    go_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'FECHA_CNTB'
      IMPORTING
        e_ti_valrango           = r_fecha_valida_doc_co
      EXCEPTIONS
        parametro_no_encontrado = 1
        OTHERS                  = 2 ).

    IF r_fecha_valida_doc_co IS  INITIAL.
      MESSAGE e031(zfi01).
    ENDIF.

    TRY.
        es_segmento_cobk = c_ti_datos_idoc[ segnam = 'E1COBK' ]-sdata.

        IF ( line_exists( r_fecha_valida_doc_co[ option = 'EQ' ] ) AND es_segmento_cobk-budat >= r_fecha_valida_doc_co[ 1 ]-low )
           OR ( es_segmento_cobk-budat NOT IN r_fecha_valida_doc_co ).
          MESSAGE e030(zfi01) WITH es_segmento_cobk-budat.
        ENDIF.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.
  ENDMETHOD.

  METHOD homologar_retencion.

    DATA: es_segmento_ekpf             TYPE e1fikpf,
          es_segmento_detalle_bseg_sub TYPE e1finbu,
          es_retenciones               TYPE gtp_es_retenciones,
          ti_tipor_retencion           TYPE STANDARD TABLE OF gtp_es_retenciones.

    TRY.
        es_segmento_ekpf = i_ti_datos_idoc[ segnam = gc_segmento_cabecera_docfi ]-sdata.
        es_segmento_detalle_bseg_sub = i_ti_datos_idoc[ segnam = gc_segmento_detalle_bseg_sub ]-sdata.

        es_segmento_detalle_bseg_sub-lifnr = |{ es_segmento_detalle_bseg_sub-lifnr ALPHA = IN }|.
        es_segmento_detalle_bseg_sub-kunnr = |{ es_segmento_detalle_bseg_sub-kunnr ALPHA = IN }|.

        IF es_segmento_detalle_bseg_sub-lifnr IS NOT INITIAL.
          SELECT p~lifnr, p~land1, l~witht, l~wt_withcd
          FROM lfa1 AS p
          INNER JOIN lfb1 AS b
          ON b~lifnr = p~lifnr
          INNER JOIN lfbw AS l
          ON l~lifnr = b~lifnr
          AND l~bukrs = b~bukrs
          LEFT JOIN t059z AS t
          ON t~land1 = b~qland
          AND t~witht = l~witht
          WHERE b~lifnr = @es_segmento_detalle_bseg_sub-lifnr
          AND   b~bukrs = @es_segmento_ekpf-bukrs
          INTO CORRESPONDING FIELDS OF TABLE @ti_tipor_retencion.
        ELSEIF es_segmento_detalle_bseg_sub-kunnr IS NOT INITIAL.
          SELECT k~kunnr, k~land1, l~witht, l~wt_withcd
          FROM kna1 AS k
          INNER JOIN knb1 AS b
          ON k~kunnr = b~kunnr
          INNER JOIN knbw AS l ON
          l~kunnr = b~kunnr
          AND l~bukrs = b~bukrs
          LEFT JOIN t059z AS t
          ON t~land1 = b~qland
          AND t~witht = l~witht
          WHERE b~kunnr = @es_segmento_detalle_bseg_sub-kunnr
          AND   b~bukrs = @es_segmento_ekpf-bukrs
          INTO CORRESPONDING FIELDS OF TABLE @ti_tipor_retencion.
        ELSE.
          EXIT.
        ENDIF.

        IF ti_tipor_retencion IS NOT INITIAL.

          es_retenciones = ti_tipor_retencion[ 1 ].
          es_retenciones = VALUE #( BASE es_retenciones witht = c_es_segmento_retenciones-witht
                                                        wt_withcd = c_es_segmento_retenciones-wt_withcd ).

          i_o_homologacion->homologar_campo( EXPORTING i_r_excluir_varible_origen = VALUE #( sign = 'I' option = 'EQ'
                                                                                             ( low = 'KUNNR'  )
                                                                                             ( low = 'LIFNR'  )
                                                                                           )
                                                      i_es_control_idoc = i_es_control_idoc
                                                      i_nombre_segmento = i_nombre_segmento
                                             CHANGING c_es = es_retenciones
                                                      c_ti_log_homologacion = c_ti_log_homologacion ).


          "Consulta dato maestro
          SELECT SINGLE land1, witht, wt_withcd
          FROM t059z
          WHERE "land1 = @es_retenciones-land1 AND "SLS 20220121 - Se comenta por validacion en cliente US
          witht = @es_retenciones-witht
          INTO @DATA(es_dato_maestero_retencion).

*          IF NOT line_exists( ti_tipor_retencion[ witht =  c_es_segmento_retenciones-witht ] ).
          IF es_dato_maestero_retencion IS INITIAL AND
            NOT line_exists( c_ti_log_homologacion[ var_origen = 'WITHT' val_varorigen = c_es_segmento_retenciones-witht ] ).
            MESSAGE e020(icc_cl) WITH es_retenciones-land1 es_retenciones-witht.
          ENDIF.

          "Asignar valor homologado
          c_es_segmento_retenciones-witht = es_retenciones-witht.
          c_es_segmento_retenciones-wt_withcd = es_retenciones-wt_withcd.

        ENDIF.

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.

  METHOD homologar_idoc_entrada_fidcc2.

    CLEAR: c_ti_verificar_campo_lleno, c_ti_log_homologacion.

    TRY.
        configurar_homologacion_bp( CHANGING c_ti_datos_idoc = c_ti_datos_idoc
                                             c_ti_verificar_campo_lleno = c_ti_verificar_campo_lleno ).

        homologar_idoccreateondatabase(
          IMPORTING
            e_ti_log_homologacion = c_ti_log_homologacion
          CHANGING
            c_ti_datos_idoc   = c_ti_datos_idoc
            c_es_control_idoc = i_es_control_idoc
            c_r_verificar_campo_lleno = c_ti_verificar_campo_lleno ).

      CATCH cx_sy_itab_line_not_found.

      CATCH cx_t100_msg.

    ENDTRY.
  ENDMETHOD.

  METHOD verificar_homologacion_idoc.

    DATA: ti_log_homologacion      TYPE zclmmi1009_homologacion_campos=>gtp_ti_log_homologacion,
          ti_campo_obligatorio     TYPE gtp_ti_campo,
          es_control_idoc          TYPE edidc,
          ti_datos_idoc_especifico TYPE edidd_tt,
          r_campo_homologado       TYPE RANGE OF ztmmi1009_1-var_origen.

    SELECT k~docnum, credat, cretim, k~mestyp, k~idoctp,
        counter, segnum, segnam, psgnum, hlevel, dtint2, sdata
    FROM edidc AS k
    INNER JOIN edid4 AS d
    ON d~docnum = k~docnum
    WHERE k~docnum IN @i_r_docnum
    AND k~mestyp IN @i_r_mestyp
    AND k~credat IN @i_r_fecha
    AND k~cretim IN @i_r_hora
    AND d~segnam IN @i_r_segnam
    ORDER BY k~mestyp, k~docnum, k~credat, k~cretim, segnum ASCENDING
    INTO TABLE @DATA(ti_datos_idoc).

    LOOP AT ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_dato_idoc>).

      APPEND CORRESPONDING #( <fs_es_dato_idoc> ) TO ti_datos_idoc_especifico.

      AT NEW mestyp.
        ti_campo_obligatorio = SWITCH #( <fs_es_dato_idoc>-mestyp
                                           WHEN 'FIDCC2' THEN
                                            VALUE #(
                                                     ( nombre_del_campo = 'LIFNR' )
                                                     ( nombre_del_campo = 'KUNNR' )
                                                     ( nombre_del_campo = 'PRCTR' )
                                                     ( nombre_del_campo = 'AUFNR' )
                                                     ( nombre_del_campo = 'KOSTL' )
                                                   )
                                           WHEN 'CODCMT' THEN
                                            VALUE #(
                                                     ( nombre_del_campo = 'PRCTR' )
                                                     ( nombre_del_campo = 'AUFNR' )
                                                     ( nombre_del_campo = 'KOSTL' )
                                                     ( nombre_del_campo = 'OBJNR' )
                                                     ( nombre_del_campo = 'PAROB' )
                                                     ( nombre_del_campo = 'USPOB' )
                                                     ( nombre_del_campo = 'PAROB1' )
                                                   )
                                          WHEN 'PRCDOC' THEN
                                            VALUE #(
                                                     ( nombre_del_campo = 'PROFIT_CTR' )
                                                     ( nombre_del_campo = 'P_EL_PRCTR' )
                                                     ( nombre_del_campo = 'PART_PRCTR' )
                                                     ( nombre_del_campo = 'ORDERID' )
                                                     ( nombre_del_campo = 'KOSTL' )
                                                   )
                                      ).

      ENDAT.

      AT END OF docnum.

        es_control_idoc = CORRESPONDING #( <fs_es_dato_idoc> ).

        TRY.
            homologar_idoccreateondatabase(
              EXPORTING
                i_escribir_log_en_bd      = abap_false
              IMPORTING
                e_ti_log_homologacion     = ti_log_homologacion
              CHANGING
                c_ti_datos_idoc           = ti_datos_idoc_especifico
                c_es_control_idoc         = es_control_idoc
                c_r_verificar_campo_lleno = ti_campo_obligatorio  ).
          CATCH cx_t100_msg.
            "handle exception
        ENDTRY.

        zclcxr1002_util=>crear_rango(
          EXPORTING
            i_ti                           = ti_log_homologacion
            i_nombre_columna               = 'VAR_ORIGEN'
          CHANGING
            c_ti_rango                     = r_campo_homologado ).

        "verificar
        LOOP AT ti_campo_obligatorio  ASSIGNING FIELD-SYMBOL(<fs_es_campo_no_homologado>)
                                          WHERE nombre_del_campo NOT IN r_campo_homologado AND
                                                valor IS NOT INITIAL.

          APPEND VALUE #( docnum = <fs_es_dato_idoc>-docnum estado = 'E' val_varorigen = <fs_es_campo_no_homologado>-valor
                          var_origen = <fs_es_campo_no_homologado>-nombre_del_campo  )
          TO ti_log_homologacion.
        ENDLOOP.

        CLEAR: ti_datos_idoc_especifico, ti_campo_obligatorio.
      ENDAT.

    ENDLOOP.

    "visualizar
    SORT ti_log_homologacion BY mestyp docnum var_destino.

    TRY.
        DATA(ti_catalogo) = zclcxr1002_util=>construir_catalogo( i_ti = ti_log_homologacion i_optimizar_columnas = abap_true ).
      CATCH cx_dynamic_check cx_static_check.
        "handle exception
    ENDTRY.

    CALL FUNCTION 'ZCXR1002_MOSTRARALV_01'
      EXPORTING
        i_ti_datos    = REF #( ti_log_homologacion )
        i_ti_catalogo = ti_catalogo.

  ENDMETHOD.


  METHOD verificar_elemento_pep.
    DATA: es_coep TYPE e1coep.

    es_coep = i_es_segmento.

    TRY.
        IF es_coep-objnr(2) = 'AO'.
          MESSAGE e035(zfi01).
        ENDIF.
      CATCH cx_root.
    ENDTRY.

  ENDMETHOD.


  METHOD configurar_homologacion_bp.
    DATA: es_bkpf     TYPE e1fikpf,
          es_bseg_sug TYPE  e1finbu,
          bp_incluido TYPE flag.

    "Caso 1: Valida que el BP que se requiere homologar en BKPF-XREF2_HD exsitan dentro de E1FINBU-KUNNR/LIFNR
    ASSIGN c_ti_datos_idoc[ segnam = gc_segmento_cabecera_docfi ]-sdata TO FIELD-SYMBOL(<fs_es_cabecera>).
    es_bkpf = <fs_es_cabecera>.

    es_bkpf-xref2_hd = |{ es_bkpf-xref2_hd ALPHA = OUT }|.

    LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_dato_idoc>) WHERE segnam = gc_segmento_detalle_bseg_sub.
      es_bseg_sug = <fs_es_dato_idoc>-sdata.

      es_bseg_sug-kunnr = |{ es_bseg_sug-kunnr ALPHA = OUT }|.
      es_bseg_sug-lifnr = |{ es_bseg_sug-lifnr ALPHA = OUT }|.

      IF es_bseg_sug-kunnr = es_bkpf-xref2_hd OR
         es_bseg_sug-lifnr = es_bkpf-xref2_hd.
        bp_incluido = abap_true.
      ENDIF.

    ENDLOOP.
    "Si el BP no se ecnuentra, se limpia la referencia que se envia desde AFS
    "Este caso sucede para tiendas propias
    IF bp_incluido = abap_false.
      CLEAR es_bkpf-xref2_hd.
      <fs_es_cabecera> = es_bkpf.
    ELSE.
      "Caso 2: Se validan que estos campos tengan datos dentro del Idoc
      "Esto es necesario para la validacion del codigo BP en un paso posterior
      c_ti_verificar_campo_lleno = VALUE #( ( nombre_del_campo = 'LIFNR' )
                                            ( nombre_del_campo = 'KUNNR' )
                                          ).
    ENDIF.
  ENDMETHOD.

  METHOD escribir_log_tbl_homologacion.

    DATA: es_datos_finales   TYPE ztmmi1009_1,
          es_datos_iniciales TYPE ztmmi1009_1,
          accion             TYPE cdchngind,
          id_objeto          TYPE cdobjectv,
          str_where          TYPE string.

    LOOP AT i_ti_registro_modificados ASSIGNING FIELD-SYMBOL(<fs_es_registro_modificados>).
      CLEAR: es_datos_finales, es_datos_iniciales.

      str_where = |LINE_INDEX = { <fs_es_registro_modificados>-indx }|.

      LOOP AT c_ti_datos_completos ASSIGNING FIELD-SYMBOL(<fs_es_datos_completos>) WHERE (str_where).
        es_datos_finales = CORRESPONDING #( <fs_es_datos_completos> ).
        id_objeto = |{ es_datos_finales-ricefw }{ es_datos_finales-consecutivo }| &&
                    |{ es_datos_finales-bukrs }{ es_datos_finales-kokrs }|.
      ENDLOOP.

      LOOP AT c_ti_datos_iniciales ASSIGNING FIELD-SYMBOL(<fs_es_datos_iniciales>) WHERE (str_where).
        es_datos_iniciales = CORRESPONDING #( <fs_es_datos_iniciales> ).
        id_objeto = |{ es_datos_iniciales-ricefw }{ es_datos_iniciales-consecutivo }| &&
                    |{ es_datos_finales-bukrs }{ es_datos_finales-kokrs }|.
      ENDLOOP.

      accion = SWITCH #( <fs_es_registro_modificados>-type
                            WHEN 'M' THEN
                              'U'
                            ELSE
                              <fs_es_registro_modificados>-type
                       ).

      IF accion = 'U'.
        CLEAR: es_datos_finales-ricefw, es_datos_finales-mandt, es_datos_finales-consecutivo,
               es_datos_finales-bukrs, es_datos_finales-kokrs.
      ENDIF.

      CALL FUNCTION 'ZCX_ZTMMI1009_1_WRITE_DOCUMENT'
        EXPORTING
          objectid                = id_objeto
          tcode                   = sy-tcode
          utime                   = sy-uzeit
          udate                   = sy-datum
          username                = sy-uname
          object_change_indicator = COND #( WHEN accion = 'U' THEN accion ELSE space )
          n_ztmmi1009_1           = es_datos_finales
          o_ztmmi1009_1           = es_datos_iniciales
          upd_ztmmi1009_1         = accion.

      COMMIT WORK AND WAIT.

    ENDLOOP.
  ENDMETHOD.


  METHOD asigna_cebe_cuenta_especifica.

    DATA: r_cebe_co10            TYPE RANGE OF prctr,
          r_cebe_co30            TYPE RANGE OF prctr,
          r_cuentas_balance      TYPE RANGE OF bseg-hkont,
          documento_solo_balance TYPE flag VALUE abap_true,
          es_segmento_bseg       TYPE e1fiseg.

    go_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'CEBE_CO10'
      IMPORTING
        e_ti_valrango           = r_cebe_co10
      EXCEPTIONS
        parametro_no_encontrado = 1
        OTHERS                  = 2 ).

    go_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'CEBE_CO30'
      IMPORTING
        e_ti_valrango           = r_cebe_co30
      EXCEPTIONS
        parametro_no_encontrado = 1
        OTHERS                  = 2 ).

    go_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'CUENTA_BAL'
      IMPORTING
        e_ti_valrango           = r_cuentas_balance
      EXCEPTIONS
        parametro_no_encontrado = 1
        OTHERS                  = 2 ).

    CHECK r_cuentas_balance IS NOT INITIAL.

    "Solo aplica para documentos con TODAS las posiciones de cuenta de balance
    LOOP AT i_ti_datos_idoc INTO DATA(es_dato_idoc) WHERE segnam = gc_segmento_bseg.
      es_segmento_bseg = es_dato_idoc-sdata.
      IF es_segmento_bseg-hkont NOT IN r_cuentas_balance.
        documento_solo_balance = abap_false.
        EXIT.
      ENDIF.
    ENDLOOP.

    CHECK c_es_segmento_bseg-prctr IS INITIAL AND
          documento_solo_balance  = abap_true.

    SELECT SINGLE kokrs
    FROM tka02
    WHERE bukrs = @c_es_segmento_bseg-bukrs
    INTO @DATA(sociedad_co) .

    TRY.

        c_es_segmento_bseg-prctr = COND #( WHEN sociedad_co = 'CO10' THEN
                                            r_cebe_co10[ 1 ]-low
                                           WHEN sociedad_co = 'CO30' THEN
                                            r_cebe_co30[ 1 ]-low
                                         ).

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.

  ENDMETHOD.

  METHOD modificar_limite_de_credito.

    DATA: ti_bp1010 TYPE STANDARD TABLE OF bp1010,
          es_bp1010 LIKE LINE OF ti_bp1010.

    IF i_r_partner IS NOT INITIAL.

      SELECT
      FROM ukmbp_cms_sgm AS credito
      INNER JOIN ukmcred_sgm0c AS segmento
      ON segmento~credit_sgmnt = credito~credit_sgmnt
      FIELDS credito~partner, credito~credit_sgmnt, credito~credit_limit, segmento~currency
      WHERE partner IN @i_r_partner
      INTO TABLE @DATA(ti_gestion_credito).

      LOOP AT ti_gestion_credito INTO DATA(es_gestion_credito).

        es_bp1010 = VALUE #( partnr = es_gestion_credito-partner sol_txt = |{ es_gestion_credito-credit_limit  WIDTH = 17 ALIGN = LEFT  }| ).
        es_bp1010-sol_txt = replace( val = es_bp1010-sol_txt sub = '.' occ = 0 with = space ).
        es_bp1010-sol_txt = replace( val = es_bp1010-sol_txt sub = ',' occ = 0 with = space ).
***        WRITE es_gestion_credito-credit_limit TO es_bp1010-sol_txt CURRENCY es_gestion_credito-currency.
        CONDENSE es_bp1010-sol_txt NO-GAPS.

        APPEND es_bp1010 TO ti_bp1010.
      ENDLOOP.

      CHECK ti_bp1010 IS NOT INITIAL.

      MODIFY bp1010 FROM TABLE ti_bp1010.

      COMMIT WORK AND WAIT.

      MESSAGE s004(/isdfps/upd806error).
    ELSE.
      MESSAGE s107(/isdfps/wm01).
    ENDIF.

  ENDMETHOD.


  METHOD eliminar_idoc_rango_fecha.

    DATA: r_fecha_creacion         TYPE RANGE OF d,
          r_estado_mensaje         TYPE RANGE OF edidc-status,
          numero_de_llamados       TYPE i.

    BREAK seblondo.
    "Excluir idoc: Sin procesar, modificados, listos para ingresar a aplicacion
    r_estado_mensaje = VALUE #( sign = 'E' option = 'EQ' ( low = '64' ) ( low = '69' ) ( low = '62' ) ).

    SELECT
    FROM edidc
    FIELDS docnum, credat, mestyp, status
    WHERE credat IN @i_r_fecha
    AND mestyp   IN @i_r_mestyp
    AND status   IN @r_estado_mensaje
    ORDER BY credat ASCENDING
    INTO TABLE @DATA(ti_idocs).

    LOOP AT ti_idocs REFERENCE INTO DATA(r_es_idoc)
                     GROUP BY ( credat = r_es_idoc->credat
                                indice = GROUP INDEX
                                cantidad_registros_x_dia = GROUP SIZE
                              )
                     REFERENCE INTO DATA(r_es_key_gr).

      CLEAR: r_fecha_creacion.

      WRITE /: |Fecha inicio ejecucion: { sy-datum }{ sy-uzeit }|.
      WRITE /: |Fecha { r_es_key_gr->credat } - Indice de grupo: { r_es_key_gr->indice }, Tamano: { r_es_key_gr->cantidad_registros_x_dia }|.

      CHECK r_es_key_gr->cantidad_registros_x_dia IS NOT INITIAL.

      numero_de_llamados = 1.

      IF r_es_key_gr->cantidad_registros_x_dia > i_cantidad_maxima_registros.
        numero_de_llamados = round( val = ( r_es_key_gr->cantidad_registros_x_dia / i_cantidad_maxima_registros ) dec = 0 mode = cl_abap_math=>round_up ).
      ENDIF.

      r_fecha_creacion = VALUE #( ( sign = 'I' option = 'EQ' low = r_es_key_gr->credat ) ).

      WRITE /: |Fecha { r_es_key_gr->credat } - Cantidad de iteraciones: { numero_de_llamados }|.

      DO numero_de_llamados TIMES.

        WRITE /: |Fecha { r_es_key_gr->credat } - iteracion: { sy-index } - Cantidad de registros a eliminar { i_cantidad_maxima_registros } de { r_es_key_gr->cantidad_registros_x_dia } en BD |.

        SUBMIT rsetestd
        WITH gp_test       =  abap_false
        WITH gs_creda      IN r_fecha_creacion
        WITH gs_statu      IN r_estado_mensaje
        WITH gs_mesty      IN i_r_mestyp
        WITH gp_maxct      =  i_cantidad_maxima_registros
        AND RETURN.

        WRITE /: |Fecha { r_es_key_gr->credat } - iteracion: { sy-index } - Terminada |.
        WRITE /: |Fecha fin ejecucion: { sy-datum }{ sy-uzeit }|.

      ENDDO.

    ENDLOOP.

  ENDMETHOD.

ENDCLASS.