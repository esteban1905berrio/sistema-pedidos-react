      "! <br/><br/>
      "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
      "! </strong><br/>
      "! \ 20.01.2021  \ S4DK900789 \ Sebastian Londono \ Creacion Inicial \
      "!
      "! @parameter i_nombre_segmento |
      "! @parameter i_cliente |
      "! @parameter i_proveedor |
      "! @parameter i_tipo_mensaje |
      "! @parameter c_ti_datos_idoc |
      completar_datos_cabecera_bp
        IMPORTING
          VALUE(i_nombre_segmento) TYPE edilsegtyp
          i_cliente                TYPE flag OPTIONAL
