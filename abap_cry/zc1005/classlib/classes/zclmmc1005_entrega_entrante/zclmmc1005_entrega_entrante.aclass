  METHOD crear_lote.
*&---------------------------------------------------------------------*
*& Include          ZXM06U29
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: E01078
* Tipo Objeto  : Include de ampliación
* Descripción  : Ampliación Creación de Lote (VL31n)
* Autor Prog.  : Juan Pablo Vélez Valencia - Consultor ABAP/HANA
* Fecha Creac. : 2022.10.06
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha       | CR#         | Autor           | Modificación
*----------------------------------------------------------------------*
* 2022.10.06   S4DK916228    JPVELEZV           Version Inicial
* 2023.03.09   S4DK918522    JPVELEZV           Version @0001
*----------------------------------------------------------------------*
* Modificaciones:
* @0001: Se ajusta ampliación para que aplique con el estándar de implementación
*         de ampliaciónes de Crystal
*----------------------------------------------------------------------*

    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'E01078' ) = abap_true.

    DATA:
      material_lote      TYPE bapibatchkey-material,
      lote               TYPE bapibatchkey-batch,
      plant              TYPE bapibatchkey-plant,
      lgort              TYPE bapibatchstoloc-stge_loc,
      es_bapibatchctrl   TYPE bapibatchctrl,
      es_batchattributes TYPE bapibatchatt,
      ti_return          TYPE STANDARD TABLE OF bapiret2.

    SELECT vbeln, posnr, matnr, werks, lgort, charg, sgt_rcat, sgt_scat
      FROM lips
      WHERE
        vbeln = @i_vbeln AND
        posnr = @i_vbelp
      INTO TABLE @DATA(ti_lips).

    IF ti_lips IS NOT INITIAL.
      "Consultamos si existe el lote
      SELECT matnr, werks, charg
       FROM mcha
        FOR ALL ENTRIES IN @ti_lips
       WHERE
         matnr = @ti_lips-matnr AND
         werks = @ti_lips-werks AND
         charg = @ti_lips-charg
       INTO TABLE @DATA(ti_mcha).

      "Si no existe lote entonces crear
      IF sy-subrc <> 0.
        READ TABLE ti_lips INTO DATA(es_lips) INDEX 1.

        MOVE es_lips-matnr TO material_lote.
        MOVE es_lips-sgt_scat TO lote.
        MOVE es_lips-werks TO plant.
*    MOVE es_lips-lgort TO lgort.

