          DESTINATION 'NONE'
          EXPORTING
            material             = material_lote
            batch                = lote
            plant                = plant
            batchcontrolfields   = es_bapibatchctrl
            batchattributes      = es_batchattributes
            batchstoragelocation = lgort
          TABLES
            return               = ti_return.
      ENDIF.
    ENDIF.

  ENDMETHOD.


