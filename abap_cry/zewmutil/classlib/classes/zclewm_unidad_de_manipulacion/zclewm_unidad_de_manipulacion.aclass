              iv_mode        = modo_ejecucion_fm
              it_data_parent = ti_cabecera_um_ewm
            IMPORTING
              et_data        = ti_posicion_um_ewm
            EXCEPTIONS
              error_message  = 1.

          APPEND LINES OF ti_cabecera_entrega TO e_ti_cabecera_entrega.
          APPEND LINES OF ti_posicion_entrega TO e_ti_posicion_entrega.
          APPEND LINES OF ti_cabecera_um_ewm  TO e_ti_cabecera_um_ewm.
          APPEND LINES OF ti_posicion_um_ewm  TO e_ti_posicion_um_ewm.

        CATCH /scwm/cx_mon_noexec ##NO_HANDLER.

      ENDTRY.

      CLEAR: ti_tab_range.

    ENDLOOP.
  ENDMETHOD.

ENDCLASS.