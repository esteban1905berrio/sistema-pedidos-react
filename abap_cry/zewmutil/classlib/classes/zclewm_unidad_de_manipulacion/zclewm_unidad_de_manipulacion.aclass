          CALL FUNCTION '/SCWM/WHRHEAD_OUT_HU_MON'
            EXPORTING
              iv_lgnum       = <fs_es_almacen_ewm>-whnumwme
              iv_mode        = modo_ejecucion_fm
              it_data_parent = ti_cabecera_entrega
            IMPORTING
