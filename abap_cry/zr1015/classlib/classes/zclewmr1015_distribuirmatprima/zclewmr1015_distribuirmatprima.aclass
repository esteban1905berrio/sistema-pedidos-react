        conos_despachados        TYPE ztewmi1006_1-conos_despachados,
        ordenes_pendientes       TYPE i,
        gramos_um(13)            TYPE p DECIMALS 3,
        diferencia(13)           TYPE p DECIMALS 3,
        ajustar_um               TYPE flag,
        cant_entrega             TYPE ztewmi1006_1-cant_necesaria,
        vltyp                    TYPE /scwm/ordim_o-vltyp,
        "+SLS 01.06.2023: Agregar campos pack and hold{
        fecha_hora_inicio_tejido TYPE ztewmi1006_1-fecha_hora_inicio_tejido,
        marca_ph                 TYPE char25,
        "}
      END OF gtp_es_ola .
    TYPES:
      gtp_ti_ola TYPE STANDARD TABLE OF gtp_es_ola WITH EMPTY KEY .

    DATA go_log TYPE REF TO zclcxr1002_log_aplicacion .

    "! <strong>Descripción:</strong>
    "! <p>
    "! Instanciar el objeto de log<br/>
    "! </p>
    "! <strong>Identificador:</strong>"! R1015
    "! <br/>
    "! <strong>Autor:</strong>
    "! Santiago Giraldo
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 26.08.2021  \ S4DK901932 \ Santiago Giraldo \ Creacion Inicial \
    "!
    METHODS constructor .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Proceso antes de mostrar la dynpro 200 del programa ZEWMR1015_1<br/>
    "! </p>
    "! <strong>Identificador:</strong>"! R1015
    "! <br/>
    "! <strong>Autor:</strong>
    "! Santiago Giraldo
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 26.08.2021  \ S4DK901932 \ Santiago Giraldo \ Creacion Inicial \
    "!
    "! @parameter i_custom_num | Nombre del custom container del HTML
    "! @parameter i_custom_alv | Nombre del custom container del ALV
    "! @parameter c_o_custom_num | Custom container del HTML
    "! @parameter c_o_custom_alv | Custom container del ALV
    "! @parameter c_o_alv | Objeto de ALV
    "! @parameter c_es_distribucion | Estructura de ola, isla y ump
    "! @parameter c_es_ola | Estructura con la información de la Ola
    METHODS proceso_pbo_200
      IMPORTING
        !i_custom_num      TYPE char50
        !i_custom_alv      TYPE char50
      CHANGING
        !c_o_custom_num    TYPE REF TO cl_gui_custom_container
        !c_o_custom_alv    TYPE REF TO cl_gui_custom_container
        !c_o_alv           TYPE REF TO cl_gui_alv_grid
        !c_es_distribucion TYPE gtp_es_distribucion
        !c_es_ola          TYPE gtp_es_ola .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Determinar el almacén del usuario que ejecuta la transacción ZEWMR1015_1<br/>
    "! </p>
    "! <strong>Identificador:</strong>"! R1015
    "! <br/>
    "! <strong>Autor:</strong>
    "! Santiago Giraldo
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 26.08.2021  \ S4DK901932 \ Santiago Giraldo \ Creacion Inicial \
    "!
    "! @parameter r_lgnum | Numero de almecén del usuario
    METHODS determinar_almacen
      RETURNING
        VALUE(r_lgnum) TYPE /scwm/lgnum .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Ayuda de busqueda para los tipos de conos<br/>
    "! </p>
    "! <strong>Identificador:</strong>"! R1015
    "! <br/>
    "! <strong>Autor:</strong>
    "! Santiago Giraldo
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 26.08.2021  \ S4DK901932 \ Santiago Giraldo \ Creacion Inicial \
    "!
    "! @parameter r_ctara | Valor elejido de la ayuda de busqueda
    METHODS ayuda_de_busqueda_tipo_cono
      RETURNING
        VALUE(r_ctara) TYPE zedctara .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Ayuda de busqueda para las islas<br/>
    "! </p>
    "! <strong>Identificador:</strong>"! R1015
    "! <br/>
    "! <strong>Autor:</strong>
    "! Santiago Giraldo
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 26.08.2021  \ S4DK901932 \ Santiago Giraldo \ Creacion Inicial \
    "!
    "! @parameter r_workstation | Valor elejido de la ayuda de busqueda
    METHODS ayuda_busqueda_islas_picking
      IMPORTING
        !i_lgnum             TYPE /scwm/lgnum
      RETURNING
        VALUE(r_workstation) TYPE /scwm/tworkst .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Proceso despues de ingresar valores a la pantalla 100 y 200<br/>
    "! </p>
    "! <strong>Identificador:</strong>"! R1015
    "! <br/>
    "! <strong>Autor:</strong>
    "! Santiago Giraldo
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 26.08.2021  \ S4DK901932 \ Santiago Giraldo \ Creacion Inicial \
    "!
    "! @parameter i_ok_code | Valor de la acción a ejecutar
    "! @parameter c_es_distribucion | Estructura de ola, isla y ump
    "! @parameter c_es_ola | Estructura con la información de la Ola
    "! @parameter c_sub_screen | Numero de Dynpro mostrada en la Subscreen
    METHODS proceso_pai_100
      IMPORTING
        !i_ok_code         TYPE sy-ucomm
      CHANGING
        !c_es_distribucion TYPE gtp_es_distribucion
        !c_es_ola          TYPE gtp_es_ola
        !c_sub_screen      TYPE sy-dynnr
        !c_o_alv           TYPE REF TO cl_gui_alv_grid
        !c_ubicacion_verif TYPE /scwm/lgpla OPTIONAL.
    "! <strong>Descripción:</strong>
    "! <p>
    "! Verifica si el proceso requiere de confirmación de ubicación.<br/>
    "! </p>
    "! <strong>Identificador:</strong>
                                                            "! R1015
    "! <br/>
    "! <strong>Autor:</strong>
    "! René Duque
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 31.03.2022  \ S4DK921485 \ René Duque \ Creación Inicial \
    "!
    "! @parameter r_respuesta | Respuesta SI = True, NO = False
    METHODS si_confirmar_ubicacion
      RETURNING
        VALUE(r_respuesta) TYPE abap_bool .
    METHODS verificar_confirma_ubicacion
      IMPORTING
        !i_numero_almacen  TYPE /scwm/lgnum
        !i_ubicacion       TYPE /scwm/lgpla
        !i_ubicacion_verif TYPE /scwm/de_verify
      RAISING
        cx_t100_msg .
  PROTECTED SECTION.
  PRIVATE SECTION.

    CONSTANTS: gc_ricefw     TYPE char5 VALUE 'R1015',
               gc_mensaje_e  TYPE c     VALUE 'E',
               gc_mensaje_w  TYPE c     VALUE 'W',
               gc_mensaje_id TYPE arbgb VALUE 'ZEWM01'.

    DATA: gti_ola                TYPE gtp_ti_ola,
          gti_data_mostrada      TYPE gtp_ti_ola,
          go_dao                 TYPE REF TO zclewmr1015_dao,
          g_num_ola              TYPE sammg,
          g_num_isla             TYPE /scwm/de_workstation,
          g_num_ump              TYPE /scwm/de_huident,
          go_custom_listar       TYPE REF TO cl_gui_custom_container,
          go_alv_listar          TYPE REF TO cl_gui_alv_grid,
          gti_listar             TYPE gtp_ti_ola,
          g_tipo_almacen         TYPE zzedlow,
          g_material_empaque     TYPE zzedlow,
          gti__ubicacion_isla    TYPE zclewmr1015_dao=>gtp_ti_ubicacion_isla,
          g_proceso              TYPE /scwm/de_procty,
          gr_otros_procesos      TYPE zclewmr1015_dao=>gtp_r_procesos,
          go_html                TYPE REF TO cl_gui_html_viewer,
          gti_tipo_conos         TYPE zclewmr1015_dao=>gtp_ti_ctara,
          g_caract_encona        TYPE zzedlow,
          g_tolerancia           TYPE i,
          g_tolerancia_maxima    TYPE i,
          g_conf_tipo_movimiento TYPE zzedlow,
          "! Indicador si se debe realizar confirmación de la ubicación (SI/NO)
          g_confirmar_ubicacion  TYPE char02.

    METHODS:
      asignar_ubicacion
        IMPORTING
          i_nombre_custom_container TYPE char50
        CHANGING
          c_o_custom_contaner       TYPE REF TO cl_gui_custom_container
          c_es_ola                  TYPE gtp_es_ola,
      mostrar_alv
        IMPORTING
          i_nombre_custom_container TYPE char50
        CHANGING
          c_o_custom_contaner       TYPE REF TO cl_gui_custom_container
          c_o_alv                   TYPE REF TO cl_gui_alv_grid,
      cambiar_catalogo
        CHANGING
          c_ti_catalog TYPE lvc_t_fcat,
      handle_toolbar FOR EVENT toolbar OF cl_gui_alv_grid
        IMPORTING
          e_object,
      validar_proceso
        CHANGING
          c_es_distribucion TYPE gtp_es_distribucion
          c_es_ola          TYPE gtp_es_ola
          c_sub_screen      TYPE sy-dynnr
        RAISING
          cx_t100_msg,
      limpiar_pantalla
        IMPORTING
          i_borrar_solo_ump TYPE flag OPTIONAL
        CHANGING
          c_es_distribucion TYPE gtp_es_distribucion
          c_es_ola          TYPE gtp_es_ola OPTIONAL,
      determinacion_material
        IMPORTING
          i_es_ola                         TYPE gtp_es_ola
        RETURNING
          VALUE(r_total_entregas_material) TYPE i,
      total_entregas
        IMPORTING
          i_ti_ola                         TYPE gtp_ti_ola
        RETURNING
          VALUE(r_total_entregas_material) TYPE i,
      asignar_valores_out_put
        CHANGING
          c_es_ola          TYPE gtp_es_ola
          c_es_distribucion TYPE gtp_es_distribucion
          c_sub_screen      TYPE sy-dynnr,
      obtener_parametros
        EXPORTING
          e_tipo_almacen           TYPE zzedlow
          e_material_empaque       TYPE zzedlow
        RETURNING
          VALUE(r_tipo_movimiento) TYPE zzedlow,
      obtener_param_conf_ubica,
      saltar_entrega
        CHANGING
          c_es_distribucion TYPE gtp_es_distribucion
          c_es_ola          TYPE gtp_es_ola
          c_sub_screen      TYPE sy-dynnr,
      imprimir_cajas
        IMPORTING
          VALUE(i_es_distribucion) TYPE gtp_es_distribucion
          VALUE(i_no_imprimir)     TYPE flag DEFAULT abap_false
        RAISING
          cx_t100_msg,
      cerrar_ump
        IMPORTING
          i_es_distribucion TYPE gtp_es_distribucion ,
      listar_mercada
        IMPORTING
          i_es_mercada TYPE gtp_es_ola
          i_ump        TYPE /scwm/de_huident,
      cambiar_catalogo_listar
        CHANGING
          c_ti_catalog TYPE lvc_t_fcat,
      actualizar_calculos
        CHANGING
          c_es_ola          TYPE gtp_es_ola
          c_es_distribucion TYPE gtp_es_distribucion
          c_sub_screen      TYPE sy-dynnr,
      confirmar
        IMPORTING
          i_es_distribucion TYPE gtp_es_distribucion
        CHANGING
          c_es_ola          TYPE gtp_es_ola
          c_es_distribucion TYPE gtp_es_distribucion
          c_sub_screen      TYPE sy-dynnr
        RAISING
          cx_t100_msg,
      rechazar_lanzar_mercada
        IMPORTING
          VALUE(i_es_ola) TYPE gtp_es_ola
        CHANGING
          c_o_alv         TYPE REF TO cl_gui_alv_grid,
      rechazar_mercada
        IMPORTING
          i_lgnum      TYPE /scwm/lgnum
          i_tanum      TYPE /scwm/tanum
          i_cant_tomar TYPE /scwm/ltap_vsolm
          i_altme      TYPE /scwm/de_aunit,
      obtener_cantidad_ump
        IMPORTING
          i_lgnum           TYPE /scwm/lgnum
          i_ump             TYPE /scwm/ltap_vlenr
        EXPORTING
          e_lgpla           TYPE /scwm/de_lgpla
        RETURNING
          VALUE(r_cantidad) TYPE /scwm/ltap_vsolm,
      determinar_ump_destino
        IMPORTING
          i_lgnum      TYPE /scwm/lgnum
          i_lgpla      TYPE lgpla
          i_dstgrp     TYPE /scwm/de_dstgrp
        RETURNING
          VALUE(r_ump) TYPE /scwm/ltap_vlenr,
      crear_ump
        IMPORTING
          i_lgnum           TYPE /scwm/lgnum
          i_lgpla           TYPE lgpla
          i_dstgrp          TYPE /scwm/de_dstgrp
        RETURNING
          VALUE(r_es_huhdr) TYPE /scwm/s_huhdr_int,
      modificar_tarea
        IMPORTING
          i_es_ola TYPE gtp_es_ola,
      confirmar_excepcion_zdiu
        IMPORTING
          i_es_ola TYPE gtp_es_ola,
      confirmar_excepcion_zdia
        IMPORTING
          i_es_ola TYPE gtp_es_ola,
      confirmar_pick_parcial
        IMPORTING
          i_es_ola TYPE gtp_es_ola,
      confirmar_sin_diferencia
        IMPORTING
          i_es_ola TYPE gtp_es_ola,
      determinar_ubicacion
        IMPORTING
          i_ola               TYPE sammg
          i_isla              TYPE /scwm/de_workstation
          i_entrega           TYPE vbeln OPTIONAL
          i_numero_almacen    TYPE /scwm/lgnum
        EXPORTING
          e_proceso_cancelado TYPE flag
        RETURNING
          VALUE(r_ubicacion)  TYPE lgpla,
      obtener_valores_dynpro
        EXPORTING
          e_dynpfields TYPE dynpread_t,
      obtener_entregas_pend_mat
        IMPORTING
          i_es_ola                         TYPE gtp_es_ola
        RETURNING
          VALUE(r_total_entregas_pend_mat) TYPE i,
      asignar_ubicacion_a_ola
        IMPORTING
          i_ola               TYPE sammg
          i_isla              TYPE /scwm/de_workstation
          i_numero_almacen    TYPE /scwm/lgnum
          i_entrega           TYPE likp-vbeln
          i_asignar_ubicacion TYPE flag OPTIONAL,
      ajustar_ump_a_cero
        IMPORTING
          i_es_ola TYPE gtp_es_ola,
      anular_tareas_pendientes
        IMPORTING
          i_lgnum           TYPE /scwm/lgnum
          i_docid           TYPE /scdl/dl_docid
          i_itemid          TYPE /scdl/dl_itemid
          i_es_distribucion TYPE gtp_es_distribucion
        CHANGING
          c_es_ola          TYPE gtp_es_ola,
      validar_cierre
        IMPORTING
          i_es_distribucion TYPE gtp_es_distribucion
        CHANGING
          c_es_ola          TYPE gtp_es_ola
        RAISING
          cx_t100_msg,
      ultima_tarea_posicion
        IMPORTING
          i_es_ola        TYPE zclewmr1015_distribuirmatprima=>gtp_es_ola
        RETURNING
          VALUE(r_result) TYPE abap_bool,
      asignar_codigo_de_proceso
        IMPORTING
          VALUE(i_es_ola) TYPE zclewmr1015_distribuirmatprima=>gtp_es_ola,
      obtener_consecutivo_entrega
        IMPORTING
          i_es_hu         TYPE /scwm/s_huhdr_int
        RETURNING
          VALUE(r_es_ump) TYPE zclewme1030_norma_embalaje=>gtp_es_ump,
      validar_tipo_tarea
        CHANGING
                 c_es_ola TYPE zclewmr1015_distribuirmatprima=>gtp_es_ola
        RAISING  cx_t100_msg .

ENDCLASS.



CLASS zclewmr1015_distribuirmatprima IMPLEMENTATION.


  METHOD determinar_ump_destino.

    DATA: ti_data TYPE /scwm/tt_huhdr_bin_mon.
    DATA(ti_tab_range) = VALUE rsds_trange( ( tablename = '/SCWM/LAGP'
                                              frange_t  = VALUE rsds_frange_t( ( fieldname = 'LGPLA'
                                                                                 selopt_t  = VALUE rsds_selopt_t( ( sign   = 'I'
                                                                                                                    option = 'EQ'
                                                                                                                    low    = i_lgpla ) ) )
                                                                               ( fieldname = 'LGTYP'
                                                                                 selopt_t  = VALUE rsds_selopt_t( ( sign   = 'I'
                                                                                                                    option = 'EQ'
                                                                                                                    low    = g_tipo_almacen ) ) ) ) ) ).
    CALL FUNCTION '/SCWM/HU_PER_BIN_MON'
      EXPORTING
        iv_lgnum     = i_lgnum
        iv_mode      = '2'
      IMPORTING
        et_data      = ti_data
      CHANGING
        ct_tab_range = ti_tab_range.

    IF line_exists( ti_data[ dstgrp = i_dstgrp copst = space ] ).
      r_ump = ti_data[ dstgrp = i_dstgrp copst = space ]-huident.
    ENDIF.

  ENDMETHOD.


  METHOD handle_toolbar.

    DELETE e_object->mt_toolbar
    WHERE function = '&DETAIL'           OR function = '&MB_SUM'       OR function = '&MB_VIEW'
       OR function = '&MB_SUBTOT'        OR function = '&PRINT_BACK'   OR function = '&COL0'
       OR function = '&GRAPH'            OR function = '&INFO'         OR function = '&REFRESH'
       OR function = '&LOCAL&CUT'        OR function = '&LOCAL&COPY'   OR function = '&LOCAL&PASTE'
       OR function = '&LOCAL&UNDO'       OR function = '&LOCAL&APPEND' OR function = '&LOCAL&INSERT_ROW'
       OR function = '&LOCAL&DELETE_ROW' OR function = '&LOCAL&COPY_ROW' .

  ENDMETHOD.


  METHOD limpiar_pantalla.

    DATA(almacen)   = c_es_distribucion-lgnum.
    DATA(ola)       = g_num_ola.
    DATA(isla)      = g_num_isla.
    CLEAR: gti_data_mostrada, g_num_ola, g_num_isla, c_es_distribucion, c_es_ola, gti__ubicacion_isla.
    c_es_distribucion-lgnum = almacen.

    IF i_borrar_solo_ump EQ abap_true.
      g_num_ola              = ola.
      g_num_isla             = isla.
      c_es_distribucion-isla = isla.
      c_es_distribucion-ola  = ola.
    ENDIF.

  ENDMETHOD.


  METHOD listar_mercada.

    CLEAR: gti_listar.
    DATA(ti_tareas) = VALUE /scwm/tt_to_det_mon_out( (  ) ).
    DATA(ti_range)  = VALUE rsds_trange( ( tablename = '/SCWM/S_WIP_Q_WHR_OUTBOUND'
                                           frange_t  = VALUE rsds_frange_t( ( fieldname = 'DOCNO_H'
                                                                              selopt_t  =  VALUE rsds_selopt_t( FOR wa IN gti_ola ( sign   = 'I'
                                                                                                                                    option = 'EQ'
                                                                                                                                    low    = wa-docno ) ) ) ) )
                                         ( tablename = '/SCWM/ORDIM_L'
                                           frange_t  = VALUE rsds_frange_t( ( fieldname = 'PROCTY'
                                                                              selopt_t  =  CORRESPONDING rsds_selopt_t( gr_otros_procesos ) )
                                                                            ( fieldname = 'MATID'
                                                                              selopt_t  =  VALUE rsds_selopt_t( sign   = 'I'
                                                                                                                option = 'EQ'
                                                                                                              ( low    = i_es_mercada-matid ) ) )
                                                                            ( fieldname = 'TOSTOP'
                                                                              selopt_t  =  VALUE rsds_selopt_t( sign   = 'I'
                                                                                                                option = 'EQ'
                                                                                                              ( low    = abap_true ) ) )
                                                                            ( fieldname = 'TOSTCO'
                                                                              selopt_t  =  VALUE rsds_selopt_t( sign   = 'I'
                                                                                                                option = 'EQ'
                                                                                                              ( low    = abap_true ) ) ) ) ) ).
    TRY.
        CALL FUNCTION '/SCWM/WHRHDR_OUT_TO_MON'
          EXPORTING
            iv_lgnum     = i_es_mercada-lgnum
            iv_mode      = '2'
          IMPORTING
            et_data      = ti_tareas
          CHANGING
            ct_tab_range = ti_range.
      CATCH /scwm/cx_mon_noexec.
    ENDTRY.

    LOOP AT ti_tareas ASSIGNING FIELD-SYMBOL(<fs_listar>) WHERE vlpla IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
        EXPORTING
          input  = <fs_listar>-meins
        IMPORTING
          output = <fs_listar>-meins.
      APPEND VALUE gtp_es_ola( tanum      = <fs_listar>-tanum
                               estado     = <fs_listar>-tostat
                               proceso    = <fs_listar>-procty
                               ump        = <fs_listar>-vlenr
                               ubicacion  = <fs_listar>-vlpla
                               matnr      = <fs_listar>-matnr
                               vbeln      = i_es_mercada-vbeln
                               docno      = i_es_mercada-docno
                               cant_tomar = <fs_listar>-vsolm
                               medida     = <fs_listar>-meins
                               orden      = <fs_listar>-who ) TO gti_listar.
    ENDLOOP.

    IF go_custom_listar IS NOT BOUND.

      go_custom_listar = NEW cl_gui_custom_container( container_name = 'CUSTOM_LISTAR' ).
      go_alv_listar    = NEW cl_gui_alv_grid( i_parent = go_custom_listar ).

      TRY.

          DATA(ti_catalogo) = zclcxr1002_util=>construir_catalogo( i_ti = gti_ola ).
          cambiar_catalogo_listar( CHANGING c_ti_catalog = ti_catalogo ).

        CATCH cx_dynamic_check.
        CATCH cx_static_check .
      ENDTRY.

      go_alv_listar->set_table_for_first_display(
        CHANGING
          it_outtab                     = gti_listar
          it_fieldcatalog               = ti_catalogo
        EXCEPTIONS
          invalid_parameter_combination = 1
          program_error                 = 2
          too_many_lines                = 3
          OTHERS                        = 4  ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                 WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.

    ELSE.

      go_alv_listar->refresh_table_display( ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                 WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.


    ENDIF.
  ENDMETHOD.


  METHOD modificar_tarea.

    DATA: ti_huhdr    TYPE /scwm/tt_huhdr_int,
          ti_bapiret2 TYPE bapiret2_t.

    DATA(ti_huident) = VALUE /scwm/tt_huident( ( lgnum = i_es_ola-lgnum huident = i_es_ola-ump_creada ) ).

    CALL FUNCTION '/SCWM/HU_SELECT'
      EXPORTING
        it_huident = ti_huident
      IMPORTING
        et_huhdr   = ti_huhdr
      EXCEPTIONS
        not_found  = 1
        error      = 2
        OTHERS     = 3.

    TRY.
        DATA(ti_change) = VALUE /scwm/tt_to_change( ( tanum = i_es_ola-tanum
                                                      d_new = abap_true
                                                      nltyp = ti_huhdr[ 1 ]-lgtyp
                                                      nlpla = ti_huhdr[ 1 ]-lgpla
                                                      nlenr = i_es_ola-ump_creada ) ).
      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    CALL FUNCTION '/SCWM/TO_CHANGE'
      EXPORTING
        iv_lgnum       = i_es_ola-lgnum
        iv_qname       = sy-uname
        iv_commit_work = abap_true
        it_change      = ti_change
      IMPORTING
        et_bapiret     = ti_bapiret2.

    COMMIT WORK AND WAIT.

    go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).


  ENDMETHOD.


  METHOD mostrar_alv.

    IF c_o_custom_contaner IS NOT BOUND.
      c_o_custom_contaner = NEW cl_gui_custom_container( container_name = i_nombre_custom_container ).
      c_o_alv =  NEW cl_gui_alv_grid( i_parent = c_o_custom_contaner ).
      TRY.
          DATA(ti_catalogo) = zclcxr1002_util=>construir_catalogo( i_ti = gti_ola ).
          cambiar_catalogo( CHANGING c_ti_catalog = ti_catalogo ).
        CATCH cx_dynamic_check .
        CATCH cx_static_check .
      ENDTRY.

      SET HANDLER: handle_toolbar FOR c_o_alv.
      DATA(es_layout) = VALUE lvc_s_layo( no_rowmark = abap_true ).
      c_o_alv->set_table_for_first_display(
          EXPORTING
            is_layout                     = es_layout
          CHANGING
            it_outtab                     = gti_data_mostrada    " Output Table
            it_fieldcatalog               = ti_catalogo          " Field Catalog
          EXCEPTIONS
            invalid_parameter_combination = 1
            program_error                 = 2
            too_many_lines                = 3
            OTHERS                        = 4  ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                   WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.
    ELSE.
      c_o_alv->check_changed_data( ).
      c_o_alv->refresh_table_display( ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                   WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD obtener_cantidad_ump.

    DATA(ti_huident)  = VALUE /scwm/tt_huident( ( lgnum   = i_lgnum
                                                  huident = |{ i_ump ALPHA = IN }| ) ).
    DATA(ti_data)     = VALUE /scwm/tt_huitm_int( ).
    DATA(ti_cabecera) = VALUE /scwm/tt_huhdr_int( ).
    CALL FUNCTION '/SCWM/HU_SELECT'
      EXPORTING
        it_huident = ti_huident
      IMPORTING
        et_huhdr   = ti_cabecera
        et_huitm   = ti_data
      EXCEPTIONS
        not_found  = 1
        error      = 2
        OTHERS     = 3.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
               WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.
    IF line_exists( ti_data[ 1 ] ).
      r_cantidad = ti_data[ 1 ]-quan.
      e_lgpla    = VALUE #( ti_cabecera[ 1 ]-lgpla OPTIONAL ).
    ENDIF.

  ENDMETHOD.


  METHOD obtener_consecutivo_entrega.

    TYPES: BEGIN OF tp_es_ump,
             exidv        TYPE vekp-exidv,
             spe_idart_01 TYPE i,
           END OF tp_es_ump.

    DATA: ti_cabecera_entrega TYPE /scwm/tt_wip_whrhead_out,
          ti_cabecera_um_ewm  TYPE /scwm/tt_huhdr_mon,
          ti_ump              TYPE STANDARD TABLE OF zclewme1030_norma_embalaje=>gtp_es_ump,
          ti_ump_num          TYPE STANDARD TABLE OF tp_es_ump.

    SELECT SINGLE ref~refdocno
    FROM /scwm/huref AS hu_ref
    JOIN /scdl/db_refdoc AS ref ON ref~docid = hu_ref~docid AND ref~itemid = '00000000000000000000000000000000' AND ref~refdoccat = 'ERP'
    WHERE hu_ref~guid_hu = @i_es_hu-guid_hu
    INTO @DATA(entrega_erp).

    CHECK sy-subrc = 0.

    "Crea la tabla del rango para consultar la información de las cajas
    DATA(ti_tab_range) = VALUE rsds_trange(
                           ( tablename = '/SCWM/S_WIP_Q_WHR_OUTBOUND'
                             frange_t  = VALUE rsds_frange_t( ( fieldname = 'REFDOCNO_ERP_H'
                                                                selopt_t  = VALUE #( ( sign = 'I' option = 'EQ' low = entrega_erp ) )
                                                             ) ) ) ).

    CHECK ti_tab_range IS NOT INITIAL.

    TRY.
        "Busca la cabecera de la entrega
        CALL FUNCTION '/SCWM/WHRHEAD_MON_OUT'
          EXPORTING
            iv_lgnum     = i_es_hu-lgnum
            iv_mode      = '2'
          IMPORTING
            et_data      = ti_cabecera_entrega
          CHANGING
            ct_tab_range = ti_tab_range.

        CALL FUNCTION '/SCWM/WHRHEAD_OUT_HU_MON'
          EXPORTING
            iv_lgnum       = i_es_hu-lgnum
            iv_mode        = '2'
            it_data_parent = ti_cabecera_entrega
          IMPORTING
            et_data        = ti_cabecera_um_ewm.

      CATCH /scwm/cx_mon_noexec.

    ENDTRY.

    SELECT ump~huident AS exidv, id~huident AS spe_ident_01
    FROM @ti_cabecera_um_ewm AS ewm_caja
    JOIN /scwm/huhdr AS ump ON ump~huident = ewm_caja~huident
    JOIN /scwm/hu_ident AS id ON id~guid_hu = ump~guid_hu AND id~idart = 'Z'
    APPENDING TABLE @ti_ump.

    CHECK ti_ump IS NOT INITIAL.

    LOOP AT ti_ump ASSIGNING FIELD-SYMBOL(<fs_es_ump>).
      TRY.
          APPEND CORRESPONDING #( <fs_es_ump> ) TO ti_ump_num.
        CATCH cx_sy_conversion_no_number.
      ENDTRY.
    ENDLOOP.

    SORT ti_ump_num ASCENDING BY spe_idart_01.
    r_es_ump = CORRESPONDING #( ti_ump_num[ lines( ti_ump_num ) ] ).


  ENDMETHOD.


  METHOD obtener_entregas_pend_mat.

    DATA(ti_material) = gti_ola.
    DELETE ti_material WHERE matid NE i_es_ola-matid.
    DELETE ti_material WHERE confirmada EQ abap_true.
    r_total_entregas_pend_mat = lines( ti_material ).

  ENDMETHOD.


  METHOD obtener_parametros.

    DATA: r_parametro TYPE RANGE OF zzedlow.

    DATA(o_parametros) = NEW zclcxr1000_parametros( i_modulo = 'EWM' i_ricefw = CONV #( gc_ricefw ) ).

    o_parametros->get_parametro(
     EXPORTING
       i_idparam               = 'PROCESO'
     IMPORTING
       e_ti_valrango           = r_parametro
     EXCEPTIONS
       parametro_no_encontrado = 1 ).

    TRY.
        r_tipo_movimiento = r_parametro[ 1 ]-low.
        CLEAR:r_parametro.
      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    o_parametros->get_parametro(
     EXPORTING
       i_idparam               = 'C_PROCESO'
     IMPORTING
       e_ti_valrango           = r_parametro
     EXCEPTIONS
       parametro_no_encontrado = 1 ).

    TRY.
        g_conf_tipo_movimiento = r_parametro[ 1 ]-low.
        CLEAR:r_parametro.
      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    o_parametros->get_parametro(
     EXPORTING
       i_idparam               = 'TP_ALMACEN'
     IMPORTING
       e_ti_valrango           = r_parametro
     EXCEPTIONS
       parametro_no_encontrado = 1 ).

    TRY.
        e_tipo_almacen = r_parametro[ 1 ]-low.
        CLEAR:r_parametro.
      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    o_parametros->get_parametro(
     EXPORTING
       i_idparam               = 'MAT_EMPAQU'
     IMPORTING
       e_ti_valrango           = r_parametro
     EXCEPTIONS
       parametro_no_encontrado = 1 ).

    TRY.
        e_material_empaque = r_parametro[ 1 ]-low.
        CLEAR:r_parametro.
      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    o_parametros->get_parametro(
    EXPORTING
      i_idparam               = 'OTR_PROCES'
    IMPORTING
      e_ti_valrango           = gr_otros_procesos
    EXCEPTIONS
      parametro_no_encontrado = 1 ).

    o_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'ENCONA'
      IMPORTING
        e_ti_valrango           = r_parametro
      EXCEPTIONS
        parametro_no_encontrado = 1 ).

    TRY.
        g_caract_encona = r_parametro[ 1 ]-low.
        CLEAR:r_parametro.
      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

    o_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'TOLERANCIA'
      IMPORTING
        e_ti_valrango           = r_parametro
      EXCEPTIONS
        parametro_no_encontrado = 1 ).

    TRY.
        g_tolerancia = r_parametro[ 1 ]-low.
        CLEAR:r_parametro.
      CATCH cx_sy_itab_line_not_found cx_root.
        g_tolerancia = 0.
    ENDTRY.

    o_parametros->get_parametro(
      EXPORTING
        i_idparam               = 'MAX_TOLERA'
      IMPORTING
        e_ti_valrango           = r_parametro
      EXCEPTIONS
        parametro_no_encontrado = 1 ).

    TRY.
        g_tolerancia_maxima = r_parametro[ 1 ]-low.
        CLEAR:r_parametro.
      CATCH cx_sy_itab_line_not_found cx_root.
        g_tolerancia_maxima = 15000.
    ENDTRY.

  ENDMETHOD.


  METHOD obtener_param_conf_ubica.

    CONSTANTS:
      c_modulo  TYPE zzedmodulo  VALUE 'EWM',
      c_idparam TYPE zzedidparam VALUE 'CONF_UBICA',
      c_si      TYPE char02      VALUE 'SI',
      c_no      TYPE char02      VALUE 'NO'.

    DATA:
      r_valores TYPE RANGE OF char02.


    CLEAR me->g_confirmar_ubicacion.

    DATA(o_parametros) = NEW zclcxr1000_parametros( i_modulo = c_modulo i_ricefw = CONV #( me->gc_ricefw ) ).

    o_parametros->get_parametro(
     EXPORTING
       i_idparam               = c_idparam
     IMPORTING
       e_ti_valrango           = r_valores
     EXCEPTIONS
       parametro_no_encontrado = 1 ).

    TRY.
        me->g_confirmar_ubicacion = r_valores[ 1 ]-low.
        TRANSLATE me->g_confirmar_ubicacion TO UPPER CASE.
      CATCH cx_sy_itab_line_not_found.
        me->g_confirmar_ubicacion = c_no.
    ENDTRY.

    IF me->g_confirmar_ubicacion <> c_si AND
       me->g_confirmar_ubicacion <> c_no.
      me->g_confirmar_ubicacion = c_no.
    ENDIF.

  ENDMETHOD.


  METHOD obtener_valores_dynpro.

    CONSTANTS: c_programa TYPE sy-repid VALUE 'ZEWMR1015_1'.

    CALL FUNCTION 'DYNP_VALUES_READ'
      EXPORTING
        dyname               = c_programa
        dynumb               = '0200'
        translate_to_upper   = abap_true
      TABLES
        dynpfields           = e_dynpfields
      EXCEPTIONS
        invalid_abapworkarea = 1
        invalid_dynprofield  = 2
        invalid_dynproname   = 3
        invalid_dynpronummer = 4
        invalid_request      = 5
        no_fielddescription  = 6
        invalid_parameter    = 7
        undefind_error       = 8
        double_conversion    = 9
        stepl_not_found      = 10
        OTHERS               = 11.

  ENDMETHOD.


  METHOD proceso_pai_100.

    CASE i_ok_code.
      WHEN 'EXIT' OR 'CANCEL'.
        LEAVE TO SCREEN 0.
      WHEN 'BACK' OR 'CANCELAR'.
        IF c_sub_screen EQ '0400'.
          c_sub_screen = '0200'.
        ELSEIF c_sub_screen EQ '0200'.
          c_sub_screen = '0300'.
          limpiar_pantalla( EXPORTING
                                i_borrar_solo_ump = COND #( WHEN i_ok_code = 'CANCELAR' THEN abap_true )
                            CHANGING
                                c_es_distribucion = c_es_distribucion
                                c_es_ola          = c_es_ola ).
        ELSE.
          LEAVE TO SCREEN 0.
        ENDIF.
      WHEN 'CONTINUAR' OR ''.
        "Evaluar si está digitando por primera vez o si cambio de ump y la ola está vacia
        IF |{ c_es_distribucion-ola ALPHA = IN }| NE g_num_ola OR c_es_ola IS INITIAL OR |{ c_es_distribucion-ump ALPHA = IN }| NE g_num_ump.
          TRY.
              validar_proceso( CHANGING
                                  c_es_distribucion = c_es_distribucion
                                  c_es_ola          = c_es_ola
                                  c_sub_screen      = c_sub_screen ).

              CLEAR: c_ubicacion_verif."+SLS 01.06.2023 : Limpia ubicacion

            CATCH cx_t100_msg INTO DATA(o_cx).
              c_sub_screen = '0300'.
              go_log->set_o_cx_log( i_o_cx_log = o_cx ).
          ENDTRY.
        ELSE.
          actualizar_calculos( CHANGING c_es_ola = c_es_ola c_es_distribucion = c_es_distribucion c_sub_screen = c_sub_screen ).
        ENDIF.

        "Verificar si los campos báscula y ubicación
        "verificable no están vacíos y
        "si confirmar ubicación es válida.
        IF NOT c_es_ola-peso_bascula IS INITIAL AND
           NOT c_ubicacion_verif IS INITIAL AND
           me->si_confirmar_ubicacion( ) = abap_true.
          TRY.
              me->verificar_confirma_ubicacion(
                EXPORTING
                  " Número de almacén/Complejo de almacenes
                  i_numero_almacen  = c_es_ola-lgnum
                  " Ubicación
                  i_ubicacion       = CONV #( c_es_ola-ubicacion )
                  " Campo verificación en entrada de datos portátil
                  i_ubicacion_verif = c_ubicacion_verif ).
            CATCH cx_t100_msg INTO o_cx.
              go_log->set_o_cx_log( i_o_cx_log = o_cx ).
          ENDTRY.

        ENDIF.
      WHEN 'SALTAR'.
        saltar_entrega( CHANGING
                          c_es_distribucion = c_es_distribucion
                          c_es_ola          = c_es_ola
                          c_sub_screen      = c_sub_screen ).
      WHEN 'CORREGIR'.
        CLEAR: c_es_ola-conos_despachar, c_es_ola-peso_bascula, c_es_ola-peso_bascula,
               c_ubicacion_verif."+SLS 03:06.2023: limpiar campo
      WHEN 'LANZA'.
        rechazar_lanzar_mercada( EXPORTING
                                    i_es_ola = c_es_ola
                                 CHANGING
                                    c_o_alv  = c_o_alv ).
        IF go_log->get_errores( ) IS INITIAL.
          CLEAR: c_es_ola-ump_creada, c_es_ola-ump_destino_out, c_es_ola-id_ump_creada.
        ENDIF.

      WHEN 'CERRAR'.
        TRY.
            "SLS 16.08.2023 Proyecto Materia Prima: Ya no se requeire la opcion de cerrar caja, se remplaza por imprimir cajas
            imprimir_cajas( i_es_distribucion = VALUE #( ump = c_es_ola-ump_creada ola = c_es_distribucion-ola
                                                         lgnum = c_es_distribucion-lgnum isla = c_es_distribucion-isla
                                                         guid_hu = c_es_ola-id_ump_creada
                                                         entrega_erp = c_es_ola-vbeln ) ).
          CATCH cx_t100_msg INTO o_cx.
            go_log->set_o_cx_log( i_o_cx_log = o_cx ).
        ENDTRY.
***        cerrar_ump( i_es_distribucion = VALUE #( lgnum = c_es_distribucion-lgnum isla = c_es_distribucion-isla guid_hu = c_es_ola-id_ump_creada ump = c_es_ola-ump_creada ) ).
***        CLEAR: c_es_ola-id_ump_creada, c_es_ola-ump_creada.
      WHEN 'LISTAR'.
        listar_mercada( i_es_mercada = c_es_ola i_ump = c_es_distribucion-ump ).
        c_sub_screen = '0400'.
      WHEN 'CONFIRMAR'.
        TRY.
            "Verificar si confirmar ubicación es válida.
            IF me->si_confirmar_ubicacion( ) = abap_true.
              me->verificar_confirma_ubicacion(
                EXPORTING
                  " Número de almacén/Complejo de almacenes
                  i_numero_almacen  = c_es_ola-lgnum
                  " Ubicación
                  i_ubicacion       = CONV #( c_es_ola-ubicacion )
                  " Campo verificación en entrada de datos portátil
                  i_ubicacion_verif = c_ubicacion_verif ).
            ENDIF.

            "+SLS 28.07.2023: Buscan las tareas de almacén que tiene pendientes por confirmar, clase de proceso de almacén Y214,
            "se debe validar que la tarea tenga como tipo de almacén  origen (VLTYP) el valor PPK y como tipo de stock origen el valor FD{
            validar_tipo_tarea( CHANGING c_es_ola = c_es_ola ).
            "}

            confirmar( EXPORTING i_es_distribucion = c_es_distribucion CHANGING c_es_ola = c_es_ola c_es_distribucion = c_es_distribucion  c_sub_screen = c_sub_screen ).
            IF gti_data_mostrada IS INITIAL AND go_log->get_errores( ) IS INITIAL.
              IF go_dao->obtener_pendientes_ola( i_lgnum = c_es_distribucion-lgnum
                                                 i_ola   = c_es_distribucion-ola ) IS NOT INITIAL.
                DATA(ola)  = c_es_distribucion-ola.
                DATA(isla) = c_es_distribucion-isla.
                limpiar_pantalla( CHANGING c_es_distribucion = c_es_distribucion c_es_ola = c_es_ola ).
                c_es_distribucion-ola             = ola.
                c_es_distribucion-ola_verificada  = abap_true.
                c_es_distribucion-isla            = isla.
                c_es_distribucion-isla_verificada = abap_true.
                g_num_ola                         = |{ ola ALPHA = IN }|.
                g_num_isla                        = isla.
                c_sub_screen                      = '0300'.
              ELSE.
                limpiar_pantalla( CHANGING c_es_distribucion = c_es_distribucion c_es_ola = c_es_ola ).
                go_log->set_es_log( i_es = VALUE #( id = 'ZEWM01' number = '036' type = 'W' ) ).
              ENDIF.

            ELSEIF go_log->get_errores( ) IS INITIAL.
              saltar_entrega( CHANGING
                                c_es_distribucion = c_es_distribucion
                                c_es_ola          = c_es_ola
                                c_sub_screen      = c_sub_screen ).
            ENDIF.

            CLEAR: c_ubicacion_verif."+SLS 01.06.2023 : Limpia ubicacion

          CATCH cx_t100_msg INTO o_cx.
            go_log->set_o_cx_log( i_o_cx_log = o_cx ).
        ENDTRY.
    ENDCASE.
    IF go_log->get_log( ) IS NOT INITIAL.
      go_log->mostrar_log( i_ventana_emergente = abap_true i_limpiar_mensajes = abap_true ).
    ENDIF.

  ENDMETHOD.


  METHOD proceso_pbo_200.

    asignar_ubicacion( EXPORTING
                              i_nombre_custom_container = i_custom_num
                       CHANGING
                              c_o_custom_contaner       = c_o_custom_num
                              c_es_ola                  = c_es_ola ).
    mostrar_alv( EXPORTING
                      i_nombre_custom_container         = i_custom_alv
                 CHANGING
                      c_o_custom_contaner               = c_o_custom_alv
                      c_o_alv                           = c_o_alv ).

  ENDMETHOD.


  METHOD rechazar_lanzar_mercada.

    DATA: ti_bapiret TYPE bapiret2_t.

    c_o_alv->check_changed_data( ).
    c_o_alv->refresh_table_display( ).
    TRY.
        i_es_ola = gti_data_mostrada[ marcar = abap_true ].
      CATCH cx_sy_itab_line_not_found.
        go_log->set_es_log( i_es = VALUE #( type = gc_mensaje_e id = gc_mensaje_id number = '091' ) ).
        RETURN.
    ENDTRY.

    CHECK i_es_ola IS NOT INITIAL.

    rechazar_mercada( i_lgnum = i_es_ola-lgnum i_tanum = i_es_ola-tanum i_cant_tomar = i_es_ola-cant_tomar i_altme = i_es_ola-medida ).

    IF go_log->get_errores( ) IS INITIAL.

      DELETE gti_ola WHERE tanum   = i_es_ola-tanum
                       AND guid_hu = i_es_ola-guid_hu
                       AND docid   = i_es_ola-docid
                       AND itemid  = i_es_ola-itemid.

      DELETE gti_data_mostrada WHERE tanum   = i_es_ola-tanum
                                 AND guid_hu = i_es_ola-guid_hu
                                 AND docid   = i_es_ola-docid
                                 AND itemid  = i_es_ola-itemid.

      DATA(ti_create_fm) = VALUE /scwm/tt_to_prep_whr_int( ( rdocid  = i_es_ola-docid
                                                             ritmid  = i_es_ola-itemid
                                                             rdoccat = 'PDO' ) ).

      CALL FUNCTION '/SCWM/TO_CREATE_WHR'
        EXPORTING
          iv_lgnum       = i_es_ola-lgnum
          iv_to_init     = abap_true
          iv_bname       = sy-uname
          it_create_whr  = ti_create_fm
          iv_update_task = abap_true
          iv_commit_work = abap_true
        IMPORTING
          et_bapiret     = ti_bapiret.

      COMMIT WORK AND WAIT.

      go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret ) ).
    ENDIF.

  ENDMETHOD.


  METHOD rechazar_mercada.

    DATA: ti_bapiret2 TYPE bapiret2_t,
          ti_ltap_vb  TYPE /scwm/tt_ltap_vb.

    DATA(ti_configuracion) = VALUE /scwm/to_conf_tt( ( tanum = i_tanum
                                                       papos = 0
                                                       altme = i_altme
                                                       nista = 0
                                                       resta = i_cant_tomar
                                                       ndifa = i_cant_tomar ) ).
    DATA(ti_config_exc) = VALUE /scwm/tt_conf_exc( ( tanum      = i_tanum
                                                     papos      = 0
                                                     exccode    = 'BIDF'
                                                     buscon     = 'TPI'
                                                     exec_step  = '26' ) ).
    CALL FUNCTION '/SCWM/TO_CONFIRM'
      EXPORTING
        iv_lgnum       = i_lgnum
        iv_qname       = sy-uname
        iv_update_task = space
        iv_commit_work = abap_true
        it_conf        = ti_configuracion
        it_conf_exc    = ti_config_exc
      IMPORTING
        et_ltap_vb     = ti_ltap_vb
        et_bapiret     = ti_bapiret2.

    COMMIT WORK AND WAIT.

    go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).

  ENDMETHOD.


  METHOD saltar_entrega.

    IF gti_data_mostrada IS NOT INITIAL.
      IF c_es_ola-confirmada NE abap_true.
        APPEND c_es_ola TO gti_data_mostrada.
      ENDIF.
      TRY.
          c_es_ola = gti_data_mostrada[ 1 ].
          DELETE gti_data_mostrada INDEX 1.

          c_es_ola-gramos_um                 = obtener_cantidad_ump( i_lgnum = c_es_ola-lgnum i_ump = c_es_ola-ump ).
          c_es_ola-cant_disponible           = c_es_ola-gramos_um.
          c_es_distribucion-total_material   = total_entregas( i_ti_ola = gti_data_mostrada ).
          c_es_distribucion-total_pendientes = obtener_entregas_pend_mat( i_es_ola = c_es_ola ).
          IF c_es_ola-ubicacion IS INITIAL.
            c_es_ola-ubicacion = determinar_ubicacion( i_ola = c_es_distribucion-ola i_entrega = c_es_ola-vbeln i_isla = c_es_distribucion-isla i_numero_almacen = c_es_ola-lgnum ).
            IF c_es_ola-ubicacion IS INITIAL.
              CLEAR: c_es_ola.
              go_log->set_es_log(  i_es = VALUE #( type = gc_mensaje_e id = gc_mensaje_id number = '037' ) ).
              c_sub_screen = '0300'.
            ENDIF.
          ENDIF.
          c_es_ola-ump_creada    = determinar_ump_destino( i_lgnum = c_es_ola-lgnum i_lgpla = c_es_ola-ubicacion i_dstgrp = c_es_ola-dstgrp ).
          c_es_ola-id_ump_creada = COND #( WHEN c_es_ola-ump_creada IS NOT INITIAL THEN
                                                go_dao->obtener_ump( i_ump = c_es_ola-ump_creada )-guid_hu
                                           ELSE space ).
          asignar_valores_out_put( CHANGING c_es_ola = c_es_ola c_es_distribucion = c_es_distribucion  c_sub_screen = c_sub_screen ).
        CATCH cx_sy_itab_line_not_found.
      ENDTRY.
    ELSE.
      go_log->set_es_log(  i_es = VALUE #( type = gc_mensaje_w id = gc_mensaje_id number = '031' message_v1 = c_es_distribucion-ump ) ).
    ENDIF.

  ENDMETHOD.


  METHOD si_confirmar_ubicacion.

    CONSTANTS:
      c_si TYPE char02 VALUE 'SI'.


    "Inicializa la respuesta
    r_respuesta = abap_false.

    "Verificar el atributo
    IF me->g_confirmar_ubicacion = c_si.
      "Cambia de estado la respuesta
      r_respuesta = abap_true.
    ENDIF.

  ENDMETHOD.


  METHOD total_entregas.

    SELECT COUNT( vbeln ) AS entregas
    FROM vbss
    WHERE sammg = @g_num_ola
    INTO @r_total_entregas_material.

  ENDMETHOD.


  METHOD ultima_tarea_posicion.

    SELECT ordim~tanum
    FROM /scwm/ordim_o AS ordim
    WHERE ordim~rdocid = @i_es_ola-docid
      AND ordim~ritmid = @i_es_ola-itemid
      INTO TABLE @DATA(ti_data).

    IF sy-subrc <> 0.
      r_result = abap_true.
    ENDIF.

  ENDMETHOD.


  METHOD validar_cierre.

    DATA: ti_id_externo TYPE STANDARD TABLE OF sval.

    IF c_es_ola-ump_creada IS INITIAL.
      c_es_ola-ump_creada = determinar_ump_destino( i_lgnum = c_es_ola-lgnum i_lgpla = c_es_ola-ubicacion i_dstgrp = c_es_ola-dstgrp ).
      IF c_es_ola-ump_creada IS INITIAL.
        DATA(ump_creada)       = crear_ump( i_lgnum = c_es_ola-lgnum i_lgpla = c_es_ola-ubicacion i_dstgrp = c_es_ola-dstgrp ).
        c_es_ola-ump_creada    = ump_creada-huident.
        c_es_ola-id_ump_creada = ump_creada-guid_hu.
      ENDIF.
    ENDIF.

    IF ultima_tarea_posicion( i_es_ola = c_es_ola ) = abap_true.
      asignar_codigo_de_proceso( i_es_ola = c_es_ola ).
    ENDIF.

    SELECT status_value
        INTO TABLE @DATA(ti_estados_entrega)
        FROM /scdl/db_status
        WHERE docid       = @c_es_ola-docid
          AND status_type = 'DPI'.

    LOOP AT ti_estados_entrega ASSIGNING FIELD-SYMBOL(<fs_es_estado>) WHERE status_value NE '9'.
      DATA(pendiente) = abap_true.
      EXIT.
    ENDLOOP.

    IF pendiente EQ space.
      DO.
        IF c_es_ola-id_externo IS INITIAL.
          ti_id_externo = VALUE #( ( tabname = 'ZTEWMR1015_3' fieldname = 'IDENTIFICADOR' ) ).
          CALL FUNCTION 'POPUP_GET_VALUES'
            EXPORTING
              popup_title     = TEXT-029
            TABLES
              fields          = ti_id_externo
            EXCEPTIONS
              error_in_fields = 1
              OTHERS          = 2.

          c_es_ola-id_externo = VALUE #( ti_id_externo[ 1 ]-value OPTIONAL ).

        ENDIF.
        IF c_es_ola-id_externo IS NOT INITIAL.
          IF c_es_ola-original_id_externo IS INITIAL.
            DATA(sy_subrc) = go_dao->guardar_id_externo( i_ump         = c_es_ola-ump_creada
                                                         i_entrega_erp = |{ c_es_ola-vbeln ALPHA = IN }|
                                                         i_id_externo  = c_es_ola-id_externo ).
            "Verificar si el guardado fue existoso
            IF sy_subrc = 0.
              "Actualizar el indicador de procesado para los id_externo existentes.
              go_dao->actualizar_id_externo_activo(
                EXPORTING
                  i_ump        = c_es_ola-ump_creada
                  i_id_externo = c_es_ola-id_externo
              ).
            ENDIF.
          ENDIF.
          go_log->set_es_log( i_es = VALUE #( type = gc_mensaje_w id = gc_mensaje_id number = '035' message_v1 = c_es_ola-vbeln message_v2 = c_es_ola-ubicacion ) ).
          "SLS 16.08.2023 Proyecto Materia Prima: Aumentar contador de impresion
          IF go_log->get_errores( ) IS INITIAL.
            imprimir_cajas( i_es_distribucion = VALUE #( ump = c_es_ola-ump_creada ola = i_es_distribucion-ola
                                                         lgnum = i_es_distribucion-lgnum isla = i_es_distribucion-isla
                                                         guid_hu = c_es_ola-id_ump_creada
                                                         entrega_erp = c_es_ola-vbeln )
                            i_no_imprimir = abap_true ).

          ENDIF.
          cerrar_ump( i_es_distribucion = VALUE #( lgnum = i_es_distribucion-lgnum isla = i_es_distribucion-isla guid_hu = c_es_ola-id_ump_creada ump = c_es_ola-ump_creada ) ).
          EXIT.
        ENDIF.
      ENDDO.

    ENDIF.
    IF c_es_ola-tipo_cono IS NOT INITIAL.
      go_dao->insertar_tipo_cono( i_matnr = CONV #( c_es_ola-matnr ) i_cono = c_es_ola-tipo_cono ).
    ENDIF.

  ENDMETHOD.


  METHOD validar_proceso.

    CONSTANTS:
      "! Constante con la screen <strong>0200</strong>.
      c_scr_0200 TYPE sy-dynnr VALUE '0200'.

    DATA: atinn TYPE atinn.

    IF |{ c_es_distribucion-ola ALPHA = IN }| EQ g_num_ola OR g_num_ola IS INITIAL.

      IF c_es_distribucion-ola_verificada IS INITIAL AND c_es_distribucion-ola IS NOT INITIAL.

        g_proceso = obtener_parametros( IMPORTING e_tipo_almacen = g_tipo_almacen e_material_empaque = g_material_empaque ).
        DATA(r_procesos) = gr_otros_procesos.
        APPEND VALUE #( sign = 'I'  option = 'EQ' low = g_proceso ) TO r_procesos.

        IF go_dao IS NOT BOUND.
          go_dao = NEW zclewmr1015_dao( ).
        ENDIF.

        CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
          EXPORTING
            input  = g_caract_encona
          IMPORTING
            output = atinn.

        go_dao->obtener_datos_ola( EXPORTING
                                     i_mandt    = sy-mandt
                                     i_sammg    = |{ c_es_distribucion-ola ALPHA = IN }|
                                     i_r_procty = r_procesos
                                     i_procty   = g_proceso
                                     i_atinn    = atinn
                                   IMPORTING
                                     e_ti_ola   = go_dao->g_ti_ola ).

        gti_ola = go_dao->g_ti_ola.
        g_num_ola = |{ c_es_distribucion-ola ALPHA = IN }|.
        SORT gti_ola BY cant_necesaria vbeln ASCENDING.

        IF gti_ola IS NOT INITIAL.
          c_es_distribucion-ola_verificada = abap_true.
          c_es_distribucion-total_entregas = total_entregas( i_ti_ola = gti_ola ).
          IF c_es_distribucion-lgnum NE gti_ola[ 1 ]-lgnum.
            RAISE EXCEPTION TYPE cx_t100_msg
              EXPORTING
                t100_msgid = gc_mensaje_id
                t100_msgno = '034'
                t100_msgv1 = CONV #( c_es_distribucion-ola )
                t100_msgv2 = CONV #( c_es_distribucion-lgnum ).
          ENDIF.
        ELSE.
          limpiar_pantalla( CHANGING c_es_distribucion = c_es_distribucion c_es_ola = c_es_ola ).

          RAISE EXCEPTION TYPE cx_t100_msg
            EXPORTING
              t100_msgid = gc_mensaje_id
              t100_msgno = '018'.

        ENDIF.
      ENDIF.
      IF g_num_isla EQ c_es_distribucion-isla OR g_num_isla IS INITIAL.
        IF c_es_distribucion-ola_verificada EQ abap_true.
          IF c_es_distribucion-isla_verificada IS INITIAL AND c_es_distribucion-isla IS NOT INITIAL.
            DATA(es_isla) = go_dao->obtener_isla( i_lgnum = c_es_distribucion-lgnum i_isla = c_es_distribucion-isla ).
            IF es_isla IS NOT INITIAL.
              IF es_isla-lgtyp NE 'PPK'.
                RAISE EXCEPTION TYPE cx_t100_msg
                  EXPORTING
                    t100_msgid = gc_mensaje_id
                    t100_msgno = '038'.
              ELSE.
                c_es_distribucion-isla_verificada = abap_true.
                g_num_isla = c_es_distribucion-isla.
                determinar_ubicacion(
                  EXPORTING
                    i_ola            = c_es_distribucion-ola
                    i_isla           = c_es_distribucion-isla
                    i_numero_almacen = c_es_distribucion-lgnum
                    IMPORTING
                    e_proceso_cancelado = DATA(cancelar) ).
                IF cancelar EQ abap_true.
                  limpiar_pantalla( CHANGING c_es_distribucion = c_es_distribucion ).
                  RETURN.
                ENDIF.
              ENDIF.
            ELSE.
              c_es_distribucion-isla = space.
              RAISE EXCEPTION TYPE cx_t100_msg
                EXPORTING
                  t100_msgid = gc_mensaje_id
                  t100_msgno = '019'.
            ENDIF.
          ENDIF.

          IF c_es_distribucion-isla_verificada EQ abap_true.
            IF c_es_distribucion-ump IS NOT INITIAL.
              DATA(es_ump) = go_dao->obtener_ump( i_ump = |{ c_es_distribucion-ump ALPHA = IN }| ).

              IF es_ump IS INITIAL.
                RAISE EXCEPTION TYPE cx_t100_msg
                  EXPORTING
                    t100_msgid = gc_mensaje_id
                    t100_msgno = '020'.
              ELSE.
                "Obtener tareas de picking
                DATA(es_orim) = go_dao->obtener_tareas_ump( i_lgnum    = c_es_distribucion-lgnum
                                                            i_ump      = |{ c_es_distribucion-ump ALPHA = IN }|
                                                            i_flghuto  = abap_true
                                                            i_r_procty = VALUE #( sign = 'I' option = 'EQ' ( low = g_conf_tipo_movimiento ) )
                                                            i_tipo_almacen = g_tipo_almacen ).
                "Confirmar la tarea de picking si no lo está
                IF es_orim IS NOT INITIAL.
                  "Confirmar con /SCWM/TO_CONFIRM
                  DATA(ti_conf) = VALUE /scwm/to_conf_tt( ( tanum = es_orim-tanum nista = es_orim-vsolm altme = es_orim-meins ) ).
                  CALL FUNCTION '/SCWM/TO_CONFIRM'
                    EXPORTING
                      iv_lgnum       = c_es_distribucion-lgnum
                      iv_update_task = space
                      it_conf        = ti_conf.
                  COMMIT WORK AND WAIT.

                  go_dao->obtener_datos_ola( EXPORTING
                                               i_mandt    = sy-mandt
                                               i_sammg    = |{ c_es_distribucion-ola ALPHA = IN }|
                                               i_r_procty = r_procesos
                                               i_procty   = g_proceso
                                               i_atinn    = atinn
                                             IMPORTING
                                               e_ti_ola   = go_dao->g_ti_ola ).

                  gti_ola = go_dao->g_ti_ola.
                ENDIF.

                es_orim = go_dao->obtener_tareas_ump( i_lgnum    = c_es_distribucion-lgnum
                                                      i_ump      = |{ c_es_distribucion-ump ALPHA = IN }|
                                                      i_r_procty = VALUE #( sign = 'I' option = 'EQ' ( low = g_proceso ) )
                                                      i_tipo_almacen = g_tipo_almacen ).
                IF es_orim IS INITIAL.
                  RAISE EXCEPTION TYPE cx_t100_msg
                    EXPORTING
                      t100_msgid = gc_mensaje_id
                      t100_msgno = '021'.
                ELSE.

                  TRY.
                      IF NOT line_exists( gti_ola[ ump = |{ c_es_distribucion-ump ALPHA = IN }| proceso = g_proceso ] ).
                        go_dao->obtener_datos_ola( EXPORTING
                                                     i_mandt    = sy-mandt
                                                     i_sammg    = |{ c_es_distribucion-ola ALPHA = IN }|
                                                     i_r_procty = r_procesos
                                                     i_procty   = g_proceso
                                                     i_atinn    = atinn
                                                   IMPORTING
                                                     e_ti_ola   = go_dao->g_ti_ola ).

                        gti_ola = go_dao->g_ti_ola.
                      ENDIF.
                      c_es_ola = gti_ola[ ump = |{ c_es_distribucion-ump ALPHA = IN }| proceso = g_proceso ].
                      IF c_es_ola-estado IS NOT INITIAL.
                        CLEAR: c_es_ola, c_es_distribucion-ump.
                        RAISE EXCEPTION TYPE cx_t100_msg
                          EXPORTING
                            t100_msgid = gc_mensaje_id
                            t100_msgno = '021'.
                      ENDIF.
                      g_num_ump = |{ c_es_distribucion-ump ALPHA = IN }|.
                      c_es_distribucion-guid_hu = es_ump-guid_hu.
                      c_sub_screen = '0200'.
                      c_es_distribucion-total_material   = determinacion_material( i_es_ola = c_es_ola ).
********************************************************************************************************************************************************************
                      c_es_ola-conos_despachados         = go_dao->obtener_conos( i_lgnum       = c_es_distribucion-lgnum
                                                                                  i_entrega_erp = c_es_ola-vbeln
                                                                                  i_posicion    = CONV #( c_es_ola-posnr ) ).
                      c_es_ola-gramos_mercados           = go_dao->obtener_gramos_mercados( i_lgnum  = c_es_distribucion-lgnum
                                                                                            i_docid  = c_es_ola-docid
                                                                                            i_itemid = c_es_ola-itemid ).
                      c_es_ola-cant_necesaria            = c_es_ola-cant_necesaria - c_es_ola-gramos_mercados.
********************************************************************************************************************************************************************
                      c_es_distribucion-total_pendientes = obtener_entregas_pend_mat( i_es_ola = c_es_ola ).
                      c_es_ola-ordenes_pendientes        = lines( gti_data_mostrada ) + 1.
                      IF c_es_ola-gramos_um IS INITIAL.
                        c_es_ola-gramos_um = obtener_cantidad_ump( i_lgnum = c_es_ola-lgnum i_ump = c_es_ola-ump ).
                        c_es_ola-cant_disponible = c_es_ola-gramos_um.
                        IF c_es_ola-ubicacion IS INITIAL.
                          c_es_ola-ubicacion  = determinar_ubicacion( i_ola = c_es_distribucion-ola i_entrega = c_es_ola-vbeln i_isla = c_es_distribucion-isla i_numero_almacen = c_es_ola-lgnum ).

                          IF c_es_ola-ubicacion IS INITIAL.
                            CLEAR: c_es_ola.
                            RAISE EXCEPTION TYPE cx_t100_msg
                              EXPORTING
                                t100_msgid = gc_mensaje_id
                                t100_msgno = '037'.
                          ENDIF.

                        ENDIF.
                        c_es_ola-ump_creada    = determinar_ump_destino( i_lgnum = c_es_ola-lgnum i_lgpla = c_es_ola-ubicacion i_dstgrp = c_es_ola-dstgrp ).
                        c_es_ola-id_ump_creada = COND #( WHEN c_es_ola-ump_creada IS NOT INITIAL THEN
                                                                go_dao->obtener_ump( i_ump = c_es_ola-ump_creada )-guid_hu
                                                         ELSE space ).
                        IF c_es_ola-ump_creada IS NOT INITIAL.
                          c_es_ola-original_id_externo = go_dao->obtener_id_externo( i_ump = c_es_ola-ump_creada ).
                          c_es_ola-id_externo          = c_es_ola-original_id_externo.
                        ENDIF.

                        MODIFY gti_ola FROM c_es_ola TRANSPORTING gramos_um cant_disponible WHERE ump = c_es_ola-ump.
                        MODIFY gti_ola FROM c_es_ola TRANSPORTING ubicacion ump_creada WHERE vbeln = c_es_ola-vbeln.
                      ENDIF.
                      asignar_valores_out_put( CHANGING c_es_ola = c_es_ola c_es_distribucion = c_es_distribucion c_sub_screen = c_sub_screen ).
                    CATCH cx_sy_itab_line_not_found.
                      CLEAR: c_es_distribucion-ump.
                      RAISE EXCEPTION TYPE cx_t100_msg
                        EXPORTING
                          t100_msgid = gc_mensaje_id
                          t100_msgno = '022'.
                  ENDTRY.
                ENDIF.
              ENDIF.
            ELSE.
              go_log->set_es_log( i_es = VALUE #( type = gc_mensaje_w id = gc_mensaje_id number = '023' ) ).
            ENDIF.
          ELSE.
            go_log->set_es_log( i_es = VALUE #( type = gc_mensaje_w id = gc_mensaje_id number = '024' ) ).
          ENDIF.

        ELSEIF c_es_distribucion-ola IS INITIAL.
          go_log->set_es_log( i_es = VALUE #( type = gc_mensaje_w id = gc_mensaje_id number = '025' ) ).
        ENDIF.
      ELSE.
        CLEAR:  c_es_distribucion-isla_verificada, c_es_distribucion-ump, g_num_isla,c_es_distribucion-total_entregas,
                c_es_distribucion-total_material, c_es_distribucion-total_pendientes, c_es_ola.
        validar_proceso( CHANGING
                            c_es_distribucion = c_es_distribucion
                            c_es_ola          = c_es_ola
                            c_sub_screen      = c_sub_screen ).
      ENDIF.
    ELSE.
      DATA(nueva_ola) = c_es_distribucion-ola.
      DATA(isla)      = c_es_distribucion-isla.
      DATA(ump)       = c_es_distribucion-ump.
      limpiar_pantalla( CHANGING c_es_distribucion = c_es_distribucion ).
      c_es_distribucion-ola   = nueva_ola.
      c_es_distribucion-isla  = isla.
      c_es_distribucion-ump   = ump.
      validar_proceso( CHANGING
                          c_es_distribucion = c_es_distribucion
                          c_es_ola          = c_es_ola
                          c_sub_screen      = c_sub_screen ).
    ENDIF.

    "Verificar la subscreen para consultar el parámetro
    IF c_sub_screen = c_scr_0200.
      me->obtener_param_conf_ubica( ).
    ENDIF.

    "+SLS 06.06.2023: Proyecto Materia prima
    CALL FUNCTION 'CONVERSION_EXIT_ZFETJ_OUTPUT'
      EXPORTING
        input  = c_es_ola-fecha_hora_inicio_tejido
      IMPORTING
        output = c_es_ola-fecha_hora_inicio_tejido.

  ENDMETHOD.


  METHOD actualizar_calculos.

    CONSTANTS: c_conos_despachar TYPE char30 VALUE 'GES_OLA-CONOS_DESPACHAR',
               c_peso_bascula    TYPE char30 VALUE 'GES_OLA-PESO_BASCULA',
               c_tipo_cono       TYPE char30 VALUE 'GES_OLA-TIPO_CONO',
               c_ajustar_um      TYPE char30 VALUE 'GES_OLA-AJUSTAR_UM'.

    IF c_es_ola-peso_bascula IS INITIAL.

      DATA(dynpro_values) = VALUE dynpread_t( ( fieldname = c_conos_despachar )
                                              ( fieldname = c_peso_bascula    )
                                              ( fieldname = c_tipo_cono       )
                                              ( fieldname = c_ajustar_um      ) ).

      obtener_valores_dynpro( IMPORTING e_dynpfields = dynpro_values ).

      TRY.
          c_es_ola-conos_despachar = dynpro_values[ fieldname = c_conos_despachar ]-fieldvalue.
          DATA(peso_con_coma)      = dynpro_values[ fieldname = c_peso_bascula ]-fieldvalue.
          REPLACE ALL OCCURRENCES OF '.' IN peso_con_coma WITH ''.
          REPLACE ALL OCCURRENCES OF ',' IN peso_con_coma WITH '.'.
          c_es_ola-peso_bascula    = CONV #( peso_con_coma ).
          c_es_ola-tipo_cono       = dynpro_values[ fieldname = c_tipo_cono ]-fieldvalue.
          c_es_ola-ajustar_um      = dynpro_values[ fieldname = c_ajustar_um ]-fieldvalue.
        CATCH cx_sy_itab_line_not_found.
        CATCH cx_sy_conversion_no_number.
      ENDTRY.

    ENDIF.

    c_es_ola-peso_conos = go_dao->obtener_peso_cono( i_ctara = c_es_ola-tipo_cono ).
    asignar_valores_out_put( CHANGING c_es_ola = c_es_ola c_es_distribucion = c_es_distribucion c_sub_screen = c_sub_screen ).

    IF c_es_ola-conos_despachar IS INITIAL OR c_es_ola-tipo_cono IS INITIAL OR c_es_ola-peso_bascula IS INITIAL OR c_es_ola-peso_neto IS INITIAL.
      go_log->set_es_log(  i_es = VALUE #( type = gc_mensaje_e id = gc_mensaje_id number = '039' ) ).
    ENDIF.


  ENDMETHOD.


  METHOD ajustar_ump_a_cero.

    DATA: tanum            TYPE /scwm/tanum,
          ti_ltap_vb       TYPE /scwm/tt_ltap_vb,
          ti_serid         TYPE /scwm/tt_to_serid,
          ti_bapiret2      TYPE bapirettab,
          severity         TYPE bapi_mtype,
          ti_create        TYPE /scwm/tt_to_create_int,
          ubicacion_origen TYPE /scwm/de_lgpla.

    DATA(cantidad) = obtener_cantidad_ump( EXPORTING
                                                i_lgnum = i_es_ola-lgnum
                                                i_ump   = i_es_ola-ump
                                           IMPORTING
                                                e_lgpla = ubicacion_origen ).

    ti_create      = VALUE #( ( reqqty        = cantidad
                                anfme         = cantidad
                                altme         = i_es_ola-altme
                                matid         = i_es_ola-matid
                                batchid       = i_es_ola-batchid
                                procty        = 'Y999'
                                vlenr         = i_es_ola-ump
                                vlpla         = ubicacion_origen
                                nlpla         = 'ZONA CERO'
                                owner         = i_es_ola-owner
                                owner_role    = i_es_ola-owner_role
                                entitled      = i_es_ola-entitled
                                entitled_role = i_es_ola-entitled_role
                                cat           = i_es_ola-cat ) ).

    CALL FUNCTION '/SCWM/TO_CREATE'
      EXPORTING
        iv_lgnum       = i_es_ola-lgnum
        iv_update_task = space
        it_create      = ti_create
        iv_commit_work = abap_true
      IMPORTING
        ev_tanum       = tanum
        et_ltap_vb     = ti_ltap_vb
        et_serid       = ti_serid
        et_bapiret     = ti_bapiret2
        ev_severity    = severity.

    COMMIT WORK AND WAIT.

    go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).

    IF tanum IS NOT INITIAL.

      CLEAR: ti_bapiret2.

      DATA(ti_configuracion) = VALUE /scwm/to_conf_tt( (  tanum      = tanum
                                                          papos      = 0
                                                          altme      = i_es_ola-altme
                                                          nista      = 0
                                                          ndifa      = cantidad
                                                          resta      = cantidad ) ).
      DATA(ti_config_exc)    = VALUE /scwm/tt_conf_exc( ( tanum      = tanum
                                                          papos      = 0
                                                          exccode    = 'DIFW'
                                                          buscon     = 'TIM'
                                                          exec_step  = '05' ) ).
      CALL FUNCTION '/SCWM/TO_CONFIRM'
        EXPORTING
          iv_lgnum       = i_es_ola-lgnum
          iv_qname       = sy-uname
          iv_update_task = space
          iv_commit_work = abap_true
          it_conf        = ti_configuracion
          it_conf_exc    = ti_config_exc
        IMPORTING
          et_ltap_vb     = ti_ltap_vb
          et_bapiret     = ti_bapiret2.

      go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).

    ENDIF.

  ENDMETHOD.


  METHOD anular_tareas_pendientes.

    DATA: ti_configuracion TYPE /scwm/to_conf_tt,
          ti_config_exc    TYPE /scwm/tt_conf_exc,
          ti_ltap_vb       TYPE /scwm/tt_ltap_vb,
          ti_bapiret2      TYPE bapirettab.

    DATA(ti_tareas) = go_dao->obtener_tareas_pendientes( i_lgnum  = i_lgnum
                                                         i_docid  = i_docid
                                                         i_itemid = i_itemid ).

    LOOP AT ti_tareas ASSIGNING FIELD-SYMBOL(<fs_es_tareas>).
      APPEND VALUE #( tanum      = <fs_es_tareas>-tanum
                      altme      = <fs_es_tareas>-altme
                      nista      = 0
                      ndifa      = <fs_es_tareas>-vsolm
                      resta      = <fs_es_tareas>-vsolm ) TO ti_configuracion .
      APPEND VALUE #( tanum      = <fs_es_tareas>-tanum
                      exccode    = 'ZDIU'
                      buscon     = 'TPI'
                      exec_step  = '26' ) TO ti_config_exc .
      go_log->set_es_log( i_es = VALUE #( id = 'ZEWM01' number = '103' type = 'W' message_v1 = <fs_es_tareas>-tanum message_v2 = <fs_es_tareas>-vlenr ) ).
    ENDLOOP.


    CALL FUNCTION '/SCWM/TO_CONFIRM'
      EXPORTING
        iv_lgnum       = i_lgnum
        iv_qname       = sy-uname
        iv_update_task = space
        iv_commit_work = abap_true
        it_conf        = ti_configuracion
        it_conf_exc    = ti_config_exc
      IMPORTING
        et_ltap_vb     = ti_ltap_vb
        et_bapiret     = ti_bapiret2.

    go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).
    IF go_log->get_errores( ) IS INITIAL.
      validar_cierre(
        EXPORTING
          i_es_distribucion = i_es_distribucion
        CHANGING
          c_es_ola          = c_es_ola ).
    ENDIF.

  ENDMETHOD.


  METHOD asignar_codigo_de_proceso.

    DATA: ti_posicion_entrega TYPE /scwm/tt_wip_whritem_out,
          posicion            TYPE ztewmi1006_1-rspos.

    SELECT SUM( ordim~nistm ) AS cantidad
    FROM /scwm/ordim_c AS ordim
    WHERE ordim~tapos  = 1
      AND ordim~procty = 'Y214'
      AND ordim~tostat = 'C'
      AND ordim~rdocid = @i_es_ola-docid
      AND ordim~ritmid = @i_es_ola-itemid
      INTO TABLE @DATA(ti_cantidad).

    DATA(cantidad) = VALUE #( ti_cantidad[ 1 ]-cantidad OPTIONAL ).

    i_es_ola-vbeln = |{ i_es_ola-vbeln ALPHA = IN }|.
    posicion       = |{ i_es_ola-posnr ALPHA = IN }|.

    SELECT SINGLE cantidad
    FROM ztewmi1006_1
    WHERE rsnum = @i_es_ola-vbeln
      AND rspos = @posicion
      AND tipo  = 'N'
    INTO @DATA(cantidad_minima).

    IF cantidad >= cantidad_minima.

      DATA(ti_tab_range) = VALUE rsds_trange(
                         ( tablename = '/SCWM/S_WIP_Q_WHR_OUTBOUND'
                           frange_t  = VALUE rsds_frange_t( ( fieldname = 'DOCNO_H'
                                                              selopt_t  = VALUE #( ( sign = 'I' option = 'EQ' low = CONV /scdl/dl_docno_int( |{ i_es_ola-docno ALPHA = IN }| ) ) )
                                                            )
                                                            ( fieldname = 'ITEMNO_I'
                                                              selopt_t  = VALUE #( ( sign = 'I' option = 'EQ' low = CONV /scdl/dl_itemno( |{ i_es_ola-itemno ALPHA = IN }| ) ) )
                                                            ) ) ) ).

      DATA(ti_cabecera_entrega) = VALUE /scwm/tt_wip_whrhead_out( ( docno_h = CONV /scdl/dl_docno_int( |{ i_es_ola-docno ALPHA = IN }| ) ) ).

      TRY.
          "Busca las posiciones de la entrega
          CALL FUNCTION '/SCWM/WHRITEM_MON_OUT'
            EXPORTING
              iv_lgnum       = i_es_ola-lgnum
              iv_mode        = '2'
              it_data_parent = ti_cabecera_entrega
            IMPORTING
              et_data        = ti_posicion_entrega
            CHANGING
              ct_tab_range   = ti_tab_range.

          CALL FUNCTION 'ZSCWM_WHRITEM_OUT_QUANT_ADJ_OD'
            EXPORTING
              iv_lgnum            = i_es_ola-lgnum
              it_data             = ti_posicion_entrega
              iv_no_od_creation   = abap_true
              iv_no_output_screen = abap_true.

          COMMIT WORK AND WAIT.

        CATCH /scwm/cx_mon_noexec ##NO_HANDLER.

      ENDTRY.

    ENDIF.


  ENDMETHOD.


  METHOD asignar_ubicacion.

    DATA: url TYPE c LENGTH 255.

    IF c_o_custom_contaner IS NOT BOUND.
      c_o_custom_contaner = NEW cl_gui_custom_container( container_name = i_nombre_custom_container ).
    ENDIF.

    IF NOT go_html IS INITIAL.
      go_html->free( ).
      FREE: go_html.
    ENDIF.

    go_html = NEW cl_gui_html_viewer( parent = c_o_custom_contaner ).

    IF c_es_ola-ubicacion IS INITIAL.
      c_es_ola-ubicacion = '002'.
    ENDIF.

    DATA(html_tab) = VALUE afx_tab_htmlline( ( |{ TEXT-001 }{ c_es_ola-ubicacion }{ TEXT-002 }| ) ).

    go_html->load_data( EXPORTING
                           type                   = 'text'
                           subtype                = 'html'
                        IMPORTING
                           assigned_url           = url
                        CHANGING
                           data_table             = html_tab
                        EXCEPTIONS
                           dp_invalid_parameter   = 1
                           dp_error_general       = 2
                           cntl_error             = 3
                           html_syntax_notcorrect = 4
                           OTHERS                 = 5 ).
    CHECK sy-subrc EQ 0.

    go_html->show_url( EXPORTING
                           url = url
                       EXCEPTIONS
                           cntl_error             = 1
                           cnht_error_not_allowed = 2
                           cnht_error_parameter   = 3
                           dp_error_general       = 4
                           OTHERS                 = 5 ).
    CHECK sy-subrc EQ 0.

  ENDMETHOD.


  METHOD asignar_ubicacion_a_ola.

    TYPES: BEGIN OF tp_es_entrega_cantidad,
             vbeln          TYPE likp-vbeln,
             cant_necesaria TYPE ztewmi1006_1-cant_necesaria,
           END OF tp_es_entrega_cantidad,
           tp_ti_entrega_cantidad TYPE STANDARD TABLE OF tp_es_entrega_cantidad WITH NON-UNIQUE KEY vbeln.

    IF gti__ubicacion_isla IS INITIAL.
      gti__ubicacion_isla = go_dao->obtener_ubicaciones_isla( i_isla           = i_isla
                                                              i_numero_almacen = i_numero_almacen
                                                              i_tipo_almacen   = g_tipo_almacen ).
    ENDIF.

    SORT gti__ubicacion_isla BY srt_nr ASCENDING.

    DATA(ti_entrega) = CORRESPONDING tp_ti_entrega_cantidad( gti_ola ).
    SORT ti_entrega BY vbeln ASCENDING.

    DELETE ADJACENT DUPLICATES FROM ti_entrega COMPARING vbeln.
    SELECT lips~vbeln, SUM( lips~lfimg ) AS cantidad
    FROM @ti_entrega AS entrega
    JOIN lips ON lips~vbeln = entrega~vbeln
    GROUP BY lips~vbeln
    INTO TABLE @DATA(ti_entregas).
    SORT ti_entregas BY cantidad DESCENDING.

    "+SLS 24.07.2023: Asignar ubicarion de forma secuencial
    go_dao->determinar_ubicacion_existente(  EXPORTING
                                  i_ola       = |{ i_ola ALPHA = IN }|
                                  i_r_isla    = VALUE #( sign = 'I' option = 'EQ' ( low = i_isla ) )
                                  i_numero_almacen = i_numero_almacen
                                  i_tipo_almacen   = g_tipo_almacen
                               CHANGING
                                  c_ti_ubicacion_isla =  gti__ubicacion_isla ).

    LOOP AT ti_entregas ASSIGNING FIELD-SYMBOL(<fs_entregas>).
      TRY.
          "+SLS 03082023: Si ya se tiene una entrega determinada para el proceso, y existen registros en ztewmr1015_1
          "descartar las entregas existentes
          IF i_asignar_ubicacion = abap_true AND i_entrega IS NOT INITIAL AND <fs_entregas>-vbeln NE i_entrega.
            CONTINUE.
          ENDIF.

          DATA(ubicacion) = gti__ubicacion_isla[ 1 ]-lgpla.

          go_dao->insertar_ubicacion_entrega( i_ola       = |{ i_ola ALPHA = IN }|
                                              i_isla      = i_isla
                                              i_entrega   = <fs_entregas>-vbeln
                                              i_ubicacion = CONV #( ubicacion ) ).

          DATA(es_ola) = VALUE gtp_es_ola( ubicacion = ubicacion ).

          MODIFY gti_ola FROM es_ola TRANSPORTING ubicacion WHERE vbeln = <fs_entregas>-vbeln.

          DELETE gti__ubicacion_isla INDEX 1.
        CATCH cx_sy_itab_line_not_found.

      ENDTRY.
    ENDLOOP.

  ENDMETHOD.


  METHOD asignar_valores_out_put.

    DATA: respuesta    TYPE string.

    c_es_ola-docno           = |{ c_es_ola-docno ALPHA = OUT }|.
    WRITE c_es_ola-itemno TO c_es_ola-itemno NO-ZERO.
    c_es_ola-vbeln           = |{ c_es_ola-vbeln ALPHA = OUT }|.
    c_es_ola-ump_destino_out = |{ c_es_ola-ump_creada ALPHA = OUT }|.
    c_es_ola-orden           = |{ c_es_ola-orden ALPHA = OUT }|.
    c_es_ola-maquina         = |{ c_es_ola-maquina ALPHA = OUT }|.
    c_es_ola-conos           = |{ c_es_ola-conos  ALPHA = OUT }|.
    MOVE c_es_ola-cant_tomar TO c_es_ola-mostrar_cant_tomar.
    MOVE c_es_ola-gramos_mercados TO c_es_ola-mostrar_gramos_mercados.
    c_es_ola-peso_neto       = c_es_ola-peso_bascula - ( c_es_ola-peso_conos * c_es_ola-conos_despachar ).
    c_es_ola-diferencia      = c_es_ola-peso_neto - c_es_ola-cant_tomar.

    IF c_es_ola-cant_necesaria <= 0.

      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          titlebar              = TEXT-032
          text_question         = TEXT-030
          text_button_1         = TEXT-031
          icon_button_1         = 'ICON_CHECKED'
          text_button_2         = TEXT-017
          icon_button_2         = 'ICON_CANCEL'
          popup_type            = 'ICON_MESSAGE_WARNING'
          display_cancel_button = space
        IMPORTING
          answer                = respuesta.

      IF respuesta = '1'."Anular
        anular_tareas_pendientes( EXPORTING
                                    i_lgnum           = c_es_ola-lgnum
                                    i_docid           = c_es_ola-docid
                                    i_itemid          = c_es_ola-itemid
                                    i_es_distribucion = c_es_distribucion
                                  CHANGING
                                    c_es_ola          = c_es_ola ).

        DATA(ola)  = c_es_distribucion-ola.
        DATA(isla) = c_es_distribucion-isla.
        limpiar_pantalla( CHANGING c_es_distribucion = c_es_distribucion c_es_ola = c_es_ola ).
        c_es_distribucion-ola             = ola.
        c_es_distribucion-ola_verificada  = abap_true.
        c_es_distribucion-isla            = isla.
        c_es_distribucion-isla_verificada = abap_true.
        g_num_ola                         = |{ ola ALPHA = IN }|.
        g_num_isla                        = isla.
        c_sub_screen                      = '0300'.
      ENDIF.

    ENDIF.

  ENDMETHOD.


  METHOD ayuda_busqueda_islas_picking.

    DATA: ti_return TYPE STANDARD TABLE OF ddshretval.

    DATA(ti_data) = zclewmr1015_dao=>islas_picking( i_lgnum = i_lgnum ).

    "Se hace uso de la función que convoca al matchcode y transforma nuestra tabla interna
    CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
      EXPORTING
        retfield        = 'WORKSTATION'
        window_title    = TEXT-018
        value_org       = 'S'
      TABLES
        value_tab       = ti_data
        return_tab      = ti_return
      EXCEPTIONS
        parameter_error = 1
        no_values_found = 2
        OTHERS          = 3.
    "Si todo es correcto
    IF sy-subrc EQ 0.
      "Leemos lo que obtenermos y se lo pasamos a nuestro campo del dynpro
      TRY .
          r_workstation = ti_return[ 1 ]-fieldval.
        CATCH cx_sy_itab_line_not_found.
      ENDTRY.
    ENDIF.

  ENDMETHOD.


  METHOD ayuda_de_busqueda_tipo_cono.

    DATA: ti_return TYPE STANDARD TABLE OF ddshretval.

    IF gti_tipo_conos IS INITIAL.
      gti_tipo_conos = zclewmr1015_dao=>tipos_conos(  ).
    ENDIF.

    "Se hace uso de la función que convoca al matchcode y transforma nuestra tabla interna
    CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
      EXPORTING
        retfield        = 'CTARA'
        window_title    = TEXT-012
        value_org       = 'S'
      TABLES
        value_tab       = gti_tipo_conos
        return_tab      = ti_return
      EXCEPTIONS
        parameter_error = 1
        no_values_found = 2
        OTHERS          = 3.
    "Si todo es correcto
    IF sy-subrc EQ 0.
      "Leemos lo que obtenermos y se lo pasamos a nuestro campo del dynpro
      TRY .
          r_ctara = ti_return[ 1 ]-fieldval.
        CATCH cx_sy_itab_line_not_found.
      ENDTRY.
    ENDIF.

  ENDMETHOD.


  METHOD cambiar_catalogo.

    DATA: r_campos TYPE RANGE OF lvc_s_fcat-fieldname.

    r_campos = VALUE #( sign   = 'I'
                        option = 'EQ'
                        ( low  = CONV #( 'MARCAR'         ) )
                        ( low  = CONV #( 'DOCNO'          ) )
                        ( low  = CONV #( 'ITEMNO'         ) )
                        ( low  = CONV #( 'VBELN'          ) )
                        ( low  = CONV #( 'ORDEN'          ) )
                        ( low  = CONV #( 'MAQUINA'        ) )
                        ( low  = CONV #( 'CANT_NECESARIA' ) )
                        ( low  = CONV #( 'CONOS'          ) )
                        ( low  = CONV #( 'CANT_TOMAR'     ) ) ).

    LOOP AT c_ti_catalog ASSIGNING FIELD-SYMBOL(<fs_es_catalog>).

      IF <fs_es_catalog>-fieldname NOT IN r_campos.
        <fs_es_catalog>-no_out = abap_true.
      ELSE.
        <fs_es_catalog>-just = 'C'.
        <fs_es_catalog>-col_opt = abap_true.
      ENDIF.

      CASE <fs_es_catalog>-fieldname.
        WHEN 'ORDEN'.
          <fs_es_catalog>-coltext  = TEXT-003.
        WHEN 'MAQUINA'.
          <fs_es_catalog>-coltext  = TEXT-004.
        WHEN 'CONOS'.
          <fs_es_catalog>-coltext  = TEXT-005.
        WHEN 'CANT_NECESARIA'.
          <fs_es_catalog>-coltext  = TEXT-006.
        WHEN 'CANT_TOMAR'.
          <fs_es_catalog>-coltext  = TEXT-007.
        WHEN 'MARCAR'.
          <fs_es_catalog>-coltext  = TEXT-019.
          <fs_es_catalog>-col_pos  = '0'.
          <fs_es_catalog>-checkbox = abap_true.
          <fs_es_catalog>-edit     = abap_true.
          <fs_es_catalog>-just     = 'C'.
      ENDCASE.

    ENDLOOP.

  ENDMETHOD.


  METHOD cambiar_catalogo_listar.

    DATA: r_campos TYPE RANGE OF lvc_s_fcat-fieldname.

    r_campos = VALUE #( sign   = 'I'
                        option = 'EQ'
                        ( low  = CONV #( 'TANUM'       ) )
                        ( low  = CONV #( 'ESTADO'      ) )
                        ( low  = CONV #( 'PROCESO'     ) )
                        ( low  = CONV #( 'UMP'         ) )
                        ( low  = CONV #( 'UBICACION'   ) )
                        ( low  = CONV #( 'MATNR'       ) )
                        ( low  = CONV #( 'VBELN'       ) )
                        ( low  = CONV #( 'DOCNO'       ) )
                        ( low  = CONV #( 'CANT_TOMAR'  ) )
                        ( low  = CONV #( 'MEDIDA'      ) )
                        ( low  = CONV #( 'ORDEN'       ) ) ).

    LOOP AT c_ti_catalog ASSIGNING FIELD-SYMBOL(<fs_es_catalog>).

      IF <fs_es_catalog>-fieldname NOT IN r_campos.
        <fs_es_catalog>-no_out = abap_true.
      ELSE.
        <fs_es_catalog>-just    = 'C'.
        <fs_es_catalog>-col_opt = abap_true.
      ENDIF.

      CASE <fs_es_catalog>-fieldname.
        WHEN 'ORDEN'.
          <fs_es_catalog>-col_pos = 0.
          <fs_es_catalog>-coltext = TEXT-003.
        WHEN 'DOCNO'.
          <fs_es_catalog>-col_pos = 1.
          <fs_es_catalog>-coltext = TEXT-010.
        WHEN 'VBELN'.
          <fs_es_catalog>-col_pos = 1.
          <fs_es_catalog>-coltext = TEXT-011.
        WHEN 'MEDIDA'.
          <fs_es_catalog>-coltext = TEXT-009.
        WHEN 'GRAMOS_UM'.
          <fs_es_catalog>-coltext = TEXT-008.
        WHEN 'CANT_TOMAR'.
          <fs_es_catalog>-coltext = TEXT-020.
      ENDCASE.

    ENDLOOP.

  ENDMETHOD.


  METHOD cerrar_ump.

    IF i_es_distribucion-guid_hu IS INITIAL.
      go_log->set_es_log( i_es = VALUE #( type = gc_mensaje_e id = '/SCWM/RFID' number = '038' ) ).
      RETURN.
    ENDIF.

    DATA(o_embalaje) = NEW /scwm/cl_wm_packing(  ).

    o_embalaje->init( iv_lgnum = i_es_distribucion-lgnum ).

    /scwm/cl_log=>get_instance( IMPORTING eo_instance = DATA(go_prot) ).

    CALL FUNCTION '/SCWM/TO_INIT_NEW'
      EXPORTING
        iv_lgnum = i_es_distribucion-lgnum
        io_prot  = go_prot.

    DATA(es_pack) = VALUE /scwm/s_pack_controle( chkpack_dstgrp = 1
                                                 processor_det  = abap_true ).

    o_embalaje->init_by_workstation( EXPORTING
                                        is_workstation   = go_dao->obtener_isla( i_lgnum = i_es_distribucion-lgnum i_isla = i_es_distribucion-isla )
                                        is_pack_controle = es_pack
                                        iv_trtyp         = '1'
                                     EXCEPTIONS
                                        error            = 1
                                        OTHERS           = 2  ).

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
               WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    o_embalaje->hu_process_completed( EXPORTING
                                          iv_hu  = i_es_distribucion-guid_hu
                                      EXCEPTIONS
                                          error  = 1
                                          OTHERS = 2 ).
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
               WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    o_embalaje->/scwm/if_pack_bas~save( EXPORTING
                                            iv_commit = space
                                            iv_wait   = space
                                        EXCEPTIONS
                                            error     = 1
                                            OTHERS    = 2 ).
    IF sy-subrc <> 0.
      ROLLBACK WORK.
      /scwm/cl_pack_view=>msg_error( iv_only_get = abap_true ).
      CALL FUNCTION 'POPUP_TO_INFORM'
        EXPORTING
          titel = ' '
          txt1  = TEXT-saf
          txt2  = ' '.
      RETURN.
    ELSE.
      /scwm/cl_pack=>gv_save = abap_true.
    ENDIF.

    COMMIT WORK AND WAIT.

    go_log->set_es_log( i_es = VALUE #( type = 'S' id = '/SCWM/RF_EN' number = '439' message_v1 = i_es_distribucion-ump ) ).

    o_embalaje->after_save( ).

  ENDMETHOD.


  METHOD confirmar.

    DATA: respuesta TYPE string,
          ump       TYPE /scwm/de_huident.

    actualizar_calculos( CHANGING c_es_ola = c_es_ola c_es_distribucion = c_es_distribucion c_sub_screen = c_sub_screen ).

    IF g_tolerancia_maxima < c_es_ola-peso_neto.
      RAISE EXCEPTION TYPE cx_t100_msg
        EXPORTING
          t100_msgid = gc_mensaje_id
          t100_msgno = '135'
          t100_msgv1 = |{ g_tolerancia_maxima }|.
    ENDIF.

    IF c_es_ola-conos_despachar IS INITIAL OR c_es_ola-tipo_cono IS INITIAL OR c_es_ola-peso_bascula IS INITIAL OR c_es_ola-peso_neto IS INITIAL.
      go_log->set_es_log(  i_es = VALUE #( type = gc_mensaje_w id = gc_mensaje_id number = '039' ) ).
    ELSEIF NOT line_exists( gti_tipo_conos[ ctara = c_es_ola-tipo_cono ] ).
      RAISE EXCEPTION TYPE cx_t100_msg
        EXPORTING
          t100_msgid = gc_mensaje_id
          t100_msgno = '090'
          t100_msgv1 = |{ c_es_ola-tipo_cono }|.
    ELSEIF c_es_ola-id_externo IS NOT INITIAL AND go_dao->id_externo_existente_activo( EXPORTING
                                                                                            i_ump        = |{ c_es_ola-ump_destino_out ALPHA = IN }|
                                                                                            i_id_externo = c_es_ola-id_externo
                                                                                       IMPORTING
                                                                                            e_ump        = ump ) IS NOT INITIAL.
      RAISE EXCEPTION TYPE cx_t100_msg
        EXPORTING
          t100_msgid = gc_mensaje_id
          t100_msgno = '095'
          t100_msgv1 = |{ c_es_ola-id_externo }|
          t100_msgv2 = |{ ump ALPHA = OUT }|.
    ELSE.

      DATA(total_cant_pendiente) = REDUCE i( INIT x = 0 FOR wa IN gti_data_mostrada NEXT x = x + wa-cant_tomar )."cant_necesaria ).

      IF total_cant_pendiente + c_es_ola-peso_neto > c_es_ola-gramos_um AND total_cant_pendiente IS NOT INITIAL.
        RAISE EXCEPTION TYPE cx_t100_msg
          EXPORTING
            t100_msgid = gc_mensaje_id
            t100_msgno = '093'.
      ENDIF.

      IF c_es_ola-gramos_um - c_es_ola-peso_neto > 0.

        IF c_es_ola-ajustar_um EQ abap_true OR
        ( go_dao->obtener_tareas_ump( i_lgnum = c_es_ola-lgnum i_ump = |{ c_es_ola-ump ALPHA = IN }| i_r_tanum = VALUE #( sign = 'E' option = 'EQ' ( low = c_es_ola-tanum ) ) i_tipo_almacen = g_tipo_almacen ) IS INITIAL
          AND c_es_ola-peso_neto < c_es_ola-cant_tomar AND c_es_ola-cant_necesaria < c_es_ola-cant_tomar AND gti_data_mostrada IS INITIAL ) OR
         c_es_ola-peso_neto > c_es_ola-cant_disponible OR ( g_tolerancia > ( c_es_ola-gramos_um - c_es_ola-peso_neto ) AND ( c_es_ola-gramos_um - c_es_ola-peso_neto ) > 0 ).
          DATA(diferencia_evaluar) = c_es_ola-gramos_um - c_es_ola-peso_neto.
          CALL FUNCTION 'POPUP_TO_CONFIRM'
            EXPORTING
              titlebar       = TEXT-021
              text_question  = |{ TEXT-022 } { c_es_ola-ump } { TEXT-023 } { TEXT-033 } { diferencia_evaluar }|
              text_button_1  = TEXT-024
              icon_button_1  = 'ICON_CHECKED'
              text_button_2  = TEXT-025
              icon_button_2  = 'ICON_CANCEL'
              default_button = '2'
              popup_type     = 'ICON_MESSAGE_WARNING'
            IMPORTING
              answer         = respuesta.

          IF respuesta = '1'."Ajustar UMp origen a 0
            DATA(es_tareas_abiertas) = go_dao->obtener_tareas_ump( i_lgnum = c_es_ola-lgnum i_ump = |{ c_es_ola-ump ALPHA = IN }| i_r_tanum = VALUE #( sign = 'E' option = 'EQ' ( low = c_es_ola-tanum ) ) i_tipo_almacen = g_tipo_almacen ).
            IF es_tareas_abiertas IS NOT INITIAL.
              RAISE EXCEPTION TYPE cx_t100_msg
                EXPORTING
                  t100_msgid = '/SCWM/MFS'
                  t100_msgno = '432'
                  t100_msgv1 = |{ c_es_ola-ump ALPHA = OUT } ({ es_tareas_abiertas-tanum })|.
            ENDIF.
          ELSEIF respuesta = 'A'.
            RAISE EXCEPTION TYPE cx_t100_msg
              EXPORTING
                t100_msgid = '3G'
                t100_msgno = '712'.
          ENDIF.
        ENDIF.
      ELSEIF c_es_ola-gramos_um <> c_es_ola-peso_neto AND c_es_ola-gramos_um <> c_es_ola-cant_tomar.
        respuesta = '1'.
        es_tareas_abiertas = go_dao->obtener_tareas_ump( i_lgnum = c_es_ola-lgnum i_ump = |{ c_es_ola-ump ALPHA = IN }| i_r_tanum = VALUE #( sign = 'E' option = 'EQ' ( low = c_es_ola-tanum ) ) i_tipo_almacen = g_tipo_almacen ).
        IF es_tareas_abiertas IS NOT INITIAL.
          RAISE EXCEPTION TYPE cx_t100_msg
            EXPORTING
              t100_msgid = '/SCWM/MFS'
              t100_msgno = '432'
              t100_msgv1 = |{ c_es_ola-ump ALPHA = OUT } ({ es_tareas_abiertas-tanum })|.
        ENDIF.
      ENDIF.

      IF c_es_ola-ump_creada IS INITIAL.
        c_es_ola-ump_creada = determinar_ump_destino( i_lgnum = c_es_ola-lgnum i_lgpla = c_es_ola-ubicacion i_dstgrp = c_es_ola-dstgrp ).
        IF c_es_ola-ump_creada IS INITIAL.
          DATA(ump_creada)       = crear_ump( i_lgnum = c_es_ola-lgnum i_lgpla = c_es_ola-ubicacion i_dstgrp = c_es_ola-dstgrp ).
          c_es_ola-ump_creada    = ump_creada-huident.
          c_es_ola-id_ump_creada = ump_creada-guid_hu.
          MODIFY gti_ola FROM c_es_ola TRANSPORTING ump_creada id_ump_creada WHERE ump    = c_es_ola-ump
                                                                               AND docno  = |{ c_es_ola-docno ALPHA = IN }|.
        ENDIF.
      ENDIF.

      c_es_ola-id_ump_creada   = COND #( WHEN c_es_ola-id_ump_creada IS NOT INITIAL THEN
                                              c_es_ola-id_ump_creada
                                         ELSE go_dao->obtener_ump( i_ump = c_es_ola-ump_creada )-guid_hu ).

      c_es_ola-confirmada      = abap_true.

      modificar_tarea( i_es_ola = c_es_ola ).
      LOOP AT gti_ola ASSIGNING FIELD-SYMBOL(<fs_es_ola>) WHERE ump        = c_es_ola-ump
                                                            AND confirmada = space
                                                            AND docno     NE |{ c_es_ola-docno ALPHA = IN }|
                                                            AND itemno    NE |{ c_es_ola-itemno ALPHA = IN }|.
        DATA(pendiente_entrega) = abap_true.
      ENDLOOP.
      DATA(cantidad_disponible) = ( c_es_ola-cant_disponible - c_es_ola-cant_tomar ) - total_cant_pendiente.

      IF c_es_ola-peso_neto > c_es_ola-cant_tomar AND pendiente_entrega = space AND ( c_es_ola-peso_neto - c_es_ola-cant_tomar ) > cantidad_disponible
      AND gti_data_mostrada IS INITIAL."c_es_ola-cant_disponible .
        confirmar_excepcion_zdia( i_es_ola = c_es_ola ).
      ELSEIF c_es_ola-peso_neto > c_es_ola-cant_tomar AND ( c_es_ola-peso_neto - c_es_ola-cant_tomar ) <= cantidad_disponible.
        confirmar_excepcion_zdiu( i_es_ola = c_es_ola ).
      ELSEIF c_es_ola-peso_neto < c_es_ola-cant_tomar AND c_es_ola-peso_neto > c_es_ola-cant_necesaria.
        confirmar_excepcion_zdiu( i_es_ola = c_es_ola ).
      ELSEIF c_es_ola-peso_neto < c_es_ola-cant_tomar AND c_es_ola-peso_neto < c_es_ola-cant_necesaria.
        confirmar_pick_parcial( i_es_ola = c_es_ola ).
      ELSEIF c_es_ola-peso_neto = c_es_ola-cant_tomar.
        confirmar_sin_diferencia( i_es_ola = c_es_ola ).
      ELSE.
        RAISE EXCEPTION TYPE cx_t100_msg
          EXPORTING
            t100_msgid = gc_mensaje_id
            t100_msgno = '134'.
      ENDIF.

      c_es_ola-cant_disponible = c_es_ola-cant_disponible - c_es_ola-cant_tomar.

      IF go_log->get_errores( ) IS INITIAL.

        DATA(sy_subrc) = go_dao->actualizar_conos_despachados( i_numero_almacen = c_es_ola-lgnum i_entrega = |{ c_es_ola-vbeln ALPHA = IN }| i_posicion = |{ c_es_ola-itemno ALPHA = IN }| i_cantidad_conos = CONV #( c_es_ola-conos_despachar ) ).

        IF sy_subrc <> 0.
          RAISE EXCEPTION TYPE cx_t100_msg
            EXPORTING
              t100_msgid = gc_mensaje_id
              t100_msgno = '040'
              t100_msgv1 = CONV #( go_dao->obtener_almacen_erp( i_numero_almacen = c_es_ola-lgnum ) )
              t100_msgv2 = CONV #( c_es_ola-vbeln ).
        ENDIF.

        IF respuesta = '1' AND ( c_es_ola-gramos_um - c_es_ola-peso_neto ) <> 0."Ajustar UMp origen a 0
          ajustar_ump_a_cero( i_es_ola = c_es_ola ).
        ENDIF.

        c_es_ola-confirmada = abap_true.

        IF c_es_ola-id_externo IS NOT INITIAL.
          CLEAR: respuesta.
          IF c_es_ola-original_id_externo IS NOT INITIAL AND c_es_ola-original_id_externo NE c_es_ola-id_externo.
            CALL FUNCTION 'POPUP_TO_CONFIRM'
              EXPORTING
                titlebar              = TEXT-026
                text_question         = TEXT-027
                text_button_1         = TEXT-028
                icon_button_1         = 'ICON_CHECKED'
                text_button_2         = TEXT-017
                icon_button_2         = 'ICON_CANCEL'
                display_cancel_button = ' '
                popup_type            = 'ICON_MESSAGE_WARNING'
              IMPORTING
                answer                = respuesta.
          ENDIF.
          IF c_es_ola-original_id_externo IS INITIAL OR respuesta = 1.
            sy_subrc = go_dao->guardar_id_externo( i_ump         = c_es_ola-ump_creada
                                                   i_entrega_erp = |{ c_es_ola-vbeln ALPHA = IN }|
                                                   i_id_externo  = c_es_ola-id_externo ).
          ENDIF.
        ENDIF.

      ENDIF.

      MODIFY gti_ola FROM c_es_ola TRANSPORTING ump_creada cant_disponible confirmada WHERE ump    = c_es_ola-ump
                                                                                        AND docno  = |{ c_es_ola-docno ALPHA = IN }|
                                                                                        AND itemno = |{ c_es_ola-itemno ALPHA = IN }|.

      validar_cierre(
        EXPORTING
          i_es_distribucion = i_es_distribucion
        CHANGING
          c_es_ola          = c_es_ola ).


    ENDIF.

  ENDMETHOD.


  METHOD confirmar_excepcion_zdia.

    DATA: ti_bapiret2 TYPE bapiret2_t,
          ti_ltap_vb  TYPE /scwm/tt_ltap_vb.

    DATA(ti_configuracion) = VALUE /scwm/to_conf_tt( ( tanum = i_es_ola-tanum
                                                       papos = 0
                                                       altme = i_es_ola-altme
                                                       nista = i_es_ola-peso_neto
                                                       ndifa = ( i_es_ola-cant_tomar - i_es_ola-peso_neto )
                                                       resta = i_es_ola-cant_tomar
                                                       ) ).
    DATA(ti_config_exc)    = VALUE /scwm/tt_conf_exc( ( tanum      = i_es_ola-tanum
                                                        papos      = 0
                                                        exccode    = 'ZDIA'
                                                        buscon     = 'TPI'
                                                        exec_step  = '26' ) ).
    CALL FUNCTION '/SCWM/TO_CONFIRM'
      EXPORTING
        iv_lgnum       = i_es_ola-lgnum
        iv_qname       = sy-uname
        iv_update_task = space
        iv_commit_work = abap_true
        it_conf        = ti_configuracion
        it_conf_exc    = ti_config_exc
      IMPORTING
        et_ltap_vb     = ti_ltap_vb
        et_bapiret     = ti_bapiret2.

    COMMIT WORK AND WAIT.

    go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).

  ENDMETHOD.


  METHOD confirmar_excepcion_zdiu.

    DATA: ti_bapiret2 TYPE bapiret2_t,
          ti_ltap_vb  TYPE /scwm/tt_ltap_vb.

    DATA(ti_configuracion) = VALUE /scwm/to_conf_tt( ( tanum = i_es_ola-tanum
                                                       papos = 0
                                                       altme = i_es_ola-altme
                                                       nista = i_es_ola-peso_neto
                                                       ndifa = ( i_es_ola-cant_tomar - i_es_ola-peso_neto )
                                                       resta = i_es_ola-cant_tomar ) ).
    DATA(ti_config_exc)    = VALUE /scwm/tt_conf_exc( ( tanum      = i_es_ola-tanum
                                                        papos      = 0
                                                        exccode    = 'ZDIU'
                                                        buscon     = 'TPI'
                                                        exec_step  = '26' ) ).
    CALL FUNCTION '/SCWM/TO_CONFIRM'
      EXPORTING
        iv_lgnum       = i_es_ola-lgnum
        iv_qname       = sy-uname
        iv_update_task = space
        iv_commit_work = abap_true
        it_conf        = ti_configuracion
        it_conf_exc    = ti_config_exc
      IMPORTING
        et_ltap_vb     = ti_ltap_vb
        et_bapiret     = ti_bapiret2.

    COMMIT WORK AND WAIT.

    go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).

  ENDMETHOD.


  METHOD confirmar_pick_parcial.

    DATA: ti_bapiret2 TYPE bapiret2_t,
          ti_ltap_vb  TYPE /scwm/tt_ltap_vb.

    DATA(ti_configuracion) = VALUE /scwm/to_conf_tt( ( tanum = i_es_ola-tanum
                                                       papos = 0
                                                       altme = i_es_ola-altme
                                                       nista = i_es_ola-peso_neto
                                                       ndifa = ( i_es_ola-cant_tomar - i_es_ola-peso_neto )
                                                       resta = i_es_ola-cant_tomar ) ).
    DATA(ti_config_exc)    = VALUE /scwm/tt_conf_exc( ( tanum      = i_es_ola-tanum
                                                        papos      = 0
                                                        exccode    = 'BIDP'
                                                        buscon     = 'TPI'
                                                        exec_step  = '26' ) ).
    CALL FUNCTION '/SCWM/TO_CONFIRM'
      EXPORTING
        iv_lgnum       = i_es_ola-lgnum
        iv_qname       = sy-uname
        iv_update_task = space
        iv_commit_work = abap_true
        it_conf        = ti_configuracion
        it_conf_exc    = ti_config_exc
      IMPORTING
        et_ltap_vb     = ti_ltap_vb
        et_bapiret     = ti_bapiret2.

    go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).

  ENDMETHOD.


  METHOD confirmar_sin_diferencia.

    DATA: ti_bapiret2 TYPE bapiret2_t,
          ti_ltap_vb  TYPE /scwm/tt_ltap_vb.

    DATA(ti_configuracion) = VALUE /scwm/to_conf_tt( ( tanum = i_es_ola-tanum
                                                       papos = 0
                                                       squit = abap_true
                                                       altme = i_es_ola-altme
                                                       resta = i_es_ola-peso_neto ) ).

    CALL FUNCTION '/SCWM/TO_CONFIRM'
      EXPORTING
        iv_lgnum       = i_es_ola-lgnum
        iv_qname       = sy-uname
        iv_update_task = space
        iv_commit_work = abap_true
        it_conf        = ti_configuracion
      IMPORTING
        et_ltap_vb     = ti_ltap_vb
        et_bapiret     = ti_bapiret2.

    COMMIT WORK AND WAIT.

    go_log->set_ti_log( i_ti = CORRESPONDING #( ti_bapiret2 ) ).

  ENDMETHOD.


  METHOD constructor.
    go_log = zclcxr1002_log_aplicacion=>get_instancia(  ).

    gti_tipo_conos = zclewmr1015_dao=>tipos_conos(  ).

  ENDMETHOD.


  METHOD crear_ump.

    DATA(o_embalaje) = NEW /scwm/cl_wm_packing( ).

    o_embalaje->init( iv_lgnum = i_lgnum ).

    CALL FUNCTION '/SCWM/TO_INIT_NEW'
      EXPORTING
        iv_lgnum = i_lgnum.

    "Datos de material de embalaje
    SELECT DISTINCT key~matnr, key~matid_x16
        FROM /sapapo/v_matidm AS key
        WHERE key~matnr EQ @g_material_empaque
        INTO TABLE @DATA(ti_material_embalaje).

    TRY.
        "Creación de la UMp
        o_embalaje->/scwm/if_pack_bas~create_hu(
          EXPORTING
            iv_pmat    = ti_material_embalaje[ matnr = g_material_empaque ]-matid_x16
            i_location = i_lgpla
          RECEIVING
            es_huhdr   = r_es_huhdr
          EXCEPTIONS
            error      = 1
            OTHERS     = 2 ).

        IF go_log->evaluar_valor_retorno( i_sysubrc = sy-subrc ) = abap_false.

          o_embalaje->/scwm/if_pack_bas~save(  EXCEPTIONS
                                                  error  = 1
                                                  OTHERS = 2 ).

          CHECK go_log->evaluar_valor_retorno( i_sysubrc = sy-subrc ) = abap_false.

          o_embalaje->init( iv_lgnum = i_lgnum ).

          CALL FUNCTION '/SCWM/TO_INIT_NEW'
            EXPORTING
              iv_lgnum = i_lgnum.
          r_es_huhdr-dstgrp = i_dstgrp.
          o_embalaje->/scwm/if_pack_bas~change_huhdr( EXPORTING
                                                          is_huhdr   = r_es_huhdr
                                                      EXCEPTIONS
                                                          error      = 1
                                                          not_locked = 2
                                                          OTHERS     = 3 ).
          o_embalaje->/scwm/if_pack_bas~save( EXPORTING
                                                iv_commit = abap_true
                                                iv_wait   = abap_true
                                              EXCEPTIONS
                                                error     = 1
                                                OTHERS    = 2 ).
*          COMMIT WORK AND WAIT.
        ENDIF.

*        DATA(es_hu_id) = obtener_consecutivo_entrega( i_es_hu = r_es_huhdr ).
*
*        TRY.
*            es_hu_id-spe_idart_01 = es_hu_id-spe_idart_01 + 1.
*          CATCH cx_root.
*            es_hu_id-spe_idart_01 = '1'.
*        ENDTRY.
*
*        o_embalaje->hu_ident_set( EXPORTING
*                                     iv_guid_hu = r_es_huhdr-guid_hu"gui ump a la que se le quiere setear
*                                     iv_huident = es_hu_id-spe_idart_01"valor del identificador
*                                     iv_idart   = 'Z'"clase de identificador
*                                  EXCEPTIONS
*                                     error      = 1
*                                     OTHERS     = 2 ).
*        IF sy-subrc <> 0.
*        ELSE.
*          o_embalaje->/scwm/if_pack_bas~save( EXPORTING
*                                                iv_commit = abap_true
*                                                iv_wait   = abap_true
*                                              EXCEPTIONS
*                                                error     = 1
*                                                OTHERS    = 2 ).
*        ENDIF.

      CATCH cx_sy_itab_line_not_found.
    ENDTRY.

  ENDMETHOD.


  METHOD determinacion_material.

    CLEAR: gti_data_mostrada.
    gti_data_mostrada = gti_ola.
    DELETE gti_data_mostrada WHERE ump NE i_es_ola-ump.
    DELETE gti_data_mostrada WHERE confirmada EQ abap_true.
    SORT gti_data_mostrada BY cant_necesaria ASCENDING.
    r_total_entregas_material = total_entregas( i_ti_ola = gti_data_mostrada ).
    DELETE gti_data_mostrada WHERE vbeln EQ i_es_ola-vbeln.
    "+SLS Eliminar registros repetidos
    DELETE ADJACENT DUPLICATES FROM gti_data_mostrada COMPARING docno itemno vbeln orden.

  ENDMETHOD.


  METHOD determinar_almacen.

    r_lgnum = zclewmr1015_dao=>almacen_del_usuario(  ).
    IF r_lgnum IS INITIAL.
      go_log->set_es_log(  i_es = VALUE #( type = gc_mensaje_e id = gc_mensaje_id number = '026' ) ).
    ENDIF.

  ENDMETHOD.


  METHOD determinar_ubicacion.

    DATA: isla_ubicacion    TYPE /scwm/de_workstation,
          ti_ubicaciones    TYPE go_dao->gtp_ti_ubicaciones,
          asignar_ubicacion TYPE flag.

    IF i_entrega IS SUPPLIED.
      r_ubicacion = go_dao->obtener_ubicacion_entrega( EXPORTING
                                                          i_ola            = i_ola
                                                          i_r_isla         = VALUE #( ( sign = 'I' option = 'EQ' low = i_isla ) )
                                                          i_r_entrega      = VALUE #( ( sign = 'I' option = 'EQ' low = i_entrega ) )
                                                          i_numero_almacen = i_numero_almacen
                                                          i_tipo_almacen   = g_tipo_almacen
                                                       IMPORTING
                                                          e_isla              = isla_ubicacion
                                                          e_ti_ubicaciones    = ti_ubicaciones
                                                          "+SLS 03082023: Determina si se debe grabar la entrega en la tabla ztewmr1015_1
                                                          "Para el escenario en donde ya para la OLA existian entregas con ubicaciones con registros en la tabla
                                                          "Pero desea terminar de procesar la OLA con otas UMP que no habian sido mercadas
                                                          e_asignar_ubicacion = asignar_ubicacion ).
    ELSE.
      r_ubicacion = go_dao->obtener_ubicacion_entrega( EXPORTING
                                                            i_ola            = i_ola
                                                            i_numero_almacen = i_numero_almacen
                                                            i_tipo_almacen   = g_tipo_almacen
                                                         IMPORTING
                                                            e_isla           = isla_ubicacion
                                                            e_ti_ubicaciones = ti_ubicaciones ).
    ENDIF.

    IF r_ubicacion IS INITIAL
    OR asignar_ubicacion = abap_true."+SLS 03082023
      asignar_ubicacion_a_ola( i_ola               = i_ola
                               i_isla              = i_isla
                               i_numero_almacen    = i_numero_almacen
                               "+SLS 03082023: Insertar registros de olas con registros en ztewmr1015_1
                               i_entrega           = i_entrega
                               i_asignar_ubicacion = asignar_ubicacion ).
    ELSEIF isla_ubicacion NE i_isla.

      MESSAGE i119(zewm01) WITH isla_ubicacion.
      e_proceso_cancelado = abap_true.

    ENDIF.

  ENDMETHOD.


  METHOD verificar_confirma_ubicacion.

    "Consultar la ubicación a verificar
    DATA(ubicacion_verif) = me->go_dao->obtener_ubicacion_verif(
                              i_numero_almacen = i_numero_almacen
                              i_ubicacion      = i_ubicacion ).

    "Verificar la ubicación ingresada con respecto a la actual
    IF ubicacion_verif <> i_ubicacion_verif.
      "Lanza la excepción
      RAISE EXCEPTION TYPE cx_t100_msg
        EXPORTING
          t100_msgid = gc_mensaje_id
          t100_msgno = '141'.
      "La ubicación leída no corresponde con la que se debe leer, verifique.
    ENDIF.

  ENDMETHOD.

  METHOD validar_tipo_tarea.

    IF c_es_ola-proceso = 'Y214' AND
       ( c_es_ola-vltyp NE g_tipo_almacen OR
         c_es_ola-cat   NE 'FD' ).
      RAISE EXCEPTION TYPE cx_t100_msg
        EXPORTING
          t100_msgid = gc_mensaje_id
          t100_msgno = '142'
          t100_msgv1 = CONV #( c_es_ola-vltyp )
          t100_msgv2 = CONV #( c_es_ola-cat )
          t100_msgv3 = CONV #( c_es_ola-tanum ).
    ENDIF.

  ENDMETHOD.

  METHOD imprimir_cajas.

    i_es_distribucion-entrega_erp = |{ i_es_distribucion-entrega_erp ALPHA = IN }|.

    SELECT SINGLE *
    FROM ztewme1029_1
    WHERE almacen = @i_es_distribucion-lgnum
    AND   ola = @i_es_distribucion-ola
    AND   entrega_erp = @i_es_distribucion-entrega_erp
    INTO @DATA(es_monitor_olas).

    IF sy-subrc IS INITIAL.

      ADD 1 TO es_monitor_olas-contador_impresion.

      UPDATE ztewme1029_1 SET contador_impresion = @es_monitor_olas-contador_impresion
      WHERE almacen = @i_es_distribucion-lgnum
      AND   ola = @i_es_distribucion-ola
      AND   entrega_erp = @i_es_distribucion-entrega_erp.

      IF i_no_imprimir = abap_false.
        COMMIT WORK AND WAIT.

        NEW zclewme1040_entrada_mensajes( )->accion_desde_accion_ppf( ip_action = 'Z_1508_03'
                                                                      i_lgnum   = i_es_distribucion-lgnum
                                                                      i_ump     = i_es_distribucion-ump ).
      ENDIF.
    ELSE.
      RAISE EXCEPTION TYPE cx_t100_msg
        EXPORTING
          t100_msgid = gc_mensaje_id
          t100_msgno = '144'
          t100_msgv1 = CONV #( i_es_distribucion-lgnum )
          t100_msgv2 = CONV #( i_es_distribucion-ola )
          t100_msgv3 = CONV #( i_es_distribucion-entrega_erp ).
    ENDIF.

  ENDMETHOD.

ENDCLASS.