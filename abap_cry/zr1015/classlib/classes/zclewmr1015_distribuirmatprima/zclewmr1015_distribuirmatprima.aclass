        medida                   TYPE meins,
        cant_tomar               TYPE /scwm/ltap_vsolm,
        mostrar_cant_tomar       TYPE zedr1015_decimales,
        conos                    TYPE ztewmi1006_1-conos,
        peso_conos               TYPE ztppi1024_1-ptara,
        tipo_cono                TYPE ztppi1024_1-ctara,
        conos_despachar          TYPE i,
        peso_bascula(13)         TYPE p DECIMALS 3,
        peso_neto(13)            TYPE p DECIMALS 3,
        gramos_mercados          TYPE /scwm/ltap_nista,
        mostrar_gramos_mercados  TYPE zedr1015_decimales,
        ump_creada               TYPE /scwm/ltap_vlenr,
        ump_destino_out          TYPE /scwm/ltap_vlenr,
        id_externo               TYPE ztewmr1015_3-identificador,
