FUNCTION z_cx_search_transports
  IMPORTING
    VALUE(iv_description) TYPE string OPTIONAL
    VALUE(iv_user) TYPE as4user OPTIONAL
    VALUE(iv_transport_type) TYPE trfunction OPTIONAL
    VALUE(iv_status) TYPE trstatus OPTIONAL
    VALUE(iv_target_system) TYPE tr_target OPTIONAL
    VALUE(iv_date_from) TYPE sydatum OPTIONAL
    VALUE(iv_date_to) TYPE sydatum OPTIONAL
    VALUE(iv_max_results) TYPE i DEFAULT 100
  EXPORTING
    VALUE(ev_success) TYPE char1
    VALUE(ev_message) TYPE string
    VALUE(ev_total_found) TYPE i
    VALUE(ev_results_json) TYPE string.



* Search transport requests with flexible criteria
* Tables: E070 (header), E07T (description), E071 (objects count)

  TYPES: BEGIN OF ty_transport,
           trkorr     TYPE trkorr,
           trfunction TYPE trfunction,
           trstatus   TYPE trstatus,
           as4user    TYPE as4user,
           as4date    TYPE as4date,
           as4time    TYPE as4time,
           tarsystem  TYPE tr_target,
           korrdev    TYPE e070-korrdev,
           strkorr    TYPE trkorr,
           as4text    TYPE as4text,
         END OF ty_transport.

  TYPES: BEGIN OF ty_result,
           trkorr       TYPE trkorr,
           trfunction   TYPE trfunction,
           trstatus     TYPE trstatus,
           as4user      TYPE as4user,
           as4date      TYPE as4date,
           as4time      TYPE as4time,
           tarsystem    TYPE tr_target,
           korrdev      TYPE e070-korrdev,
           strkorr      TYPE trkorr,
           as4text      TYPE as4text,
           object_count TYPE i,
           task_count   TYPE i,
         END OF ty_result.

  DATA: lt_transports   TYPE STANDARD TABLE OF ty_transport,
        lt_results      TYPE STANDARD TABLE OF ty_result,
        ls_transport    TYPE ty_transport,
        ls_result       TYPE ty_result,
        lv_json         TYPE string,
        lv_first        TYPE abap_bool VALUE abap_true,
        lv_max          TYPE i,
        lv_desc_pattern TYPE as4text,
        lv_where        TYPE string,
        lv_obj_count    TYPE i,
        lv_task_count   TYPE i.

  CLEAR: ev_success, ev_message, ev_total_found, ev_results_json.

  " Validate max results
  lv_max = COND #( WHEN iv_max_results < 1 THEN 100
                   WHEN iv_max_results > 1000 THEN 1000
                   ELSE iv_max_results ).

  " At least one filter required for performance
  IF iv_description IS INITIAL AND
     iv_user IS INITIAL AND
     iv_transport_type IS INITIAL AND
     iv_status IS INITIAL AND
     iv_target_system IS INITIAL AND
     iv_date_from IS INITIAL AND
     iv_date_to IS INITIAL.
    ev_success = ''.
    ev_message = 'At least one search criterion is required'.
    RETURN.
  ENDIF.

  " Build dynamic WHERE clause

  IF iv_description IS NOT INITIAL.
    lv_desc_pattern = iv_description.
    lv_where = lv_where && | AND E07T~AS4TEXT LIKE '{ lv_desc_pattern }'|.
  ENDIF.

  IF iv_user IS NOT INITIAL.
    lv_where = lv_where && | AND E070~AS4USER LIKE '{ iv_user }'|.
  ENDIF.

  IF iv_transport_type IS NOT INITIAL.
    lv_where = lv_where && | AND E070~TRFUNCTION = '{ iv_transport_type }'|.
  ENDIF.

  IF iv_status IS NOT INITIAL.
    lv_where = lv_where && | AND E070~TRSTATUS = '{ iv_status }'|.
  ENDIF.

  IF iv_target_system IS NOT INITIAL.
    lv_where = lv_where && | AND E070~TARSYSTEM = '{ iv_target_system }'|.
  ENDIF.

  IF iv_date_from IS NOT INITIAL.
    lv_where = lv_where && | AND E070~AS4DATE >= '{ iv_date_from }'|.
  ENDIF.

  IF iv_date_to IS NOT INITIAL.
    lv_where = lv_where && | AND E070~AS4DATE <= '{ iv_date_to }'|.
  ENDIF.

  REPLACE FIRST OCCURRENCE  OF 'AND' IN lv_where WITH space.


  " Query transports with description
  SELECT e070~trkorr,
         e070~trfunction,
         e070~trstatus,
         e070~as4user,
         e070~as4date,
         e070~as4time,
         e070~tarsystem,
         e070~korrdev,
         e070~strkorr,
         e07t~as4text
    FROM e070
    INNER JOIN e07t
      ON e07t~trkorr = e070~trkorr
     AND e07t~langu = @sy-langu
    WHERE (lv_where)
    ORDER BY e070~as4date DESCENDING, e070~as4time DESCENDING
    INTO CORRESPONDING FIELDS OF TABLE @lt_transports
    UP TO @lv_max ROWS.

  IF sy-subrc <> 0 OR lt_transports IS INITIAL.
    ev_success = 'X'.
    ev_message = 'No transports found matching criteria'.
    ev_total_found = 0.
    ev_results_json = '{"success":true,"totalFound":0,"transports":[]}'.
    RETURN.
  ENDIF.

  " Get counts for each transport
  LOOP AT lt_transports INTO ls_transport.
    CLEAR: lv_obj_count, lv_task_count.

    " Count objects
    SELECT COUNT( DISTINCT obj_name )
      FROM e071
      WHERE trkorr = @ls_transport-trkorr
      INTO @lv_obj_count.

    " Count tasks
    SELECT COUNT(*)
      FROM e070
      WHERE strkorr = @ls_transport-trkorr
        AND trfunction = 'S'
      INTO @lv_task_count.

    ls_result = CORRESPONDING #( ls_transport ).
    ls_result-object_count = lv_obj_count.
    ls_result-task_count = lv_task_count.
    APPEND ls_result TO lt_results.
  ENDLOOP.

  ev_total_found = lines( lt_results ).

  " Build JSON response
  lv_json = '{' &&
            '"success":true,' &&
            |"totalFound":{ ev_total_found },| &&
            '"transports":['.

  LOOP AT lt_results INTO ls_result.
    IF lv_first = abap_false.
      lv_json = lv_json && ','.
    ENDIF.

    " Map type description
    DATA(lv_type_desc) = COND string(
      WHEN ls_result-trfunction = 'K' THEN 'Workbench'
      WHEN ls_result-trfunction = 'T' THEN 'Transport of Copies'
      WHEN ls_result-trfunction = 'W' THEN 'Customizing Request'
      WHEN ls_result-trfunction = 'C' THEN 'Customizing'
      ELSE ls_result-trfunction ).

    " Map status description
    DATA(lv_status_desc) = COND string(
      WHEN ls_result-trstatus = 'D' THEN 'Modifiable'
      WHEN ls_result-trstatus = 'R' THEN 'Released'
      WHEN ls_result-trstatus = 'L' THEN 'Protected'
      WHEN ls_result-trstatus = 'N' THEN 'Modifiable (Protected)'
      WHEN ls_result-trstatus = 'O' THEN 'Released (With Import Protection)'
      ELSE ls_result-trstatus ).

    " Format date/time
    DATA(lv_date) = |{ ls_result-as4date+0(4) }-{ ls_result-as4date+4(2) }-{ ls_result-as4date+6(2) }|.
    DATA(lv_time) = |{ ls_result-as4time+0(2) }:{ ls_result-as4time+2(2) }:{ ls_result-as4time+4(2) }|.

    " Handle parent transport
    DATA(lv_parent) = COND string(
      WHEN ls_result-strkorr IS NOT INITIAL THEN |"{ ls_result-strkorr }"|
      ELSE 'null' ).

    " Escape description for JSON
    DATA(lv_escaped_desc) = escape( val = ls_result-as4text format = cl_abap_format=>e_json_string ).

    " Build JSON object
    lv_json = lv_json &&
              '{' &&
              |"transport_number":"{ ls_result-trkorr }",| &&
              |"description":"{ lv_escaped_desc }",| &&
              |"transport_type":"{ ls_result-trfunction }",| &&
              |"transport_type_desc":"{ lv_type_desc }",| &&
              |"status":"{ ls_result-trstatus }",| &&
              |"status_desc":"{ lv_status_desc }",| &&
              |"owner":"{ ls_result-as4user }",| &&
              |"created_date":"{ lv_date }",| &&
              |"created_time":"{ lv_time }",| &&
              |"target_system":"{ ls_result-tarsystem }",| &&
              |"category":"{ ls_result-korrdev }",| &&
              |"parent_transport":{ lv_parent },| &&
              |"object_count":{ ls_result-object_count },| &&
              |"task_count":{ ls_result-task_count }| &&
              '}'.

    lv_first = abap_false.
  ENDLOOP.

  lv_json = lv_json && ']}'.

  ev_success = 'X'.
  ev_results_json = lv_json.

ENDFUNCTION.