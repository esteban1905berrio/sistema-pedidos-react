    APPEND  'DSF' TO lt_scope. "Structure Fields
    APPEND 'DVF' TO lt_scope. " View Fields
    APPEND 'DA' TO lt_scope.
    APPEND 'DH' TO lt_scope.
    APPEND 'O' TO lt_scope. "Classes/Interfaces




