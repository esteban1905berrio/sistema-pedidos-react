CLASS zclcxr1090_mensaje_impresion DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    TYPES:
      tt_r_vstat  TYPE RANGE OF nast-vstat,
      gtp_r_kappl TYPE RANGE OF sna_kappl.

    CONSTANTS kvewe_nast TYPE t681z-kvewe VALUE 'B' ##NO_TEXT.
    CONSTANTS:
      on(1)      TYPE c VALUE 'X' ##NO_TEXT.

    "! Impresion de mensajes de etiquetas
    "! @parameter i_objky | Clave del objeto
    "! @parameter i_kappl | Aplicación
    "! @parameter i_r_mensajes | Rango de clases de mensaje a excluir
    METHODS impresion
      IMPORTING
        !i_objky       TYPE nast-objky
        !i_kappl       TYPE sna_kappl OPTIONAL
        i_r_kappl      TYPE gtp_r_kappl OPTIONAL
        !i_r_mensajes  TYPE cond_type_range_erp_t OPTIONAL
        !i_r_vstat     TYPE tt_r_vstat OPTIONAL
        !i_manual      TYPE xfeld OPTIONAL
      EXPORTING
        VALUE(e_subrc) TYPE sy-subrc .
    METHODS impresion_hu_ewm
      IMPORTING
        !i_lgnum       TYPE /scwm/hu_ppf-lgnum
        !i_huident     TYPE /scwm/hu_ppf-huident
      EXPORTING
        VALUE(e_subrc) TYPE sy-subrc .
  PROTECTED SECTION.


  PRIVATE SECTION.


    DATA: ges_nast  TYPE nast,  "NAST
          ges_nase  TYPE nase,  "NASE
          ges_t681b TYPE t681b. "T681B

    DATA: ges_alarc_par1 TYPE alarc_par1, "ALARC_PAR1
          ges_arc_params TYPE arc_params, "ARC_PARAMS
          ges_toa_dara   TYPE toa_dara,   "TOA_DARA
          ges_nast00     TYPE nast00.     "NAST00

    DATA: ges_tnapr  TYPE tnapr,  "TNAPR
          ges_tnapr_ TYPE tnapr,  "*TNAPR
          ges_t681z  TYPE t681z,  "T681Z
          ges_t685b  TYPE t685b.  "T685B

    DATA: returncode TYPE sy-subrc,   "Returncode aus Druckprogramm
          retcode    TYPE sy-subrc,   "Returncode
          count      TYPE sy-index,   "Counter: verarbeitete Belege
          count_1    TYPE sy-index,   "Counter: erfolgreich verarbeitet
          count_2    TYPE sy-index,   "Counter: fehlerhaft verarbeitet
          xscreen(1) TYPE c.

    DATA: BEGIN OF partner,
            rolle  TYPE nast-parvw,
            nummer TYPE nast-parnr,
          END OF partner.

    DATA: p_vstat TYPE nast-vstat.


    METHODS:
      check_kappls_not_to_process CHANGING VALUE(p_kappl) TYPE nast-kappl
                                           VALUE(p_subrc) TYPE sy-subrc,


      tnapr_lesen  IMPORTING VALUE(p_kschl) TYPE nast-kschl
                             VALUE(p_nacha) TYPE nast-nacha
                             VALUE(p_kappl) TYPE nast-kappl,

      t685b_lesen IMPORTING VALUE(us_kappl) TYPE t685b-kappl
                            VALUE(us_kschl) TYPE t685b-kschl,


      optische_archivierung,

      programm_aufrufen IMPORTING us_screen TYPE c,

      set_counters IMPORTING l_subrc TYPE sy-subrc,

      objekt_entsperren.


ENDCLASS.



CLASS zclcxr1090_mensaje_impresion IMPLEMENTATION.


  METHOD impresion.

    DATA: l_r_kappl  TYPE RANGE OF sna_kappl,
          l_es_kappl LIKE LINE OF l_r_kappl,
          l_ti_nast  TYPE STANDARD TABLE OF nast,
          l_r_nacha  TYPE RANGE OF nast-nacha,
          l_es_nacha LIKE LINE OF l_r_nacha.

    CLEAR: l_r_kappl, l_r_nacha.

    IF i_kappl IS NOT INITIAL.
      l_es_kappl-sign   = 'I'.
      l_es_kappl-option = 'EQ'.
      l_es_kappl-low    = i_kappl.
      APPEND l_es_kappl TO l_r_kappl.
    ENDIF.

    "' Inicio SGR 07.04.2025 | Permitir mas de un objeto
    IF i_r_kappl IS NOT INITIAL.
      APPEND LINES OF i_r_kappl TO l_r_kappl.
    ENDIF.
    "' Fin SGR 07.04.2025

    l_es_nacha-sign   = 'I'.
    l_es_nacha-option = 'EQ'.
    l_es_nacha-low    = '1'.
    APPEND l_es_nacha TO l_r_nacha.

    l_es_nacha-sign   = 'I'.
    l_es_nacha-option = 'EQ'.
    l_es_nacha-low    = '2'.
    APPEND l_es_nacha TO l_r_nacha.

    l_es_nacha-sign   = 'I'.
    l_es_nacha-option = 'EQ'.
    l_es_nacha-low    = '5'.
    APPEND l_es_nacha TO l_r_nacha.

    l_es_nacha-sign   = 'I'.
    l_es_nacha-option = 'EQ'.
    l_es_nacha-low    = '7'.
    APPEND l_es_nacha TO l_r_nacha.

    IF i_manual IS INITIAL.
      SELECT *
        INTO TABLE l_ti_nast
        FROM nast
        WHERE objky EQ i_objky
          AND kappl IN l_r_kappl
          AND manue NE 'X'.
    ELSE.
      SELECT *
        INTO TABLE l_ti_nast
        FROM nast
        WHERE objky EQ i_objky
          AND kappl IN l_r_kappl.
      "AND manue NE 'X'.
    ENDIF.
    "Excluir las clases de  mensajes paramatrizados si es del caso
    IF i_r_mensajes[] IS NOT INITIAL.
      DELETE l_ti_nast WHERE kschl NOT IN i_r_mensajes.
    ENDIF.

    "Excluir los estados de los mensajes paramatrizados si es del caso
    IF i_r_vstat[] IS NOT INITIAL.
      DELETE l_ti_nast WHERE vstat NOT IN i_r_vstat.
    ENDIF.

    IF l_ti_nast IS INITIAL.
      e_subrc = 4.
    ELSE.


      LOOP AT l_ti_nast INTO ges_nast.

        CALL FUNCTION 'WFMC_MESSAGE_SINGLE'
          EXPORTING
            pi_nast  = ges_nast
          IMPORTING
            pe_rcode = e_subrc.

*      check_kappls_not_to_process( CHANGING p_kappl = ges_nast-kappl
*                                            p_subrc = returncode ).
*
**...Validación de mensajes
*      IF ges_nast-nacha NOT IN l_r_nacha OR ges_nast-aktiv NE space.
*        CONTINUE.
*      ENDIF.
*
*
*
*      tnapr_lesen( EXPORTING p_kschl = ges_nast-kschl
*                             p_nacha = ges_nast-nacha
*                             p_kappl = ges_nast-kappl ).
*      CLEAR xscreen.
*
*      optische_archivierung(  ).
*      programm_aufrufen( xscreen ).
*      set_counters( returncode ).
*      IF sy-batch NE space.
*        partner-rolle = ges_nast-parvw.
*        partner-nummer = ges_nast-parnr.
*        MESSAGE i034(vn) WITH ges_nast-objky ges_nast-kschl partner returncode.
*      ENDIF.
*      IF ges_nast-kappl EQ 'WT'.
*        COMMIT WORK AND WAIT.
*      ELSE.
*        COMMIT WORK .
*      ENDIF.
*      objekt_entsperren(  ).
*      IF sy-batch = space.
*        CALL FUNCTION 'WFMC_PROTOCOL_LOAD'
*          EXPORTING
*            cps_nast = ges_nast.
*      ENDIF.
*      IF sy-batch = space.
*        CALL FUNCTION 'WFMC_PROTOCOL_SHOW'
*          EXPORTING
*            cps_kalsm = space
*            cps_nast  = ges_nast
*            no_header = 'X'.
*      ENDIF.
*
      ENDLOOP.

    ENDIF.

  ENDMETHOD.


  METHOD check_kappls_not_to_process.

    CASE p_kappl.
      WHEN 'WA'.
* NAST records for application WA must not be processed
        p_subrc = 4.
      WHEN OTHERS.
* any other application may be processed
        p_subrc = 0.
    ENDCASE.


  ENDMETHOD.


  METHOD tnapr_lesen.

    CHECK ges_tnapr-kschl NE p_kschl
      OR  ges_tnapr-nacha NE p_nacha
      OR  ges_tnapr-kappl NE p_kappl.
    SELECT SINGLE * FROM tnapr INTO ges_tnapr
      WHERE kschl = p_kschl
        AND   nacha = p_nacha
        AND   kappl = p_kappl.
    IF sy-subrc NE 0.
      MESSAGE a020(vn) WITH p_kschl p_nacha p_kappl.
    ENDIF.

  ENDMETHOD.


  METHOD t685b_lesen.

    CHECK ges_t685b-kappl NE us_kappl
       OR ges_t685b-kschl NE us_kschl.
    SELECT SINGLE * FROM t685b INTO ges_t685b
      WHERE kappl = us_kappl
        AND   kschl = us_kschl.
    IF sy-subrc NE 0.
      MESSAGE a047(vn) WITH us_kappl us_kschl.
    ENDIF.

  ENDMETHOD.


  METHOD optische_archivierung.


    DATA: BEGIN OF xobjid,
            objky TYPE nast-objky,
            arcnr TYPE nast-optarcnr,
          END OF xobjid.
    DATA: xoj_name TYPE toa_dara-sap_object.
    DATA: xobjky   TYPE nast-objky.

    CHECK ges_nast-tdarmod = '2'
      OR  ges_nast-tdarmod = '3'.
* Ermitteln der Objektart
    xobjky = ges_nast-objky.
    CALL FUNCTION 'WFMC_GET_ARCHIVE_OBJECT_TYPE'
      EXPORTING
        pi_kappl       = ges_nast-kappl
        pi_objtype     = ges_nast-objtype
      IMPORTING
        pe_object_type = xoj_name
      CHANGING
        pc_objky       = xobjky.
    IF xoj_name = space.
      MESSAGE a049(vn) WITH ges_nast-kappl.
    ENDIF.
* Ermitteln der Dokumentenart
    t685b_lesen( EXPORTING us_kappl = ges_nast-kappl
                           us_kschl = ges_nast-kschl ).
* Ermitteln der Archivnummer
    CALL FUNCTION 'NUMBER_GET_NEXT'
      EXPORTING
        nr_range_nr = '01'
        object      = 'NA_OPT_ARC'
      IMPORTING
        number      = ges_nast-optarcnr.
* Aufbau OBJECT_ID
    xobjid-objky = xobjky.
    xobjid-arcnr = ges_nast-optarcnr.
* Versorgen TOA_DARA
    ges_toa_dara-mandant    = ges_nast-mandt.
    ges_toa_dara-sap_object = xoj_name.
    ges_toa_dara-ar_object  = ges_t685b-arcobjart.
    ges_toa_dara-object_id  = xobjid.
* Versorgen ARC_PARAMS
    ges_arc_params-sap_object = xoj_name.
    ges_arc_params-ar_object  = ges_t685b-arcobjart.
    ges_arc_params-mandant    = ges_nast-mandt.
* gleiches Userhandling wie in den Spoolparametern
    IF ges_nast-tdreceiver NE space.
      ges_arc_params-arcuser    = ges_nast-tdreceiver.
    ELSE.
      ges_arc_params-arcuser    = ges_nast-usnam.
    ENDIF.
    ges_arc_params-printer    = ges_nast-ldest.
    ges_alarc_par1-sap_object = xoj_name.
    ges_alarc_par1-ar_object  = ges_t685b-arcobjart.
    ges_alarc_par1-mandant    = ges_nast-mandt.
    ges_alarc_par1-arcuser    = ges_nast-usnam.
    ges_alarc_par1-printer    = ges_nast-ldest.

  ENDMETHOD.


  METHOD programm_aufrufen.

    DATA: ronam     TYPE tnapr-ronam,
          fonam     TYPE tnapr-fonam,
          pgnam     TYPE tnapr-pgnam,
          temp_nast TYPE nast.

* shall those NAST records be processed at all?
    DATA us_subrc TYPE sy-subrc.

    check_kappls_not_to_process( CHANGING p_kappl = ges_nast-kappl
                                          p_subrc = us_subrc ).

    CHECK us_subrc EQ 0.


* don't process locked entries (but don't perform this check
* in preview mode)
    IF us_screen NE on.
      returncode = 3.
      CHECK ges_nast-snddr EQ space.
    ENDIF.

    IF ges_nast-nacha = '1' AND
         ges_nast-tdreceiver IS INITIAL.
      ges_nast-tdreceiver = ges_nast-usnam.
    ENDIF.
    CALL FUNCTION 'NAST_PROTOCOL_INITIALIZE'.
    ges_tnapr_ = ges_tnapr.
* try to perform all routines in TNAPR (RONAM - RONAM5)
    DO 5 TIMES VARYING ronam FROM ges_tnapr_-ronam NEXT ges_tnapr_-ronam2
               VARYING fonam FROM ges_tnapr_-fonam NEXT ges_tnapr_-fonam2
               VARYING pgnam FROM ges_tnapr_-pgnam NEXT ges_tnapr_-pgnam2.
      CHECK pgnam NE space.
      ges_tnapr-ronam = ronam.
      ges_tnapr-fonam = fonam.
      ges_tnapr-pgnam = pgnam.
      IF ges_tnapr-ronam NE space OR ges_tnapr-pgnam NE space.
* initial protocol entry for this processing program call
* note: if no further protocol entries exist, this entry alone
*       will not be saved by NAST_PROTOCOL_STORE
        sy-msgid = 'VN'.
        sy-msgno = '056'.
        sy-msgty = 'I'.
        sy-msgv1 = ges_tnapr-pgnam.
        CONDENSE sy-msgv1 NO-GAPS.
        sy-msgv2 = ges_tnapr-ronam.
        CONDENSE sy-msgv2 NO-GAPS.
        CALL FUNCTION 'NAST_PROTOCOL_UPDATE'
          EXPORTING
            msg_arbgb = sy-msgid
            msg_nr    = sy-msgno
            msg_ty    = sy-msgty
            msg_v1    = sy-msgv1
            msg_v2    = sy-msgv2
          EXCEPTIONS
            OTHERS    = 0.

      ENDIF.
* set function module if not yet available
* (extra module to have an alternative print engine)
* for printing only:
      IF ges_nast-nacha EQ '1'.
* set function module if not yet available
* (extra module to have an alternative print engine)
        IF ges_nast-pfld5 NE space.
          ges_tnapr-funcname = ges_nast-pfld5.
        ENDIF.
      ENDIF.
* for printing and faxing:
      IF ges_nast-nacha EQ '1' OR ges_nast-nacha EQ '2'.
* set SAPscript form if specified in NAST record
        IF ges_nast-pfld4 NE space.
          ges_tnapr-fonam = ges_nast-pfld4.
        ENDIF.
      ENDIF.

* override smart form name, if applicable
      IF ges_nast-pfld3 NE space.
        ges_tnapr-sform = ges_nast-pfld3.
      ENDIF.

      returncode = 999.
* save original NAST record
      temp_nast = ges_nast.
* even repeated processing should get VSTAT = 0 in order to
* have a consistent behaviour throughout all processing techniques
*   nast-vstat = '0'.
      IF ges_nast-kappl EQ 'V1' AND
         us_screen NE on.
* set initialization-flag for sales messages
        CALL FUNCTION 'RV_PRICE_PRINT_GET_BUFFER'
          EXPORTING
            i_print_from_buffer = 'A'.
      ENDIF.
      PERFORM (ges_tnapr-ronam) IN PROGRAM (ges_tnapr-pgnam) USING returncode
                                                                   us_screen
                                                             IF FOUND.
* restore original NAST record (in case TNAPR-RONAM changed something)
      ges_nast = temp_nast.
* return code unchanged: program didn't behave properly
      IF returncode = 999.
        syst-msgid = 'VN'.
        syst-msgno = 068.
        syst-msgty = 'E'.
        syst-msgv1 = ges_tnapr-ronam.
        syst-msgv2 = ges_tnapr-pgnam.
        CALL FUNCTION 'NAST_PROTOCOL_UPDATE'
          EXPORTING
            msg_arbgb = syst-msgid
            msg_nr    = syst-msgno
            msg_ty    = syst-msgty
            msg_v1    = syst-msgv1
            msg_v2    = syst-msgv2
          EXCEPTIONS
            OTHERS    = 0.

      ENDIF.
      IF returncode NE 0.
        EXIT.
      ENDIF.

    ENDDO.
    ges_tnapr = ges_tnapr_.

  ENDMETHOD.


  METHOD set_counters.

    CASE l_subrc.
      WHEN '0'.                          "successfully processed
        ADD 1 TO count_1.
      WHEN '1'.                          "processing failure
        ADD 1 TO count_2.
*   WHEN '2'.                          "translated (EDI)
*     ADD 1 TO count_1.
      WHEN '3'.                          "application document incomplete
      WHEN OTHERS.                       "processing failure
        ADD 1 TO count_2.
    ENDCASE.

  ENDMETHOD.


  METHOD objekt_entsperren.
    DATA: belnr TYPE vbak-vbeln.
    DATA: ebeln TYPE ekko-ebeln.
    DATA: tknum TYPE vttk-tknum.
    DATA: pabnum TYPE pabit-pabnum.
    DATA: l_knuma TYPE knuma.
    DATA: l_wbeln TYPE wbeln_ag.
    DATA: l_tkonn TYPE tkonn.
    DATA: l_wale TYPE wale.

    CASE ges_nast-kappl.
      WHEN 'V1'.                         "Auftrag
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBAKE'
          EXPORTING
            vbeln = belnr.
      WHEN 'V2' OR 'E1'.                 "Lieferung
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBLKE'
          EXPORTING
            vbeln = belnr.
      WHEN 'V3'.                         "Faktura
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBRKE'
          EXPORTING
            vbeln = belnr.
      WHEN 'V4'.                         "Kommissionierung
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBLKE'
          EXPORTING
            vbeln = belnr.
      WHEN 'V6'.                         "Versandelemente
      WHEN 'V7'.                         "Transporte
        tknum = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVTTKE'
          EXPORTING
            mandt = sy-mandt
            tknum = tknum.
      WHEN 'VL'.                         "Besuchsliste
        DATA: lv_vlid(10) TYPE c.
        lv_vlid = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_/DSD/E_VC_VLH'
          EXPORTING
            vlid = lv_vlid.
      WHEN 'K1'.                         "Kontakte
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBKAE'
          EXPORTING
            vbeln = belnr.
      WHEN 'EF' OR 'EA' OR 'EV' OR 'ES' OR 'EL'.  "Einkauf
        ebeln = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EMEKKOE'
          EXPORTING
            ebeln  = ebeln
          EXCEPTIONS
            OTHERS = 0.
      WHEN 'NF'.                         "Nota Fiscal (Brasilien)
        DATA: nfnum_int TYPE j_1bnfdoc-docnum.
        nfnum_int = ges_nast-objky.
        CALL FUNCTION 'J_1B_NF_DOCUMENT_UNLOCK'
          EXPORTING
            doc_number = nfnum_int
            lock_mode  = 'E'
          EXCEPTIONS
            OTHERS     = 0.
      WHEN 'PA'.                         "Produktionsabruf
        pabnum = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_E_PABIT_E'
          EXPORTING
            pabnum   = pabnum
            x_pabpos = on
          EXCEPTIONS
            OTHERS   = 0.
      WHEN 'WN'.
        l_knuma = ges_nast-objky+10(10).
        CALL FUNCTION 'DEQUEUE_EVKONAE'
          EXPORTING
            knuma = l_knuma.
      WHEN 'WR'.
        l_wbeln = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EMWBRKE'
          EXPORTING
            wbeln = l_wbeln.
      WHEN 'WS'.
        l_knuma = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVKONAE'
          EXPORTING
            knuma = l_knuma.
      WHEN 'WT'.
        l_tkonn = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVWBHKE'
          EXPORTING
            tkonn = l_tkonn.
      WHEN 'W1'.
        CLEAR l_wale.
        l_wale-aktnr = ges_nast-objky(10).
        l_wale-kunnr = ges_nast-sort2+5(10).
        CALL FUNCTION 'DEQUEUE_EWWALE'
          EXPORTING
            aktnr = l_wale-aktnr
            artnr = l_wale-artnr
            mebme = l_wale-mebme
            kunnr = l_wale-kunnr
            clint = l_wale-clint.

    ENDCASE.

  ENDMETHOD.


  METHOD impresion_hu_ewm.


    DATA: lo_manager             TYPE REF TO cl_manager_ppf,
          li_transaction_manager TYPE REF TO if_os_transaction_manager,
          li_persistency_agent   TYPE REF TO if_os_ca_persistency,
          lo_new_trigger         TYPE REF TO cl_trigger_ppf,
          lo_trigger             TYPE REF TO cl_trigger_ppf,
          l_execanddel           TYPE char1,
          l_executed             TYPE char1,
          l_counter_locked       TYPE i,
          l_error                TYPE char1,
          l_execute_mode         TYPE sppfdxmode,
          lo_agent               TYPE REF TO ca_trigger_ppf. "1770445

    DATA lo_appl   TYPE REF TO object.
    DATA: l_guid           TYPE os_guid,
          l_stat           TYPE ppfdtstat,
          l_check_opt_rule TYPE char1.


    SELECT SINGLE FROM /scwm/hu_ppf
      FIELDS *
      WHERE lgnum EQ @i_lgnum
        AND huident EQ @i_huident
      INTO @DATA(ls_hu_ppf).
    IF sy-subrc IS INITIAL.

      SELECT SINGLE FROM ppfttrigg
        FIELDS *
        WHERE appl_oid EQ @ls_hu_ppf-guid
          AND status IN ( '0', '1' )
        INTO @DATA(ls_ppf).
      IF sy-subrc IS INITIAL.
* activate object pool
        CALL FUNCTION 'GUID_CREATE'
          IMPORTING
            ev_guid_16 = l_guid.

        cl_object_pool=>set_guid( l_guid ).



* ask central system instance for transaction manager
        li_transaction_manager = cl_os_system=>get_transaction_manager( ).

*li_service_agent ?= cl_os_system=>get_class_agent( sppf_cls_trigger ).
        li_persistency_agent ?=
          cl_os_system=>get_class_agent( sppf_cls_trigger ).

* get PPF manager and set execution mode
        lo_manager = cl_manager_ppf=>get_instance( ).
        l_execute_mode = lo_manager->execution_mode.        "note 1124587
        lo_manager->execution_mode = sppf_execute_report.


        TRY.
*note 1770445:  refresh buffers, as in the meantime actions can be deleted in a different session
*           but still be found in buffers of persistence class
            lo_agent ?= ca_trigger_ppf=>agent.
            lo_trigger ?= li_persistency_agent->get_persistent_by_oid( ls_ppf-os_guid ).
            lo_agent->if_os_factory~refresh_persistent( lo_trigger ).
            lo_trigger ?= li_persistency_agent->get_persistent_by_oid( ls_ppf-os_guid ).
          CATCH cx_os_object_not_found.
            e_subrc = 4.
            MESSAGE s002(sppf_view).
            EXIT.
        ENDTRY.

* reprocessing? -> set new trigger by repeating the selected one
        IF lo_trigger->get_status( ) NE sppf_status_unprocessed.
          lo_new_trigger = lo_trigger->repeat( ).
* this trigger has been manually created
          CALL METHOD lo_new_trigger->set_is_mcreat( sppf_true ).
          lo_trigger = lo_new_trigger.
        ENDIF.

        IF lo_trigger->internal_enqueue( ) EQ sppf_true.
*   check for exec and delete
          l_execanddel = lo_trigger->get_execanddel( ).
          IF l_execanddel = abap_true.
*             set temporary to not delete
            lo_trigger->set_execanddel( space ).
          ENDIF.
*   execute
          CALL METHOD lo_trigger->execute
            EXPORTING
              ip_check_opt_rule       = l_check_opt_rule
              ip_appl_already_locked  = abap_true            "note 807255
            EXCEPTIONS
*   Correction: supress BAdI call, in case of an error
*   1.12.2003 (Part 1/2)<<<<
              empty_medium_reference  = 1
              empty_appl_reference    = 2
              locked                  = 3
              document_is_locked      = 4
              inactive                = 5
              startcondition_not_true = 6
              OTHERS                  = 99.

          IF sy-subrc NE 0.
            MESSAGE ID sy-msgid TYPE 'S' NUMBER sy-msgno
               WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
*           Correction: BAdI call, in case of an error
*           Remember if the
            l_executed = sppf_false.

          ELSE.
            l_executed = sppf_true.
          ENDIF.


*   set flag back to original value
          IF l_execanddel = 'X'.
*             set temporary to not delete
            lo_trigger->set_execanddel( 'X' ).
          ENDIF.

*   set guid again
          cl_object_pool=>set_guid( l_guid ).

*   access data (for object pool)
*   Correction: supress BAdI call, in case of an error
*   1.12.2003 (Part 2/2)<<<<
          IF l_executed EQ sppf_true.
            lo_trigger->update_date_and_user( ).

*            PERFORM call_exit_executed USING lo_trigger.
          ENDIF.

          l_stat = lo_trigger->get_status( ).

*   delete trigger if necessary
          IF l_execanddel = 'X'  AND
             l_stat EQ sppf_status_processed.
            lo_trigger->delete( EXPORTING ip_appl_already_locked = abap_true
                                EXCEPTIONS OTHERS                = 0 ).
          ENDIF.
          lo_trigger->internal_dequeue( ).
*   dequeue application object (error is ignored)
*            perform unlock_application_object using    lo_appl
*                                              changing l_error.
        ENDIF.

* end object pool for this guid
        cl_object_pool=>save_guids( ip_guid = l_guid ).

*         CALL METHOD li_transaction->end.
* wait for update task to finish (data needs to be displayed)
        COMMIT WORK AND WAIT.

* set guid again
        cl_object_pool=>set_guid( l_guid ).

        e_subrc = 0.
      ELSE.
        e_subrc = sy-subrc.
      ENDIF.
    ELSE.
      e_subrc = sy-subrc.
    ENDIF.

  ENDMETHOD.
ENDCLASS.
CLASS zclcxr1090_mensaje_impresion DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    TYPES:
      tt_r_vstat  TYPE RANGE OF nast-vstat,
      gtp_r_kappl TYPE RANGE OF sna_kappl.

    CONSTANTS kvewe_nast TYPE t681z-kvewe VALUE 'B' ##NO_TEXT.
    CONSTANTS:
      on(1)      TYPE c VALUE 'X' ##NO_TEXT.

    "! Impresion de mensajes de etiquetas
    "! @parameter i_objky | Clave del objeto
    "! @parameter i_kappl | Aplicación
    "! @parameter i_r_mensajes | Rango de clases de mensaje a excluir
    METHODS impresion
      IMPORTING
        !i_objky       TYPE nast-objky
        !i_kappl       TYPE sna_kappl OPTIONAL
        i_r_kappl      TYPE gtp_r_kappl OPTIONAL
        !i_r_mensajes  TYPE cond_type_range_erp_t OPTIONAL
        !i_r_vstat     TYPE tt_r_vstat OPTIONAL
        !i_manual      TYPE xfeld OPTIONAL
      EXPORTING
        VALUE(e_subrc) TYPE sy-subrc .
    METHODS impresion_hu_ewm
      IMPORTING
        !i_lgnum       TYPE /scwm/hu_ppf-lgnum
        !i_huident     TYPE /scwm/hu_ppf-huident
      EXPORTING
        VALUE(e_subrc) TYPE sy-subrc .
  PROTECTED SECTION.


  PRIVATE SECTION.


    DATA: ges_nast  TYPE nast,  "NAST
          ges_nase  TYPE nase,  "NASE
          ges_t681b TYPE t681b. "T681B

    DATA: ges_alarc_par1 TYPE alarc_par1, "ALARC_PAR1
          ges_arc_params TYPE arc_params, "ARC_PARAMS
          ges_toa_dara   TYPE toa_dara,   "TOA_DARA
          ges_nast00     TYPE nast00.     "NAST00

    DATA: ges_tnapr  TYPE tnapr,  "TNAPR
          ges_tnapr_ TYPE tnapr,  "*TNAPR
          ges_t681z  TYPE t681z,  "T681Z
          ges_t685b  TYPE t685b.  "T685B

    DATA: returncode TYPE sy-subrc,   "Returncode aus Druckprogramm
          retcode    TYPE sy-subrc,   "Returncode
          count      TYPE sy-index,   "Counter: verarbeitete Belege
          count_1    TYPE sy-index,   "Counter: erfolgreich verarbeitet
          count_2    TYPE sy-index,   "Counter: fehlerhaft verarbeitet
          xscreen(1) TYPE c.

    DATA: BEGIN OF partner,
            rolle  TYPE nast-parvw,
            nummer TYPE nast-parnr,
          END OF partner.

    DATA: p_vstat TYPE nast-vstat.


    METHODS:
      check_kappls_not_to_process CHANGING VALUE(p_kappl) TYPE nast-kappl
                                           VALUE(p_subrc) TYPE sy-subrc,


      tnapr_lesen  IMPORTING VALUE(p_kschl) TYPE nast-kschl
                             VALUE(p_nacha) TYPE nast-nacha
                             VALUE(p_kappl) TYPE nast-kappl,

      t685b_lesen IMPORTING VALUE(us_kappl) TYPE t685b-kappl
                            VALUE(us_kschl) TYPE t685b-kschl,


      optische_archivierung,

      programm_aufrufen IMPORTING us_screen TYPE c,

      set_counters IMPORTING l_subrc TYPE sy-subrc,

      objekt_entsperren.


ENDCLASS.



CLASS zclcxr1090_mensaje_impresion IMPLEMENTATION.


  METHOD impresion.

    DATA: l_r_kappl  TYPE RANGE OF sna_kappl,
          l_es_kappl LIKE LINE OF l_r_kappl,
          l_ti_nast  TYPE STANDARD TABLE OF nast,
          l_r_nacha  TYPE RANGE OF nast-nacha,
          l_es_nacha LIKE LINE OF l_r_nacha.

    CLEAR: l_r_kappl, l_r_nacha.

    IF i_kappl IS NOT INITIAL.
      l_es_kappl-sign   = 'I'.
      l_es_kappl-option = 'EQ'.
      l_es_kappl-low    = i_kappl.
      APPEND l_es_kappl TO l_r_kappl.
    ENDIF.

    "' Inicio SGR 07.04.2025 | Permitir mas de un objeto
    IF i_r_kappl IS NOT INITIAL.
      APPEND LINES OF i_r_kappl TO l_r_kappl.
    ENDIF.
    "' Fin SGR 07.04.2025

    l_es_nacha-sign   = 'I'.
    l_es_nacha-option = 'EQ'.
    l_es_nacha-low    = '1'.
    APPEND l_es_nacha TO l_r_nacha.

    l_es_nacha-sign   = 'I'.
    l_es_nacha-option = 'EQ'.
    l_es_nacha-low    = '2'.
    APPEND l_es_nacha TO l_r_nacha.

    l_es_nacha-sign   = 'I'.
    l_es_nacha-option = 'EQ'.
    l_es_nacha-low    = '5'.
    APPEND l_es_nacha TO l_r_nacha.

    l_es_nacha-sign   = 'I'.
    l_es_nacha-option = 'EQ'.
    l_es_nacha-low    = '7'.
    APPEND l_es_nacha TO l_r_nacha.

    IF i_manual IS INITIAL.
      SELECT *
        INTO TABLE l_ti_nast
        FROM nast
        WHERE objky EQ i_objky
          AND kappl IN l_r_kappl
          AND manue NE 'X'.
    ELSE.
      SELECT *
        INTO TABLE l_ti_nast
        FROM nast
        WHERE objky EQ i_objky
          AND kappl IN l_r_kappl.
      "AND manue NE 'X'.
    ENDIF.
    "Excluir las clases de  mensajes paramatrizados si es del caso
    IF i_r_mensajes[] IS NOT INITIAL.
      DELETE l_ti_nast WHERE kschl NOT IN i_r_mensajes.
    ENDIF.

    "Excluir los estados de los mensajes paramatrizados si es del caso
    IF i_r_vstat[] IS NOT INITIAL.
      DELETE l_ti_nast WHERE vstat NOT IN i_r_vstat.
    ENDIF.

    IF l_ti_nast IS INITIAL.
      e_subrc = 4.
    ELSE.


      LOOP AT l_ti_nast INTO ges_nast.

        CALL FUNCTION 'WFMC_MESSAGE_SINGLE'
          EXPORTING
            pi_nast  = ges_nast
          IMPORTING
            pe_rcode = e_subrc.

*      check_kappls_not_to_process( CHANGING p_kappl = ges_nast-kappl
*                                            p_subrc = returncode ).
*
**...Validación de mensajes
*      IF ges_nast-nacha NOT IN l_r_nacha OR ges_nast-aktiv NE space.
*        CONTINUE.
*      ENDIF.
*
*
*
*      tnapr_lesen( EXPORTING p_kschl = ges_nast-kschl
*                             p_nacha = ges_nast-nacha
*                             p_kappl = ges_nast-kappl ).
*      CLEAR xscreen.
*
*      optische_archivierung(  ).
*      programm_aufrufen( xscreen ).
*      set_counters( returncode ).
*      IF sy-batch NE space.
*        partner-rolle = ges_nast-parvw.
*        partner-nummer = ges_nast-parnr.
*        MESSAGE i034(vn) WITH ges_nast-objky ges_nast-kschl partner returncode.
*      ENDIF.
*      IF ges_nast-kappl EQ 'WT'.
*        COMMIT WORK AND WAIT.
*      ELSE.
*        COMMIT WORK .
*      ENDIF.
*      objekt_entsperren(  ).
*      IF sy-batch = space.
*        CALL FUNCTION 'WFMC_PROTOCOL_LOAD'
*          EXPORTING
*            cps_nast = ges_nast.
*      ENDIF.
*      IF sy-batch = space.
*        CALL FUNCTION 'WFMC_PROTOCOL_SHOW'
*          EXPORTING
*            cps_kalsm = space
*            cps_nast  = ges_nast
*            no_header = 'X'.
*      ENDIF.
*
      ENDLOOP.

    ENDIF.

  ENDMETHOD.


  METHOD check_kappls_not_to_process.

    CASE p_kappl.
      WHEN 'WA'.
* NAST records for application WA must not be processed
        p_subrc = 4.
      WHEN OTHERS.
* any other application may be processed
        p_subrc = 0.
    ENDCASE.


  ENDMETHOD.


  METHOD tnapr_lesen.

    CHECK ges_tnapr-kschl NE p_kschl
      OR  ges_tnapr-nacha NE p_nacha
      OR  ges_tnapr-kappl NE p_kappl.
    SELECT SINGLE * FROM tnapr INTO ges_tnapr
      WHERE kschl = p_kschl
        AND   nacha = p_nacha
        AND   kappl = p_kappl.
    IF sy-subrc NE 0.
      MESSAGE a020(vn) WITH p_kschl p_nacha p_kappl.
    ENDIF.

  ENDMETHOD.


  METHOD t685b_lesen.

    CHECK ges_t685b-kappl NE us_kappl
       OR ges_t685b-kschl NE us_kschl.
    SELECT SINGLE * FROM t685b INTO ges_t685b
      WHERE kappl = us_kappl
        AND   kschl = us_kschl.
    IF sy-subrc NE 0.
      MESSAGE a047(vn) WITH us_kappl us_kschl.
    ENDIF.

  ENDMETHOD.


  METHOD optische_archivierung.


    DATA: BEGIN OF xobjid,
            objky TYPE nast-objky,
            arcnr TYPE nast-optarcnr,
          END OF xobjid.
    DATA: xoj_name TYPE toa_dara-sap_object.
    DATA: xobjky   TYPE nast-objky.

    CHECK ges_nast-tdarmod = '2'
      OR  ges_nast-tdarmod = '3'.
* Ermitteln der Objektart
    xobjky = ges_nast-objky.
    CALL FUNCTION 'WFMC_GET_ARCHIVE_OBJECT_TYPE'
      EXPORTING
        pi_kappl       = ges_nast-kappl
        pi_objtype     = ges_nast-objtype
      IMPORTING
        pe_object_type = xoj_name
      CHANGING
        pc_objky       = xobjky.
    IF xoj_name = space.
      MESSAGE a049(vn) WITH ges_nast-kappl.
    ENDIF.
* Ermitteln der Dokumentenart
    t685b_lesen( EXPORTING us_kappl = ges_nast-kappl
                           us_kschl = ges_nast-kschl ).
* Ermitteln der Archivnummer
    CALL FUNCTION 'NUMBER_GET_NEXT'
      EXPORTING
        nr_range_nr = '01'
        object      = 'NA_OPT_ARC'
      IMPORTING
        number      = ges_nast-optarcnr.
* Aufbau OBJECT_ID
    xobjid-objky = xobjky.
    xobjid-arcnr = ges_nast-optarcnr.
* Versorgen TOA_DARA
    ges_toa_dara-mandant    = ges_nast-mandt.
    ges_toa_dara-sap_object = xoj_name.
    ges_toa_dara-ar_object  = ges_t685b-arcobjart.
    ges_toa_dara-object_id  = xobjid.
* Versorgen ARC_PARAMS
    ges_arc_params-sap_object = xoj_name.
    ges_arc_params-ar_object  = ges_t685b-arcobjart.
    ges_arc_params-mandant    = ges_nast-mandt.
* gleiches Userhandling wie in den Spoolparametern
    IF ges_nast-tdreceiver NE space.
      ges_arc_params-arcuser    = ges_nast-tdreceiver.
    ELSE.
      ges_arc_params-arcuser    = ges_nast-usnam.
    ENDIF.
    ges_arc_params-printer    = ges_nast-ldest.
    ges_alarc_par1-sap_object = xoj_name.
    ges_alarc_par1-ar_object  = ges_t685b-arcobjart.
    ges_alarc_par1-mandant    = ges_nast-mandt.
    ges_alarc_par1-arcuser    = ges_nast-usnam.
    ges_alarc_par1-printer    = ges_nast-ldest.

  ENDMETHOD.


  METHOD programm_aufrufen.

    DATA: ronam     TYPE tnapr-ronam,
          fonam     TYPE tnapr-fonam,
          pgnam     TYPE tnapr-pgnam,
          temp_nast TYPE nast.

* shall those NAST records be processed at all?
    DATA us_subrc TYPE sy-subrc.

    check_kappls_not_to_process( CHANGING p_kappl = ges_nast-kappl
                                          p_subrc = us_subrc ).

    CHECK us_subrc EQ 0.


* don't process locked entries (but don't perform this check
* in preview mode)
    IF us_screen NE on.
      returncode = 3.
      CHECK ges_nast-snddr EQ space.
    ENDIF.

    IF ges_nast-nacha = '1' AND
         ges_nast-tdreceiver IS INITIAL.
      ges_nast-tdreceiver = ges_nast-usnam.
    ENDIF.
    CALL FUNCTION 'NAST_PROTOCOL_INITIALIZE'.
    ges_tnapr_ = ges_tnapr.
* try to perform all routines in TNAPR (RONAM - RONAM5)
    DO 5 TIMES VARYING ronam FROM ges_tnapr_-ronam NEXT ges_tnapr_-ronam2
               VARYING fonam FROM ges_tnapr_-fonam NEXT ges_tnapr_-fonam2
               VARYING pgnam FROM ges_tnapr_-pgnam NEXT ges_tnapr_-pgnam2.
      CHECK pgnam NE space.
      ges_tnapr-ronam = ronam.
      ges_tnapr-fonam = fonam.
      ges_tnapr-pgnam = pgnam.
      IF ges_tnapr-ronam NE space OR ges_tnapr-pgnam NE space.
* initial protocol entry for this processing program call
* note: if no further protocol entries exist, this entry alone
*       will not be saved by NAST_PROTOCOL_STORE
        sy-msgid = 'VN'.
        sy-msgno = '056'.
        sy-msgty = 'I'.
        sy-msgv1 = ges_tnapr-pgnam.
        CONDENSE sy-msgv1 NO-GAPS.
        sy-msgv2 = ges_tnapr-ronam.
        CONDENSE sy-msgv2 NO-GAPS.
        CALL FUNCTION 'NAST_PROTOCOL_UPDATE'
          EXPORTING
            msg_arbgb = sy-msgid
            msg_nr    = sy-msgno
            msg_ty    = sy-msgty
            msg_v1    = sy-msgv1
            msg_v2    = sy-msgv2
          EXCEPTIONS
            OTHERS    = 0.

      ENDIF.
* set function module if not yet available
* (extra module to have an alternative print engine)
* for printing only:
      IF ges_nast-nacha EQ '1'.
* set function module if not yet available
* (extra module to have an alternative print engine)
        IF ges_nast-pfld5 NE space.
          ges_tnapr-funcname = ges_nast-pfld5.
        ENDIF.
      ENDIF.
* for printing and faxing:
      IF ges_nast-nacha EQ '1' OR ges_nast-nacha EQ '2'.
* set SAPscript form if specified in NAST record
        IF ges_nast-pfld4 NE space.
          ges_tnapr-fonam = ges_nast-pfld4.
        ENDIF.
      ENDIF.

* override smart form name, if applicable
      IF ges_nast-pfld3 NE space.
        ges_tnapr-sform = ges_nast-pfld3.
      ENDIF.

      returncode = 999.
* save original NAST record
      temp_nast = ges_nast.
* even repeated processing should get VSTAT = 0 in order to
* have a consistent behaviour throughout all processing techniques
*   nast-vstat = '0'.
      IF ges_nast-kappl EQ 'V1' AND
         us_screen NE on.
* set initialization-flag for sales messages
        CALL FUNCTION 'RV_PRICE_PRINT_GET_BUFFER'
          EXPORTING
            i_print_from_buffer = 'A'.
      ENDIF.
      PERFORM (ges_tnapr-ronam) IN PROGRAM (ges_tnapr-pgnam) USING returncode
                                                                   us_screen
                                                             IF FOUND.
* restore original NAST record (in case TNAPR-RONAM changed something)
      ges_nast = temp_nast.
* return code unchanged: program didn't behave properly
      IF returncode = 999.
        syst-msgid = 'VN'.
        syst-msgno = 068.
        syst-msgty = 'E'.
        syst-msgv1 = ges_tnapr-ronam.
        syst-msgv2 = ges_tnapr-pgnam.
        CALL FUNCTION 'NAST_PROTOCOL_UPDATE'
          EXPORTING
            msg_arbgb = syst-msgid
            msg_nr    = syst-msgno
            msg_ty    = syst-msgty
            msg_v1    = syst-msgv1
            msg_v2    = syst-msgv2
          EXCEPTIONS
            OTHERS    = 0.

      ENDIF.
      IF returncode NE 0.
        EXIT.
      ENDIF.

    ENDDO.
    ges_tnapr = ges_tnapr_.

  ENDMETHOD.


  METHOD set_counters.

    CASE l_subrc.
      WHEN '0'.                          "successfully processed
        ADD 1 TO count_1.
      WHEN '1'.                          "processing failure
        ADD 1 TO count_2.
*   WHEN '2'.                          "translated (EDI)
*     ADD 1 TO count_1.
      WHEN '3'.                          "application document incomplete
      WHEN OTHERS.                       "processing failure
        ADD 1 TO count_2.
    ENDCASE.

  ENDMETHOD.


  METHOD objekt_entsperren.
    DATA: belnr TYPE vbak-vbeln.
    DATA: ebeln TYPE ekko-ebeln.
    DATA: tknum TYPE vttk-tknum.
    DATA: pabnum TYPE pabit-pabnum.
    DATA: l_knuma TYPE knuma.
    DATA: l_wbeln TYPE wbeln_ag.
    DATA: l_tkonn TYPE tkonn.
    DATA: l_wale TYPE wale.

    CASE ges_nast-kappl.
      WHEN 'V1'.                         "Auftrag
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBAKE'
          EXPORTING
            vbeln = belnr.
      WHEN 'V2' OR 'E1'.                 "Lieferung
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBLKE'
          EXPORTING
            vbeln = belnr.
      WHEN 'V3'.                         "Faktura
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBRKE'
          EXPORTING
            vbeln = belnr.
      WHEN 'V4'.                         "Kommissionierung
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBLKE'
          EXPORTING
            vbeln = belnr.
      WHEN 'V6'.                         "Versandelemente
      WHEN 'V7'.                         "Transporte
        tknum = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVTTKE'
          EXPORTING
            mandt = sy-mandt
            tknum = tknum.
      WHEN 'VL'.                         "Besuchsliste
        DATA: lv_vlid(10) TYPE c.
        lv_vlid = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_/DSD/E_VC_VLH'
          EXPORTING
            vlid = lv_vlid.
      WHEN 'K1'.                         "Kontakte
        belnr = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVVBKAE'
          EXPORTING
            vbeln = belnr.
      WHEN 'EF' OR 'EA' OR 'EV' OR 'ES' OR 'EL'.  "Einkauf
        ebeln = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EMEKKOE'
          EXPORTING
            ebeln  = ebeln
          EXCEPTIONS
            OTHERS = 0.
      WHEN 'NF'.                         "Nota Fiscal (Brasilien)
        DATA: nfnum_int TYPE j_1bnfdoc-docnum.
        nfnum_int = ges_nast-objky.
        CALL FUNCTION 'J_1B_NF_DOCUMENT_UNLOCK'
          EXPORTING
            doc_number = nfnum_int
            lock_mode  = 'E'
          EXCEPTIONS
            OTHERS     = 0.
      WHEN 'PA'.                         "Produktionsabruf
        pabnum = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_E_PABIT_E'
          EXPORTING
            pabnum   = pabnum
            x_pabpos = on
          EXCEPTIONS
            OTHERS   = 0.
      WHEN 'WN'.
        l_knuma = ges_nast-objky+10(10).
        CALL FUNCTION 'DEQUEUE_EVKONAE'
          EXPORTING
            knuma = l_knuma.
      WHEN 'WR'.
        l_wbeln = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EMWBRKE'
          EXPORTING
            wbeln = l_wbeln.
      WHEN 'WS'.
        l_knuma = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVKONAE'
          EXPORTING
            knuma = l_knuma.
      WHEN 'WT'.
        l_tkonn = ges_nast-objky.
        CALL FUNCTION 'DEQUEUE_EVWBHKE'
          EXPORTING
            tkonn = l_tkonn.
      WHEN 'W1'.
        CLEAR l_wale.
        l_wale-aktnr = ges_nast-objky(10).
        l_wale-kunnr = ges_nast-sort2+5(10).
        CALL FUNCTION 'DEQUEUE_EWWALE'
          EXPORTING
            aktnr = l_wale-aktnr
            artnr = l_wale-artnr
            mebme = l_wale-mebme
            kunnr = l_wale-kunnr
            clint = l_wale-clint.

    ENDCASE.

  ENDMETHOD.


  METHOD impresion_hu_ewm.


    DATA: lo_manager             TYPE REF TO cl_manager_ppf,
          li_transaction_manager TYPE REF TO if_os_transaction_manager,
          li_persistency_agent   TYPE REF TO if_os_ca_persistency,
          lo_new_trigger         TYPE REF TO cl_trigger_ppf,
          lo_trigger             TYPE REF TO cl_trigger_ppf,
          l_execanddel           TYPE char1,
          l_executed             TYPE char1,
          l_counter_locked       TYPE i,
          l_error                TYPE char1,
          l_execute_mode         TYPE sppfdxmode,
          lo_agent               TYPE REF TO ca_trigger_ppf. "1770445

    DATA lo_appl   TYPE REF TO object.
    DATA: l_guid           TYPE os_guid,
          l_stat           TYPE ppfdtstat,
          l_check_opt_rule TYPE char1.


    SELECT SINGLE FROM /scwm/hu_ppf
      FIELDS *
      WHERE lgnum EQ @i_lgnum
        AND huident EQ @i_huident
      INTO @DATA(ls_hu_ppf).
    IF sy-subrc IS INITIAL.

      SELECT SINGLE FROM ppfttrigg
        FIELDS *
        WHERE appl_oid EQ @ls_hu_ppf-guid
          AND status IN ( '0', '1' )
        INTO @DATA(ls_ppf).
      IF sy-subrc IS INITIAL.
* activate object pool
        CALL FUNCTION 'GUID_CREATE'
          IMPORTING
            ev_guid_16 = l_guid.

        cl_object_pool=>set_guid( l_guid ).



* ask central system instance for transaction manager
        li_transaction_manager = cl_os_system=>get_transaction_manager( ).

*li_service_agent ?= cl_os_system=>get_class_agent( sppf_cls_trigger ).
        li_persistency_agent ?=
          cl_os_system=>get_class_agent( sppf_cls_trigger ).

* get PPF manager and set execution mode
        lo_manager = cl_manager_ppf=>get_instance( ).
        l_execute_mode = lo_manager->execution_mode.        "note 1124587
        lo_manager->execution_mode = sppf_execute_report.


        TRY.
*note 1770445:  refresh buffers, as in the meantime actions can be deleted in a different session
*           but still be found in buffers of persistence class
            lo_agent ?= ca_trigger_ppf=>agent.
            lo_trigger ?= li_persistency_agent->get_persistent_by_oid( ls_ppf-os_guid ).
            lo_agent->if_os_factory~refresh_persistent( lo_trigger ).
            lo_trigger ?= li_persistency_agent->get_persistent_by_oid( ls_ppf-os_guid ).
          CATCH cx_os_object_not_found.
            e_subrc = 4.
            MESSAGE s002(sppf_view).
            EXIT.
        ENDTRY.

* reprocessing? -> set new trigger by repeating the selected one
        IF lo_trigger->get_status( ) NE sppf_status_unprocessed.
          lo_new_trigger = lo_trigger->repeat( ).
* this trigger has been manually created
          CALL METHOD lo_new_trigger->set_is_mcreat( sppf_true ).
          lo_trigger = lo_new_trigger.
        ENDIF.

        IF lo_trigger->internal_enqueue( ) EQ sppf_true.
*   check for exec and delete
          l_execanddel = lo_trigger->get_execanddel( ).
          IF l_execanddel = abap_true.
*             set temporary to not delete
            lo_trigger->set_execanddel( space ).
          ENDIF.
*   execute
          CALL METHOD lo_trigger->execute
            EXPORTING
              ip_check_opt_rule       = l_check_opt_rule
              ip_appl_already_locked  = abap_true            "note 807255
            EXCEPTIONS
*   Correction: supress BAdI call, in case of an error
*   1.12.2003 (Part 1/2)<<<<
              empty_medium_reference  = 1
              empty_appl_reference    = 2
              locked                  = 3
              document_is_locked      = 4
              inactive                = 5
              startcondition_not_true = 6
              OTHERS                  = 99.

          IF sy-subrc NE 0.
            MESSAGE ID sy-msgid TYPE 'S' NUMBER sy-msgno
               WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
*           Correction: BAdI call, in case of an error
*           Remember if the
            l_executed = sppf_false.

          ELSE.
            l_executed = sppf_true.
          ENDIF.


*   set flag back to original value
          IF l_execanddel = 'X'.
*             set temporary to not delete
            lo_trigger->set_execanddel( 'X' ).
          ENDIF.

*   set guid again
          cl_object_pool=>set_guid( l_guid ).

*   access data (for object pool)
*   Correction: supress BAdI call, in case of an error
*   1.12.2003 (Part 2/2)<<<<
          IF l_executed EQ sppf_true.
            lo_trigger->update_date_and_user( ).

*            PERFORM call_exit_executed USING lo_trigger.
          ENDIF.

          l_stat = lo_trigger->get_status( ).

*   delete trigger if necessary
          IF l_execanddel = 'X'  AND
             l_stat EQ sppf_status_processed.
            lo_trigger->delete( EXPORTING ip_appl_already_locked = abap_true
                                EXCEPTIONS OTHERS                = 0 ).
          ENDIF.
          lo_trigger->internal_dequeue( ).
*   dequeue application object (error is ignored)
*            perform unlock_application_object using    lo_appl
*                                              changing l_error.
        ENDIF.

* end object pool for this guid
        cl_object_pool=>save_guids( ip_guid = l_guid ).

*         CALL METHOD li_transaction->end.
* wait for update task to finish (data needs to be displayed)
        COMMIT WORK AND WAIT.

* set guid again
        cl_object_pool=>set_guid( l_guid ).

        e_subrc = 0.
      ELSE.
        e_subrc = sy-subrc.
      ENDIF.
    ELSE.
      e_subrc = sy-subrc.
    ENDIF.

  ENDMETHOD.
ENDCLASS.