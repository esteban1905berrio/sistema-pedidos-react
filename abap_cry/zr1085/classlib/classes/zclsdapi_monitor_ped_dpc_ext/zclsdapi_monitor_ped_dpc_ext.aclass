      es_pedidos-hora_fin_transporte                = es_outdata-trans_uzeit                   .
      es_pedidos-status_novedad_transportista       = es_outdata-zz1_statustransportist_dlh    .
      es_pedidos-desc_sta_novedad_transportista     = es_outdata-desc_sta_novedad_transportista.

      v_char255 = es_outdata-zz1_fechaentregaclient_dlh.
      CONDENSE v_char255 NO-GAPS.
      IF v_char255 IS INITIAL.
        CLEAR es_pedidos-fecha_entrega_cliente.
      ELSE.
        TRY.
            IF es_outdata-zz1_fechaentregaclient_dlh IS NOT INITIAL.
              es_pedidos-fecha_entrega_cliente              = es_outdata-zz1_fechaentregaclient_dlh  .
            ENDIF.
          CATCH cx_root.
            CLEAR es_pedidos-fecha_entrega_cliente.
        ENDTRY.
      ENDIF.
      v_char255 = es_outdata-zz1_horaentregacliente_dlh.
      CONDENSE v_char255 NO-GAPS.
      IF v_char255 IS INITIAL.
        CLEAR es_pedidos-hora_entrega_cliente.
      ELSE.
        TRY.
            IF es_outdata-zz1_horaentregacliente_dlh IS NOT INITIAL.
              es_pedidos-hora_entrega_cliente               = es_outdata-zz1_horaentregacliente_dlh    .
            ENDIF.
          CATCH cx_root.
            CLEAR es_pedidos-hora_entrega_cliente.
        ENDTRY.
      ENDIF.
      es_pedidos-fecha_contabiliza_recepcion        = es_outdata-budat_1                       .
      es_pedidos-cantidad_recibida                  = es_outdata-menge                         .
      es_pedidos-novedad_transportista              = es_outdata-zz1_novedadtransportis_dlh    .
*      es_pedidos-zzest_carga                        = es_outdata-                              .
*      es_pedidos-pedido_traslado                    = es_outdata-                              .
*      es_pedidos-posicion_consolidada               = es_outdata-                              .
      v_char255 = es_outdata-zz1_fechprivisit_dlh.
      CONDENSE v_char255 NO-GAPS.
      IF v_char255 IS INITIAL.
        CLEAR es_pedidos-zz1_fechprivisit_dlh.
      ELSE.
*        es_pedidos-zz1_fechprivisit_dlh               = es_outdata-zz1_fechprivisit_dlh          .
        TRY.
            IF es_outdata-zz1_fechprivisit_dlh IS NOT INITIAL.
              es_pedidos-zz1_fechprivisit_dlh               = es_outdata-zz1_fechprivisit_dlh    .
            ENDIF.
          CATCH cx_root.
            CLEAR es_pedidos-zz1_fechprivisit_dlh.
        ENDTRY.
      ENDIF.

      v_char255 = es_outdata-zz1_horaprivisit_dlh.
      CONDENSE v_char255 NO-GAPS.
      IF v_char255 IS INITIAL.
        CLEAR es_pedidos-zz1_horaprivisit_dlh.
      ELSE.
*        es_pedidos-zz1_horaprivisit_dlh               = es_outdata-zz1_horaprivisit_dlh          .
        TRY.
            IF es_outdata-zz1_horaprivisit_dlh IS NOT INITIAL.
              es_pedidos-zz1_horaprivisit_dlh               = es_outdata-zz1_horaprivisit_dlh    .
            ENDIF.
          CATCH cx_root.
            CLEAR es_pedidos-zz1_horaprivisit_dlh.
        ENDTRY.
      ENDIF.

      APPEND es_pedidos TO ti_pedidos.

    ENDLOOP.

    CREATE DATA er_entityset TYPE zclsdapi_monitor_pedidos_mpc=>tt_pedidos.
*      ASSIGN er_entityset->* TO FIELD-SYMBOL(<fs_ti_pedidos>).
    ASSIGN er_entityset->* TO <fs_ti_pedidos>.

    <fs_ti_pedidos> =  CORRESPONDING zclsdapi_monitor_pedidos_mpc=>tt_pedidos( ti_pedidos ).

*      DATA(o_log) = zclcxr1002_log_aplicacion=>get_instancia( ).
*      DATA(ti_log) = o_log->get_log( ).

    IF ti_bapiterturn IS NOT INITIAL.
      "Retorna Status 400 con mensaje en body
      me->/iwbep/if_sb_dpc_comm_services~rfc_save_log(  EXPORTING
                                                          iv_entity_type  = iv_entity_name
                                                          it_return       = ti_bapiterturn
                                                          it_key_tab      = it_key_tab ).
      "Retorna Status 200 con mensaje en header del response
      o_contenedor_msg = me->mo_context->get_message_container( ).
*        LOOP AT ti_bapiterturn ASSIGNING FIELD-SYMBOL(<fs_es_mensaje>).
      LOOP AT ti_bapiterturn INTO es_bapiret2.

        o_contenedor_msg->add_message( iv_msg_type    = es_bapiret2-type
                                       iv_msg_id      = es_bapiret2-id
                                       iv_msg_number  = es_bapiret2-number
                                       iv_msg_text    = es_bapiret2-message
                                       iv_msg_v1      = es_bapiret2-message_v1
                                       iv_msg_v2      = es_bapiret2-message_v2
                                       iv_msg_v3      = es_bapiret2-message_v3
                                       iv_msg_v4      = es_bapiret2-message_v4
                                       iv_add_to_response_header = abap_true
                                     ).

      ENDLOOP.
    ENDIF.

  ENDMETHOD.
ENDCLASS.