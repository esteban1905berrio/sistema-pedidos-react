      ENDIF.

      v_char255 = es_outdata-zz1_horaprivisit_dlh.
      CONDENSE v_char255 NO-GAPS.
      IF v_char255 IS INITIAL.
        CLEAR es_pedidos-zz1_horaprivisit_dlh.
      ELSE.
*        es_pedidos-zz1_horaprivisit_dlh               = es_outdata-zz1_horaprivisit_dlh          .
        TRY.
            IF es_outdata-zz1_horaprivisit_dlh IS NOT INITIAL.
              es_pedidos-zz1_horaprivisit_dlh               = es_outdata-zz1_horaprivisit_dlh    .
            ENDIF.
          CATCH cx_root.
            CLEAR es_pedidos-zz1_horaprivisit_dlh.
        ENDTRY.
      ENDIF.

      APPEND es_pedidos TO ti_pedidos.

    ENDLOOP.

    CREATE DATA er_entityset TYPE zclsdapi_monitor_pedidos_mpc=>tt_pedidos.
*      ASSIGN er_entityset->* TO FIELD-SYMBOL(<fs_ti_pedidos>).
    ASSIGN er_entityset->* TO <fs_ti_pedidos>.

    <fs_ti_pedidos> =  CORRESPONDING zclsdapi_monitor_pedidos_mpc=>tt_pedidos( ti_pedidos ).

*      DATA(o_log) = zclcxr1002_log_aplicacion=>get_instancia( ).
*      DATA(ti_log) = o_log->get_log( ).

    IF ti_bapiterturn IS NOT INITIAL.
      "Retorna Status 400 con mensaje en body
      me->/iwbep/if_sb_dpc_comm_services~rfc_save_log(  EXPORTING
                                                          iv_entity_type  = iv_entity_name
                                                          it_return       = ti_bapiterturn
                                                          it_key_tab      = it_key_tab ).
      "Retorna Status 200 con mensaje en header del response
      o_contenedor_msg = me->mo_context->get_message_container( ).
*        LOOP AT ti_bapiterturn ASSIGNING FIELD-SYMBOL(<fs_es_mensaje>).
      LOOP AT ti_bapiterturn INTO es_bapiret2.

        o_contenedor_msg->add_message( iv_msg_type    = es_bapiret2-type
                                       iv_msg_id      = es_bapiret2-id
                                       iv_msg_number  = es_bapiret2-number
                                       iv_msg_text    = es_bapiret2-message
                                       iv_msg_v1      = es_bapiret2-message_v1
                                       iv_msg_v2      = es_bapiret2-message_v2
                                       iv_msg_v3      = es_bapiret2-message_v3
                                       iv_msg_v4      = es_bapiret2-message_v4
                                       iv_add_to_response_header = abap_true
                                     ).

      ENDLOOP.
    ENDIF.

  ENDMETHOD.
ENDCLASS.
CLASS zclsdapi_monitor_ped_dpc_ext DEFINITION
  PUBLIC
  INHERITING FROM zclsdapi_monitor_pedidos_dpc
  CREATE PUBLIC .

  PUBLIC SECTION.

    METHODS:
      /iwbep/if_mgw_appl_srv_runtime~get_entityset REDEFINITION.

  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.



CLASS zclsdapi_monitor_ped_dpc_ext IMPLEMENTATION.


  METHOD /iwbep/if_mgw_appl_srv_runtime~get_entityset.

*-------------------------------------------------------------------------------*
* Definicion de Objetos
*-------------------------------------------------------------------------------*
    DATA:
          go_sdr1085_2 TYPE REF TO zclsdr1085_2_monitor_pedidos.

*-------------------------------------------------------------------------------*
* Definicion de Constantes
*-------------------------------------------------------------------------------*
    CONSTANTS:
      gc_zcx01 TYPE symsgid    VALUE 'ZCX01',  ".Clase de Mensajes
      gc_000   TYPE msgnr      VALUE '000',    ".Mensaje Generico
*              gc_coma      TYPE c          VALUE ',',      "Coma (,)
      gc_punto TYPE c          VALUE '.',      "Punto (.)
*              gc_01        TYPE char2      VALUE '01',
*              gc_04        TYPE char2      VALUE '04',
      gc_1     TYPE c          VALUE '1',      "1
      gc_2     TYPE c          VALUE '2',      "2
*              gc_3         TYPE i          VALUE '3',      "3
*              gc_4         TYPE i          VALUE '4',      "4
      gc_42    TYPE i          VALUE '42',     "42
*              gc_5         TYPE i          VALUE '5',      "5
*              gc_6         TYPE i          VALUE '6',      "6
*              gc_7         TYPE i          VALUE '7',      "7
      gc_8     TYPE i          VALUE '8',      "8
*              gc_10        TYPE i          VALUE '10',     "10
      gc_a     TYPE c          VALUE 'A',      "A
*              gc_b         TYPE c          VALUE 'B',      "B
*              gc_c         TYPE c          VALUE 'C',      "C
*              gc_d         TYPE c          VALUE 'D',      "D
      gc_e     TYPE c          VALUE 'E',      "E
*              gc_f         TYPE c          VALUE 'F',      "F
      gc_i     TYPE c          VALUE 'I',      "I
      gc_l     TYPE c          VALUE 'L',      "L
*              gc_m         TYPE vbtyp_n    VALUE 'M',      "M (Factura)
*              gc_n         TYPE c          VALUE 'N',      "N
      gc_s     TYPE c          VALUE 'S',      "S
*              gc_u         TYPE c          VALUE 'U',      "U
      gc_w     TYPE c          VALUE 'W',      "W
      gc_x     TYPE c          VALUE 'X',      "X
*              gc_z         TYPE vbsk-smart VALUE 'Z',
*              gc_ag        TYPE parvw      VALUE 'AG',     "Interlocutor AG Solicitante
*              gc_bt        TYPE char2      VALUE 'BT',     "BT
*              gc_co        TYPE land1      VALUE 'CO',     "CO
      gc_eq    TYPE char2      VALUE 'EQ'.     "EQ

*&---------------------------------------------------------------------*
*& Definición de Tipos
*&---------------------------------------------------------------------*
    TYPES:
      BEGIN OF tp_dyn_1000,
        pedido          TYPE char10,
        clase_documento TYPE char4,
        motivo_pedido   TYPE char4,
*        EBELN           TYPE ekko-EBELN,
        vbelp           TYPE vbak-vbeln,
        auart           TYPE vbak-auart,
        augru           TYPE vbak-augru,
        vkorg           TYPE vbak-vkorg,
        vtweg           TYPE vbak-vtweg,
        spart           TYPE vbak-spart,
        werks           TYPE vbap-werks,
        werkr           TYPE ekpo-werks,
        erdat           TYPE vbak-erdat,
        vdatu           TYPE vbak-vdatu,
        bstkd           TYPE vbkd-bstkd, "Orden de Compra
        repag           TYPE vbak-kunnr, "Responsable de pago
        encom           TYPE vbak-kunnr, "Encargado comercial
        ekgrp           TYPE ekko-ekgrp, "Grupo de compra
        vbele           TYPE likp-vbeln, "Entrega
        nguia           TYPE likp-zz1_numeroguia_dlh,
        vbelf           TYPE vbrk-vbeln, "Factura
        tknum           TYPE /scmtms/d_torrot-tor_id, "Numero Transporte
        fftp            TYPE vbak-erdat, "Fecha fin Transporte
      END OF tp_dyn_1000,

      tp_rn_vkorg TYPE RANGE OF tp_dyn_1000-vkorg,
      tp_rn_vtweg TYPE RANGE OF tp_dyn_1000-vtweg,
      tp_rn_spart TYPE RANGE OF tp_dyn_1000-spart,
      tp_rn_werks TYPE RANGE OF tp_dyn_1000-werks,
      tp_rn_werkr TYPE RANGE OF tp_dyn_1000-werkr,
      tp_rn_erdat TYPE RANGE OF tp_dyn_1000-erdat,
      tp_rn_auart TYPE RANGE OF tp_dyn_1000-auart,
      tp_rn_moped TYPE RANGE OF tp_dyn_1000-augru,
      tp_rn_vdatu TYPE RANGE OF tp_dyn_1000-vdatu,
      tp_rn_vbelp TYPE RANGE OF tp_dyn_1000-vbelp,
      tp_rn_bstkd TYPE RANGE OF tp_dyn_1000-bstkd,
      tp_rn_repag TYPE RANGE OF tp_dyn_1000-repag,
      tp_rn_encom TYPE RANGE OF tp_dyn_1000-encom,
      tp_rn_ekgrp TYPE RANGE OF tp_dyn_1000-ekgrp,
      tp_rn_vbele TYPE RANGE OF tp_dyn_1000-vbele,
      tp_rn_nguia TYPE RANGE OF tp_dyn_1000-nguia,
      tp_rn_vbelf TYPE RANGE OF tp_dyn_1000-vbelf,
      tp_rn_tknum TYPE RANGE OF tp_dyn_1000-tknum,
      tp_rn_fftp  TYPE RANGE OF tp_dyn_1000-fftp.

    DATA:
*          r_fecha_creacion_pedido TYPE tp_r_fecha,
      o_contenedor_msg TYPE REF TO /iwbep/if_message_container,
      rc               TYPE sysubrc.
*-------------------------------------------------------------------------------*
* Definición de Estructuras
*-------------------------------------------------------------------------------*
    DATA:
      es_bapiret2    TYPE bapiret2,      "Manjeo Log Errores
      es_dyn_1000    TYPE tp_dyn_1000,   "Criterios de Seleccion
      es_pedidos     TYPE zesdr1085_1,
      es_outdata     TYPE go_sdr1085_2->gtp_outtab,
      es_outdata_aux TYPE go_sdr1085_2->gtp_outtab,
      es_outdata_nxt TYPE go_sdr1085_2->gtp_outtab.

*-------------------------------------------------------------------------------*
* Definición de Tablas
*-------------------------------------------------------------------------------*
    DATA:
      ti_bapiterturn  TYPE bapiret2_tab,
*      ti_pedidos      TYPE zclsdr1085_monitor_pedidos=>gtp_ti_monito_pedidos,
      ti_pedidos      TYPE STANDARD TABLE OF zesdr1085_1,
      ti_outdata      TYPE STANDARD TABLE OF zclsdr1085_2_monitor_pedidos=>gtp_outtab,
      ti_outdata_aux  TYPE STANDARD TABLE OF go_sdr1085_2->gtp_outtab,
      ti_outdata_cons TYPE STANDARD TABLE OF go_sdr1085_2->gtp_outtab,

      ti_rn_ihrez     TYPE RANGE OF ekko-ihrez,
      ti_rn_vbeln     TYPE RANGE OF vbak-vbeln,
      ti_rn_vbeln_aux TYPE RANGE OF vbak-vbeln,
*      ti_rn_vbele       TYPE RANGE OF likp-vbeln,

      ti_rn_vkorg     TYPE tp_rn_vkorg,
      ti_rn_vtweg     TYPE tp_rn_vtweg,
      ti_rn_spart     TYPE tp_rn_spart,
      ti_rn_werks     TYPE tp_rn_werks,
      ti_rn_werkr     TYPE tp_rn_werkr,
      ti_rn_erdat     TYPE tp_rn_erdat,
      ti_rn_auart     TYPE tp_rn_auart,
      ti_rn_moped     TYPE tp_rn_moped,
      ti_rn_vdatu     TYPE tp_rn_vdatu,
      ti_rn_vbelp     TYPE tp_rn_vbelp,
      ti_rn_bstkd     TYPE tp_rn_bstkd,
      ti_rn_repag     TYPE tp_rn_repag,
      ti_rn_encom     TYPE tp_rn_encom,
      ti_rn_ekgrp     TYPE tp_rn_ekgrp,
      ti_rn_vbele     TYPE tp_rn_vbele,
      ti_rn_nguia     TYPE tp_rn_nguia,
      ti_rn_vbelf     TYPE tp_rn_vbelf,
      ti_rn_tknum     TYPE tp_rn_tknum,
      ti_rn_fftp      TYPE tp_rn_fftp.

*-------------------------------------------------------------------------------*
* Definicion de variables locales
*-------------------------------------------------------------------------------*
    DATA:
      message     TYPE msgli,  ".Manejo mesaje
      v_char255   TYPE char255,
      v_index     TYPE int4,
      v_index_nxt TYPE int4,
      v_vdatu     TYPE vbak-vdatu.

*-------------------------------------------------------------------------------*
* Definicion de Apuntadores de Memoria
*-------------------------------------------------------------------------------*
    FIELD-SYMBOLS:
          <fs_outdata> TYPE go_sdr1085_2->gtp_outtab.

    DATA(o_filtros) = io_tech_request_context->get_filter( ).
    DATA(ti_filtro_en_rango) = o_filtros->get_filter_select_options( ).
    DATA(str_filtro) = o_filtros->get_filter_string( ).
    DATA(o_monitor) = NEW zclsdr1085_monitor_pedidos(  ).

*    IF sy-uname EQ 'SRESTREV'.
*      CLEAR v_index.
*      WHILE v_index EQ 0.
*        v_index = v_index.
*      ENDWHILE.
*    ENDIF.

*    ti_rn_erdat           = CORRESPONDING tp_r_fecha( VALUE #( ti_filtro_en_rango[ property = 'FECHA_CREACION_PEDIDO' ]-select_options OPTIONAL ) ).
    ti_rn_vbelp  = CORRESPONDING tp_rn_vbelp( VALUE #( ti_filtro_en_rango[ property = 'PEDIDO' ]-select_options OPTIONAL ) ).
    ti_rn_vkorg  = CORRESPONDING tp_rn_vkorg( VALUE #( ti_filtro_en_rango[ property = 'VKORG' ]-select_options OPTIONAL ) ).
    ti_rn_vtweg  = CORRESPONDING tp_rn_vtweg( VALUE #( ti_filtro_en_rango[ property = 'VTWEG' ]-select_options OPTIONAL ) ).
    ti_rn_werks  = CORRESPONDING tp_rn_werks( VALUE #( ti_filtro_en_rango[ property = 'WERKS' ]-select_options OPTIONAL ) ).
    ti_rn_erdat  = CORRESPONDING tp_rn_erdat( VALUE #( ti_filtro_en_rango[ property = 'FECHA_CREACION_PEDIDO' ]-select_options OPTIONAL ) ).
    ti_rn_auart  = CORRESPONDING tp_rn_auart( VALUE #( ti_filtro_en_rango[ property = 'CLASE_DOCUMENTO' ]-select_options OPTIONAL ) ).
    ti_rn_bstkd  = CORRESPONDING tp_rn_bstkd( VALUE #( ti_filtro_en_rango[ property = 'PEDIDO_CLIENTE' ]-select_options OPTIONAL ) ).
    ti_rn_vbele  = CORRESPONDING tp_rn_vbele( VALUE #( ti_filtro_en_rango[ property = 'ENTREGA' ]-select_options OPTIONAL ) ).
    ti_rn_werkr  = CORRESPONDING tp_rn_werkr( VALUE #( ti_filtro_en_rango[ property = 'CENTRO_RECEPTOR' ]-select_options OPTIONAL ) ).          ".Centro Receptor
    ti_rn_vdatu  = CORRESPONDING tp_rn_vdatu( VALUE #( ti_filtro_en_rango[ property = 'FECHA_PREFERENTE_ENTREGA' ]-select_options OPTIONAL ) ). ".Fecha Preferencte de entrega
    ti_rn_repag  = CORRESPONDING tp_rn_repag( VALUE #( ti_filtro_en_rango[ property = 'RESPONSABLE_PAGO' ]-select_options OPTIONAL ) ).         ".Responsable de Pago
    ti_rn_ekgrp  = CORRESPONDING tp_rn_ekgrp( VALUE #( ti_filtro_en_rango[ property = 'GRUPO_COMPRA' ]-select_options OPTIONAL ) ).             ".Grupo Compra

    LOOP AT ti_rn_vbelp ASSIGNING FIELD-SYMBOL(<fs_rn_vbelp>).
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = <fs_rn_vbelp>-low
        IMPORTING
          output = <fs_rn_vbelp>-low.

      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = <fs_rn_vbelp>-high
        IMPORTING
          output = <fs_rn_vbelp>-high.
    ENDLOOP.

    LOOP AT ti_rn_vbele ASSIGNING FIELD-SYMBOL(<fs_rn_vbele>).
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = <fs_rn_vbele>-low
        IMPORTING
          output = <fs_rn_vbele>-low.

      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = <fs_rn_vbele>-high
        IMPORTING
          output = <fs_rn_vbele>-high.
    ENDLOOP.

    IF 'ant' NE 'ant'.
      IF ti_filtro_en_rango IS NOT INITIAL.
        "Trabajar con Fechas/Hora en ODATA
        "Filtrar Odata con fecha Fecha:/ZSDAPI_MONITOR_PEDIDOS_SRV/PedidosSet?$filter=FechaCreacionPedido eq datetime'2017-04-15T00:00:00'&$format=json
        "Error: Property 'FechaLiberacion' has invalid value '00000000' : Seleccior la opcion NULLABLE para los campos tipo datetime en el servicio Odata
        ti_rn_erdat = CORRESPONDING tp_rn_erdat( VALUE #( ti_filtro_en_rango[ property = 'FECHA_CREACION_PEDIDO' ]-select_options OPTIONAL ) ).
        ti_rn_vdatu = CORRESPONDING tp_rn_vdatu( VALUE #( ti_filtro_en_rango[ property = 'FECHA_PREFERENTE_ENTREGA' ]-select_options OPTIONAL ) ). ".Fecha Preferencte de entrega

        ti_pedidos =
        o_monitor->generar_monitor_pedidos_venta( EXPORTING
                                                    i_r_vbelp           = VALUE #( ti_filtro_en_rango[ property = 'PEDIDO' ]-select_options OPTIONAL )
                                                    i_r_vkorg           = VALUE #( ti_filtro_en_rango[ property = 'VKORG' ]-select_options OPTIONAL )
                                                    i_r_vtweg           = VALUE #( ti_filtro_en_rango[ property = 'VTWEG' ]-select_options OPTIONAL )
                                                    i_r_werks           = VALUE #( ti_filtro_en_rango[ property = 'WERKS' ]-select_options OPTIONAL )
                                                    i_r_erdat           = ti_rn_erdat
                                                    i_r_auart           = VALUE #( ti_filtro_en_rango[ property = 'CLASE_DOCUMENTO' ]-select_options OPTIONAL )
                                                    i_r_vdatu           = ti_rn_vdatu                                                                                 ".adicion Jose Miguel Valencia 28.08.2024
                                                    i_r_bstnk           = VALUE #( ti_filtro_en_rango[ property = 'PEDIDO_CLIENTE' ]-select_options OPTIONAL )
                                                    i_r_ekgrp           = VALUE #( ti_filtro_en_rango[ property = 'GRUPO_COMPRA' ]-select_options OPTIONAL )          ".adicion Jose Miguel Valencia 28.08.2024
                                                    i_r_responsable_de_pago = VALUE #( ti_filtro_en_rango[ property = 'RESPONSABLE_PAGO' ]-select_options OPTIONAL )  ".adicion Jose Miguel Valencia 28.08.2024
                                                    i_r_vbele           = VALUE #( ti_filtro_en_rango[ property = 'ENTREGA' ]-select_options OPTIONAL )
                                                    i_detalllado        = abap_true
                                                    i_retornar_mensajes = abap_true
                                                  IMPORTING
                                                    e_rc                = rc
                                                ).

        APPEND LINES OF
        o_monitor->generar_monitor_pedidotraslado( EXPORTING
                                                        i_r_vbelp           = VALUE #( ti_filtro_en_rango[ property = 'PEDIDO' ]-select_options OPTIONAL )
                                                        i_r_vkorg           = VALUE #( ti_filtro_en_rango[ property = 'VKORG' ]-select_options OPTIONAL )
                                                        i_r_vtweg           = VALUE #( ti_filtro_en_rango[ property = 'VTWEG' ]-select_options OPTIONAL )
                                                        i_r_werks           = VALUE #( ti_filtro_en_rango[ property = 'WERKS' ]-select_options OPTIONAL )
                                                        i_r_centro_receptor = VALUE #( ti_filtro_en_rango[ property = 'CENTRO_RECEPTOR' ]-select_options OPTIONAL ) ".adicion Jose Miguel Valencia 28.08.2024
                                                        i_r_erdat           = ti_rn_erdat
                                                        i_r_auart           = VALUE #( ti_filtro_en_rango[ property = 'CLASE_DOCUMENTO' ]-select_options OPTIONAL )
                                                        i_r_vdatu           = ti_rn_vdatu                                                                               ".adicion Jose Miguel Valencia 28.08.2024
                                                        i_r_bstnk           = VALUE #( ti_filtro_en_rango[ property = 'PEDIDO_CLIENTE' ]-select_options OPTIONAL )
                                                        i_r_responsable_de_pago = VALUE #( ti_filtro_en_rango[ property = 'RESPONSABLE_PAGO' ]-select_options OPTIONAL ) ".adicion Jose Miguel Valencia 28.08.2024
                                                        i_r_ekgrp           = VALUE #( ti_filtro_en_rango[ property = 'GRUPO_COMPRA' ]-select_options OPTIONAL )         ".adicion Jose Miguel Valencia 28.08.2024
                                                        i_r_vbele           = VALUE #( ti_filtro_en_rango[ property = 'ENTREGA' ]-select_options OPTIONAL )
                                                        i_detalllado        = abap_true
                                                        i_retornar_mensajes = abap_true
                                                    IMPORTING
                                                        e_rc                = rc
                                           )
          TO ti_pedidos.

      ENDIF.

      LOOP AT ti_pedidos ASSIGNING FIELD-SYMBOL(<fs_es_pedido>).
        IF <fs_es_pedido>-fecha_entrega_cliente IS NOT INITIAL AND
           <fs_es_pedido>-fecha_entrega_cliente(2) NE '20'.
          CLEAR: <fs_es_pedido>-fecha_entrega_cliente.
        ENDIF.
      ENDLOOP.

      CREATE DATA er_entityset TYPE zclsdapi_monitor_pedidos_mpc=>tt_pedidos.
      ASSIGN er_entityset->* TO FIELD-SYMBOL(<fs_ti_pedidos>).

      <fs_ti_pedidos> =  CORRESPONDING zclsdapi_monitor_pedidos_mpc=>tt_pedidos( ti_pedidos ).

      DATA(o_log) = zclcxr1002_log_aplicacion=>get_instancia( ).
      DATA(ti_log) = o_log->get_log( ).

      IF ti_log IS NOT INITIAL.
        "Retorna Status 400 con mensaje en body
        me->/iwbep/if_sb_dpc_comm_services~rfc_save_log(  EXPORTING
                                                            iv_entity_type = iv_entity_name
                                                            it_return = ti_log
                                                            it_key_tab = it_key_tab ).
        "Retorna Status 200 con mensaje en header del response
        o_contenedor_msg = me->mo_context->get_message_container( ).
        LOOP AT ti_log ASSIGNING FIELD-SYMBOL(<fs_es_mensaje>).

          o_contenedor_msg->add_message( iv_msg_type    = <fs_es_mensaje>-type
                                         iv_msg_id      = <fs_es_mensaje>-id
                                         iv_msg_number  = <fs_es_mensaje>-number
                                         iv_msg_text    = <fs_es_mensaje>-message
                                         iv_msg_v1      = <fs_es_mensaje>-message_v1
                                         iv_msg_v2      = <fs_es_mensaje>-message_v2
                                         iv_msg_v3      = <fs_es_mensaje>-message_v3
                                         iv_msg_v4      = <fs_es_mensaje>-message_v4
                                         iv_add_to_response_header = abap_true
                                       ).

        ENDLOOP.
      ENDIF.
    ENDIF.

**********************************************************************
**********************************************************************
***NOTA: SI llegan a cambiar esta logica en el programa ZSDR1085_2
*        debera tomarse y reeemplazarce en este servicio tal cual
*        con la logica del metodo  me->get_data( de dicho programa
**********************************************************************
    ti_rn_ihrez = CORRESPONDING #( ti_rn_bstkd[] MAPPING sign = sign option = option low = low high = high ).

    "Consultar datos a nivel de Transporte (COMUN PARA SD y MM)
    IF ti_rn_tknum IS NOT INITIAL.
      SELECT DISTINCT 'I' AS sign, 'EQ' AS option, substring( tr~btd_id, 26, 10 ) AS low
        FROM /scmtms/d_torrot AS tk
       INNER JOIN /scmtms/d_tordrf AS tr ON tr~parent_key = tk~db_key
       WHERE tk~tor_cat  EQ 'TO'
         AND tk~tor_id   IN @ti_rn_tknum
        INTO TABLE @ti_rn_vbele.
    ENDIF.

**********************************************************************
************************        VENTAS       *************************
**********************************************************************
    "Consultar datos a nivel de pedido
    IF ti_rn_vbelp IS INITIAL.
      IF ti_rn_erdat IS NOT INITIAL OR
         ti_rn_vkorg IS NOT INITIAL OR
         ti_rn_werks IS NOT INITIAL.
        "Selección en VBAK Cabecera de Pedidos
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, vbak~vbeln AS low
          FROM vbak
         INNER JOIN vbap ON vbak~vbeln EQ vbap~vbeln
         INNER JOIN vbpa ON vbak~vbeln EQ vbpa~vbeln
         WHERE vbak~erdat IN @ti_rn_erdat
           AND vbak~auart IN @ti_rn_auart
           AND vbak~vkorg IN @ti_rn_vkorg
           AND vbak~spart IN @ti_rn_spart
           AND vbak~vdatu IN @ti_rn_vdatu
           AND vbak~augru IN @ti_rn_moped
           AND vbpa~parvw EQ 'RG'
           AND vbpa~kunnr IN @ti_rn_repag
           AND vbak~augru IN @ti_rn_moped
           AND vbap~werks IN @ti_rn_werks
          INTO TABLE @ti_rn_vbeln.
      ENDIF.
    ELSE.
      "Selección en VBAK Cabecera de Pedidos
      SELECT DISTINCT 'I' AS sign, 'EQ' AS option, vbak~vbeln AS low
        FROM vbak
       INNER JOIN vbap ON vbak~vbeln EQ vbap~vbeln
       INNER JOIN vbpa ON vbak~vbeln EQ vbpa~vbeln
       WHERE vbak~vbeln IN @ti_rn_vbelp
         AND vbak~erdat IN @ti_rn_erdat
         AND vbak~auart IN @ti_rn_auart
         AND vbak~vkorg IN @ti_rn_vkorg
         AND vbak~spart IN @ti_rn_spart
         AND vbak~vdatu IN @ti_rn_vdatu
         AND vbak~augru IN @ti_rn_moped
         AND vbpa~parvw EQ 'RG'
         AND vbpa~kunnr IN @ti_rn_repag
         AND vbap~werks IN @ti_rn_werks
        INTO TABLE @ti_rn_vbeln.
    ENDIF.

    "Consultar datos a nivel de OC
    IF ti_rn_bstkd IS NOT INITIAL.
      SORT ti_rn_vbeln BY low.
      DELETE ADJACENT DUPLICATES FROM ti_rn_vbeln COMPARING low.
      "NOTA: Se debe condicionar de esta forma porque sino saca DUMP DBSQL_STMNT_TOO_LARGE  CX_SY_OPEN_SQL_DB
      IF lines( ti_rn_vbeln ) GT 6000.
        "Selección en VBAK Cabecera de Pedidos
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, vbak~vbeln AS low
          FROM vbkd
         INNER JOIN @ti_rn_vbeln AS vb ON vb~low EQ vbkd~vbeln
         INNER JOIN vbak ON vbak~vbeln EQ vb~low
         INNER JOIN vbap ON vbap~vbeln EQ vbak~vbeln
         INNER JOIN vbpa ON vbak~vbeln EQ vbpa~vbeln
         WHERE vbkd~bstkd IN @ti_rn_bstkd
           AND vbak~erdat IN @ti_rn_erdat
           AND vbak~auart IN @ti_rn_auart
           AND vbak~vkorg IN @ti_rn_vkorg
           AND vbak~spart IN @ti_rn_spart
           AND vbak~vdatu IN @ti_rn_vdatu
*           AND vbak~kunnr IN @ti_rn_repag
           AND vbak~augru IN @ti_rn_moped
           AND vbpa~parvw EQ 'RG'
           AND vbpa~kunnr IN @ti_rn_repag
           AND vbap~werks IN @ti_rn_werks
          INTO TABLE @ti_rn_vbeln.
      ELSE.
        "Selección en VBAK Cabecera de Pedidos
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, vbak~vbeln AS low
          FROM vbkd
         INNER JOIN vbak ON vbak~vbeln EQ vbkd~vbeln
         INNER JOIN vbap ON vbap~vbeln EQ vbkd~vbeln
         INNER JOIN vbpa ON vbak~vbeln EQ vbpa~vbeln
         WHERE vbkd~bstkd IN @ti_rn_bstkd
           AND vbak~vbeln IN @ti_rn_vbeln
           AND vbak~erdat IN @ti_rn_erdat
           AND vbak~auart IN @ti_rn_auart
           AND vbak~vkorg IN @ti_rn_vkorg
           AND vbak~spart IN @ti_rn_spart
           AND vbak~vdatu IN @ti_rn_vdatu
*           AND vbak~kunnr IN @ti_rn_repag
           AND vbak~augru IN @ti_rn_moped
           AND vbpa~parvw EQ 'RG'
           AND vbpa~kunnr IN @ti_rn_repag
           AND vbap~werks IN @ti_rn_werks
          INTO TABLE @ti_rn_vbeln.
      ENDIF.
    ENDIF.

    "Consultar datos a nivel de Entrega
    IF ti_rn_vbele IS NOT INITIAL    OR
       ti_rn_vbele IS NOT INITIAL OR
       ti_rn_nguia IS NOT INITIAL.
      SORT ti_rn_vbeln BY low.
      DELETE ADJACENT DUPLICATES FROM ti_rn_vbeln COMPARING low.

      APPEND LINES OF ti_rn_vbele TO ti_rn_vbele.
      SORT ti_rn_vbele.
      DELETE ADJACENT DUPLICATES FROM ti_rn_vbele COMPARING ALL FIELDS.

      "NOTA: Se debe condicionar de esta forma porque sino saca DUMP DBSQL_STMNT_TOO_LARGE  CX_SY_OPEN_SQL_DB
      IF lines( ti_rn_vbeln ) GT 6000.
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, vbak~vbeln AS low
          FROM likp
         INNER JOIN lips ON lips~vbeln EQ likp~vbeln
*         INNER JOIN likp ON lips~vbeln EQ likp~vbeln
         INNER JOIN @ti_rn_vbeln AS vb ON vb~low EQ lips~vgbel
         INNER JOIN vbak ON vbak~vbeln EQ vb~low
         INNER JOIN vbap ON vbap~vbeln EQ vbak~vbeln
         INNER JOIN vbpa ON vbak~vbeln EQ vbpa~vbeln
         INNER JOIN vbkd ON vbkd~vbeln EQ vbak~vbeln
         WHERE likp~vbeln IN @ti_rn_vbele
           AND vbkd~bstkd IN @ti_rn_bstkd
*           AND vbak~vbeln IN @ti_rn_vbeln
           AND vbak~erdat IN @ti_rn_erdat
           AND vbak~auart IN @ti_rn_auart
           AND vbak~vkorg IN @ti_rn_vkorg
           AND vbak~spart IN @ti_rn_spart
           AND vbak~vdatu IN @ti_rn_vdatu
*           AND vbak~kunnr IN @ti_rn_repag
           AND vbak~augru IN @ti_rn_moped
           AND vbpa~parvw EQ 'RG'
           AND vbpa~kunnr IN @ti_rn_repag
           AND vbap~werks IN @ti_rn_werks
           AND likp~zz1_numeroguia_dlh IN @ti_rn_nguia
          INTO TABLE @ti_rn_vbeln.
      ELSE.
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, vbak~vbeln AS low
          FROM likp
         INNER JOIN lips ON lips~vbeln EQ likp~vbeln
         INNER JOIN vbak ON vbak~vbeln EQ lips~vgbel
         INNER JOIN vbap ON vbap~vbeln EQ vbak~vbeln
         INNER JOIN vbpa ON vbak~vbeln EQ vbpa~vbeln
         INNER JOIN vbkd ON vbkd~vbeln EQ vbak~vbeln
         WHERE likp~vbeln IN @ti_rn_vbele
           AND vbkd~bstkd IN @ti_rn_bstkd
           AND vbak~vbeln IN @ti_rn_vbeln
           AND vbak~erdat IN @ti_rn_erdat
           AND vbak~auart IN @ti_rn_auart
           AND vbak~vkorg IN @ti_rn_vkorg
           AND vbak~spart IN @ti_rn_spart
           AND vbak~vdatu IN @ti_rn_vdatu
*           AND vbak~kunnr IN @ti_rn_repag
           AND vbak~augru IN @ti_rn_moped
           AND vbpa~parvw EQ 'RG'
           AND vbpa~kunnr IN @ti_rn_repag
           AND vbap~werks IN @ti_rn_werks
           AND likp~zz1_numeroguia_dlh IN @ti_rn_nguia
          INTO TABLE @ti_rn_vbeln.
      ENDIF.
    ENDIF.

    "Consultar datos a nivel de Factura
    IF ti_rn_vbelf IS NOT INITIAL.
      SORT ti_rn_vbeln BY low.
      DELETE ADJACENT DUPLICATES FROM ti_rn_vbeln COMPARING low.

      "NOTA: Se debe condicionar de esta forma porque sino saca DUMP DBSQL_STMNT_TOO_LARGE  CX_SY_OPEN_SQL_DB
      IF lines( ti_rn_vbeln ) GT 6000.
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, vbak~vbeln AS low
          FROM vbrk
         INNER JOIN vbrp ON vbrp~vbeln EQ vbrk~vbeln
         INNER JOIN likp ON likp~vbeln EQ vbrp~vgbel
         INNER JOIN lips ON lips~vbeln EQ likp~vbeln
         INNER JOIN @ti_rn_vbeln AS vb ON vb~low EQ vbrp~aubel
         INNER JOIN vbak ON vbak~vbeln EQ vb~low
         INNER JOIN vbap ON vbap~vbeln EQ vbak~vbeln
         INNER JOIN vbpa ON vbak~vbeln EQ vbpa~vbeln
         INNER JOIN vbkd ON vbkd~vbeln EQ vbak~vbeln
         WHERE vbrk~vbeln IN @ti_rn_vbelf
           AND likp~vbeln IN @ti_rn_vbele
           AND vbkd~bstkd IN @ti_rn_bstkd
*         AND vbak~vbeln IN @ti_rn_vbeln
           AND vbak~erdat IN @ti_rn_erdat
           AND vbak~auart IN @ti_rn_auart
           AND vbak~vkorg IN @ti_rn_vkorg
           AND vbak~spart IN @ti_rn_spart
           AND vbak~vdatu IN @ti_rn_vdatu
*           AND vbak~kunnr IN @ti_rn_repag
           AND vbak~augru IN @ti_rn_moped
           AND vbpa~parvw EQ 'RG'
           AND vbpa~kunnr IN @ti_rn_repag
           AND vbap~werks IN @ti_rn_werks
           AND likp~zz1_numeroguia_dlh IN @ti_rn_nguia
          INTO TABLE @ti_rn_vbeln.
      ELSE.
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, vbak~vbeln AS low
          FROM vbrk
         INNER JOIN vbrp ON vbrp~vbeln EQ vbrk~vbeln
         INNER JOIN likp ON likp~vbeln EQ vbrp~vgbel
         INNER JOIN lips ON lips~vbeln EQ likp~vbeln
         INNER JOIN vbak ON vbak~vbeln EQ vbrp~aubel
         INNER JOIN vbap ON vbap~vbeln EQ vbak~vbeln
         INNER JOIN vbpa ON vbak~vbeln EQ vbpa~vbeln
         INNER JOIN vbkd ON vbkd~vbeln EQ vbak~vbeln
         WHERE vbrk~vbeln IN @ti_rn_vbelf
           AND likp~vbeln IN @ti_rn_vbele
           AND vbkd~bstkd IN @ti_rn_bstkd
           AND vbak~vbeln IN @ti_rn_vbeln
           AND vbak~erdat IN @ti_rn_erdat
           AND vbak~auart IN @ti_rn_auart
           AND vbak~vkorg IN @ti_rn_vkorg
           AND vbak~spart IN @ti_rn_spart
           AND vbak~vdatu IN @ti_rn_vdatu
*           AND vbak~kunnr IN @ti_rn_repag
           AND vbak~augru IN @ti_rn_moped
           AND vbpa~parvw EQ 'RG'
           AND vbpa~kunnr IN @ti_rn_repag
           AND vbap~werks IN @ti_rn_werks
           AND likp~zz1_numeroguia_dlh IN @ti_rn_nguia
          INTO TABLE @ti_rn_vbeln.
      ENDIF.
    ENDIF.

**********************************************************************
************************      TRASLADOS      *************************
**********************************************************************
    ti_rn_vbeln_aux = ti_rn_vbeln.
    "Consultar datos a nivel de pedido traslado
    IF ti_rn_vbelp IS INITIAL.
      IF ti_rn_vkorg IS NOT INITIAL OR
         ti_rn_vtweg IS NOT INITIAL OR
         ti_rn_spart IS NOT INITIAL .
        "Selección en EKKO Cabecera de Pedidos
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, ekko~ebeln AS low
          FROM ekko
         INNER JOIN ekpv ON ekko~ebeln EQ ekpv~ebeln
         INNER JOIN ekpo ON ekko~ebeln EQ ekpo~ebeln
         WHERE ekko~aedat IN @ti_rn_erdat
           AND ekko~reswk IN @ti_rn_werks
           AND ekko~bsart IN @ti_rn_auart
           AND ekko~ekgrp IN @ti_rn_ekgrp
           AND ekko~ihrez IN @ti_rn_ihrez
           AND ekpv~vkorg IN @ti_rn_vkorg
           AND ekpv~vtweg IN @ti_rn_vtweg
           AND ekpv~spart IN @ti_rn_spart
           AND ekpo~werks IN @ti_rn_werkr
          INTO TABLE @ti_rn_vbeln.
      ELSE.
        "Selección en EKKO Cabecera de Pedidos
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, ekko~ebeln AS low
          FROM ekko
         INNER JOIN ekpo ON ekko~ebeln EQ ekpo~ebeln
         WHERE ekko~aedat IN @ti_rn_erdat
           AND ekko~reswk IN @ti_rn_werks
           AND ekko~bsart IN @ti_rn_auart
           AND ekko~ekgrp IN @ti_rn_ekgrp
           AND ekko~ihrez IN @ti_rn_ihrez
           AND ekpo~werks IN @ti_rn_werkr
          INTO TABLE @ti_rn_vbeln.
      ENDIF.
    ELSE.
      IF ti_rn_vkorg IS NOT INITIAL OR
         ti_rn_vtweg IS NOT INITIAL OR
         ti_rn_spart IS NOT INITIAL .
        "Selección en EKKO Cabecera de Pedidos
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, ekko~ebeln AS low
          FROM ekko
         INNER JOIN ekpv ON ekko~ebeln EQ ekpv~ebeln
         INNER JOIN ekpo ON ekko~ebeln EQ ekpo~ebeln
         WHERE ekko~ebeln IN @ti_rn_vbelp
           AND ekko~aedat IN @ti_rn_erdat
           AND ekko~reswk IN @ti_rn_werks
           AND ekko~bsart IN @ti_rn_auart
           AND ekko~ekgrp IN @ti_rn_ekgrp
           AND ekko~ihrez IN @ti_rn_ihrez
           AND ekpv~vkorg IN @ti_rn_vkorg
           AND ekpv~vtweg IN @ti_rn_vtweg
           AND ekpv~spart IN @ti_rn_spart
           AND ekpo~werks IN @ti_rn_werkr
          INTO TABLE @ti_rn_vbeln.
      ELSE.
        "Selección en EKKO Cabecera de Pedidos
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, ekko~ebeln AS low
          FROM ekko
         INNER JOIN ekpo ON ekko~ebeln EQ ekpo~ebeln
         WHERE ekko~ebeln IN @ti_rn_vbelp
           AND ekko~aedat IN @ti_rn_erdat
           AND ekko~reswk IN @ti_rn_werks
           AND ekko~bsart IN @ti_rn_auart
           AND ekko~ekgrp IN @ti_rn_ekgrp
           AND ekko~ihrez IN @ti_rn_ihrez
           AND ekpo~werks IN @ti_rn_werkr
          INTO TABLE @ti_rn_vbeln.
      ENDIF.
    ENDIF.

    "Consultar datos a nivel de Entrega
    IF ti_rn_vbele IS NOT INITIAL    OR
       ti_rn_vbele IS NOT INITIAL OR
       ti_rn_nguia    IS NOT INITIAL.
      APPEND LINES OF ti_rn_vbele TO ti_rn_vbele.
      SORT ti_rn_vbele.
      DELETE ADJACENT DUPLICATES FROM ti_rn_vbele COMPARING ALL FIELDS.
      "NOTA: Se debe condicionar de esta forma porque sino saca DUMP DBSQL_STMNT_TOO_LARGE  CX_SY_OPEN_SQL_DB
      IF lines( ti_rn_vbeln ) GT 6000.
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, ekko~ebeln AS low
          FROM lips
         INNER JOIN likp ON likp~vbeln EQ lips~vbeln
         INNER JOIN @ti_rn_vbeln AS vb ON vb~low EQ lips~vgbel
         INNER JOIN ekko ON ekko~ebeln EQ vb~low
         INNER JOIN ekpo ON ekko~ebeln EQ ekpo~ebeln
         WHERE likp~vbeln IN @ti_rn_vbele
*         AND ekko~ebeln IN @ti_rn_vbeln
           AND ekko~aedat IN @ti_rn_erdat
           AND ekko~reswk IN @ti_rn_werks
           AND ekko~bsart IN @ti_rn_auart
           AND ekko~ekgrp IN @ti_rn_ekgrp
           AND ekko~ihrez IN @ti_rn_bstkd
           AND ekpo~werks IN @ti_rn_werkr
           AND likp~zz1_numeroguia_dlh IN @ti_rn_nguia
          INTO TABLE @ti_rn_vbeln.
      ELSE.
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, ekko~ebeln AS low
          FROM lips
         INNER JOIN likp ON likp~vbeln EQ lips~vbeln
         INNER JOIN ekko ON ekko~ebeln EQ lips~vgbel
         INNER JOIN ekpo ON ekko~ebeln EQ ekpo~ebeln
         WHERE likp~vbeln IN @ti_rn_vbele
           AND ekko~ebeln IN @ti_rn_vbeln
           AND ekko~aedat IN @ti_rn_erdat
           AND ekko~reswk IN @ti_rn_werks
           AND ekko~bsart IN @ti_rn_auart
           AND ekko~ekgrp IN @ti_rn_ekgrp
           AND ekko~ihrez IN @ti_rn_bstkd
           AND ekpo~werks IN @ti_rn_werkr
           AND likp~zz1_numeroguia_dlh IN @ti_rn_nguia
          INTO TABLE @ti_rn_vbeln.
      ENDIF.
    ENDIF.

    "Consultar datos a nivel de Factura
    IF ti_rn_vbelf IS NOT INITIAL.
      SORT ti_rn_vbeln BY low.
      DELETE ADJACENT DUPLICATES FROM ti_rn_vbeln COMPARING low.
      "NOTA: Se debe condicionar de esta forma porque sino saca DUMP DBSQL_STMNT_TOO_LARGE  CX_SY_OPEN_SQL_DB
      IF lines( ti_rn_vbeln ) GT 6000.
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, ekko~ebeln AS low
          FROM vbrk
         INNER JOIN vbrp ON vbrp~vbeln EQ vbrk~vbeln
         INNER JOIN likp ON likp~vbeln EQ vbrp~vgbel
         INNER JOIN lips ON lips~vbeln EQ likp~vbeln
         INNER JOIN @ti_rn_vbeln AS vb ON vb~low EQ lips~vgbel
         INNER JOIN ekko ON ekko~ebeln EQ vb~low
         INNER JOIN ekpo ON ekko~ebeln EQ ekpo~ebeln
         WHERE likp~vbeln IN @ti_rn_vbele
*         AND ekko~ebeln IN @ti_rn_vbeln
           AND ekko~aedat IN @ti_rn_erdat
           AND ekko~reswk IN @ti_rn_werks
           AND ekko~bsart IN @ti_rn_auart
           AND ekko~ekgrp IN @ti_rn_ekgrp
           AND ekko~ihrez IN @ti_rn_bstkd
           AND ekpo~werks IN @ti_rn_werkr
           AND likp~zz1_numeroguia_dlh IN @ti_rn_nguia
          INTO TABLE @ti_rn_vbeln.
      ELSE.
        SELECT DISTINCT 'I' AS sign, 'EQ' AS option, ekko~ebeln AS low
          FROM vbrk
         INNER JOIN vbrp ON vbrp~vbeln EQ vbrk~vbeln
         INNER JOIN likp ON likp~vbeln EQ vbrp~vgbel
         INNER JOIN lips ON lips~vbeln EQ likp~vbeln
         INNER JOIN ekko ON ekko~ebeln EQ lips~vgbel
         INNER JOIN ekpo ON ekko~ebeln EQ ekpo~ebeln
         WHERE likp~vbeln IN @ti_rn_vbele
           AND ekko~ebeln IN @ti_rn_vbeln
           AND ekko~aedat IN @ti_rn_erdat
           AND ekko~reswk IN @ti_rn_werks
           AND ekko~bsart IN @ti_rn_auart
           AND ekko~ekgrp IN @ti_rn_ekgrp
           AND ekko~ihrez IN @ti_rn_bstkd
           AND ekpo~werks IN @ti_rn_werkr
           AND likp~zz1_numeroguia_dlh IN @ti_rn_nguia
          INTO TABLE @ti_rn_vbeln.
      ENDIF.
    ENDIF.

    IF ti_rn_vbeln_aux IS NOT INITIAL.
      APPEND LINES OF ti_rn_vbeln_aux TO ti_rn_vbeln.
    ENDIF.
    SORT ti_rn_vbeln.
    DELETE ADJACENT DUPLICATES FROM ti_rn_vbeln COMPARING ALL FIELDS.

    IF ti_rn_vbeln IS INITIAL.
      CLEAR es_bapiret2.
      "No se encontraron datos con los criterios de búsqueda
      MESSAGE e008(zcx01) INTO message.
      es_bapiret2-type        = gc_e.          ".Tipo mensaje: S Success, E Error, W Warning, I Info A Abort
      es_bapiret2-id          = gc_zcx01.      ".Clase de mensajes
      es_bapiret2-number      = gc_8.         ".Número de mensaje
      es_bapiret2-message     = message.      ".Texto de mensaje.
*    es_bapiret2-message_v1  = es_likp-vbeln.  ".Variable de mensaje
      ".Adicionar Registro al Log
      APPEND es_bapiret2 TO ti_bapiterturn.
      "Retorna Status 400 con mensaje en body
      me->/iwbep/if_sb_dpc_comm_services~rfc_save_log(  EXPORTING
                                                          iv_entity_type  = iv_entity_name
                                                          it_return       = ti_bapiterturn
                                                          it_key_tab      = it_key_tab ).
      "Retorna Status 200 con mensaje en header del response
      o_contenedor_msg = me->mo_context->get_message_container( ).
*        LOOP AT ti_bapiterturn ASSIGNING FIELD-SYMBOL(<fs_es_mensaje>).
      LOOP AT ti_bapiterturn INTO es_bapiret2.

        o_contenedor_msg->add_message( iv_msg_type    = es_bapiret2-type
                                       iv_msg_id      = es_bapiret2-id
                                       iv_msg_number  = es_bapiret2-number
                                       iv_msg_text    = es_bapiret2-message
                                       iv_msg_v1      = es_bapiret2-message_v1
                                       iv_msg_v2      = es_bapiret2-message_v2
                                       iv_msg_v3      = es_bapiret2-message_v3
                                       iv_msg_v4      = es_bapiret2-message_v4
                                       iv_add_to_response_header = abap_true
                                     ).

      ENDLOOP.
      RETURN.
    ENDIF.

    CREATE OBJECT go_sdr1085_2.
    CALL METHOD go_sdr1085_2->get_data
      EXPORTING
        i_ti_vbeln = ti_rn_vbeln.

    IF go_sdr1085_2->gti_vbap IS INITIAL AND
       go_sdr1085_2->gti_ekpo IS INITIAL.
      CLEAR es_bapiret2.
      "No se encontraron datos con los criterios de búsqueda
      MESSAGE e008(zcx01) INTO message.
      es_bapiret2-type        = gc_e.          ".Tipo mensaje: S Success, E Error, W Warning, I Info A Abort
      es_bapiret2-id          = gc_zcx01.      ".Clase de mensajes
      es_bapiret2-number      = gc_8.         ".Número de mensaje
      es_bapiret2-message     = message.      ".Texto de mensaje.
*    es_bapiret2-message_v1  = es_likp-vbeln.  ".Variable de mensaje
      ".Adicionar Registro al Log
      APPEND es_bapiret2 TO ti_bapiterturn.
    ENDIF.


    CALL METHOD go_sdr1085_2->set_data
      CHANGING
        c_ti_outtab = ti_outdata.

*    CLEAR go_sdr1085_2. "Limpiar datos para liberar memoria

    LOOP AT ti_outdata INTO es_outdata.

***      IF pa_mtftl IS NOT INITIAL. "Excluir Material Flete
      IF go_sdr1085_2->ges_param_app-ti_rn_ped_matflt IS NOT INITIAL AND
         es_outdata-pstyv IN go_sdr1085_2->ges_param_app-ti_rn_ped_matflt.
        CONTINUE.
      ENDIF.
***      ENDIF.

***      IF pa_ppent IS NOT INITIAL."Pedidos pendientes
***        IF es_outdata-gbstk EQ go_sdr1085_2->gc_c.
***          CONTINUE.
***        ENDIF.
***      ENDIF.

***      IF pa_unest IS NOT INITIAL."Unidad de Medida Estadística
***        CALL METHOD set_um_estatica
***          CHANGING
***            c_es_outtab = es_outdata.
***      ENDIF.

      "Clase Pedido
      IF ti_rn_auart[] IS NOT INITIAL AND
         es_outdata-auart NOT IN ti_rn_auart.
        CONTINUE.
      ENDIF.

      "Referencia cliente
      IF ti_rn_bstkd[] IS NOT INITIAL AND
         es_outdata-bstkd NOT IN ti_rn_bstkd.
        CONTINUE.
      ENDIF.
      "Grupo de compras
      IF ti_rn_ekgrp[] IS NOT INITIAL AND
         es_outdata-ekgrp NOT IN ti_rn_ekgrp.
        CONTINUE.
      ENDIF.
      "Encargado Comercial
      IF ti_rn_encom[] IS NOT INITIAL AND
         es_outdata-kunzv NOT IN ti_rn_encom.
        CONTINUE.
      ENDIF.
      "Creado el
      IF ti_rn_erdat[] IS NOT INITIAL AND
         es_outdata-erdat NOT IN ti_rn_erdat.
        CONTINUE.
      ENDIF.
      "Fecha fin Transporte
      IF ti_rn_fftp[] IS NOT INITIAL AND
         es_outdata-actual_date NOT IN ti_rn_fftp.
        CONTINUE.
      ENDIF.
      "Motivo Pedido
      IF ti_rn_moped[] IS NOT INITIAL AND
         es_outdata-augru NOT IN ti_rn_moped.
        CONTINUE.
      ENDIF.
      "Número Guía#
      IF ti_rn_nguia[] IS NOT INITIAL AND
         es_outdata-zz1_numeroguia_dlh NOT IN ti_rn_nguia.
        CONTINUE.
      ENDIF.
      "Responsable de Pago
      IF ti_rn_repag[] IS NOT INITIAL AND
         es_outdata-kunrg NOT IN ti_rn_repag.
        CONTINUE.
      ENDIF.
      "Sector
      IF ti_rn_spart[] IS NOT INITIAL AND
         es_outdata-spart NOT IN ti_rn_spart.
        CONTINUE.
      ENDIF.
      "Documento Transporte
      IF ti_rn_tknum[] IS NOT INITIAL AND
         es_outdata-tor_id NOT IN ti_rn_tknum.
        CONTINUE.
      ENDIF.
      "Entrega
      IF ti_rn_vbele[] IS NOT INITIAL AND
         es_outdata-vbelne NOT IN ti_rn_vbele.
        CONTINUE.
      ENDIF.
      "Doc.facturación
      IF ti_rn_vbelf[] IS NOT INITIAL AND
         es_outdata-vbelnf NOT IN ti_rn_vbelf.
        CONTINUE.
      ENDIF.
      "Pedido
      IF ti_rn_vbelp[] IS NOT INITIAL AND
         es_outdata-vbelnp NOT IN ti_rn_vbelp.
        CONTINUE.
      ENDIF.
      "Fe.prefer.entrega
      IF ti_rn_vdatu[] IS NOT INITIAL AND
         es_outdata-vdatu NOT IN ti_rn_vdatu.
        CONTINUE.
      ENDIF.
      "Organización ventas
      IF ti_rn_vkorg[] IS NOT INITIAL AND
         es_outdata-vkorg NOT IN ti_rn_vkorg.
        CONTINUE.
      ENDIF.
      "Canal distribución
      IF ti_rn_vtweg[] IS NOT INITIAL AND
         es_outdata-vtweg NOT IN ti_rn_vtweg.
        CONTINUE.
      ENDIF.
      "Centro Receptor
      IF ti_rn_werkr[] IS NOT INITIAL AND
         es_outdata-werkr NOT IN ti_rn_werkr.
        CONTINUE.
      ENDIF.
      "Centro
      IF ti_rn_werks[] IS NOT INITIAL AND
         es_outdata-werks NOT IN ti_rn_werks.
        CONTINUE.
      ENDIF.
      APPEND es_outdata TO ti_outdata_aux.

    ENDLOOP.
    ti_outdata = ti_outdata_aux.
    CLEAR ti_outdata_aux.

