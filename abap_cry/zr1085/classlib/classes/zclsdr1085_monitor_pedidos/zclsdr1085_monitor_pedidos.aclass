  METHOD consultar_condiciones.

    DATA: es_pedido_posicion LIKE LINE OF i_ti_pedido_cabecera.

    CHECK i_ti_pedido_cabecera IS NOT INITIAL.

    SELECT knumv, kposn,stunr, zaehk, kschl, kwert, kbetr, waerk
    FROM prcd_elements
    FOR ALL ENTRIES IN @i_ti_pedido_cabecera
    WHERE knumv = @i_ti_pedido_cabecera-knumv
    AND   kschl IN ( 'ZPRS', 'EDI1', 'EDI2', 'ZMAR', 'ZPEX', 'ZPRN' )
    INTO CORRESPONDING FIELDS OF TABLE @r_ti_condiciones.

    LOOP AT r_ti_condiciones ASSIGNING FIELD-SYMBOL(<fs_es_condiciones>).
      CLEAR: es_pedido_posicion.

      es_pedido_posicion = VALUE #( i_ti_pedido_cabecera[ KEY clave_secundaria knumv = <fs_es_condiciones>-knumv ] OPTIONAL ).

      <fs_es_condiciones>-pedido = es_pedido_posicion-pedido.
      <fs_es_condiciones>-posicion_pedido = <fs_es_condiciones>-kposn.
    ENDLOOP.

  ENDMETHOD.


  METHOD modificar_catalogo.

    "Eliminar columnas temporalmente
    DELETE gti_catalogo_alv WHERE fieldname = 'STATUS_ENTREGA_FINAL' OR
                                  fieldname = 'STATUS_ENTREGA_COMPLETA'.
    "OR fieldname = 'INVENTARIO_DISPONIBLE'.

    LOOP AT c_ti_catalogo ASSIGNING FIELD-SYMBOL(<fs_es_catalogo>).
      <fs_es_catalogo>-col_opt = abap_true.

      CASE <fs_es_catalogo>-fieldname.

        WHEN 'KNUMV' OR 'PEDIDO_IMPUESTO_POSICION' OR 'OBJEK' OR
             'TIPO_DOCUMENTO_ENTREGA' OR 'POSICION_CONSOLIDADA' OR
             'GBSTK' OR 'ENTREGA_PARCIAL_POSICION' OR
             'INDIC_ENTREGA_SALIDA_COMPLETA'."Ocultar columnas
          <fs_es_catalogo>-no_out = abap_true.
        WHEN 'PEDIDO' OR 'ENTREGA' OR 'FACTURA' OR 'DOCUMENTO_FI'.
          <fs_es_catalogo>-hotspot = abap_true.
        WHEN 'STATUS_LOGISTICO'.
          <fs_es_catalogo>-f4availabl = abap_true.
        WHEN 'MOTIVO_BLOQUEO_FACTURA_DESC'.
          <fs_es_catalogo>-coltext = TEXT-002.
        WHEN 'MOTIVO_BLOQUEO_ENTREGA_DESC'.
          <fs_es_catalogo>-coltext = TEXT-001.
        WHEN 'MOTIVO_RECHAZO_DESC'.
          <fs_es_catalogo>-coltext = TEXT-003.
        WHEN 'VALOR_NETO_PEDIDO'.
          <fs_es_catalogo>-coltext = TEXT-004.
        WHEN 'PAGO_CLINETE_IMPUESTOS'.
          <fs_es_catalogo>-coltext = TEXT-005.
        WHEN 'IMPUESTOS'.
          <fs_es_catalogo>-coltext = TEXT-006.
        WHEN 'FECHA_CONFIRMADA'.
          <fs_es_catalogo>-coltext = TEXT-007.
        WHEN 'TIENDA'.
          <fs_es_catalogo>-coltext = TEXT-008.
        WHEN 'NOMBRE_TIENDA'.
          <fs_es_catalogo>-coltext = TEXT-009.
        WHEN 'ID_FISCAL_TIENDA'.
          <fs_es_catalogo>-coltext = TEXT-010.
        WHEN 'PAIS_TIENDA'.
          <fs_es_catalogo>-coltext = TEXT-011.
        WHEN 'TELEFONO_TIENDA'.
          <fs_es_catalogo>-coltext = TEXT-012.
        WHEN 'DIRECCION_TIENDA'.
          <fs_es_catalogo>-coltext = TEXT-013.
        WHEN 'ZONATRANSPORTE_TIENDA'.
          <fs_es_catalogo>-coltext = TEXT-014.
        WHEN 'SOLICITANTE'.
          <fs_es_catalogo>-coltext = TEXT-015.
        WHEN 'NOMBRE_SOLICITANTE'.
          <fs_es_catalogo>-coltext = TEXT-016.
        WHEN 'ID_FISCAL_SOLICITANTE'.
          <fs_es_catalogo>-coltext = TEXT-017.
        WHEN 'PAIS_SOLICITANTE'.
          <fs_es_catalogo>-coltext = TEXT-018.
        WHEN 'CIUDAD_SOLICITANTE'.
          <fs_es_catalogo>-coltext = TEXT-019.
        WHEN 'TELEFONO_SOLICITANTE'.
          <fs_es_catalogo>-coltext = TEXT-020.
        WHEN 'DIRECCION_SOLICITANTE'.
          <fs_es_catalogo>-coltext = TEXT-021.
        WHEN 'ZONATRANSPORTE_SOLICITANTE'.
          <fs_es_catalogo>-coltext = TEXT-022.
        WHEN 'RESPONSABLE_PAGO'.
          <fs_es_catalogo>-coltext = TEXT-023.
        WHEN 'NOMBRE_RESPONSABLE_PAGO'.
          <fs_es_catalogo>-coltext = TEXT-024.
        WHEN 'ID_FISCAL_RESPONSABLE_PAGO'.
          <fs_es_catalogo>-coltext = TEXT-030.
        WHEN 'PAIS_RESPONSABLE_PAGO'.
          <fs_es_catalogo>-coltext = TEXT-025.
        WHEN 'CIUDAD_RESPONSABLE_PAGO'.
          <fs_es_catalogo>-coltext = TEXT-026.
        WHEN 'TELEFONO_RESPONSABLE_PAGO'.
          <fs_es_catalogo>-coltext = TEXT-027.
        WHEN 'DIRECCION_RESPONSABLE_PAGO'.
          <fs_es_catalogo>-coltext = TEXT-028.
        WHEN 'ZONATRANSPORTE_RESP_PAGO'.
          <fs_es_catalogo>-coltext = TEXT-029.
        WHEN 'DESTINATARIO'.
          <fs_es_catalogo>-coltext = TEXT-031.
        WHEN 'NOMBRE_DESTINATARIO'.
          <fs_es_catalogo>-coltext = TEXT-032.
        WHEN 'ID_FISCAL_DESTINATARIO'.
          <fs_es_catalogo>-coltext = TEXT-033.
        WHEN 'PAIS_DESTINATARIO'.
          <fs_es_catalogo>-coltext = TEXT-034.
        WHEN 'TELEFONO_DESTINATARIO'.
          <fs_es_catalogo>-coltext = TEXT-035.
        WHEN 'DIRECCION_DESTINATARIO'.
          <fs_es_catalogo>-coltext = TEXT-036.
        WHEN 'ZONATRANSPORTE_DESTINATARIO'.
          <fs_es_catalogo>-coltext = TEXT-037.
        WHEN 'POSICION_PEDIDO'.
          <fs_es_catalogo>-coltext = TEXT-038.
        WHEN 'DESCRIPCION_TALLA'.
          <fs_es_catalogo>-coltext = TEXT-039.
        WHEN 'DESCRIPCION_COLOR'.
          <fs_es_catalogo>-coltext = TEXT-040.
        WHEN 'PORCENTAJE_CUMPLIMIENTO'.
          <fs_es_catalogo>-coltext = TEXT-041.
        WHEN 'PORCENTAJE_ASIGNACION'.
          <fs_es_catalogo>-coltext = TEXT-042.
        WHEN 'CANTIDAD_PENDIENTE'.
          <fs_es_catalogo>-coltext = TEXT-043.
        WHEN 'STATUS_CANCELADO'.
          <fs_es_catalogo>-coltext = TEXT-044.
        WHEN 'CAJA_EWM'.
          <fs_es_catalogo>-coltext = TEXT-045.
        WHEN 'MATNR_EMBALAJE'.
          <fs_es_catalogo>-coltext = TEXT-046.
        WHEN 'CANTIDAD_DESPACHADA'.
          <fs_es_catalogo>-coltext = TEXT-047.
        WHEN 'STATUS_VL_PEDIDO_VS_VL_FACTURA'.
          <fs_es_catalogo>-coltext = TEXT-048.
          <fs_es_catalogo>-just = 'C'.

          IF i_consolidado = abap_false.
            <fs_es_catalogo>-no_out = abap_true.
          ENDIF.

        WHEN 'IDOC_FI'.
          <fs_es_catalogo>-coltext = TEXT-054.
        WHEN 'HORA_FIN_TRANSPORTE'.
          <fs_es_catalogo>-coltext = TEXT-057.
          <fs_es_catalogo>-edit_mask = '__:__:__'.
        WHEN 'FECHA_FIN_TRANSPORTE'.
          <fs_es_catalogo>-coltext = TEXT-052.
        WHEN 'GUIA_TRANSPORTE'.
          <fs_es_catalogo>-coltext = TEXT-053.
        WHEN 'VALOR_FACTURA'.
          <fs_es_catalogo>-coltext = TEXT-055.
        WHEN 'VALOR_NETO'.
          <fs_es_catalogo>-coltext = TEXT-056.
        WHEN 'CANTIDAD_ENTREGADA_PARCIAL'.
          <fs_es_catalogo>-coltext = TEXT-059.
        WHEN 'ECOMMERCE_REMITENTE'.
          <fs_es_catalogo>-coltext = TEXT-060.
        WHEN 'ECOMMERCE_DESTINATARIO'.
          <fs_es_catalogo>-coltext = TEXT-061.
        WHEN 'ECOMMERCE_TEXTO_DEL_MENSAJE'.
          <fs_es_catalogo>-coltext = TEXT-062.
        WHEN 'ECOMMERCE_EMPAQUE_REGALO'.
          <fs_es_catalogo>-coltext = TEXT-063.
        WHEN 'GUIA_DEVOLUCION'.
          <fs_es_catalogo>-coltext = TEXT-064.
        WHEN 'TALLA_CLIENTE'.
          <fs_es_catalogo>-coltext = TEXT-065.
        WHEN 'DESCRIPCION_TALLA_CLIENTE'.
          <fs_es_catalogo>-coltext = TEXT-066.
        WHEN 'COLOR_CLIENTE'.
          <fs_es_catalogo>-coltext = TEXT-067.
        WHEN 'DESCRIPCION_COLOR_CLIENTE'.
          <fs_es_catalogo>-coltext = TEXT-068.
        WHEN 'CENTRO_RECEPTOR'.
          <fs_es_catalogo>-coltext = TEXT-069.
        WHEN 'ALMACEN_RECEPTOR'.
          <fs_es_catalogo>-coltext = TEXT-070.
        WHEN 'CANTIDAD_RECIBIDA'.
          <fs_es_catalogo>-coltext = TEXT-071.
        WHEN 'FECHA_CONTABILIZA_RECEPCION'.
          <fs_es_catalogo>-coltext = TEXT-072.
        WHEN 'FECHA_FACTURA'.
          <fs_es_catalogo>-coltext = TEXT-073.
        WHEN 'MATERIAL_GENERICO'.
          <fs_es_catalogo>-coltext = TEXT-074.
        WHEN 'DESC_MATERIAL_GENERICO'.
          <fs_es_catalogo>-coltext = TEXT-075.
      ENDCASE.

    ENDLOOP.

  ENDMETHOD.

  METHOD determinar_estado_pedido.

    DATA: indicador_pedido_bloqueado   TYPE flag,
          indicador_pedido_sin_gestion TYPE flag.

    IF i_r_pedido IS NOT INITIAL AND c_ti_pedidos IS INITIAL.
      SORT i_r_pedido BY sign option low.
      DELETE ADJACENT DUPLICATES FROM i_r_pedido COMPARING ALL FIELDS.
      c_ti_pedidos = consultar_pedidos_venta( i_r_vbelp = i_r_pedido i_retornar_mensajes = abap_false ).
    ENDIF.

    LOOP AT c_ti_pedidos ASSIGNING FIELD-SYMBOL(<fs_es_pedidos_grupo>)
                         GROUP BY ( pedido = <fs_es_pedidos_grupo>-pedido ).

      indicador_pedido_sin_gestion =
      indicador_pedido_bloqueado = abap_true.

      LOOP AT GROUP <fs_es_pedidos_grupo> ASSIGNING FIELD-SYMBOL(<fs_es_pedidos>).
        IF i_pedido_traslado = abap_false.
          "Estado Pedido{
          <fs_es_pedidos>-status_pedido = COND #( WHEN <fs_es_pedidos>-status_novedad_transportista = '05' THEN
                                                    "El status de la novedad de transporte es "Entregado a Cliente"
                                                    icon_green_light
                                                  WHEN <fs_es_pedidos>-entrega IS INITIAL AND <fs_es_pedidos>-factura IS INITIAL THEN
                                                    "Pedidos sin documentos subsiguientes
                                                    icon_red_light
                                                  ELSE
                                                    "El pedido se encuentra en proceso y con documentos subsiguientes
                                                     icon_yellow_light
                                                 ).
          "Bono Eccomerce
          IF g_r_tipo_posicion_bono_eccomer IS NOT INITIAL AND
             <fs_es_pedidos>-tipo_posicion IN g_r_tipo_posicion_bono_eccomer AND
             <fs_es_pedidos>-factura IS NOT INITIAL.
            <fs_es_pedidos>-status_pedido = icon_green_light.
          ENDIF.
          "}
          "Estado Logistico Logica {
          <fs_es_pedidos_grupo>-status_logistico = COND #(   WHEN <fs_es_pedidos>-status_novedad_transportista = '05' THEN
                                                                gc_completo_entregado_cliente
                                                             WHEN  <fs_es_pedidos>-orden_flete IS NOT INITIAL AND <fs_es_pedidos>-unidad_flete IS NOT INITIAL THEN "Pedidos con entrega
                                                                gc_lectura_transporte
                                                             WHEN <fs_es_pedidos>-kostk = 'C' THEN
                                                                gc_fin_picking
                                                             WHEN <fs_es_pedidos>-entrega IS NOT INITIAL THEN
                                                                gc_enviado_a_proceso
                                                             WHEN (
                                                                  "Motivo_Bloqueo_Entrega
                                                                  ( <fs_es_pedidos>-motivo_bloqueo_entrega IS INITIAL ) AND
                                                                  "Motivo_Bloqueo_Factura
                                                                  ( <fs_es_pedidos>-motivo_bloqueo_factura IS INITIAL AND
                                                                    <fs_es_pedidos>-entrega IS INITIAL ) AND
                                                                  "Motivo_rechazo
                                                                  ( <fs_es_pedidos>-motivo_rechazo IS INITIAL )
                                                                  ) THEN
                                                                gc_pedido_sin_gestion
                                                             WHEN <fs_es_pedidos>-clasificacion = '04' THEN
                                                                gc_pedido_bloqueado
                                                             ELSE
                                                                gc_pedidos_cancelados
                                                            ).


          IF <fs_es_pedidos>-indicador_borrado NE 'L'.
            indicador_pedido_bloqueado = abap_false.
          ENDIF.

          IF <fs_es_pedidos>-entrega NE space.
            indicador_pedido_sin_gestion = abap_false.
          ENDIF.

          IF <fs_es_pedidos>-kostk = 'C'.
            <fs_es_pedidos_grupo>-status_logistico = gc_fin_picking.
          ENDIF.

          IF <fs_es_pedidos>-status_novedad_transportista = '05'.
            <fs_es_pedidos_grupo>-status_logistico = gc_completo_entregado_cliente.
          ENDIF.

          "}

        ELSE.
          "Estado Pedido{
          <fs_es_pedidos>-status_pedido = COND #( WHEN <fs_es_pedidos>-status_novedad_transportista = '05' THEN
                                                    "El status de la novedad de transporte es "Entregado a Cliente"
                                                    icon_green_light
                                                  WHEN <fs_es_pedidos>-entrega IS INITIAL THEN
                                                    "Pedidos sin documentos subsiguientes
                                                    icon_red_light
                                                  ELSE
                                                    "El pedido se encuentra en proceso y con documentos subsiguientes
                                                     icon_yellow_light
                                                 ).
          "}
        ENDIF.

      ENDLOOP.

      IF i_pedido_traslado = abap_true AND <fs_es_pedidos_grupo>-status_logistico IS INITIAL.

        <fs_es_pedidos_grupo>-status_logistico = COND #( WHEN <fs_es_pedidos>-status_novedad_transportista = '05' THEN
                                                            gc_completo_entregado_cliente
                                                         WHEN indicador_pedido_sin_gestion = abap_false THEN "Pedidos con entrega
                                                            gc_enviado_a_proceso
                                                         WHEN indicador_pedido_sin_gestion = abap_true THEN
                                                            gc_pedido_sin_gestion
                                                         WHEN indicador_pedido_bloqueado = abap_true THEN
                                                            gc_pedido_bloqueado
                                                         ELSE
                                                            gc_pedido_sin_gestion
                                                       ).
      ENDIF.

    ENDLOOP.


  ENDMETHOD.


  METHOD constructor.

    go_log =  zclcxr1002_log_aplicacion=>get_instancia( ).
    go_log->remover_mensage( ).
    go_log->liberar( ).

    IF go_parametros IS NOT BOUND.
      go_parametros = NEW zclcxr1000_parametros( i_modulo = 'SD' i_ricefw = 'R1085'  ).
    ENDIF.

    "Catalogo de campos del reporte para generar consultas y calculos dinamicos =)
    TRY.
        gti_catalogo_alv = zclcxr1002_util=>construir_catalogo( i_ti = gti_pedidos_monitor  i_cfieldname = 'MONEDA' i_qfieldname = 'UNIDAD_MEDIDA'  ).

      CATCH cx_dynamic_check cx_static_check.
        "handle exception
    ENDTRY.

    TRY.
        g_r_clase_pedido_ecommerce = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'PED_ECOMME' )
                                                ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                            ).
        g_r_tp_posicion_material_flete = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'PED_MATFLT' )
                                                ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                            ).
        g_r_tipo_posicion_mto  = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'INV_TPPMTO' )
                                            ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                        ).

        g_r_excluir_tipo_posicion_espe  = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'EX_TPPOSPE' )
                                                ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                            ).

        DELETE g_r_excluir_tipo_posicion_espe WHERE low = space.

        g_r_cl_pedido_guia_devolucion = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'GUIA_DEVOL' )
                                                    ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                               ).

        g_r_cl_pedido_devolucion = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'PED_DEVOL' )
                                                    ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                               ).

        g_r_tipo_posicion_bono_eccomer = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'PED_BOECOM' )
                                                    ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                                ).

        g_r_cldc_traslado_interlocutor = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'CLPD_INTER' )
                                                    ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                                ).
        g_r_cl_factura_enviada_asn = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'CLM_EASNFA' )
                                              ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                            ).
        g_r_cl_factura_impresa = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'CLM_IMPRFA' )
                                          ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                        ).

        g_r_orgventa_con_cant_entrega = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'ORGVT_CTEN' )
                                          ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                        ).

        g_valor_event_code  = VALUE #(  go_parametros->gti_parametros[ idparam = 'EVENT_CODE' ]-low OPTIONAL ).

        g_max_cantidad_dias_ejecucion  = VALUE #(  go_parametros->gti_parametros[ idparam = 'MAX_DIACON' ]-low OPTIONAL ).

      CATCH cx_sy_itab_line_not_found.

    ENDTRY.
    "Organizaciones de venta y Canal que aplican para pedidos de exportacion
    LOOP AT  go_parametros->gti_parametros INTO DATA(es_parametro_dividido) WHERE ( idparam = 'ORVCA_EXPO' ).

      SPLIT es_parametro_dividido-low AT '/' INTO TABLE DATA(ti_parametro_dividido).

      CHECK lines( ti_parametro_dividido ) = 2.

      APPEND VALUE #( vkorg = ti_parametro_dividido[ 1 ] vtweg = ti_parametro_dividido[ 2 ] )
      TO gti_orgventa_canal_exportacion.

      CLEAR: ti_parametro_dividido.

    ENDLOOP.

  ENDMETHOD.


  METHOD consultar_um_erp.

    CHECK i_r_entregas IS NOT INITIAL.

    SELECT p~venum, p~vepos, c~exidv, vbeln, posnr, vhilm
    FROM i_sddocumentprocessflow AS fd
    INNER JOIN vepo AS p
    ON fd~subsequentdocument = p~venum
    AND fd~subsequentdocumentitem = p~vepos
    INNER JOIN  vekp AS c
    ON p~venum = c~venum
    WHERE fd~precedingdocument IN @i_r_entregas
    AND fd~precedingdocumentcategory = 'J' "entrega
    AND fd~subsequentdocumentcategory = 'X' "UM
    INTO CORRESPONDING FIELDS OF TABLE @r_ti_um_erp.


  ENDMETHOD.

  METHOD ajustar_datos_tm.


    DATA: fecha_actual TYPE string.

    LOOP AT c_ti_pedidos ASSIGNING FIELD-SYMBOL(<fs_es_tm>).
      CLEAR: fecha_actual.

      "Formato Fecha
      IF <fs_es_tm>-fecha_actual_transporte IS NOT INITIAL.
        CALL FUNCTION 'CONVERSION_EXIT_TSTLC_OUTPUT'
          EXPORTING
            input  = <fs_es_tm>-fecha_actual_transporte
          IMPORTING
            output = fecha_actual.

        TRY.
            <fs_es_tm>-fecha_fin_transporte = |{ fecha_actual+6(4) }{ fecha_actual+3(2) }{ fecha_actual(2) }|.
            <fs_es_tm>-hora_fin_transporte = |{ fecha_actual+11(2) }{ fecha_actual+14(2) }{ fecha_actual+17(2) }|.
          CATCH cx_sy_range_out_of_bounds.

        ENDTRY.
      ENDIF.

***      entrega_tm = VALUE #( ti_datos_nodo[ db_key = ti_enlace_de_claves[ KEY target_key target_key = <fs_es_tm>-db_key ]-source_key ]-base_btd_id OPTIONAL ).
***      entrega_tm = |{ entrega_tm ALPHA = OUT }|.
***      <fs_es_tm>-entrega = |{ entrega_tm ALPHA = IN }|.
      <fs_es_tm>-agente_servicio = |{ <fs_es_tm>-agente_servicio ALPHA = OUT }|.
    ENDLOOP.

  ENDMETHOD.

  METHOD aplicar_unidad_medida_estatica.

    CONSTANTS: c_um_docena_x_par TYPE marm-meinh VALUE 'DZP',
               c_um_un           TYPE marm-meinh VALUE 'UNU'.

    DATA: cantidad                  TYPE bstmg,
          r_tecnologia_material     TYPE RANGE OF char1,
          unidad_medida_estadistica TYPE meins.

    r_tecnologia_material  = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'TECNO_MATE' )
                                        ( CORRESPONDING #( es_parametro MAPPING option = opti ) )
                                    ).

    unidad_medida_estadistica = COND #( WHEN c_es_pedidos-grupo_de_articulo+1(1) IN r_tecnologia_material THEN
                                           c_um_docena_x_par
                                        ELSE
                                           c_um_un ).

    "ZSD110
    SELECT SINGLE
    FROM marm
    FIELDS matnr, meinh
    WHERE matnr = @c_es_pedidos-matnr
    AND   meinh = @unidad_medida_estadistica
    INTO @DATA(es_unidad_medida).

    CHECK sy-subrc IS INITIAL.

    "cambiar cantidad pedida, cantidad entregada, candidad facturada
    LOOP AT i_ti_catalog_alv ASSIGNING FIELD-SYMBOL(<fs_es_catalogo>) WHERE datatype = 'DEC' OR
                                                                            datatype = 'QUAN' OR
                                                                            datatype = 'P'.

      ASSIGN COMPONENT <fs_es_catalogo>-fieldname OF STRUCTURE c_es_pedidos TO FIELD-SYMBOL(<fs_valor_campo>).

      TRY.
          cantidad = <fs_valor_campo>.

          CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
            EXPORTING
              i_matnr              = c_es_pedidos-matnr
              i_in_me              = c_es_pedidos-unidad_venta
              i_out_me             = unidad_medida_estadistica "Calm it's equals to DOP *-<+><+>-*
              i_menge              = cantidad
            IMPORTING
              e_menge              = cantidad
            EXCEPTIONS
              error_in_application = 1
              error                = 2
              OTHERS               = 3.

          IF sy-subrc IS INITIAL.
            <fs_valor_campo> = cantidad.
          ELSE.
            go_log->set_es_log( i_es = VALUE #( id = sy-msgid type = sy-msgty number = sy-msgno message_v1 = sy-msgv1 message_v2 = sy-msgv2 ) ).
          ENDIF.

        CATCH cx_sy_conversion_overflow.

      ENDTRY.
    ENDLOOP.

    c_es_pedidos-unidad_venta = unidad_medida_estadistica.

  ENDMETHOD.

  METHOD manejador_f4_alv.

    TYPES: BEGIN OF tp_es_status_logistico,
             status_logistico TYPE zedstatuslogistico,
             val_text         TYPE val_text,
           END OF tp_es_status_logistico.

    DATA: ti_status_logistico TYPE STANDARD TABLE OF tp_es_status_logistico,
          ti_mapeo            TYPE TABLE OF dselc,
          ti_retorno          TYPE TABLE OF ddshretval.

    CASE e_fieldname.

      WHEN 'STATUS_LOGISTICO'.

        "Cargar datos F4
        DATA(ti_dominio) = zclcxr1002_util=>get_valores_dominio( i_nombre_dominio = 'ZDMSTATUSLOGISTICO' ).

        ti_status_logistico = VALUE #( FOR es_dominio  IN ti_dominio
                                        ( status_logistico = es_dominio-domvalue_l val_text = es_dominio-ddtext ) ).

        "Asignar valores de retorno
        ti_mapeo = VALUE #( ( fldname = 'STATUS_LOGISTICO' dyfldname = 'STATUS_LOGISTICO' ) ).

        CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
          EXPORTING
            retfield        = 'STATUS_LOGISTICO'
            value_org       = 'S'
          TABLES
            value_tab       = ti_status_logistico
            dynpfld_mapping = ti_mapeo
            return_tab      = ti_retorno
          EXCEPTIONS
            parameter_error = 1
            no_values_found = 2
            OTHERS          = 3.

    ENDCASE.

    er_event_data->m_event_handled = abap_true.

  ENDMETHOD.

  METHOD evento_hotspot.
    ASSIGN gti_pedidos_monitor[ e_row_id-index ] TO FIELD-SYMBOL(<fs_es_monitor>).

    CHECK <fs_es_monitor> IS ASSIGNED.

    CASE e_column_id.
      WHEN 'PEDIDO'.
        IF <fs_es_monitor>-pedido_traslado = abap_true.
          SET PARAMETER ID 'BES' FIELD <fs_es_monitor>-pedido.
          CALL TRANSACTION 'ME23N' AND SKIP FIRST SCREEN.
        ELSE.
          SET PARAMETER ID 'AUN' FIELD <fs_es_monitor>-pedido.
          CALL TRANSACTION 'VA03' AND SKIP FIRST SCREEN.
        ENDIF.

      WHEN 'ENTREGA'.
        CHECK <fs_es_monitor>-entrega IS NOT INITIAL.
        SET PARAMETER ID 'VL' FIELD <fs_es_monitor>-entrega.
        CALL TRANSACTION 'VL03N' AND SKIP FIRST SCREEN.
      WHEN 'FACTURA'.
        CHECK <fs_es_monitor>-factura IS NOT INITIAL.
        SET PARAMETER ID 'VF' FIELD <fs_es_monitor>-factura.
        CALL TRANSACTION 'VF03' AND SKIP FIRST SCREEN.
      WHEN 'DOCUMENTO_FI'.
        CHECK <fs_es_monitor>-documento_fi IS NOT INITIAL.
        SET PARAMETER ID 'BLN' FIELD <fs_es_monitor>-documento_fi.
        SET PARAMETER ID 'BUK' FIELD <fs_es_monitor>-sociedad_fi.
        SET PARAMETER ID 'GJR' FIELD <fs_es_monitor>-ejercicio_fi.
        CALL TRANSACTION 'FB03' AND SKIP FIRST SCREEN.
    ENDCASE.

  ENDMETHOD.

  METHOD inventario_entrega
         BY DATABASE FUNCTION FOR HDB
                LANGUAGE SQLSCRIPT
                OPTIONS READ-ONLY
                USING lips ztcxr1000_2.

    declare client varchar(3) := session_context ('CLIENT');

    --consultar entregas
    ti_entrega =
    SELECT
    mandt,
    matnr,
    werks,
    lgort,
    charg,
    vrkme,
    pstyv, --+sls excluir tipo de posicion para entrega entrante
    _entrega.lfimg as cantidad_entrega
    from lips as _entrega
    where mandt = :client
      and wbsta <> 'C'
      and lfimg >  0;
    --totalizar y excluir por tipo de poscion de entrega
    ti_entrega_cantidad =
    select
    mandt,
    matnr,
    werks,
    lgort,
    charg,
    vrkme,
    sum( cantidad_entrega ) as cantidad_entrega
    from :ti_entrega as _entrega
    where pstyv not in ( select low from ztcxr1000_2 where ricefw  =  'R1085' and idparam =  'EX_TPPOSEE' )
    group by
        _entrega.mandt,
        _entrega.matnr,
        _entrega.werks,
        _entrega.lgort,
        _entrega.charg,
        _entrega.vrkme;

    --unir valores totalizados con valores generales
    ti_inventario =
    select distinct
    _entrega_inventario.mandt,
    _entrega_inventario.matnr,
    _entrega_inventario.werks,
    _entrega_inventario.lgort,
    _entrega_inventario.charg,
    _entrega_inventario.vrkme,
    _entrega_totalizada.cantidad_entrega
    from :ti_entrega as _entrega_inventario
    left join :ti_entrega_cantidad as _entrega_totalizada on
    _entrega_totalizada.mandt = _entrega_inventario.mandt and
    _entrega_totalizada.matnr = _entrega_inventario.matnr and
    _entrega_totalizada.werks = _entrega_inventario.werks and
    _entrega_totalizada.lgort = _entrega_inventario.lgort and
    _entrega_totalizada.charg = _entrega_inventario.charg and
    _entrega_totalizada.vrkme = _entrega_inventario.vrkme;

    return
    select
    mandt,
    matnr,
    werks,
    lgort,
    charg,
    vrkme,
    cantidad_entrega
    from :ti_inventario as _entrega_inventario;

  ENDMETHOD.

  METHOD datos_idoc_financiero
            BY DATABASE FUNCTION FOR HDB
                LANGUAGE SQLSCRIPT
                OPTIONS READ-ONLY
                USING edidc edid4 edids.

    declare client varchar(3) := session_context ('CLIENT');

    ti_datos_idoc = SELECT
                    k.mandt,
                    k.docnum as numero_idoc,
                    k.mestyp,
                    segnam,
                    k.status,
                    substring( stapa2, 1, 10)  as numero_documento_fi,
                    substring( sdata, 138, 4)  as sociedad,
                    substring( sdata, 154, 2) as periodo,
                    substring( sdata, 156, 4) as ejercicio,
                    substring( sdata, 160, 8) as fecha_contabilizacion,
                    substring( sdata, 136, 2) as tipo_documento,
                    trim ( substring( sdata, 201, 18) ) as pedido_cliente,
                    substring( sdata, 88, 12) as referencia_1
                    from edidc as k
                    inner join edid4 AS d
                    ON k.mandt = d.mandt
                    and k.docnum = d.docnum
                    left join
                    ( select docnum, status, stapa2 FROM edids WHERE status = '53' ) as dl
                    ON dl.docnum = k.docnum
                    and dl.status = k.status
                    where k.mandt = :client
                    and d.segnam = 'E1BPACGL09'
                    WITH HINT ( ignore_plan_cache );

    --solo documentos generados por ecommerce
    ti_documentos_ecommerce =
    SELECT *
    FROM :ti_datos_idoc
    WHERE tipo_documento = 'P1';
    RETURN SELECT DISTINCT
    mandt,
    numero_idoc,
    numero_documento_fi,
    pedido_cliente,
    tipo_documento,
    mestyp,
    segnam,
    status,
    sociedad,
    periodo,
    ejercicio,
    fecha_contabilizacion,
    referencia_1
    FROM :ti_documentos_ecommerce
    WITH HINT ( ignore_plan_cache );

  ENDMETHOD.


  METHOD asignar_datos_tm.
*    DATA(es_datos_tm) = VALUE #( i_ti_datos_tm[ entrega = c_es_detalle_pedido-entrega ] OPTIONAL ).
*
*    c_es_detalle_pedido-zzest_carga = es_datos_tm-zzest_carga.

  ENDMETHOD.


  METHOD calc_porcentaje_cumplimiento.
    TRY.
        c_es_detalle_pedido-porcentaje_cumplimiento = ( i_cantidad_entrega_acumulada  / i_cantidad_pedida ) * 100 .
      CATCH cx_sy_zerodivide.

    ENDTRY.
  ENDMETHOD.


  METHOD aplicar_formatos.

    LOOP AT c_ti_pedidos ASSIGNING FIELD-SYMBOL(<fs_es_pedido>).
      <fs_es_pedido>-numero_transporte = |{ <fs_es_pedido>-numero_transporte ALPHA = OUT }|.
    ENDLOOP.

  ENDMETHOD.

  METHOD generar_monitor_pedidotraslado.

    DATA: ti_pedido_cabecera            TYPE gtp_ti_pedido_cabecera,
          ti_pedido_posicion            TYPE gtp_ti_pedido_posicion,
          ti_um_erp                     TYPE gtp_ti_um_erp,
          ti_entregas_pedido            TYPE gtp_ti_entregas_pedido,
          es_um_erp                     LIKE LINE OF ti_um_erp,
          ti_datos_tm                   TYPE gtp_ti_datos_tm,
          es_entrega_factura_referencia LIKE LINE OF r_ti_pedidos_traslado,
          es_pedido_referencia          LIKE LINE OF r_ti_pedidos_traslado,
          es_ultimo_estado_logistico    LIKE LINE OF r_ti_pedidos_traslado,
          cantidad_despachada           TYPE vbfa-rfmng,
          cantidad_entrega_acumulada    TYPE lips-lfimg,
          cantidad_pedida               TYPE zesdr1085_1-cantidad_pedida,
          precio_exportacion            TYPE ekpo-netwr,
          cantidad_entregas_parciales   TYPE i,
          posicion_anterior             TYPE vbap-posnr,
          cantidad_entregada_parcial    TYPE p LENGTH 15 DECIMALS 2,
          status_entrega_final          TYPE flag,
          indicador_borrado             TYPE flag,
          status_entrega_completa       TYPE flag,
          status_cancelado              TYPE flag,
          primera_iteracion             TYPE flag,
          pedido_con_factura            TYPE flag.

    FIELD-SYMBOLS: <fs_es_entrega_pedido> LIKE LINE OF ti_entregas_pedido.
    "        \ _ /
    "      -= (_) =-
    "        /   \         _\/_
    "          |           //o\  _\/_
    "   _____ _ __ __ ____ _ | __/o\\ _
    " =-=-_-__=_-= _=_=-=_,-'|"'""-|-,_
    "  =- _=-=- -_=-=_,-"          |
    "     =- =- -=.--"                             \ /
    " Chase your dreams and never but never Stop ...O...
    "--------------------------------------------- / \
    zclcxr1002_util=>completar_rango(
      EXPORTING
        i_convertir_in  = abap_true
      CHANGING
        c_ti_rango      = i_r_vbelp ).

    IF ( i_r_vkorg[] IS INITIAL OR i_r_werks[] IS INITIAL OR i_r_erdat[] IS INITIAL ) AND
       ( i_r_bstnk[] IS INITIAL AND i_r_vbelp[] IS INITIAL ) .
      go_log->set_es_log( i_es = VALUE #( type = 'E' id = '00' number = '055' )  ).
      RETURN.
    ENDIF.

    r_ti_pedidos_traslado = consultar_pedidos_traslado( i_r_vkorg                     = i_r_vkorg
                                                        i_r_vtweg                     = i_r_vtweg
                                                        i_r_spart                     = i_r_spart
                                                        i_r_werks                     = i_r_werks
                                                        i_r_centro_receptor           = i_r_centro_receptor
                                                        i_r_erdat                     = i_r_erdat
                                                        i_r_auart                     = i_r_auart
                                                        i_r_vdatu                     = i_r_vdatu
                                                        i_r_vbelp                     = i_r_vbelp
                                                        i_r_bstnk                     = i_r_bstnk
                                                        i_r_responsable_de_pago       = i_r_responsable_de_pago
                                                        i_r_vbele                     = i_r_vbele
                                                        i_r_bsgru                     = i_r_bsgru
                                                        i_r_ekgrp                     = i_r_ekgrp
                                                        i_r_numero_guia               = i_r_numero_guia
                                                        i_r_vbelf                     = i_r_vbelf
                                                        i_r_numero_transporte         = i_r_numero_transporte
                                                        i_pedido_pendiente_x_entregar = i_pedido_pendiente_x_entregar ).

    CHECK r_ti_pedidos_traslado IS NOT INITIAL.

    LOOP AT r_ti_pedidos_traslado ASSIGNING FIELD-SYMBOL(<fs_es_pedidos_traslado_grp>)
                                  GROUP BY ( pedido = <fs_es_pedidos_traslado_grp>-pedido
                                             posicion_pedido = <fs_es_pedidos_traslado_grp>-posicion_pedido
                                           ).

      CLEAR: cantidad_entrega_acumulada, cantidad_entregas_parciales.
      UNASSIGN <fs_es_entrega_pedido>.

      "Agregar los campos que se requieren a nivel de cabecera para realizar calculos
      APPEND CORRESPONDING #( <fs_es_pedidos_traslado_grp> ) TO ti_pedido_cabecera.

      LOOP AT GROUP <fs_es_pedidos_traslado_grp> ASSIGNING FIELD-SYMBOL(<fs_es_pedidos_posicion>).

        APPEND CORRESPONDING #( <fs_es_pedidos_posicion> ) TO ti_pedido_posicion.

        IF NOT line_exists( ti_entregas_pedido[ KEY clave_secundaria pedido = <fs_es_pedidos_posicion>-pedido posicion_pedido = <fs_es_pedidos_posicion>-posicion_pedido
                                                  entrega = <fs_es_pedidos_posicion>-entrega posicion_entrega = <fs_es_pedidos_posicion>-posicion_entrega ] ).
          APPEND INITIAL LINE TO ti_entregas_pedido ASSIGNING <fs_es_entrega_pedido>.
          <fs_es_entrega_pedido> = CORRESPONDING #( <fs_es_pedidos_posicion> ).
          ADD 1 TO cantidad_entregas_parciales.
          ADD <fs_es_pedidos_posicion>-cantidad_entrega TO cantidad_entrega_acumulada.
        ENDIF.
      ENDLOOP.

      IF <fs_es_entrega_pedido> IS ASSIGNED.
        MODIFY ti_entregas_pedido
        FROM VALUE #( cantidad_entrega_acumulada = cantidad_entrega_acumulada cantidad_entregas_parciales = cantidad_entregas_parciales )
        USING KEY clave_secundaria
        TRANSPORTING cantidad_entrega_acumulada cantidad_entregas_parciales
        WHERE pedido = <fs_es_entrega_pedido>-pedido AND
              posicion_pedido = <fs_es_entrega_pedido>-posicion_pedido.
      ENDIF.

    ENDLOOP.

    SORT ti_entregas_pedido BY pedido posicion_pedido entrega posicion_entrega.
    DELETE ADJACENT DUPLICATES FROM ti_entregas_pedido COMPARING pedido posicion_pedido entrega posicion_entrega.

    DELETE ADJACENT DUPLICATES FROM ti_pedido_cabecera COMPARING pedido.
    DELETE ADJACENT DUPLICATES FROM ti_pedido_posicion COMPARING pedido posicion_pedido.

    asignar_interlocutor_pedtrasla( IMPORTING i_ti_pedido_cabecera  = ti_pedido_cabecera
                                    CHANGING  c_ti_pedidos_traslado = r_ti_pedidos_traslado ).
    asignar_factura_pedidotraslado( IMPORTING i_ti_entregas_pedido  = ti_entregas_pedido
                                              i_ti_pedido_cabecera  = ti_pedido_cabecera
                                    CHANGING  c_ti_pedidos_traslado = r_ti_pedidos_traslado ).
    "                           ____
    "                         _(____)_
    "                  ___ooO_(_o__o_)_Ooo___
    "
    " La determinacion del STATUS_LOGISTICO se translado a la CDS, en posteriores
    " logicas no soportadas en la CDS aplicar logica de determinacion en este metodo
    determinar_estado_pedido( EXPORTING i_pedido_traslado = abap_true CHANGING c_ti_pedidos = r_ti_pedidos_traslado  ).

    ti_datos_tm = ajustar_datos_tm( EXPORTING
                                        i_r_numero_transporte = i_r_numero_transporte
                                      CHANGING
                                        c_ti_pedidos = r_ti_pedidos_traslado ).

    LOOP AT r_ti_pedidos_traslado ASSIGNING FIELD-SYMBOL(<fs_es_grupo_pedido>)
                         GROUP BY ( pedido = <fs_es_grupo_pedido>-pedido ).

      CLEAR: cantidad_despachada, es_entrega_factura_referencia, es_pedido_referencia,
             es_ultimo_estado_logistico, pedido_con_factura, posicion_anterior, cantidad_pedida,
             cantidad_entrega_acumulada, precio_exportacion.

      primera_iteracion = abap_true.
      status_cancelado = abap_true.
      status_entrega_final = abap_true.
      status_entrega_completa = abap_true.
      indicador_borrado = abap_true.
      cantidad_entregada_parcial = 1.

      zclcxr1002_util=>inicializar_totalizacion_es( ).

      "Recorrer posiciones
      LOOP AT GROUP <fs_es_grupo_pedido> ASSIGNING FIELD-SYMBOL(<fs_es_detalle_pedido>).

        "Acumular precio_exportacion
        precio_exportacion = precio_exportacion + <fs_es_detalle_pedido>-precio_exportacion.

        "Cantidad pedida para cada posicion
        IF <fs_es_detalle_pedido>-posicion_pedido NE posicion_anterior.
          cantidad_pedida = <fs_es_detalle_pedido>-cantidad_pedida.
          cantidad_entrega_acumulada = VALUE #( ti_entregas_pedido[ KEY clave_secundaria pedido = <fs_es_detalle_pedido>-pedido posicion_pedido = <fs_es_detalle_pedido>-posicion_pedido ]-cantidad_entrega_acumulada OPTIONAL ).

        ELSEIF primera_iteracion = abap_false.
          "Limpiar campos que solo se requieren una vez por posicion de pedido
          "dado que cuando existen multiples entregas por posicion de pedido, los valores se duplican
          CLEAR: <fs_es_detalle_pedido>-cantidad_pedida,
                 <fs_es_detalle_pedido>-cantidad_confirmada,
                 <fs_es_detalle_pedido>-cantidad_pendiente,
                 <fs_es_detalle_pedido>-porcentaje_cumplimiento,
                 <fs_es_detalle_pedido>-cantidad_recibida,
                 <fs_es_detalle_pedido>-cantidad_despachada,
                 <fs_es_detalle_pedido>-precio_exportacion.
        ENDIF.

        "+17.02.2023 - Omitir posiciones con indicador de posicion estadistica (STAPO) = X
        IF <fs_es_detalle_pedido>-posicion_es_estadistica = abap_true.
          CLEAR: <fs_es_detalle_pedido>-cantidad_pedida.
        ENDIF.

        "Datos TM{
        asignar_datos_tm( EXPORTING i_ti_datos_tm = ti_datos_tm CHANGING c_es_detalle_pedido = <fs_es_detalle_pedido> ).
        "}

        "Determinar estado logisticos adicionales{
        CONDENSE <fs_es_detalle_pedido>-fecha_fin_transporte NO-GAPS.
        IF <fs_es_detalle_pedido>-status_logistico < '09' AND
           <fs_es_detalle_pedido>-fecha_fin_transporte IS NOT INITIAL .
          <fs_es_detalle_pedido>-status_logistico = '09'.
        ENDIF.
        "}

        "Determinar si el pedido tiene por lo menos una factura
        IF <fs_es_detalle_pedido>-factura IS NOT INITIAL.
          pedido_con_factura = abap_true.
        ENDIF.

        "Cantidad maxima de entrega parcial
        IF i_consolidado = abap_true AND <fs_es_detalle_pedido>-entrega_parcial_posicion NE 'B'.
          cantidad_entregada_parcial =  0.
        ENDIF.

        IF i_consolidado = abap_true AND <fs_es_detalle_pedido>-indic_entrega_salida_completa = abap_false.
          status_entrega_final = abap_false.
        ENDIF.

        IF i_consolidado = abap_true AND <fs_es_detalle_pedido>-indicador_entrega_completa = abap_false.
          status_entrega_completa = abap_false.
        ENDIF.

        "Indicador de borrado
        IF i_consolidado = abap_true AND <fs_es_detalle_pedido>-indicador_borrado NE 'L'.
          indicador_borrado =  space.
        ENDIF.

        "Determinar estado logistico con mayor valor para el pedido
        IF es_ultimo_estado_logistico-status_logistico < <fs_es_detalle_pedido>-status_logistico.
          es_ultimo_estado_logistico = <fs_es_detalle_pedido>.
        ENDIF.
        "Asignar status_logistico a posiciones vacias
        IF <fs_es_detalle_pedido>-status_logistico IS INITIAL.
          <fs_es_detalle_pedido>-status_logistico = COND #( WHEN es_ultimo_estado_logistico-status_logistico IS NOT INITIAL THEN
                                                              es_ultimo_estado_logistico-status_logistico
                                                            WHEN <fs_es_grupo_pedido>-status_logistico IS NOT INITIAL THEN
                                                              <fs_es_grupo_pedido>-status_logistico
                                                          ).
        ENDIF.
        "Ajustar formato para campos tipo fecha - Requerido para API
        <fs_es_detalle_pedido>-fecha_entrega_cliente = condense( val = <fs_es_detalle_pedido>-fecha_entrega_cliente to = '' ).

        "Valida si solo tiene una entrega el pedido
        IF es_entrega_factura_referencia-entrega NE <fs_es_detalle_pedido>-entrega AND
           <fs_es_detalle_pedido>-entrega NE space.
          "Muestra entrega en en consolidado cuando el pedido tiene varias entregas asignadas
          IF <fs_es_detalle_pedido>-entrega > es_entrega_factura_referencia-entrega.
            es_entrega_factura_referencia-entrega = <fs_es_detalle_pedido>-entrega.
            "{Inicio SGR 21.11.2022 | Agregar datos de cabecera de la entrega para la los datos de TM
            es_entrega_factura_referencia-fecha_fin_transporte = <fs_es_detalle_pedido>-fecha_fin_transporte.
            es_entrega_factura_referencia-fu_tm                = <fs_es_detalle_pedido>-fu_tm.
            es_entrega_factura_referencia-numero_transporte    = <fs_es_detalle_pedido>-numero_transporte.
            "+SLS 08.03.2023:guia_transporte debe ser la asignada a la enrega que se muestra en consolidado{
            es_entrega_factura_referencia-guia_transporte = <fs_es_detalle_pedido>-guia_transporte.
            es_entrega_factura_referencia-fecha_entrega_cliente = <fs_es_detalle_pedido>-fecha_entrega_cliente.
            es_entrega_factura_referencia-hora_entrega_cliente = <fs_es_detalle_pedido>-hora_entrega_cliente.
            "}
            "{Fin SGR 21.11.2022 | Agregar datos de cabecera de la entrega para la los datos de TM
            "Conservar datos de posicion excepto numero de entrega para definir si es unica para el pedido
            es_entrega_factura_referencia = CORRESPONDING #( BASE ( es_entrega_factura_referencia ) <fs_es_detalle_pedido> EXCEPT entrega numero_transporte guia_transporte fu_tm ).
          ENDIF.
        ENDIF.

        "Asigna ultimo numero de factura para mostrar en consolidado/ [Hacer luego de la asignacion de la entrega para evitar perdia de datos ]
        IF es_entrega_factura_referencia-factura NE <fs_es_detalle_pedido>-factura AND <fs_es_detalle_pedido>-factura NE space.

          es_entrega_factura_referencia-factura = <fs_es_detalle_pedido>-factura.
          es_entrega_factura_referencia-cantidad_facturada = <fs_es_detalle_pedido>-cantidad_facturada.
          es_entrega_factura_referencia-valor_factura = <fs_es_detalle_pedido>-valor_factura.
          es_entrega_factura_referencia-valor_neto_factura = <fs_es_detalle_pedido>-valor_neto_factura.

        ENDIF.
        "+SLS 08.03.2023:guia_transporte debe ser la asignada a la enrega que se muestra en consolidado{
***        IF es_entrega_factura_referencia-guia_transporte IS INITIAL AND
***           <fs_es_detalle_pedido>-guia_transporte IS NOT INITIAL.
        IF es_entrega_factura_referencia-desc_sta_novedad_transportista IS INITIAL AND
           <fs_es_detalle_pedido>-desc_sta_novedad_transportista IS NOT INITIAL.

***          es_entrega_factura_referencia-guia_transporte = <fs_es_detalle_pedido>-guia_transporte.
***          es_entrega_factura_referencia-fecha_entrega_cliente = <fs_es_detalle_pedido>-fecha_entrega_cliente.
***          es_entrega_factura_referencia-hora_entrega_cliente = <fs_es_detalle_pedido>-hora_entrega_cliente.
          "}
          "{Inicio SGR 21.11.2022 | Agregar datos de cabecera de la entrega para la los datos de TM
*          es_pedido_entrega_referencia-numero_transporte = <fs_es_detalle_pedido>-numero_transporte.
*          es_pedido_entrega_referencia-fecha_fin_transporte = <fs_es_detalle_pedido>-fecha_fin_transporte.
*          es_pedido_entrega_referencia-fu_tm = <fs_es_detalle_pedido>-fu_tm.
          es_entrega_factura_referencia-desc_sta_novedad_transportista = <fs_es_detalle_pedido>-desc_sta_novedad_transportista.
          "{Fin SGR 21.11.2022 | Agregar datos de cabecera de la entrega para la los datos de TM
          es_entrega_factura_referencia-status_novedad_transportista = <fs_es_detalle_pedido>-status_novedad_transportista.
          es_entrega_factura_referencia-fecha_actual_transporte = <fs_es_detalle_pedido>-fecha_actual_transporte.

        ENDIF.

        "Se calcula individual para detallado
        IF i_consolidado = abap_false.
          <fs_es_detalle_pedido>-porcentaje_asignacion = ( <fs_es_detalle_pedido>-cantidad_asignada / cantidad_pedida ) * 100.
        ENDIF.
        <fs_es_detalle_pedido>-cantidad_pendiente = cantidad_pedida - <fs_es_detalle_pedido>-cantidad_despachada
                                                  - <fs_es_detalle_pedido>-cantidad_asignada.

        calcular_cantidad_pendiente(
          EXPORTING
            i_cantidad_pedida            = cantidad_pedida
            i_cantidad_entrega_acumulada = cantidad_entrega_acumulada
          CHANGING
            c_es_detalle_pedido          = <fs_es_detalle_pedido> ).

        calc_porcentaje_cumplimiento( EXPORTING i_cantidad_pedida   = cantidad_pedida
                                                i_cantidad_entrega_acumulada = cantidad_entrega_acumulada
                                      CHANGING  c_es_detalle_pedido = <fs_es_detalle_pedido> ).

        IF <fs_es_detalle_pedido>-motivo_rechazo IS INITIAL.
          status_cancelado = abap_false.
        ENDIF.

        TRY.

            es_um_erp = VALUE #( ti_um_erp[ KEY s_key vbeln =  <fs_es_detalle_pedido>-entrega posnr = <fs_es_detalle_pedido>-posicion_entrega ] OPTIONAL ).
            <fs_es_detalle_pedido>-matnr_embalaje = es_um_erp-vhilm.

          CATCH cx_sy_itab_line_not_found.
        ENDTRY.

        <fs_es_detalle_pedido>-impuestos = <fs_es_detalle_pedido>-pedido_impuesto_posicion.

        "Unidad de medida estatica{
        IF i_un_medida_estadistica = abap_true.
          aplicar_unidad_medida_estatica( EXPORTING  i_ti_catalog_alv = gti_catalogo_alv
                                          CHANGING   c_es_pedidos = <fs_es_detalle_pedido> ).
        ENDIF.
        "}

        "Limpiar valores de pedido para posiciones diferentes de la primera, solo en detalle
        IF <fs_es_detalle_pedido>-posicion_pedido = posicion_anterior AND
           primera_iteracion = abap_false.
          "Limpiar campos CALCULADOS que solo se requieren una vez por posicion de pedido
          "dado que cuando existen multiples entregas por posicion de pedido, los valores se duplican
          CLEAR: <fs_es_detalle_pedido>-cantidad_confirmada,
                 <fs_es_detalle_pedido>-cantidad_pendiente,
                 <fs_es_detalle_pedido>-porcentaje_cumplimiento,
                 <fs_es_detalle_pedido>-valor_factura,
                 <fs_es_detalle_pedido>-valor_neto_factura, <fs_es_detalle_pedido>-pago_clinete_impuestos.

          "Valores que solo aplica limpiar para el DETALLE, dado que en consolidado se limpian
          "Por que NO se estan totalizando
          IF i_consolidado = abap_false.
            CLEAR: <fs_es_detalle_pedido>-valor_neto_pedido.
          ENDIF.

        ENDIF.

        IF i_consolidado = abap_true.
          "Asignar valores para consolidado
          IF es_pedido_referencia-fecha_contabiliza_recepcion < <fs_es_detalle_pedido>-fecha_contabiliza_recepcion.
            es_pedido_referencia-fecha_contabiliza_recepcion = <fs_es_detalle_pedido>-fecha_contabiliza_recepcion.
          ENDIF.

          zclcxr1002_util=>totalizar_estructura( EXPORTING i_inicializar = primera_iteracion
                                                           "Campos que no se deben totalizar
                                                           i_r_excluir_campo = VALUE #( sign = 'I' option = 'EQ'
                                                                                        ( low = 'TOTAL_IMPUESTO_FACTURA' )
                                                                                        ( low = 'VALOR_NETO_FACTURA' )
                                                                                        ( low = 'VALOR_FACTURA' )
                                                                                        ( low = 'PORCENTAJE_CUMPLIMIENTO' )
                                                                                        ( low = 'PORCENTAJE_ASIGNACION' )
                                                                                        ( low = 'PAGO_CLINETE_IMPUESTOS' )
                                                                                        ( low = 'FECHA_FIN_TRANSPORTE' )
                                                                                        ( low = 'FECHA_ACTUAL_TRANSPORTE' )
                                                                                        ( low = 'CANTIDAD_ENTREGADA_PARCIAL' )
                                                                                      )
                                                           i_ti_campo_clave = VALUE #( ( name = 'PEDIDO' ) )
                                                 CHANGING c_es = <fs_es_detalle_pedido> ).

        ENDIF.

        primera_iteracion = abap_false.
        posicion_anterior = <fs_es_detalle_pedido>-posicion_pedido.

      ENDLOOP.
      "Indica que es la ultima posicion de la iteracion por posicion de pedido y la que tiene los totales
      <fs_es_detalle_pedido>-posicion_consolidada = abap_true.
      "Acumulado precio_exportacion
      IF i_consolidado = abap_true.
        <fs_es_grupo_pedido>-precio_exportacion = precio_exportacion.
      ENDIF.
      "Escenario entregas parciales o pedidos con y sin entrega asiganda
      "APLICA para consolidado unicamente cuando hay una unica entrega
      IF i_consolidado = abap_true.

        <fs_es_detalle_pedido>-porcentaje_asignacion = ( <fs_es_detalle_pedido>-cantidad_asignada / <fs_es_detalle_pedido>-cantidad_pedida ) * 100.

        "Verde: Los valores del pedido PRCD_ELEMENTS-KWERT para NETW y MWSI
        "       son iguales a VBRK-NETWR + VBRK-MWSBK
        "Rojo: Los valores calculados son diferentes
        <fs_es_grupo_pedido>-status_vl_pedido_vs_vl_factura =
                      COND #( WHEN (  ( pedido_con_factura = abap_true ) AND
                                      ( <fs_es_detalle_pedido>-valor_neto_pedido + <fs_es_detalle_pedido>-pedido_impuesto_posicion ) = ( <fs_es_grupo_pedido>-valor_neto_factura + <fs_es_grupo_pedido>-total_impuesto_factura )
                                   ) THEN
                                  icon_green_light
                              ELSE
                                  icon_red_light
                            ).

        calcular_cantidad_pendiente(
          EXPORTING
            i_cantidad_pedida            = <fs_es_detalle_pedido>-cantidad_pedida
            i_cantidad_entrega_acumulada = <fs_es_detalle_pedido>-cantidad_entrega
          CHANGING
            c_es_detalle_pedido          = <fs_es_detalle_pedido> ).

        "calcular de nuevo % cumplimiento con montos totalizados
        calc_porcentaje_cumplimiento( EXPORTING i_cantidad_pedida  = <fs_es_detalle_pedido>-cantidad_pedida
                                                i_cantidad_entrega_acumulada = <fs_es_detalle_pedido>-cantidad_entrega
                                      CHANGING c_es_detalle_pedido = <fs_es_detalle_pedido> ).

        "Tiene mas de una entrega el pedido por posicion = 'NA'
        "Muestra ULTIMA entrega en consolidado
        IF es_entrega_factura_referencia-entrega NE space.

          <fs_es_detalle_pedido>-entrega = es_entrega_factura_referencia-entrega.
          <fs_es_detalle_pedido>-numero_transporte = es_entrega_factura_referencia-numero_transporte.
          <fs_es_detalle_pedido>-guia_transporte = es_entrega_factura_referencia-guia_transporte.
          <fs_es_detalle_pedido>-fu_tm = es_entrega_factura_referencia-fu_tm.
          <fs_es_detalle_pedido>-fecha_creacion_entrega = es_entrega_factura_referencia-fecha_creacion_entrega.
          <fs_es_detalle_pedido>-fecha_entrega_cliente = es_entrega_factura_referencia-fecha_entrega_cliente.
          <fs_es_detalle_pedido>-hora_entrega_cliente = es_entrega_factura_referencia-hora_entrega_cliente.
          <fs_es_detalle_pedido>-fecha_fin_transporte = es_entrega_factura_referencia-fecha_fin_transporte.
          <fs_es_detalle_pedido>-status_novedad_transportista = es_entrega_factura_referencia-status_novedad_transportista.
          "{Inicio SGR 28.11.2022 - Agregar la descripción de la novedad del transportista en el consolidado
          <fs_es_detalle_pedido>-desc_sta_novedad_transportista = es_entrega_factura_referencia-desc_sta_novedad_transportista.
          "{Fin SGR 28.11.2022 - Agregar la descripción de la novedad del transportista en el consolidado
          <fs_es_detalle_pedido>-fecha_actual_transporte = es_entrega_factura_referencia-fecha_actual_transporte.

          "Datos de factura
          <fs_es_detalle_pedido>-factura = es_entrega_factura_referencia-factura.
          <fs_es_detalle_pedido>-cantidad_facturada = es_entrega_factura_referencia-cantidad_facturada.
          <fs_es_detalle_pedido>-valor_factura = es_entrega_factura_referencia-valor_factura.
          <fs_es_detalle_pedido>-valor_neto_factura = es_entrega_factura_referencia-valor_neto_factura.

          asignar_datos_tm( EXPORTING i_ti_datos_tm = ti_datos_tm CHANGING c_es_detalle_pedido = <fs_es_detalle_pedido> ).
        ELSE.
          CLEAR:  <fs_es_detalle_pedido>-clase_entrega, <fs_es_detalle_pedido>-fecha_creacion_entrega, <fs_es_detalle_pedido>-estado_movimiento_mercancia.
          <fs_es_detalle_pedido>-entregas_parciales = abap_true.
        ENDIF.
        "Estado Logistico
        <fs_es_detalle_pedido>-status_logistico = es_ultimo_estado_logistico-status_logistico.
        <fs_es_detalle_pedido>-status_pedido = es_ultimo_estado_logistico-status_pedido.
        <fs_es_detalle_pedido>-fecha_contabiliza_recepcion = es_pedido_referencia-fecha_contabiliza_recepcion.

        <fs_es_detalle_pedido>-indicador_borrado = indicador_borrado.
        <fs_es_detalle_pedido>-cantidad_entregada_parcial = cantidad_entregada_parcial.
        <fs_es_detalle_pedido>-status_entrega_final = status_entrega_final.
        <fs_es_detalle_pedido>-status_entrega_completa = status_entrega_completa.

      ENDIF.

      "Cuando el pedido tenga el flag de cancelado(todas las posiciones con motivo de rechazo)
      "Dejarlo en estatus 00
      IF status_cancelado = abap_true.
        MODIFY r_ti_pedidos_traslado
        FROM VALUE #( status_logistico = gc_pedidos_cancelados )
        USING KEY clave_secundaria
        TRANSPORTING status_logistico
        WHERE pedido = <fs_es_grupo_pedido>-pedido.
      ENDIF.

      MODIFY r_ti_pedidos_traslado
      FROM VALUE #( status_cancelado = status_cancelado
                    status_vl_pedido_vs_vl_factura = <fs_es_grupo_pedido>-status_vl_pedido_vs_vl_factura )
      USING KEY clave_secundaria
      TRANSPORTING status_cancelado status_vl_pedido_vs_vl_factura
      WHERE pedido = <fs_es_grupo_pedido>-pedido.

    ENDLOOP.

    IF i_consolidado = abap_true.

      "OjO, este SORT debe conservarce dado que es el que toma la posicion consolidada
      "Si se requiere modificar se debe tener presente la totalizacion de los valores,
      "que para el caso esta quedando en la ULTIMA posicion posicion_consolidada = X
      SORT r_ti_pedidos_traslado BY pedido posicion_consolidada DESCENDING.
      "Eliminar posiciones
      DELETE ADJACENT DUPLICATES FROM r_ti_pedidos_traslado COMPARING pedido.

      "Limpiar campos
      MODIFY r_ti_pedidos_traslado FROM VALUE #( clase_entrega = space
                                                 estado_movimiento_mercancia = space
                                                 posicion_entrega = space posicion_pedido = space
                                                 talla = space color = space
                                                 descripcion_color = space descripcion_talla = space
                                                 ean11 = space
                                                 matnr = space maktx = space )
      TRANSPORTING clase_entrega
                   posicion_entrega posicion_pedido talla color descripcion_color descripcion_talla
                   matnr maktx ean11
      WHERE pedido IS NOT INITIAL.
    ELSE.
      SORT r_ti_pedidos_traslado BY pedido posicion_pedido.
    ENDIF.

    "Aplicar filtros con data consolidada{
    IF i_fecha_fin_transporte IS NOT INITIAL.
      DELETE r_ti_pedidos_traslado WHERE fecha_fin_transporte NOT IN  i_fecha_fin_transporte.
    ENDIF.
    "}

    aplicar_formatos( CHANGING c_ti_pedidos = r_ti_pedidos_traslado ).

    APPEND LINES OF r_ti_pedidos_traslado TO gti_pedidos_monitor.

    e_rc = COND #( WHEN r_ti_pedidos_traslado IS INITIAL THEN
                    4
                   ELSE
                    0 "Goodbye!
                 ).

  ENDMETHOD.

  METHOD consultar_pedidos_traslado.

    TRY.
        SELECT DISTINCT *
        FROM zimmr1085_moni_pedido_traslado
        WHERE pedido IN @i_r_vbelp
        AND vkorg IN @i_r_vkorg
        AND vtweg IN @i_r_vtweg
        AND spart IN @i_r_spart
        AND werks IN @i_r_werks
        AND centro_receptor IN @i_r_centro_receptor
        AND clase_documento IN @i_r_auart
        AND grupo_compra    IN @i_r_ekgrp
        AND fecha_creacion_pedido IN @i_r_erdat
        AND fecha_preferente_entrega IN @i_r_vdatu
        AND motivo_pedido IN @i_r_bsgru
        AND pedido_cliente IN @i_r_bstnk
        AND entrega IN @i_r_vbele
        AND zz1_numeroguia_dlh IN @i_r_numero_guia
        AND numero_transporte  IN @i_r_numero_transporte
        ORDER BY pedido, posicion_pedido DESCENDING
        INTO CORRESPONDING FIELDS OF TABLE @r_ti_pedidos_traslado.

      CATCH cx_sy_open_sql_data_error cx_sy_open_sql_db INTO DATA(o_cx).
        go_log->set_o_cx_log( i_o_cx_log = o_cx ).
    ENDTRY.

    IF i_pedido_pendiente_x_entregar = abap_true.
      DELETE r_ti_pedidos_traslado WHERE entrega NE space.
    ENDIF.
  ENDMETHOD.


  METHOD leer_texto_mensaje_regalo.

    DATA: nombre_texto    TYPE tdobname,
          ti_lineas_texto TYPE tline_tab.

    nombre_texto = |{ c_es_detalle_pedido-pedido }{ c_es_detalle_pedido-posicion_pedido }2020_3|.

    CALL FUNCTION 'READ_TEXT'
      EXPORTING
        id                      = 'VASS'
        language                = sy-langu
        name                    = nombre_texto
        object                  = 'VAST'
      TABLES
        lines                   = ti_lineas_texto
      EXCEPTIONS
        id                      = 1
        language                = 2
        name                    = 3
        not_found               = 4
        object                  = 5
        reference_check         = 6
        wrong_access_to_archive = 7
        OTHERS                  = 8.

    IF sy-subrc IS INITIAL.

      LOOP AT ti_lineas_texto INTO DATA(es_texto).
        c_es_detalle_pedido-ecommerce_texto_del_mensaje = c_es_detalle_pedido-ecommerce_texto_del_mensaje && es_texto-tdline.
      ENDLOOP.

    ENDIF.

  ENDMETHOD.

  METHOD obtener_cantidad_pedidos.

    DATA(ti_pedidos_monitor) = gti_pedidos_monitor.

    DELETE ADJACENT DUPLICATES FROM ti_pedidos_monitor COMPARING pedido.

    r_cantidad_pedidos = lines( ti_pedidos_monitor ).

  ENDMETHOD.


  METHOD calcular_cantidad_pendiente.
    c_es_detalle_pedido-cantidad_pendiente = i_cantidad_pedida - i_cantidad_entrega_acumulada.

  ENDMETHOD.


  METHOD consulta_inventario_disponible.

    DATA: ti_materiales             TYPE gtp_ti_inventario_disponible,
          ti_materiales_exportacion TYPE gtp_ti_inventario_disponible,
          ti_materiales_mto         LIKE c_ti_pedido_posicion_completo.


    CHECK i_consolidado = abap_false.

    "Verifica autorización para consultar inventario
    IF i_verificar_autorizacion = abap_true.
      AUTHORITY-CHECK OBJECT 'ZR1085_1'
      ID 'ACTVT' FIELD '03'.

      CHECK sy-subrc IS INITIAL.
    ENDIF.

    LOOP AT c_ti_pedido_posicion_completo REFERENCE INTO DATA(r_es_pedido_posicion).

      IF r_es_pedido_posicion->tipo_posicion IN g_r_tipo_posicion_mto.
        APPEND CORRESPONDING #( r_es_pedido_posicion->* ) TO ti_materiales_mto.
      ELSEIF line_exists( gti_orgventa_canal_exportacion[ vkorg = r_es_pedido_posicion->vkorg vtweg = r_es_pedido_posicion->vtweg ] ).
        APPEND CORRESPONDING #( r_es_pedido_posicion->* EXCEPT pedido ) TO ti_materiales_exportacion.
      ELSE.
        APPEND CORRESPONDING #( r_es_pedido_posicion->* EXCEPT pedido segmento_necesidad ) TO ti_materiales.
      ENDIF.

    ENDLOOP.

    SORT ti_materiales BY matnr werks lgort.
    DELETE ADJACENT DUPLICATES FROM ti_materiales COMPARING ALL FIELDS.

    SORT ti_materiales_exportacion BY matnr werks lgort.
    DELETE ADJACENT DUPLICATES FROM ti_materiales_exportacion COMPARING ALL FIELDS.

    SORT ti_materiales_mto BY pedido posicion_pedido matnr werks lgort.
    DELETE ADJACENT DUPLICATES FROM ti_materiales_mto COMPARING ALL FIELDS.

    IF ti_materiales IS NOT INITIAL.

      SELECT
      FROM zisdr1085_inventariodisponible
      FIELDS matnr, werks, lgort, inventario_disponible, cantidad_entrega
      FOR ALL ENTRIES IN @ti_materiales
      WHERE matnr = @ti_materiales-matnr
      AND   werks = @ti_materiales-werks
      AND   lgort = @ti_materiales-lgort
      INTO CORRESPONDING FIELDS OF TABLE @r_ti_inventario_disponible.

    ENDIF.

    IF ti_materiales_exportacion IS NOT INITIAL.

      SELECT
      FROM zisdr1085_inventariodispo_lote
      FIELDS matnr, werks, lgort, charg AS segmento_necesidad, inventario_disponible, cantidad_entrega
      FOR ALL ENTRIES IN @ti_materiales_exportacion
      WHERE matnr = @ti_materiales_exportacion-matnr
      AND   werks = @ti_materiales_exportacion-werks
      AND   lgort = @ti_materiales_exportacion-lgort
      AND   charg = @ti_materiales_exportacion-segmento_necesidad(10)
      APPENDING CORRESPONDING FIELDS OF TABLE @r_ti_inventario_disponible.

    ENDIF.

    IF ti_materiales_mto IS NOT INITIAL.

      SORT ti_materiales_mto BY matnr werks lgort pedido posicion_pedido.
      DELETE ADJACENT DUPLICATES FROM ti_materiales_mto COMPARING matnr werks lgort pedido posicion_pedido.

      SELECT
      FROM @ti_materiales_mto AS material
      INNER JOIN mska AS _inventario ON
          _inventario~matnr = material~matnr
      AND _inventario~werks = material~werks
      AND _inventario~lgort = material~lgort
      AND _inventario~vbeln = material~pedido
      AND _inventario~posnr = material~posicion_pedido
      LEFT OUTER JOIN zpsdr1085_cantidad_mat_pedido   AS _inventarioentrega ON
          _inventarioentrega~pedido = _inventario~vbeln
      AND _inventarioentrega~posicion_pedido = _inventario~posnr
      AND _inventarioentrega~matnr           = _inventario~matnr
      AND _inventarioentrega~werks           = _inventario~werks
      AND _inventarioentrega~lgort           = _inventario~lgort
      FIELDS material~pedido, material~posicion_pedido,
      _inventario~matnr, _inventario~werks, _inventario~lgort,
      CASE
      WHEN cantidad_entrega IS NOT NULL THEN
***        ( SUM( _inventario~kalab ) - cantidad_entrega )
        ( _inventario~kalab  - cantidad_entrega )
      ELSE
***        SUM( _inventario~kalab )
         _inventario~kalab
      END AS inventario_disponible
*      GROUP BY  material~pedido,
*      _inventario~matnr, _inventario~werks, _inventario~lgort, cantidad_entrega
      APPENDING CORRESPONDING FIELDS OF TABLE @r_ti_inventario_disponible.

    ENDIF.

  ENDMETHOD.

  METHOD consultar_interlocutores.

    DATA:  ti_interlocutores TYPE gtp_ti_interlocutor.

    SELECT  pedido~vbeln AS pedido,
            "Tiendas
            tiendas~kunnr                 AS tienda,
            tiendas~name1                 AS nombre_tienda,
            tiendas~stcd1                 AS id_fiscal_tienda,
            tiendas~land1                 AS pais_tienda,
            tiendas~tel_number            AS telefono_tienda,
            tiendas~mc_street             AS direccion_tienda,
            tiendas~transpzone            AS zonatransporte_tienda,
            "Solicitante
            solicitante~kunnr             AS solicitante,
            solicitante~name1             AS nombre_solicitante,
            solicitante~stcd1             AS id_fiscal_solicitante,
            solicitante~land1             AS pais_solicitante,
            solicitante~city1             AS ciudad_solicitante,
            solicitante~tel_number        AS telefono_solicitante,
            solicitante~mc_street         AS direccion_solicitante,
            solicitante~transpzone        AS zonatransporte_solicitante,
            "Responsable pago
            responsable_pago~kunnr        AS responsable_pago,
            responsable_pago~name1        AS nombre_responsable_pago,
            responsable_pago~stcd1        AS id_fiscal_responsable_pago,
            responsable_pago~land1        AS pais_responsable_pago,
            responsable_pago~city1        AS ciudad_responsable_pago,
            responsable_pago~tel_number   AS telefono_responsable_pago,
            responsable_pago~mc_street    AS direccion_responsable_pago,
            responsable_pago~transpzone   AS zonatransporte_resp_pago,
            "Destinatario
            destinatario~kunnr            AS destinatario,
            destinatario~name1            AS nombre_destinatario,
            destinatario~stcd1            AS id_fiscal_destinatario,
            destinatario~land1            AS pais_destinatario,
            destinatario~city1            AS ciudad_destinatario,
            destinatario~tel_number       AS telefono_destinatario,
            destinatario~mc_street        AS direccion_destinatario,
            responsable_pago~transpzone   AS zonatransporte_destinatario,
            "Encargado Comercial
            encargadocomercial~kunnr      AS encargado_comercial,
            encargadocomercial~name1      AS nombre_encargado_comercial,
            encargadocomercial~stcd1      AS id_fiscal_encargado_comercial,
            encargadocomercial~land1      AS pais_encargado_comercial,
            encargadocomercial~city1      AS ciudad_encargado_comercial,
            encargadocomercial~tel_number AS telefono_encargado_comercial,
            encargadocomercial~mc_street  AS direccion_encargado_comercial
        FROM vbak AS pedido
            LEFT JOIN zisdr1085_interlo_tienda       AS tiendas                  ON tiendas~pedido            = pedido~vbeln
            LEFT JOIN zisdr1085_interlo_solicitante  AS solicitante              ON solicitante~pedido        = pedido~vbeln
            LEFT JOIN zisdr1085_interlo_resp_pago    AS responsable_pago         ON responsable_pago~pedido   = pedido~vbeln
            LEFT JOIN zisdr1085_interlo_destinatario AS destinatario             ON destinatario~pedido       = pedido~vbeln
            LEFT JOIN zisdr1085_interlo_encomercial  AS encargadocomercial       ON encargadocomercial~pedido = pedido~vbeln
        FOR ALL ENTRIES IN @i_ti_pedido_cabecera
        WHERE pedido~vbeln = @i_ti_pedido_cabecera-pedido
          AND responsable_pago~kunnr IN @i_r_responsable_de_pago
          AND encargadocomercial~kunnr IN @i_r_encargado_comercial
        INTO CORRESPONDING FIELDS OF TABLE @ti_interlocutores.

    LOOP AT c_ti_pedidos_venta ASSIGNING FIELD-SYMBOL(<fs_es_pedido_venta>).
      ASSIGN ti_interlocutores[ KEY clave_pedido pedido = <fs_es_pedido_venta>-pedido ] TO FIELD-SYMBOL(<fs_es_interlocutores>).

      IF sy-subrc = 0.
        <fs_es_pedido_venta> = CORRESPONDING #( BASE ( <fs_es_pedido_venta> ) <fs_es_interlocutores> EXCEPT pedido ).
        UNASSIGN: <fs_es_interlocutores>.
      ELSE.
        DELETE TABLE c_ti_pedidos_venta FROM <fs_es_pedido_venta>.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.

  METHOD asignar_interlocutor_pedtrasla.

    DATA: r_pedidos_interlocutor TYPE RANGE OF ekko-ebeln.

    CHECK g_r_cldc_traslado_interlocutor IS NOT INITIAL.

    r_pedidos_interlocutor = VALUE #( FOR es_pedido_cabecera IN i_ti_pedido_cabecera
                                                              WHERE ( clase_documento IN g_r_cldc_traslado_interlocutor )
                                        ( sign = 'I' option = 'EQ' low = es_pedido_cabecera-pedido )
                                     ).

    CHECK r_pedidos_interlocutor IS NOT INITIAL.

    TRY.
        consultar_interlocutor_pedtras(
            EXPORTING
                i_r_filtros = cl_shdb_seltab=>combine_seltabs( it_named_seltabs = VALUE #( ( name = 'EBELN' dref = REF #( r_pedidos_interlocutor ) ) ) )
            IMPORTING
                e_ti_interlocutor_ped_traslado = DATA(ti_interlocutor_ped_traslado)
        ).

        LOOP AT ti_interlocutor_ped_traslado REFERENCE INTO DATA(r_interlocutor).

          LOOP AT c_ti_pedidos_traslado ASSIGNING FIELD-SYMBOL(<fs_es_pedido_traslado>)
                                        USING KEY clave_secundaria
                                        WHERE pedido = r_interlocutor->pedido.

            <fs_es_pedido_traslado> = CORRESPONDING #( BASE ( <fs_es_pedido_traslado> ) r_interlocutor->* EXCEPT pedido ).

          ENDLOOP.

        ENDLOOP.

      CATCH cx_amdp_execution_failed INTO DATA(o_cx).
        go_log->set_o_cx_log( i_o_cx_log = o_cx ).
      CATCH cx_shdb_exception.
        "handle exception
    ENDTRY.
  ENDMETHOD.

  METHOD consultar_interlocutor_pedtras BY DATABASE PROCEDURE FOR HDB
                                        LANGUAGE SQLSCRIPT
                                        OPTIONS READ-ONLY
                                        USING ekko kna1 t001w adrc.

    DECLARE mandante varchar(3) := session_context ('CLIENT');
    DECLARE lenguaje_sistema varchar(2) := session_context ('LOCALE_SAP');

    ti_pedidos_traslado_completo =
    SELECT mandt, ebeln, bukrs, ihrez
    FROM ekko
    WHERE mandt = :mandante
    WITH HINT ( IGNORE_PLAN_CACHE );

    ti_pedidos_traslado = APPLY_FILTER ( :ti_pedidos_traslado_completo , :i_r_filtros );

    ti_cliente =
    SELECT mandt, kunnr, _cliente.name1, stcd1, land1, telf1, ort01, adrnr, street, _direccion.transpzone
    FROM kna1 as _cliente
    INNER JOIN adrc as _direccion ON
        _direccion.client = _cliente.mandt
    AND _direccion.addrnumber = _cliente.adrnr
    WHERE _cliente.mandt = :mandante;

    --Tiendas
    ti_tiendas =
    SELECT ebeln as pedido, lpad( _centros.werks, 10, 0 ) as tienda, _centros.name1 AS nombre_tienda,
           _cliente.stcd1 AS id_fiscal_tienda, _cliente.land1 AS pais_tienda,
           _cliente.telf1 AS telefono_tienda, _cliente.street AS  direccion_tienda,
           _cliente.transpzone AS  zonatransporte_tienda
    FROM :ti_pedidos_traslado AS _pedido_cabecera
    INNER JOIN t001w AS _centros ON
        _centros.mandt = _pedido_cabecera.mandt
    AND _centros.werks = _pedido_cabecera.ihrez
    AND SUBSTRING ( _centros.vlfkz, 1, 1 ) = 'A'
    INNER JOIN :ti_cliente AS _cliente ON
        _cliente.mandt = _centros.mandt
    AND _cliente.kunnr = lpad( _centros.werks, 10, 0 )
    WITH HINT ( IGNORE_PLAN_CACHE );

    --Responsable pago
    ti_responsable_pago =
    SELECT ebeln as pedido, lpad(_pedido_cabecera.bukrs, 10, 0) as responsable_pago, _cliente.name1 AS nombre_responsable_pago,
           _cliente.stcd1 AS id_fiscal_responsable_pago, _cliente.land1 AS pais_responsable_pago, _cliente.ort01 AS ciudad_responsable_pago,
           _cliente.telf1 AS telefono_responsable_pago, _cliente.street AS  direccion_responsable_pago,
           _cliente.transpzone AS  zonatransporte_resp_pago
    FROM :ti_pedidos_traslado AS _pedido_cabecera
    INNER JOIN :ti_cliente AS _cliente ON
        _cliente.mandt = _pedido_cabecera.mandt
    AND _cliente.kunnr = lpad(_pedido_cabecera.bukrs, 10, 0)
    WITH HINT ( IGNORE_PLAN_CACHE );

    e_ti_interlocutor_ped_traslado =
    SELECT  _pedidos_traslado.ebeln AS pedido,
            --Tienda
            tienda, nombre_tienda, id_fiscal_tienda,
            pais_tienda, telefono_tienda,
            direccion_tienda, zonatransporte_tienda,
            --Solicitante    ,
            '' AS   solicitante,
            '' AS   nombre_solicitante              ,
            '' AS   id_fiscal_solicitante           ,
            '' AS   pais_solicitante,
            '' AS   ciudad_solicitante              ,
            '' AS   telefono_solicitante            ,
            '' AS   direccion_solicitante           ,
            '' AS   zonatransporte_solicitante      ,
            --Responsable pago
            responsable_pago,
            nombre_responsable_pago,
            id_fiscal_responsable_pago,
            pais_responsable_pago,
            ciudad_responsable_pago,
            telefono_responsable_pago,
            direccion_responsable_pago,
            zonatransporte_resp_pago,
            --Destinatario
            '' AS   destinatario,
            '' AS   nombre_destinatario             ,
            '' AS   id_fiscal_destinatario          ,
            '' AS   pais_destinatario,
            '' AS   ciudad_destinatario             ,
            '' AS   telefono_destinatario           ,
            '' AS   direccion_destinatario          ,
            '' AS   zonatransporte_destinatario     ,
            --Encargado Comercial
            '' AS   encargado_comercial             ,
            '' AS   nombre_encargado_comercial      ,
            '' AS   id_fiscal_encargado_comercial   ,
            '' AS   pais_encargado_comercial        ,
            '' AS   ciudad_encargado_comercial      ,
            '' AS   telefono_encargado_comercial    ,
            '' AS   direccion_encargado_comercial

    FROM :ti_pedidos_traslado AS _pedidos_traslado
    LEFT JOIN :ti_tiendas AS _tiendas ON
    _tiendas.pedido = _pedidos_traslado.ebeln
    LEFT JOIN :ti_responsable_pago AS _responsable_pago ON
    _responsable_pago.pedido = _pedidos_traslado.ebeln
    ;

    e_ti_interlocutor_ped_traslado =
    SELECT *
    FROM :e_ti_interlocutor_ped_traslado
    WHERE ( tienda != '' OR tienda IS NOT NULL )
    OR   ( responsable_pago != '' OR responsable_pago IS NOT NULL );

  ENDMETHOD.


  METHOD asignar_factura_pedidotraslado.

    DATA: r_entrega TYPE RANGE OF likp-vbeln,
          r_pedidos TYPE RANGE OF ekko-ebeln.

    CHECK i_ti_entregas_pedido IS NOT INITIAL.

    r_pedidos = VALUE #( FOR es_pedido_cabecera IN i_ti_pedido_cabecera
                                                WHERE ( clase_documento IN g_r_cldc_traslado_interlocutor )
                        ( sign = 'I' option = 'EQ' low = es_pedido_cabecera-pedido )
                       ).

    CHECK r_pedidos IS NOT INITIAL.

    r_entrega = VALUE #( FOR es_entrega IN i_ti_entregas_pedido
                                                WHERE ( pedido IN r_pedidos )
                            ( sign = 'I' option = 'EQ' low = es_entrega-entrega )
                       ).

    SORT r_entrega BY low.
    DELETE ADJACENT DUPLICATES FROM r_entrega COMPARING low.

    CHECK r_entrega IS NOT INITIAL.

    SELECT
    FROM vbrk AS _factura_cabecera
    INNER JOIN vbrp AS _factura_posicion
    INNER JOIN lips AS _entrega ON
        _entrega~vbeln = _factura_posicion~vgbel
    AND _entrega~posnr = _factura_posicion~vgpos
    ON _factura_posicion~vbeln = _factura_cabecera~vbeln
    FIELDS _factura_cabecera~vbeln AS factura, _factura_posicion~vgbel AS entrega, _factura_posicion~vgpos AS posicion_entrega,
           _factura_cabecera~fkdat AS fecha_factura,
           _factura_posicion~netwr AS valor_factura, _factura_posicion~fklmg AS cantidad_facturada,
           _factura_posicion~netwr AS valor_neto_factura
    FOR ALL ENTRIES IN @r_entrega
    WHERE _factura_cabecera~sfakn = @space
    AND   _factura_cabecera~fksto = @space
    AND   _entrega~uecha          NE @space
    AND   _factura_posicion~vgbel = @r_entrega-low
    INTO TABLE @DATA(ti_facturas_pedido_traslado).

    "Asigna solo la ultima factura cuando son varias facturas por posicion de pedido
    SORT ti_facturas_pedido_traslado BY factura entrega.
    "Totalizar valores de la factura por posicion
    LOOP AT ti_facturas_pedido_traslado REFERENCE INTO DATA(r_es_factura).

      zclcxr1002_util=>totalizar_estructura( EXPORTING
                                                i_ti_campo_clave = VALUE #( ( name = 'FACTURA' ) )
                                             CHANGING
                                                c_es = r_es_factura->* ).
    ENDLOOP.
    SORT ti_facturas_pedido_traslado BY factura entrega cantidad_facturada DESCENDING.
    DELETE ADJACENT DUPLICATES FROM ti_facturas_pedido_traslado COMPARING factura entrega.

    LOOP AT ti_facturas_pedido_traslado REFERENCE INTO r_es_factura.

      LOOP AT c_ti_pedidos_traslado ASSIGNING FIELD-SYMBOL(<fs_es_pedido_traslado>)
                                        USING KEY clave_entrega
                                        WHERE entrega = r_es_factura->entrega.

        <fs_es_pedido_traslado> = CORRESPONDING #( BASE ( <fs_es_pedido_traslado> ) r_es_factura->*
                                                   EXCEPT entrega posicion_entrega valor_factura cantidad_facturada valor_neto_factura ).

      ENDLOOP.

      CHECK sy-subrc IS INITIAL.

      <fs_es_pedido_traslado>-valor_factura = r_es_factura->valor_factura.
      <fs_es_pedido_traslado>-cantidad_facturada  = r_es_factura->cantidad_facturada.
      <fs_es_pedido_traslado>-valor_neto_factura = r_es_factura->valor_neto_factura.

    ENDLOOP.

  ENDMETHOD.


  METHOD completar_valores_factura.

    CHECK c_ti_factura_pedido IS NOT INITIAL AND
    ( g_r_cl_factura_enviada_asn IS NOT INITIAL OR g_r_cl_factura_impresa IS NOT INITIAL ).

    SORT c_ti_factura_pedido BY factura.

    SELECT
    FROM nast AS _mensaje
    FIELDS DISTINCT objky AS factura, kschl, _mensaje~vstat
    FOR ALL ENTRIES IN @c_ti_factura_pedido
    WHERE _mensaje~objky = @c_ti_factura_pedido-factura_objky
      AND ( _mensaje~kschl  IN @g_r_cl_factura_impresa OR _mensaje~kschl  IN @g_r_cl_factura_enviada_asn )
    INTO TABLE @DATA(ti_mensajes_factura).

    LOOP AT c_ti_pedidos_venta REFERENCE INTO DATA(r_es_pedido).

      CHECK r_es_pedido->factura IS NOT INITIAL.

      r_es_pedido->status_envio_asn = icon_light_out.
      r_es_pedido->status_impresion_factura = icon_light_out.

      LOOP AT ti_mensajes_factura ASSIGNING FIELD-SYMBOL(<fs_es_mensaje_factura>) WHERE factura = r_es_pedido->factura.

        IF <fs_es_mensaje_factura>-kschl IN g_r_cl_factura_enviada_asn.
          r_es_pedido->status_envio_asn = COND #( WHEN <fs_es_mensaje_factura>-vstat = '1' THEN "Procesado Ok
                                                      icon_green_light
                                                  WHEN <fs_es_mensaje_factura>-vstat = '2' THEN "Procesado con error
                                                      icon_red_light
                                                  WHEN <fs_es_mensaje_factura>-vstat = '0' THEN "Procesado parcialmente
                                                      icon_yellow_light
                                                  ELSE
                                                      icon_light_out
                                                ).
        ENDIF.

        IF <fs_es_mensaje_factura>-kschl IN g_r_cl_factura_impresa.
          r_es_pedido->status_impresion_factura = COND #( WHEN <fs_es_mensaje_factura>-vstat = '1' THEN
                                                              icon_green_light
                                                          WHEN <fs_es_mensaje_factura>-vstat = '2' THEN
                                                              icon_red_light
                                                          WHEN <fs_es_mensaje_factura>-vstat = '0' THEN
                                                              icon_yellow_light
                                                          ELSE
                                                              icon_light_out
                                                ).
        ENDIF.

      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.

ENDCLASS.