CLASS zclppr1157_productos_quimicos DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    CONSTANTS: gc_ricefw                   TYPE zzedricefw VALUE 'R1157',
               gc_modulo                   TYPE zzedmodulo VALUE 'PP',
               gc_clase_mensajes           TYPE symsgid VALUE 'ZPP01',
               gc_huso_horario             TYPE timezone VALUE 'UTC',
               gc_objecto                  TYPE  balobj_d VALUE 'ZPP_1',
               gc_subobjecto               TYPE  balsubobj VALUE 'ZR1157_1',
               gc_lista_mat_sin_actualizar TYPE ztppi1209_1-ind_actualizado VALUE '0',
               gc_lista_material_ok        TYPE ztppi1209_1-ind_actualizado VALUE '1',
               gc_lista_mat_en_error       TYPE ztppi1209_1-ind_actualizado VALUE '9'.


    TYPES: gtp_r_centro             TYPE RANGE OF ztppi1209_1-centro,
           gtp_r_fecha              TYPE RANGE OF ztppi1209_1-fecha_envio,
           gtp_r_material           TYPE RANGE OF ztppi1209_1-material_generico,
           gtp_r_color              TYPE RANGE OF ztppi1209_1-color,
           gtp_r_ind_actualizacion  TYPE RANGE OF ztppi1209_1-ind_actualizado,
           gtp_r_alternativa_escala TYPE RANGE OF ztppi1209_1-alternativa_escala,
           gtp_r_estado_lista       TYPE RANGE OF ztppi1209_1-ind_actualizado.

    TYPES: BEGIN OF gtp_es_datos_infotint,
             procesar              TYPE zed_procesar_registro,
             estado                TYPE zed_estado_lista_infotint,
             centro                TYPE ztppi1209_1-centro,
             material_variante     TYPE zed_materialvar,
             color                 TYPE ztppi1209_1-color,
             alternativa_escala    TYPE ztppi1209_1-alternativa_escala,
             componente            TYPE zed_componente,
             material_generico     TYPE zed_material_generico_legado,
             material_generico_sap TYPE zed_materialgenerico_sap,
             fecha_envio           TYPE ztppi1209_1-fecha_envio,
             hora_envio            TYPE ztppi1209_1-hora_envio,
             cant_mapeo            TYPE ztppi1209_1-cant_mapeo,
             unidad_medida         TYPE ztppi1209_1-unidad_medida,
             usuario               TYPE ztppi1209_1-usuario,
             mensaje               TYPE ztppi1209_1-mensaje,
             ind_actualizado       TYPE ztppi1209_1-ind_actualizado,
             peso_tanda            TYPE ztppi1209_1-peso_tanda,
             maquina               TYPE ztppi1209_1-maquina,
             usuario_actualizacion TYPE ztppi1209_1-usuario_actualizacion,
             fecha_actualizacion   TYPE ztppi1209_1-fecha_actualizacion,
             hora_actualizacion    TYPE ztppi1209_1-hora_actualizacion,
             variantes_sap         TYPE ztppi1209_1-variantes_sap,
             size1                 TYPE mara-size1,
             mtart                 TYPE mara-mtart,
             peticion_borrado_mat  TYPE mara-lvorm,
           END OF gtp_es_datos_infotint,

           BEGIN OF gtp_es_lm_cabecera,
             matnr            TYPE mara-matnr,
             werks            TYPE werks_d,
             stlan            TYPE mast-stlan,
             stlal            TYPE mast-stlal,
             mtart            TYPE mara-mtart,
             bmeng            TYPE stko-bmeng,
             bmeng_no_decimal TYPE char17,
             stktx            TYPE stko-stktx,
           END OF gtp_es_lm_cabecera,

           BEGIN OF gtp_es_lista_material,
             matnr            TYPE mara-matnr,
             werks            TYPE werks_d,
             stlan            TYPE mast-stlan,
             stlal            TYPE mast-stlal,
             material_lista   TYPE mara-matnr,
             mtart            TYPE mara-mtart,
             componente       TYPE idnrk,
             bmeng            TYPE stko-bmeng,
             stktx            TYPE stko-stktx,
             postp            TYPE stpo-postp,
             posnr            TYPE stpo-posnr,
             menge            TYPE stpo-menge,
             stlkn            TYPE stpo-stlkn,
             stpoz            TYPE stpo-stpoz,
             stlnr            TYPE stpo-stlnr,
             datuv            TYPE stpo-datuv,
             fsh_vmkz         TYPE stpo-fsh_vmkz,
             rel_cost         TYPE stpo-sanka,
             ind_borrado_stpo TYPE stpo-lkenz,
             ind_borrado_stas TYPE stpo-lkenz,
           END OF gtp_es_lista_material,

           BEGIN OF gtp_es_componentes_sap,
             componente           TYPE mara-matnr,
             werks                TYPE marc-werks,
             mtart                TYPE mara-mtart,
             peticion_borrado_mat TYPE mara-lvorm,
           END OF gtp_es_componentes_sap,

           BEGIN OF gtp_es_componente_variantes,
             componente  TYPE mara-matnr,
             r_variantes TYPE gtp_r_material,
           END OF gtp_es_componente_variantes,

           BEGIN OF gtp_es_datos_actualizar_lm,
             fecha_valida_desde TYPE datuv_bi,
             componentes        TYPE gtp_r_material,
             ti_componentes     TYPE STANDARD TABLE OF stpo_api03 WITH EMPTY KEY,
             ti_variantes_bomd  TYPE STANDARD TABLE OF fsh_s_bomvd_api WITH DEFAULT KEY,
           END OF gtp_es_datos_actualizar_lm.

    TYPES: gtp_ti_lista_infotint       TYPE STANDARD TABLE OF gtp_es_datos_infotint
                                                        WITH NON-UNIQUE KEY procesar estado centro material_variante color
                                                        WITH NON-UNIQUE SORTED KEY key_agrupador COMPONENTS centro material_variante color alternativa_escala,
           gtp_ti_datos_actualizar_lm  TYPE STANDARD TABLE OF gtp_es_datos_actualizar_lm WITH NON-UNIQUE KEY fecha_valida_desde,
           gtp_ti_lista_material       TYPE STANDARD TABLE OF gtp_es_lista_material WITH EMPTY KEY,
           gtp_ti_componente_variantes TYPE STANDARD TABLE OF gtp_es_componente_variantes WITH EMPTY KEY,
           gtp_ti_componentes_sap      TYPE STANDARD TABLE OF gtp_es_componentes_sap WITH EMPTY KEY.

    CLASS-DATA: go_log                       TYPE REF TO zclcxr1002_log_aplicacion,
                go_parametros                TYPE REF TO zclcxr1000_parametros,
                gti_lista_infotint           TYPE gtp_ti_lista_infotint,
                ges_lm_infotint_en_proceso   TYPE REF TO data,
                gr_centro                    TYPE gtp_r_centro,
                gr_fecha_envio               TYPE gtp_r_fecha,
                gr_material_legado           TYPE gtp_r_material,
                gr_material                  TYPE gtp_r_material,
                gr_indicador_actualizacion   TYPE gtp_r_ind_actualizacion,
                gr_color                     TYPE gtp_r_color,
                gr_alternativa_escala        TYPE gtp_r_alternativa_escala,
                g_actualizacion_lm_terminada TYPE flag,
                g_lm_bloqueada               TYPE flag,
                g_nombre_job                 TYPE tbtcjob-jobname VALUE 'ZPPR1157_R1096_LM',
                g_pendiente_procesar         TYPE flag,
                g_cantidad_total_procesos    TYPE i VALUE 5.

    DATA: go_alv                      TYPE REF TO cl_gui_alv_grid,
          go_dock_container           TYPE REF TO cl_gui_docking_container,
          gr_tipo_material            TYPE RANGE OF mara-mtart,
          gr_material_quimico_acabado TYPE RANGE OF mara-matnr,
          gr_tipo_posicion_lista      TYPE RANGE OF stpo-postp,
          gr_cantidad_componente      TYPE RANGE OF kmpmg_bi,
          g_cronomarcador_utc         TYPE tzntstmps,
          gr_sufijo_mateiral          TYPE RANGE OF string.

    CLASS-DATA: gr_utilizacion_lista_mat TYPE RANGE OF mast-stlan,
                gr_tipo_material_quimico TYPE RANGE OF mara-mtart.

    METHODS:
      constructor,
      cargar_parametros,
      iniciar_tratamiento_infotint
        IMPORTING
          VALUE(i_r_centro)                TYPE gtp_r_centro
          VALUE(i_r_fecha_envio)           TYPE gtp_r_fecha
          VALUE(i_r_material_legado)       TYPE gtp_r_material
          VALUE(i_r_material)              TYPE gtp_r_material
          VALUE(i_r_color)                 TYPE gtp_r_color
          VALUE(i_r_alternativa)           TYPE gtp_r_alternativa_escala
          VALUE(i_visualizar_duplicados)   TYPE flag OPTIONAL
          i_pendiente_procesar             TYPE flag
          i_actualizar_registros           TYPE flag OPTIONAL
          VALUE(i_ejecutar_jobs_agrupados) TYPE flag OPTIONAL
          i_r_indicador_actualizacion      TYPE gtp_r_ind_actualizacion,
      procesar_registros_infotint,
      visualizar_datos
        IMPORTING
          i_reporte TYPE syrepid
          i_layout  TYPE disvariant-variant,
      modificar_catalogo
        CHANGING
          c_ti_catalogo TYPE lvc_t_fcat,
      leer_registros_infotint
        IMPORTING
          VALUE(i_r_centro)           TYPE gtp_r_centro
          VALUE(i_r_fecha_envio)      TYPE gtp_r_fecha
          VALUE(i_r_material_legado)  TYPE gtp_r_material
          VALUE(i_r_material)         TYPE gtp_r_material
          VALUE(i_r_color)            TYPE gtp_r_color
          VALUE(i_r_alternativa)      TYPE gtp_r_alternativa_escala
          i_r_indicador_actualizacion TYPE gtp_r_ind_actualizacion
          i_pendiente_procesar        TYPE flag
        RETURNING
          VALUE(r_ti_lista_infotint)  TYPE gtp_ti_lista_infotint,
      validar_consistencia_de_datos
        CHANGING
          c_ti_lista_infotint TYPE gtp_ti_lista_infotint,
      actualizar_lista_materiales
        CHANGING
          c_ti_lista_infotint TYPE gtp_ti_lista_infotint,
      registrar_modificaciones
        EXPORTING
          e_es_log            TYPE bal_s_lgnm
        CHANGING
          c_ti_lista_infotint TYPE gtp_ti_lista_infotint,
      consultar_lista_material
        IMPORTING
          i_ti_lista_infotint         TYPE gtp_ti_lista_material
          i_incluir_material_variante TYPE flag OPTIONAL
          i_solo_componentes_quimicos TYPE flag OPTIONAL
          i_descartar_reg_eliminados  TYPE flag OPTIONAL
        EXPORTING
          e_es_lm_cabecera            TYPE zclppr1157_productos_quimicos=>gtp_es_lm_cabecera
          e_ti_lista_material         TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_material
          e_ti_lm_variantes           TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_material
          e_ultima_posicion           TYPE numc4,
      consultar_lista_material_db
        IMPORTING
          i_ti_lista_infotint TYPE gtp_ti_lista_material
        EXPORTING
          e_ti_lista_material TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_material,
      consultar_componentes
        IMPORTING
          VALUE(i_ti_lista_infotint) TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_infotint
        RETURNING
          VALUE(r_ti_componentes)    TYPE gtp_ti_componentes_sap,
      respuesta_actualizacion_lm
        IMPORTING
          p_task TYPE clike,
      ejec_consistencia_lm_masivo
        CHANGING
          c_ti_lista_infotint TYPE gtp_ti_lista_infotint,
      visualizar_lm_con_duplicados
        CHANGING
          c_ti_lista_infotint TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_infotint.

    "Eventos ALV
    METHODS:
      evento_hotspot FOR EVENT hotspot_click OF cl_gui_alv_grid
        IMPORTING
          e_row_id
          e_column_id,
      evento_tool_bar FOR EVENT toolbar  OF cl_gui_alv_grid
        IMPORTING
          e_interactive
          e_object
          sender,
      evento_user_comand FOR EVENT user_command  OF cl_gui_alv_grid
        IMPORTING
          e_ucomm,
      evento_data_change FOR EVENT data_changed OF cl_gui_alv_grid
        IMPORTING
          er_data_changed
          e_onf4
          e_onf4_before
          e_onf4_after
          e_ucomm
          sender,
      evento_data_change_finish FOR EVENT data_changed_finished OF cl_gui_alv_grid
        IMPORTING
          e_modified
          et_good_cells
          sender.

    CLASS-METHODS:
      visualizar_log
        IMPORTING
          VALUE(i_id_log) TYPE zed_id_mensaje_externo DEFAULT '*',
      ejecutar_consistencia_lm
        IMPORTING
          i_tiempo_espera_extendido  TYPE flag DEFAULT abap_false
          VALUE(i_nombre_job)        TYPE tbtcjob-jobname DEFAULT g_nombre_job
          VALUE(i_es_lista_infotint) TYPE gtp_es_datos_infotint,
      validar_bloqueo_usuario
        IMPORTING
          VALUE(i_es_lista_infotint) TYPE zclppr1157_productos_quimicos=>gtp_es_datos_infotint,
      ejecutar_proeso_agrupado_job
        IMPORTING
          VALUE(i_r_fecha_envio)     TYPE gtp_r_fecha
          VALUE(i_r_material_legado) TYPE gtp_r_material OPTIONAL
        CHANGING
          c_ti_lista_infotint        TYPE gtp_ti_lista_infotint,
      generar_fecha
        IMPORTING
          i_fecha        TYPE stpo-datuv
        RETURNING
          VALUE(r_fecha) TYPE datuv_bi.


  PROTECTED SECTION.

  PRIVATE SECTION.

    CLASS-DATA: g_cantidad_intento_bloqueo TYPE i VALUE 1.

    METHODS:
      get_id_log
        IMPORTING
          VALUE(i_es_lista_infotint) TYPE zclppr1157_productos_quimicos=>gtp_es_datos_infotint
        RETURNING
          VALUE(r_id_log)            TYPE string,
      eliminar_componantes_variante
        IMPORTING
          i_incluir_todas_las_variantes       TYPE flag
          i_tiempo_espera_extendido           TYPE flag DEFAULT abap_false
          VALUE(i_ti_componente_x_variantes)  TYPE gtp_ti_componente_variantes OPTIONAL
          VALUE(i_ti_posicion_lista_eliminar) TYPE t_stpo_api03 OPTIONAL
        CHANGING
          VALUE(c_es_lista_infotint)          TYPE gtp_es_datos_infotint
          c_ti_lista_infotint                 TYPE gtp_ti_lista_infotint OPTIONAL,
      eliminar_componantes_generico
        IMPORTING
          VALUE(i_r_componente)               TYPE gtp_r_material
          VALUE(i_ti_posicion_lista_eliminar) TYPE t_stpo_api03
          i_tiempo_espera_extendido           TYPE flag DEFAULT abap_false
        CHANGING
          c_es_lista_infotint                 TYPE gtp_es_datos_infotint,
      asignar_variante_sap
        IMPORTING
          VALUE(i_variante_sap) TYPE ztppi1209_1-variantes_sap OPTIONAL
        CHANGING
          c_es_lista_infotint   TYPE zclppr1157_productos_quimicos=>gtp_es_datos_infotint,
      "! <strong>Descripción:</strong>
      "! <p>
      "! Genera una itab que contiene las variantes que contiene un componente segun.<br/>
      "! el centro/material generico/alternativa/color
      "! </p>
      "! <strong>Identificador:</strong>
                                                            "! R1157
      "! <br/>
      "! <strong>Autor:</strong>
      "! Sebastian Londono
      "! <br/>
      "! <strong>Historial de cambios:
      "! <br/><br/>
      "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
      "! </strong><br/>
      "! \ 20.05.2024  \ S4DK917548 \ Sebastian Londono \ Creacion Inicial \
      "!
      "! @parameter i_ti_componente_x_variantes |
      "! @parameter i_incluir_todas_las_variantes |
      "! @parameter i_es_lista_infotint |
      "! @parameter e_es_lm_cabecera |
      "! @parameter e_ti_datos_eliminar_lm |
      "! @parameter e_ti_componente_lm_eliminar |
      "! @parameter e_ti_datos_actualizar_lm |
      "! @parameter e_ti_variantes_duplicadas |
      leer_componentes_duplicados
        IMPORTING
          VALUE(i_ti_componente_x_variantes) TYPE gtp_ti_componente_variantes
          i_incluir_todas_las_variantes      TYPE flag
          VALUE(i_es_lista_infotint)         TYPE gtp_es_datos_infotint
        EXPORTING
          e_es_lm_cabecera                   TYPE zclppr1157_productos_quimicos=>gtp_es_lm_cabecera
          e_ti_datos_eliminar_lm             TYPE gtp_ti_datos_actualizar_lm
          e_ti_componente_lm_eliminar        TYPE t_stpo_api03
          e_ti_datos_actualizar_lm           TYPE gtp_ti_datos_actualizar_lm
          e_ti_variantes_duplicadas          TYPE fsh_tt_bomvd_api,
      verificar_consistencia_lm
        IMPORTING
          i_ejecutar_consistencia_lm TYPE flag DEFAULT abap_true
          i_numero_proceso           TYPE i DEFAULT 1
          i_tiempo_espera_extendido  TYPE flag DEFAULT abap_false
        CHANGING
          VALUE(c_es_lista_infotint) TYPE gtp_es_datos_infotint
          c_ti_lista_infotint        TYPE gtp_ti_lista_infotint,
      consolidar_componente_variante
        IMPORTING
          i_indicador_procesar               TYPE flag DEFAULT abap_true
          i_es_lista_infotint                TYPE gtp_es_datos_infotint
          i_ti_lista_infotint                TYPE gtp_ti_lista_infotint
        RETURNING
          VALUE(r_ti_componente_x_variantes) TYPE gtp_ti_componente_variantes.

ENDCLASS.



CLASS ZCLPPR1157_PRODUCTOS_QUIMICOS IMPLEMENTATION.


  METHOD constructor.

    CONVERT DATE sy-datum TIME sy-uzeit
    INTO TIME STAMP g_cronomarcador_utc TIME ZONE gc_huso_horario.

    cargar_parametros( ).
  ENDMETHOD.


  METHOD procesar_registros_infotint.

    CLEAR: g_cronomarcador_utc."Variable de log
    zclcxr1002_log_aplicacion=>liberar( ).

    cargar_parametros( ).

    IF NOT line_exists( gti_lista_infotint[ procesar = abap_true ] ).
      MESSAGE i508(fins_cfin_cmt_msg).
      RETURN.
    ENDIF.

    IF line_exists( gti_lista_infotint[ procesar = abap_true material_variante = space ] ).
      MESSAGE i098(zpp01).
    ENDIF.

    validar_consistencia_de_datos(
      CHANGING
        c_ti_lista_infotint = gti_lista_infotint ).

    actualizar_lista_materiales(
      CHANGING
        c_ti_lista_infotint = gti_lista_infotint ).

    registrar_modificaciones(
      CHANGING
        c_ti_lista_infotint = gti_lista_infotint ).

    IF sy-batch = abap_false.
      go_alv->refresh_table_display( is_stable = VALUE #( row = abap_true col = abap_true ) ).
    ENDIF.

    MESSAGE i093(zpp01).

  ENDMETHOD.


  METHOD iniciar_tratamiento_infotint.

    IF i_actualizar_registros = abap_false.
      zclcxr1002_log_aplicacion=>liberar( ).
      go_log = zclcxr1002_log_aplicacion=>get_instancia(
        i_es_cabecera_log = VALUE #( object = 'ZPP_1' subobject = 'ZR1157_1' )
        i_identificador   = 'ZR1157_1' ).

      gr_centro = i_r_centro.
      gr_color = i_r_color.
      gr_alternativa_escala = i_r_alternativa.
      gr_fecha_envio = i_r_fecha_envio.
      gr_material_legado = i_r_material_legado.
      gr_material = i_r_material.
      gr_indicador_actualizacion = i_r_indicador_actualizacion.
      g_pendiente_procesar = i_pendiente_procesar.

    ENDIF.

    gti_lista_infotint =
      leer_registros_infotint(
      EXPORTING
        i_r_centro                  = i_r_centro
        i_r_fecha_envio             = i_r_fecha_envio
        i_r_material_legado         = gr_material_legado
        i_r_material                = i_r_material
        i_r_color                   = i_r_color
        i_r_alternativa             = i_r_alternativa
        i_pendiente_procesar        = i_pendiente_procesar
        i_r_indicador_actualizacion = i_r_indicador_actualizacion ).

    IF i_visualizar_duplicados = abap_true AND sy-batch = abap_false.
      visualizar_lm_con_duplicados(
        CHANGING
          c_ti_lista_infotint = gti_lista_infotint ).

    ELSE.

      "Procesamiento en batch
      IF sy-batch = abap_true OR i_ejecutar_jobs_agrupados = abap_true.

        MODIFY gti_lista_infotint FROM VALUE #( procesar = abap_true )
        TRANSPORTING procesar
        WHERE ind_actualizado NE gc_lista_material_ok.

        IF i_ejecutar_jobs_agrupados = abap_false.
          procesar_registros_infotint( ).
        ENDIF.

      ENDIF.

      IF i_ejecutar_jobs_agrupados = abap_true.
        ejecutar_proeso_agrupado_job(
          EXPORTING
            i_r_fecha_envio     = i_r_fecha_envio
          CHANGING
            c_ti_lista_infotint = gti_lista_infotint ).

        gti_lista_infotint =
          leer_registros_infotint(
          EXPORTING
            i_r_centro                  = i_r_centro
            i_r_fecha_envio             = i_r_fecha_envio
            i_r_material_legado         = gr_material_legado
            i_r_material                = i_r_material
            i_r_color                   = i_r_color
            i_r_alternativa             = i_r_alternativa
            i_pendiente_procesar        = i_pendiente_procesar
            i_r_indicador_actualizacion = i_r_indicador_actualizacion ).
      ENDIF.

      IF i_actualizar_registros = abap_true.

        go_alv->refresh_table_display( ).

      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD leer_registros_infotint.

    DATA: r_indicador_actualizacion TYPE gtp_r_estado_lista,
          r_material_variante       TYPE RANGE OF mara-matnr.

    IF i_pendiente_procesar = abap_true.
      r_indicador_actualizacion = VALUE #( sign = 'I' option = 'EQ'
                                          ( low = gc_lista_mat_sin_actualizar )
                                          ( low = gc_lista_mat_en_error ) ).
    ENDIF.

***    LOOP AT i_r_material_legado ASSIGNING FIELD-SYMBOL(<fs_es_material_legado>).
***      <fs_es_material_legado>-low = |{ <fs_es_material_legado>-low ALPHA = OUT }|.
***      <fs_es_material_legado>-high = |{ <fs_es_material_legado>-high ALPHA = OUT }|.
***    ENDLOOP.

    "Tomar TODOS los registros Lista Infotint
    "agrupar mismo centro+ material genérico + color+ alternativa
    "IND_ACTUALIZADO = 0 o 9
    SELECT
    FROM ztppi1209_1 AS _lista_infotint
    LEFT JOIN mara AS _material ON
    _material~bismt = ltrim( _lista_infotint~material_generico,'0' )
    AND _material~color = _lista_infotint~color
    FIELDS
      _lista_infotint~centro,
      _material~matnr AS material_variante,
      _lista_infotint~color,
      lpad( _lista_infotint~alternativa_escala, 2, '0' ) AS alternativa_escala,
      _lista_infotint~componente,
      _material~satnr AS material_generico_sap,
      _lista_infotint~material_generico,
      _lista_infotint~fecha_envio,
      _lista_infotint~hora_envio,
      _lista_infotint~cant_mapeo,
      _lista_infotint~unidad_medida,
      _lista_infotint~usuario,
      _lista_infotint~mensaje,
      _lista_infotint~ind_actualizado,
      _lista_infotint~peso_tanda,
      _lista_infotint~maquina,
      _lista_infotint~usuario_actualizacion,
      _lista_infotint~fecha_actualizacion,
      _lista_infotint~hora_actualizacion,
      _lista_infotint~variantes_sap,
      _material~mtart,  _material~size1
    WHERE _lista_infotint~ind_actualizado IN @r_indicador_actualizacion
    AND _lista_infotint~centro IN @i_r_centro
    AND _material~satnr IN @i_r_material
***    AND _material~bismt IN @i_r_material_legado
    AND _lista_infotint~material_generico IN @i_r_material_legado
    AND _lista_infotint~color IN @i_r_color
    AND _lista_infotint~fecha_envio IN @i_r_fecha_envio
    AND _lista_infotint~alternativa_escala IN @i_r_alternativa
    AND _lista_infotint~ind_actualizado IN @i_r_indicador_actualizacion
    INTO CORRESPONDING FIELDS OF TABLE @r_ti_lista_infotint.

    SORT r_ti_lista_infotint
    BY centro material_generico_sap alternativa_escala color size1 material_variante componente.

    "Para las telas, rectilíneos e hiladilla tipos de materiales (ZFAB)
    "extraer todos los materiales variantes MARA-MATNR que contenga el sufijo acorde a parámetro Sufijo
    LOOP AT r_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico = <fs_es_lista_infotint_gr>-material_generico
                                           color = <fs_es_lista_infotint_gr>-color
                                           alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      SPLIT <fs_es_lista_infotint_gr>-variantes_sap AT ';' INTO TABLE DATA(ti_variantes).
      r_material_variante = VALUE #( FOR es_variante IN ti_variantes ( sign = 'I' option = 'EQ' low = es_variante ) ).

      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>).
        "Completar ceros en componente
        CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
          EXPORTING
            input        = <fs_es_lista_infotint>-componente
          IMPORTING
            output       = <fs_es_lista_infotint>-componente
          EXCEPTIONS
            length_error = 1
            OTHERS       = 2.

        <fs_es_lista_infotint>-estado = SWITCH #( <fs_es_lista_infotint>-ind_actualizado
                                                    WHEN gc_lista_mat_sin_actualizar THEN
                                                     icon_light_out
                                                    WHEN gc_lista_material_ok THEN
                                                      icon_green_light
                                                    WHEN gc_lista_mat_en_error THEN
                                                      icon_red_light
                                                ).
        "Listas tratadas parcalmente
        IF <fs_es_lista_infotint>-material_variante NOT IN r_material_variante
        AND r_material_variante IS NOT INITIAL.
          <fs_es_lista_infotint>-estado = icon_yellow_light.
        ENDIF.
      ENDLOOP.

    ENDLOOP.

    "Eliminar materialas sin sufijo parametrizado
    DELETE r_ti_lista_infotint WHERE mtart = 'ZFAB' AND material_variante NOT IN gr_sufijo_mateiral.

    DELETE ADJACENT DUPLICATES FROM r_ti_lista_infotint COMPARING centro material_variante color alternativa_escala componente.

  ENDMETHOD.


  METHOD cargar_parametros.

    go_parametros = NEW zclcxr1000_parametros(
      i_modulo = gc_modulo
      i_ricefw = gc_ricefw ).

    gr_tipo_material = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'TP_MATERIA' )
                                    ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_sufijo_mateiral = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'SUFIJO_MAT' )
                                    ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_tipo_material_quimico = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'TP_MAT_QUI' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_utilizacion_lista_mat = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'UTILIZA_LM' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_tipo_posicion_lista = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'TP_POS_LM' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_cantidad_componente = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'CANT_COMP' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_material_quimico_acabado = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'QUIM_ACABA' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    g_cantidad_intento_bloqueo = VALUE #( go_parametros->gti_parametros[ idparam = 'NUM_INTBLQ' ]-low OPTIONAL ).

    IF g_cantidad_intento_bloqueo IS INITIAL.
      g_cantidad_intento_bloqueo = 1.
    ENDIF.

    LOOP AT gr_material_quimico_acabado ASSIGNING FIELD-SYMBOL(<fs_es_material>).
      CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
        EXPORTING
          input        = <fs_es_material>-low
        IMPORTING
          output       = <fs_es_material>-low
        EXCEPTIONS
          length_error = 1
          OTHERS       = 2.

      CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
        EXPORTING
          input        = <fs_es_material>-high
        IMPORTING
          output       = <fs_es_material>-high
        EXCEPTIONS
          length_error = 1
          OTHERS       = 2.

    ENDLOOP.

  ENDMETHOD.


  METHOD visualizar_datos.
    DATA: perc      TYPE i,
          extension TYPE i VALUE 100.

    IF go_dock_container IS NOT BOUND AND cl_gui_alv_grid=>offline( ) IS INITIAL.

      CREATE OBJECT go_dock_container
        EXPORTING
          side                        = cl_gui_docking_container=>dock_at_bottom
        EXCEPTIONS
          cntl_error                  = 1
          cntl_system_error           = 2
          create_error                = 3
          lifetime_error              = 4
          lifetime_dynpro_dynpro_link = 5
          OTHERS                      = 6.

      go_dock_container->get_ratio( IMPORTING ratio = perc ).
      extension = ( 500 * extension / perc ).

      go_dock_container->set_extension( extension ).

    ENDIF.

    IF go_alv IS NOT BOUND.

      go_alv = NEW cl_gui_alv_grid( i_parent = go_dock_container ).

      TRY.
          DATA(ti_catalogo_alv) = zclcxr1002_util=>construir_catalogo( i_ti = gti_lista_infotint  i_qfieldname = 'UNIDAD_MEDIDA'  ).
          modificar_catalogo( CHANGING c_ti_catalogo = ti_catalogo_alv ).
        CATCH cx_dynamic_check cx_static_check.
          "handle exception
      ENDTRY.

      go_alv->register_edit_event(
        EXPORTING
          i_event_id = cl_gui_alv_grid=>mc_evt_enter
        EXCEPTIONS
          error      = 1
          OTHERS     = 2 ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
          WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.

      go_alv->register_edit_event(
        EXPORTING
          i_event_id = cl_gui_alv_grid=>mc_evt_modified
        EXCEPTIONS
          error      = 1
          OTHERS     = 2 ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
          WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.


      SET HANDLER: evento_hotspot     FOR go_alv,
                   evento_tool_bar    FOR go_alv,
                   evento_user_comand FOR go_alv,
                   evento_data_change FOR go_alv,
                   evento_data_change_finish FOR go_alv.

      go_alv->set_table_for_first_display(
        EXPORTING
          i_save                        = 'A'
          is_variant                    = VALUE #( variant = i_layout report = i_reporte username = sy-uname )
        CHANGING
          it_outtab                     = gti_lista_infotint " Output Table
          it_fieldcatalog               = ti_catalogo_alv " Field Catalog
        EXCEPTIONS
          invalid_parameter_combination = 1
          program_error                 = 2
          too_many_lines                = 3
          OTHERS                        = 4 ).


      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                   WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.

    ELSE.

      go_alv->refresh_table_display( ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                   WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.

    ENDIF.
  ENDMETHOD.


  METHOD validar_consistencia_de_datos.

    DATA: error_en_grupo TYPE flag.

    DATA(ti_lista_infotint) = VALUE gtp_ti_lista_infotint( FOR es_lm IN c_ti_lista_infotint WHERE ( procesar = abap_true )
                                                            ( es_lm ) ).

    CHECK ti_lista_infotint IS NOT INITIAL.

    "Lista de material
    SELECT
    FROM mast AS _lista_material
    LEFT JOIN stas AS _pos_lista_material ON
    _pos_lista_material~stlnr = _lista_material~stlnr
    AND _pos_lista_material~stlal = _lista_material~stlal
    AND _pos_lista_material~lkenz = @space
    FIELDS _lista_material~matnr, _lista_material~werks, _lista_material~stlan, _lista_material~stlal
    FOR ALL ENTRIES IN @ti_lista_infotint
    WHERE _lista_material~matnr = @ti_lista_infotint-material_variante
    AND _lista_material~werks   = @ti_lista_infotint-centro
    AND _lista_material~stlan   IN @gr_utilizacion_lista_mat
    AND _lista_material~stlal   = @ti_lista_infotint-alternativa_escala(2)
    INTO TABLE @DATA(ti_lista_material).

    DATA(ti_componentes_sap) = consultar_componentes( i_ti_lista_infotint = c_ti_lista_infotint ).
    "Limpiar variantes con error
    MODIFY c_ti_lista_infotint
    FROM VALUE #( variantes_sap = space )
*    USING KEY key_marcados
    TRANSPORTING variantes_sap

    WHERE procesar = abap_true
    AND ind_actualizado NE gc_lista_material_ok
    AND material_variante IS NOT INITIAL.

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
*                                USING KEY key_marcados
                                WHERE procesar = abap_true
                                AND ind_actualizado NE gc_lista_material_ok
                                AND material_variante IS NOT INITIAL
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico = <fs_es_lista_infotint_gr>-material_generico
                                           color = <fs_es_lista_infotint_gr>-color
                                           alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log          = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                         i_identificador            = get_id_log( <fs_es_lista_infotint_gr> )
                                                         i_descartar_msj_duplicados = abap_true ).
      error_en_grupo = abap_false.

      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_listinfotint_varian_gr>)
                                              GROUP BY <fs_es_listinfotint_varian_gr>-material_variante.

        <fs_es_listinfotint_varian_gr>-estado = icon_light_out.
        <fs_es_listinfotint_varian_gr>-ind_actualizado = gc_lista_mat_sin_actualizar.

        "Validar Material Variante Existe/tipo material
        IF <fs_es_listinfotint_varian_gr>-material_variante IS INITIAL
        OR <fs_es_listinfotint_varian_gr>-mtart NOT IN gr_tipo_material.
          error_en_grupo = abap_true.
          <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
          go_log->set_es_log( i_es = VALUE #( id = 'ZMM01' number = '411' type = 'E'
                                              message_v1 = <fs_es_listinfotint_varian_gr>-material_variante
                                              parameter = <fs_es_listinfotint_varian_gr>-material_generico ) ).
        ENDIF.

        IF <fs_es_listinfotint_varian_gr>-estado NE icon_red_light.
          "Recorrer lista de componentes por variante
          LOOP AT GROUP <fs_es_listinfotint_varian_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>).

            "Validar componete
            DATA(es_componente) = VALUE #( ti_componentes_sap[ componente = <fs_es_lista_infotint>-componente ] OPTIONAL ).

            IF es_componente-componente IS INITIAL.
              error_en_grupo = abap_true.
              <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
              go_log->set_es_log( i_es = VALUE #( id = gc_clase_mensajes number = '103' type = 'E'
                                                 message_v1 = <fs_es_lista_infotint>-componente
                                                 message_v2 = <fs_es_lista_infotint>-centro
                                                 parameter = <fs_es_lista_infotint>-material_generico ) ).
            ENDIF.

            "Componente en centro
            IF NOT line_exists( ti_componentes_sap[ componente = <fs_es_lista_infotint>-componente werks = <fs_es_lista_infotint>-centro ] )
            AND <fs_es_listinfotint_varian_gr>-estado NE icon_red_light.
              error_en_grupo = abap_true.
              <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
              go_log->set_es_log( i_es = VALUE #( id = 'ZPP01' number = '105' type = 'E'
                                                  message_v1 = <fs_es_lista_infotint>-componente
                                                  message_v2 = <fs_es_lista_infotint>-centro
                                                  parameter = <fs_es_lista_infotint>-material_generico ) ).
            ENDIF.

            "Componente con peticion de borrado
            IF es_componente-peticion_borrado_mat IS NOT INITIAL
            AND <fs_es_listinfotint_varian_gr>-estado NE icon_red_light.
              error_en_grupo = abap_true.
              <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
              go_log->set_es_log( i_es = VALUE #( id = gc_clase_mensajes number = '104' type = 'E'
                                                    message_v1 = <fs_es_lista_infotint>-componente
                                                    parameter = <fs_es_lista_infotint>-material_generico ) ).
            ENDIF.

          ENDLOOP.

          "Material en lista de material
          IF NOT line_exists( ti_lista_material[ matnr = <fs_es_listinfotint_varian_gr>-material_variante werks = <fs_es_listinfotint_varian_gr>-centro
                                                 stlal = <fs_es_listinfotint_varian_gr>-alternativa_escala ] ).
            <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
            <fs_es_listinfotint_varian_gr>-ind_actualizado = gc_lista_mat_en_error.

            go_log->set_es_log( i_es = VALUE #( id = gc_clase_mensajes number = '077' type = 'E'
                                               message_v1 = <fs_es_listinfotint_varian_gr>-material_variante
                                               message_v2 = <fs_es_listinfotint_varian_gr>-alternativa_escala
                                               parameter = <fs_es_listinfotint_varian_gr>-material_generico ) ).
            <fs_es_lista_infotint_gr>-variantes_sap = |{ <fs_es_lista_infotint_gr>-variantes_sap };{ <fs_es_listinfotint_varian_gr>-material_variante }|.
          ENDIF.

        ENDIF.

        "Actualizar registros por subgrupo
        DATA(ti_log_errores) = go_log->get_errores( ).

        MODIFY c_ti_lista_infotint
        USING KEY key_agrupador
        FROM VALUE #( ind_actualizado = <fs_es_listinfotint_varian_gr>-ind_actualizado
                      estado = <fs_es_listinfotint_varian_gr>-estado
                      fecha_actualizacion = sy-datum hora_actualizacion = sy-uzeit usuario_actualizacion = sy-uname
                      variantes_sap = <fs_es_lista_infotint_gr>-variantes_sap )
        TRANSPORTING ind_actualizado estado fecha_actualizacion hora_actualizacion usuario_actualizacion variantes_sap
        WHERE centro = <fs_es_lista_infotint_gr>-centro
          AND material_variante = <fs_es_listinfotint_varian_gr>-material_variante
          AND material_generico = <fs_es_listinfotint_varian_gr>-material_generico
          AND color = <fs_es_listinfotint_varian_gr>-color
          AND alternativa_escala = <fs_es_listinfotint_varian_gr>-alternativa_escala.

      ENDLOOP.

      "Si se presenta un error a nivel de grupo, se actualiza el estado para todo el conjunto de datos
      IF error_en_grupo = abap_true.
        MODIFY c_ti_lista_infotint
        USING KEY key_agrupador
        FROM VALUE #( ind_actualizado = gc_lista_mat_en_error
                      estado = <fs_es_listinfotint_varian_gr>-estado
                      fecha_actualizacion = sy-datum hora_actualizacion = sy-uzeit usuario_actualizacion = sy-uname )
        TRANSPORTING ind_actualizado estado fecha_actualizacion hora_actualizacion usuario_actualizacion
        WHERE centro = <fs_es_lista_infotint_gr>-centro
          AND material_generico = <fs_es_lista_infotint_gr>-material_generico
          AND color = <fs_es_lista_infotint_gr>-color
          AND alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD eliminar_componantes_generico.

    DATA: log_con_advertencia           TYPE flwarning,
          ti_lista_material             TYPE gtp_ti_lista_material,
          ti_posicion_lista_eliminar    TYPE t_stpo_api03,
          es_posicion_lista             TYPE stpo_api03,
          es_cabecera_lista_material    TYPE stko_api02,
          resultado_remover_componentes TYPE sysubrc,
          fecha_valida_desde            TYPE datuv_bi.

    go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log      = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                         i_identificador            = get_id_log( c_es_lista_infotint )
***                                                         i_descartar_msj_duplicados = abap_true
                                                         ).

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    go_log->set_es_log( i_es = VALUE #( type = 'S' number = '007' id = 'CRMS4_IU_CM_PROCESS'
                                        message_v1 = TEXT-elm ) ).

    DATA(tiempo_espera_despues_bapi) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_BAPI' ]-low OPTIONAL ).

    cl_progress_indicator=>progress_indicate(
      EXPORTING
        i_msgid              = 'CRMS4_IU_CM_PROCESS'
        i_msgno              = '007'
        i_msgv1              = TEXT-elm
        i_processed          = 3
        i_total              = g_cantidad_total_procesos
        i_output_immediately = abap_true ).

    consultar_lista_material( EXPORTING i_ti_lista_infotint = VALUE #( ( matnr = c_es_lista_infotint-material_generico_sap
                                                                         werks             = c_es_lista_infotint-centro
                                                                         stlal = c_es_lista_infotint-alternativa_escala ) )
                              IMPORTING e_ti_lista_material = ti_lista_material
                                        e_es_lm_cabecera    = DATA(es_lm_cabecera) ).

    LOOP AT ti_lista_material INTO DATA(es_lista_material)
                                WHERE werks = c_es_lista_infotint-centro
                                  AND mtart IN gr_tipo_material_quimico
                                  AND stlal = c_es_lista_infotint-alternativa_escala(2)
                                  AND componente IN i_r_componente
                                  AND ind_borrado_stpo = space
                                  AND ind_borrado_stas = space.
      "Materiales componente que se deben excluir de la eliminacion
      CHECK es_lista_material-componente IN gr_material_quimico_acabado.

      es_posicion_lista =
             VALUE #( item_categ = es_lista_material-postp
                      item_no = es_lista_material-posnr
                      component = es_lista_material-componente
                      comp_qty = VALUE #( gr_cantidad_componente[ 1 ]-low OPTIONAL )
                      rel_cost = abap_true
                      item_node  = es_lista_material-stlkn
                      item_count = es_lista_material-stpoz
                      fldelete = abap_true ).

      APPEND es_posicion_lista TO ti_posicion_lista_eliminar.

    ENDLOOP.

    IF i_ti_posicion_lista_eliminar IS NOT INITIAL.
      ti_posicion_lista_eliminar = i_ti_posicion_lista_eliminar.
    ENDIF.


    IF ti_posicion_lista_eliminar IS NOT INITIAL.

      DO g_cantidad_intento_bloqueo TIMES.

        validar_bloqueo_usuario( c_es_lista_infotint ).

        CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
          EXPORTING
            material           = c_es_lista_infotint-material_generico_sap
            plant              = c_es_lista_infotint-centro
            bom_usage          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
            alternative        = c_es_lista_infotint-alternativa_escala(2)
            valid_from         = fecha_valida_desde
            i_stko             = VALUE stko_api01( base_quan = es_lm_cabecera-bmeng_no_decimal
                                                   alt_text  = es_lm_cabecera-stktx )
            fl_commit_and_wait = abap_true
            fl_complete        = abap_true
            fl_default_values  = abap_true
          IMPORTING
            fl_warning         = log_con_advertencia
            o_stko             = es_cabecera_lista_material
          TABLES
            t_stpo             = ti_posicion_lista_eliminar
          EXCEPTIONS
            error              = 1
            OTHERS             = 2.

        resultado_remover_componentes = sy-subrc.

        "Sis se ejecuto de forma correcta, o si el error es diferente al bloqueo
        IF resultado_remover_componentes IS INITIAL
        OR ( resultado_remover_componentes IS NOT INITIAL AND ( sy-msgid NE '29' OR sy-msgno NE '160' ) ).
          EXIT.
        ENDIF.

      ENDDO.

      IF resultado_remover_componentes IS NOT INITIAL.

        c_es_lista_infotint-estado = icon_red_light.
        c_es_lista_infotint-ind_actualizado = gc_lista_mat_en_error.

        go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                            message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

        asignar_variante_sap( CHANGING c_es_lista_infotint = c_es_lista_infotint ).

      ELSE.
        c_es_lista_infotint-estado = icon_green_light.
        c_es_lista_infotint-ind_actualizado = gc_lista_material_ok.
        LOOP AT ti_posicion_lista_eliminar ASSIGNING FIELD-SYMBOL(<fs_es_posicion_lm_eliminar>).
          go_log->set_es_log( i_es = VALUE #( type = 'S' number = '107' id = gc_clase_mensajes
                                              message_v1 = |{ <fs_es_posicion_lm_eliminar>-component ALPHA = OUT }|
                                              message_v2 = c_es_lista_infotint-material_generico_sap
                                              message_v3 = c_es_lista_infotint-alternativa_escala ) ).
        ENDLOOP.

        WAIT UP TO tiempo_espera_despues_bapi SECONDS.

      ENDIF.

    ENDIF.

  ENDMETHOD.


  METHOD leer_componentes_duplicados.

    DATA: ti_lista_material       TYPE gtp_ti_lista_material,
          ti_lm_variantes         TYPE gtp_ti_lista_material,
          r_componentes_duplicado TYPE RANGE OF mara-matnr,
          posicion_componente     TYPE i,
          fecha_valida_desde      TYPE datuv_bi.


    CLEAR: e_ti_datos_actualizar_lm, e_ti_datos_eliminar_lm, e_es_lm_cabecera, e_ti_variantes_duplicadas.

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    consultar_lista_material( EXPORTING i_descartar_reg_eliminados  = abap_true
                                        i_solo_componentes_quimicos = abap_true
                                        i_incluir_material_variante = abap_true
                                        i_ti_lista_infotint         = VALUE #( ( matnr = i_es_lista_infotint-material_generico_sap
                                                                                 werks = i_es_lista_infotint-centro
                                                                                 stlal = i_es_lista_infotint-alternativa_escala ) )
                              IMPORTING e_es_lm_cabecera            = e_es_lm_cabecera
                                        e_ti_lista_material         = ti_lista_material
                                        e_ti_lm_variantes           = ti_lm_variantes ).

    "Recorrer por componente
    LOOP AT i_ti_componente_x_variantes ASSIGNING FIELD-SYMBOL(<fs_es_componete_x_variante>).

      IF i_incluir_todas_las_variantes = abap_true.
        CLEAR: <fs_es_componete_x_variante>-r_variantes.
      ENDIF.

      LOOP AT ti_lista_material INTO DATA(es_posicion_lm_existentes_gr)
                                WHERE componente = <fs_es_componete_x_variante>-componente
                                GROUP BY es_posicion_lm_existentes_gr-componente.

        "Recorremos por material variante
        LOOP AT ti_lm_variantes   ASSIGNING FIELD-SYMBOL(<fs_es_lm_gr>)
                                  WHERE mtart IN gr_tipo_material_quimico
                                  AND componente = es_posicion_lm_existentes_gr-componente
                                  AND matnr      IN <fs_es_componete_x_variante>-r_variantes
                                  GROUP BY ( componente = <fs_es_lm_gr>-componente ).

          "Determina si existen componentes repetidos por variante
          LOOP AT GROUP <fs_es_lm_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lm_variante_gr>)
                                      GROUP BY ( matnr = <fs_es_lm_variante_gr>-matnr ).

            DATA(cantidad_componente_x_variante) = 0.

            LOOP AT GROUP <fs_es_lm_variante_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lm>).
              ADD 1 TO cantidad_componente_x_variante.
            ENDLOOP.

            IF cantidad_componente_x_variante > 1.

              APPEND VALUE #( sign = 'I' option = 'EQ' low = es_posicion_lm_existentes_gr-componente )
              TO r_componentes_duplicado.

              APPEND
                 VALUE #( item_categ  = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                     item_number = <fs_es_lm>-posnr
                     material    = <fs_es_lm>-matnr
                     component   = <fs_es_lm>-componente
                     quantity    = <fs_es_lm>-bmeng
                     item_node   = <fs_es_lm>-stlkn
                     item_count  = <fs_es_lm>-stpoz )
              TO  e_ti_variantes_duplicadas.

            ENDIF.

          ENDLOOP.

        ENDLOOP.

        IF es_posicion_lm_existentes_gr-componente IN r_componentes_duplicado AND r_componentes_duplicado IS NOT INITIAL.

          ASSIGN e_ti_datos_actualizar_lm[ fecha_valida_desde = fecha_valida_desde ]
          TO FIELD-SYMBOL(<fs_es_datos_actualizar_lm>).

          IF sy-subrc IS NOT INITIAL.
            APPEND INITIAL LINE TO e_ti_datos_actualizar_lm ASSIGNING <fs_es_datos_actualizar_lm>.
            <fs_es_datos_actualizar_lm>-fecha_valida_desde = fecha_valida_desde.
          ENDIF.

          "Agregar componentes
          LOOP AT GROUP es_posicion_lm_existentes_gr INTO DATA(es_posicion_lm_existentes).
            "Valida si el material componente/varainte se encuentra duplicado
            IF i_incluir_todas_las_variantes = abap_false.
              CHECK line_exists( e_ti_variantes_duplicadas[ material = es_posicion_lm_existentes-matnr component = es_posicion_lm_existentes-componente ] ).
            ENDIF.

            ASSIGN e_ti_datos_eliminar_lm[ fecha_valida_desde =  generar_fecha( es_posicion_lm_existentes-datuv ) ]
            TO FIELD-SYMBOL(<fs_es_datos_eliminar_lm>).

            IF sy-subrc IS NOT INITIAL.
              APPEND INITIAL LINE TO e_ti_datos_eliminar_lm ASSIGNING <fs_es_datos_eliminar_lm>.
              <fs_es_datos_eliminar_lm>-fecha_valida_desde =  generar_fecha( es_posicion_lm_existentes-datuv ).
            ENDIF.

            "Agregar registro de componentes a todas las lineas que requieran
            IF NOT line_exists( <fs_es_datos_eliminar_lm>-ti_componentes[ component  = es_posicion_lm_existentes-componente
                                                                          item_no    = es_posicion_lm_existentes-posnr
                                                                          item_node  = es_posicion_lm_existentes-stlkn
                                                                          item_count = es_posicion_lm_existentes-stpoz ] ).
              <fs_es_datos_eliminar_lm>-componentes = r_componentes_duplicado.

              APPEND
              VALUE #( item_categ = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                       item_no = es_posicion_lm_existentes-posnr
                       component = es_posicion_lm_existentes-componente
                       comp_qty = VALUE #( gr_cantidad_componente[ 1 ]-low OPTIONAL )"es_posicion_lm_existentes-bmeng
                       rel_cost = es_posicion_lm_existentes-rel_cost
                       item_node  = es_posicion_lm_existentes-stlkn
                       item_count = es_posicion_lm_existentes-stpoz
                       fldelete = abap_true )
              TO: <fs_es_datos_eliminar_lm>-ti_componentes,
                  e_ti_componente_lm_eliminar,
                  <fs_es_datos_actualizar_lm>-ti_componentes.

              MODIFY <fs_es_datos_actualizar_lm>-ti_componentes
              FROM VALUE #( fldelete = abap_false )
              TRANSPORTING fldelete item_node item_count
              WHERE fldelete = abap_true.

            ENDIF.

          ENDLOOP.

          DELETE ADJACENT DUPLICATES FROM <fs_es_datos_actualizar_lm>-ti_componentes COMPARING component.

          "Agregar varianes que se deben almacenar
          LOOP AT ti_lm_variantes   ASSIGNING <fs_es_lm>
                                    WHERE mtart IN gr_tipo_material_quimico
                                    AND componente = es_posicion_lm_existentes_gr-componente
                                    AND matnr      IN <fs_es_componete_x_variante>-r_variantes.

            "Agregar todas las variantes para los componentes que se deben actualizar
            IF NOT line_exists( <fs_es_datos_actualizar_lm>-ti_variantes_bomd[ item_number = <fs_es_lm>-posnr
                                                                               material    = <fs_es_lm>-matnr
                                                                               component   = <fs_es_lm>-componente ] ).
              READ TABLE <fs_es_datos_actualizar_lm>-ti_componentes INTO DATA(es_componentes)
              WITH KEY component = <fs_es_lm>-componente.

              posicion_componente = sy-tabix.

              APPEND
                  VALUE #( item_categ  = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                           item_number = es_componentes-item_no "<fs_es_lm>-posnr
                           material    = <fs_es_lm>-matnr
                           component   = <fs_es_lm>-componente
                           quantity    = <fs_es_lm>-menge
                           fsh_comp_lno = posicion_componente )
              TO <fs_es_datos_actualizar_lm>-ti_variantes_bomd.

            ENDIF.

          ENDLOOP.

        ENDIF.

      ENDLOOP.
    ENDLOOP.

    SORT e_ti_datos_eliminar_lm BY fecha_valida_desde ASCENDING.

    IF e_ti_datos_eliminar_lm IS NOT INITIAL.

      LOOP AT e_ti_datos_actualizar_lm ASSIGNING <fs_es_datos_actualizar_lm>.
        "Para actualizar se descartan los registros mas antiguos
        IF sy-tabix > 1.
          DELETE e_ti_datos_actualizar_lm WHERE fecha_valida_desde = <fs_es_datos_actualizar_lm>-fecha_valida_desde.
          CONTINUE.
        ENDIF.

        DELETE ADJACENT DUPLICATES FROM <fs_es_datos_actualizar_lm>-ti_componentes COMPARING item_categ item_no component.
        SORT <fs_es_datos_actualizar_lm>-ti_variantes_bomd BY item_categ item_number component material .
        DELETE ADJACENT DUPLICATES FROM <fs_es_datos_actualizar_lm>-ti_variantes_bomd COMPARING item_categ item_number component material .

        LOOP AT <fs_es_datos_actualizar_lm>-ti_variantes_bomd ASSIGNING FIELD-SYMBOL(<fs_es_posiciones_bomd>).

          READ TABLE <fs_es_datos_actualizar_lm>-ti_componentes TRANSPORTING NO FIELDS
          WITH KEY component = <fs_es_posiciones_bomd>-component.

          <fs_es_posiciones_bomd>-fsh_comp_lno = sy-tabix.

        ENDLOOP.
      ENDLOOP.

    ENDIF.

  ENDMETHOD.


  METHOD verificar_consistencia_lm.

    DATA: ti_posicion_lista_actualizar  TYPE STANDARD TABLE OF stpo_api03,
          ti_posiciones_bomd_actualizar TYPE STANDARD TABLE OF fsh_s_bomvd_api,
          ti_componente_x_variantes     TYPE gtp_ti_componente_variantes,
          resultado_adicion_componentes TYPE sysubrc,
          fecha_valida_desde            TYPE datuv_bi.

    DATA(tiempo_espera_despues_bapi) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_BAPI' ]-low OPTIONAL ).

    IF i_tiempo_espera_extendido = abap_true.
      tiempo_espera_despues_bapi = tiempo_espera_despues_bapi * 2.
    ENDIF.

    "Identificar los componetes y variantes a los que se le debe realizar el proceso de duplicidad de datos
    ti_componente_x_variantes =
      consolidar_componente_variante(
      EXPORTING
        i_es_lista_infotint = c_es_lista_infotint
        i_ti_lista_infotint = c_ti_lista_infotint ).

    leer_componentes_duplicados(
      EXPORTING
        i_ti_componente_x_variantes   = ti_componente_x_variantes
        i_incluir_todas_las_variantes = abap_true
        i_es_lista_infotint           = c_es_lista_infotint
      IMPORTING
        e_es_lm_cabecera              = DATA(es_lm_cabecera)
        e_ti_variantes_duplicadas     = DATA(ti_compo_variante_duplicado)
        e_ti_datos_eliminar_lm        = DATA(ti_datos_eliminar_lm)
        e_ti_componente_lm_eliminar   = DATA(ti_componente_lm_eliminar)
        e_ti_datos_actualizar_lm      = DATA(ti_datos_actualizar_lm) ).

    go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log          = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                       i_identificador            = get_id_log( c_es_lista_infotint )
*                                                       i_descartar_msj_duplicados = abap_true
                                                        ).

    validar_bloqueo_usuario( i_es_lista_infotint = c_es_lista_infotint ).

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    IF ti_compo_variante_duplicado IS NOT INITIAL.

      go_log->set_es_log( i_es = VALUE #( type = 'S' number = '113' id = gc_clase_mensajes
                                          message_v1 = c_es_lista_infotint-material_generico_sap
                                          message_v2 = c_es_lista_infotint-alternativa_escala ) ).

      cl_progress_indicator=>progress_indicate(
        EXPORTING
          i_msgid              = gc_clase_mensajes
          i_msgno              = '113'
          i_msgv1              = c_es_lista_infotint-material_generico_sap
          i_msgv2              = c_es_lista_infotint-alternativa_escala
          i_processed          = i_numero_proceso
          i_total              = g_cantidad_total_procesos
          i_output_immediately = abap_true ).

      "Se consolidan los componentes y las variantes que estan duplicadas para pasar a limpiar su mapeo y si aplica
      "eliminar el componente a nivel de generico
      CLEAR: ti_componente_x_variantes.

      LOOP AT ti_compo_variante_duplicado ASSIGNING FIELD-SYMBOL(<fs_es_variante_duplicado_gr>)
                                          GROUP BY <fs_es_variante_duplicado_gr>-component.

        APPEND INITIAL LINE TO ti_componente_x_variantes ASSIGNING FIELD-SYMBOL(<fs_es_componente_x_variantes>).
        <fs_es_componente_x_variantes>-componente = <fs_es_variante_duplicado_gr>-component.

        LOOP AT GROUP <fs_es_variante_duplicado_gr> ASSIGNING FIELD-SYMBOL(<fs_es_variante_duplicado>).

          APPEND VALUE #( sign = 'I' option = 'EQ' low = <fs_es_variante_duplicado>-material )
          TO <fs_es_componente_x_variantes>-r_variantes.

        ENDLOOP.

        SORT <fs_es_componente_x_variantes>-r_variantes BY low.
        DELETE ADJACENT DUPLICATES FROM <fs_es_componente_x_variantes>-r_variantes COMPARING low.

      ENDLOOP.

      eliminar_componantes_variante(
        EXPORTING
          i_ti_componente_x_variantes   = ti_componente_x_variantes
          i_incluir_todas_las_variantes = abap_true
          i_ti_posicion_lista_eliminar  = ti_componente_lm_eliminar
          i_tiempo_espera_extendido     = i_tiempo_espera_extendido
        CHANGING
          c_es_lista_infotint           = c_es_lista_infotint ).

      IF ti_datos_actualizar_lm IS NOT INITIAL.

        LOOP AT ti_datos_actualizar_lm ASSIGNING FIELD-SYMBOL(<fs_es_lm_actualizar>).

          ti_posicion_lista_actualizar = <fs_es_lm_actualizar>-ti_componentes.
          ti_posiciones_bomd_actualizar = <fs_es_lm_actualizar>-ti_variantes_bomd.

          DO g_cantidad_intento_bloqueo TIMES.

            validar_bloqueo_usuario( c_es_lista_infotint ).

            ges_lm_infotint_en_proceso = REF #( c_es_lista_infotint ).
            g_actualizacion_lm_terminada = abap_false.
            g_lm_bloqueada = abap_false.

            CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
              EXPORTING
                material           = c_es_lista_infotint-material_generico_sap
                plant              = c_es_lista_infotint-centro
                bom_usage          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
                alternative        = c_es_lista_infotint-alternativa_escala(2)
                valid_from         = <fs_es_lm_actualizar>-fecha_valida_desde "fecha_valida_desde
                i_stko             = VALUE stko_api01( base_quan =  es_lm_cabecera-bmeng_no_decimal
                                                       alt_text  =  es_lm_cabecera-stktx )
                fl_commit_and_wait = abap_true
              TABLES
                t_stpo             = ti_posicion_lista_actualizar
                t_fsh_bomd         = ti_posiciones_bomd_actualizar
              EXCEPTIONS
                error              = 1
                OTHERS             = 2.

            resultado_adicion_componentes = sy-subrc.
            "Sis se ejecuto de forma correcta, o si el error es diferente al bloqueo
            IF resultado_adicion_componentes IS INITIAL
            OR ( resultado_adicion_componentes IS NOT INITIAL AND ( sy-msgid NE '29' OR sy-msgno NE '160' ) ).
              EXIT.
            ENDIF.

          ENDDO.

          IF resultado_adicion_componentes IS NOT INITIAL.

            c_es_lista_infotint-estado = icon_red_light.
            c_es_lista_infotint-ind_actualizado = gc_lista_mat_en_error.

            go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                                message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

            asignar_variante_sap( CHANGING c_es_lista_infotint = c_es_lista_infotint ).
          ELSE.
            c_es_lista_infotint-estado = icon_green_light.
            c_es_lista_infotint-ind_actualizado = gc_lista_material_ok.

            LOOP AT ti_posiciones_bomd_actualizar INTO DATA(es_variantes)
                                                  GROUP BY ( component = es_variantes-component
                                                             material  = es_variantes-material ).
              go_log->set_es_log( i_es = VALUE #( type = 'S' number = '097' id = gc_clase_mensajes
                                                  message_v1 = es_variantes-component
                                                  message_v2 = es_variantes-material
                                                  message_v3 = c_es_lista_infotint-alternativa_escala ) ).
            ENDLOOP.

            WAIT UP TO tiempo_espera_despues_bapi SECONDS.
          ENDIF.

        ENDLOOP.

      ENDIF.

    ENDIF.

  ENDMETHOD.


  METHOD eliminar_componantes_variante.

    DATA: ti_posicion_lm_limpiar_mapeo  TYPE STANDARD TABLE OF stpo_api03,
          ti_variantes_bom              TYPE STANDARD TABLE OF fsh_s_bomvd_api,
          ti_lista_material             TYPE gtp_ti_lista_material,
          ti_lm_variante                TYPE gtp_ti_lista_material,
          r_variantes_infotint          TYPE RANGE OF mara-matnr,
          r_componente_eliminar         TYPE RANGE OF mara-matnr,
          es_posicion_lista             TYPE stpo_api03,
          consecutivo_lista_actualizar  TYPE i,
          resultado_remover_componentes TYPE sysubrc,
          fecha_valida_desde            TYPE datuv_bi.

    go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log      = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                         i_identificador            = get_id_log( c_es_lista_infotint )
***                                                         i_descartar_msj_duplicados = abap_true
                                                         ).

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    DATA(msj) = |{ TEXT-lmv } { COND #( WHEN c_ti_lista_infotint IS NOT INITIAL THEN c_es_lista_infotint-material_variante ELSE space ) } { c_es_lista_infotint-alternativa_escala }|.
    go_log->set_es_log( i_es = VALUE #( type = 'S' number = '007' id = 'CRMS4_IU_CM_PROCESS'
                                        message_v1 = msj ) ).
    DATA(tiempo_espera_despues_bapi) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_BAPI' ]-low OPTIONAL ).

    IF i_tiempo_espera_extendido = abap_true.
      tiempo_espera_despues_bapi = tiempo_espera_despues_bapi * 2.
    ENDIF.

    cl_progress_indicator=>progress_indicate(
      EXPORTING
        i_msgid              = 'CRMS4_IU_CM_PROCESS'
        i_msgno              = '007'
        i_msgv1              = msj
        i_processed          = 2
        i_total              = g_cantidad_total_procesos
        i_output_immediately = abap_true ).

    consultar_lista_material( EXPORTING i_descartar_reg_eliminados  = abap_true
                                        i_incluir_material_variante = abap_true
                                        i_solo_componentes_quimicos = abap_true
                                        i_ti_lista_infotint         = VALUE #( ( matnr = c_es_lista_infotint-material_generico_sap
                                                                                 werks             = c_es_lista_infotint-centro
                                                                                 stlal = c_es_lista_infotint-alternativa_escala ) )
                              IMPORTING e_es_lm_cabecera            = DATA(es_lm_cabecera)
                                        e_ti_lista_material         = ti_lista_material
                                        e_ti_lm_variantes           = ti_lm_variante ).

    "Si no se envia los componentes/variantes a limpiar, se debe hacer para todos los componentes/variante de la LM y su alternativa
    IF i_ti_componente_x_variantes IS INITIAL.

      r_variantes_infotint = VALUE #( FOR es_lista_infotint IN c_ti_lista_infotint WHERE (    centro = c_es_lista_infotint-centro
                                                                                            AND material_generico_sap = c_es_lista_infotint-material_generico_sap
                                                                                            AND alternativa_escala    = c_es_lista_infotint-alternativa_escala
                                                                                            AND procesar              = abap_true
                                                                                   )
                                ( sign = 'I' option = 'EQ' low = es_lista_infotint-material_variante )
                              ).

      "agregar componentes que existian pero ya no se enviaron desde infotint y por ende se deben eliminar
      LOOP AT ti_lm_variante REFERENCE INTO DATA(r_es_lm_variante_gr)
                             GROUP BY r_es_lm_variante_gr->componente.

        IF NOT line_exists( i_ti_componente_x_variantes[ componente = r_es_lm_variante_gr->componente ] ).
          APPEND INITIAL LINE TO i_ti_componente_x_variantes ASSIGNING FIELD-SYMBOL(<fs_es_componete_x_variante>).
          <fs_es_componete_x_variante>-componente = r_es_lm_variante_gr->componente.

          APPEND LINES OF r_variantes_infotint TO <fs_es_componete_x_variante>-r_variantes.

        ENDIF.

      ENDLOOP.
    ENDIF.

    "Recorrer Componentes x Variante
    LOOP AT i_ti_componente_x_variantes ASSIGNING <fs_es_componete_x_variante>.

      IF i_incluir_todas_las_variantes = abap_true.
        CLEAR: <fs_es_componete_x_variante>-r_variantes.
      ENDIF.

      LOOP AT ti_lm_variante INTO DATA(es_componente_bom_en_lista)
                                 WHERE componente = <fs_es_componete_x_variante>-componente
                                   AND matnr IN <fs_es_componete_x_variante>-r_variantes
                                 GROUP BY ( componente = es_componente_bom_en_lista-componente
                                            matnr = es_componente_bom_en_lista-matnr ).
        DATA(es_posicion_lista_existentes) = VALUE #( ti_lista_material[ componente = es_componente_bom_en_lista-componente ] OPTIONAL ).

        "Materiales componente que se deben excluir de la eliminacion
        CHECK es_componente_bom_en_lista-componente IN gr_material_quimico_acabado
        AND es_posicion_lista_existentes IS NOT INITIAL.

        IF NOT line_exists( ti_posicion_lm_limpiar_mapeo[ component = es_posicion_lista_existentes-componente ] ).
          es_posicion_lista =
                 VALUE #( item_categ = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                          item_no = es_posicion_lista_existentes-posnr
                          component = es_posicion_lista_existentes-componente
                          comp_qty = COND #( WHEN c_ti_lista_infotint IS NOT INITIAL THEN
                                              es_posicion_lista_existentes-bmeng
                                             ELSE
                                              VALUE #( gr_cantidad_componente[ 1 ]-low OPTIONAL ) )
                          rel_cost = es_posicion_lista_existentes-rel_cost
                          item_node  = es_posicion_lista_existentes-stlkn
                          item_count = es_posicion_lista_existentes-stpoz ).

          APPEND es_posicion_lista TO ti_posicion_lm_limpiar_mapeo.
        ENDIF.

        READ TABLE ti_posicion_lm_limpiar_mapeo INTO es_posicion_lista"TRANSPORTING NO FIELDS
        WITH KEY component = es_posicion_lista_existentes-componente.

        consecutivo_lista_actualizar = sy-tabix.

        APPEND VALUE #( item_categ  = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                        item_number = es_componente_bom_en_lista-posnr
                        item_node   = es_posicion_lista-item_node
                        item_count  = es_posicion_lista-item_count
                        material    = es_componente_bom_en_lista-matnr
                        component   = es_componente_bom_en_lista-componente
                        quantity    = space
                        fsh_comp_lno = consecutivo_lista_actualizar
                        )
            TO  ti_variantes_bom.

        CLEAR: es_posicion_lista_existentes.

      ENDLOOP.
    ENDLOOP.

    IF ti_posicion_lm_limpiar_mapeo IS NOT INITIAL.

      DO g_cantidad_intento_bloqueo TIMES.

        validar_bloqueo_usuario( c_es_lista_infotint ).

        CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
          EXPORTING
            material           = c_es_lista_infotint-material_generico_sap
            plant              = c_es_lista_infotint-centro
            bom_usage          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
            alternative        = c_es_lista_infotint-alternativa_escala(2)
            valid_from         = fecha_valida_desde
            i_stko             = VALUE stko_api01( base_quan = es_lm_cabecera-bmeng_no_decimal
                                                   alt_text  = es_lm_cabecera-stktx )
            fl_commit_and_wait = abap_true
*           fl_complete        = abap_true
*           fl_default_values  = abap_true
          TABLES
            t_stpo             = ti_posicion_lm_limpiar_mapeo
            t_fsh_bomd         = ti_variantes_bom
          EXCEPTIONS
            error              = 1
            OTHERS             = 2.

        resultado_remover_componentes = sy-subrc.

        "Sis se ejecuto de forma correcta, o si el error es diferente al bloqueo
        IF resultado_remover_componentes IS INITIAL
        OR ( resultado_remover_componentes IS NOT INITIAL AND ( sy-msgid NE '29' OR sy-msgno NE '160' ) ).
          EXIT.
        ENDIF.

      ENDDO.

      IF resultado_remover_componentes IS NOT INITIAL.

        c_es_lista_infotint-estado = icon_red_light.
        c_es_lista_infotint-ind_actualizado = gc_lista_mat_en_error.

        go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                            message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

        asignar_variante_sap( CHANGING c_es_lista_infotint = c_es_lista_infotint ).

      ELSE.
        c_es_lista_infotint-estado = icon_green_light.
        c_es_lista_infotint-ind_actualizado = gc_lista_material_ok.
        LOOP AT ti_variantes_bom INTO DATA(es_variante_bom)
        GROUP BY ( component = es_variante_bom-component
                   material = es_variante_bom-material ).
          go_log->set_es_log( i_es = VALUE #( type = 'S' number = '116' id = gc_clase_mensajes
                                              message_v1 = |{ es_variante_bom-component ALPHA = OUT }|
                                              message_v2 = es_variante_bom-material
                                              message_v3 = c_es_lista_infotint-alternativa_escala ) ).
        ENDLOOP.
        WAIT UP TO tiempo_espera_despues_bapi SECONDS.
      ENDIF.

    ENDIF.

    IF r_componente_eliminar IS INITIAL.

      consultar_lista_material( EXPORTING i_ti_lista_infotint = VALUE #( ( matnr = c_es_lista_infotint-material_generico_sap
                                                                           werks             = c_es_lista_infotint-centro
                                                                           stlal = c_es_lista_infotint-alternativa_escala ) )
                                IMPORTING e_ti_lista_material = ti_lista_material ).
      "Tomar las posiciones de los materiales quimicos que estén vacíos en el campo Valores desviación
      "FSH_VMKZ para ser eliminados los componentes de la lista de materiales por material genérico,
      "de lo contrario es porque tiene marca “X” que indica que el componente mínimamente contiene una variante mapeada,
      "entonces NO eliminarlo
      LOOP  AT ti_lista_material REFERENCE INTO DATA(r_es_lm)
                                 GROUP BY  r_es_lm->componente.

        IF NOT line_exists( ti_lista_material[ componente = r_es_lm->componente fsh_vmkz = abap_true ] ).
          APPEND VALUE #( sign = 'I' option = 'EQ' low = r_es_lm->componente )
          TO r_componente_eliminar.
        ENDIF.

      ENDLOOP.
    ENDIF.

    IF r_componente_eliminar IS NOT INITIAL OR i_ti_posicion_lista_eliminar IS NOT INITIAL.
      eliminar_componantes_generico( EXPORTING i_r_componente               = r_componente_eliminar
                                               i_ti_posicion_lista_eliminar = i_ti_posicion_lista_eliminar
                                               i_tiempo_espera_extendido    = i_tiempo_espera_extendido
                                     CHANGING  c_es_lista_infotint          = c_es_lista_infotint ).
    ENDIF.

*    ejecutar_consistencia_lm( i_es_lista_infotint = c_es_lista_infotint i_tiempo_espera_extendido = i_tiempo_espera_extendido ).

  ENDMETHOD.


  METHOD actualizar_lista_materiales.

    DATA: ti_datos_actualizar_lm        TYPE gtp_ti_datos_actualizar_lm,
          ti_posicion_lista_eliminar    TYPE STANDARD TABLE OF stpo_api03,
          ti_lm_generico                TYPE gtp_ti_lista_material,
          ti_lm_variante                TYPE gtp_ti_lista_material,
          ti_componentes_sap            TYPE gtp_ti_componentes_sap,
          es_posicion_lista             TYPE stpo_api03,
          ultima_posicion_lm_actualizar TYPE numc4,
          contador_posicion_lista_act   TYPE numc4,
          consecutivo_lista_actualizar  TYPE i,
          resultado_adicion_componentes TYPE sysubrc,
          fecha_valida_desde            TYPE datuv_bi,
          ind_componente_no_quimico     TYPE flag,
          cantidad_acumulada_componente TYPE ztppi1209_1-cant_mapeo.

    ti_componentes_sap = consultar_componentes( i_ti_lista_infotint = c_ti_lista_infotint ).

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    DATA(tiempo_espera_despues_bapi) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_BAPI' ]-low OPTIONAL ).

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                WHERE procesar = abap_true
                                AND ind_actualizado NE gc_lista_material_ok
                                AND estado = icon_light_out
                                AND material_variante IS NOT INITIAL
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico = <fs_es_lista_infotint_gr>-material_generico
                                           alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      verificar_consistencia_lm(
        CHANGING
          c_es_lista_infotint = <fs_es_lista_infotint_gr>
          c_ti_lista_infotint = c_ti_lista_infotint ).

      """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
      "Eliminar componentes lista anterior                           "
      """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
      eliminar_componantes_variante( EXPORTING i_incluir_todas_las_variantes = abap_false
                                     CHANGING  c_es_lista_infotint           = <fs_es_lista_infotint_gr>
                                               c_ti_lista_infotint           = c_ti_lista_infotint ).

      "Recorrer componentes de INFOTINT para ser actualizados en Lista de Material
      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>)
                                              GROUP BY ( color = <fs_es_lista_infotint>-color
                                                         "material_variante = <fs_es_lista_infotint>-material_variante
                                                         ).

        go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log      = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                       i_identificador            = get_id_log( <fs_es_lista_infotint> ) ).

        <fs_es_lista_infotint>-ind_actualizado = gc_lista_material_ok.
        <fs_es_lista_infotint>-estado = icon_green_light.

        CLEAR: cantidad_acumulada_componente,consecutivo_lista_actualizar, ti_datos_actualizar_lm,
               ti_posicion_lista_eliminar, ind_componente_no_quimico.

        "Si no existe errores en la eliminacion de componentes y existe la lsita
        IF <fs_es_lista_infotint>-ind_actualizado = gc_lista_material_ok.

          "Consulatar posiciones en lista de material existente para COMPONENTE
          consultar_lista_material( EXPORTING i_descartar_reg_eliminados  = abap_true
                                              i_incluir_material_variante = abap_true
                                              i_solo_componentes_quimicos = abap_true
                                              i_ti_lista_infotint         = VALUE #( ( matnr = <fs_es_lista_infotint_gr>-material_generico_sap
                                                                                       werks = <fs_es_lista_infotint_gr>-centro
                                                                                       stlal = <fs_es_lista_infotint_gr>-alternativa_escala ) )
                                    IMPORTING e_es_lm_cabecera            = DATA(es_lm_cabecera)
                                              e_ti_lista_material         = ti_lm_generico
                                              e_ti_lm_variantes           = ti_lm_variante
                                              e_ultima_posicion           = ultima_posicion_lm_actualizar ).

          "Recorrer variantes de COLOR x COMPONENTE
          LOOP AT GROUP <fs_es_lista_infotint> ASSIGNING FIELD-SYMBOL(<fs_es_ls_infotint_variante>).
            "validar que el componente sea un quimico
            DATA(es_componente_sap) = VALUE #( ti_componentes_sap[ componente = <fs_es_ls_infotint_variante>-componente ] OPTIONAL ).

            IF es_componente_sap-mtart NOT IN gr_tipo_material_quimico.
              <fs_es_lista_infotint>-estado = icon_red_light.
              <fs_es_lista_infotint>-ind_actualizado = gc_lista_mat_en_error.

              go_log->set_es_log( i_es = VALUE #( type = 'E' number = '106' id = gc_clase_mensajes
                                                message_v1 = <fs_es_ls_infotint_variante>-componente
                                                message_v2 = es_componente_sap-mtart ) ).

              ind_componente_no_quimico = abap_true.

              CONTINUE.
            ENDIF.

            "Valida si el componente existe, y asigna la misma posicion, de lo contrario asigna la ultima para sumar 10
            DATA(es_componente_en_lista) =
            VALUE #( ti_lm_generico[ componente = <fs_es_ls_infotint_variante>-componente ] OPTIONAL ).

            IF es_componente_en_lista IS NOT INITIAL."Componene exite en LM
              contador_posicion_lista_act = es_componente_en_lista-posnr.
            ELSE.
              "Si no existe el componente en la lista, debe sumar 10 a la ultima posicion
              ultima_posicion_lm_actualizar = ultima_posicion_lm_actualizar + 10.
              contador_posicion_lista_act = ultima_posicion_lm_actualizar.
            ENDIF.

            cantidad_acumulada_componente = <fs_es_ls_infotint_variante>-cant_mapeo.

            "Para actualizar
            DATA(es_componente_bom_en_lista) = VALUE #( ti_lm_variante[ matnr      = <fs_es_ls_infotint_variante>-material_variante
                                                                        componente = <fs_es_ls_infotint_variante>-componente ] OPTIONAL ).

            ASSIGN ti_datos_actualizar_lm[ fecha_valida_desde =  COND #( WHEN es_componente_en_lista-datuv IS NOT INITIAL THEN
                                                                           generar_fecha( es_componente_en_lista-datuv )
                                                                         ELSE
                                                                           fecha_valida_desde )  ]
            TO FIELD-SYMBOL(<fs_es_datos_actualizar_lm>).

            IF sy-subrc IS NOT INITIAL.
              APPEND INITIAL LINE TO ti_datos_actualizar_lm ASSIGNING <fs_es_datos_actualizar_lm>.
              <fs_es_datos_actualizar_lm>-fecha_valida_desde = COND #( WHEN es_componente_en_lista-datuv IS INITIAL THEN
                                                                          fecha_valida_desde
                                                                       ELSE
                                                                          generar_fecha( es_componente_en_lista-datuv ) ).
            ENDIF.

            IF NOT line_exists( <fs_es_datos_actualizar_lm>-ti_componentes[ component = <fs_es_ls_infotint_variante>-componente ] ).
              es_posicion_lista =
                     VALUE #( item_categ = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                              item_no    = contador_posicion_lista_act
                              id_item_no = COND #( WHEN es_componente_en_lista IS NOT INITIAL THEN
                                                     es_componente_en_lista-posnr"item_no
                                                   ELSE
                                                    space )
                              component = <fs_es_ls_infotint_variante>-componente
                              item_node = COND #( WHEN es_componente_en_lista IS NOT INITIAL THEN
                                                     es_componente_en_lista-stlkn "item_node
                                                   ELSE
                                                    space )
                              item_count = COND #( WHEN es_componente_en_lista IS NOT INITIAL THEN
                                                     es_componente_en_lista-stpoz "item_count
                                                   ELSE
                                                    space )
                              comp_qty = VALUE #( gr_cantidad_componente[ 1 ]-low OPTIONAL )
                              rel_cost = abap_true
                              fldelete = abap_false ).

              APPEND es_posicion_lista TO <fs_es_datos_actualizar_lm>-ti_componentes.
            ENDIF.

            CLEAR: es_posicion_lista.
            READ TABLE <fs_es_datos_actualizar_lm>-ti_componentes INTO es_posicion_lista
                                                   WITH KEY component = <fs_es_ls_infotint_variante>-componente.
            consecutivo_lista_actualizar = sy-tabix.

            APPEND VALUE #( item_categ  = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                            item_number = es_posicion_lista-item_no "contador_posicion_lista_act
                            item_node = COND #( WHEN es_posicion_lista IS NOT INITIAL THEN
                                                   es_posicion_lista-item_node
                                                 ELSE
                                                  space )
                            item_count = COND #( WHEN es_posicion_lista IS NOT INITIAL THEN
                                                   es_posicion_lista-item_count
                                                 ELSE
                                                  space )
                            material    = <fs_es_ls_infotint_variante>-material_variante
                            component   = <fs_es_ls_infotint_variante>-componente
                            quantity    = cantidad_acumulada_componente
                            fsh_comp_lno = consecutivo_lista_actualizar )
            TO  <fs_es_datos_actualizar_lm>-ti_variantes_bomd.

          ENDLOOP.

          IF ind_componente_no_quimico = abap_false.

            LOOP AT ti_datos_actualizar_lm ASSIGNING <fs_es_datos_actualizar_lm>.
              DATA(es_msg) = VALUE bapiret2( message_v1 = |{ TEXT-pag } { <fs_es_lista_infotint>-material_generico_sap }|
                                             message_v2 = |color { <fs_es_lista_infotint>-color } alt { <fs_es_lista_infotint>-alternativa_escala }|
                                             message_v3 = |fecha { <fs_es_datos_actualizar_lm>-fecha_valida_desde }| ).
              go_log->set_es_log( i_es = VALUE #( type = 'S' number = '117' id = 'ZPP01'
                                                message_v1 = es_msg-message_v1
                                                message_v2 = es_msg-message_v2
                                                message_v3 = es_msg-message_v3 ) ).

              cl_progress_indicator=>progress_indicate(
                EXPORTING
                  i_msgid              = 'ZPP01'
                  i_msgno              = '117'
                  i_msgv1              = es_msg-message_v1
                  i_msgv2              = es_msg-message_v2
                  i_msgv3              = es_msg-message_v3
                  i_processed          = 4
                  i_total              = g_cantidad_total_procesos
                  i_output_immediately = abap_true
              ).

              CLEAR: resultado_adicion_componentes.
              "Para evitar bloqueos, intenta N veces adicionar los componentes
              DO g_cantidad_intento_bloqueo TIMES.

                validar_bloqueo_usuario( <fs_es_lista_infotint_gr> ).

                ges_lm_infotint_en_proceso = REF #( <fs_es_lista_infotint> ).
                g_actualizacion_lm_terminada = abap_false.
                g_lm_bloqueada = abap_false.

                CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
                  EXPORTING
                    material           = <fs_es_lista_infotint_gr>-material_generico_sap
                    plant              = <fs_es_lista_infotint_gr>-centro
                    bom_usage          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
                    alternative        = <fs_es_lista_infotint_gr>-alternativa_escala(2)
                    valid_from         = <fs_es_datos_actualizar_lm>-fecha_valida_desde
                    i_stko             = VALUE stko_api01( base_quan = es_lm_cabecera-bmeng_no_decimal
                                                           alt_text  = es_lm_cabecera-stktx )
                    fl_commit_and_wait = abap_true
                  TABLES
                    t_stpo             = <fs_es_datos_actualizar_lm>-ti_componentes
                    t_fsh_bomd         = <fs_es_datos_actualizar_lm>-ti_variantes_bomd
                  EXCEPTIONS
                    error              = 1
                    OTHERS             = 2.

                resultado_adicion_componentes = sy-subrc.
                "Sis se ejecuto de forma correcta, o si el error es diferente al bloqueo
                IF resultado_adicion_componentes IS INITIAL
                OR ( resultado_adicion_componentes IS NOT INITIAL AND ( sy-msgid NE '29' OR sy-msgno NE '160' ) ).
                  EXIT.
                ENDIF.

              ENDDO.

              IF resultado_adicion_componentes IS NOT INITIAL.

                <fs_es_lista_infotint>-estado = icon_red_light.
                <fs_es_lista_infotint>-ind_actualizado = gc_lista_mat_en_error.

                go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                                  message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

                asignar_variante_sap( CHANGING c_es_lista_infotint = <fs_es_lista_infotint> ).

              ELSE.
                <fs_es_lista_infotint>-estado = icon_green_light.
                <fs_es_lista_infotint>-ind_actualizado = gc_lista_material_ok.

                LOOP AT <fs_es_datos_actualizar_lm>-ti_variantes_bomd INTO DATA(es_variantes)
                                                                      GROUP BY ( component = es_variantes-component
                                                                                 material = es_variantes-material ).
                  go_log->set_es_log( i_es = VALUE #( type = 'S' number = '097' id = gc_clase_mensajes
                                                      message_v1 = es_variantes-component
                                                      message_v2 = es_variantes-material
                                                      message_v3 = <fs_es_lista_infotint>-alternativa_escala ) ).
                ENDLOOP.

                WAIT UP TO tiempo_espera_despues_bapi SECONDS.
              ENDIF.

            ENDLOOP.

          ENDIF.

        ENDIF.

        "Actualizar a nivel de material variante
        MODIFY c_ti_lista_infotint
        USING KEY key_agrupador
        FROM VALUE #( ind_actualizado = <fs_es_lista_infotint>-ind_actualizado estado = <fs_es_lista_infotint>-estado
                      fecha_actualizacion = sy-datum hora_actualizacion = sy-uzeit usuario_actualizacion = sy-uname
                      )
        TRANSPORTING ind_actualizado estado fecha_actualizacion hora_actualizacion usuario_actualizacion
        WHERE centro = <fs_es_lista_infotint>-centro
          AND material_generico = <fs_es_lista_infotint>-material_generico
          AND color = <fs_es_lista_infotint>-color
          AND alternativa_escala = <fs_es_lista_infotint>-alternativa_escala.

      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.


  METHOD respuesta_actualizacion_lm.

    DATA: log_con_advertencia        TYPE flwarning,
          es_cabecera_lista_material TYPE stko_api02.

    FIELD-SYMBOLS: <fs_es_lista_infotint> TYPE gtp_es_datos_infotint.

    ASSIGN ges_lm_infotint_en_proceso->* TO <fs_es_lista_infotint>.

    g_actualizacion_lm_terminada = abap_true.

    RECEIVE RESULTS FROM FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
        IMPORTING
          fl_warning         = log_con_advertencia
          o_stko             = es_cabecera_lista_material
        EXCEPTIONS
          error              = 1
          OTHERS             = 2.

    DATA(resultado_adicion_componentes) = sy-subrc.

    IF resultado_adicion_componentes IS NOT INITIAL.

      IF  sy-msgid = '29' AND sy-msgno = '160'.
        g_lm_bloqueada = abap_true.
      ELSE.

        <fs_es_lista_infotint>-estado = icon_red_light.
        <fs_es_lista_infotint>-ind_actualizado = gc_lista_mat_en_error.

        go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                          message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

        asignar_variante_sap( CHANGING c_es_lista_infotint = <fs_es_lista_infotint> ).
      ENDIF.

    ELSE.

      <fs_es_lista_infotint>-estado = icon_green_light.
      <fs_es_lista_infotint>-ind_actualizado = gc_lista_material_ok.

      go_log->set_es_log( i_es = VALUE #( type = 'S' number = '097' id = gc_clase_mensajes
                                          message_v1 = |{ <fs_es_lista_infotint>-material_generico_sap ALPHA = OUT }|
                                          message_v2 = <fs_es_lista_infotint>-color
                                          message_v3 = <fs_es_lista_infotint>-alternativa_escala ) ).
    ENDIF.

  ENDMETHOD.


  METHOD modificar_catalogo.

    LOOP AT c_ti_catalogo ASSIGNING FIELD-SYMBOL(<fs_es_catalogo>).
      <fs_es_catalogo>-col_opt = abap_true.

      CASE <fs_es_catalogo>-fieldname.

        WHEN 'PROCESAR'.
          <fs_es_catalogo>-checkbox = abap_true.
          <fs_es_catalogo>-edit = abap_true.
        WHEN 'ESTADO'.
          <fs_es_catalogo>-just = 'C'.
        WHEN 'IND_ACTUALIZADO'.
          <fs_es_catalogo>-f4availabl = abap_true.
          <fs_es_catalogo>-domname = 'ZDMIND_ACTUALIZADO'.
          <fs_es_catalogo>-ref_table = 'ZTPPI1209_1'.
          <fs_es_catalogo>-ref_field = 'IND_ACTUALIZADO'.
        WHEN 'MENSAJE'.
          <fs_es_catalogo>-col_opt = abap_false.
          <fs_es_catalogo>-outputlen = 15.
          <fs_es_catalogo>-hotspot = abap_true.
        WHEN 'COMPONENTE'.
          <fs_es_catalogo>-coltext = TEXT-cmp.
        WHEN 'MATERIAL_VARIANTE'.
          <fs_es_catalogo>-coltext = TEXT-mvr.
          <fs_es_catalogo>-hotspot = abap_true.
        WHEN 'MATERIAL_GENERICO'.
          <fs_es_catalogo>-coltext = TEXT-mgl.
        WHEN 'MATERIAL_GENERICO_SAP'.
          <fs_es_catalogo>-coltext = TEXT-mgs.
          <fs_es_catalogo>-hotspot = abap_true.
      ENDCASE.

    ENDLOOP.

  ENDMETHOD.


  METHOD evento_hotspot.

    DATA: ti_bdcdata  TYPE TABLE OF bdcdata,
          material_lm TYPE matnr.

    ASSIGN gti_lista_infotint[ e_row_id-index ] TO FIELD-SYMBOL(<fs_es_infotint>).

    CHECK <fs_es_infotint> IS ASSIGNED.

    CASE e_column_id.
      WHEN 'MENSAJE'.

        CHECK <fs_es_infotint>-mensaje IS NOT INITIAL.

        visualizar_log( i_id_log = <fs_es_infotint>-mensaje ).
      WHEN 'MATERIAL_GENERICO_SAP' OR 'MATERIAL_VARIANTE'.

        material_lm = COND #( WHEN e_column_id = 'MATERIAL_GENERICO_SAP' THEN
                                <fs_es_infotint>-material_generico_sap
                              ELSE
                                <fs_es_infotint>-material_variante ).
        DATA(utilizacion) = VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ).

        SET PARAMETER ID 'MAT' FIELD material_lm.
        SET PARAMETER ID 'WRK' FIELD <fs_es_infotint>-centro.
        SET PARAMETER ID 'CSV' FIELD utilizacion.

        ti_bdcdata = VALUE #( ( program = 'SAPLCSDI' dynpro = '0100' dynbegin = abap_true )
                              ( fnam = 'BDC_CURSOR'  fval = 'RC29N-WERKS' )
                              ( fnam = 'RC29N-WERKS' fval = <fs_es_infotint>-centro )
                              ( fnam = 'BDC_CURSOR'  fval = 'RC29N-STLAN' )
                              ( fnam = 'RC29N-STLAN' fval = utilizacion )
                              ( fnam = 'BDC_CURSOR'  fval = 'RC29N-STLAL' )
                              ( fnam = 'RC29N-STLAL' fval = <fs_es_infotint>-alternativa_escala )
                            ).

        CALL TRANSACTION 'CS03'." USING ti_bdcdata.

    ENDCASE.

  ENDMETHOD.


  METHOD evento_tool_bar.

    INSERT VALUE #( function = '&PROC' icon  = icon_generate
                    text = TEXT-001 quickinfo = TEXT-001 )
    INTO e_object->mt_toolbar INDEX 1.

    INSERT VALUE #( function = '&&SEP01' butn_type = 3 )
    INTO e_object->mt_toolbar INDEX 2.

    INSERT VALUE #( function = '&MARCAR' icon  = icon_select_all )
    INTO e_object->mt_toolbar INDEX 3.

    INSERT VALUE #( function = '&DESMARCAR' icon  = icon_deselect_all )
    INTO e_object->mt_toolbar INDEX 4.

    MODIFY e_object->mt_toolbar
    FROM VALUE #( function = '&ACTUALIZAR' )
    TRANSPORTING function
    WHERE function = '&REFRESH'.

    DELETE e_object->mt_toolbar WHERE function = '&LOCAL&CUT'
                                   OR function = '&LOCAL&COPY'
                                   OR function = '&CHECK'
                                   OR function = '&LOCAL&PASTE'
                                   OR function = '&LOCAL&UNDO'
                                   OR function = '&&SEP00'
                                   OR function = '&&SEP02'
                                   OR function = '&LOCAL&APPEND'
                                   OR function = '&LOCAL&INSERT_ROW'
                                   OR function = '&LOCAL&DELETE_ROW'
                                   OR function = '&LOCAL&COPY_ROW'
                                   OR function = '&INFO'.

  ENDMETHOD.


  METHOD evento_user_comand.

    CASE e_ucomm.
      WHEN '&MARCAR'.

        LOOP AT gti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>)
                                   WHERE ind_actualizado NE gc_lista_material_ok.
          <fs_es_lista_infotint>-procesar = abap_true.
        ENDLOOP.

      WHEN '&DESMARCAR'.
        LOOP AT gti_lista_infotint ASSIGNING <fs_es_lista_infotint>.
          <fs_es_lista_infotint>-procesar = abap_false.
        ENDLOOP.
      WHEN '&ACTUALIZAR'.
        iniciar_tratamiento_infotint(
          EXPORTING
            i_r_centro                  = gr_centro
            i_r_fecha_envio             = gr_fecha_envio
            i_r_material_legado         = gr_material_legado
            i_r_material                = gr_material
            i_r_color                   = gr_color
            i_r_alternativa             = gr_alternativa_escala
            i_pendiente_procesar        = g_pendiente_procesar
            i_actualizar_registros      = abap_true
            i_r_indicador_actualizacion = gr_indicador_actualizacion ).
      WHEN '&PROC'.
        go_alv->check_changed_data( ).
        procesar_registros_infotint( ).
    ENDCASE.

    go_alv->refresh_table_display(
      EXPORTING
        is_stable      = VALUE #( row = abap_true
                                  col = abap_true )
        i_soft_refresh = abap_true
      EXCEPTIONS
        finished       = 1
        OTHERS         = 2 ).

  ENDMETHOD.


  METHOD evento_data_change.

    FIELD-SYMBOLS: <fs_ti_lista_infotint_mod> TYPE gtp_ti_lista_infotint.

    CHECK line_exists( er_data_changed->mt_mod_cells[ fieldname = 'PROCESAR' ] ).

    ASSIGN er_data_changed->mp_mod_rows->*
    TO <fs_ti_lista_infotint_mod>.

    LOOP AT <fs_ti_lista_infotint_mod> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_mod>)
                                       WHERE material_variante IS NOT INITIAL.

      IF <fs_es_lista_infotint_mod>-procesar = abap_true AND
      <fs_es_lista_infotint_mod>-ind_actualizado = gc_lista_material_ok.
        <fs_es_lista_infotint_mod>-procesar = abap_false.
      ENDIF.

      LOOP AT gti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>)
                                  WHERE centro = <fs_es_lista_infotint_mod>-centro
                                  AND   material_generico = <fs_es_lista_infotint_mod>-material_generico
                                  AND   color = <fs_es_lista_infotint_mod>-color
                                  AND   alternativa_escala = <fs_es_lista_infotint_mod>-alternativa_escala
                                  AND   material_variante IS NOT INITIAL.

        IF <fs_es_lista_infotint>-ind_actualizado NE gc_lista_material_ok.
          <fs_es_lista_infotint>-procesar = <fs_es_lista_infotint_mod>-procesar.
        ELSE.
          <fs_es_lista_infotint>-procesar = abap_false.
        ENDIF.

      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.


  METHOD evento_data_change_finish.

    CHECK line_exists( et_good_cells[ fieldname = 'PROCESAR' ] ).

    go_alv->refresh_table_display(
      EXPORTING
        is_stable = VALUE #( row = abap_true
                             col = abap_true )
      EXCEPTIONS
        finished  = 1
        OTHERS    = 2 ).

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

  ENDMETHOD.


  METHOD registrar_modificaciones.

    DATA: alternativa_escala  TYPE ztppi1209_1-alternativa_escala,
          estado_grupal       TYPE icon_d,
          r_material_variante TYPE RANGE OF mara-matnr.

    ejec_consistencia_lm_masivo(
      CHANGING
        c_ti_lista_infotint = c_ti_lista_infotint ).

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                          WHERE procesar = abap_true
                                          AND material_variante IS NOT INITIAL
                                          GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                                     material_generico = <fs_es_lista_infotint_gr>-material_generico
                                                     color = <fs_es_lista_infotint_gr>-color
                                                     alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      DATA(ti_numero_log) = go_log->guardar( i_id_log = get_id_log( <fs_es_lista_infotint_gr> ) ).
      e_es_log = VALUE #( ti_numero_log[ 1 ] OPTIONAL ).

      CLEAR: r_material_variante, estado_grupal.

      "Validar si existen variantes con error
      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>)
                                              WHERE variantes_sap NE space.

        SPLIT <fs_es_lista_infotint>-variantes_sap AT ';' INTO TABLE DATA(ti_variantes).
        r_material_variante = VALUE #( BASE r_material_variante FOR es_variante IN ti_variantes ( sign = 'I' option = 'EQ' low = es_variante ) ).

      ENDLOOP.

      DELETE r_material_variante WHERE low = space.

      "si existe un subgrupo en error, se debe asignar el ind_actualizado = 9 y estado warning
      IF r_material_variante IS NOT INITIAL.

        SORT r_material_variante BY low.
        DELETE ADJACENT DUPLICATES FROM r_material_variante COMPARING low.

        <fs_es_lista_infotint_gr>-variantes_sap =
          zclcxr1002_util=>ti_a_string(
          i_r_excluir_columnas         = VALUE #( sign = 'I' option = 'EQ'
                                                  ( low = 'SIGN' )
                                                  ( low = 'OPTION' )
                                                  ( low = 'HIGH' ) )
          i_ti                         = r_material_variante
          i_separador_como_salto_linea = abap_true ).

        <fs_es_lista_infotint_gr>-ind_actualizado = gc_lista_mat_en_error.
        "primero valida si alguna variante fue actualizada con exito
        IF line_exists( c_ti_lista_infotint[ KEY key_agrupador
                                             centro = <fs_es_lista_infotint_gr>-centro
                                             material_generico = <fs_es_lista_infotint_gr>-material_generico
                                             color = <fs_es_lista_infotint_gr>-color
                                             alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala
                                             estado = icon_green_light ] ).
          estado_grupal = icon_yellow_light.
        ELSE.
          estado_grupal = icon_red_light.
        ENDIF.
      ENDIF.

      alternativa_escala = shift_left( val = <fs_es_lista_infotint_gr>-alternativa_escala sub = '0' ).

      UPDATE ztppi1209_1
      SET mensaje =  e_es_log-extnumber
          ind_actualizado = <fs_es_lista_infotint_gr>-ind_actualizado
          variantes_sap = <fs_es_lista_infotint_gr>-variantes_sap
          fecha_actualizacion = sy-datum
          hora_actualizacion = sy-uzeit
          usuario_actualizacion = sy-uname
      WHERE centro = <fs_es_lista_infotint_gr>-centro
            AND material_generico = <fs_es_lista_infotint_gr>-material_generico
            AND color = <fs_es_lista_infotint_gr>-color
            AND alternativa_escala = alternativa_escala.

      COMMIT WORK AND WAIT.
      "Modificar valores generales
      MODIFY c_ti_lista_infotint
        USING KEY key_agrupador
        FROM VALUE #( variantes_sap = <fs_es_lista_infotint_gr>-variantes_sap
                      ind_actualizado = <fs_es_lista_infotint_gr>-ind_actualizado
                      mensaje =  e_es_log-extnumber
                      fecha_actualizacion = sy-datum hora_actualizacion = sy-uzeit usuario_actualizacion = sy-uname )
        TRANSPORTING variantes_sap mensaje ind_actualizado fecha_actualizacion
                     hora_actualizacion usuario_actualizacion
        WHERE centro = <fs_es_lista_infotint_gr>-centro
              AND material_generico = <fs_es_lista_infotint_gr>-material_generico
              AND color = <fs_es_lista_infotint_gr>-color
              AND alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala.

      "Modificar estado
      MODIFY c_ti_lista_infotint
      USING KEY key_agrupador
      FROM VALUE #( estado  = COND #( WHEN estado_grupal IS NOT INITIAL THEN estado_grupal ELSE <fs_es_lista_infotint_gr>-estado ) )
      TRANSPORTING estado
      WHERE centro = <fs_es_lista_infotint_gr>-centro
            AND material_variante NOT IN r_material_variante
            AND material_generico = <fs_es_lista_infotint_gr>-material_generico
            AND color = <fs_es_lista_infotint_gr>-color
            AND alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala.

    ENDLOOP.

    LOOP AT c_ti_lista_infotint ASSIGNING <fs_es_lista_infotint>
                                WHERE ind_actualizado = gc_lista_material_ok.
      <fs_es_lista_infotint>-procesar =  abap_false.
    ENDLOOP.

  ENDMETHOD.


  METHOD consultar_lista_material_db.

    CLEAR: e_ti_lista_material.

    CHECK i_ti_lista_infotint IS NOT INITIAL.

    SELECT
    FROM mast AS _lista_material
    LEFT JOIN stas AS _pos_lista_material ON
    _pos_lista_material~stlnr = _lista_material~stlnr
    AND _pos_lista_material~stlal = _lista_material~stlal
***    AND _pos_lista_material~lkenz = @space
    LEFT JOIN stko AS _lista_material_cab ON
    _lista_material_cab~stlnr = _pos_lista_material~stlnr
    AND _lista_material_cab~stlal = _pos_lista_material~stlal
    AND _pos_lista_material~stlkn = _pos_lista_material~stlkn
    LEFT JOIN stpo AS _lista_material_pos ON
    _lista_material_pos~stlnr = _pos_lista_material~stlnr
    AND _lista_material_pos~stlkn = _pos_lista_material~stlkn
***    AND _lista_material_pos~lkenz = @space
    LEFT JOIN mara AS _material ON
    _material~matnr = _lista_material_pos~idnrk
    FIELDS _lista_material~matnr, _lista_material~werks, mtart, _lista_material~stlan, _lista_material~stlal,
    _material~matnr AS material_lista, _material~mtart, idnrk AS componente, _lista_material_cab~bmeng, _lista_material_cab~stktx,
    postp, posnr, menge, _lista_material_pos~stlkn, stpoz, _lista_material_pos~stlnr, _lista_material_pos~datuv, fsh_vmkz,
    sanka AS rel_cost,
    _lista_material_pos~lkenz AS ind_borrado_stpo, _pos_lista_material~lkenz AS ind_borrado_stas
    FOR ALL ENTRIES IN @i_ti_lista_infotint
    WHERE _lista_material~matnr = @i_ti_lista_infotint-matnr
    AND _lista_material~werks   = @i_ti_lista_infotint-werks
    AND _lista_material~stlal   = @i_ti_lista_infotint-stlal
    INTO CORRESPONDING FIELDS OF TABLE @e_ti_lista_material.

  ENDMETHOD.


  METHOD consultar_lista_material.

    CLEAR: e_ultima_posicion.

    consultar_lista_material_db(
      EXPORTING
        i_ti_lista_infotint = i_ti_lista_infotint
      IMPORTING
        e_ti_lista_material = e_ti_lista_material ).

    SORT e_ti_lista_material BY werks matnr stlal posnr componente DESCENDING stlkn DESCENDING stpoz .

    e_es_lm_cabecera = CORRESPONDING #( VALUE #( e_ti_lista_material[ 1 ] OPTIONAL ) ).

    e_es_lm_cabecera-bmeng_no_decimal = e_es_lm_cabecera-bmeng.
    CONDENSE e_es_lm_cabecera-bmeng_no_decimal NO-GAPS.
    SPLIT e_es_lm_cabecera-bmeng_no_decimal AT '.' INTO TABLE DATA(ti_numero).

    IF ti_numero IS NOT INITIAL.

      CLEAR: e_es_lm_cabecera-bmeng_no_decimal.

      LOOP AT ti_numero INTO DATA(numero).
        IF sy-tabix = lines( ti_numero ) AND CONV i( numero ) IS INITIAL.
          CONTINUE.
        ENDIF.

        e_es_lm_cabecera-bmeng_no_decimal = |{ e_es_lm_cabecera-bmeng_no_decimal }.{ numero }|.

      ENDLOOP.

      REPLACE FIRST OCCURRENCE OF '.' IN e_es_lm_cabecera-bmeng_no_decimal WITH space.
      REPLACE ALL OCCURRENCES OF '.' IN e_es_lm_cabecera-bmeng_no_decimal WITH ','.
      CONDENSE e_es_lm_cabecera-bmeng_no_decimal NO-GAPS.
    ENDIF.

    "Ultima posicion de la lista, entendiendo que solo se envia UN material generico
    DATA(ti_lista_material) = e_ti_lista_material.
    DELETE ti_lista_material WHERE ind_borrado_stas NE space OR ind_borrado_stpo NE space.
    e_ultima_posicion = VALUE #( ti_lista_material[ lines( ti_lista_material ) ]-posnr OPTIONAL ).

    IF i_incluir_material_variante = abap_true.

      "Consultar variantes de generico
      SELECT werks, stlal, mara~matnr, satnr AS material_generico_sap
      FROM @i_ti_lista_infotint AS _lista_infotint
      INNER JOIN mara ON
      mara~satnr = _lista_infotint~matnr
      INTO TABLE @DATA(ti_variantes).

      consultar_lista_material_db(
        EXPORTING
          i_ti_lista_infotint = CORRESPONDING #( ti_variantes )
        IMPORTING
          e_ti_lista_material = e_ti_lm_variantes ).
    ENDIF.

    IF i_descartar_reg_eliminados = abap_true.
      DELETE e_ti_lista_material WHERE ind_borrado_stas NE space AND ind_borrado_stpo NE space.
      DELETE e_ti_lm_variantes WHERE ind_borrado_stas NE space AND ind_borrado_stpo NE space.
    ENDIF.

    IF i_solo_componentes_quimicos = abap_true.
      DELETE e_ti_lista_material WHERE mtart NOT IN gr_tipo_material_quimico.
      DELETE e_ti_lm_variantes WHERE mtart NOT IN gr_tipo_material_quimico.
    ENDIF.

  ENDMETHOD.


  METHOD visualizar_log.

    DATA: ti_bdcdata TYPE TABLE OF bdcdata.

    SET PARAMETER ID 'BALOBJ' FIELD 'ZPP_1'.
    SET PARAMETER ID 'BALSUBOBJ' FIELD 'ZR1157_1'.
    SET PARAMETER ID 'BALEXT' FIELD i_id_log.

    ti_bdcdata = VALUE #( ( program = 'SAPLSLG3' dynpro = '0100' dynbegin = abap_true )
                          ( fnam = 'BDC_CURSOR'  fval = 'BALHDR-ALDATE' )
                          ( fnam = 'BALHDR-ALDATE' fval = '01.01.2024' )
*                          ( fnam = 'BDC_OKCODE' fval = '=SELE' )
                          ).

    CALL TRANSACTION 'SLG1'
    USING ti_bdcdata.

  ENDMETHOD.


  METHOD consultar_componentes.

    CHECK i_ti_lista_infotint IS NOT INITIAL.

    SELECT componente, _centro_material~werks, _material~mtart, _material~lvorm AS peticion_borrado_mat
    FROM @i_ti_lista_infotint AS _lista_infotint
    INNER JOIN mara AS _material ON
    _material~matnr = _lista_infotint~componente
    LEFT JOIN marc AS _centro_material ON
    _centro_material~werks = _lista_infotint~centro
    AND _centro_material~matnr = _lista_infotint~componente
    INTO CORRESPONDING FIELDS OF TABLE @r_ti_componentes.

  ENDMETHOD.


  METHOD validar_bloqueo_usuario.

    DATA: ti_bloqueos_lista        TYPE STANDARD TABLE OF seqg3,
          ti_bloqueos_lista_pos    TYPE STANDARD TABLE OF seqg3,
          ti_bloqueos_material     TYPE STANDARD TABLE OF seqg3,
          contador_intento_bloqueo TYPE i.

    DO.
      CLEAR: ti_bloqueos_lista, ti_bloqueos_material, ti_bloqueos_lista_pos.

      CALL FUNCTION 'ENQUEUE_ECMASTE'
        EXPORTING
          mode_mast      = 'V'
          matnr          = i_es_lista_infotint-material_generico_sap
          werks          = i_es_lista_infotint-centro
          stlan          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
          x_werks        = abap_true
        EXCEPTIONS
          foreign_lock   = 2
          system_failure = 3.

      IF  ( sy-subrc NE 2 )
      OR contador_intento_bloqueo > g_cantidad_intento_bloqueo.
        CALL FUNCTION 'DEQUEUE_ECMASTE'
          EXPORTING
            mode_mast = 'V'
            matnr     = i_es_lista_infotint-material_generico_sap
            werks     = i_es_lista_infotint-centro
            stlan     = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
            x_werks   = abap_true.

        EXIT.
      ELSE.

        ADD 1 TO contador_intento_bloqueo.
        WAIT UP TO 1 SECONDS.

      ENDIF.

    ENDDO.

    IF contador_intento_bloqueo >= 1.
      go_log->set_es_log( i_es = VALUE #( type = 'S' number = '114' id = gc_clase_mensajes
                                              message_v1 = sy-uname
                                              message_v2 = contador_intento_bloqueo ) ).
    ENDIF.

  ENDMETHOD.


  METHOD get_id_log.

    IF g_cronomarcador_utc IS INITIAL.
      CONVERT DATE sy-datum TIME sy-uzeit
      INTO TIME STAMP g_cronomarcador_utc TIME ZONE gc_huso_horario.
    ENDIF.

    r_id_log =
    |{ i_es_lista_infotint-centro }{ shift_left( val = i_es_lista_infotint-material_generico sub = '0' ) }{ i_es_lista_infotint-color }{ i_es_lista_infotint-alternativa_escala }_{ shift_left( val =  |{ g_cronomarcador_utc }| sub = space ) }|.

  ENDMETHOD.


  METHOD ejec_consistencia_lm_masivo.

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                WHERE procesar = abap_true
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico_sap = <fs_es_lista_infotint_gr>-material_generico_sap
                                           alternativa_escala    = <fs_es_lista_infotint_gr>-alternativa_escala ).

      go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log      = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                         i_identificador            = get_id_log( <fs_es_lista_infotint_gr> )
                                                       ).
      verificar_consistencia_lm(
        EXPORTING
          i_numero_proceso    = 5
        CHANGING
          c_es_lista_infotint = <fs_es_lista_infotint_gr>
          c_ti_lista_infotint = c_ti_lista_infotint ).

      DATA(ti_componente_x_variantes) =
        consolidar_componente_variante(
        EXPORTING
          i_es_lista_infotint = <fs_es_lista_infotint_gr>
          i_ti_lista_infotint = c_ti_lista_infotint ).

      DO 2 TIMES.
        DATA(numero_de_iteracion) = sy-index.

        leer_componentes_duplicados(
          EXPORTING
            i_ti_componente_x_variantes   = ti_componente_x_variantes
            i_es_lista_infotint           = <fs_es_lista_infotint_gr>
            i_incluir_todas_las_variantes = abap_true
          IMPORTING
            e_ti_variantes_duplicadas     = DATA(ti_variantes_duplicadas) ).

        IF ti_variantes_duplicadas IS NOT INITIAL.

          IF numero_de_iteracion = 1.
            verificar_consistencia_lm(
              EXPORTING
                i_numero_proceso          = 5
                i_tiempo_espera_extendido = abap_true
              CHANGING
                c_es_lista_infotint       = <fs_es_lista_infotint_gr>
                c_ti_lista_infotint       = c_ti_lista_infotint ).
          ELSE.
            go_log->set_es_log( i_es = VALUE #( type = 'W' number = '115' id = gc_clase_mensajes
                                                message_v1 = <fs_es_lista_infotint_gr>-material_generico_sap
                                                message_v2 = <fs_es_lista_infotint_gr>-color
                                                message_v3 = <fs_es_lista_infotint_gr>-alternativa_escala ) ).
          ENDIF.
        ELSE.
          EXIT.
        ENDIF.
      ENDDO.

    ENDLOOP.

  ENDMETHOD.


  METHOD ejecutar_consistencia_lm.

    DATA: r_material_generico          TYPE RANGE OF marc-matnr,
          r_centro                     TYPE RANGE OF marc-werks,
          contador_intento_bloqueo     TYPE i,
          job_finalizado               TYPE flag,
          numero_job                   TYPE tbtcjob-jobcount,
          nombre_job                   TYPE tbtcjob-jobname,
          gs_bom_constcy_chk_log_param TYPE if_rfm_pp_bom_consty_chk_commn=>ty_s_bom_constcy_chk_log_param,
          gt_matnr_selopt              TYPE rfm_pp_tt_selopt,
          gt_werks_selopt              TYPE rfm_pp_tt_selopt,
          go_mbom_constcy_chk_process  TYPE REF TO if_rfm_pp_mbom_consistency_chk.

    go_log->set_es_log( i_es = VALUE #( type = 'S' number = '007' id = 'CRMS4_IU_CM_PROCESS'
                                        message_v1 = TEXT-ir6 ) ).
    DATA(tiempo_espera_despues_r1096) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_R1096' ]-low OPTIONAL ).

    IF i_tiempo_espera_extendido = abap_true.
      tiempo_espera_despues_r1096 = tiempo_espera_despues_r1096 * 2.
    ENDIF.

    cl_progress_indicator=>progress_indicate(
      EXPORTING
        i_msgid              = 'ZPP01'
        i_msgno              = '117'
        i_msgv1              = TEXT-ir6
        i_processed          = 2
        i_total              = g_cantidad_total_procesos
        i_output_immediately = abap_true ).

    validar_bloqueo_usuario( i_es_lista_infotint ).

    r_material_generico = VALUE #( sign = 'I' option = 'EQ' ( low = i_es_lista_infotint-material_generico_sap ) ).
    r_centro = VALUE #( sign = 'I' option = 'EQ' ( low = i_es_lista_infotint-centro ) ).

    go_mbom_constcy_chk_process = cl_rfm_pp_bom_maint_factory=>get_object( )->check_mbom_consistency( ) ##NEEDED.

    gs_bom_constcy_chk_log_param-log_active      = abap_true.
    gs_bom_constcy_chk_log_param-log_granularity = abap_true.
*    gs_bom_constcy_chk_log_param-log_validity    = abap_true.

    gt_matnr_selopt[] = r_material_generico.
    gt_werks_selopt[] = r_centro.

*    go_mbom_constcy_chk_process->fix_bom_inconsistencies(
*      EXPORTING
*        it_matnr_selopt              = gt_matnr_selopt
*        it_werks_selopt              = gt_werks_selopt
*        is_bom_consty_chk_log_params = gs_bom_constcy_chk_log_param ).

    WAIT UP TO tiempo_espera_despues_r1096 SECONDS.
    "El siguiente proceso se deja deshabilitado dado que la R1156 por estrategia de rendimiento se decidio hacer sobre el mimos proceso de trabajo
    "En caso de requerir ejecutar en FONDO, solo se debe comentar la linea del RETURN y comentar los llamados anteriores
    RETURN.
    nombre_job = |{ i_nombre_job }|.

    CALL FUNCTION 'JOB_OPEN'
      EXPORTING
        jobname          = nombre_job
      IMPORTING
        jobcount         = numero_job
      EXCEPTIONS
        cant_create_job  = 1
        invalid_job_data = 2
        jobname_missing  = 3
        OTHERS           = 4.
    IF sy-subrc = 0.

      SUBMIT rfm_pp_bom_consistency_check
       WITH p_matnr IN r_material_generico
       WITH p_werks IN r_centro
       WITH p_fixbom = abap_true
       WITH p_dislog = abap_true
       WITH p_log    = abap_true
       WITH p_gralog = '0'
*       WITH P_PPROC = abap_true
       VIA JOB nombre_job NUMBER numero_job
       AND RETURN.

      IF sy-subrc = 0.
        CALL FUNCTION 'JOB_CLOSE'
          EXPORTING
            jobcount             = numero_job
            jobname              = nombre_job
            strtimmed            = 'X'
          EXCEPTIONS
            cant_start_immediate = 1
            invalid_startdate    = 2
            jobname_missing      = 3
            job_close_failed     = 4
            job_nosteps          = 5
            job_notex            = 6
            lock_failed          = 7
            OTHERS               = 8.

        IF sy-subrc <> 0.

        ENDIF.
        "Esperar que el JOB termine
        DO.

          CALL FUNCTION 'SHOW_JOBSTATE'
            EXPORTING
              jobcount         = numero_job
              jobname          = nombre_job
            IMPORTING
              finished         = job_finalizado
            EXCEPTIONS
              jobcount_missing = 1
              jobname_missing  = 2
              job_notex        = 3
              OTHERS           = 4.

          IF sy-subrc <> 0 OR job_finalizado = abap_true
          OR contador_intento_bloqueo > g_cantidad_intento_bloqueo.
            EXIT.
          ELSE.
            WAIT UP TO 1 SECONDS.
            ADD 1 TO contador_intento_bloqueo.
          ENDIF.

        ENDDO.

      ELSE.
        DATA(msg) = cl_abap_submit_handling=>get_error_message( ).
        MESSAGE ID msg-msgid
                TYPE 'I'
                NUMBER msg-msgno
                WITH msg-msgv1 msg-msgv2 msg-msgv3 msg-msgv4
                DISPLAY LIKE msg-msgty.
      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD asignar_variante_sap.

    c_es_lista_infotint-variantes_sap = |{ c_es_lista_infotint-variantes_sap };{ c_es_lista_infotint-material_variante }|.

  ENDMETHOD.


  METHOD generar_fecha.
    r_fecha = |{ i_fecha+6(2) }.{ i_fecha+4(2) }.{ i_fecha(4) }|.
  ENDMETHOD.


  METHOD ejecutar_proeso_agrupado_job.

    DATA: r_material_generico      TYPE RANGE OF marc-matnr,
          r_material_legado        TYPE gtp_r_material,
          r_centro                 TYPE RANGE OF marc-werks,
          contador_intento_bloqueo TYPE i,
          job_finalizado           TYPE flag,
          job_abortado             TYPE flag,
          job_preliminar           TYPE flag,
          job_listo                TYPE flag,
          job_en_ejecucion         TYPE flag,
          job_programado           TYPE flag,
          job_suspendido           TYPE flag,
          job_otros                TYPE flag,
          numero_job               TYPE tbtcjob-jobcount,
          nombre_job               TYPE tbtcjob-jobname,
          r_colores                TYPE RANGE OF ztppi1209_1-color,
          colores                  TYPE string,
          r_alternativa            TYPE RANGE OF ztppi1209_1-alternativa_escala,
          cantidad_colores_x_job   TYPE i,
          cantidad_total_procesos  TYPE i,
          contador_proceso_actual  TYPE i,
          contador_colores         TYPE i.

    go_parametros = NEW zclcxr1000_parametros(
      i_modulo = gc_modulo
      i_ricefw = gc_ricefw ).

    cantidad_colores_x_job = VALUE #( go_parametros->gti_parametros[ idparam = 'CANT_COLJOB' ]-low OPTIONAL ).

    IF cantidad_colores_x_job IS INITIAL.
      cantidad_colores_x_job = 1.
    ENDIF.

    "Crear un JOB por centro/material generica/alternativa
    LOOP AT c_ti_lista_infotint REFERENCE INTO DATA(r_es_lm_gr)
                                WHERE ind_actualizado NE gc_lista_material_ok
                                GROUP BY ( centro = r_es_lm_gr->centro
                                           material_generico_sap = r_es_lm_gr->material_generico_sap
                                           alternativa_escala = r_es_lm_gr->alternativa_escala ).

      CLEAR: cantidad_total_procesos, contador_proceso_actual, contador_colores.
      "Cantidad de colores por grupo
      LOOP AT GROUP r_es_lm_gr REFERENCE INTO DATA(r_es_lm)
                               GROUP BY ( color = r_es_lm->color ).
        ADD 1 TO cantidad_total_procesos.
      ENDLOOP.

      LOOP AT GROUP r_es_lm_gr REFERENCE INTO r_es_lm
                               GROUP BY ( color = r_es_lm->color ).

        ADD 1 TO contador_colores.
        APPEND VALUE #( sign = 'I' option = 'EQ' low = r_es_lm->color ) TO r_colores.
        colores = colores && r_es_lm->color.

        DATA(residuo) = contador_colores MOD cantidad_colores_x_job.
        "Lanzar JOB cada que se cumpla el numero de colores a procesar en el parametro CANT_COLJOB
        IF residuo = 0 OR ( cantidad_total_procesos <= contador_colores ).

          CLEAR: contador_intento_bloqueo, job_finalizado.

          r_material_generico = VALUE #( sign = 'I' option = 'EQ' ( low = r_es_lm_gr->material_generico_sap ) ).
          r_material_legado = VALUE #( sign = 'I' option = 'EQ' ( low = r_es_lm_gr->material_generico ) ).
          r_centro = VALUE #( sign = 'I' option = 'EQ' ( low = r_es_lm_gr->centro ) ).
          r_alternativa = VALUE #( sign = 'I' option = 'EQ' ( low = shift_left( val = CONV i( r_es_lm_gr->alternativa_escala ) ) ) ).

          nombre_job = |ZPPR1157_{ r_es_lm_gr->material_generico_sap }{ r_es_lm_gr->alternativa_escala }_{ colores }|.

          ADD 1 TO contador_proceso_actual.

          CALL FUNCTION 'JOB_OPEN'
            EXPORTING
              jobname          = nombre_job
            IMPORTING
              jobcount         = numero_job
            EXCEPTIONS
              cant_create_job  = 1
              invalid_job_data = 2
              jobname_missing  = 3
              OTHERS           = 4.

          IF sy-subrc = 0.

            SUBMIT zppr1157_1
             WITH so_matnr IN r_material_generico
             WITH so_centr IN r_centro
             WITH so_fenvi IN i_r_fecha_envio
             WITH so_color IN r_colores
             WITH so_alter IN r_alternativa
             WITH pa_ppent = abap_true
             VIA JOB nombre_job NUMBER numero_job
             AND RETURN.

            IF sy-subrc = 0.
              CALL FUNCTION 'JOB_CLOSE'
                EXPORTING
                  jobcount             = numero_job
                  jobname              = nombre_job
                  strtimmed            = 'X'
                EXCEPTIONS
                  cant_start_immediate = 1
                  invalid_startdate    = 2
                  jobname_missing      = 3
                  job_close_failed     = 4
                  job_nosteps          = 5
                  job_notex            = 6
                  lock_failed          = 7
                  OTHERS               = 8.

              IF sy-subrc IS INITIAL.
                cl_progress_indicator=>progress_indicate(
                  EXPORTING
                    i_msgid              = 'ZPP01'
                    i_msgno              = '117'
                    i_msgv1              = |{ r_es_lm_gr->material_generico_sap }{ r_es_lm_gr->alternativa_escala }|
                    i_msgv2              = |_{ colores }|
                    i_processed          = contador_proceso_actual
                    i_total              = cantidad_total_procesos
                    i_output_immediately = abap_true ).
              ENDIF.

              DO.
                "Esperar que el JOB termine
                CALL FUNCTION 'SHOW_JOBSTATE'
                  EXPORTING
                    jobcount         = numero_job
                    jobname          = nombre_job
                  IMPORTING
                    aborted          = job_abortado
                    finished         = job_finalizado
                    preliminary      = job_preliminar
                    ready            = job_listo
                    running          = job_en_ejecucion
                    scheduled        = job_programado
                    suspended        = job_suspendido
                    other            = job_otros
                  EXCEPTIONS
                    jobcount_missing = 1
                    jobname_missing  = 2
                    job_notex        = 3
                    OTHERS           = 4.

                IF sy-subrc <> 0
                OR job_finalizado = abap_true
                OR job_abortado = abap_true
                OR job_preliminar = abap_true
                OR ( job_listo = abap_false AND job_en_ejecucion = abap_false )
                OR job_programado = abap_true
                OR job_suspendido = abap_true
                OR job_otros = abap_true
                OR contador_intento_bloqueo > 2400. "Esperar hasta 1 horas

                  EXIT.
                ELSE.
                  WAIT UP TO 1 SECONDS.
                  ADD 1 TO contador_intento_bloqueo.
                ENDIF.

              ENDDO.

            ELSE.
              DATA(msg) = cl_abap_submit_handling=>get_error_message( ).
              MESSAGE ID msg-msgid
                      TYPE 'I'
                      NUMBER msg-msgno
                      WITH msg-msgv1 msg-msgv2 msg-msgv3 msg-msgv4
                      DISPLAY LIKE msg-msgty.
            ENDIF.
          ENDIF.

          CLEAR: r_colores, colores.

        ENDIF.
      ENDLOOP.
    ENDLOOP.

  ENDMETHOD.


  METHOD consolidar_componente_variante.

    LOOP AT i_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                  WHERE  centro = i_es_lista_infotint-centro
                                     AND material_generico_sap = i_es_lista_infotint-material_generico_sap
                                     AND alternativa_escala    = i_es_lista_infotint-alternativa_escala
                                     AND procesar              = i_indicador_procesar
                                  GROUP BY <fs_es_lista_infotint_gr>-componente.

      APPEND INITIAL LINE TO r_ti_componente_x_variantes ASSIGNING FIELD-SYMBOL(<fs_es_comente_x_variantes>).

      <fs_es_comente_x_variantes>-componente = <fs_es_lista_infotint_gr>-componente.

      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>).
        APPEND VALUE #( sign = 'I' option = 'EQ' low = <fs_es_lista_infotint>-material_variante )
        TO <fs_es_comente_x_variantes>-r_variantes.
      ENDLOOP.

      SORT <fs_es_comente_x_variantes>-r_variantes BY low.
      DELETE ADJACENT DUPLICATES FROM <fs_es_comente_x_variantes>-r_variantes COMPARING low.

    ENDLOOP.

  ENDMETHOD.


  METHOD visualizar_lm_con_duplicados.

    TYPES: BEGIN OF tp_es_duplicadas,
             alternativa_escala    TYPE ztppi1209_1-alternativa_escala,
             material_generico_sap TYPE zed_materialgenerico_sap.
             INCLUDE TYPE fsh_s_bomvd_api.
    TYPES:
           END OF tp_es_duplicadas,

           tp_ti_duplicadas TYPE STANDARD TABLE OF tp_es_duplicadas WITH EMPTY KEY.

    DATA: ti_variantes_duplicadas TYPE tp_ti_duplicadas.

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico = <fs_es_lista_infotint_gr>-material_generico
                                           alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      DATA(ti_componente_x_variantes) =
        consolidar_componente_variante(
        EXPORTING
          i_indicador_procesar = abap_false
          i_es_lista_infotint  = <fs_es_lista_infotint_gr>
          i_ti_lista_infotint  = c_ti_lista_infotint ).

      leer_componentes_duplicados(
        EXPORTING
          i_ti_componente_x_variantes   = ti_componente_x_variantes
          i_es_lista_infotint           = <fs_es_lista_infotint_gr>
          i_incluir_todas_las_variantes = abap_true
        IMPORTING
          e_ti_variantes_duplicadas     = DATA(ti_duplicados) ).

      APPEND LINES OF CORRESPONDING tp_ti_duplicadas( ti_duplicados ) TO ti_variantes_duplicadas.

      MODIFY ti_variantes_duplicadas
      FROM VALUE #( alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala material_generico_sap = <fs_es_lista_infotint_gr>-material_generico_sap )
      TRANSPORTING alternativa_escala material_generico_sap
      WHERE material_generico_sap IS INITIAL.

    ENDLOOP.

    CALL FUNCTION 'ZCXR1002_MOSTRARALV_01'
      EXPORTING
        i_ti_datos = REF #( ti_variantes_duplicadas )
        i_titulo   = TEXT-tdp.

  ENDMETHOD.
ENDCLASS.
CLASS zclppr1157_productos_quimicos DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    CONSTANTS: gc_ricefw                   TYPE zzedricefw VALUE 'R1157',
               gc_modulo                   TYPE zzedmodulo VALUE 'PP',
               gc_clase_mensajes           TYPE symsgid VALUE 'ZPP01',
               gc_huso_horario             TYPE timezone VALUE 'UTC',
               gc_objecto                  TYPE  balobj_d VALUE 'ZPP_1',
               gc_subobjecto               TYPE  balsubobj VALUE 'ZR1157_1',
               gc_lista_mat_sin_actualizar TYPE ztppi1209_1-ind_actualizado VALUE '0',
               gc_lista_material_ok        TYPE ztppi1209_1-ind_actualizado VALUE '1',
               gc_lista_mat_en_error       TYPE ztppi1209_1-ind_actualizado VALUE '9'.


    TYPES: gtp_r_centro             TYPE RANGE OF ztppi1209_1-centro,
           gtp_r_fecha              TYPE RANGE OF ztppi1209_1-fecha_envio,
           gtp_r_material           TYPE RANGE OF ztppi1209_1-material_generico,
           gtp_r_color              TYPE RANGE OF ztppi1209_1-color,
           gtp_r_ind_actualizacion  TYPE RANGE OF ztppi1209_1-ind_actualizado,
           gtp_r_alternativa_escala TYPE RANGE OF ztppi1209_1-alternativa_escala,
           gtp_r_estado_lista       TYPE RANGE OF ztppi1209_1-ind_actualizado.

    TYPES: BEGIN OF gtp_es_datos_infotint,
             procesar              TYPE zed_procesar_registro,
             estado                TYPE zed_estado_lista_infotint,
             centro                TYPE ztppi1209_1-centro,
             material_variante     TYPE zed_materialvar,
             color                 TYPE ztppi1209_1-color,
             alternativa_escala    TYPE ztppi1209_1-alternativa_escala,
             componente            TYPE zed_componente,
             material_generico     TYPE zed_material_generico_legado,
             material_generico_sap TYPE zed_materialgenerico_sap,
             fecha_envio           TYPE ztppi1209_1-fecha_envio,
             hora_envio            TYPE ztppi1209_1-hora_envio,
             cant_mapeo            TYPE ztppi1209_1-cant_mapeo,
             unidad_medida         TYPE ztppi1209_1-unidad_medida,
             usuario               TYPE ztppi1209_1-usuario,
             mensaje               TYPE ztppi1209_1-mensaje,
             ind_actualizado       TYPE ztppi1209_1-ind_actualizado,
             peso_tanda            TYPE ztppi1209_1-peso_tanda,
             maquina               TYPE ztppi1209_1-maquina,
             usuario_actualizacion TYPE ztppi1209_1-usuario_actualizacion,
             fecha_actualizacion   TYPE ztppi1209_1-fecha_actualizacion,
             hora_actualizacion    TYPE ztppi1209_1-hora_actualizacion,
             variantes_sap         TYPE ztppi1209_1-variantes_sap,
             size1                 TYPE mara-size1,
             mtart                 TYPE mara-mtart,
             peticion_borrado_mat  TYPE mara-lvorm,
           END OF gtp_es_datos_infotint,

           BEGIN OF gtp_es_lm_cabecera,
             matnr            TYPE mara-matnr,
             werks            TYPE werks_d,
             stlan            TYPE mast-stlan,
             stlal            TYPE mast-stlal,
             mtart            TYPE mara-mtart,
             bmeng            TYPE stko-bmeng,
             bmeng_no_decimal TYPE char17,
             stktx            TYPE stko-stktx,
           END OF gtp_es_lm_cabecera,

           BEGIN OF gtp_es_lista_material,
             matnr            TYPE mara-matnr,
             werks            TYPE werks_d,
             stlan            TYPE mast-stlan,
             stlal            TYPE mast-stlal,
             material_lista   TYPE mara-matnr,
             mtart            TYPE mara-mtart,
             componente       TYPE idnrk,
             bmeng            TYPE stko-bmeng,
             stktx            TYPE stko-stktx,
             postp            TYPE stpo-postp,
             posnr            TYPE stpo-posnr,
             menge            TYPE stpo-menge,
             stlkn            TYPE stpo-stlkn,
             stpoz            TYPE stpo-stpoz,
             stlnr            TYPE stpo-stlnr,
             datuv            TYPE stpo-datuv,
             fsh_vmkz         TYPE stpo-fsh_vmkz,
             rel_cost         TYPE stpo-sanka,
             ind_borrado_stpo TYPE stpo-lkenz,
             ind_borrado_stas TYPE stpo-lkenz,
           END OF gtp_es_lista_material,

           BEGIN OF gtp_es_componentes_sap,
             componente           TYPE mara-matnr,
             werks                TYPE marc-werks,
             mtart                TYPE mara-mtart,
             peticion_borrado_mat TYPE mara-lvorm,
           END OF gtp_es_componentes_sap,

           BEGIN OF gtp_es_componente_variantes,
             componente  TYPE mara-matnr,
             r_variantes TYPE gtp_r_material,
           END OF gtp_es_componente_variantes,

           BEGIN OF gtp_es_datos_actualizar_lm,
             fecha_valida_desde TYPE datuv_bi,
             componentes        TYPE gtp_r_material,
             ti_componentes     TYPE STANDARD TABLE OF stpo_api03 WITH EMPTY KEY,
             ti_variantes_bomd  TYPE STANDARD TABLE OF fsh_s_bomvd_api WITH DEFAULT KEY,
           END OF gtp_es_datos_actualizar_lm.

    TYPES: gtp_ti_lista_infotint       TYPE STANDARD TABLE OF gtp_es_datos_infotint
                                                        WITH NON-UNIQUE KEY procesar estado centro material_variante color
                                                        WITH NON-UNIQUE SORTED KEY key_agrupador COMPONENTS centro material_variante color alternativa_escala,
           gtp_ti_datos_actualizar_lm  TYPE STANDARD TABLE OF gtp_es_datos_actualizar_lm WITH NON-UNIQUE KEY fecha_valida_desde,
           gtp_ti_lista_material       TYPE STANDARD TABLE OF gtp_es_lista_material WITH EMPTY KEY,
           gtp_ti_componente_variantes TYPE STANDARD TABLE OF gtp_es_componente_variantes WITH EMPTY KEY,
           gtp_ti_componentes_sap      TYPE STANDARD TABLE OF gtp_es_componentes_sap WITH EMPTY KEY.

    CLASS-DATA: go_log                       TYPE REF TO zclcxr1002_log_aplicacion,
                go_parametros                TYPE REF TO zclcxr1000_parametros,
                gti_lista_infotint           TYPE gtp_ti_lista_infotint,
                ges_lm_infotint_en_proceso   TYPE REF TO data,
                gr_centro                    TYPE gtp_r_centro,
                gr_fecha_envio               TYPE gtp_r_fecha,
                gr_material_legado           TYPE gtp_r_material,
                gr_material                  TYPE gtp_r_material,
                gr_indicador_actualizacion   TYPE gtp_r_ind_actualizacion,
                gr_color                     TYPE gtp_r_color,
                gr_alternativa_escala        TYPE gtp_r_alternativa_escala,
                g_actualizacion_lm_terminada TYPE flag,
                g_lm_bloqueada               TYPE flag,
                g_nombre_job                 TYPE tbtcjob-jobname VALUE 'ZPPR1157_R1096_LM',
                g_pendiente_procesar         TYPE flag,
                g_cantidad_total_procesos    TYPE i VALUE 5.

    DATA: go_alv                      TYPE REF TO cl_gui_alv_grid,
          go_dock_container           TYPE REF TO cl_gui_docking_container,
          gr_tipo_material            TYPE RANGE OF mara-mtart,
          gr_material_quimico_acabado TYPE RANGE OF mara-matnr,
          gr_tipo_posicion_lista      TYPE RANGE OF stpo-postp,
          gr_cantidad_componente      TYPE RANGE OF kmpmg_bi,
          g_cronomarcador_utc         TYPE tzntstmps,
          gr_sufijo_mateiral          TYPE RANGE OF string.

    CLASS-DATA: gr_utilizacion_lista_mat TYPE RANGE OF mast-stlan,
                gr_tipo_material_quimico TYPE RANGE OF mara-mtart.

    METHODS:
      constructor,
      cargar_parametros,
      iniciar_tratamiento_infotint
        IMPORTING
          VALUE(i_r_centro)                TYPE gtp_r_centro
          VALUE(i_r_fecha_envio)           TYPE gtp_r_fecha
          VALUE(i_r_material_legado)       TYPE gtp_r_material
          VALUE(i_r_material)              TYPE gtp_r_material
          VALUE(i_r_color)                 TYPE gtp_r_color
          VALUE(i_r_alternativa)           TYPE gtp_r_alternativa_escala
          VALUE(i_visualizar_duplicados)   TYPE flag OPTIONAL
          i_pendiente_procesar             TYPE flag
          i_actualizar_registros           TYPE flag OPTIONAL
          VALUE(i_ejecutar_jobs_agrupados) TYPE flag OPTIONAL
          i_r_indicador_actualizacion      TYPE gtp_r_ind_actualizacion,
      procesar_registros_infotint,
      visualizar_datos
        IMPORTING
          i_reporte TYPE syrepid
          i_layout  TYPE disvariant-variant,
      modificar_catalogo
        CHANGING
          c_ti_catalogo TYPE lvc_t_fcat,
      leer_registros_infotint
        IMPORTING
          VALUE(i_r_centro)           TYPE gtp_r_centro
          VALUE(i_r_fecha_envio)      TYPE gtp_r_fecha
          VALUE(i_r_material_legado)  TYPE gtp_r_material
          VALUE(i_r_material)         TYPE gtp_r_material
          VALUE(i_r_color)            TYPE gtp_r_color
          VALUE(i_r_alternativa)      TYPE gtp_r_alternativa_escala
          i_r_indicador_actualizacion TYPE gtp_r_ind_actualizacion
          i_pendiente_procesar        TYPE flag
        RETURNING
          VALUE(r_ti_lista_infotint)  TYPE gtp_ti_lista_infotint,
      validar_consistencia_de_datos
        CHANGING
          c_ti_lista_infotint TYPE gtp_ti_lista_infotint,
      actualizar_lista_materiales
        CHANGING
          c_ti_lista_infotint TYPE gtp_ti_lista_infotint,
      registrar_modificaciones
        EXPORTING
          e_es_log            TYPE bal_s_lgnm
        CHANGING
          c_ti_lista_infotint TYPE gtp_ti_lista_infotint,
      consultar_lista_material
        IMPORTING
          i_ti_lista_infotint         TYPE gtp_ti_lista_material
          i_incluir_material_variante TYPE flag OPTIONAL
          i_solo_componentes_quimicos TYPE flag OPTIONAL
          i_descartar_reg_eliminados  TYPE flag OPTIONAL
        EXPORTING
          e_es_lm_cabecera            TYPE zclppr1157_productos_quimicos=>gtp_es_lm_cabecera
          e_ti_lista_material         TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_material
          e_ti_lm_variantes           TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_material
          e_ultima_posicion           TYPE numc4,
      consultar_lista_material_db
        IMPORTING
          i_ti_lista_infotint TYPE gtp_ti_lista_material
        EXPORTING
          e_ti_lista_material TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_material,
      consultar_componentes
        IMPORTING
          VALUE(i_ti_lista_infotint) TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_infotint
        RETURNING
          VALUE(r_ti_componentes)    TYPE gtp_ti_componentes_sap,
      respuesta_actualizacion_lm
        IMPORTING
          p_task TYPE clike,
      ejec_consistencia_lm_masivo
        CHANGING
          c_ti_lista_infotint TYPE gtp_ti_lista_infotint,
      visualizar_lm_con_duplicados
        CHANGING
          c_ti_lista_infotint TYPE zclppr1157_productos_quimicos=>gtp_ti_lista_infotint.

    "Eventos ALV
    METHODS:
      evento_hotspot FOR EVENT hotspot_click OF cl_gui_alv_grid
        IMPORTING
          e_row_id
          e_column_id,
      evento_tool_bar FOR EVENT toolbar  OF cl_gui_alv_grid
        IMPORTING
          e_interactive
          e_object
          sender,
      evento_user_comand FOR EVENT user_command  OF cl_gui_alv_grid
        IMPORTING
          e_ucomm,
      evento_data_change FOR EVENT data_changed OF cl_gui_alv_grid
        IMPORTING
          er_data_changed
          e_onf4
          e_onf4_before
          e_onf4_after
          e_ucomm
          sender,
      evento_data_change_finish FOR EVENT data_changed_finished OF cl_gui_alv_grid
        IMPORTING
          e_modified
          et_good_cells
          sender.

    CLASS-METHODS:
      visualizar_log
        IMPORTING
          VALUE(i_id_log) TYPE zed_id_mensaje_externo DEFAULT '*',
      ejecutar_consistencia_lm
        IMPORTING
          i_tiempo_espera_extendido  TYPE flag DEFAULT abap_false
          VALUE(i_nombre_job)        TYPE tbtcjob-jobname DEFAULT g_nombre_job
          VALUE(i_es_lista_infotint) TYPE gtp_es_datos_infotint,
      validar_bloqueo_usuario
        IMPORTING
          VALUE(i_es_lista_infotint) TYPE zclppr1157_productos_quimicos=>gtp_es_datos_infotint,
      ejecutar_proeso_agrupado_job
        IMPORTING
          VALUE(i_r_fecha_envio)     TYPE gtp_r_fecha
          VALUE(i_r_material_legado) TYPE gtp_r_material OPTIONAL
        CHANGING
          c_ti_lista_infotint        TYPE gtp_ti_lista_infotint,
      generar_fecha
        IMPORTING
          i_fecha        TYPE stpo-datuv
        RETURNING
          VALUE(r_fecha) TYPE datuv_bi.


  PROTECTED SECTION.

  PRIVATE SECTION.

    CLASS-DATA: g_cantidad_intento_bloqueo TYPE i VALUE 1.

    METHODS:
      get_id_log
        IMPORTING
          VALUE(i_es_lista_infotint) TYPE zclppr1157_productos_quimicos=>gtp_es_datos_infotint
        RETURNING
          VALUE(r_id_log)            TYPE string,
      eliminar_componantes_variante
        IMPORTING
          i_incluir_todas_las_variantes       TYPE flag
          i_tiempo_espera_extendido           TYPE flag DEFAULT abap_false
          VALUE(i_ti_componente_x_variantes)  TYPE gtp_ti_componente_variantes OPTIONAL
          VALUE(i_ti_posicion_lista_eliminar) TYPE t_stpo_api03 OPTIONAL
        CHANGING
          VALUE(c_es_lista_infotint)          TYPE gtp_es_datos_infotint
          c_ti_lista_infotint                 TYPE gtp_ti_lista_infotint OPTIONAL,
      eliminar_componantes_generico
        IMPORTING
          VALUE(i_r_componente)               TYPE gtp_r_material
          VALUE(i_ti_posicion_lista_eliminar) TYPE t_stpo_api03
          i_tiempo_espera_extendido           TYPE flag DEFAULT abap_false
        CHANGING
          c_es_lista_infotint                 TYPE gtp_es_datos_infotint,
      asignar_variante_sap
        IMPORTING
          VALUE(i_variante_sap) TYPE ztppi1209_1-variantes_sap OPTIONAL
        CHANGING
          c_es_lista_infotint   TYPE zclppr1157_productos_quimicos=>gtp_es_datos_infotint,
      "! <strong>Descripción:</strong>
      "! <p>
      "! Genera una itab que contiene las variantes que contiene un componente segun.<br/>
      "! el centro/material generico/alternativa/color
      "! </p>
      "! <strong>Identificador:</strong>
                                                            "! R1157
      "! <br/>
      "! <strong>Autor:</strong>
      "! Sebastian Londono
      "! <br/>
      "! <strong>Historial de cambios:
      "! <br/><br/>
      "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
      "! </strong><br/>
      "! \ 20.05.2024  \ S4DK917548 \ Sebastian Londono \ Creacion Inicial \
      "!
      "! @parameter i_ti_componente_x_variantes |
      "! @parameter i_incluir_todas_las_variantes |
      "! @parameter i_es_lista_infotint |
      "! @parameter e_es_lm_cabecera |
      "! @parameter e_ti_datos_eliminar_lm |
      "! @parameter e_ti_componente_lm_eliminar |
      "! @parameter e_ti_datos_actualizar_lm |
      "! @parameter e_ti_variantes_duplicadas |
      leer_componentes_duplicados
        IMPORTING
          VALUE(i_ti_componente_x_variantes) TYPE gtp_ti_componente_variantes
          i_incluir_todas_las_variantes      TYPE flag
          VALUE(i_es_lista_infotint)         TYPE gtp_es_datos_infotint
        EXPORTING
          e_es_lm_cabecera                   TYPE zclppr1157_productos_quimicos=>gtp_es_lm_cabecera
          e_ti_datos_eliminar_lm             TYPE gtp_ti_datos_actualizar_lm
          e_ti_componente_lm_eliminar        TYPE t_stpo_api03
          e_ti_datos_actualizar_lm           TYPE gtp_ti_datos_actualizar_lm
          e_ti_variantes_duplicadas          TYPE fsh_tt_bomvd_api,
      verificar_consistencia_lm
        IMPORTING
          i_ejecutar_consistencia_lm TYPE flag DEFAULT abap_true
          i_numero_proceso           TYPE i DEFAULT 1
          i_tiempo_espera_extendido  TYPE flag DEFAULT abap_false
        CHANGING
          VALUE(c_es_lista_infotint) TYPE gtp_es_datos_infotint
          c_ti_lista_infotint        TYPE gtp_ti_lista_infotint,
      consolidar_componente_variante
        IMPORTING
          i_indicador_procesar               TYPE flag DEFAULT abap_true
          i_es_lista_infotint                TYPE gtp_es_datos_infotint
          i_ti_lista_infotint                TYPE gtp_ti_lista_infotint
        RETURNING
          VALUE(r_ti_componente_x_variantes) TYPE gtp_ti_componente_variantes.

ENDCLASS.



CLASS ZCLPPR1157_PRODUCTOS_QUIMICOS IMPLEMENTATION.


  METHOD constructor.

    CONVERT DATE sy-datum TIME sy-uzeit
    INTO TIME STAMP g_cronomarcador_utc TIME ZONE gc_huso_horario.

    cargar_parametros( ).
  ENDMETHOD.


  METHOD procesar_registros_infotint.

    CLEAR: g_cronomarcador_utc."Variable de log
    zclcxr1002_log_aplicacion=>liberar( ).

    cargar_parametros( ).

    IF NOT line_exists( gti_lista_infotint[ procesar = abap_true ] ).
      MESSAGE i508(fins_cfin_cmt_msg).
      RETURN.
    ENDIF.

    IF line_exists( gti_lista_infotint[ procesar = abap_true material_variante = space ] ).
      MESSAGE i098(zpp01).
    ENDIF.

    validar_consistencia_de_datos(
      CHANGING
        c_ti_lista_infotint = gti_lista_infotint ).

    actualizar_lista_materiales(
      CHANGING
        c_ti_lista_infotint = gti_lista_infotint ).

    registrar_modificaciones(
      CHANGING
        c_ti_lista_infotint = gti_lista_infotint ).

    IF sy-batch = abap_false.
      go_alv->refresh_table_display( is_stable = VALUE #( row = abap_true col = abap_true ) ).
    ENDIF.

    MESSAGE i093(zpp01).

  ENDMETHOD.


  METHOD iniciar_tratamiento_infotint.

    IF i_actualizar_registros = abap_false.
      zclcxr1002_log_aplicacion=>liberar( ).
      go_log = zclcxr1002_log_aplicacion=>get_instancia(
        i_es_cabecera_log = VALUE #( object = 'ZPP_1' subobject = 'ZR1157_1' )
        i_identificador   = 'ZR1157_1' ).

      gr_centro = i_r_centro.
      gr_color = i_r_color.
      gr_alternativa_escala = i_r_alternativa.
      gr_fecha_envio = i_r_fecha_envio.
      gr_material_legado = i_r_material_legado.
      gr_material = i_r_material.
      gr_indicador_actualizacion = i_r_indicador_actualizacion.
      g_pendiente_procesar = i_pendiente_procesar.

    ENDIF.

    gti_lista_infotint =
      leer_registros_infotint(
      EXPORTING
        i_r_centro                  = i_r_centro
        i_r_fecha_envio             = i_r_fecha_envio
        i_r_material_legado         = gr_material_legado
        i_r_material                = i_r_material
        i_r_color                   = i_r_color
        i_r_alternativa             = i_r_alternativa
        i_pendiente_procesar        = i_pendiente_procesar
        i_r_indicador_actualizacion = i_r_indicador_actualizacion ).

    IF i_visualizar_duplicados = abap_true AND sy-batch = abap_false.
      visualizar_lm_con_duplicados(
        CHANGING
          c_ti_lista_infotint = gti_lista_infotint ).

    ELSE.

      "Procesamiento en batch
      IF sy-batch = abap_true OR i_ejecutar_jobs_agrupados = abap_true.

        MODIFY gti_lista_infotint FROM VALUE #( procesar = abap_true )
        TRANSPORTING procesar
        WHERE ind_actualizado NE gc_lista_material_ok.

        IF i_ejecutar_jobs_agrupados = abap_false.
          procesar_registros_infotint( ).
        ENDIF.

      ENDIF.

      IF i_ejecutar_jobs_agrupados = abap_true.
        ejecutar_proeso_agrupado_job(
          EXPORTING
            i_r_fecha_envio     = i_r_fecha_envio
          CHANGING
            c_ti_lista_infotint = gti_lista_infotint ).

        gti_lista_infotint =
          leer_registros_infotint(
          EXPORTING
            i_r_centro                  = i_r_centro
            i_r_fecha_envio             = i_r_fecha_envio
            i_r_material_legado         = gr_material_legado
            i_r_material                = i_r_material
            i_r_color                   = i_r_color
            i_r_alternativa             = i_r_alternativa
            i_pendiente_procesar        = i_pendiente_procesar
            i_r_indicador_actualizacion = i_r_indicador_actualizacion ).
      ENDIF.

      IF i_actualizar_registros = abap_true.

        go_alv->refresh_table_display( ).

      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD leer_registros_infotint.

    DATA: r_indicador_actualizacion TYPE gtp_r_estado_lista,
          r_material_variante       TYPE RANGE OF mara-matnr.

    IF i_pendiente_procesar = abap_true.
      r_indicador_actualizacion = VALUE #( sign = 'I' option = 'EQ'
                                          ( low = gc_lista_mat_sin_actualizar )
                                          ( low = gc_lista_mat_en_error ) ).
    ENDIF.

***    LOOP AT i_r_material_legado ASSIGNING FIELD-SYMBOL(<fs_es_material_legado>).
***      <fs_es_material_legado>-low = |{ <fs_es_material_legado>-low ALPHA = OUT }|.
***      <fs_es_material_legado>-high = |{ <fs_es_material_legado>-high ALPHA = OUT }|.
***    ENDLOOP.

    "Tomar TODOS los registros Lista Infotint
    "agrupar mismo centro+ material genérico + color+ alternativa
    "IND_ACTUALIZADO = 0 o 9
    SELECT
    FROM ztppi1209_1 AS _lista_infotint
    LEFT JOIN mara AS _material ON
    _material~bismt = ltrim( _lista_infotint~material_generico,'0' )
    AND _material~color = _lista_infotint~color
    FIELDS
      _lista_infotint~centro,
      _material~matnr AS material_variante,
      _lista_infotint~color,
      lpad( _lista_infotint~alternativa_escala, 2, '0' ) AS alternativa_escala,
      _lista_infotint~componente,
      _material~satnr AS material_generico_sap,
      _lista_infotint~material_generico,
      _lista_infotint~fecha_envio,
      _lista_infotint~hora_envio,
      _lista_infotint~cant_mapeo,
      _lista_infotint~unidad_medida,
      _lista_infotint~usuario,
      _lista_infotint~mensaje,
      _lista_infotint~ind_actualizado,
      _lista_infotint~peso_tanda,
      _lista_infotint~maquina,
      _lista_infotint~usuario_actualizacion,
      _lista_infotint~fecha_actualizacion,
      _lista_infotint~hora_actualizacion,
      _lista_infotint~variantes_sap,
      _material~mtart,  _material~size1
    WHERE _lista_infotint~ind_actualizado IN @r_indicador_actualizacion
    AND _lista_infotint~centro IN @i_r_centro
    AND _material~satnr IN @i_r_material
***    AND _material~bismt IN @i_r_material_legado
    AND _lista_infotint~material_generico IN @i_r_material_legado
    AND _lista_infotint~color IN @i_r_color
    AND _lista_infotint~fecha_envio IN @i_r_fecha_envio
    AND _lista_infotint~alternativa_escala IN @i_r_alternativa
    AND _lista_infotint~ind_actualizado IN @i_r_indicador_actualizacion
    INTO CORRESPONDING FIELDS OF TABLE @r_ti_lista_infotint.

    SORT r_ti_lista_infotint
    BY centro material_generico_sap alternativa_escala color size1 material_variante componente.

    "Para las telas, rectilíneos e hiladilla tipos de materiales (ZFAB)
    "extraer todos los materiales variantes MARA-MATNR que contenga el sufijo acorde a parámetro Sufijo
    LOOP AT r_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico = <fs_es_lista_infotint_gr>-material_generico
                                           color = <fs_es_lista_infotint_gr>-color
                                           alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      SPLIT <fs_es_lista_infotint_gr>-variantes_sap AT ';' INTO TABLE DATA(ti_variantes).
      r_material_variante = VALUE #( FOR es_variante IN ti_variantes ( sign = 'I' option = 'EQ' low = es_variante ) ).

      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>).
        "Completar ceros en componente
        CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
          EXPORTING
            input        = <fs_es_lista_infotint>-componente
          IMPORTING
            output       = <fs_es_lista_infotint>-componente
          EXCEPTIONS
            length_error = 1
            OTHERS       = 2.

        <fs_es_lista_infotint>-estado = SWITCH #( <fs_es_lista_infotint>-ind_actualizado
                                                    WHEN gc_lista_mat_sin_actualizar THEN
                                                     icon_light_out
                                                    WHEN gc_lista_material_ok THEN
                                                      icon_green_light
                                                    WHEN gc_lista_mat_en_error THEN
                                                      icon_red_light
                                                ).
        "Listas tratadas parcalmente
        IF <fs_es_lista_infotint>-material_variante NOT IN r_material_variante
        AND r_material_variante IS NOT INITIAL.
          <fs_es_lista_infotint>-estado = icon_yellow_light.
        ENDIF.
      ENDLOOP.

    ENDLOOP.

    "Eliminar materialas sin sufijo parametrizado
    DELETE r_ti_lista_infotint WHERE mtart = 'ZFAB' AND material_variante NOT IN gr_sufijo_mateiral.

    DELETE ADJACENT DUPLICATES FROM r_ti_lista_infotint COMPARING centro material_variante color alternativa_escala componente.

  ENDMETHOD.


  METHOD cargar_parametros.

    go_parametros = NEW zclcxr1000_parametros(
      i_modulo = gc_modulo
      i_ricefw = gc_ricefw ).

    gr_tipo_material = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'TP_MATERIA' )
                                    ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_sufijo_mateiral = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'SUFIJO_MAT' )
                                    ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_tipo_material_quimico = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'TP_MAT_QUI' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_utilizacion_lista_mat = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'UTILIZA_LM' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_tipo_posicion_lista = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'TP_POS_LM' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_cantidad_componente = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'CANT_COMP' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    gr_material_quimico_acabado = VALUE #( FOR es_parametro IN go_parametros->gti_parametros WHERE ( idparam = 'QUIM_ACABA' )
                                ( CORRESPONDING #( es_parametro MAPPING option = opti )  ) ).

    g_cantidad_intento_bloqueo = VALUE #( go_parametros->gti_parametros[ idparam = 'NUM_INTBLQ' ]-low OPTIONAL ).

    IF g_cantidad_intento_bloqueo IS INITIAL.
      g_cantidad_intento_bloqueo = 1.
    ENDIF.

    LOOP AT gr_material_quimico_acabado ASSIGNING FIELD-SYMBOL(<fs_es_material>).
      CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
        EXPORTING
          input        = <fs_es_material>-low
        IMPORTING
          output       = <fs_es_material>-low
        EXCEPTIONS
          length_error = 1
          OTHERS       = 2.

      CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
        EXPORTING
          input        = <fs_es_material>-high
        IMPORTING
          output       = <fs_es_material>-high
        EXCEPTIONS
          length_error = 1
          OTHERS       = 2.

    ENDLOOP.

  ENDMETHOD.


  METHOD visualizar_datos.
    DATA: perc      TYPE i,
          extension TYPE i VALUE 100.

    IF go_dock_container IS NOT BOUND AND cl_gui_alv_grid=>offline( ) IS INITIAL.

      CREATE OBJECT go_dock_container
        EXPORTING
          side                        = cl_gui_docking_container=>dock_at_bottom
        EXCEPTIONS
          cntl_error                  = 1
          cntl_system_error           = 2
          create_error                = 3
          lifetime_error              = 4
          lifetime_dynpro_dynpro_link = 5
          OTHERS                      = 6.

      go_dock_container->get_ratio( IMPORTING ratio = perc ).
      extension = ( 500 * extension / perc ).

      go_dock_container->set_extension( extension ).

    ENDIF.

    IF go_alv IS NOT BOUND.

      go_alv = NEW cl_gui_alv_grid( i_parent = go_dock_container ).

      TRY.
          DATA(ti_catalogo_alv) = zclcxr1002_util=>construir_catalogo( i_ti = gti_lista_infotint  i_qfieldname = 'UNIDAD_MEDIDA'  ).
          modificar_catalogo( CHANGING c_ti_catalogo = ti_catalogo_alv ).
        CATCH cx_dynamic_check cx_static_check.
          "handle exception
      ENDTRY.

      go_alv->register_edit_event(
        EXPORTING
          i_event_id = cl_gui_alv_grid=>mc_evt_enter
        EXCEPTIONS
          error      = 1
          OTHERS     = 2 ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
          WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.

      go_alv->register_edit_event(
        EXPORTING
          i_event_id = cl_gui_alv_grid=>mc_evt_modified
        EXCEPTIONS
          error      = 1
          OTHERS     = 2 ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
          WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.


      SET HANDLER: evento_hotspot     FOR go_alv,
                   evento_tool_bar    FOR go_alv,
                   evento_user_comand FOR go_alv,
                   evento_data_change FOR go_alv,
                   evento_data_change_finish FOR go_alv.

      go_alv->set_table_for_first_display(
        EXPORTING
          i_save                        = 'A'
          is_variant                    = VALUE #( variant = i_layout report = i_reporte username = sy-uname )
        CHANGING
          it_outtab                     = gti_lista_infotint " Output Table
          it_fieldcatalog               = ti_catalogo_alv " Field Catalog
        EXCEPTIONS
          invalid_parameter_combination = 1
          program_error                 = 2
          too_many_lines                = 3
          OTHERS                        = 4 ).


      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                   WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.

    ELSE.

      go_alv->refresh_table_display( ).

      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                   WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.

    ENDIF.
  ENDMETHOD.


  METHOD validar_consistencia_de_datos.

    DATA: error_en_grupo TYPE flag.

    DATA(ti_lista_infotint) = VALUE gtp_ti_lista_infotint( FOR es_lm IN c_ti_lista_infotint WHERE ( procesar = abap_true )
                                                            ( es_lm ) ).

    CHECK ti_lista_infotint IS NOT INITIAL.

    "Lista de material
    SELECT
    FROM mast AS _lista_material
    LEFT JOIN stas AS _pos_lista_material ON
    _pos_lista_material~stlnr = _lista_material~stlnr
    AND _pos_lista_material~stlal = _lista_material~stlal
    AND _pos_lista_material~lkenz = @space
    FIELDS _lista_material~matnr, _lista_material~werks, _lista_material~stlan, _lista_material~stlal
    FOR ALL ENTRIES IN @ti_lista_infotint
    WHERE _lista_material~matnr = @ti_lista_infotint-material_variante
    AND _lista_material~werks   = @ti_lista_infotint-centro
    AND _lista_material~stlan   IN @gr_utilizacion_lista_mat
    AND _lista_material~stlal   = @ti_lista_infotint-alternativa_escala(2)
    INTO TABLE @DATA(ti_lista_material).

    DATA(ti_componentes_sap) = consultar_componentes( i_ti_lista_infotint = c_ti_lista_infotint ).
    "Limpiar variantes con error
    MODIFY c_ti_lista_infotint
    FROM VALUE #( variantes_sap = space )
*    USING KEY key_marcados
    TRANSPORTING variantes_sap

    WHERE procesar = abap_true
    AND ind_actualizado NE gc_lista_material_ok
    AND material_variante IS NOT INITIAL.

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
*                                USING KEY key_marcados
                                WHERE procesar = abap_true
                                AND ind_actualizado NE gc_lista_material_ok
                                AND material_variante IS NOT INITIAL
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico = <fs_es_lista_infotint_gr>-material_generico
                                           color = <fs_es_lista_infotint_gr>-color
                                           alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log          = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                         i_identificador            = get_id_log( <fs_es_lista_infotint_gr> )
                                                         i_descartar_msj_duplicados = abap_true ).
      error_en_grupo = abap_false.

      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_listinfotint_varian_gr>)
                                              GROUP BY <fs_es_listinfotint_varian_gr>-material_variante.

        <fs_es_listinfotint_varian_gr>-estado = icon_light_out.
        <fs_es_listinfotint_varian_gr>-ind_actualizado = gc_lista_mat_sin_actualizar.

        "Validar Material Variante Existe/tipo material
        IF <fs_es_listinfotint_varian_gr>-material_variante IS INITIAL
        OR <fs_es_listinfotint_varian_gr>-mtart NOT IN gr_tipo_material.
          error_en_grupo = abap_true.
          <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
          go_log->set_es_log( i_es = VALUE #( id = 'ZMM01' number = '411' type = 'E'
                                              message_v1 = <fs_es_listinfotint_varian_gr>-material_variante
                                              parameter = <fs_es_listinfotint_varian_gr>-material_generico ) ).
        ENDIF.

        IF <fs_es_listinfotint_varian_gr>-estado NE icon_red_light.
          "Recorrer lista de componentes por variante
          LOOP AT GROUP <fs_es_listinfotint_varian_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>).

            "Validar componete
            DATA(es_componente) = VALUE #( ti_componentes_sap[ componente = <fs_es_lista_infotint>-componente ] OPTIONAL ).

            IF es_componente-componente IS INITIAL.
              error_en_grupo = abap_true.
              <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
              go_log->set_es_log( i_es = VALUE #( id = gc_clase_mensajes number = '103' type = 'E'
                                                 message_v1 = <fs_es_lista_infotint>-componente
                                                 message_v2 = <fs_es_lista_infotint>-centro
                                                 parameter = <fs_es_lista_infotint>-material_generico ) ).
            ENDIF.

            "Componente en centro
            IF NOT line_exists( ti_componentes_sap[ componente = <fs_es_lista_infotint>-componente werks = <fs_es_lista_infotint>-centro ] )
            AND <fs_es_listinfotint_varian_gr>-estado NE icon_red_light.
              error_en_grupo = abap_true.
              <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
              go_log->set_es_log( i_es = VALUE #( id = 'ZPP01' number = '105' type = 'E'
                                                  message_v1 = <fs_es_lista_infotint>-componente
                                                  message_v2 = <fs_es_lista_infotint>-centro
                                                  parameter = <fs_es_lista_infotint>-material_generico ) ).
            ENDIF.

            "Componente con peticion de borrado
            IF es_componente-peticion_borrado_mat IS NOT INITIAL
            AND <fs_es_listinfotint_varian_gr>-estado NE icon_red_light.
              error_en_grupo = abap_true.
              <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
              go_log->set_es_log( i_es = VALUE #( id = gc_clase_mensajes number = '104' type = 'E'
                                                    message_v1 = <fs_es_lista_infotint>-componente
                                                    parameter = <fs_es_lista_infotint>-material_generico ) ).
            ENDIF.

          ENDLOOP.

          "Material en lista de material
          IF NOT line_exists( ti_lista_material[ matnr = <fs_es_listinfotint_varian_gr>-material_variante werks = <fs_es_listinfotint_varian_gr>-centro
                                                 stlal = <fs_es_listinfotint_varian_gr>-alternativa_escala ] ).
            <fs_es_listinfotint_varian_gr>-estado = icon_red_light.
            <fs_es_listinfotint_varian_gr>-ind_actualizado = gc_lista_mat_en_error.

            go_log->set_es_log( i_es = VALUE #( id = gc_clase_mensajes number = '077' type = 'E'
                                               message_v1 = <fs_es_listinfotint_varian_gr>-material_variante
                                               message_v2 = <fs_es_listinfotint_varian_gr>-alternativa_escala
                                               parameter = <fs_es_listinfotint_varian_gr>-material_generico ) ).
            <fs_es_lista_infotint_gr>-variantes_sap = |{ <fs_es_lista_infotint_gr>-variantes_sap };{ <fs_es_listinfotint_varian_gr>-material_variante }|.
          ENDIF.

        ENDIF.

        "Actualizar registros por subgrupo
        DATA(ti_log_errores) = go_log->get_errores( ).

        MODIFY c_ti_lista_infotint
        USING KEY key_agrupador
        FROM VALUE #( ind_actualizado = <fs_es_listinfotint_varian_gr>-ind_actualizado
                      estado = <fs_es_listinfotint_varian_gr>-estado
                      fecha_actualizacion = sy-datum hora_actualizacion = sy-uzeit usuario_actualizacion = sy-uname
                      variantes_sap = <fs_es_lista_infotint_gr>-variantes_sap )
        TRANSPORTING ind_actualizado estado fecha_actualizacion hora_actualizacion usuario_actualizacion variantes_sap
        WHERE centro = <fs_es_lista_infotint_gr>-centro
          AND material_variante = <fs_es_listinfotint_varian_gr>-material_variante
          AND material_generico = <fs_es_listinfotint_varian_gr>-material_generico
          AND color = <fs_es_listinfotint_varian_gr>-color
          AND alternativa_escala = <fs_es_listinfotint_varian_gr>-alternativa_escala.

      ENDLOOP.

      "Si se presenta un error a nivel de grupo, se actualiza el estado para todo el conjunto de datos
      IF error_en_grupo = abap_true.
        MODIFY c_ti_lista_infotint
        USING KEY key_agrupador
        FROM VALUE #( ind_actualizado = gc_lista_mat_en_error
                      estado = <fs_es_listinfotint_varian_gr>-estado
                      fecha_actualizacion = sy-datum hora_actualizacion = sy-uzeit usuario_actualizacion = sy-uname )
        TRANSPORTING ind_actualizado estado fecha_actualizacion hora_actualizacion usuario_actualizacion
        WHERE centro = <fs_es_lista_infotint_gr>-centro
          AND material_generico = <fs_es_lista_infotint_gr>-material_generico
          AND color = <fs_es_lista_infotint_gr>-color
          AND alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD eliminar_componantes_generico.

    DATA: log_con_advertencia           TYPE flwarning,
          ti_lista_material             TYPE gtp_ti_lista_material,
          ti_posicion_lista_eliminar    TYPE t_stpo_api03,
          es_posicion_lista             TYPE stpo_api03,
          es_cabecera_lista_material    TYPE stko_api02,
          resultado_remover_componentes TYPE sysubrc,
          fecha_valida_desde            TYPE datuv_bi.

    go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log      = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                         i_identificador            = get_id_log( c_es_lista_infotint )
***                                                         i_descartar_msj_duplicados = abap_true
                                                         ).

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    go_log->set_es_log( i_es = VALUE #( type = 'S' number = '007' id = 'CRMS4_IU_CM_PROCESS'
                                        message_v1 = TEXT-elm ) ).

    DATA(tiempo_espera_despues_bapi) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_BAPI' ]-low OPTIONAL ).

    cl_progress_indicator=>progress_indicate(
      EXPORTING
        i_msgid              = 'CRMS4_IU_CM_PROCESS'
        i_msgno              = '007'
        i_msgv1              = TEXT-elm
        i_processed          = 3
        i_total              = g_cantidad_total_procesos
        i_output_immediately = abap_true ).

    consultar_lista_material( EXPORTING i_ti_lista_infotint = VALUE #( ( matnr = c_es_lista_infotint-material_generico_sap
                                                                         werks             = c_es_lista_infotint-centro
                                                                         stlal = c_es_lista_infotint-alternativa_escala ) )
                              IMPORTING e_ti_lista_material = ti_lista_material
                                        e_es_lm_cabecera    = DATA(es_lm_cabecera) ).

    LOOP AT ti_lista_material INTO DATA(es_lista_material)
                                WHERE werks = c_es_lista_infotint-centro
                                  AND mtart IN gr_tipo_material_quimico
                                  AND stlal = c_es_lista_infotint-alternativa_escala(2)
                                  AND componente IN i_r_componente
                                  AND ind_borrado_stpo = space
                                  AND ind_borrado_stas = space.
      "Materiales componente que se deben excluir de la eliminacion
      CHECK es_lista_material-componente IN gr_material_quimico_acabado.

      es_posicion_lista =
             VALUE #( item_categ = es_lista_material-postp
                      item_no = es_lista_material-posnr
                      component = es_lista_material-componente
                      comp_qty = VALUE #( gr_cantidad_componente[ 1 ]-low OPTIONAL )
                      rel_cost = abap_true
                      item_node  = es_lista_material-stlkn
                      item_count = es_lista_material-stpoz
                      fldelete = abap_true ).

      APPEND es_posicion_lista TO ti_posicion_lista_eliminar.

    ENDLOOP.

    IF i_ti_posicion_lista_eliminar IS NOT INITIAL.
      ti_posicion_lista_eliminar = i_ti_posicion_lista_eliminar.
    ENDIF.


    IF ti_posicion_lista_eliminar IS NOT INITIAL.

      DO g_cantidad_intento_bloqueo TIMES.

        validar_bloqueo_usuario( c_es_lista_infotint ).

        CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
          EXPORTING
            material           = c_es_lista_infotint-material_generico_sap
            plant              = c_es_lista_infotint-centro
            bom_usage          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
            alternative        = c_es_lista_infotint-alternativa_escala(2)
            valid_from         = fecha_valida_desde
            i_stko             = VALUE stko_api01( base_quan = es_lm_cabecera-bmeng_no_decimal
                                                   alt_text  = es_lm_cabecera-stktx )
            fl_commit_and_wait = abap_true
            fl_complete        = abap_true
            fl_default_values  = abap_true
          IMPORTING
            fl_warning         = log_con_advertencia
            o_stko             = es_cabecera_lista_material
          TABLES
            t_stpo             = ti_posicion_lista_eliminar
          EXCEPTIONS
            error              = 1
            OTHERS             = 2.

        resultado_remover_componentes = sy-subrc.

        "Sis se ejecuto de forma correcta, o si el error es diferente al bloqueo
        IF resultado_remover_componentes IS INITIAL
        OR ( resultado_remover_componentes IS NOT INITIAL AND ( sy-msgid NE '29' OR sy-msgno NE '160' ) ).
          EXIT.
        ENDIF.

      ENDDO.

      IF resultado_remover_componentes IS NOT INITIAL.

        c_es_lista_infotint-estado = icon_red_light.
        c_es_lista_infotint-ind_actualizado = gc_lista_mat_en_error.

        go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                            message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

        asignar_variante_sap( CHANGING c_es_lista_infotint = c_es_lista_infotint ).

      ELSE.
        c_es_lista_infotint-estado = icon_green_light.
        c_es_lista_infotint-ind_actualizado = gc_lista_material_ok.
        LOOP AT ti_posicion_lista_eliminar ASSIGNING FIELD-SYMBOL(<fs_es_posicion_lm_eliminar>).
          go_log->set_es_log( i_es = VALUE #( type = 'S' number = '107' id = gc_clase_mensajes
                                              message_v1 = |{ <fs_es_posicion_lm_eliminar>-component ALPHA = OUT }|
                                              message_v2 = c_es_lista_infotint-material_generico_sap
                                              message_v3 = c_es_lista_infotint-alternativa_escala ) ).
        ENDLOOP.

        WAIT UP TO tiempo_espera_despues_bapi SECONDS.

      ENDIF.

    ENDIF.

  ENDMETHOD.


  METHOD leer_componentes_duplicados.

    DATA: ti_lista_material       TYPE gtp_ti_lista_material,
          ti_lm_variantes         TYPE gtp_ti_lista_material,
          r_componentes_duplicado TYPE RANGE OF mara-matnr,
          posicion_componente     TYPE i,
          fecha_valida_desde      TYPE datuv_bi.


    CLEAR: e_ti_datos_actualizar_lm, e_ti_datos_eliminar_lm, e_es_lm_cabecera, e_ti_variantes_duplicadas.

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    consultar_lista_material( EXPORTING i_descartar_reg_eliminados  = abap_true
                                        i_solo_componentes_quimicos = abap_true
                                        i_incluir_material_variante = abap_true
                                        i_ti_lista_infotint         = VALUE #( ( matnr = i_es_lista_infotint-material_generico_sap
                                                                                 werks = i_es_lista_infotint-centro
                                                                                 stlal = i_es_lista_infotint-alternativa_escala ) )
                              IMPORTING e_es_lm_cabecera            = e_es_lm_cabecera
                                        e_ti_lista_material         = ti_lista_material
                                        e_ti_lm_variantes           = ti_lm_variantes ).

    "Recorrer por componente
    LOOP AT i_ti_componente_x_variantes ASSIGNING FIELD-SYMBOL(<fs_es_componete_x_variante>).

      IF i_incluir_todas_las_variantes = abap_true.
        CLEAR: <fs_es_componete_x_variante>-r_variantes.
      ENDIF.

      LOOP AT ti_lista_material INTO DATA(es_posicion_lm_existentes_gr)
                                WHERE componente = <fs_es_componete_x_variante>-componente
                                GROUP BY es_posicion_lm_existentes_gr-componente.

        "Recorremos por material variante
        LOOP AT ti_lm_variantes   ASSIGNING FIELD-SYMBOL(<fs_es_lm_gr>)
                                  WHERE mtart IN gr_tipo_material_quimico
                                  AND componente = es_posicion_lm_existentes_gr-componente
                                  AND matnr      IN <fs_es_componete_x_variante>-r_variantes
                                  GROUP BY ( componente = <fs_es_lm_gr>-componente ).

          "Determina si existen componentes repetidos por variante
          LOOP AT GROUP <fs_es_lm_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lm_variante_gr>)
                                      GROUP BY ( matnr = <fs_es_lm_variante_gr>-matnr ).

            DATA(cantidad_componente_x_variante) = 0.

            LOOP AT GROUP <fs_es_lm_variante_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lm>).
              ADD 1 TO cantidad_componente_x_variante.
            ENDLOOP.

            IF cantidad_componente_x_variante > 1.

              APPEND VALUE #( sign = 'I' option = 'EQ' low = es_posicion_lm_existentes_gr-componente )
              TO r_componentes_duplicado.

              APPEND
                 VALUE #( item_categ  = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                     item_number = <fs_es_lm>-posnr
                     material    = <fs_es_lm>-matnr
                     component   = <fs_es_lm>-componente
                     quantity    = <fs_es_lm>-bmeng
                     item_node   = <fs_es_lm>-stlkn
                     item_count  = <fs_es_lm>-stpoz )
              TO  e_ti_variantes_duplicadas.

            ENDIF.

          ENDLOOP.

        ENDLOOP.

        IF es_posicion_lm_existentes_gr-componente IN r_componentes_duplicado AND r_componentes_duplicado IS NOT INITIAL.

          ASSIGN e_ti_datos_actualizar_lm[ fecha_valida_desde = fecha_valida_desde ]
          TO FIELD-SYMBOL(<fs_es_datos_actualizar_lm>).

          IF sy-subrc IS NOT INITIAL.
            APPEND INITIAL LINE TO e_ti_datos_actualizar_lm ASSIGNING <fs_es_datos_actualizar_lm>.
            <fs_es_datos_actualizar_lm>-fecha_valida_desde = fecha_valida_desde.
          ENDIF.

          "Agregar componentes
          LOOP AT GROUP es_posicion_lm_existentes_gr INTO DATA(es_posicion_lm_existentes).
            "Valida si el material componente/varainte se encuentra duplicado
            IF i_incluir_todas_las_variantes = abap_false.
              CHECK line_exists( e_ti_variantes_duplicadas[ material = es_posicion_lm_existentes-matnr component = es_posicion_lm_existentes-componente ] ).
            ENDIF.

            ASSIGN e_ti_datos_eliminar_lm[ fecha_valida_desde =  generar_fecha( es_posicion_lm_existentes-datuv ) ]
            TO FIELD-SYMBOL(<fs_es_datos_eliminar_lm>).

            IF sy-subrc IS NOT INITIAL.
              APPEND INITIAL LINE TO e_ti_datos_eliminar_lm ASSIGNING <fs_es_datos_eliminar_lm>.
              <fs_es_datos_eliminar_lm>-fecha_valida_desde =  generar_fecha( es_posicion_lm_existentes-datuv ).
            ENDIF.

            "Agregar registro de componentes a todas las lineas que requieran
            IF NOT line_exists( <fs_es_datos_eliminar_lm>-ti_componentes[ component  = es_posicion_lm_existentes-componente
                                                                          item_no    = es_posicion_lm_existentes-posnr
                                                                          item_node  = es_posicion_lm_existentes-stlkn
                                                                          item_count = es_posicion_lm_existentes-stpoz ] ).
              <fs_es_datos_eliminar_lm>-componentes = r_componentes_duplicado.

              APPEND
              VALUE #( item_categ = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                       item_no = es_posicion_lm_existentes-posnr
                       component = es_posicion_lm_existentes-componente
                       comp_qty = VALUE #( gr_cantidad_componente[ 1 ]-low OPTIONAL )"es_posicion_lm_existentes-bmeng
                       rel_cost = es_posicion_lm_existentes-rel_cost
                       item_node  = es_posicion_lm_existentes-stlkn
                       item_count = es_posicion_lm_existentes-stpoz
                       fldelete = abap_true )
              TO: <fs_es_datos_eliminar_lm>-ti_componentes,
                  e_ti_componente_lm_eliminar,
                  <fs_es_datos_actualizar_lm>-ti_componentes.

              MODIFY <fs_es_datos_actualizar_lm>-ti_componentes
              FROM VALUE #( fldelete = abap_false )
              TRANSPORTING fldelete item_node item_count
              WHERE fldelete = abap_true.

            ENDIF.

          ENDLOOP.

          DELETE ADJACENT DUPLICATES FROM <fs_es_datos_actualizar_lm>-ti_componentes COMPARING component.

          "Agregar varianes que se deben almacenar
          LOOP AT ti_lm_variantes   ASSIGNING <fs_es_lm>
                                    WHERE mtart IN gr_tipo_material_quimico
                                    AND componente = es_posicion_lm_existentes_gr-componente
                                    AND matnr      IN <fs_es_componete_x_variante>-r_variantes.

            "Agregar todas las variantes para los componentes que se deben actualizar
            IF NOT line_exists( <fs_es_datos_actualizar_lm>-ti_variantes_bomd[ item_number = <fs_es_lm>-posnr
                                                                               material    = <fs_es_lm>-matnr
                                                                               component   = <fs_es_lm>-componente ] ).
              READ TABLE <fs_es_datos_actualizar_lm>-ti_componentes INTO DATA(es_componentes)
              WITH KEY component = <fs_es_lm>-componente.

              posicion_componente = sy-tabix.

              APPEND
                  VALUE #( item_categ  = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                           item_number = es_componentes-item_no "<fs_es_lm>-posnr
                           material    = <fs_es_lm>-matnr
                           component   = <fs_es_lm>-componente
                           quantity    = <fs_es_lm>-menge
                           fsh_comp_lno = posicion_componente )
              TO <fs_es_datos_actualizar_lm>-ti_variantes_bomd.

            ENDIF.

          ENDLOOP.

        ENDIF.

      ENDLOOP.
    ENDLOOP.

    SORT e_ti_datos_eliminar_lm BY fecha_valida_desde ASCENDING.

    IF e_ti_datos_eliminar_lm IS NOT INITIAL.

      LOOP AT e_ti_datos_actualizar_lm ASSIGNING <fs_es_datos_actualizar_lm>.
        "Para actualizar se descartan los registros mas antiguos
        IF sy-tabix > 1.
          DELETE e_ti_datos_actualizar_lm WHERE fecha_valida_desde = <fs_es_datos_actualizar_lm>-fecha_valida_desde.
          CONTINUE.
        ENDIF.

        DELETE ADJACENT DUPLICATES FROM <fs_es_datos_actualizar_lm>-ti_componentes COMPARING item_categ item_no component.
        SORT <fs_es_datos_actualizar_lm>-ti_variantes_bomd BY item_categ item_number component material .
        DELETE ADJACENT DUPLICATES FROM <fs_es_datos_actualizar_lm>-ti_variantes_bomd COMPARING item_categ item_number component material .

        LOOP AT <fs_es_datos_actualizar_lm>-ti_variantes_bomd ASSIGNING FIELD-SYMBOL(<fs_es_posiciones_bomd>).

          READ TABLE <fs_es_datos_actualizar_lm>-ti_componentes TRANSPORTING NO FIELDS
          WITH KEY component = <fs_es_posiciones_bomd>-component.

          <fs_es_posiciones_bomd>-fsh_comp_lno = sy-tabix.

        ENDLOOP.
      ENDLOOP.

    ENDIF.

  ENDMETHOD.


  METHOD verificar_consistencia_lm.

    DATA: ti_posicion_lista_actualizar  TYPE STANDARD TABLE OF stpo_api03,
          ti_posiciones_bomd_actualizar TYPE STANDARD TABLE OF fsh_s_bomvd_api,
          ti_componente_x_variantes     TYPE gtp_ti_componente_variantes,
          resultado_adicion_componentes TYPE sysubrc,
          fecha_valida_desde            TYPE datuv_bi.

    DATA(tiempo_espera_despues_bapi) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_BAPI' ]-low OPTIONAL ).

    IF i_tiempo_espera_extendido = abap_true.
      tiempo_espera_despues_bapi = tiempo_espera_despues_bapi * 2.
    ENDIF.

    "Identificar los componetes y variantes a los que se le debe realizar el proceso de duplicidad de datos
    ti_componente_x_variantes =
      consolidar_componente_variante(
      EXPORTING
        i_es_lista_infotint = c_es_lista_infotint
        i_ti_lista_infotint = c_ti_lista_infotint ).

    leer_componentes_duplicados(
      EXPORTING
        i_ti_componente_x_variantes   = ti_componente_x_variantes
        i_incluir_todas_las_variantes = abap_true
        i_es_lista_infotint           = c_es_lista_infotint
      IMPORTING
        e_es_lm_cabecera              = DATA(es_lm_cabecera)
        e_ti_variantes_duplicadas     = DATA(ti_compo_variante_duplicado)
        e_ti_datos_eliminar_lm        = DATA(ti_datos_eliminar_lm)
        e_ti_componente_lm_eliminar   = DATA(ti_componente_lm_eliminar)
        e_ti_datos_actualizar_lm      = DATA(ti_datos_actualizar_lm) ).

    go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log          = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                       i_identificador            = get_id_log( c_es_lista_infotint )
*                                                       i_descartar_msj_duplicados = abap_true
                                                        ).

    validar_bloqueo_usuario( i_es_lista_infotint = c_es_lista_infotint ).

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    IF ti_compo_variante_duplicado IS NOT INITIAL.

      go_log->set_es_log( i_es = VALUE #( type = 'S' number = '113' id = gc_clase_mensajes
                                          message_v1 = c_es_lista_infotint-material_generico_sap
                                          message_v2 = c_es_lista_infotint-alternativa_escala ) ).

      cl_progress_indicator=>progress_indicate(
        EXPORTING
          i_msgid              = gc_clase_mensajes
          i_msgno              = '113'
          i_msgv1              = c_es_lista_infotint-material_generico_sap
          i_msgv2              = c_es_lista_infotint-alternativa_escala
          i_processed          = i_numero_proceso
          i_total              = g_cantidad_total_procesos
          i_output_immediately = abap_true ).

      "Se consolidan los componentes y las variantes que estan duplicadas para pasar a limpiar su mapeo y si aplica
      "eliminar el componente a nivel de generico
      CLEAR: ti_componente_x_variantes.

      LOOP AT ti_compo_variante_duplicado ASSIGNING FIELD-SYMBOL(<fs_es_variante_duplicado_gr>)
                                          GROUP BY <fs_es_variante_duplicado_gr>-component.

        APPEND INITIAL LINE TO ti_componente_x_variantes ASSIGNING FIELD-SYMBOL(<fs_es_componente_x_variantes>).
        <fs_es_componente_x_variantes>-componente = <fs_es_variante_duplicado_gr>-component.

        LOOP AT GROUP <fs_es_variante_duplicado_gr> ASSIGNING FIELD-SYMBOL(<fs_es_variante_duplicado>).

          APPEND VALUE #( sign = 'I' option = 'EQ' low = <fs_es_variante_duplicado>-material )
          TO <fs_es_componente_x_variantes>-r_variantes.

        ENDLOOP.

        SORT <fs_es_componente_x_variantes>-r_variantes BY low.
        DELETE ADJACENT DUPLICATES FROM <fs_es_componente_x_variantes>-r_variantes COMPARING low.

      ENDLOOP.

      eliminar_componantes_variante(
        EXPORTING
          i_ti_componente_x_variantes   = ti_componente_x_variantes
          i_incluir_todas_las_variantes = abap_true
          i_ti_posicion_lista_eliminar  = ti_componente_lm_eliminar
          i_tiempo_espera_extendido     = i_tiempo_espera_extendido
        CHANGING
          c_es_lista_infotint           = c_es_lista_infotint ).

      IF ti_datos_actualizar_lm IS NOT INITIAL.

        LOOP AT ti_datos_actualizar_lm ASSIGNING FIELD-SYMBOL(<fs_es_lm_actualizar>).

          ti_posicion_lista_actualizar = <fs_es_lm_actualizar>-ti_componentes.
          ti_posiciones_bomd_actualizar = <fs_es_lm_actualizar>-ti_variantes_bomd.

          DO g_cantidad_intento_bloqueo TIMES.

            validar_bloqueo_usuario( c_es_lista_infotint ).

            ges_lm_infotint_en_proceso = REF #( c_es_lista_infotint ).
            g_actualizacion_lm_terminada = abap_false.
            g_lm_bloqueada = abap_false.

            CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
              EXPORTING
                material           = c_es_lista_infotint-material_generico_sap
                plant              = c_es_lista_infotint-centro
                bom_usage          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
                alternative        = c_es_lista_infotint-alternativa_escala(2)
                valid_from         = <fs_es_lm_actualizar>-fecha_valida_desde "fecha_valida_desde
                i_stko             = VALUE stko_api01( base_quan =  es_lm_cabecera-bmeng_no_decimal
                                                       alt_text  =  es_lm_cabecera-stktx )
                fl_commit_and_wait = abap_true
              TABLES
                t_stpo             = ti_posicion_lista_actualizar
                t_fsh_bomd         = ti_posiciones_bomd_actualizar
              EXCEPTIONS
                error              = 1
                OTHERS             = 2.

            resultado_adicion_componentes = sy-subrc.
            "Sis se ejecuto de forma correcta, o si el error es diferente al bloqueo
            IF resultado_adicion_componentes IS INITIAL
            OR ( resultado_adicion_componentes IS NOT INITIAL AND ( sy-msgid NE '29' OR sy-msgno NE '160' ) ).
              EXIT.
            ENDIF.

          ENDDO.

          IF resultado_adicion_componentes IS NOT INITIAL.

            c_es_lista_infotint-estado = icon_red_light.
            c_es_lista_infotint-ind_actualizado = gc_lista_mat_en_error.

            go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                                message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

            asignar_variante_sap( CHANGING c_es_lista_infotint = c_es_lista_infotint ).
          ELSE.
            c_es_lista_infotint-estado = icon_green_light.
            c_es_lista_infotint-ind_actualizado = gc_lista_material_ok.

            LOOP AT ti_posiciones_bomd_actualizar INTO DATA(es_variantes)
                                                  GROUP BY ( component = es_variantes-component
                                                             material  = es_variantes-material ).
              go_log->set_es_log( i_es = VALUE #( type = 'S' number = '097' id = gc_clase_mensajes
                                                  message_v1 = es_variantes-component
                                                  message_v2 = es_variantes-material
                                                  message_v3 = c_es_lista_infotint-alternativa_escala ) ).
            ENDLOOP.

            WAIT UP TO tiempo_espera_despues_bapi SECONDS.
          ENDIF.

        ENDLOOP.

      ENDIF.

    ENDIF.

  ENDMETHOD.


  METHOD eliminar_componantes_variante.

    DATA: ti_posicion_lm_limpiar_mapeo  TYPE STANDARD TABLE OF stpo_api03,
          ti_variantes_bom              TYPE STANDARD TABLE OF fsh_s_bomvd_api,
          ti_lista_material             TYPE gtp_ti_lista_material,
          ti_lm_variante                TYPE gtp_ti_lista_material,
          r_variantes_infotint          TYPE RANGE OF mara-matnr,
          r_componente_eliminar         TYPE RANGE OF mara-matnr,
          es_posicion_lista             TYPE stpo_api03,
          consecutivo_lista_actualizar  TYPE i,
          resultado_remover_componentes TYPE sysubrc,
          fecha_valida_desde            TYPE datuv_bi.

    go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log      = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                         i_identificador            = get_id_log( c_es_lista_infotint )
***                                                         i_descartar_msj_duplicados = abap_true
                                                         ).

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    DATA(msj) = |{ TEXT-lmv } { COND #( WHEN c_ti_lista_infotint IS NOT INITIAL THEN c_es_lista_infotint-material_variante ELSE space ) } { c_es_lista_infotint-alternativa_escala }|.
    go_log->set_es_log( i_es = VALUE #( type = 'S' number = '007' id = 'CRMS4_IU_CM_PROCESS'
                                        message_v1 = msj ) ).
    DATA(tiempo_espera_despues_bapi) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_BAPI' ]-low OPTIONAL ).

    IF i_tiempo_espera_extendido = abap_true.
      tiempo_espera_despues_bapi = tiempo_espera_despues_bapi * 2.
    ENDIF.

    cl_progress_indicator=>progress_indicate(
      EXPORTING
        i_msgid              = 'CRMS4_IU_CM_PROCESS'
        i_msgno              = '007'
        i_msgv1              = msj
        i_processed          = 2
        i_total              = g_cantidad_total_procesos
        i_output_immediately = abap_true ).

    consultar_lista_material( EXPORTING i_descartar_reg_eliminados  = abap_true
                                        i_incluir_material_variante = abap_true
                                        i_solo_componentes_quimicos = abap_true
                                        i_ti_lista_infotint         = VALUE #( ( matnr = c_es_lista_infotint-material_generico_sap
                                                                                 werks             = c_es_lista_infotint-centro
                                                                                 stlal = c_es_lista_infotint-alternativa_escala ) )
                              IMPORTING e_es_lm_cabecera            = DATA(es_lm_cabecera)
                                        e_ti_lista_material         = ti_lista_material
                                        e_ti_lm_variantes           = ti_lm_variante ).

    "Si no se envia los componentes/variantes a limpiar, se debe hacer para todos los componentes/variante de la LM y su alternativa
    IF i_ti_componente_x_variantes IS INITIAL.

      r_variantes_infotint = VALUE #( FOR es_lista_infotint IN c_ti_lista_infotint WHERE (    centro = c_es_lista_infotint-centro
                                                                                            AND material_generico_sap = c_es_lista_infotint-material_generico_sap
                                                                                            AND alternativa_escala    = c_es_lista_infotint-alternativa_escala
                                                                                            AND procesar              = abap_true
                                                                                   )
                                ( sign = 'I' option = 'EQ' low = es_lista_infotint-material_variante )
                              ).

      "agregar componentes que existian pero ya no se enviaron desde infotint y por ende se deben eliminar
      LOOP AT ti_lm_variante REFERENCE INTO DATA(r_es_lm_variante_gr)
                             GROUP BY r_es_lm_variante_gr->componente.

        IF NOT line_exists( i_ti_componente_x_variantes[ componente = r_es_lm_variante_gr->componente ] ).
          APPEND INITIAL LINE TO i_ti_componente_x_variantes ASSIGNING FIELD-SYMBOL(<fs_es_componete_x_variante>).
          <fs_es_componete_x_variante>-componente = r_es_lm_variante_gr->componente.

          APPEND LINES OF r_variantes_infotint TO <fs_es_componete_x_variante>-r_variantes.

        ENDIF.

      ENDLOOP.
    ENDIF.

    "Recorrer Componentes x Variante
    LOOP AT i_ti_componente_x_variantes ASSIGNING <fs_es_componete_x_variante>.

      IF i_incluir_todas_las_variantes = abap_true.
        CLEAR: <fs_es_componete_x_variante>-r_variantes.
      ENDIF.

      LOOP AT ti_lm_variante INTO DATA(es_componente_bom_en_lista)
                                 WHERE componente = <fs_es_componete_x_variante>-componente
                                   AND matnr IN <fs_es_componete_x_variante>-r_variantes
                                 GROUP BY ( componente = es_componente_bom_en_lista-componente
                                            matnr = es_componente_bom_en_lista-matnr ).
        DATA(es_posicion_lista_existentes) = VALUE #( ti_lista_material[ componente = es_componente_bom_en_lista-componente ] OPTIONAL ).

        "Materiales componente que se deben excluir de la eliminacion
        CHECK es_componente_bom_en_lista-componente IN gr_material_quimico_acabado
        AND es_posicion_lista_existentes IS NOT INITIAL.

        IF NOT line_exists( ti_posicion_lm_limpiar_mapeo[ component = es_posicion_lista_existentes-componente ] ).
          es_posicion_lista =
                 VALUE #( item_categ = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                          item_no = es_posicion_lista_existentes-posnr
                          component = es_posicion_lista_existentes-componente
                          comp_qty = COND #( WHEN c_ti_lista_infotint IS NOT INITIAL THEN
                                              es_posicion_lista_existentes-bmeng
                                             ELSE
                                              VALUE #( gr_cantidad_componente[ 1 ]-low OPTIONAL ) )
                          rel_cost = es_posicion_lista_existentes-rel_cost
                          item_node  = es_posicion_lista_existentes-stlkn
                          item_count = es_posicion_lista_existentes-stpoz ).

          APPEND es_posicion_lista TO ti_posicion_lm_limpiar_mapeo.
        ENDIF.

        READ TABLE ti_posicion_lm_limpiar_mapeo INTO es_posicion_lista"TRANSPORTING NO FIELDS
        WITH KEY component = es_posicion_lista_existentes-componente.

        consecutivo_lista_actualizar = sy-tabix.

        APPEND VALUE #( item_categ  = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                        item_number = es_componente_bom_en_lista-posnr
                        item_node   = es_posicion_lista-item_node
                        item_count  = es_posicion_lista-item_count
                        material    = es_componente_bom_en_lista-matnr
                        component   = es_componente_bom_en_lista-componente
                        quantity    = space
                        fsh_comp_lno = consecutivo_lista_actualizar
                        )
            TO  ti_variantes_bom.

        CLEAR: es_posicion_lista_existentes.

      ENDLOOP.
    ENDLOOP.

    IF ti_posicion_lm_limpiar_mapeo IS NOT INITIAL.

      DO g_cantidad_intento_bloqueo TIMES.

        validar_bloqueo_usuario( c_es_lista_infotint ).

        CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
          EXPORTING
            material           = c_es_lista_infotint-material_generico_sap
            plant              = c_es_lista_infotint-centro
            bom_usage          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
            alternative        = c_es_lista_infotint-alternativa_escala(2)
            valid_from         = fecha_valida_desde
            i_stko             = VALUE stko_api01( base_quan = es_lm_cabecera-bmeng_no_decimal
                                                   alt_text  = es_lm_cabecera-stktx )
            fl_commit_and_wait = abap_true
*           fl_complete        = abap_true
*           fl_default_values  = abap_true
          TABLES
            t_stpo             = ti_posicion_lm_limpiar_mapeo
            t_fsh_bomd         = ti_variantes_bom
          EXCEPTIONS
            error              = 1
            OTHERS             = 2.

        resultado_remover_componentes = sy-subrc.

        "Sis se ejecuto de forma correcta, o si el error es diferente al bloqueo
        IF resultado_remover_componentes IS INITIAL
        OR ( resultado_remover_componentes IS NOT INITIAL AND ( sy-msgid NE '29' OR sy-msgno NE '160' ) ).
          EXIT.
        ENDIF.

      ENDDO.

      IF resultado_remover_componentes IS NOT INITIAL.

        c_es_lista_infotint-estado = icon_red_light.
        c_es_lista_infotint-ind_actualizado = gc_lista_mat_en_error.

        go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                            message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

        asignar_variante_sap( CHANGING c_es_lista_infotint = c_es_lista_infotint ).

      ELSE.
        c_es_lista_infotint-estado = icon_green_light.
        c_es_lista_infotint-ind_actualizado = gc_lista_material_ok.
        LOOP AT ti_variantes_bom INTO DATA(es_variante_bom)
        GROUP BY ( component = es_variante_bom-component
                   material = es_variante_bom-material ).
          go_log->set_es_log( i_es = VALUE #( type = 'S' number = '116' id = gc_clase_mensajes
                                              message_v1 = |{ es_variante_bom-component ALPHA = OUT }|
                                              message_v2 = es_variante_bom-material
                                              message_v3 = c_es_lista_infotint-alternativa_escala ) ).
        ENDLOOP.
        WAIT UP TO tiempo_espera_despues_bapi SECONDS.
      ENDIF.

    ENDIF.

    IF r_componente_eliminar IS INITIAL.

      consultar_lista_material( EXPORTING i_ti_lista_infotint = VALUE #( ( matnr = c_es_lista_infotint-material_generico_sap
                                                                           werks             = c_es_lista_infotint-centro
                                                                           stlal = c_es_lista_infotint-alternativa_escala ) )
                                IMPORTING e_ti_lista_material = ti_lista_material ).
      "Tomar las posiciones de los materiales quimicos que estén vacíos en el campo Valores desviación
      "FSH_VMKZ para ser eliminados los componentes de la lista de materiales por material genérico,
      "de lo contrario es porque tiene marca “X” que indica que el componente mínimamente contiene una variante mapeada,
      "entonces NO eliminarlo
      LOOP  AT ti_lista_material REFERENCE INTO DATA(r_es_lm)
                                 GROUP BY  r_es_lm->componente.

        IF NOT line_exists( ti_lista_material[ componente = r_es_lm->componente fsh_vmkz = abap_true ] ).
          APPEND VALUE #( sign = 'I' option = 'EQ' low = r_es_lm->componente )
          TO r_componente_eliminar.
        ENDIF.

      ENDLOOP.
    ENDIF.

    IF r_componente_eliminar IS NOT INITIAL OR i_ti_posicion_lista_eliminar IS NOT INITIAL.
      eliminar_componantes_generico( EXPORTING i_r_componente               = r_componente_eliminar
                                               i_ti_posicion_lista_eliminar = i_ti_posicion_lista_eliminar
                                               i_tiempo_espera_extendido    = i_tiempo_espera_extendido
                                     CHANGING  c_es_lista_infotint          = c_es_lista_infotint ).
    ENDIF.

*    ejecutar_consistencia_lm( i_es_lista_infotint = c_es_lista_infotint i_tiempo_espera_extendido = i_tiempo_espera_extendido ).

  ENDMETHOD.


  METHOD actualizar_lista_materiales.

    DATA: ti_datos_actualizar_lm        TYPE gtp_ti_datos_actualizar_lm,
          ti_posicion_lista_eliminar    TYPE STANDARD TABLE OF stpo_api03,
          ti_lm_generico                TYPE gtp_ti_lista_material,
          ti_lm_variante                TYPE gtp_ti_lista_material,
          ti_componentes_sap            TYPE gtp_ti_componentes_sap,
          es_posicion_lista             TYPE stpo_api03,
          ultima_posicion_lm_actualizar TYPE numc4,
          contador_posicion_lista_act   TYPE numc4,
          consecutivo_lista_actualizar  TYPE i,
          resultado_adicion_componentes TYPE sysubrc,
          fecha_valida_desde            TYPE datuv_bi,
          ind_componente_no_quimico     TYPE flag,
          cantidad_acumulada_componente TYPE ztppi1209_1-cant_mapeo.

    ti_componentes_sap = consultar_componentes( i_ti_lista_infotint = c_ti_lista_infotint ).

    fecha_valida_desde = |{ sy-datum+6(2) }.{ sy-datum+4(2) }.{ sy-datum(4) }|.

    DATA(tiempo_espera_despues_bapi) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_BAPI' ]-low OPTIONAL ).

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                WHERE procesar = abap_true
                                AND ind_actualizado NE gc_lista_material_ok
                                AND estado = icon_light_out
                                AND material_variante IS NOT INITIAL
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico = <fs_es_lista_infotint_gr>-material_generico
                                           alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      verificar_consistencia_lm(
        CHANGING
          c_es_lista_infotint = <fs_es_lista_infotint_gr>
          c_ti_lista_infotint = c_ti_lista_infotint ).

      """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
      "Eliminar componentes lista anterior                           "
      """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
      eliminar_componantes_variante( EXPORTING i_incluir_todas_las_variantes = abap_false
                                     CHANGING  c_es_lista_infotint           = <fs_es_lista_infotint_gr>
                                               c_ti_lista_infotint           = c_ti_lista_infotint ).

      "Recorrer componentes de INFOTINT para ser actualizados en Lista de Material
      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>)
                                              GROUP BY ( color = <fs_es_lista_infotint>-color
                                                         "material_variante = <fs_es_lista_infotint>-material_variante
                                                         ).

        go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log      = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                       i_identificador            = get_id_log( <fs_es_lista_infotint> ) ).

        <fs_es_lista_infotint>-ind_actualizado = gc_lista_material_ok.
        <fs_es_lista_infotint>-estado = icon_green_light.

        CLEAR: cantidad_acumulada_componente,consecutivo_lista_actualizar, ti_datos_actualizar_lm,
               ti_posicion_lista_eliminar, ind_componente_no_quimico.

        "Si no existe errores en la eliminacion de componentes y existe la lsita
        IF <fs_es_lista_infotint>-ind_actualizado = gc_lista_material_ok.

          "Consulatar posiciones en lista de material existente para COMPONENTE
          consultar_lista_material( EXPORTING i_descartar_reg_eliminados  = abap_true
                                              i_incluir_material_variante = abap_true
                                              i_solo_componentes_quimicos = abap_true
                                              i_ti_lista_infotint         = VALUE #( ( matnr = <fs_es_lista_infotint_gr>-material_generico_sap
                                                                                       werks = <fs_es_lista_infotint_gr>-centro
                                                                                       stlal = <fs_es_lista_infotint_gr>-alternativa_escala ) )
                                    IMPORTING e_es_lm_cabecera            = DATA(es_lm_cabecera)
                                              e_ti_lista_material         = ti_lm_generico
                                              e_ti_lm_variantes           = ti_lm_variante
                                              e_ultima_posicion           = ultima_posicion_lm_actualizar ).

          "Recorrer variantes de COLOR x COMPONENTE
          LOOP AT GROUP <fs_es_lista_infotint> ASSIGNING FIELD-SYMBOL(<fs_es_ls_infotint_variante>).
            "validar que el componente sea un quimico
            DATA(es_componente_sap) = VALUE #( ti_componentes_sap[ componente = <fs_es_ls_infotint_variante>-componente ] OPTIONAL ).

            IF es_componente_sap-mtart NOT IN gr_tipo_material_quimico.
              <fs_es_lista_infotint>-estado = icon_red_light.
              <fs_es_lista_infotint>-ind_actualizado = gc_lista_mat_en_error.

              go_log->set_es_log( i_es = VALUE #( type = 'E' number = '106' id = gc_clase_mensajes
                                                message_v1 = <fs_es_ls_infotint_variante>-componente
                                                message_v2 = es_componente_sap-mtart ) ).

              ind_componente_no_quimico = abap_true.

              CONTINUE.
            ENDIF.

            "Valida si el componente existe, y asigna la misma posicion, de lo contrario asigna la ultima para sumar 10
            DATA(es_componente_en_lista) =
            VALUE #( ti_lm_generico[ componente = <fs_es_ls_infotint_variante>-componente ] OPTIONAL ).

            IF es_componente_en_lista IS NOT INITIAL."Componene exite en LM
              contador_posicion_lista_act = es_componente_en_lista-posnr.
            ELSE.
              "Si no existe el componente en la lista, debe sumar 10 a la ultima posicion
              ultima_posicion_lm_actualizar = ultima_posicion_lm_actualizar + 10.
              contador_posicion_lista_act = ultima_posicion_lm_actualizar.
            ENDIF.

            cantidad_acumulada_componente = <fs_es_ls_infotint_variante>-cant_mapeo.

            "Para actualizar
            DATA(es_componente_bom_en_lista) = VALUE #( ti_lm_variante[ matnr      = <fs_es_ls_infotint_variante>-material_variante
                                                                        componente = <fs_es_ls_infotint_variante>-componente ] OPTIONAL ).

            ASSIGN ti_datos_actualizar_lm[ fecha_valida_desde =  COND #( WHEN es_componente_en_lista-datuv IS NOT INITIAL THEN
                                                                           generar_fecha( es_componente_en_lista-datuv )
                                                                         ELSE
                                                                           fecha_valida_desde )  ]
            TO FIELD-SYMBOL(<fs_es_datos_actualizar_lm>).

            IF sy-subrc IS NOT INITIAL.
              APPEND INITIAL LINE TO ti_datos_actualizar_lm ASSIGNING <fs_es_datos_actualizar_lm>.
              <fs_es_datos_actualizar_lm>-fecha_valida_desde = COND #( WHEN es_componente_en_lista-datuv IS INITIAL THEN
                                                                          fecha_valida_desde
                                                                       ELSE
                                                                          generar_fecha( es_componente_en_lista-datuv ) ).
            ENDIF.

            IF NOT line_exists( <fs_es_datos_actualizar_lm>-ti_componentes[ component = <fs_es_ls_infotint_variante>-componente ] ).
              es_posicion_lista =
                     VALUE #( item_categ = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                              item_no    = contador_posicion_lista_act
                              id_item_no = COND #( WHEN es_componente_en_lista IS NOT INITIAL THEN
                                                     es_componente_en_lista-posnr"item_no
                                                   ELSE
                                                    space )
                              component = <fs_es_ls_infotint_variante>-componente
                              item_node = COND #( WHEN es_componente_en_lista IS NOT INITIAL THEN
                                                     es_componente_en_lista-stlkn "item_node
                                                   ELSE
                                                    space )
                              item_count = COND #( WHEN es_componente_en_lista IS NOT INITIAL THEN
                                                     es_componente_en_lista-stpoz "item_count
                                                   ELSE
                                                    space )
                              comp_qty = VALUE #( gr_cantidad_componente[ 1 ]-low OPTIONAL )
                              rel_cost = abap_true
                              fldelete = abap_false ).

              APPEND es_posicion_lista TO <fs_es_datos_actualizar_lm>-ti_componentes.
            ENDIF.

            CLEAR: es_posicion_lista.
            READ TABLE <fs_es_datos_actualizar_lm>-ti_componentes INTO es_posicion_lista
                                                   WITH KEY component = <fs_es_ls_infotint_variante>-componente.
            consecutivo_lista_actualizar = sy-tabix.

            APPEND VALUE #( item_categ  = VALUE #( gr_tipo_posicion_lista[ 1 ]-low OPTIONAL )
                            item_number = es_posicion_lista-item_no "contador_posicion_lista_act
                            item_node = COND #( WHEN es_posicion_lista IS NOT INITIAL THEN
                                                   es_posicion_lista-item_node
                                                 ELSE
                                                  space )
                            item_count = COND #( WHEN es_posicion_lista IS NOT INITIAL THEN
                                                   es_posicion_lista-item_count
                                                 ELSE
                                                  space )
                            material    = <fs_es_ls_infotint_variante>-material_variante
                            component   = <fs_es_ls_infotint_variante>-componente
                            quantity    = cantidad_acumulada_componente
                            fsh_comp_lno = consecutivo_lista_actualizar )
            TO  <fs_es_datos_actualizar_lm>-ti_variantes_bomd.

          ENDLOOP.

          IF ind_componente_no_quimico = abap_false.

            LOOP AT ti_datos_actualizar_lm ASSIGNING <fs_es_datos_actualizar_lm>.
              DATA(es_msg) = VALUE bapiret2( message_v1 = |{ TEXT-pag } { <fs_es_lista_infotint>-material_generico_sap }|
                                             message_v2 = |color { <fs_es_lista_infotint>-color } alt { <fs_es_lista_infotint>-alternativa_escala }|
                                             message_v3 = |fecha { <fs_es_datos_actualizar_lm>-fecha_valida_desde }| ).
              go_log->set_es_log( i_es = VALUE #( type = 'S' number = '117' id = 'ZPP01'
                                                message_v1 = es_msg-message_v1
                                                message_v2 = es_msg-message_v2
                                                message_v3 = es_msg-message_v3 ) ).

              cl_progress_indicator=>progress_indicate(
                EXPORTING
                  i_msgid              = 'ZPP01'
                  i_msgno              = '117'
                  i_msgv1              = es_msg-message_v1
                  i_msgv2              = es_msg-message_v2
                  i_msgv3              = es_msg-message_v3
                  i_processed          = 4
                  i_total              = g_cantidad_total_procesos
                  i_output_immediately = abap_true
              ).

              CLEAR: resultado_adicion_componentes.
              "Para evitar bloqueos, intenta N veces adicionar los componentes
              DO g_cantidad_intento_bloqueo TIMES.

                validar_bloqueo_usuario( <fs_es_lista_infotint_gr> ).

                ges_lm_infotint_en_proceso = REF #( <fs_es_lista_infotint> ).
                g_actualizacion_lm_terminada = abap_false.
                g_lm_bloqueada = abap_false.

                CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
                  EXPORTING
                    material           = <fs_es_lista_infotint_gr>-material_generico_sap
                    plant              = <fs_es_lista_infotint_gr>-centro
                    bom_usage          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
                    alternative        = <fs_es_lista_infotint_gr>-alternativa_escala(2)
                    valid_from         = <fs_es_datos_actualizar_lm>-fecha_valida_desde
                    i_stko             = VALUE stko_api01( base_quan = es_lm_cabecera-bmeng_no_decimal
                                                           alt_text  = es_lm_cabecera-stktx )
                    fl_commit_and_wait = abap_true
                  TABLES
                    t_stpo             = <fs_es_datos_actualizar_lm>-ti_componentes
                    t_fsh_bomd         = <fs_es_datos_actualizar_lm>-ti_variantes_bomd
                  EXCEPTIONS
                    error              = 1
                    OTHERS             = 2.

                resultado_adicion_componentes = sy-subrc.
                "Sis se ejecuto de forma correcta, o si el error es diferente al bloqueo
                IF resultado_adicion_componentes IS INITIAL
                OR ( resultado_adicion_componentes IS NOT INITIAL AND ( sy-msgid NE '29' OR sy-msgno NE '160' ) ).
                  EXIT.
                ENDIF.

              ENDDO.

              IF resultado_adicion_componentes IS NOT INITIAL.

                <fs_es_lista_infotint>-estado = icon_red_light.
                <fs_es_lista_infotint>-ind_actualizado = gc_lista_mat_en_error.

                go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                                  message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

                asignar_variante_sap( CHANGING c_es_lista_infotint = <fs_es_lista_infotint> ).

              ELSE.
                <fs_es_lista_infotint>-estado = icon_green_light.
                <fs_es_lista_infotint>-ind_actualizado = gc_lista_material_ok.

                LOOP AT <fs_es_datos_actualizar_lm>-ti_variantes_bomd INTO DATA(es_variantes)
                                                                      GROUP BY ( component = es_variantes-component
                                                                                 material = es_variantes-material ).
                  go_log->set_es_log( i_es = VALUE #( type = 'S' number = '097' id = gc_clase_mensajes
                                                      message_v1 = es_variantes-component
                                                      message_v2 = es_variantes-material
                                                      message_v3 = <fs_es_lista_infotint>-alternativa_escala ) ).
                ENDLOOP.

                WAIT UP TO tiempo_espera_despues_bapi SECONDS.
              ENDIF.

            ENDLOOP.

          ENDIF.

        ENDIF.

        "Actualizar a nivel de material variante
        MODIFY c_ti_lista_infotint
        USING KEY key_agrupador
        FROM VALUE #( ind_actualizado = <fs_es_lista_infotint>-ind_actualizado estado = <fs_es_lista_infotint>-estado
                      fecha_actualizacion = sy-datum hora_actualizacion = sy-uzeit usuario_actualizacion = sy-uname
                      )
        TRANSPORTING ind_actualizado estado fecha_actualizacion hora_actualizacion usuario_actualizacion
        WHERE centro = <fs_es_lista_infotint>-centro
          AND material_generico = <fs_es_lista_infotint>-material_generico
          AND color = <fs_es_lista_infotint>-color
          AND alternativa_escala = <fs_es_lista_infotint>-alternativa_escala.

      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.


  METHOD respuesta_actualizacion_lm.

    DATA: log_con_advertencia        TYPE flwarning,
          es_cabecera_lista_material TYPE stko_api02.

    FIELD-SYMBOLS: <fs_es_lista_infotint> TYPE gtp_es_datos_infotint.

    ASSIGN ges_lm_infotint_en_proceso->* TO <fs_es_lista_infotint>.

    g_actualizacion_lm_terminada = abap_true.

    RECEIVE RESULTS FROM FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
        IMPORTING
          fl_warning         = log_con_advertencia
          o_stko             = es_cabecera_lista_material
        EXCEPTIONS
          error              = 1
          OTHERS             = 2.

    DATA(resultado_adicion_componentes) = sy-subrc.

    IF resultado_adicion_componentes IS NOT INITIAL.

      IF  sy-msgid = '29' AND sy-msgno = '160'.
        g_lm_bloqueada = abap_true.
      ELSE.

        <fs_es_lista_infotint>-estado = icon_red_light.
        <fs_es_lista_infotint>-ind_actualizado = gc_lista_mat_en_error.

        go_log->set_es_log( i_es = VALUE #( type = sy-msgty number = sy-msgno id = sy-msgid message_v1 = sy-msgv1 message_v2 = sy-msgv2
                                          message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).

        asignar_variante_sap( CHANGING c_es_lista_infotint = <fs_es_lista_infotint> ).
      ENDIF.

    ELSE.

      <fs_es_lista_infotint>-estado = icon_green_light.
      <fs_es_lista_infotint>-ind_actualizado = gc_lista_material_ok.

      go_log->set_es_log( i_es = VALUE #( type = 'S' number = '097' id = gc_clase_mensajes
                                          message_v1 = |{ <fs_es_lista_infotint>-material_generico_sap ALPHA = OUT }|
                                          message_v2 = <fs_es_lista_infotint>-color
                                          message_v3 = <fs_es_lista_infotint>-alternativa_escala ) ).
    ENDIF.

  ENDMETHOD.


  METHOD modificar_catalogo.

    LOOP AT c_ti_catalogo ASSIGNING FIELD-SYMBOL(<fs_es_catalogo>).
      <fs_es_catalogo>-col_opt = abap_true.

      CASE <fs_es_catalogo>-fieldname.

        WHEN 'PROCESAR'.
          <fs_es_catalogo>-checkbox = abap_true.
          <fs_es_catalogo>-edit = abap_true.
        WHEN 'ESTADO'.
          <fs_es_catalogo>-just = 'C'.
        WHEN 'IND_ACTUALIZADO'.
          <fs_es_catalogo>-f4availabl = abap_true.
          <fs_es_catalogo>-domname = 'ZDMIND_ACTUALIZADO'.
          <fs_es_catalogo>-ref_table = 'ZTPPI1209_1'.
          <fs_es_catalogo>-ref_field = 'IND_ACTUALIZADO'.
        WHEN 'MENSAJE'.
          <fs_es_catalogo>-col_opt = abap_false.
          <fs_es_catalogo>-outputlen = 15.
          <fs_es_catalogo>-hotspot = abap_true.
        WHEN 'COMPONENTE'.
          <fs_es_catalogo>-coltext = TEXT-cmp.
        WHEN 'MATERIAL_VARIANTE'.
          <fs_es_catalogo>-coltext = TEXT-mvr.
          <fs_es_catalogo>-hotspot = abap_true.
        WHEN 'MATERIAL_GENERICO'.
          <fs_es_catalogo>-coltext = TEXT-mgl.
        WHEN 'MATERIAL_GENERICO_SAP'.
          <fs_es_catalogo>-coltext = TEXT-mgs.
          <fs_es_catalogo>-hotspot = abap_true.
      ENDCASE.

    ENDLOOP.

  ENDMETHOD.


  METHOD evento_hotspot.

    DATA: ti_bdcdata  TYPE TABLE OF bdcdata,
          material_lm TYPE matnr.

    ASSIGN gti_lista_infotint[ e_row_id-index ] TO FIELD-SYMBOL(<fs_es_infotint>).

    CHECK <fs_es_infotint> IS ASSIGNED.

    CASE e_column_id.
      WHEN 'MENSAJE'.

        CHECK <fs_es_infotint>-mensaje IS NOT INITIAL.

        visualizar_log( i_id_log = <fs_es_infotint>-mensaje ).
      WHEN 'MATERIAL_GENERICO_SAP' OR 'MATERIAL_VARIANTE'.

        material_lm = COND #( WHEN e_column_id = 'MATERIAL_GENERICO_SAP' THEN
                                <fs_es_infotint>-material_generico_sap
                              ELSE
                                <fs_es_infotint>-material_variante ).
        DATA(utilizacion) = VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ).

        SET PARAMETER ID 'MAT' FIELD material_lm.
        SET PARAMETER ID 'WRK' FIELD <fs_es_infotint>-centro.
        SET PARAMETER ID 'CSV' FIELD utilizacion.

        ti_bdcdata = VALUE #( ( program = 'SAPLCSDI' dynpro = '0100' dynbegin = abap_true )
                              ( fnam = 'BDC_CURSOR'  fval = 'RC29N-WERKS' )
                              ( fnam = 'RC29N-WERKS' fval = <fs_es_infotint>-centro )
                              ( fnam = 'BDC_CURSOR'  fval = 'RC29N-STLAN' )
                              ( fnam = 'RC29N-STLAN' fval = utilizacion )
                              ( fnam = 'BDC_CURSOR'  fval = 'RC29N-STLAL' )
                              ( fnam = 'RC29N-STLAL' fval = <fs_es_infotint>-alternativa_escala )
                            ).

        CALL TRANSACTION 'CS03'." USING ti_bdcdata.

    ENDCASE.

  ENDMETHOD.


  METHOD evento_tool_bar.

    INSERT VALUE #( function = '&PROC' icon  = icon_generate
                    text = TEXT-001 quickinfo = TEXT-001 )
    INTO e_object->mt_toolbar INDEX 1.

    INSERT VALUE #( function = '&&SEP01' butn_type = 3 )
    INTO e_object->mt_toolbar INDEX 2.

    INSERT VALUE #( function = '&MARCAR' icon  = icon_select_all )
    INTO e_object->mt_toolbar INDEX 3.

    INSERT VALUE #( function = '&DESMARCAR' icon  = icon_deselect_all )
    INTO e_object->mt_toolbar INDEX 4.

    MODIFY e_object->mt_toolbar
    FROM VALUE #( function = '&ACTUALIZAR' )
    TRANSPORTING function
    WHERE function = '&REFRESH'.

    DELETE e_object->mt_toolbar WHERE function = '&LOCAL&CUT'
                                   OR function = '&LOCAL&COPY'
                                   OR function = '&CHECK'
                                   OR function = '&LOCAL&PASTE'
                                   OR function = '&LOCAL&UNDO'
                                   OR function = '&&SEP00'
                                   OR function = '&&SEP02'
                                   OR function = '&LOCAL&APPEND'
                                   OR function = '&LOCAL&INSERT_ROW'
                                   OR function = '&LOCAL&DELETE_ROW'
                                   OR function = '&LOCAL&COPY_ROW'
                                   OR function = '&INFO'.

  ENDMETHOD.


  METHOD evento_user_comand.

    CASE e_ucomm.
      WHEN '&MARCAR'.

        LOOP AT gti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>)
                                   WHERE ind_actualizado NE gc_lista_material_ok.
          <fs_es_lista_infotint>-procesar = abap_true.
        ENDLOOP.

      WHEN '&DESMARCAR'.
        LOOP AT gti_lista_infotint ASSIGNING <fs_es_lista_infotint>.
          <fs_es_lista_infotint>-procesar = abap_false.
        ENDLOOP.
      WHEN '&ACTUALIZAR'.
        iniciar_tratamiento_infotint(
          EXPORTING
            i_r_centro                  = gr_centro
            i_r_fecha_envio             = gr_fecha_envio
            i_r_material_legado         = gr_material_legado
            i_r_material                = gr_material
            i_r_color                   = gr_color
            i_r_alternativa             = gr_alternativa_escala
            i_pendiente_procesar        = g_pendiente_procesar
            i_actualizar_registros      = abap_true
            i_r_indicador_actualizacion = gr_indicador_actualizacion ).
      WHEN '&PROC'.
        go_alv->check_changed_data( ).
        procesar_registros_infotint( ).
    ENDCASE.

    go_alv->refresh_table_display(
      EXPORTING
        is_stable      = VALUE #( row = abap_true
                                  col = abap_true )
        i_soft_refresh = abap_true
      EXCEPTIONS
        finished       = 1
        OTHERS         = 2 ).

  ENDMETHOD.


  METHOD evento_data_change.

    FIELD-SYMBOLS: <fs_ti_lista_infotint_mod> TYPE gtp_ti_lista_infotint.

    CHECK line_exists( er_data_changed->mt_mod_cells[ fieldname = 'PROCESAR' ] ).

    ASSIGN er_data_changed->mp_mod_rows->*
    TO <fs_ti_lista_infotint_mod>.

    LOOP AT <fs_ti_lista_infotint_mod> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_mod>)
                                       WHERE material_variante IS NOT INITIAL.

      IF <fs_es_lista_infotint_mod>-procesar = abap_true AND
      <fs_es_lista_infotint_mod>-ind_actualizado = gc_lista_material_ok.
        <fs_es_lista_infotint_mod>-procesar = abap_false.
      ENDIF.

      LOOP AT gti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>)
                                  WHERE centro = <fs_es_lista_infotint_mod>-centro
                                  AND   material_generico = <fs_es_lista_infotint_mod>-material_generico
                                  AND   color = <fs_es_lista_infotint_mod>-color
                                  AND   alternativa_escala = <fs_es_lista_infotint_mod>-alternativa_escala
                                  AND   material_variante IS NOT INITIAL.

        IF <fs_es_lista_infotint>-ind_actualizado NE gc_lista_material_ok.
          <fs_es_lista_infotint>-procesar = <fs_es_lista_infotint_mod>-procesar.
        ELSE.
          <fs_es_lista_infotint>-procesar = abap_false.
        ENDIF.

      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.


  METHOD evento_data_change_finish.

    CHECK line_exists( et_good_cells[ fieldname = 'PROCESAR' ] ).

    go_alv->refresh_table_display(
      EXPORTING
        is_stable = VALUE #( row = abap_true
                             col = abap_true )
      EXCEPTIONS
        finished  = 1
        OTHERS    = 2 ).

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

  ENDMETHOD.


  METHOD registrar_modificaciones.

    DATA: alternativa_escala  TYPE ztppi1209_1-alternativa_escala,
          estado_grupal       TYPE icon_d,
          r_material_variante TYPE RANGE OF mara-matnr.

    ejec_consistencia_lm_masivo(
      CHANGING
        c_ti_lista_infotint = c_ti_lista_infotint ).

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                          WHERE procesar = abap_true
                                          AND material_variante IS NOT INITIAL
                                          GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                                     material_generico = <fs_es_lista_infotint_gr>-material_generico
                                                     color = <fs_es_lista_infotint_gr>-color
                                                     alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      DATA(ti_numero_log) = go_log->guardar( i_id_log = get_id_log( <fs_es_lista_infotint_gr> ) ).
      e_es_log = VALUE #( ti_numero_log[ 1 ] OPTIONAL ).

      CLEAR: r_material_variante, estado_grupal.

      "Validar si existen variantes con error
      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>)
                                              WHERE variantes_sap NE space.

        SPLIT <fs_es_lista_infotint>-variantes_sap AT ';' INTO TABLE DATA(ti_variantes).
        r_material_variante = VALUE #( BASE r_material_variante FOR es_variante IN ti_variantes ( sign = 'I' option = 'EQ' low = es_variante ) ).

      ENDLOOP.

      DELETE r_material_variante WHERE low = space.

      "si existe un subgrupo en error, se debe asignar el ind_actualizado = 9 y estado warning
      IF r_material_variante IS NOT INITIAL.

        SORT r_material_variante BY low.
        DELETE ADJACENT DUPLICATES FROM r_material_variante COMPARING low.

        <fs_es_lista_infotint_gr>-variantes_sap =
          zclcxr1002_util=>ti_a_string(
          i_r_excluir_columnas         = VALUE #( sign = 'I' option = 'EQ'
                                                  ( low = 'SIGN' )
                                                  ( low = 'OPTION' )
                                                  ( low = 'HIGH' ) )
          i_ti                         = r_material_variante
          i_separador_como_salto_linea = abap_true ).

        <fs_es_lista_infotint_gr>-ind_actualizado = gc_lista_mat_en_error.
        "primero valida si alguna variante fue actualizada con exito
        IF line_exists( c_ti_lista_infotint[ KEY key_agrupador
                                             centro = <fs_es_lista_infotint_gr>-centro
                                             material_generico = <fs_es_lista_infotint_gr>-material_generico
                                             color = <fs_es_lista_infotint_gr>-color
                                             alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala
                                             estado = icon_green_light ] ).
          estado_grupal = icon_yellow_light.
        ELSE.
          estado_grupal = icon_red_light.
        ENDIF.
      ENDIF.

      alternativa_escala = shift_left( val = <fs_es_lista_infotint_gr>-alternativa_escala sub = '0' ).

      UPDATE ztppi1209_1
      SET mensaje =  e_es_log-extnumber
          ind_actualizado = <fs_es_lista_infotint_gr>-ind_actualizado
          variantes_sap = <fs_es_lista_infotint_gr>-variantes_sap
          fecha_actualizacion = sy-datum
          hora_actualizacion = sy-uzeit
          usuario_actualizacion = sy-uname
      WHERE centro = <fs_es_lista_infotint_gr>-centro
            AND material_generico = <fs_es_lista_infotint_gr>-material_generico
            AND color = <fs_es_lista_infotint_gr>-color
            AND alternativa_escala = alternativa_escala.

      COMMIT WORK AND WAIT.
      "Modificar valores generales
      MODIFY c_ti_lista_infotint
        USING KEY key_agrupador
        FROM VALUE #( variantes_sap = <fs_es_lista_infotint_gr>-variantes_sap
                      ind_actualizado = <fs_es_lista_infotint_gr>-ind_actualizado
                      mensaje =  e_es_log-extnumber
                      fecha_actualizacion = sy-datum hora_actualizacion = sy-uzeit usuario_actualizacion = sy-uname )
        TRANSPORTING variantes_sap mensaje ind_actualizado fecha_actualizacion
                     hora_actualizacion usuario_actualizacion
        WHERE centro = <fs_es_lista_infotint_gr>-centro
              AND material_generico = <fs_es_lista_infotint_gr>-material_generico
              AND color = <fs_es_lista_infotint_gr>-color
              AND alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala.

      "Modificar estado
      MODIFY c_ti_lista_infotint
      USING KEY key_agrupador
      FROM VALUE #( estado  = COND #( WHEN estado_grupal IS NOT INITIAL THEN estado_grupal ELSE <fs_es_lista_infotint_gr>-estado ) )
      TRANSPORTING estado
      WHERE centro = <fs_es_lista_infotint_gr>-centro
            AND material_variante NOT IN r_material_variante
            AND material_generico = <fs_es_lista_infotint_gr>-material_generico
            AND color = <fs_es_lista_infotint_gr>-color
            AND alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala.

    ENDLOOP.

    LOOP AT c_ti_lista_infotint ASSIGNING <fs_es_lista_infotint>
                                WHERE ind_actualizado = gc_lista_material_ok.
      <fs_es_lista_infotint>-procesar =  abap_false.
    ENDLOOP.

  ENDMETHOD.


  METHOD consultar_lista_material_db.

    CLEAR: e_ti_lista_material.

    CHECK i_ti_lista_infotint IS NOT INITIAL.

    SELECT
    FROM mast AS _lista_material
    LEFT JOIN stas AS _pos_lista_material ON
    _pos_lista_material~stlnr = _lista_material~stlnr
    AND _pos_lista_material~stlal = _lista_material~stlal
***    AND _pos_lista_material~lkenz = @space
    LEFT JOIN stko AS _lista_material_cab ON
    _lista_material_cab~stlnr = _pos_lista_material~stlnr
    AND _lista_material_cab~stlal = _pos_lista_material~stlal
    AND _pos_lista_material~stlkn = _pos_lista_material~stlkn
    LEFT JOIN stpo AS _lista_material_pos ON
    _lista_material_pos~stlnr = _pos_lista_material~stlnr
    AND _lista_material_pos~stlkn = _pos_lista_material~stlkn
***    AND _lista_material_pos~lkenz = @space
    LEFT JOIN mara AS _material ON
    _material~matnr = _lista_material_pos~idnrk
    FIELDS _lista_material~matnr, _lista_material~werks, mtart, _lista_material~stlan, _lista_material~stlal,
    _material~matnr AS material_lista, _material~mtart, idnrk AS componente, _lista_material_cab~bmeng, _lista_material_cab~stktx,
    postp, posnr, menge, _lista_material_pos~stlkn, stpoz, _lista_material_pos~stlnr, _lista_material_pos~datuv, fsh_vmkz,
    sanka AS rel_cost,
    _lista_material_pos~lkenz AS ind_borrado_stpo, _pos_lista_material~lkenz AS ind_borrado_stas
    FOR ALL ENTRIES IN @i_ti_lista_infotint
    WHERE _lista_material~matnr = @i_ti_lista_infotint-matnr
    AND _lista_material~werks   = @i_ti_lista_infotint-werks
    AND _lista_material~stlal   = @i_ti_lista_infotint-stlal
    INTO CORRESPONDING FIELDS OF TABLE @e_ti_lista_material.

  ENDMETHOD.


  METHOD consultar_lista_material.

    CLEAR: e_ultima_posicion.

    consultar_lista_material_db(
      EXPORTING
        i_ti_lista_infotint = i_ti_lista_infotint
      IMPORTING
        e_ti_lista_material = e_ti_lista_material ).

    SORT e_ti_lista_material BY werks matnr stlal posnr componente DESCENDING stlkn DESCENDING stpoz .

    e_es_lm_cabecera = CORRESPONDING #( VALUE #( e_ti_lista_material[ 1 ] OPTIONAL ) ).

    e_es_lm_cabecera-bmeng_no_decimal = e_es_lm_cabecera-bmeng.
    CONDENSE e_es_lm_cabecera-bmeng_no_decimal NO-GAPS.
    SPLIT e_es_lm_cabecera-bmeng_no_decimal AT '.' INTO TABLE DATA(ti_numero).

    IF ti_numero IS NOT INITIAL.

      CLEAR: e_es_lm_cabecera-bmeng_no_decimal.

      LOOP AT ti_numero INTO DATA(numero).
        IF sy-tabix = lines( ti_numero ) AND CONV i( numero ) IS INITIAL.
          CONTINUE.
        ENDIF.

        e_es_lm_cabecera-bmeng_no_decimal = |{ e_es_lm_cabecera-bmeng_no_decimal }.{ numero }|.

      ENDLOOP.

      REPLACE FIRST OCCURRENCE OF '.' IN e_es_lm_cabecera-bmeng_no_decimal WITH space.
      REPLACE ALL OCCURRENCES OF '.' IN e_es_lm_cabecera-bmeng_no_decimal WITH ','.
      CONDENSE e_es_lm_cabecera-bmeng_no_decimal NO-GAPS.
    ENDIF.

    "Ultima posicion de la lista, entendiendo que solo se envia UN material generico
    DATA(ti_lista_material) = e_ti_lista_material.
    DELETE ti_lista_material WHERE ind_borrado_stas NE space OR ind_borrado_stpo NE space.
    e_ultima_posicion = VALUE #( ti_lista_material[ lines( ti_lista_material ) ]-posnr OPTIONAL ).

    IF i_incluir_material_variante = abap_true.

      "Consultar variantes de generico
      SELECT werks, stlal, mara~matnr, satnr AS material_generico_sap
      FROM @i_ti_lista_infotint AS _lista_infotint
      INNER JOIN mara ON
      mara~satnr = _lista_infotint~matnr
      INTO TABLE @DATA(ti_variantes).

      consultar_lista_material_db(
        EXPORTING
          i_ti_lista_infotint = CORRESPONDING #( ti_variantes )
        IMPORTING
          e_ti_lista_material = e_ti_lm_variantes ).
    ENDIF.

    IF i_descartar_reg_eliminados = abap_true.
      DELETE e_ti_lista_material WHERE ind_borrado_stas NE space AND ind_borrado_stpo NE space.
      DELETE e_ti_lm_variantes WHERE ind_borrado_stas NE space AND ind_borrado_stpo NE space.
    ENDIF.

    IF i_solo_componentes_quimicos = abap_true.
      DELETE e_ti_lista_material WHERE mtart NOT IN gr_tipo_material_quimico.
      DELETE e_ti_lm_variantes WHERE mtart NOT IN gr_tipo_material_quimico.
    ENDIF.

  ENDMETHOD.


  METHOD visualizar_log.

    DATA: ti_bdcdata TYPE TABLE OF bdcdata.

    SET PARAMETER ID 'BALOBJ' FIELD 'ZPP_1'.
    SET PARAMETER ID 'BALSUBOBJ' FIELD 'ZR1157_1'.
    SET PARAMETER ID 'BALEXT' FIELD i_id_log.

    ti_bdcdata = VALUE #( ( program = 'SAPLSLG3' dynpro = '0100' dynbegin = abap_true )
                          ( fnam = 'BDC_CURSOR'  fval = 'BALHDR-ALDATE' )
                          ( fnam = 'BALHDR-ALDATE' fval = '01.01.2024' )
*                          ( fnam = 'BDC_OKCODE' fval = '=SELE' )
                          ).

    CALL TRANSACTION 'SLG1'
    USING ti_bdcdata.

  ENDMETHOD.


  METHOD consultar_componentes.

    CHECK i_ti_lista_infotint IS NOT INITIAL.

    SELECT componente, _centro_material~werks, _material~mtart, _material~lvorm AS peticion_borrado_mat
    FROM @i_ti_lista_infotint AS _lista_infotint
    INNER JOIN mara AS _material ON
    _material~matnr = _lista_infotint~componente
    LEFT JOIN marc AS _centro_material ON
    _centro_material~werks = _lista_infotint~centro
    AND _centro_material~matnr = _lista_infotint~componente
    INTO CORRESPONDING FIELDS OF TABLE @r_ti_componentes.

  ENDMETHOD.


  METHOD validar_bloqueo_usuario.

    DATA: ti_bloqueos_lista        TYPE STANDARD TABLE OF seqg3,
          ti_bloqueos_lista_pos    TYPE STANDARD TABLE OF seqg3,
          ti_bloqueos_material     TYPE STANDARD TABLE OF seqg3,
          contador_intento_bloqueo TYPE i.

    DO.
      CLEAR: ti_bloqueos_lista, ti_bloqueos_material, ti_bloqueos_lista_pos.

      CALL FUNCTION 'ENQUEUE_ECMASTE'
        EXPORTING
          mode_mast      = 'V'
          matnr          = i_es_lista_infotint-material_generico_sap
          werks          = i_es_lista_infotint-centro
          stlan          = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
          x_werks        = abap_true
        EXCEPTIONS
          foreign_lock   = 2
          system_failure = 3.

      IF  ( sy-subrc NE 2 )
      OR contador_intento_bloqueo > g_cantidad_intento_bloqueo.
        CALL FUNCTION 'DEQUEUE_ECMASTE'
          EXPORTING
            mode_mast = 'V'
            matnr     = i_es_lista_infotint-material_generico_sap
            werks     = i_es_lista_infotint-centro
            stlan     = CONV stlan( VALUE #( gr_utilizacion_lista_mat[ 1 ]-low OPTIONAL ) )
            x_werks   = abap_true.

        EXIT.
      ELSE.

        ADD 1 TO contador_intento_bloqueo.
        WAIT UP TO 1 SECONDS.

      ENDIF.

    ENDDO.

    IF contador_intento_bloqueo >= 1.
      go_log->set_es_log( i_es = VALUE #( type = 'S' number = '114' id = gc_clase_mensajes
                                              message_v1 = sy-uname
                                              message_v2 = contador_intento_bloqueo ) ).
    ENDIF.

  ENDMETHOD.


  METHOD get_id_log.

    IF g_cronomarcador_utc IS INITIAL.
      CONVERT DATE sy-datum TIME sy-uzeit
      INTO TIME STAMP g_cronomarcador_utc TIME ZONE gc_huso_horario.
    ENDIF.

    r_id_log =
    |{ i_es_lista_infotint-centro }{ shift_left( val = i_es_lista_infotint-material_generico sub = '0' ) }{ i_es_lista_infotint-color }{ i_es_lista_infotint-alternativa_escala }_{ shift_left( val =  |{ g_cronomarcador_utc }| sub = space ) }|.

  ENDMETHOD.


  METHOD ejec_consistencia_lm_masivo.

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                WHERE procesar = abap_true
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico_sap = <fs_es_lista_infotint_gr>-material_generico_sap
                                           alternativa_escala    = <fs_es_lista_infotint_gr>-alternativa_escala ).

      go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log      = VALUE #( object = gc_objecto subobject = gc_subobjecto )
                                                         i_identificador            = get_id_log( <fs_es_lista_infotint_gr> )
                                                       ).
      verificar_consistencia_lm(
        EXPORTING
          i_numero_proceso    = 5
        CHANGING
          c_es_lista_infotint = <fs_es_lista_infotint_gr>
          c_ti_lista_infotint = c_ti_lista_infotint ).

      DATA(ti_componente_x_variantes) =
        consolidar_componente_variante(
        EXPORTING
          i_es_lista_infotint = <fs_es_lista_infotint_gr>
          i_ti_lista_infotint = c_ti_lista_infotint ).

      DO 2 TIMES.
        DATA(numero_de_iteracion) = sy-index.

        leer_componentes_duplicados(
          EXPORTING
            i_ti_componente_x_variantes   = ti_componente_x_variantes
            i_es_lista_infotint           = <fs_es_lista_infotint_gr>
            i_incluir_todas_las_variantes = abap_true
          IMPORTING
            e_ti_variantes_duplicadas     = DATA(ti_variantes_duplicadas) ).

        IF ti_variantes_duplicadas IS NOT INITIAL.

          IF numero_de_iteracion = 1.
            verificar_consistencia_lm(
              EXPORTING
                i_numero_proceso          = 5
                i_tiempo_espera_extendido = abap_true
              CHANGING
                c_es_lista_infotint       = <fs_es_lista_infotint_gr>
                c_ti_lista_infotint       = c_ti_lista_infotint ).
          ELSE.
            go_log->set_es_log( i_es = VALUE #( type = 'W' number = '115' id = gc_clase_mensajes
                                                message_v1 = <fs_es_lista_infotint_gr>-material_generico_sap
                                                message_v2 = <fs_es_lista_infotint_gr>-color
                                                message_v3 = <fs_es_lista_infotint_gr>-alternativa_escala ) ).
          ENDIF.
        ELSE.
          EXIT.
        ENDIF.
      ENDDO.

    ENDLOOP.

  ENDMETHOD.


  METHOD ejecutar_consistencia_lm.

    DATA: r_material_generico          TYPE RANGE OF marc-matnr,
          r_centro                     TYPE RANGE OF marc-werks,
          contador_intento_bloqueo     TYPE i,
          job_finalizado               TYPE flag,
          numero_job                   TYPE tbtcjob-jobcount,
          nombre_job                   TYPE tbtcjob-jobname,
          gs_bom_constcy_chk_log_param TYPE if_rfm_pp_bom_consty_chk_commn=>ty_s_bom_constcy_chk_log_param,
          gt_matnr_selopt              TYPE rfm_pp_tt_selopt,
          gt_werks_selopt              TYPE rfm_pp_tt_selopt,
          go_mbom_constcy_chk_process  TYPE REF TO if_rfm_pp_mbom_consistency_chk.

    go_log->set_es_log( i_es = VALUE #( type = 'S' number = '007' id = 'CRMS4_IU_CM_PROCESS'
                                        message_v1 = TEXT-ir6 ) ).
    DATA(tiempo_espera_despues_r1096) = VALUE i( go_parametros->gti_parametros[ idparam = 'ESP_R1096' ]-low OPTIONAL ).

    IF i_tiempo_espera_extendido = abap_true.
      tiempo_espera_despues_r1096 = tiempo_espera_despues_r1096 * 2.
    ENDIF.

    cl_progress_indicator=>progress_indicate(
      EXPORTING
        i_msgid              = 'ZPP01'
        i_msgno              = '117'
        i_msgv1              = TEXT-ir6
        i_processed          = 2
        i_total              = g_cantidad_total_procesos
        i_output_immediately = abap_true ).

    validar_bloqueo_usuario( i_es_lista_infotint ).

    r_material_generico = VALUE #( sign = 'I' option = 'EQ' ( low = i_es_lista_infotint-material_generico_sap ) ).
    r_centro = VALUE #( sign = 'I' option = 'EQ' ( low = i_es_lista_infotint-centro ) ).

    go_mbom_constcy_chk_process = cl_rfm_pp_bom_maint_factory=>get_object( )->check_mbom_consistency( ) ##NEEDED.

    gs_bom_constcy_chk_log_param-log_active      = abap_true.
    gs_bom_constcy_chk_log_param-log_granularity = abap_true.
*    gs_bom_constcy_chk_log_param-log_validity    = abap_true.

    gt_matnr_selopt[] = r_material_generico.
    gt_werks_selopt[] = r_centro.

*    go_mbom_constcy_chk_process->fix_bom_inconsistencies(
*      EXPORTING
*        it_matnr_selopt              = gt_matnr_selopt
*        it_werks_selopt              = gt_werks_selopt
*        is_bom_consty_chk_log_params = gs_bom_constcy_chk_log_param ).

    WAIT UP TO tiempo_espera_despues_r1096 SECONDS.
    "El siguiente proceso se deja deshabilitado dado que la R1156 por estrategia de rendimiento se decidio hacer sobre el mimos proceso de trabajo
    "En caso de requerir ejecutar en FONDO, solo se debe comentar la linea del RETURN y comentar los llamados anteriores
    RETURN.
    nombre_job = |{ i_nombre_job }|.

    CALL FUNCTION 'JOB_OPEN'
      EXPORTING
        jobname          = nombre_job
      IMPORTING
        jobcount         = numero_job
      EXCEPTIONS
        cant_create_job  = 1
        invalid_job_data = 2
        jobname_missing  = 3
        OTHERS           = 4.
    IF sy-subrc = 0.

      SUBMIT rfm_pp_bom_consistency_check
       WITH p_matnr IN r_material_generico
       WITH p_werks IN r_centro
       WITH p_fixbom = abap_true
       WITH p_dislog = abap_true
       WITH p_log    = abap_true
       WITH p_gralog = '0'
*       WITH P_PPROC = abap_true
       VIA JOB nombre_job NUMBER numero_job
       AND RETURN.

      IF sy-subrc = 0.
        CALL FUNCTION 'JOB_CLOSE'
          EXPORTING
            jobcount             = numero_job
            jobname              = nombre_job
            strtimmed            = 'X'
          EXCEPTIONS
            cant_start_immediate = 1
            invalid_startdate    = 2
            jobname_missing      = 3
            job_close_failed     = 4
            job_nosteps          = 5
            job_notex            = 6
            lock_failed          = 7
            OTHERS               = 8.

        IF sy-subrc <> 0.

        ENDIF.
        "Esperar que el JOB termine
        DO.

          CALL FUNCTION 'SHOW_JOBSTATE'
            EXPORTING
              jobcount         = numero_job
              jobname          = nombre_job
            IMPORTING
              finished         = job_finalizado
            EXCEPTIONS
              jobcount_missing = 1
              jobname_missing  = 2
              job_notex        = 3
              OTHERS           = 4.

          IF sy-subrc <> 0 OR job_finalizado = abap_true
          OR contador_intento_bloqueo > g_cantidad_intento_bloqueo.
            EXIT.
          ELSE.
            WAIT UP TO 1 SECONDS.
            ADD 1 TO contador_intento_bloqueo.
          ENDIF.

        ENDDO.

      ELSE.
        DATA(msg) = cl_abap_submit_handling=>get_error_message( ).
        MESSAGE ID msg-msgid
                TYPE 'I'
                NUMBER msg-msgno
                WITH msg-msgv1 msg-msgv2 msg-msgv3 msg-msgv4
                DISPLAY LIKE msg-msgty.
      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD asignar_variante_sap.

    c_es_lista_infotint-variantes_sap = |{ c_es_lista_infotint-variantes_sap };{ c_es_lista_infotint-material_variante }|.

  ENDMETHOD.


  METHOD generar_fecha.
    r_fecha = |{ i_fecha+6(2) }.{ i_fecha+4(2) }.{ i_fecha(4) }|.
  ENDMETHOD.


  METHOD ejecutar_proeso_agrupado_job.

    DATA: r_material_generico      TYPE RANGE OF marc-matnr,
          r_material_legado        TYPE gtp_r_material,
          r_centro                 TYPE RANGE OF marc-werks,
          contador_intento_bloqueo TYPE i,
          job_finalizado           TYPE flag,
          job_abortado             TYPE flag,
          job_preliminar           TYPE flag,
          job_listo                TYPE flag,
          job_en_ejecucion         TYPE flag,
          job_programado           TYPE flag,
          job_suspendido           TYPE flag,
          job_otros                TYPE flag,
          numero_job               TYPE tbtcjob-jobcount,
          nombre_job               TYPE tbtcjob-jobname,
          r_colores                TYPE RANGE OF ztppi1209_1-color,
          colores                  TYPE string,
          r_alternativa            TYPE RANGE OF ztppi1209_1-alternativa_escala,
          cantidad_colores_x_job   TYPE i,
          cantidad_total_procesos  TYPE i,
          contador_proceso_actual  TYPE i,
          contador_colores         TYPE i.

    go_parametros = NEW zclcxr1000_parametros(
      i_modulo = gc_modulo
      i_ricefw = gc_ricefw ).

    cantidad_colores_x_job = VALUE #( go_parametros->gti_parametros[ idparam = 'CANT_COLJOB' ]-low OPTIONAL ).

    IF cantidad_colores_x_job IS INITIAL.
      cantidad_colores_x_job = 1.
    ENDIF.

    "Crear un JOB por centro/material generica/alternativa
    LOOP AT c_ti_lista_infotint REFERENCE INTO DATA(r_es_lm_gr)
                                WHERE ind_actualizado NE gc_lista_material_ok
                                GROUP BY ( centro = r_es_lm_gr->centro
                                           material_generico_sap = r_es_lm_gr->material_generico_sap
                                           alternativa_escala = r_es_lm_gr->alternativa_escala ).

      CLEAR: cantidad_total_procesos, contador_proceso_actual, contador_colores.
      "Cantidad de colores por grupo
      LOOP AT GROUP r_es_lm_gr REFERENCE INTO DATA(r_es_lm)
                               GROUP BY ( color = r_es_lm->color ).
        ADD 1 TO cantidad_total_procesos.
      ENDLOOP.

      LOOP AT GROUP r_es_lm_gr REFERENCE INTO r_es_lm
                               GROUP BY ( color = r_es_lm->color ).

        ADD 1 TO contador_colores.
        APPEND VALUE #( sign = 'I' option = 'EQ' low = r_es_lm->color ) TO r_colores.
        colores = colores && r_es_lm->color.

        DATA(residuo) = contador_colores MOD cantidad_colores_x_job.
        "Lanzar JOB cada que se cumpla el numero de colores a procesar en el parametro CANT_COLJOB
        IF residuo = 0 OR ( cantidad_total_procesos <= contador_colores ).

          CLEAR: contador_intento_bloqueo, job_finalizado.

          r_material_generico = VALUE #( sign = 'I' option = 'EQ' ( low = r_es_lm_gr->material_generico_sap ) ).
          r_material_legado = VALUE #( sign = 'I' option = 'EQ' ( low = r_es_lm_gr->material_generico ) ).
          r_centro = VALUE #( sign = 'I' option = 'EQ' ( low = r_es_lm_gr->centro ) ).
          r_alternativa = VALUE #( sign = 'I' option = 'EQ' ( low = shift_left( val = CONV i( r_es_lm_gr->alternativa_escala ) ) ) ).

          nombre_job = |ZPPR1157_{ r_es_lm_gr->material_generico_sap }{ r_es_lm_gr->alternativa_escala }_{ colores }|.

          ADD 1 TO contador_proceso_actual.

          CALL FUNCTION 'JOB_OPEN'
            EXPORTING
              jobname          = nombre_job
            IMPORTING
              jobcount         = numero_job
            EXCEPTIONS
              cant_create_job  = 1
              invalid_job_data = 2
              jobname_missing  = 3
              OTHERS           = 4.

          IF sy-subrc = 0.

            SUBMIT zppr1157_1
             WITH so_matnr IN r_material_generico
             WITH so_centr IN r_centro
             WITH so_fenvi IN i_r_fecha_envio
             WITH so_color IN r_colores
             WITH so_alter IN r_alternativa
             WITH pa_ppent = abap_true
             VIA JOB nombre_job NUMBER numero_job
             AND RETURN.

            IF sy-subrc = 0.
              CALL FUNCTION 'JOB_CLOSE'
                EXPORTING
                  jobcount             = numero_job
                  jobname              = nombre_job
                  strtimmed            = 'X'
                EXCEPTIONS
                  cant_start_immediate = 1
                  invalid_startdate    = 2
                  jobname_missing      = 3
                  job_close_failed     = 4
                  job_nosteps          = 5
                  job_notex            = 6
                  lock_failed          = 7
                  OTHERS               = 8.

              IF sy-subrc IS INITIAL.
                cl_progress_indicator=>progress_indicate(
                  EXPORTING
                    i_msgid              = 'ZPP01'
                    i_msgno              = '117'
                    i_msgv1              = |{ r_es_lm_gr->material_generico_sap }{ r_es_lm_gr->alternativa_escala }|
                    i_msgv2              = |_{ colores }|
                    i_processed          = contador_proceso_actual
                    i_total              = cantidad_total_procesos
                    i_output_immediately = abap_true ).
              ENDIF.

              DO.
                "Esperar que el JOB termine
                CALL FUNCTION 'SHOW_JOBSTATE'
                  EXPORTING
                    jobcount         = numero_job
                    jobname          = nombre_job
                  IMPORTING
                    aborted          = job_abortado
                    finished         = job_finalizado
                    preliminary      = job_preliminar
                    ready            = job_listo
                    running          = job_en_ejecucion
                    scheduled        = job_programado
                    suspended        = job_suspendido
                    other            = job_otros
                  EXCEPTIONS
                    jobcount_missing = 1
                    jobname_missing  = 2
                    job_notex        = 3
                    OTHERS           = 4.

                IF sy-subrc <> 0
                OR job_finalizado = abap_true
                OR job_abortado = abap_true
                OR job_preliminar = abap_true
                OR ( job_listo = abap_false AND job_en_ejecucion = abap_false )
                OR job_programado = abap_true
                OR job_suspendido = abap_true
                OR job_otros = abap_true
                OR contador_intento_bloqueo > 2400. "Esperar hasta 1 horas

                  EXIT.
                ELSE.
                  WAIT UP TO 1 SECONDS.
                  ADD 1 TO contador_intento_bloqueo.
                ENDIF.

              ENDDO.

            ELSE.
              DATA(msg) = cl_abap_submit_handling=>get_error_message( ).
              MESSAGE ID msg-msgid
                      TYPE 'I'
                      NUMBER msg-msgno
                      WITH msg-msgv1 msg-msgv2 msg-msgv3 msg-msgv4
                      DISPLAY LIKE msg-msgty.
            ENDIF.
          ENDIF.

          CLEAR: r_colores, colores.

        ENDIF.
      ENDLOOP.
    ENDLOOP.

  ENDMETHOD.


  METHOD consolidar_componente_variante.

    LOOP AT i_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                  WHERE  centro = i_es_lista_infotint-centro
                                     AND material_generico_sap = i_es_lista_infotint-material_generico_sap
                                     AND alternativa_escala    = i_es_lista_infotint-alternativa_escala
                                     AND procesar              = i_indicador_procesar
                                  GROUP BY <fs_es_lista_infotint_gr>-componente.

      APPEND INITIAL LINE TO r_ti_componente_x_variantes ASSIGNING FIELD-SYMBOL(<fs_es_comente_x_variantes>).

      <fs_es_comente_x_variantes>-componente = <fs_es_lista_infotint_gr>-componente.

      LOOP AT GROUP <fs_es_lista_infotint_gr> ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint>).
        APPEND VALUE #( sign = 'I' option = 'EQ' low = <fs_es_lista_infotint>-material_variante )
        TO <fs_es_comente_x_variantes>-r_variantes.
      ENDLOOP.

      SORT <fs_es_comente_x_variantes>-r_variantes BY low.
      DELETE ADJACENT DUPLICATES FROM <fs_es_comente_x_variantes>-r_variantes COMPARING low.

    ENDLOOP.

  ENDMETHOD.


  METHOD visualizar_lm_con_duplicados.

    TYPES: BEGIN OF tp_es_duplicadas,
             alternativa_escala    TYPE ztppi1209_1-alternativa_escala,
             material_generico_sap TYPE zed_materialgenerico_sap.
             INCLUDE TYPE fsh_s_bomvd_api.
    TYPES:
           END OF tp_es_duplicadas,

           tp_ti_duplicadas TYPE STANDARD TABLE OF tp_es_duplicadas WITH EMPTY KEY.

    DATA: ti_variantes_duplicadas TYPE tp_ti_duplicadas.

    LOOP AT c_ti_lista_infotint ASSIGNING FIELD-SYMBOL(<fs_es_lista_infotint_gr>)
                                GROUP BY ( centro = <fs_es_lista_infotint_gr>-centro
                                           material_generico = <fs_es_lista_infotint_gr>-material_generico
                                           alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala ).

      DATA(ti_componente_x_variantes) =
        consolidar_componente_variante(
        EXPORTING
          i_indicador_procesar = abap_false
          i_es_lista_infotint  = <fs_es_lista_infotint_gr>
          i_ti_lista_infotint  = c_ti_lista_infotint ).

      leer_componentes_duplicados(
        EXPORTING
          i_ti_componente_x_variantes   = ti_componente_x_variantes
          i_es_lista_infotint           = <fs_es_lista_infotint_gr>
          i_incluir_todas_las_variantes = abap_true
        IMPORTING
          e_ti_variantes_duplicadas     = DATA(ti_duplicados) ).

      APPEND LINES OF CORRESPONDING tp_ti_duplicadas( ti_duplicados ) TO ti_variantes_duplicadas.

      MODIFY ti_variantes_duplicadas
      FROM VALUE #( alternativa_escala = <fs_es_lista_infotint_gr>-alternativa_escala material_generico_sap = <fs_es_lista_infotint_gr>-material_generico_sap )
      TRANSPORTING alternativa_escala material_generico_sap
      WHERE material_generico_sap IS INITIAL.

    ENDLOOP.

    CALL FUNCTION 'ZCXR1002_MOSTRARALV_01'
      EXPORTING
        i_ti_datos = REF #( ti_variantes_duplicadas )
        i_titulo   = TEXT-tdp.

  ENDMETHOD.
ENDCLASS.