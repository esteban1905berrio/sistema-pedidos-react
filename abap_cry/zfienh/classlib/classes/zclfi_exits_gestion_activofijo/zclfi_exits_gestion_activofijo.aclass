CLASS zclfi_exits_gestion_activofijo DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES if_badi_interface .
    INTERFACES if_faa_general_services .

    CLASS-METHODS:
      modificar_idoc_activo_fijo
        CHANGING
          c_ti_datos_idoc TYPE edidd_tt,

      sustituir_digitos_activos
