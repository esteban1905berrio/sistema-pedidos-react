                                                                 i_tcode         = i_tcode
                                                                 i_ti_bkpf       = i_ti_bkpf
                                                       CHANGING  c_ti_bseg       = c_ti_bseg
                                                                 c_ti_bseg_subst = c_ti_bseg_subst
                                                                 c_ti_bsec       = c_ti_bsec ).

  ENDMETHOD.


