                                                                 i_blart         = i_blart
                                                                 i_tcode         = i_tcode
                                                                 i_ti_bkpf       = i_ti_bkpf
                                                       CHANGING  c_ti_bseg       = c_ti_bseg
                                                                 c_ti_bseg_subst = c_ti_bseg_subst
                                                                 c_ti_bsec       = c_ti_bsec ).

  ENDMETHOD.


  METHOD sustituir_xblnr.

    zclfie1002_val_xref1_xref3=>sustituir_xblnr(
      EXPORTING
        i_ti_bkpf    = i_ti_bkpf
        i_ti_bseg    = i_ti_bseg
      CHANGING
        c_ti_bkpfsub = c_ti_bkpfsub ).

  ENDMETHOD.


  METHOD validacion_xblnr_por_proveedor.

    zclfie1045_validar_referencia=>validacion_xblnr_por_proveedor( i_lifnr = i_lifnr i_xblnr = i_xblnr i_blart = i_blart ).

  ENDMETHOD.


  METHOD sustituir_textos_bseg.

    zclfie1002_val_xref1_xref3=>sustituir_textos_bseg(
      EXPORTING
        i_ti_bkpf       = i_ti_bkpf
      CHANGING
        c_ti_bseg       = c_ti_bseg
        c_ti_bseg_subst = c_ti_bseg_subst
*       c_ti_bsec       =
    ).
  ENDMETHOD.


  METHOD sustituir_xref1_xref3_compensa.

    zclfie1002_val_xref1_xref3=>sustituir_xref1_xref3_compensa(
      EXPORTING
        i_ti_bkpf       = i_ti_bkpf[]       " Standard Table Type for BKPF
      CHANGING
        c_ti_bseg_subst = c_ti_bseg_subst[] " Table Type BSEG_SUBST
    ).

  ENDMETHOD.


  METHOD if_ex_ac_document~change_after_check.
    "Asignacion necesaria para que no se limpie el campo BKTXT
    ex_document-header-bktxt = im_document-header-bktxt.
  ENDMETHOD.


  METHOD if_ex_ac_document~change_initial.

    "Asignacion necesaria para que no se limpie el campo BKTXT
    ex_document-header-bktxt = im_document-header-bktxt.

    zclfie1007_contabiliza_wpufib=>modificar_oper_empresarial(
      EXPORTING
        i_es_documento = im_document
      IMPORTING
        e_es_documento = ex_document ).

  ENDMETHOD.


  METHOD if_ex_ac_document~is_acctit_relevant.

  ENDMETHOD.


  METHOD if_ex_ac_document~is_compression_required.

  ENDMETHOD.


  METHOD if_ex_ac_document~is_suppressed_acct.

  ENDMETHOD.


  METHOD sustituir_cuenta_contable.
**********************************************************************
*NOTA: Se mueve a la sustitucion de FI (transacción GGB1 y a nivel de posición
*      de documento se crea una nueva sustitución HKONT y dentro un nuevo paso
*      con el campo BSEG-HKONT que se llamara a la función U100), esto debido a
*      que cuando se cambia aca la BSEG descarta los campbios luego de salir de la BTE
**********************************************************************
    zclfie1098_sust_cuenta_contabl=>sustituir_cuenta_contable(
      EXPORTING
        i_ti_bkpf       = i_ti_bkpf[]       " Standard Table Type for BKPF
      CHANGING
        c_ti_bseg       = c_ti_bseg[]       " Table Type BSEG
        c_ti_bseg_subst = c_ti_bseg_subst[] " Table Type BSEG_SUBST
    ).

  ENDMETHOD.
ENDCLASS.
