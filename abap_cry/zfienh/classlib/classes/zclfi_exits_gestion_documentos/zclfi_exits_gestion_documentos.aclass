                                                                 i_blart         = i_blart
                                                                 i_tcode         = i_tcode
                                                       CHANGING  c_ti_bseg_subst = c_ti_bseg_subst[]
                                                                 c_ti_bseg       = c_ti_bseg[]
                                                                 c_ti_bkpf_subst = c_ti_bkpf_subst[] "EFB 20.10.2021
                                                                 c_ti_bkpf       = c_ti_bkpf[] ). "EFB 20.10.2021

  ENDMETHOD.


  METHOD homologar_idoc_entrada_fidcc2.

    zclfii1008_integracion_afs=>homologar_idoc_entrada_fidcc2(
