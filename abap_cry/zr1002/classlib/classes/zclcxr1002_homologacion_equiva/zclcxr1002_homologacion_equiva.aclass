  methods APLICAR_EQUIVALENCIAS
    importing
      !I_C_AMBITO type ZEDAMBITO optional
    exporting
      !E_TI_RETURN type BAPIRET2_TAB
    changing
      !C_O_OBJ type ref to OBJECT .
protected section.
private section.

  methods GET_PARAMETERS
    importing
      !I_C_RICEFW type ZZEDRICEFW default 'R1002'
