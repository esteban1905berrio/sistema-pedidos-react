class ZCLCXR1002_HOMOLOGACION_EQUIVA definition
  public
  final
  create public .

public section.

  types:
    BEGIN OF g_tp_parametros,
        separador TYPE char1,
      END OF g_tp_parametros .

  data G_ES_PARAMETROS type G_TP_PARAMETROS .
  data GTI_ZTCXR1002_1 type ZTTCXR1002_1 .
  constants GC_000 type SYMSGNO value '000' ##NO_TEXT.
  constants GC_005 type SYMSGNO value '005' ##NO_TEXT.
  constants GC_E type CHAR1 value 'E' ##NO_TEXT.
  constants GC_ZCX01 type SYMSGID value 'ZCX01' ##NO_TEXT.
  constants GC_ZMM01 type SYMSGID value 'ZMM01' ##NO_TEXT.
  constants GC_S type CHAR1 value 'S' ##NO_TEXT.
  constants GC_W type CHAR1 value 'W' ##NO_TEXT.
  constants GC_X type CHAR1 value 'X' ##NO_TEXT.

  methods CONSTRUCTOR
    importing
      !I_C_RICEFW_PARAM type ZZEDRICEFW default 'R1002'
      !I_C_MODULO type ZZEDMODULO default 'CX'
      !I_C_RICEFW type ZZEDRICEFW .
  methods GET_DATA
    importing
      !I_C_RICEFW type ZZEDRICEFW .
  methods APLICAR_EQUIVALENCIAS
    importing
      !I_C_AMBITO type ZEDAMBITO optional
    exporting
      !E_TI_RETURN type BAPIRET2_TAB
    changing
      !C_O_OBJ type ref to OBJECT .
protected section.
private section.

  methods GET_PARAMETERS
    importing
      !I_C_RICEFW type ZZEDRICEFW default 'R1002'
      !I_C_MODULO type ZZEDMODULO default 'CX' .
ENDCLASS.



CLASS ZCLCXR1002_HOMOLOGACION_EQUIVA IMPLEMENTATION.


  METHOD aplicar_equivalencias.

*----------------------------------------------------------------------*
*                       Definiciòn Constantes
*----------------------------------------------------------------------*
    CONSTANTS:
                c_asterisco TYPE char1 VALUE '*'.

*----------------------------------------------------------------------*
*                       Definiciòn Tablas
*----------------------------------------------------------------------*
    DATA:
          ti_split_valor TYPE STANDARD TABLE OF string.

*----------------------------------------------------------------------*
*                       Definiciòn Estruturas
*----------------------------------------------------------------------*
    DATA:
      es_ztcxr1002_1 TYPE ztcxr1002_1,
      es_split_valor LIKE LINE OF ti_split_valor.

*----------------------------------------------------------------------*
*                       Definiciòn Variables
*----------------------------------------------------------------------*
    DATA:
      message        TYPE bapi_msg,
      index          TYPE i,
      error          TYPE char1,
      out_conversion TYPE char255,
      valor_origen   TYPE string.

*    DATA:
*          o_obj TYPE REF TO data.

*----------------------------------------------------------------------*
*                       Definiciòn field Symbol
*----------------------------------------------------------------------*
    FIELD-SYMBOLS:
      <l_fs_campo>         TYPE any,
      <l_fs_campo_origen>  TYPE any,
      <l_fs_campo_destino> TYPE any.

*    o_obj ?= c_o_obj.
*get REFERENCE OF c_o_obj into o_obj.
*ASSIGN c_o_obj->* TO <l_fs_campo>.

    "Leer el index
    READ TABLE gti_ztcxr1002_1
      WITH KEY ambito = i_c_ambito
      BINARY SEARCH TRANSPORTING NO FIELDS.
    IF sy-subrc EQ 0.
      index = sy-tabix.
    ELSE.
      index = 0.
    ENDIF.
    "Recorrer todas las equivalencias para el ambito indicado
    LOOP AT gti_ztcxr1002_1 INTO es_ztcxr1002_1 FROM index.
      IF i_c_ambito IS NOT INITIAL.
        IF es_ztcxr1002_1-ambito NE i_c_ambito.
          EXIT.
        ENDIF.
      ENDIF.

      CLEAR:
             ti_split_valor,
             valor_origen.

      "Se verifica SPLIT en la equivalencia
      SPLIT es_ztcxr1002_1-var_origen    AT  g_es_parametros-separador INTO TABLE ti_split_valor.

      IF lines( ti_split_valor ) GT 1.
        CLEAR error.
        "Recorrer todas las cairables que componen el valor Origen
        LOOP AT ti_split_valor INTO es_split_valor.
          IF <l_fs_campo_origen> IS ASSIGNED.
            UNASSIGN <l_fs_campo_origen>.
          ENDIF.
          "Cuando se envia * es para que aplique para todos los valores
          IF es_split_valor NE c_asterisco.
            ASSIGN c_o_obj->(es_split_valor)  TO <l_fs_campo_origen>.
            IF <l_fs_campo_origen> IS NOT ASSIGNED.
              "Error de asignacion
              error = gc_x.
              "Regla Equivalencias RICEFW: &1 Consecutivo: &2, &3. &4
              MESSAGE i005(zmm01) INTO message WITH es_ztcxr1002_1-ricefw es_ztcxr1002_1-consecutivo TEXT-m01 TEXT-m02.
              APPEND VALUE bapiret2(
              type        = gc_w
              id          = gc_zmm01
              number      = gc_005
              message     = message
              message_v1  = es_ztcxr1002_1-ricefw
              message_v2  = es_ztcxr1002_1-consecutivo
              message_v3  = TEXT-m01 "Campo Origen NO Valido
              message_v4  = TEXT-m02 "Validar Equivalencia!!
              ) TO e_ti_return.
              EXIT.
            ENDIF.
            IF <l_fs_campo_origen> IS ASSIGNED.
              "Ejecutar a formato de salida en caso de que aplique
              WRITE <l_fs_campo_origen> TO out_conversion.
            ENDIF.
          ELSE.
            out_conversion = c_asterisco.
          ENDIF.
*          "Evaluar si necesita conversion a formato de salida
*          IF <l_fs_campo_origen> IS ASSIGNED    AND
*             <l_fs_campo_origen> IS NOT INITIAL AND
*             <l_fs_campo_origen>(1) = '0'.
*            CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*              EXPORTING
*                input  = <l_fs_campo_origen>
*              IMPORTING
*                output = out_conversion.
*          ELSE.
*            out_conversion = <l_fs_campo_origen>.
*          ENDIF.

          "Consutrir el valor de salida con el valor de la variables
          IF valor_origen IS INITIAL.
            valor_origen = out_conversion.
          ELSE.
            CONCATENATE valor_origen
                        out_conversion
                   INTO valor_origen
              SEPARATED BY g_es_parametros-separador.
          ENDIF.
        ENDLOOP.
        "Si hay error Continar con el registro siguiente
        IF error EQ gc_x.
          CONTINUE.
        ENDIF.
      ELSE.
        IF <l_fs_campo_origen> IS ASSIGNED.
          UNASSIGN <l_fs_campo_origen>.
        ENDIF.

        "Cuando se envia * es para que aplique para todos los valores
        IF es_ztcxr1002_1-var_origen NE c_asterisco.
          ASSIGN c_o_obj->(es_ztcxr1002_1-var_origen) TO <l_fs_campo_origen>.
          IF <l_fs_campo_origen> IS NOT ASSIGNED.
            "Error de asignacion
            "Regla Equivalencias RICEFW: &1 Consecutivo: &2, &3. &4
            MESSAGE i005(zmm01) INTO message WITH es_ztcxr1002_1-ricefw es_ztcxr1002_1-consecutivo TEXT-m01 TEXT-m02.
            APPEND VALUE bapiret2(
            type        = gc_w
            id          = gc_zmm01
            number      = gc_005
            message     = message
            message_v1  = es_ztcxr1002_1-ricefw
            message_v2  = es_ztcxr1002_1-consecutivo
            message_v3  = TEXT-m01 "Campo Origen NO Valido
            message_v4  = TEXT-m02 "Validar Equivalencia!!
            ) TO e_ti_return.
            CONTINUE.
          ENDIF.
          IF <l_fs_campo_origen> IS ASSIGNED.
            "Ejecutar a formato de salida en caso de que aplique
            WRITE <l_fs_campo_origen> TO out_conversion.
          ENDIF.
        ELSE.
          out_conversion = c_asterisco.
        ENDIF.
*        "Evaluar si necesita conversion a formato de salida
*        IF <l_fs_campo_origen> IS ASSIGNED    AND
*           <l_fs_campo_origen> IS NOT INITIAL AND
*           <l_fs_campo_origen>(1) = '0'.
*          CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*            EXPORTING
*              input  = <l_fs_campo_origen>
*            IMPORTING
*              output = out_conversion.
*        ELSE.
*          out_conversion = <l_fs_campo_origen>.
*        ENDIF.

        IF valor_origen IS INITIAL.
          valor_origen = out_conversion.
        ELSE.
          CONCATENATE valor_origen
                      out_conversion
                 INTO valor_origen
            SEPARATED BY g_es_parametros-separador.
        ENDIF.
      ENDIF.

      "Evaluar el valor resultante de las variables VS el Valor Configurado para la Homologacion/Equivalencia
      IF c_asterisco  EQ valor_origen OR "Si es el comodin o si cumple el valor de la condicion
         valor_origen EQ es_ztcxr1002_1-val_origen .
        IF <l_fs_campo_destino> IS ASSIGNED.
          UNASSIGN <l_fs_campo_destino>.
        ENDIF.
        "Asignar la Variable destino
        ASSIGN c_o_obj->(es_ztcxr1002_1-var_destino) TO <l_fs_campo_destino>.
        IF <l_fs_campo_destino> IS ASSIGNED.
          <l_fs_campo_destino> = es_ztcxr1002_1-val_destino.
        ELSE.
          "Error de Asignacion
          "Regla Equivalencias RICEFW: &1 Consecutivo: &2, &3. &4
          MESSAGE i005(zmm01) INTO message WITH es_ztcxr1002_1-ricefw es_ztcxr1002_1-consecutivo TEXT-m03 TEXT-m02.
          APPEND VALUE bapiret2(
          type        = gc_w
          id          = gc_zmm01
          number      = gc_005
          message     = message
          message_v1  = es_ztcxr1002_1-ricefw
          message_v2  = es_ztcxr1002_1-consecutivo
          message_v3  = TEXT-m03 "Campo Destino NO Valido
          message_v4  = TEXT-m02 "Validar Equivalencia!!
          ) TO e_ti_return.
          CONTINUE.
        ENDIF.
      ENDIF.

    ENDLOOP.

*    c_o_obj = o_obj.

  ENDMETHOD.


  METHOD constructor.

    "Obtener parametros de Aplicacion
    CALL METHOD me->get_parameters
      EXPORTING
        i_c_ricefw = i_c_ricefw_param
        i_c_modulo = i_c_modulo.

    "Obtener datos
    CALL METHOD me->get_data
      EXPORTING
        i_c_ricefw = i_c_ricefw.

  ENDMETHOD.


  METHOD get_data.

    "Consultar tabla de Homologaciones/Equivalencias
    SELECT mandt, ricefw, consecutivo, ambito, var_origen, val_origen, var_destino, val_destino
      FROM ztcxr1002_1
     WHERE ricefw = @i_c_ricefw
       AND inact  = @space
      INTO TABLE @gti_ztcxr1002_1.
    IF sy-subrc EQ 0.
      "Se descarta el RICEFW puesto que por cada proceso es obligatorio enviar el RICEFW
      SORT gti_ztcxr1002_1 BY ambito consecutivo.
    ENDIF.

  ENDMETHOD.


  METHOD get_parameters.

*----------------------------------------------------------------------*
* Definición de constantes
*----------------------------------------------------------------------*
    CONSTANTS:
      l_cte_separador    TYPE ztcxr1000_1-idparam VALUE 'SEPARADOR'.


*----------------------------------------------------------------------*
* Definición de Variables
*----------------------------------------------------------------------*
    DATA:
     l_ra_comodin TYPE RANGE OF char1.


    ".Instancia Constructor
    DATA(l_o_parametros) = NEW zclcxr1000_parametros( i_modulo = i_c_modulo
                                                      i_ricefw = i_c_ricefw ).


    "Caracter SPLIT
    l_o_parametros->get_parametro( EXPORTING i_idparam     = l_cte_separador
                                   IMPORTING e_ti_valrango = l_ra_comodin
                                   EXCEPTIONS
                                    parametro_no_encontrado = 1 ).

    IF line_exists( l_ra_comodin[ 1 ] ).
      g_es_parametros-separador = l_ra_comodin[ 1 ]-low.
    ENDIF.

  ENDMETHOD.
ENDCLASS.
