          CONTINUE.
        ENDIF.
      ENDIF.

    ENDLOOP.

*    c_o_obj = o_obj.

  ENDMETHOD.


  METHOD constructor.

    "Obtener parametros de Aplicacion
    CALL METHOD me->get_parameters
      EXPORTING
        i_c_ricefw = i_c_ricefw_param
        i_c_modulo = i_c_modulo.

    "Obtener datos
    CALL METHOD me->get_data
      EXPORTING
        i_c_ricefw = i_c_ricefw.

  ENDMETHOD.


  METHOD get_data.

    "Consultar tabla de Homologaciones/Equivalencias
    SELECT mandt, ricefw, consecutivo, ambito, var_origen, val_origen, var_destino, val_destino
      FROM ztcxr1002_1
     WHERE ricefw = @i_c_ricefw
       AND inact  = @space
      INTO TABLE @gti_ztcxr1002_1.
    IF sy-subrc EQ 0.
      "Se descarta el RICEFW puesto que por cada proceso es obligatorio enviar el RICEFW
      SORT gti_ztcxr1002_1 BY ambito consecutivo.
    ENDIF.

  ENDMETHOD.


  METHOD get_parameters.

*----------------------------------------------------------------------*
* Definición de constantes
*----------------------------------------------------------------------*
    CONSTANTS:
      l_cte_separador    TYPE ztcxr1000_1-idparam VALUE 'SEPARADOR'.


*----------------------------------------------------------------------*
* Definición de Variables
*----------------------------------------------------------------------*
    DATA:
     l_ra_comodin TYPE RANGE OF char1.


    ".Instancia Constructor
    DATA(l_o_parametros) = NEW zclcxr1000_parametros( i_modulo = i_c_modulo
                                                      i_ricefw = i_c_ricefw ).


    "Caracter SPLIT
    l_o_parametros->get_parametro( EXPORTING i_idparam     = l_cte_separador
                                   IMPORTING e_ti_valrango = l_ra_comodin
                                   EXCEPTIONS
                                    parametro_no_encontrado = 1 ).

    IF line_exists( l_ra_comodin[ 1 ] ).
      g_es_parametros-separador = l_ra_comodin[ 1 ]-low.
