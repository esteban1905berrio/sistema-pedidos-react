      COMMIT WORK AND WAIT.
      go_log->set_es_log( i_es = VALUE #( id = '/PF1/MSG_RD' number = '097' type = 'S'
                                          message_v1 = <fs_es_dato_idoc>-docnum  ) ).

    ENDLOOP.

    r_ti_mensajes = CORRESPONDING #( go_log->get_log( ) ).

  ENDMETHOD.

ENDCLASS.