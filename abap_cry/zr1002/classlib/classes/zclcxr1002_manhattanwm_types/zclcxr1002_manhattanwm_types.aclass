        _Pickup_End_Date_Time          TYPE string,
        _Pickup_Start_Date_Time        TYPE string,
        _Original_Order_Line_Instructi TYPE gtp_ti_order_instruction, "_Original_Order_Line_Instruction
        _Original_Order_Line_Requested TYPE gtp_ti_order_request, "_Original_Order_Line_Requested_Services
      END OF gtp_original_order_line .
  types:
    gtp_ti_original_order_line TYPE STANDARD TABLE OF gtp_original_order_line WITH EMPTY KEY .
  types:
