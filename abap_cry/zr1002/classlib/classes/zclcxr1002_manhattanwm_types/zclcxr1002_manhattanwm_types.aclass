        _Order_Type                 TYPE string,    "
        _Order_Placed_Date_Time     TYPE string,    "
        _Customer_Id                TYPE string,    "
        _Extended                   TYPE gtp_extended,                "
        _Original_Order_Notes       TYPE gtp_ti_original_order_notes,
        _Destination_Address        TYPE gtp_destination_address,     "
        _Bill_To_Address            TYPE gtp_bill_to_address,         "
        _Original_Order_Line        TYPE gtp_ti_original_order_line,           "
      END OF gtp_original_order .
  types:
    gtp_ti_original_order TYPE STANDARD TABLE OF gtp_original_order WITH EMPTY KEY .
  types:
