        _Provided_Service_Instruction TYPE string,
      END OF gtp_original_order_request .
  types:
    gtp_ti_order_request TYPE STANDARD TABLE OF gtp_original_order_request WITH EMPTY KEY .
  types:
    BEGIN OF gtp_original_order_line,
        _Extended                      TYPE gtp_extended_original_order,
        _Quantity_Uom_Id               TYPE string,
        _Ordered_Quantity              TYPE string,
        _Item_Id                       TYPE string,
        _Priority                      TYPE string,
