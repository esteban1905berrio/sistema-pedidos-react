        !requirement_item          TYPE posnr OPTIONAL
        !requirement_schedule_line TYPE etenr OPTIONAL
        !article_long              TYPE matnr40 OPTIONAL
      CHANGING
        !et_stock_requirement_list TYPE fsh_tt_stock_req_list .
    CLASS-METHODS agregar_mensaje_respuestaodata
      IMPORTING
        !i_msj_en_cuerpo_respuesta   TYPE flag DEFAULT abap_true
        !i_msj_en_cabecera_respuesta TYPE flag DEFAULT abap_false
      CHANGING
        !c_ti_mensajes               TYPE bapiret2_t
        !c_o_message_container       TYPE REF TO /iwbep/if_message_container .
    CLASS-METHODS registrar_cdhdr_cdpos
      IMPORTING
        !i_objectclass      TYPE cdobjectcl
        !i_objectid         TYPE cdobjectv
        !i_change_indicator TYPE char1 DEFAULT 'U'
