      RAISING
        cx_t100_msg .
    CLASS-METHODS formato_fecha_ddmmyyyy
      CHANGING
        !c_fecha TYPE any .
    CLASS-METHODS ti_a_xstring
      IMPORTING
        !i_ti            TYPE REF TO data
      RETURNING
        VALUE(r_xstring) TYPE xstring .
    CLASS-METHODS zfsh_api_get_stock_req_list
      IMPORTING
        !article                   TYPE matnr18 OPTIONAL
        !plant                     TYPE werks_d
        !berid                     TYPE berid OPTIONAL
        !mrp_status                TYPE fsh_tt_mrp_stat_range OPTIONAL
        !stock_element             TYPE fsh_stock_delkz OPTIONAL
        !stock_number              TYPE fsh_bsnr OPTIONAL
        !stock_item                TYPE fsh_hbsp OPTIONAL
        !stock_schedule_line       TYPE etenr OPTIONAL
        !requirement_element       TYPE fsh_req_delkz OPTIONAL
