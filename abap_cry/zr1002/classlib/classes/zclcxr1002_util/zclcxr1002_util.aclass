        !i_workarea_new     TYPE any
        !i_tcode            TYPE sytcode DEFAULT sy-tcode
      CHANGING
        !c_ti_bapiret2      TYPE bapiret2_tab .
  PROTECTED SECTION.

  PRIVATE SECTION.
    CLASS-METHODS asignar_tipo_componente
      IMPORTING
        i_omitir_conversion_tipo_p TYPE flag OPTIONAL
      CHANGING
        c_ti_campos                TYPE gtp_ti_estructura_tabla OPTIONAL
      EXCEPTIONS
        cx_root .

ENDCLASS.



CLASS ZCLCXR1002_UTIL IMPLEMENTATION.


  METHOD construir_catalogo.

    DATA: o_ttdescribe              TYPE REF TO cl_abap_tabledescr,
          o_stdescribe              TYPE REF TO cl_abap_structdescr,
          o_eldescribe              TYPE REF TO cl_abap_elemdescr,
          ti_component_d            TYPE abap_component_tab,
          es_dfies                  TYPE dfies,
          index                     TYPE i,
          indice_estructura_anidada TYPE i,
          ti_component              TYPE abap_component_tab,
          es_component              LIKE LINE OF ti_component.

    FIELD-SYMBOLS: <fs_catalog> TYPE lvc_s_fcat.

    o_ttdescribe ?= cl_abap_structdescr=>describe_by_data( i_ti ).
    o_stdescribe ?= o_ttdescribe->get_table_line_type( ).

    ti_component = o_stdescribe->get_components( ).
    "busca estructuras anidadas
    LOOP AT ti_component INTO es_component WHERE name = space OR as_include EQ abap_true.
      indice_estructura_anidada = sy-tabix.
      o_stdescribe ?=  es_component-type.
      APPEND LINES OF o_stdescribe->get_components( ) TO ti_component_d.
    ENDLOOP..

    DELETE ti_component WHERE name = space.
    "agrega componenes anidados
    IF i_conservar_indice_es_anidada = abap_true
    AND ti_component_d IS NOT INITIAL.
      IF indice_estructura_anidada <= 0.
        indice_estructura_anidada = 1.
      ENDIF.
      INSERT LINES OF ti_component_d INTO ti_component INDEX indice_estructura_anidada.
    ELSE.
      APPEND LINES OF ti_component_d TO ti_component.
    ENDIF.

    LOOP AT ti_component INTO es_component.
      index = sy-tabix.
      CLEAR: es_dfies.

      " recupera descripcion del tipo
      TRY.
          o_eldescribe ?= es_component-type.
        CATCH cx_root.
          CONTINUE.
      ENDTRY.

      IF o_eldescribe->is_ddic_type( ) EQ abap_true.
        es_dfies = o_eldescribe->get_ddic_field( ).
      ELSE.
        es_dfies-leng = o_eldescribe->length.
        es_dfies-decimals = o_eldescribe->decimals.
        es_dfies-datatype = es_dfies-inttype = es_dfies-comptype = o_eldescribe->type_kind.
      ENDIF.

      APPEND INITIAL LINE TO r_ti_catalogo ASSIGNING <fs_catalog>.

      MOVE-CORRESPONDING es_dfies TO <fs_catalog>.

      IF es_component-name EQ 'MANDT'.
        <fs_catalog>-tech = abap_true.
      ENDIF.
      "{ Inicio SGR 08.01.2025 | Comentar porque genera error al generar totalizados
*      IF es_dfies-datatype = 'CURR'.
*        <fs_catalog>-cfieldname = i_cfieldname.
*      ENDIF.
      "{ Fin SGR 08.01.2025

      IF es_dfies-datatype = 'MEINS'.
        <fs_catalog>-qfieldname = i_qfieldname.
      ENDIF.

      <fs_catalog>-fieldname  = es_component-name.
      <fs_catalog>-dd_outlen = <fs_catalog>-intlen = es_dfies-leng.
      <fs_catalog>-outputlen = '0'.
      <fs_catalog>-col_opt = i_optimizar_columnas.
      <fs_catalog>-col_pos = index.
      <fs_catalog>-tabname = '1'.

      IF es_component-name = 'ICON'.
        <fs_catalog>-icon = abap_true.
      ELSE.
        <fs_catalog>-icon =  abap_false.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD crear_rango.

    FIELD-SYMBOLS: <fs_val>    TYPE any,
                   <fs_es_val> TYPE any.

    IF i_ti IS NOT INITIAL.
      LOOP AT i_ti ASSIGNING <fs_es_val>.

        UNASSIGN <fs_val>.

        IF i_nombre_columna IS NOT INITIAL.
          ASSIGN COMPONENT i_nombre_columna OF STRUCTURE <fs_es_val> TO <fs_val>.
        ELSE.
          ASSIGN <fs_es_val> TO <fs_val>.
        ENDIF.

        CHECK <fs_val> IS ASSIGNED.

        set_entrada_rango(
          EXPORTING
            i_sign                         = i_sign
            i_option                       = i_option
            i_low                          = <fs_val>
            i_convertir_in                 = i_convertir_in
            i_convertir_out                = i_convertir_out
            i_completar_cp                 = i_completar_cp
            i_caracter_divide_valor_x_fila = i_caracter_divide_valor_x_fila
            i_remover_espacios             = i_remover_espacios
          CHANGING
            c_ti_rango                     = c_ti_rango ).
      ENDLOOP.
    ELSEIF i_low IS NOT INITIAL OR i_high IS NOT INITIAL.
      set_entrada_rango(
        EXPORTING
          i_sign                         = i_sign
          i_option                       = i_option
          i_low                          = i_low
          i_high                         = i_high
          i_convertir_in                 = i_convertir_in
          i_convertir_out                = i_convertir_out
          i_completar_cp                 = i_completar_cp
          i_caracter_divide_valor_x_fila = i_caracter_divide_valor_x_fila
          i_remover_espacios             = i_remover_espacios
        CHANGING
          c_ti_rango                     = c_ti_rango ).

    ENDIF.
    "Omitir estas sentencias puede ayudar en el performance
    IF i_no_ordenar = abap_false.
      SORT c_ti_rango.
    ENDIF.
    IF i_no_eliminar_duplicados = abap_false.
      DELETE ADJACENT DUPLICATES FROM c_ti_rango COMPARING ALL FIELDS.
    ENDIF.

    IF i_eliminar_valores_iniciales = abap_true.
      DELETE c_ti_rango WHERE ('LOW = space and HIGH = space').
    ENDIF.

  ENDMETHOD.


  METHOD crear_rango_division.
    DATA: str     TYPE string,
          ti_data TYPE TABLE OF string.

    DATA: obj_it_desc TYPE REF TO cl_abap_tabledescr.

    FIELD-SYMBOLS: <fs_it_aux> TYPE ANY TABLE.

    ASSIGN: c_ti_rango TO <fs_it_aux>.

    SPLIT i_cadena AT i_separador INTO TABLE ti_data.

    obj_it_desc ?= cl_abap_tabledescr=>describe_by_data( <fs_it_aux> ).

    READ TABLE obj_it_desc->key TRANSPORTING NO FIELDS
                                WITH KEY name = gc_sign.

    IF sy-subrc IS INITIAL.
      LOOP AT ti_data INTO str.

        set_entrada_rango(
          EXPORTING
            i_low              = str
            i_convertir_in     = i_convertir_in
            i_convertir_out    = i_convertir_out
            i_remover_espacios = i_remover_espacios
          CHANGING
            c_ti_rango         = c_ti_rango ).

      ENDLOOP.
    ENDIF.
  ENDMETHOD.


  METHOD set_entrada_rango.

    DATA: lv_data TYPE REF TO data.

    FIELD-SYMBOLS: <fs_wa_st> TYPE any,
                   <fs_value> TYPE any.

    CREATE DATA lv_data LIKE LINE OF c_ti_rango.

    ASSIGN lv_data->* TO <fs_wa_st>.

    CHECK sy-subrc EQ 0.

    ASSIGN COMPONENT gc_sign OF STRUCTURE <fs_wa_st> TO <fs_value>.

    CHECK sy-subrc EQ 0.

    MOVE i_sign TO <fs_value>.

    ASSIGN COMPONENT gc_option OF STRUCTURE <fs_wa_st> TO <fs_value>.

    IF i_high IS NOT INITIAL AND i_low IS NOT INITIAL.
      <fs_value> = gc_bt.
    ELSE.
      <fs_value> = i_option.
    ENDIF.

    ASSIGN COMPONENT gc_low OF STRUCTURE <fs_wa_st> TO <fs_value>.
    MOVE i_low TO <fs_value>.

    IF i_remover_espacios = abap_true.
      CONDENSE <fs_value>.
    ENDIF.

    IF  i_convertir_in = abap_true.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = <fs_value>
        IMPORTING
          output = <fs_value>.
    ENDIF.

    IF  i_convertir_out = abap_true.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          input  = <fs_value>
        IMPORTING
          output = <fs_value>.
    ENDIF.

    IF i_completar_cp  = abap_true AND <fs_value> IS NOT INITIAL.
      CONCATENATE '*' <fs_value> '*'
      INTO <fs_value>.
    ENDIF.

    ASSIGN COMPONENT gc_high OF STRUCTURE <fs_wa_st> TO <fs_value>.
    MOVE i_high TO <fs_value>.

    IF i_remover_espacios = abap_true.
      CONDENSE <fs_value>.
    ENDIF.

    IF  i_convertir_in = abap_true.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = <fs_value>
        IMPORTING
          output = <fs_value>.
    ENDIF.

    IF  i_convertir_out = abap_true.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          input  = <fs_value>
        IMPORTING
          output = <fs_value>.
    ENDIF.

    IF i_completar_cp  = abap_true AND <fs_value> IS NOT INITIAL.
      CONCATENATE '*' <fs_value> '*'
      INTO <fs_value>.
    ENDIF.

    IF i_caracter_divide_valor_x_fila IS INITIAL.
      INSERT <fs_wa_st> INTO TABLE c_ti_rango.
    ELSE.
      "dividir un valor en varias filas
      SPLIT i_low AT i_caracter_divide_valor_x_fila INTO TABLE DATA(ti_valores_divididos).

      LOOP AT ti_valores_divididos ASSIGNING FIELD-SYMBOL(<fs_es_valor>).

        crear_rango(
          EXPORTING
            i_sign                       = i_sign
            i_option                     = i_option
            i_low                        = <fs_es_valor>
            i_convertir_in               = i_convertir_in
            i_convertir_out              = i_convertir_out
            i_eliminar_valores_iniciales = i_eliminar_valores_iniciales
            i_completar_cp               = i_completar_cp
          CHANGING
            c_ti_rango                   = c_ti_rango ).

      ENDLOOP.

    ENDIF.

  ENDMETHOD.


  METHOD crear_ti_dinamica.
    DATA :
      " declaración de RTTS
      o_struct_typ TYPE REF TO cl_abap_datadescr,
      o_dintbl_typ TYPE REF TO cl_abap_tabledescr,
      ti_component TYPE cl_abap_structdescr=>component_table.

    "recupera información de tipo de dato
    asignar_tipo_componente( EXPORTING i_omitir_conversion_tipo_p = i_omitir_conversion_tipo_p
                             CHANGING  c_ti_campos                = c_ti_campos ).

    ti_component = VALUE #( FOR es_campos IN c_ti_campos
                            ( name = es_campos-nombre
                              type = es_campos-o_descripcion_elemento ) ).

    o_struct_typ ?= cl_abap_structdescr=>create( p_components = ti_component ).
    o_dintbl_typ = cl_abap_tabledescr=>create( p_line_type  = o_struct_typ
                                               p_table_kind = i_tipo_tabla
                                               p_unique     = i_valores_unicos
                                               p_key        = i_ti_clave
                                               p_key_kind   = i_tipo_clave ).

    CREATE DATA: r_ti  TYPE HANDLE o_dintbl_typ.
  ENDMETHOD.


  METHOD asignar_tipo_componente.
    DATA: o_desc TYPE REF TO cl_abap_typedescr.

    LOOP AT c_ti_campos ASSIGNING FIELD-SYMBOL(<fs_es_campos>).
      "ajusta nombre de columna
      TRANSLATE <fs_es_campos>-nombre USING ' _'.
      "deriva el tipo de dato
      IF <fs_es_campos>-o_descripcion_elemento IS INITIAL.
        cl_abap_datadescr=>describe_by_name( EXPORTING  p_name         = COND #( WHEN <fs_es_campos>-campo EQ 'STRING' THEN
                                                                                  <fs_es_campos>-campo
                                                                                 WHEN <fs_es_campos>-estructura IS NOT INITIAL THEN
                                                                                  |{ <fs_es_campos>-estructura }-{ <fs_es_campos>-campo }|
                                                                               )
                                             RECEIVING  p_descr_ref    = o_desc
                                             EXCEPTIONS type_not_found = 1 ).
      ELSE.
        o_desc ?= <fs_es_campos>-o_descripcion_elemento.
      ENDIF.

      IF sy-subrc EQ 1.

        "si eltipo no es valido, crea la columna tipo String
        <fs_es_campos>-o_descripcion_elemento ?= cl_abap_datadescr=>describe_by_name( 'STRING' ).
      ELSE.

        <fs_es_campos>-o_descripcion_elemento ?= o_desc.

        "ajustar longitud de salida para tipos de dato P
        IF i_omitir_conversion_tipo_p = abap_false.
          CASE o_desc->type_kind.
            WHEN 'P'.
              <fs_es_campos>-o_descripcion_elemento ?=
                <fs_es_campos>-o_descripcion_elemento->get_p(
                p_length   = COND #( WHEN ( ( o_desc->length * 2 ) - 1 ) > <fs_es_campos>-o_descripcion_elemento->type_p_max_length THEN
                                         <fs_es_campos>-o_descripcion_elemento->type_p_max_length
                                     ELSE
                                         ( ( o_desc->length * 2 ) - 1 ) )
                p_decimals = o_desc->decimals
              ).
          ENDCASE.
        ENDIF.

      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD crear_archivo_zip.

    DATA: o_zip       TYPE REF TO cl_abap_zip,
          zip_content TYPE xstring.

    CREATE OBJECT o_zip.

    "agregar contenido a ZIP
    LOOP AT i_ti_contenido_zip INTO DATA(es_zip_data).

      o_zip->add( name = es_zip_data-nombre content = es_zip_data-contenido ).

    ENDLOOP.

    zip_content   = o_zip->save( ).

* convierte xstring a binary
    CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
      EXPORTING
        buffer        = zip_content
      IMPORTING
        output_length = e_longitud_salida
      TABLES
        binary_tab    = e_ti_binario.

  ENDMETHOD.


  METHOD get_nueva_referencia.
    FIELD-SYMBOLS <f_t_dyn> TYPE STANDARD TABLE.

    CREATE DATA r_ti_o LIKE i_ti.
    ASSIGN r_ti_o->* TO <f_t_dyn>.

    <f_t_dyn> = i_ti.
  ENDMETHOD.


  METHOD ti_a_string.

    DATA: str_line            TYPE string,
          o_stdescribe        TYPE REF TO cl_abap_structdescr,
          o_tabledescr        TYPE REF TO cl_abap_tabledescr,
          o_elm_des           TYPE REF TO cl_abap_elemdescr,
          ti_columnas_tabla_d TYPE cl_abap_structdescr=>component_table.

    FIELD-SYMBOLS: <fs_es_datos> TYPE any,
                   <fs_dato>     TYPE any,
                   <fs_ti_datos> TYPE ANY TABLE.

    TRY.

        o_tabledescr ?= cl_abap_structdescr=>describe_by_data( i_ti ).

        TRY.
            o_stdescribe ?= o_tabledescr->get_table_line_type( ).
            DATA(ti_columnas_tabla) = o_stdescribe->get_components( ).
          CATCH cx_sy_move_cast_error INTO DATA(o_cx_cast) ##NO_HANDLER.

            o_elm_des ?= o_tabledescr->get_table_line_type( ).

            APPEND VALUE cl_abap_structdescr=>component( name = 'TABLE_LINE'
                                                         type = o_tabledescr->get_table_line_type( )    )
            TO ti_columnas_tabla.

        ENDTRY.

        "busca estructuras anidadas
        LOOP AT ti_columnas_tabla INTO DATA(es_componente) WHERE name = space OR as_include EQ abap_true.
          o_stdescribe ?=  es_componente-type.
          APPEND LINES OF o_stdescribe->get_components( ) TO ti_columnas_tabla_d.
        ENDLOOP..

        DELETE ti_columnas_tabla_d WHERE name = space.
        "agrega componenes anidados
        APPEND LINES OF ti_columnas_tabla_d TO ti_columnas_tabla.

        DELETE ti_columnas_tabla WHERE name = space.

      CATCH cx_sy_move_cast_error ##NO_HANDLER.

    ENDTRY.

    LOOP AT i_ti ASSIGNING <fs_es_datos>.

      str_line = es_a_string( i_es                       = <fs_es_datos>
                              i_r_excluir_columnas       = i_r_excluir_columnas
                              i_caracter_exc_columna     = i_caracter_exc_columna
                              i_separador                = i_separador
                              i_incluir_encabezado       = abap_false
                              i_ti_componente_estructura = ti_columnas_tabla ).

      IF i_omitir_salto_linea = abap_true.
        r_str = r_str && str_line.
      ELSE.
        IF i_separador_como_salto_linea = abap_true.
          r_str = r_str && str_line && i_separador.
        ELSE.
          r_str = r_str && str_line && cl_abap_char_utilities=>cr_lf.
        ENDIF.
      ENDIF.

    ENDLOOP.
    "Eliminar ultimo caracter
    IF i_separador_como_salto_linea = abap_true.
      DATA(longitud_cadena) = strlen( r_str ) - 1.
      IF longitud_cadena > 1.
        r_str = r_str(longitud_cadena).
      ENDIF.
    ENDIF.

    """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
    "Funcionalidad para incluir el encabezado de la tabla
    IF i_incluir_encabezado = abap_true.
      CLEAR str_line.

      "Recorrer los campos de la tabla
      LOOP AT ti_columnas_tabla ASSIGNING FIELD-SYMBOL(<fs_es_componentes_tabla>).

        IF i_r_excluir_columnas IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name IN i_r_excluir_columnas.
          CONTINUE.
        ENDIF.
        "columnas que se excluyen
        IF i_caracter_exc_columna IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name(2) EQ i_caracter_exc_columna.
          CONTINUE.
        ENDIF.

        TRY.
            "Asigna la referencia del tipo del campo
            o_elm_des ?= <fs_es_componentes_tabla>-type.
          CATCH  cx_sy_move_cast_error cx_root INTO DATA(o_cx).
            CONTINUE.
        ENDTRY.

        CASE i_tam_txt_columna.
          WHEN 'L'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_l }|.
          WHEN 'M'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_m }|.
          WHEN 'S'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_s }|.
          WHEN OTHERS.
            str_line = |{ str_line }{ i_separador }{ <fs_es_componentes_tabla>-name }|.
        ENDCASE.

      ENDLOOP.

      REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

      IF i_omitir_salto_linea = abap_true.
        r_str = str_line && r_str.
      ELSE.
        r_str = str_line && cl_abap_char_utilities=>cr_lf && r_str.
      ENDIF.

    ENDIF.

  ENDMETHOD.


  METHOD enviar_correo.
*    CONSTANTS:
*      c_raw     TYPE char03 VALUE 'RAW'.

    DATA:
      v_mlrec            TYPE so_obj_nam,
      v_sent_to_all      TYPE os_boolean,
      cadena_255         TYPE xstring,
      longitud_xs        TYPE i,
      longitud_xs_actual TYPE i,
      offset_cadena      TYPE i,
      o_send_request     TYPE REF TO cl_bcs,
      o_bcs_exception    TYPE REF TO cx_bcs,
      o_recipient        TYPE REF TO if_recipient_bcs,
      o_sender           TYPE REF TO cl_sapuser_bcs,
      o_document         TYPE REF TO cl_document_bcs.

    TRY.
        "Create send request
        o_send_request = cl_bcs=>create_persistent( ).

        "Email FROM...
*        o_sender = cl_sapuser_bcs=>create( sy-uname ).
        o_sender = cl_sapuser_bcs=>create( i_from ).
        "Add sender to send request
        o_send_request->set_sender( i_sender = o_sender ).

        "Email TO...
        LOOP AT i_ti_destinatarios INTO DATA(s_email).

          o_recipient = cl_cam_address_bcs=>create_internet_address( s_email-smtp_addr ).
          "Add recipient to send request
          o_send_request->add_recipient( i_recipient = o_recipient i_express = abap_true ).

        ENDLOOP.

        "Email BODY
        o_document = cl_document_bcs=>create_document(
          i_type    = i_tipo_documento "c_raw
          i_text    = i_ti_texto_cuerpo_correo
          i_subject = i_asunto ).

        "Convert itab to line 255 positions
        IF i_contenido_binario_adjunto IS NOT INITIAL.

          CLEAR: c_ti_dato_binario.

          cadena_255 = i_contenido_binario_adjunto.
          longitud_xs = xstrlen( cadena_255 ).

          IF longitud_xs > 0.
            DO.
              longitud_xs_actual = offset_cadena + 255.
              IF longitud_xs_actual > longitud_xs.
                APPEND VALUE #( line = cadena_255+offset_cadena ) TO c_ti_dato_binario.
              ELSE.
                APPEND VALUE #( line = cadena_255+offset_cadena(255) ) TO c_ti_dato_binario.
              ENDIF.
              offset_cadena = longitud_xs_actual.
              IF offset_cadena >= longitud_xs.
                EXIT.
              ENDIF.
            ENDDO.
          ENDIF.
        ENDIF.

        "Email attach
        IF c_ti_dato_binario IS SUPPLIED.
          o_document->add_attachment(
            i_attachment_type    = i_tipo_adjunto    " Document Class for Attachment
            i_attachment_subject = i_titulo_adjunto  " Attachment Title
            i_att_content_hex    = c_ti_dato_binario
            i_attachment_header  = i_ti_attachment_header
            i_attachment_size    = i_dimension_adjunto ).
        ENDIF.

        "Add document to send request
        o_send_request->set_document( o_document ).

        "Send email
        v_sent_to_all = o_send_request->send( i_with_error_screen = abap_true ).

        "Commit to send email
        IF i_commit = abap_true.
          COMMIT WORK AND WAIT.
        ENDIF.

        "Exception handling
      CATCH cx_bcs INTO o_bcs_exception.

    ENDTRY.
  ENDMETHOD.


  METHOD enviar_correo_av.

    CONSTANTS:
      c_raw     TYPE char03 VALUE 'RAW'.

    DATA:
      v_mlrec         TYPE so_obj_nam,
      v_sent_to_all   TYPE os_boolean,
      o_send_request  TYPE REF TO cl_bcs,
      o_bcs_exception TYPE REF TO cx_bcs,
      o_recipient     TYPE REF TO if_recipient_bcs,
      o_sender        TYPE REF TO cl_sapuser_bcs,
      o_document      TYPE REF TO cl_document_bcs.


    CLEAR e_es_msg_error.

    "Verificar si las tabla de destinatario y listas de distribución
    "están vacias a la vez
    IF i_ti_destinatarios IS INITIAL AND
       i_ti_ld_emails IS INITIAL.
      "Imprime el mensaje
      MESSAGE ID 'ZCX01'
              TYPE 'E'
              NUMBER '059'
              INTO DATA(mensaje).

      "Asigna el mensaje de error
      e_es_msg_error = VALUE #(
                         id      = 'ZCX01'
                         type    = 'E'
                         number  = '059'
                         message = mensaje ).
      " Falta ingresar direcciones de email y/o listas de distribución.
      RETURN.
    ENDIF.

    "Recuperar los destinatarios de las listas de distribución
    consultar_listas_distribucion(
      EXPORTING
        i_ti_ld_emails     = i_ti_ld_emails
      IMPORTING
        e_ti_destinatarios = DATA(ti_destinatarios)
        e_es_msg_error     = e_es_msg_error
    ).
    IF NOT e_es_msg_error IS INITIAL.
      RETURN.
    ENDIF.

    "Unificar los destinatarios
    ti_destinatarios =
      VALUE #(
        BASE ti_destinatarios
        FOR <fs_es_destin> IN i_ti_destinatarios
        ( tipo_dest = COND #( WHEN <fs_es_destin>-tipo_dest = '' THEN gc_to
                              ELSE <fs_es_destin>-tipo_dest )
          ind_urge  = <fs_es_destin>-ind_urge
          nombre    = <fs_es_destin>-nombre
          email     = to_lower( <fs_es_destin>-email ) ) ).

    "Organiza la tabla
    SORT ti_destinatarios BY tipo_dest DESCENDING
                             ind_urge DESCENDING
                             nombre ASCENDING
                             email ASCENDING.

    TRY.
        "Create send request
        o_send_request = cl_bcs=>create_persistent( ).

        "Email FROM...
        o_sender = cl_sapuser_bcs=>create( COND #( WHEN i_remitente <> space
                                                     THEN i_remitente
                                                   ELSE sy-uname ) ).
        "Add sender to send request
        o_send_request->set_sender( i_sender = o_sender ).

        "Asigna los destinatarios
        LOOP AT ti_destinatarios ASSIGNING FIELD-SYMBOL(<fs_es_destinatarios>).
          "Arma la info del destinatario
          o_recipient = cl_cam_address_bcs=>create_internet_address(
            i_address_string = CONV #( <fs_es_destinatarios>-email )
            i_address_name   = <fs_es_destinatarios>-nombre ).

          "Verifica el tipo de destinatario
          CASE <fs_es_destinatarios>-tipo_dest.
            WHEN gc_to.     "Adiciona destinatario TO
              "Add recipient to send request
              o_send_request->add_recipient(
                EXPORTING
                  i_recipient  = o_recipient
                  i_express    = <fs_es_destinatarios>-ind_urge
                  i_copy       = abap_false
                  i_blind_copy = abap_false
                  i_no_forward = abap_false ).

            WHEN gc_cc.     "Adiciona destinatario CC
              "Add recipient to send request
              o_send_request->add_recipient(
                EXPORTING
                  i_recipient  = o_recipient
                  i_express    = <fs_es_destinatarios>-ind_urge
                  i_copy       = abap_true
                  i_blind_copy = abap_false
                  i_no_forward = abap_false ).

            WHEN gc_bcc.    "Adiciona destinatario BCC
              "Add recipient to send request
              o_send_request->add_recipient(
                EXPORTING
                  i_recipient  = o_recipient
                  i_express    = <fs_es_destinatarios>-ind_urge
                  i_copy       = abap_false
                  i_blind_copy = abap_true
                  i_no_forward = abap_false ).

          ENDCASE.
        ENDLOOP.

        "Email BODY
        o_document = cl_document_bcs=>create_document(
          i_type    = c_raw
          i_text    = i_ti_texto_cuerpo_correo
          i_subject = i_asunto ).

        "Recorre la tabla de adjuntos
        LOOP AT i_ti_lista_adjuntos ASSIGNING FIELD-SYMBOL(<fs_es_lista_adjuntos>).
          "Adjunta el dato
          o_document->add_attachment(
            i_attachment_type    = <fs_es_lista_adjuntos>-tipo
            i_attachment_subject = <fs_es_lista_adjuntos>-titulo
            i_att_content_hex    = <fs_es_lista_adjuntos>-dato ).
        ENDLOOP.

        "Add document to send request
        o_send_request->set_document( o_document ).

        "Send email
        v_sent_to_all = o_send_request->send( i_with_error_screen = abap_true ).

        "Verificar si requiere del commit explícito
        IF i_commit_work = abap_true.
          "Commit to send email
          COMMIT WORK AND WAIT.
        ENDIF.

        "Exception handling
      CATCH cx_bcs INTO o_bcs_exception.

        "Imprime el mensaje
        MESSAGE ID 'ZCX01'
                TYPE 'E'
                NUMBER '060'
                WITH o_bcs_exception->error_type
                     o_bcs_exception->error_text
                INTO mensaje.

        "Asigna el mensaje de error
        e_es_msg_error = VALUE #(
                           id         = 'ZCX01'
                           type       = 'E'
                           number     = '060'
                           message    = mensaje
                           message_v1 = o_bcs_exception->error_type
                           message_v2 = o_bcs_exception->error_text ).
        " Error al enviar el correo electrónico: &1 - &2

    ENDTRY.
  ENDMETHOD.


  METHOD consultar_listas_distribucion.

    DATA:
      ti_member  TYPE STANDARD TABLE OF sodm1,
      ti_objpara TYPE STANDARD TABLE OF selc,
      ti_objparb TYPE STANDARD TABLE OF soop1,
      excepcion  TYPE string.


    CLEAR:
      e_ti_destinatarios,
      e_es_msg_error.

    "Verificar si la tabla listas de distribución está vacía
    IF i_ti_ld_emails IS INITIAL.
      RETURN.
    ENDIF.

    "Recorrer las listas de distribución
    LOOP AT i_ti_ld_emails ASSIGNING FIELD-SYMBOL(<fs_es_ld_emails>).
      "Llamar el MF que recupera la lista
      CALL FUNCTION 'SO_DLI_READ'
        EXPORTING
          distributionlist           = <fs_es_ld_emails>-nombre_obj
*         dli_id                     = space
*         owner                      = space
          system_dli                 = gc_x
*        IMPORTING
*         object_fl_display          =
*         object_hd_display          =
*         object_id                  =
*         object_sd_display          =
        TABLES
          member                     = ti_member
          objpara                    = ti_objpara
          objparb                    = ti_objparb
        EXCEPTIONS
          active_user_not_exist      = 1
          communication_failure      = 2
          component_not_available    = 3
          dl_name_not_exist          = 4
          folder_not_exist           = 5
          folder_no_authorization    = 6
          forwarder_not_exist        = 7
          object_not_exist           = 8
          object_no_authorization    = 9
          operation_no_authorization = 10
          owner_not_exist            = 11
          parameter_error            = 12
          substitute_not_active      = 13
          substitute_not_defined     = 14
          system_failure             = 15
          user_not_exist             = 16
          x_error                    = 17
          OTHERS                     = 18.

      IF sy-subrc <> 0.
        "Asigna la excepción, no se dispara mensajes en la SY.
        CASE sy-subrc.
          WHEN 1.
            excepcion = 'ACTIVE_USER_NOT_EXIST'.
          WHEN 2.
            excepcion = 'COMMUNICATION_FAILURE'.
          WHEN 3.
            excepcion = 'COMPONENT_NOT_AVAILABLE'.
          WHEN 4.
            excepcion = 'DL_NAME_NOT_EXIST'.
          WHEN 5.
            excepcion = 'FOLDER_NOT_EXIST'.
          WHEN 6.
            excepcion = 'FOLDER_NO_AUTHORIZATION'.
          WHEN 7.
            excepcion = 'FORWARDER_NOT_EXIST'.
          WHEN 8.
            excepcion = 'OBJECT_NOT_EXIST'.
          WHEN 9.
            excepcion = 'OBJECT_NO_AUTHORIZATION'.
          WHEN 10.
            excepcion = 'OPERATION_NO_AUTHORIZATION'.
          WHEN 11.
            excepcion = 'OWNER_NOT_EXIST'.
          WHEN 12.
            excepcion = 'PARAMETER_ERROR'.
          WHEN 13.
            excepcion = 'SUBSTITUTE_NOT_ACTIVE'.
          WHEN 14.
            excepcion = 'SUBSTITUTE_NOT_DEFINED'.
          WHEN 15.
            excepcion = 'SYSTEM_FAILURE'.
          WHEN 16.
            excepcion = 'USER_NOT_EXIST'.
          WHEN 17.
            excepcion = 'X_ERROR'.
          WHEN OTHERS.
            excepcion = 'OTHERS'.
        ENDCASE.

        "Imprime el mensaje
        MESSAGE ID 'ZCX01'
                TYPE 'E'
                NUMBER '061'
                WITH excepcion
                INTO DATA(mensaje).

        "Asigna el mensaje de error
        e_es_msg_error = VALUE #(
                           id         = 'ZCX01'
                           type       = 'E'
                           number     = '061'
                           message    = mensaje
                           message_v1 = excepcion ).
        " Error al consultar las listas de distribución de correos: &1

        "Salir del loop
        EXIT.
      ENDIF.

      "Arma la tabla de salida con los destinatarios
      e_ti_destinatarios =
        VALUE #(
          BASE e_ti_destinatarios
          FOR <fs_es_member> IN ti_member
          ( tipo_dest = COND #( WHEN <fs_es_member>-sndcp = gc_x THEN gc_cc
                                WHEN <fs_es_member>-sndbc = gc_x THEN gc_bcc
                                ELSE gc_to )
            ind_urge  = <fs_es_member>-sndex
            nombre    = <fs_es_member>-memadrnam
            email     = <fs_es_member>-address )  ).

      CLEAR:
      ti_member,
      ti_objpara,
      ti_objparb.
    ENDLOOP.

    "Organiza la tabla
    SORT e_ti_destinatarios BY tipo_dest DESCENDING
                               ind_urge DESCENDING
                               nombre ASCENDING
                               email ASCENDING.

  ENDMETHOD.


  METHOD get_valores_dominio.

    CALL FUNCTION 'DDIF_DOMA_GET'
      EXPORTING
        name          = i_nombre_dominio                 " Name of the Domain to be Read
        langu         = sy-langu              " Language in which Texts are Read
      TABLES
        dd07v_tab     = r_ti_valores                " Fixed Domain Values
      EXCEPTIONS
        illegal_input = 1                " Value not Allowed for Parameter
        OTHERS        = 2.

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

  ENDMETHOD.


  METHOD get_tag_xml.

    DATA: begin TYPE string,
          end   TYPE string,
          first LIKE r_ti_tag.

    CONCATENATE '<' i_tag '>' INTO begin.
    CONCATENATE '</' i_tag '>' INTO end.

    SPLIT i_xml AT begin INTO TABLE first.

    DELETE first INDEX 1.

    IF sy-subrc EQ 0.

      LOOP AT first ASSIGNING FIELD-SYMBOL(<fs_r_it_tag>).
        SPLIT <fs_r_it_tag> AT end INTO DATA(s_text1) DATA(s_text2).
        APPEND s_text1 TO r_ti_tag.
      ENDLOOP.

    ENDIF.

  ENDMETHOD.


  METHOD f4_layout.
    "Este codigo aplica en los eventos del reporte
*    AT SELECTION-SCREEN ON VALUE-REQUEST FOR pa_layou.
*    lcl_controlador=>f4_layout( CHANGING c_layout = pa_layou ).
*    PARAMETERS: pa_layou TYPE disvariant-variant.

*    ls_key-report = i_report.
*    ls_layout = cl_salv_layout_service=>f4_layouts( s_key = ls_key
*                                                    restrict = if_salv_c_layout=>restrict_none ).

    DATA: ls_variante TYPE disvariant,
          lv_exit     TYPE char1.

    ls_variante-report = sy-repid.

    CALL FUNCTION 'LVC_VARIANT_F4'
      EXPORTING
        is_variant = VALUE disvariant( report = i_report )
*       i_save     = 'A'
      IMPORTING
        e_exit     = lv_exit
        es_variant = ls_variante
      EXCEPTIONS
        not_found  = 1
        OTHERS     = 2.

    IF sy-subrc NE 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ELSE.
      CHECK lv_exit EQ space.
      c_layout = ls_variante-variant.
    ENDIF.

  ENDMETHOD.


  METHOD asignar_marcado_estructura.
    DATA: o_es_dec                  TYPE REF TO cl_abap_structdescr,
          o_descripcion_es_destino  TYPE REF TO cl_abap_structdescr,
          nombre_componente_destino TYPE string.

    FIELD-SYMBOLS: <fs_vl_des> TYPE any,
                   <fs_vl_org> TYPE any.

    CLEAR: c_es_destino.

    o_es_dec ?= cl_abap_structdescr=>describe_by_data( i_es_origen ).
    o_descripcion_es_destino ?= cl_abap_structdescr=>describe_by_data( c_es_destino ).

    LOOP AT o_es_dec->components INTO DATA(es_component).
      UNASSIGN: <fs_vl_des>, <fs_vl_org>.

      nombre_componente_destino = COND #( WHEN i_prefijo_estructura_destino IS NOT INITIAL THEN
                                           |{ i_prefijo_estructura_destino }{ es_component-name }|
                                         ELSE
                                           es_component-name ).

      ASSIGN COMPONENT: nombre_componente_destino OF STRUCTURE c_es_destino TO <fs_vl_des>,
                        es_component-name OF STRUCTURE i_es_origen TO <fs_vl_org>.

      CHECK <fs_vl_des> IS ASSIGNED AND <fs_vl_org> IS ASSIGNED AND <fs_vl_org> IS NOT INITIAL.
      "...si son de tipo igual asigna el mismo valor
      IF o_descripcion_es_destino->components[ name = nombre_componente_destino ]-type_kind = es_component-type_kind AND
         o_descripcion_es_destino->components[ name = nombre_componente_destino ]-length = es_component-length.
        <fs_vl_des> =  <fs_vl_org>.
      ELSE.
        <fs_vl_des> = abap_true."para componentes detipo FLAG se lleva con abap_true indicando que el valor se modificara
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD completar_rango.

    FIELD-SYMBOLS: <fs_sign>   TYPE any,
                   <fs_option> TYPE any,
                   <fs_low>    TYPE any,
                   <fs_high>   TYPE any.

    LOOP AT c_ti_rango ASSIGNING FIELD-SYMBOL(<fs_es_val>).

      ASSIGN COMPONENT: gc_sign OF STRUCTURE <fs_es_val> TO <fs_sign>,
                        gc_option OF STRUCTURE <fs_es_val> TO <fs_option>,
                        gc_low OF STRUCTURE <fs_es_val> TO <fs_low>,
                        gc_high OF STRUCTURE <fs_es_val> TO <fs_high>.

      CHECK <fs_sign> IS ASSIGNED.

      IF <fs_high> IS NOT INITIAL AND <fs_low> IS NOT INITIAL.
        <fs_option> = gc_bt.
      ENDIF.

      IF  i_convertir_in = abap_true.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = <fs_low>
          IMPORTING
            output = <fs_low>.

        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = <fs_high>
          IMPORTING
            output = <fs_high>.

      ENDIF.

      IF  i_convertir_out = abap_true.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
          EXPORTING
            input  = <fs_low>
          IMPORTING
            output = <fs_low>.

        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
          EXPORTING
            input  = <fs_high>
          IMPORTING
            output = <fs_high>.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD asignar_porcentaje_br_progreso.
    CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
      EXPORTING
        percentage = i_porcentaje
        text       = i_texto.
  ENDMETHOD.


  METHOD aplicar_conversion_campo.
    DATA: ti_ptab      TYPE abap_func_parmbind_tab,
          es_ptab      TYPE abap_func_parmbind,
          es_mtdata_fm TYPE rsfbintfv,
          ti_excep     TYPE abap_func_excpbind_tab.

    CHECK i_exit IS NOT INITIAL.

    DATA(o_log) = zclcxr1002_log_aplicacion=>get_instancia( ).

    REPLACE '==' WITH space INTO i_exit.

    "nombre modulo de funcion
    DATA(fm_nm) = 'CONVERSION_EXIT_' && i_exit && '_INPUT'.

    CONDENSE fm_nm NO-GAPS.

    CHECK i_valor IS NOT INITIAL.

    " Exporting
    es_ptab-name = 'INPUT'.
    es_ptab-kind = abap_func_exporting.
    es_ptab-value = REF #( i_valor ).
    INSERT es_ptab INTO TABLE ti_ptab.

    " Importing
    es_ptab-name = 'OUTPUT'.
    es_ptab-kind = abap_func_importing.
    es_ptab-value = REF #( c_valor ).
    INSERT es_ptab INTO TABLE ti_ptab.
    "recupera lista de excepciones
    cl_fb_function_utility=>meth_get_interface(
      EXPORTING
        im_name             = CONV #( fm_nm )    " ABAP Workbench: LIMU Name
      IMPORTING
        ex_interface        = es_mtdata_fm    " Function Module Interface
      EXCEPTIONS
        error_occured       = 1
        object_not_existing = 2
        OTHERS              = 3 ).

    IF sy-subrc IS NOT INITIAL.
      o_log->set_es_log( i_es = VALUE #( row = i_fila id = sy-msgid type = sy-msgty number = sy-msgno message_v1 = sy-msgv1
                                              message_v2 = sy-msgv2 message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).
    ELSE.
      ti_excep = VALUE abap_func_excpbind_tab( BASE ti_excep FOR es_except IN es_mtdata_fm-except
                                               ( name = es_except-parameter value = sy-tabix )  ).
    ENDIF.

    CALL FUNCTION fm_nm
      PARAMETER-TABLE
      ti_ptab
      EXCEPTION-TABLE
      ti_excep.

    IF sy-subrc NE 0.
      "manejo de errores
      o_log->set_es_log( i_es = VALUE #( row = i_fila id = sy-msgid type = sy-msgty number = sy-msgno message_v1 = sy-msgv1
                                              message_v2 = sy-msgv2 message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).
    ENDIF.

  ENDMETHOD.


  METHOD validar_dominio.
    DATA: es_dd01v   TYPE dd01v,
          cond_where TYPE string,
          r_val_dom  TYPE REF TO data,
          ti_fiels   TYPE STANDARD TABLE OF dfies.

    FIELD-SYMBOLS: <fs_es_valores> TYPE any.

    CHECK i_dominio IS NOT INITIAL.
    "valida valor para dominios con valores fijos
    CALL FUNCTION 'FM_DOMAINVALUE_CHECK'
      EXPORTING
        i_domname         = i_dominio
        i_domvalue        = CONV dd07d-domvalue( i_valor )
      EXCEPTIONS
        input_error       = 1
        value_not_allowed = 2
        OTHERS            = 3.


    CASE sy-subrc.

      WHEN 0.
        r_valor = i_valor.
      WHEN  2."valor no encontrado para dominio con valores fijos
        RAISE EXCEPTION TYPE cx_t100_msg EXPORTING textid = 'err_dom_val' t100_msgv1 = i_valor t100_msgv2 = CONV #( i_dominio ) .
      WHEN OTHERS."busca en dominio con tabla de valores
        "recupera tabla de valores de dominio
        CALL FUNCTION 'DDIF_DOMA_GET'
          EXPORTING
            name          = i_dominio    " Name of the Domain to be Read
            langu         = sy-langu    " Language in which Texts are Read
          IMPORTING
            dd01v_wa      = es_dd01v    " Header of the Domain
          EXCEPTIONS
            illegal_input = 1
            OTHERS        = 2.

        IF sy-subrc IS INITIAL AND es_dd01v-entitytab IS NOT INITIAL.

          "Crea estructuras segun tabla de consulta
          CREATE DATA r_val_dom TYPE (es_dd01v-entitytab).
          ASSIGN r_val_dom->* TO <fs_es_valores>.
          "recupera campo clave de tabla de valores
          CALL FUNCTION 'DDIF_FIELDINFO_GET'
            EXPORTING
              tabname        = es_dd01v-entitytab   " Name of the Table (of the Type) for which Information is Req
            TABLES
              dfies_tab      = ti_fiels   " Field List if Necessary
            EXCEPTIONS
              not_found      = 1
              internal_error = 2
              OTHERS         = 3.

          IF sy-subrc IS INITIAL.
            "crea condicion WHERE
            cond_where = |{ COND #( WHEN line_exists( ti_fiels[ fieldname = i_dominio ] )
                                    THEN i_dominio
                                    WHEN line_exists( ti_fiels[ domname = i_dominio ] )
                                    THEN ti_fiels[ domname = i_dominio ]-fieldname
                                    ELSE ti_fiels[ 2 ]-fieldname  ) } = '{ i_valor }'|.
            "valida valor de tabla de valores
            SELECT SINGLE *
            FROM  (es_dd01v-entitytab)
            INTO  <fs_es_valores>
            WHERE (cond_where).

            "si el valor es encontrado se asigna a la variable de retorno, de lo contrario lanta una excepcion
            r_valor = COND #( WHEN sy-subrc IS INITIAL THEN i_valor
                                ELSE  THROW  cx_t100_msg( textid = 'err_dom_val' t100_msgv1 = i_valor t100_msgv2 = CONV #( i_dominio ) ) ).

          ENDIF.
        ELSE."Dominio sin tabla de valores ni valores fijos
          r_valor = i_valor.
        ENDIF.

    ENDCASE.
  ENDMETHOD.


  METHOD formato_fecha_ddmmyyyy.
    CHECK strlen( c_fecha ) >= 8.
    SPLIT c_fecha AT '-' INTO TABLE DATA(ti_fecha).

    IF lines( ti_fecha ) = 1.
      c_fecha = ti_fecha[ 1 ].
    ELSE.
      c_fecha = ti_fecha[ 1 ] && ti_fecha[ 2 ] && ti_fecha[ 3 ].
    ENDIF.
  ENDMETHOD.


  METHOD totalizar_estructura.

    DATA: o_ttdescribe         TYPE REF TO cl_abap_tabledescr,
          o_stdescribe         TYPE REF TO cl_abap_structdescr,
          o_eldescribe         TYPE REF TO cl_abap_elemdescr,
          ti_component_d       TYPE abap_component_tab,
          es_dfies             TYPE dfies,
          index                TYPE i,
          ti_valores_numericos TYPE gtp_ti_estructura_tabla,
          r_es_datos_totalizar TYPE REF TO data.

    FIELD-SYMBOLS: <fs_ti_datos_totalizar> TYPE ANY TABLE,
                   <fs_es_componentes>     LIKE LINE OF gti_componentes_es,
                   <fs_es_datos_totalizar> TYPE any.

    IF gti_componentes_es IS INITIAL OR i_inicializar = abap_true.
      CLEAR: gti_componentes_es.

*      o_ttdescribe ?= cl_abap_structdescr=>describe_by_data( c_es ).
*      o_stdescribe ?= o_ttdescribe->get_table_line_type( ).
      o_stdescribe ?= cl_abap_structdescr=>describe_by_data( c_es ).

      gti_componentes_es = o_stdescribe->get_components( ).
      "busca estructuras anidadas
      LOOP AT gti_componentes_es ASSIGNING <fs_es_componentes> WHERE name = space OR as_include EQ abap_true.
        o_stdescribe ?=  <fs_es_componentes>-type.
        APPEND LINES OF o_stdescribe->get_components( ) TO ti_component_d.
      ENDLOOP.

      DELETE gti_componentes_es WHERE name = space.
      "agrega componenes anidados
      APPEND LINES OF ti_component_d TO gti_componentes_es.

      LOOP AT gti_componentes_es ASSIGNING <fs_es_componentes>.
        index = sy-tabix.
        CLEAR: es_dfies.

        IF i_r_excluir_campo IS NOT INITIAL AND
           <fs_es_componentes>-name IN i_r_excluir_campo.
          CONTINUE.
        ENDIF.

        "recupera descripcion del tipo
        TRY.
            o_eldescribe ?= <fs_es_componentes>-type.
          CATCH cx_root.
            CONTINUE.
        ENDTRY.

        IF o_eldescribe->is_ddic_type( ) EQ abap_true.
          es_dfies = o_eldescribe->get_ddic_field( ).
        ELSE.
          es_dfies-leng = o_eldescribe->length.
          es_dfies-decimals = o_eldescribe->decimals.
          es_dfies-datatype = es_dfies-inttype = es_dfies-comptype = o_eldescribe->type_kind.
        ENDIF.

        IF es_dfies-datatype = 'CURR' OR es_dfies-datatype = 'DEC' OR es_dfies-datatype = 'QUAN'
        OR es_dfies-datatype = 'P' OR es_dfies-datatype = 'I'
        OR ( line_exists( i_ti_campo_clave[ name = <fs_es_componentes>-name ] ) ).
          APPEND VALUE gtp_es_tabla( nombre = <fs_es_componentes>-name
                                     o_descripcion_elemento = o_eldescribe )
          TO ti_valores_numericos.
        ENDIF.

      ENDLOOP.
      TRY.
          gti_datos_totalizar = crear_ti_dinamica( EXPORTING i_ti_clave       = i_ti_campo_clave
                                                             i_tipo_clave     = cl_abap_tabledescr=>keydefkind_user
                                                             i_valores_unicos = abap_false
                                                   CHANGING  c_ti_campos      = ti_valores_numericos ).
        CATCH cx_sy_struct_creation.
        CATCH cx_dynamic_check INTO DATA(o_cx_d).
          DATA(tc) = o_cx_d->get_text( ).
        CATCH cx_static_check.
      ENDTRY.
    ENDIF.

    ASSIGN gti_datos_totalizar->* TO <fs_ti_datos_totalizar>.
    CREATE DATA r_es_datos_totalizar LIKE LINE OF <fs_ti_datos_totalizar>.
    ASSIGN r_es_datos_totalizar->* TO <fs_es_datos_totalizar>.

    <fs_es_datos_totalizar> = CORRESPONDING #( c_es ).

    COLLECT <fs_es_datos_totalizar> INTO <fs_ti_datos_totalizar>.

    LOOP AT <fs_ti_datos_totalizar> ASSIGNING <fs_es_datos_totalizar>.
    ENDLOOP.

    CHECK sy-subrc IS INITIAL.

    c_es = CORRESPONDING #( BASE ( c_es ) <fs_es_datos_totalizar> ).

  ENDMETHOD.


  METHOD inicializar_totalizacion_es.
    CLEAR: gti_componentes_es, gti_datos_totalizar.
    FREE: gti_datos_totalizar.
  ENDMETHOD.


  METHOD zfsh_api_get_stock_req_list.

**********************************************************************
*NOTA: Copia de la funcion FSH_API_GET_STOCK_REQ_LIST debido a que esta
*no brinda la opcion de filtrar por area de planificacion
**********************************************************************

    DATA : lo_fsh_stock_req_list TYPE REF TO cl_fsh_srl_service_provider,
           ls_srl                TYPE fsh_s_srl_dialog,
           lt_fsh_srl            TYPE fsh_tt_srl_alv,
           ls_fsh_srl            TYPE fsh_s_srl_alv,
           ls_add_info           TYPE fsh_s_mattb,
           ls_return             TYPE bapiret2,
           ls_stock_req_list     TYPE fsh_s_stock_req_list,
           v_article_long	       TYPE matnr40.

    v_article_long = article_long.
    cl_matnr_chk_mapper=>convert_on_input(
      EXPORTING
        iv_matnr18               = article         " Field length 18
        iv_matnr40               = v_article_long  " Material Number
      IMPORTING
        ev_matnr40               = v_article_long  " Material Number
      EXCEPTIONS
        excp_matnr_ne            = 1
        excp_matnr_invalid_input = 2
        OTHERS                   = 3
    ).

    IF sy-subrc <> 0.
      cl_matnr_chk_mapper=>bapi_get_last_error(
        IMPORTING
          ev_return = ls_return
      ).
      MESSAGE ID     ls_return-id
              TYPE   ls_return-type
              NUMBER ls_return-number
              WITH   ls_return-message_v1
                     ls_return-message_v2
                     ls_return-message_v3
                     ls_return-message_v4.
      RETURN.
    ENDIF.

    IF v_article_long IS INITIAL.
      RETURN.
    ENDIF.

***-- MOVE input PARAMETERS
    ls_srl-matnr          = v_article_long.
    ls_srl-werks          = plant.
    ls_srl-berid          = berid.
    ls_srl-stock_delkz    = stock_element.
    ls_srl-fsh_bsnr       = stock_number.
    ls_srl-fsh_hbsp       = stock_item.
    ls_srl-fsh_ebsp       = stock_schedule_line.
    ls_srl-req_delkz      = requirement_element.
    ls_srl-fsh_aufnr      = requirement_number.
    ls_srl-fsh_posnr      = requirement_item.
    ls_srl-fsh_etenr      = requirement_schedule_line.

**-- Get instance of cl_fsh_srl_service_provider class
    CALL METHOD cl_fsh_srl_service_provider=>get_instance
      IMPORTING
        eo_cl_fsh_srl_service_provider = lo_fsh_stock_req_list.

**-- Retrive Stock/Requirement list
    CALL METHOD lo_fsh_stock_req_list->retrieve_srl
      EXPORTING
        is_dialog_in        = ls_srl
        it_fsh_mrp_stat     = mrp_status
        iv_bypass_buffer    = abap_true
      IMPORTING
        et_fsh_srl          = lt_fsh_srl
        es_add_info         = ls_add_info
      EXCEPTIONS
        ex_material_problem = 1
        ex_hana_problem     = 2
        OTHERS              = 3.


    LOOP AT lt_fsh_srl INTO ls_fsh_srl .
      IF cl_mfle_matnr_mode=>get_instance( )->is_in_compatibility_mode( ) = abap_true.
        ls_stock_req_list-article                        = ls_fsh_srl-matnr.
      ENDIF.
      ls_stock_req_list-plant                          = ls_fsh_srl-werks.
      ls_stock_req_list-uom                            = ls_fsh_srl-meins.
      ls_stock_req_list-quantity                       = ls_fsh_srl-menge.
      ls_stock_req_list-fashion_mrp_status             = ls_fsh_srl-fsh_mrp_stat.
      ls_stock_req_list-rquirement_type                = ls_fsh_srl-bdart.
      ls_stock_req_list-requirement_element            = ls_fsh_srl-req_delkz.
      ls_stock_req_list-requirement_mrp_abbreviation   = ls_fsh_srl-req_delbo.
      ls_stock_req_list-requirement_no                 = ls_fsh_srl-delnr.
      ls_stock_req_list-requirement_element_item       = ls_fsh_srl-delps.
      ls_stock_req_list-requirement_schedule_line_no   = ls_fsh_srl-delet.
      ls_stock_req_list-delivery_date                  = ls_fsh_srl-del_date.
      ls_stock_req_list-stock_type                     = ls_fsh_srl-fsh_bskz.
      ls_stock_req_list-stock_element                  = ls_fsh_srl-stock_delkz.
      ls_stock_req_list-stock_mrp_abbreviation         = ls_fsh_srl-stock_delbo.
      ls_stock_req_list-stock_no                       = ls_fsh_srl-fsh_bsnr.
      ls_stock_req_list-stock_element_item             = ls_fsh_srl-fsh_hbsp.
      ls_stock_req_list-stock_schedule_line_no         = ls_fsh_srl-fsh_ebsp.
      ls_stock_req_list-purchase_requisition_fix_icon  = ls_fsh_srl-fixkz_icon.
      ls_stock_req_list-is_purchase_requisition_fixed  = ls_fsh_srl-fixkz.
      ls_stock_req_list-plan_date                      = ls_fsh_srl-plan_date.
      ls_stock_req_list-storage_location_req           = ls_fsh_srl-lgort_r.
      ls_stock_req_list-storage_location_stock         = ls_fsh_srl-lgort_s.
      ls_stock_req_list-customer_no                    =  ls_fsh_srl-kunnr.
      ls_stock_req_list-customer_name                  =  ls_fsh_srl-kuname.
      ls_stock_req_list-vendor_no                      =  ls_fsh_srl-lifnr.
      ls_stock_req_list-vendor_name                    =  ls_fsh_srl-liname.
      ls_stock_req_list-requirements_plan_number       =  ls_fsh_srl-pbdnr.
      ls_stock_req_list-external_requirements_plan_id  =  ls_fsh_srl-pbdnr_ext.
      ls_stock_req_list-pir_date                       =  ls_fsh_srl-pir_date.
      ls_stock_req_list-requirement_segment            =  ls_fsh_srl-sgt_rcat.
      ls_stock_req_list-segmentation_value             =  ls_fsh_srl-sgt_plrc.
      ls_stock_req_list-stock_segment                  =  ls_fsh_srl-sgt_scat.
      ls_stock_req_list-planning_type                  =  ls_fsh_srl-plart.
      ls_stock_req_list-characteristic_value1          =  ls_fsh_srl-dim1.
      ls_stock_req_list-characteristic_value2          =  ls_fsh_srl-dim2.
      ls_stock_req_list-characteristic_value3          =  ls_fsh_srl-dim3.
      ls_stock_req_list-fsh_sc_bezg                    =  ls_fsh_srl-fsh_sc_bezg.
      ls_stock_req_list-fashion_mrp_status_text        =  ls_fsh_srl-fsh_mrp_stat_txt.
      ls_stock_req_list-special_stock_indicator        =  ls_fsh_srl-sobkz.
      ls_stock_req_list-fashion_termn_date             =  ls_fsh_srl-termn.
      ls_stock_req_list-fashion_master_order           =  ls_fsh_srl-fsh_master_order.
      ls_stock_req_list-fashion_season_year_stock      =  ls_fsh_srl-fsh_season_year_s.
      ls_stock_req_list-fsh_season_stock               =  ls_fsh_srl-fsh_season_s.
      ls_stock_req_list-fsh_collection_stock           =  ls_fsh_srl-fsh_collection_s.
      ls_stock_req_list-fsh_theme_stock                =  ls_fsh_srl-fsh_theme_s.
      ls_stock_req_list-fsh_season_year_req            =  ls_fsh_srl-fsh_season_year_r.
      ls_stock_req_list-fsh_season_req                 =  ls_fsh_srl-fsh_season_r.
      ls_stock_req_list-fsh_collection_req             =  ls_fsh_srl-fsh_collection_r.
      ls_stock_req_list-fsh_theme_req                  =  ls_fsh_srl-fsh_theme_r.
      ls_stock_req_list-article_long                   =  ls_fsh_srl-matnr.

      APPEND ls_stock_req_list TO et_stock_requirement_list.
      CLEAR ls_stock_req_list.
    ENDLOOP.

  ENDMETHOD.


  METHOD es_a_string.

    DATA: str_line                 TYPE string,
          o_stdescribe             TYPE REF TO cl_abap_structdescr,
          o_tabledescr             TYPE REF TO cl_abap_tabledescr,
          o_elm_des                TYPE REF TO cl_abap_elemdescr,
          ti_columnas_tabla_d      TYPE cl_abap_structdescr=>component_table,
          indice_columna           TYPE i,
          r_tipo_no_dato_permitido TYPE RANGE OF c.

    FIELD-SYMBOLS: <fs_dato>     TYPE any,
                   <fs_ti_datos> TYPE ANY TABLE.

    r_tipo_no_dato_permitido = VALUE #( sign = 'I' option = 'EQ' ( low = 'h' )
                                                                 ( low = 'u' )
                                                                 ( low = 'v' ) ).

    IF i_ti_componente_estructura IS INITIAL.
      TRY.

          o_stdescribe ?= cl_abap_structdescr=>describe_by_data( i_es ).

          DATA(ti_componente_estructura) = o_stdescribe->get_components( ).

          "busca estructuras anidadas
          LOOP AT ti_componente_estructura INTO DATA(es_componente) WHERE name = space OR as_include EQ abap_true.
            o_stdescribe ?=  es_componente-type.
            APPEND LINES OF o_stdescribe->get_components( ) TO ti_columnas_tabla_d.
          ENDLOOP..

          DELETE ti_columnas_tabla_d WHERE name = space.
          "agrega componenes anidados
          APPEND LINES OF ti_columnas_tabla_d TO ti_componente_estructura.

          DELETE ti_componente_estructura WHERE name = space.

        CATCH cx_sy_move_cast_error ##NO_HANDLER.

      ENDTRY.

    ELSE.
      ti_componente_estructura = i_ti_componente_estructura.
    ENDIF.

    DO.

      indice_columna = sy-index.

      UNASSIGN <fs_dato>.

      ASSIGN COMPONENT indice_columna OF STRUCTURE i_es TO <fs_dato>.

      IF sy-subrc IS NOT INITIAL.
        IF lines( ti_componente_estructura ) = 1 AND i_es IS NOT INITIAL.
          ASSIGN i_es TO <fs_dato>.

          IF <fs_dato> IS NOT ASSIGNED OR indice_columna > lines( ti_componente_estructura ).
            EXIT.
          ENDIF.

        ELSE.
          EXIT.
        ENDIF.
      ENDIF.

      IF i_r_excluir_columnas IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name IN i_r_excluir_columnas.
        CONTINUE.
      ENDIF.
      "columnas que se excluyen
      IF i_caracter_exc_columna IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name(2) EQ i_caracter_exc_columna.
        CONTINUE.
      ENDIF.

      TRY.
          DESCRIBE FIELD <fs_dato> TYPE DATA(tp_componente).

          CHECK tp_componente NOT IN r_tipo_no_dato_permitido.

          str_line = |{ str_line }{ i_separador }{ <fs_dato> }|.
        CATCH cx_root.

      ENDTRY.

    ENDDO.

    REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

    r_str = str_line.

    """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
    "Funcionalidad para incluir el encabezado de la tabla
    IF i_incluir_encabezado = abap_true.
      CLEAR str_line.

      "Recorrer los campos de la tabla
      LOOP AT ti_componente_estructura ASSIGNING FIELD-SYMBOL(<fs_es_componentes_tabla>).

        IF i_r_excluir_columnas IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name IN i_r_excluir_columnas.
          CONTINUE.
        ENDIF.
        "columnas que se excluyen
        IF i_caracter_exc_columna IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name(2) EQ i_caracter_exc_columna.
          CONTINUE.
        ENDIF.

        "Asigna la referencia del tipo del campo
        o_elm_des ?= <fs_es_componentes_tabla>-type.

        CASE i_longitud_texto_columna.
          WHEN 'L'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_l }|.
          WHEN 'M'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_m }|.
          WHEN 'S'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_s }|.
          WHEN OTHERS.
            str_line = |{ str_line }{ i_separador }{ <fs_es_componentes_tabla>-name }|.
        ENDCASE.

      ENDLOOP.

      REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

      r_str = str_line && cl_abap_char_utilities=>cr_lf && r_str.

    ENDIF.

  ENDMETHOD.


  METHOD ti_a_xstring.
    FIELD-SYMBOLS: <fs_data> TYPE ANY TABLE.

    CLEAR r_xstring.
    ASSIGN i_ti->* TO <fs_data>.

    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(o_tabla)
                                CHANGING  t_table      = <fs_data> ).

        DATA(ti_catalogo) = cl_salv_controller_metadata=>get_lvc_fieldcatalog( r_columns      = o_tabla->get_columns( )
                                                                               r_aggregations = o_tabla->get_aggregations( ) ).

        LOOP AT ti_catalogo ASSIGNING FIELD-SYMBOL(<fs_es_catalogo>).

          <fs_es_catalogo>-reptext = <fs_es_catalogo>-fieldname.

        ENDLOOP.

        DATA(o_resultado) = cl_salv_ex_util=>factory_result_data_table( r_data         = i_ti
                                                                        t_fieldcatalog = ti_catalogo ).

        cl_salv_bs_tt_util=>if_salv_bs_tt_util~transform( EXPORTING
                                                            xml_type      = if_salv_bs_xml=>c_type_xlsx
                                                            xml_version   = cl_salv_bs_a_xml_base=>get_version( )
                                                            r_result_data = o_resultado
                                                            xml_flavour   = if_salv_bs_c_tt=>c_tt_xml_flavour_export
                                                            gui_type      = if_salv_bs_xml=>c_gui_type_gui
                                                          IMPORTING
                                                            xml           = r_xstring ).
      CATCH cx_root.
        CLEAR r_xstring.
    ENDTRY.
  ENDMETHOD.


  METHOD agregar_mensaje_respuestaodata.

    LOOP AT c_ti_mensajes ASSIGNING FIELD-SYMBOL(<fs_es_msg>).
      c_o_message_container->add_message(
        EXPORTING
          iv_msg_type               = <fs_es_msg>-type
          iv_msg_id                 = <fs_es_msg>-id
          iv_msg_number             = <fs_es_msg>-number
          iv_msg_v1                 = <fs_es_msg>-message_v1
          iv_msg_v2                 = <fs_es_msg>-message_v2
          iv_msg_v3                 = <fs_es_msg>-message_v3
          iv_msg_v4                 = <fs_es_msg>-message_v4
          iv_is_leading_message     = abap_true
          iv_add_to_response_header = abap_true ).
    ENDLOOP.

  ENDMETHOD.


  METHOD registrar_cdhdr_cdpos.

    DATA:
          ls_bapiret2 TYPE bapiret2.


    DATA:
      lv_message      TYPE sy-msgli,
      lv_objectid     TYPE cdhdr-objectid,
      lv_changenumber TYPE cdhdr-changenr.

*lv_OBJECTID = |{ ls_workarea_new-objek }{ ls_workarea_new-mafid }|.
    lv_objectid = i_objectid.

    "En primer lugar abrimos el documento de cambios, para esto utilizamos la siguiente función,
    "a la misma, le pasamos la clase y el ID del objeto:
    CALL FUNCTION 'CHANGEDOCUMENT_OPEN'
      EXPORTING
        objectclass      = i_objectclass "'MAT_FULL'
        objectid         = lv_objectid
      EXCEPTIONS
        sequence_invalid = 1.
    IF sy-subrc NE 0.
      CLEAR lv_message.
      MESSAGE ID sy-msgid
            TYPE sy-msgty
          NUMBER sy-msgno
            WITH sy-msgv1
                 sy-msgv2
                 sy-msgv3
                 sy-msgv4
            INTO lv_message.
      APPEND VALUE bapiret2(
      type        = sy-msgty
      id          = sy-msgid
      number      = sy-msgno
      message     = lv_message
      message_v1  = sy-msgv1
      message_v2  = sy-msgv2
      message_v3  = sy-msgv3
      message_v4  = sy-msgv4
      ) TO c_ti_bapiret2.
      RETURN.
    ENDIF.

*Luego, se llama a la función que identifica los campos modificados. Para esto se le tiene que pasar
*como parámetros el indicador de cambio, la tabla modificada, los valores
*modificados y los valores antes de la modificación:
    CALL FUNCTION 'CHANGEDOCUMENT_SINGLE_CASE'
      EXPORTING
        change_indicator       = i_change_indicator "'U'
        tablename              = i_reftablename     "'AUSP'
        workarea_new           = i_workarea_new
        workarea_old           = i_workarea_old
      EXCEPTIONS
        nametab_error          = 1
        open_missing           = 2
        position_insert_failed = 3.
    IF sy-subrc NE 0.
      CLEAR lv_message.
      MESSAGE ID sy-msgid
            TYPE sy-msgty
          NUMBER sy-msgno
            WITH sy-msgv1
                 sy-msgv2
                 sy-msgv3
                 sy-msgv4
            INTO lv_message.
      APPEND VALUE bapiret2(
      type        = sy-msgty
      id          = sy-msgid
      number      = sy-msgno
      message     = lv_message
      message_v1  = sy-msgv1
      message_v2  = sy-msgv2
      message_v3  = sy-msgv3
      message_v4  = sy-msgv4
      ) TO c_ti_bapiret2.
      RETURN.
    ENDIF.

*Por ultimo, se llama a la función para cerra el objeto de cambio:
    CALL FUNCTION 'CHANGEDOCUMENT_CLOSE'
      EXPORTING
        date_of_change          = sy-datum
        objectclass             = i_objectclass       "'MAT_FULL'
        objectid                = lv_objectid
        tcode                   = i_tcode
        time_of_change          = sy-uzeit
        username                = sy-uname
        object_change_indicator = i_change_indicator  "'U'
      IMPORTING
        changenumber            = lv_changenumber
      EXCEPTIONS
        header_insert_failed    = 1
        no_position_inserted    = 2
        object_invalid          = 3
        open_missing            = 4
        position_insert_failed  = 5.
    IF sy-subrc NE 0.
      CLEAR lv_message.
      MESSAGE ID sy-msgid
            TYPE sy-msgty
          NUMBER sy-msgno
            WITH sy-msgv1
                 sy-msgv2
                 sy-msgv3
                 sy-msgv4
            INTO lv_message.
      APPEND VALUE bapiret2(
      type        = sy-msgty
      id          = sy-msgid
      number      = sy-msgno
      message     = lv_message
      message_v1  = sy-msgv1
      message_v2  = sy-msgv2
      message_v3  = sy-msgv3
      message_v4  = sy-msgv4
      ) TO c_ti_bapiret2.
      RETURN.
    ENDIF.

    lv_changenumber = lv_changenumber.

  ENDMETHOD.


  METHOD get_componentes.
    DATA: o_ttdescribe              TYPE REF TO cl_abap_tabledescr,
          o_stdescribe              TYPE REF TO cl_abap_structdescr,
          o_eldescribe              TYPE REF TO cl_abap_elemdescr,
          ti_component_d            TYPE abap_component_tab,
          es_dfies                  TYPE dfies,
          indice_estructura_anidada TYPE i,
          ti_component              TYPE abap_component_tab,
          es_component              LIKE LINE OF ti_component.

    TRY.
        o_ttdescribe ?= cl_abap_structdescr=>describe_by_data( i_objeto ).
        o_stdescribe ?= o_ttdescribe->get_table_line_type( ).
      CATCH cx_sy_move_cast_error.
        o_stdescribe ?= cl_abap_structdescr=>describe_by_data( i_objeto ).
    ENDTRY.

    ti_component = o_stdescribe->get_components( ).
    "busca estructuras anidadas
    LOOP AT ti_component INTO es_component WHERE name = space OR as_include EQ abap_true.
      indice_estructura_anidada = sy-tabix.
      o_stdescribe ?=  es_component-type.
      APPEND LINES OF o_stdescribe->get_components( ) TO ti_component_d.

      "agrega componenes anidados
      INSERT LINES OF o_stdescribe->get_components( ) INTO ti_component INDEX indice_estructura_anidada.

    ENDLOOP.

    DELETE ti_component WHERE name = space.

    LOOP AT ti_component INTO es_component.

      " recupera descripcion del tipo
      TRY.
          o_eldescribe ?= es_component-type.
        CATCH cx_root.
          CONTINUE.
      ENDTRY.

      IF o_eldescribe->is_ddic_type( ) EQ abap_true.
        es_dfies = o_eldescribe->get_ddic_field( ).
      ELSE.
        es_dfies-leng = o_eldescribe->length.
        es_dfies-decimals = o_eldescribe->decimals.
        es_dfies-datatype = es_dfies-inttype = es_dfies-comptype = o_eldescribe->type_kind.
      ENDIF.

      APPEND VALUE #(  nombre  = es_component-name
                       estructura  = space
                       campo  = space
                       o_descripcion_elemento = o_eldescribe )
      TO r_ti_componentes.
    ENDLOOP.

  ENDMETHOD.


  METHOD convertir_a_texto_columna.
    r_texto_columna = to_mixed( replace( val = i_texto sub = i_separador with = ` ` occ = 0 ) ).
  ENDMETHOD.


  METHOD string_a_es.
    DATA: str_line                 TYPE string,
          o_stdescribe             TYPE REF TO cl_abap_structdescr,
          o_tabledescr             TYPE REF TO cl_abap_tabledescr,
          o_elm_des                TYPE REF TO cl_abap_elemdescr,
          ti_columnas_tabla_d      TYPE cl_abap_structdescr=>component_table,
          indice_columna           TYPE i,
          r_tipo_no_dato_permitido TYPE RANGE OF c.

    FIELD-SYMBOLS: <fs_dato>     TYPE any,
                   <fs_ti_datos> TYPE ANY TABLE.

    r_tipo_no_dato_permitido = VALUE #( sign = 'I' option = 'EQ' ( low = 'h' )
                                                                 ( low = 'u' )
                                                                 ( low = 'v' ) ).

    IF i_ti_componente_estructura IS INITIAL.
      TRY.

          o_stdescribe ?= cl_abap_structdescr=>describe_by_data( c_es_destino ).

          DATA(ti_componente_estructura) = o_stdescribe->get_components( ).

          "busca estructuras anidadas
          LOOP AT ti_componente_estructura INTO DATA(es_componente) WHERE name = space OR as_include EQ abap_true.
            o_stdescribe ?=  es_componente-type.
            APPEND LINES OF o_stdescribe->get_components( ) TO ti_columnas_tabla_d.
          ENDLOOP..

          DELETE ti_columnas_tabla_d WHERE name = space.
          "agrega componenes anidados
          APPEND LINES OF ti_columnas_tabla_d TO ti_componente_estructura.

          DELETE ti_componente_estructura WHERE name = space.

        CATCH cx_sy_move_cast_error ##NO_HANDLER.

      ENDTRY.

    ELSE.
      ti_componente_estructura = i_ti_componente_estructura.
    ENDIF.

    SPLIT i_str AT i_separador INTO TABLE DATA(ti_cadena_separada).

    DO.

      indice_columna = sy-index.

      UNASSIGN <fs_dato>.

      ASSIGN COMPONENT indice_columna OF STRUCTURE c_es_destino TO <fs_dato>.

      IF sy-subrc IS NOT INITIAL.
        IF lines( ti_componente_estructura ) = 1 AND c_es_destino IS NOT INITIAL.
          ASSIGN c_es_destino TO <fs_dato>.

          IF <fs_dato> IS NOT ASSIGNED OR indice_columna > lines( ti_componente_estructura ).
            EXIT.
          ENDIF.

        ELSE.
          EXIT.
        ENDIF.
      ENDIF.

      IF i_r_excluir_columnas IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name IN i_r_excluir_columnas.
        CONTINUE.
      ENDIF.
      "columnas que se excluyen
      IF i_caracter_exc_columna IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name(2) EQ i_caracter_exc_columna.
        CONTINUE.
      ENDIF.

      TRY.
          DESCRIBE FIELD <fs_dato> TYPE DATA(tp_componente).

          CHECK tp_componente NOT IN r_tipo_no_dato_permitido.

          ASSIGN ti_cadena_separada[ indice_columna ] TO FIELD-SYMBOL(<fs_valor_fuente>).

          CHECK sy-subrc IS INITIAL AND <fs_valor_fuente> IS ASSIGNED.

          IF tp_componente = 'P' AND i_remover_separador_decimales = abap_true.
            REPLACE ALL OCCURRENCES OF '.' IN <fs_valor_fuente> WITH space.
          ENDIF.

          <fs_dato> = <fs_valor_fuente>.

        CATCH cx_root.

      ENDTRY.

    ENDDO.

  ENDMETHOD.


  METHOD string_a_ti.

    DATA: r_es_destino TYPE REF TO data.

    IF i_fila_final = 0.
      i_fila_final = lines( i_ti_str ).
    ENDIF.

    LOOP AT i_ti_str INTO DATA(cadena_de_texto)
                     FROM i_fila_de_inicio TO i_fila_final.

      CREATE DATA r_es_destino LIKE LINE OF c_ti_destino.

      ASSIGN r_es_destino->* TO FIELD-SYMBOL(<fs_es_destino>).

      string_a_es(
        EXPORTING
          i_str                         = cadena_de_texto
          i_r_excluir_columnas          = i_r_excluir_columnas
          i_caracter_exc_columna        = i_caracter_exc_columna
          i_separador                   = i_separador
          i_incluir_encabezado          = i_incluir_encabezado
          i_longitud_texto_columna      = i_longitud_texto_columna
          i_ti_componente_estructura    = i_ti_componente_estructura
          i_remover_separador_decimales = i_remover_separador_decimales
        CHANGING
          c_es_destino                  = <fs_es_destino> ).

      INSERT <fs_es_destino> INTO TABLE c_ti_destino.

      FREE: r_es_destino.

    ENDLOOP.

  ENDMETHOD.
ENDCLASS.
"! <p class="shorttext synchronized" lang="ES">Utilidades transversales</p>
"! Utilidades de desarrollo ABAP
CLASS zclcxr1002_util DEFINITION
  PUBLIC
  CREATE PUBLIC .

  PUBLIC SECTION.

    TYPES:
      BEGIN OF gtp_es_tabla,
        nombre                 TYPE string,
        estructura             TYPE tabname,
        campo                  TYPE rollname,
        o_descripcion_elemento TYPE REF TO cl_abap_elemdescr,
      END OF gtp_es_tabla .
    TYPES:
      BEGIN OF gtp_es_datos_zip,
        nombre    TYPE string,
        contenido TYPE xstring,
      END OF gtp_es_datos_zip .
    TYPES:
      BEGIN OF gtp_es_smtp_addr,
        smtp_addr TYPE adr6-smtp_addr,
      END OF gtp_es_smtp_addr .
    TYPES:
      "! Tipo para las listas de distribución de email.
      BEGIN OF gtp_ld_emails,
        nombre_obj TYPE soodd-objnam,
      END OF gtp_ld_emails .
    TYPES:
      "! Tipo para los destinatarios de email.
      BEGIN OF gtp_destinatarios,
        tipo_dest TYPE zedtipodestinatario,
        ind_urge  TYPE sodm1-sndex,
        nombre    TYPE sodm1-memadrnam,
        email     TYPE sodm1-address,
      END OF gtp_destinatarios .
    TYPES:
      "! Tipo para la información completa de los adjuntos.
      BEGIN OF gtp_lista_adjuntos,
        titulo TYPE sood-objdes,
        tipo   TYPE so_obj_tp,
        dato   TYPE solix_tab,
      END OF gtp_lista_adjuntos .
    TYPES:
      gtp_ti_estructura_tabla TYPE STANDARD TABLE OF gtp_es_tabla WITH DEFAULT KEY .
    TYPES:
      gtp_ti_datos_zip        TYPE STANDARD TABLE OF gtp_es_datos_zip .
    TYPES:
      gtp_ti_xstring          TYPE STANDARD TABLE OF x255 WITH EMPTY KEY .
    TYPES:
      gtp_ti_string           TYPE STANDARD TABLE OF string WITH DEFAULT KEY .
    TYPES:
      gtp_r_string            TYPE RANGE OF string .
    TYPES:
      gtp_ti_i                TYPE RANGE OF i .
    TYPES:
      gtp_ti_smtp_addr        TYPE STANDARD TABLE OF gtp_es_smtp_addr .
    TYPES:
      gtp_ti_dato_binario     TYPE STANDARD TABLE OF solix .
    TYPES:
          "! Tipo tabla para las listas de distribución de correos.
      gtp_tt_ld_emails        TYPE STANDARD TABLE OF gtp_ld_emails WITH DEFAULT KEY .
    TYPES:
          "! Tipo tabla para los destinatarios de email.
      gtp_tt_destinatarios    TYPE STANDARD TABLE OF gtp_destinatarios WITH NON-UNIQUE DEFAULT KEY .
    TYPES:
          "! Tipo tabla para la lista de adjuntos.
      gtp_tt_lista_adjuntos   TYPE STANDARD TABLE OF gtp_lista_adjuntos WITH DEFAULT KEY .

    CONSTANTS gc_e TYPE bapi_mtype VALUE 'E' ##NO_TEXT.
    CONSTANTS gc_a TYPE bapi_mtype VALUE 'A' ##NO_TEXT.
    CONSTANTS gc_w TYPE bapi_mtype VALUE 'W' ##NO_TEXT.
    CONSTANTS gc_s TYPE bapi_mtype VALUE 'S' ##NO_TEXT.
    CONSTANTS gc_h TYPE bapi_mtype VALUE 'H' ##NO_TEXT.
    CONSTANTS gc_i TYPE bapi_mtype VALUE 'I' ##NO_TEXT.
    CONSTANTS gc_eq TYPE s_option VALUE 'EQ' ##NO_TEXT.
    CONSTANTS gc_ne TYPE s_option VALUE 'NE' ##NO_TEXT.
    CONSTANTS gc_bt TYPE s_option VALUE 'BT' ##NO_TEXT.
    CONSTANTS gc_cp TYPE s_option VALUE 'CP' ##NO_TEXT.
    CONSTANTS gc_sign TYPE fieldname VALUE 'SIGN' ##NO_TEXT.
    CONSTANTS gc_option TYPE fieldname VALUE 'OPTION' ##NO_TEXT.
    CONSTANTS gc_low TYPE fieldname VALUE 'LOW' ##NO_TEXT.
    CONSTANTS gc_high TYPE fieldname VALUE 'HIGH' ##NO_TEXT.
    CONSTANTS gc_nodata TYPE c VALUE '/' ##NO_TEXT.
    CONSTANTS gc_x TYPE char01 VALUE 'X' ##NO_TEXT.
    CONSTANTS gc_to TYPE zedtipodestinatario VALUE 'TO' ##NO_TEXT.
    CONSTANTS gc_cc TYPE zedtipodestinatario VALUE 'CC' ##NO_TEXT.
    CONSTANTS gc_bcc TYPE zedtipodestinatario VALUE 'BCC' ##NO_TEXT.
    CLASS-DATA gti_componentes_es TYPE abap_component_tab .
    CLASS-DATA gti_datos_totalizar TYPE REF TO data .

    "! Devuelve los valores fijos de un dominio
    "!
    "! @parameter i_nombre_dominio |
    "! @parameter r_ti_valores |
    CLASS-METHODS get_valores_dominio
      IMPORTING
        !i_nombre_dominio   TYPE ddobjname
      RETURNING
        VALUE(r_ti_valores) TYPE dd07v_tab .
    "! Recupera el valor de un tag particular de un XML
    "!
    "! @parameter i_xml |
    "! @parameter i_tag |
    "! @parameter r_ti_tag |
    CLASS-METHODS get_tag_xml
      IMPORTING
        !i_xml          TYPE string
        VALUE(i_tag)    TYPE string
      RETURNING
        VALUE(r_ti_tag) TYPE gtp_ti_string .
    "! Retorna una referencia nueva de una variable
    "! @parameter i_ti |
    "! @parameter r_ti_o |
    CLASS-METHODS get_nueva_referencia
      IMPORTING
        VALUE(i_ti)   TYPE ANY TABLE
      RETURNING
        VALUE(r_ti_o) TYPE REF TO data .
    "! Convierte el contenido de una tabla interna
    "! en una cadena de texto (String)
    "!
    "! @parameter i_ti |
    "! @parameter i_r_excluir_columnas | Nombre de columnas a excluir
    "! @parameter i_omitir_salto_linea |
    "! @parameter i_caracter_exc_columna | Caracter que identifica las columnas que no se tendran en cuenta en la conversion
    "! @parameter i_separador | Caracter mediante el cual se separaran los valores en cada columna
    "! @parameter i_incluir_encabezado | Incluye en la primera línea el texto de las columnas o descripciones
    "! @parameter i_tam_txt_columna | El tamaño de los textos de las columnas a incluir (Large, Medium, Small, Otro:Nombre Columna)
    "! @parameter r_str | Cadena de texto con contendio de tabla interna
    CLASS-METHODS ti_a_string
      IMPORTING
        !i_ti                         TYPE ANY TABLE
        !i_r_excluir_columnas         TYPE gtp_r_string OPTIONAL
        !i_omitir_salto_linea         TYPE flag DEFAULT abap_false
        !i_caracter_exc_columna       TYPE string OPTIONAL
        !i_separador                  TYPE string DEFAULT ';'
        !i_separador_como_salto_linea TYPE flag DEFAULT abap_false
        !i_incluir_encabezado         TYPE flag DEFAULT abap_false
        !i_tam_txt_columna            TYPE char01 OPTIONAL
      RETURNING
        VALUE(r_str)                  TYPE string .
    "! Convierte el contenido de una tabla interna
    "! en una cadena de texto (String)
    "!
    "! @parameter i_es |
    "! @parameter i_r_excluir_columnas | Nombre de columnas a excluir
    "! @parameter i_caracter_exc_columna | Caracter que identifica las columnas que no se tendran en cuenta en la conversion
    "! @parameter i_separador | Caracter mediante el cual se separaran los valores en cada columna
    "! @parameter i_incluir_encabezado | Incluye en la primera línea el texto de las columnas o descripciones
    "! @parameter i_longitud_texto_columna | El tamaño de los textos de las columnas a incluir (Large, Medium, Small, Otro:Nombre Columna)
    "! @parameter r_str | Cadena de texto con contendio de tabla interna
    "! @parameter i_ti_componente_estructura | Nombres de las columnas
    CLASS-METHODS es_a_string
      IMPORTING
        !i_es                       TYPE any
        !i_r_excluir_columnas       TYPE gtp_r_string OPTIONAL
        !i_caracter_exc_columna     TYPE string OPTIONAL
        !i_separador                TYPE string DEFAULT ';'
        !i_incluir_encabezado       TYPE flag DEFAULT abap_false
        !i_longitud_texto_columna   TYPE char01 OPTIONAL
        !i_ti_componente_estructura TYPE cl_abap_structdescr=>component_table OPTIONAL
      RETURNING
        VALUE(r_str)                TYPE string .

    CLASS-METHODS string_a_ti
      IMPORTING
        VALUE(i_ti_str)               TYPE string_t
        i_fila_de_inicio              TYPE i DEFAULT 1
        VALUE(i_fila_final)           TYPE i DEFAULT 0
        !i_r_excluir_columnas         TYPE gtp_r_string OPTIONAL
        !i_caracter_exc_columna       TYPE string OPTIONAL
        !i_separador                  TYPE string DEFAULT ';'
        !i_incluir_encabezado         TYPE flag DEFAULT abap_false
        i_remover_separador_decimales TYPE flag DEFAULT abap_false
        !i_longitud_texto_columna     TYPE char01 OPTIONAL
        !i_ti_componente_estructura   TYPE cl_abap_structdescr=>component_table OPTIONAL
      CHANGING
        !c_ti_destino                 TYPE ANY TABLE.

    CLASS-METHODS string_a_es
      IMPORTING
        VALUE(i_str)                  TYPE string
        !i_r_excluir_columnas         TYPE gtp_r_string OPTIONAL
        !i_caracter_exc_columna       TYPE string OPTIONAL
        !i_separador                  TYPE string DEFAULT ';'
        !i_incluir_encabezado         TYPE flag DEFAULT abap_false
        i_remover_separador_decimales TYPE flag DEFAULT abap_false
        !i_longitud_texto_columna     TYPE char01 OPTIONAL
        !i_ti_componente_estructura   TYPE cl_abap_structdescr=>component_table OPTIONAL
      CHANGING
        !c_es_destino                 TYPE any.
    "! Enviar correo mediante la clase CL_BCS
    "!
    "! @parameter i_ti_destinatarios |
    "! @parameter i_ti_texto_cuerpo_correo |
    "! @parameter i_asunto |
    "! @parameter i_titulo_adjunto |
    "! @parameter i_tipo_adjunto |
    "! @parameter c_ti_dato_binario |
    "! @parameter i_commit |
    "! @parameter i_contenido_binario_adjunto |
    CLASS-METHODS enviar_correo
      IMPORTING
        !i_ti_destinatarios          TYPE gtp_ti_smtp_addr
        !i_ti_texto_cuerpo_correo    TYPE soli_tab
        !i_asunto                    TYPE so_obj_des
        !i_titulo_adjunto            TYPE sood-objdes OPTIONAL
        !i_tipo_adjunto              TYPE so_obj_tp DEFAULT 'BIN'
        !i_commit                    TYPE flag DEFAULT abap_true
        !i_contenido_binario_adjunto TYPE xstring OPTIONAL
        !i_tipo_documento            TYPE char03 DEFAULT 'RAW'
        !i_from                      TYPE sy-uname DEFAULT sy-uname
        !i_ti_attachment_header      TYPE soli_tab OPTIONAL
        !i_dimension_adjunto         TYPE so_obj_len OPTIONAL
      CHANGING
        !c_ti_dato_binario           TYPE gtp_ti_dato_binario OPTIONAL .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Envia correo avanzado mediante la clase CL_BCS, método mejorado con
    "! respecto al original (ENVIAR_CORREO), acepta como parámetro una lista
    "! de distribución de correos y también soporta múltiples adjuntos.
    "! </p>
    "! <strong>Identificador:</strong>
    "! E00XXX
    "! <br/>
    "! <strong>Autor:</strong>
    "! René Duque
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 04.01.2022  \ S4DK905655 \ René Duque \ Creacion Inicial \
    "!
    "! @parameter i_ti_destinatarios | Destinatarios
    "! @parameter i_ti_ld_emails | Listas de distribución de correos
    "! @parameter i_ti_texto_cuerpo_correo | Cuerpo del correo
    "! @parameter i_asunto | Asunto
    "! @parameter i_ti_lista_adjuntos | Lista de adjuntos
    "! @parameter i_commit_work | Ejecutar el commit de manera explícita
    "! @parameter e_es_msg_error | Mensaje de error generado
    CLASS-METHODS enviar_correo_av
      IMPORTING
        !i_ti_destinatarios       TYPE gtp_tt_destinatarios OPTIONAL
        !i_ti_ld_emails           TYPE gtp_tt_ld_emails OPTIONAL
        !i_remitente              TYPE uname DEFAULT sy-uname
        !i_ti_texto_cuerpo_correo TYPE soli_tab
        !i_asunto                 TYPE so_obj_des
        !i_ti_lista_adjuntos      TYPE gtp_tt_lista_adjuntos OPTIONAL
        !i_commit_work            TYPE abap_bool DEFAULT abap_true
      EXPORTING
        !e_es_msg_error           TYPE bapiret2 .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Consulta las cuentas de correo electrónico agregadas en una o varias
    "! listas de distribución de correos. Entrega una tabla con formato de
    "! correo con tipo de destinatario (To, Cc, Bcc).
    "! </p>
    "! <strong>Identificador:</strong>
    "! E00XXX
    "! <br/>
    "! <strong>Autor:</strong>
    "! René Duque
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 04.01.2022  \ S4DK905655 \ René Duque \ Creacion Inicial \
    "!
    "! @parameter i_ti_ld_emails | Listas de distribución de correos
    "! @parameter e_ti_destinatarios | Destinatarios
    "! @parameter e_es_msg_error | Mensaje de error
    CLASS-METHODS consultar_listas_distribucion
      IMPORTING
        !i_ti_ld_emails     TYPE gtp_tt_ld_emails
      EXPORTING
        !e_ti_destinatarios TYPE gtp_tt_destinatarios
        !e_es_msg_error     TYPE bapiret2 .
    "! Crear archivo ZIP
    "!
    "! @parameter i_ti_contenido_zip | Nombre del archivo y contenido binario
    "! @parameter e_longitud_salida | Longitud del archivo generado
    "! @parameter e_ti_binario | Archivo ZIP en formato binario
    CLASS-METHODS crear_archivo_zip
      IMPORTING
        !i_ti_contenido_zip TYPE gtp_ti_datos_zip
      EXPORTING
        !e_longitud_salida  TYPE i
        !e_ti_binario       TYPE gtp_ti_xstring .
    "! Construye un catalogo del tipo lvc_t_fcat a partir de una tabla interna
    "!
    "! @parameter i_ti |
    "! @parameter i_optimizar_columnas |
    "! @parameter i_cfieldname | Columna de referencia para lo valores tipo moneda
    "! @parameter i_qfieldname | Columna de referencia para lo valores tipo unidad de medida
    "! @parameter r_ti_catalogo |
    "! @parameter i_conservar_indice_es_anidada | Conservar posicion de las estructuras internas tipo INCLUDE
    "! @raising cx_dynamic_check |
    "! @raising cx_static_check |
    CLASS-METHODS construir_catalogo
      IMPORTING
        !i_ti                         TYPE data
        !i_optimizar_columnas         TYPE flag OPTIONAL
        !i_cfieldname                 TYPE string DEFAULT 'CURRENCY'
        !i_qfieldname                 TYPE string OPTIONAL
        i_conservar_indice_es_anidada TYPE flag DEFAULT space
      RETURNING
        VALUE(r_ti_catalogo)          TYPE lvc_t_fcat
      RAISING
        cx_dynamic_check
        cx_static_check .
    "! Crea una tabla interna segun la estructura enviada en el parametro
    "! i_ti_campos[nombre : Nombre de columan, estructura : Estructura de referncia en Diccionario de datos, campo: Campo en estructura o elemento de datos]
    "!
    "! @parameter c_ti_campos | Nombre de campos y tipo
    "! @parameter r_ti | tabla interna con estructura definida
    CLASS-METHODS crear_ti_dinamica
      IMPORTING
        VALUE(i_valores_unicos)    TYPE abap_bool DEFAULT abap_false
        VALUE(i_ti_clave)          TYPE abap_keydescr_tab OPTIONAL
        VALUE(i_tipo_clave)        TYPE abap_keydefkind DEFAULT cl_abap_tabledescr=>keydefkind_user
        VALUE(i_tipo_tabla)        TYPE abap_tablekind DEFAULT cl_abap_tabledescr=>tablekind_std
        i_omitir_conversion_tipo_p TYPE flag DEFAULT space
      CHANGING
        !c_ti_campos               TYPE gtp_ti_estructura_tabla
      RETURNING
        VALUE(r_ti)                TYPE REF TO data
      RAISING
        cx_sy_struct_creation
        cx_dynamic_check
        cx_static_check .

    "! <strong>Descripción:</strong>
    "! <p>
    "! Recueperar los componentes y su tipo de una estructura o de una tabla interna.<br/>
    "! El metodo tiene la capacidad de extraer los componentes de estructuras con INCLUDE
    "! </p>
    "! <strong>Identificador:</strong>
    "! No Aplica
    "! <br/>
    "! <strong>Autor:</strong>
    "! Sebastian Londono
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 20.01.2024  \ S4DK917548 \ Sebastian Londono \ Creacion Inicial \
    "!
    "! @parameter i_objeto | Estructura o Tabla Interna
    "! @parameter r_ti_componentes | retorna los componentes y su tipo
    CLASS-METHODS get_componentes
      IMPORTING
        i_objeto                TYPE data
      RETURNING
        VALUE(r_ti_componentes) TYPE gtp_ti_estructura_tabla.

    "! <strong>Descripción:</strong>
    "! <p>
    "! Convertir nombre de componente de estructura o tabla interna separado por _ en<br/>
    "! texto para visualizar en columna de ALV por ejemplo
    "! </p>
    "! <strong>Identificador:</strong>
    "! No Aplica
    "! <br/>
    "! <strong>Autor:</strong>
    "! Sebastian Londono
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 20.01.2024  \ S4DK917548 \ Sebastian Londono \ Creacion Inicial \
    "!
    "! @parameter i_texto |
    "! @parameter r_texto_columna |
    CLASS-METHODS convertir_a_texto_columna
      IMPORTING
        VALUE(i_texto)         TYPE string
        i_separador            TYPE string DEFAULT '_'
      RETURNING
        VALUE(r_texto_columna) TYPE string.

    CLASS-METHODS set_entrada_rango
      IMPORTING
        !i_sign                         TYPE s_sign DEFAULT gc_i
        !i_option                       TYPE s_option DEFAULT gc_eq
        !i_low                          TYPE any OPTIONAL
        !i_high                         TYPE any OPTIONAL
        !i_convertir_in                 TYPE flag OPTIONAL
        !i_convertir_out                TYPE flag OPTIONAL
        !i_completar_cp                 TYPE flag OPTIONAL
        !i_caracter_divide_valor_x_fila TYPE string OPTIONAL
        !i_eliminar_valores_iniciales   TYPE flag DEFAULT abap_true
        !i_remover_espacios             TYPE flag OPTIONAL
      CHANGING
        !c_ti_rango                     TYPE ANY TABLE .
    "! Construye un rango a partir de una cadena de texto
    "! separada por un caracter especifico
    "!
    "! @parameter i_cadena | Cadena con string a convertir
    "! @parameter i_separador | Separador de cadena
    "! @parameter c_ti_rango | Rango con datos, estructura [SIGN OPTION LOW HIGH]
    "! @parameter i_remover_espacios | elimina espacios al inicio y final de la cadena
    "!
    "! @raising cx_sy_assign_cast_illegal_cast |
    CLASS-METHODS crear_rango_division
      IMPORTING
        !i_cadena           TYPE any
        !i_separador        TYPE char1 DEFAULT ';'
        !i_convertir_in     TYPE flag OPTIONAL
        !i_convertir_out    TYPE flag OPTIONAL
        !i_remover_espacios TYPE flag OPTIONAL
      CHANGING
        !c_ti_rango         TYPE ANY TABLE
      RAISING
        cx_sy_assign_cast_illegal_cast .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Construye un rango de forma dinamica.<br/>
    "! La fuente de datos puede ser un valor siemple o a partir de una tabla interna
    "! </p>
    "! <strong>Identificador:</strong>
    "! E00XXX
    "! <br/>
    "! <strong>Autor:</strong>
    "! Sebastian Londono
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 20.01.2021  \ S4DK900021 \ Sebastian Londono \ Creacion Inicial \
    "!
    "! @parameter i_sign | Valor SIGN
    "! @parameter i_option | Valor OPTION
    "! @parameter i_low | Valor LOW
    "! @parameter i_high | Valor HIGH
    "! @parameter i_ti | Tabla interna con datos. Si suministra este parametro los anteriores seran omitidos
    "! @parameter i_nombre_columna | Columna del parametro i_ti que se desea convertir a rango
    "! @parameter i_convertir_in  | Aplicar funcion CONVERSION_EXIT_ALPHA_INPUT a valores LOW y HIGH
    "! @parameter i_convertir_out | Aplicar funcion CONVERSION_EXIT_ALPHA_OUT a valores LOW y HIGH
    "! @parameter i_no_ordenar | No ordena el rango
    "! @parameter i_no_eliminar_duplicados | No eliminar valores duplicados
    "! @parameter i_remover_espacios | elimina espacios al inicio y final de la cadena
    "! @parameter c_ti_rango | Tabla interna tipo rango. Estructura [SIGN OPTION LOW HIGH]
    CLASS-METHODS crear_rango
      IMPORTING
        !i_sign                         TYPE s_sign DEFAULT gc_i
        !i_option                       TYPE s_option DEFAULT gc_eq
        !i_low                          TYPE any OPTIONAL
        !i_high                         TYPE any OPTIONAL
        !i_ti                           TYPE ANY TABLE OPTIONAL
        !i_nombre_columna               TYPE string OPTIONAL
        !i_convertir_in                 TYPE flag OPTIONAL
        !i_convertir_out                TYPE flag OPTIONAL
        !i_eliminar_valores_iniciales   TYPE flag DEFAULT abap_true
        !i_completar_cp                 TYPE flag OPTIONAL
        !i_caracter_divide_valor_x_fila TYPE string OPTIONAL
        !i_no_ordenar                   TYPE flag OPTIONAL
        !i_no_eliminar_duplicados       TYPE flag OPTIONAL
        !i_remover_espacios             TYPE flag OPTIONAL
      CHANGING
        !c_ti_rango                     TYPE ANY TABLE OPTIONAL .
    "! <strong>Descripción:</strong>
    "! <p>
    "! Completar datos de Rango<br/>
    "! <strong>Identificador: </strong> R1002
    "! <br/>
    "! <strong>Autor:</strong>
    "! Sebastian Londono
    "! <br/>
    "! <strong>Historial de cambios:
    "! <br/><br/>
    "! \___Fecha___\____CR#____\________Autor________\_____Modificación_____\
    "! </strong><br/>
    "! \ 20.01.2021  \ S4DK900021 \ Sebastian Londono \ Creacion Inicial \
    "!
    "! @parameter i_convertir_in  | Aplicar funcion CONVERSION_EXIT_ALPHA_INPUT a valores LOW y HIGH
    "! @parameter i_convertir_out | Aplicar funcion CONVERSION_EXIT_ALPHA_OUT a valores LOW y HIGH
    "! @parameter c_ti_rango | Tabla interna tipo rango. Estructura [SIGN OPTION LOW HIGH]
    CLASS-METHODS completar_rango
      IMPORTING
        !i_convertir_in  TYPE flag OPTIONAL
        !i_convertir_out TYPE flag OPTIONAL
      CHANGING
        !c_ti_rango      TYPE ANY TABLE OPTIONAL .
    "! Ayuda de busqueda para Layout de ALV en Selection Screen
    "! @parameter c_layout | Datos del Layout
    CLASS-METHODS f4_layout
      IMPORTING
        !i_report TYPE syrepid DEFAULT sy-repid
      CHANGING
        !c_layout TYPE disvariant-variant .
    "! Marca una estructura con X basado en los campos de una estructura origen.
    "! Ideal para mapeo de BAPIs
    "! @parameter i_es_origen | Estructura con datos
    "! @parameter c_es_destino | Estructura que se marcara con X basada en la estructura origen
    CLASS-METHODS asignar_marcado_estructura
      IMPORTING
        !i_es_origen                  TYPE any
        !i_prefijo_estructura_destino TYPE string OPTIONAL
      CHANGING
        !c_es_destino                 TYPE any .
    CLASS-METHODS asignar_porcentaje_br_progreso
      IMPORTING
        !i_porcentaje TYPE i
        !i_texto      TYPE string .
    CLASS-METHODS inicializar_totalizacion_es .
    CLASS-METHODS totalizar_estructura
      IMPORTING
        !i_inicializar           TYPE flag OPTIONAL
        VALUE(i_r_excluir_campo) TYPE gtp_r_string OPTIONAL
        VALUE(i_ti_campo_clave)  TYPE abap_keydescr_tab OPTIONAL
      CHANGING
        !c_es                    TYPE any .
    CLASS-METHODS aplicar_conversion_campo
      IMPORTING
        VALUE(i_exit)  TYPE string
        !i_fila        TYPE i OPTIONAL
        VALUE(i_valor) TYPE any OPTIONAL
      CHANGING
        !c_valor       TYPE any OPTIONAL .
    CLASS-METHODS validar_dominio
      IMPORTING
        VALUE(i_dominio) TYPE dd01l-domname
        VALUE(i_valor)   TYPE string
      RETURNING
        VALUE(r_valor)   TYPE string
      RAISING
        cx_t100_msg .
    CLASS-METHODS formato_fecha_ddmmyyyy
      CHANGING
        !c_fecha TYPE any .
    CLASS-METHODS ti_a_xstring
      IMPORTING
        !i_ti            TYPE REF TO data
      RETURNING
        VALUE(r_xstring) TYPE xstring .
    CLASS-METHODS zfsh_api_get_stock_req_list
      IMPORTING
        !article                   TYPE matnr18 OPTIONAL
        !plant                     TYPE werks_d
        !berid                     TYPE berid OPTIONAL
        !mrp_status                TYPE fsh_tt_mrp_stat_range OPTIONAL
        !stock_element             TYPE fsh_stock_delkz OPTIONAL
        !stock_number              TYPE fsh_bsnr OPTIONAL
        !stock_item                TYPE fsh_hbsp OPTIONAL
        !stock_schedule_line       TYPE etenr OPTIONAL
        !requirement_element       TYPE fsh_req_delkz OPTIONAL
        !requirement_number        TYPE delnr OPTIONAL
        !requirement_item          TYPE posnr OPTIONAL
        !requirement_schedule_line TYPE etenr OPTIONAL
        !article_long              TYPE matnr40 OPTIONAL
      CHANGING
        !et_stock_requirement_list TYPE fsh_tt_stock_req_list .
    CLASS-METHODS agregar_mensaje_respuestaodata
      IMPORTING
        !i_msj_en_cuerpo_respuesta   TYPE flag DEFAULT abap_true
        !i_msj_en_cabecera_respuesta TYPE flag DEFAULT abap_false
      CHANGING
        !c_ti_mensajes               TYPE bapiret2_t
        !c_o_message_container       TYPE REF TO /iwbep/if_message_container .
    CLASS-METHODS registrar_cdhdr_cdpos
      IMPORTING
        !i_objectclass      TYPE cdobjectcl
        !i_objectid         TYPE cdobjectv
        !i_change_indicator TYPE char1 DEFAULT 'U'
        !i_reftablename     TYPE tabname
        !i_workarea_old     TYPE any
        !i_workarea_new     TYPE any
        !i_tcode            TYPE sytcode DEFAULT sy-tcode
      CHANGING
        !c_ti_bapiret2      TYPE bapiret2_tab .
  PROTECTED SECTION.

  PRIVATE SECTION.
    CLASS-METHODS asignar_tipo_componente
      IMPORTING
        i_omitir_conversion_tipo_p TYPE flag OPTIONAL
      CHANGING
        c_ti_campos                TYPE gtp_ti_estructura_tabla OPTIONAL
      EXCEPTIONS
        cx_root .

ENDCLASS.



CLASS ZCLCXR1002_UTIL IMPLEMENTATION.


  METHOD construir_catalogo.

    DATA: o_ttdescribe              TYPE REF TO cl_abap_tabledescr,
          o_stdescribe              TYPE REF TO cl_abap_structdescr,
          o_eldescribe              TYPE REF TO cl_abap_elemdescr,
          ti_component_d            TYPE abap_component_tab,
          es_dfies                  TYPE dfies,
          index                     TYPE i,
          indice_estructura_anidada TYPE i,
          ti_component              TYPE abap_component_tab,
          es_component              LIKE LINE OF ti_component.

    FIELD-SYMBOLS: <fs_catalog> TYPE lvc_s_fcat.

    o_ttdescribe ?= cl_abap_structdescr=>describe_by_data( i_ti ).
    o_stdescribe ?= o_ttdescribe->get_table_line_type( ).

    ti_component = o_stdescribe->get_components( ).
    "busca estructuras anidadas
    LOOP AT ti_component INTO es_component WHERE name = space OR as_include EQ abap_true.
      indice_estructura_anidada = sy-tabix.
      o_stdescribe ?=  es_component-type.
      APPEND LINES OF o_stdescribe->get_components( ) TO ti_component_d.
    ENDLOOP..

    DELETE ti_component WHERE name = space.
    "agrega componenes anidados
    IF i_conservar_indice_es_anidada = abap_true
    AND ti_component_d IS NOT INITIAL.
      IF indice_estructura_anidada <= 0.
        indice_estructura_anidada = 1.
      ENDIF.
      INSERT LINES OF ti_component_d INTO ti_component INDEX indice_estructura_anidada.
    ELSE.
      APPEND LINES OF ti_component_d TO ti_component.
    ENDIF.

    LOOP AT ti_component INTO es_component.
      index = sy-tabix.
      CLEAR: es_dfies.

      " recupera descripcion del tipo
      TRY.
          o_eldescribe ?= es_component-type.
        CATCH cx_root.
          CONTINUE.
      ENDTRY.

      IF o_eldescribe->is_ddic_type( ) EQ abap_true.
        es_dfies = o_eldescribe->get_ddic_field( ).
      ELSE.
        es_dfies-leng = o_eldescribe->length.
        es_dfies-decimals = o_eldescribe->decimals.
        es_dfies-datatype = es_dfies-inttype = es_dfies-comptype = o_eldescribe->type_kind.
      ENDIF.

      APPEND INITIAL LINE TO r_ti_catalogo ASSIGNING <fs_catalog>.

      MOVE-CORRESPONDING es_dfies TO <fs_catalog>.

      IF es_component-name EQ 'MANDT'.
        <fs_catalog>-tech = abap_true.
      ENDIF.
      "{ Inicio SGR 08.01.2025 | Comentar porque genera error al generar totalizados
*      IF es_dfies-datatype = 'CURR'.
*        <fs_catalog>-cfieldname = i_cfieldname.
*      ENDIF.
      "{ Fin SGR 08.01.2025

      IF es_dfies-datatype = 'MEINS'.
        <fs_catalog>-qfieldname = i_qfieldname.
      ENDIF.

      <fs_catalog>-fieldname  = es_component-name.
      <fs_catalog>-dd_outlen = <fs_catalog>-intlen = es_dfies-leng.
      <fs_catalog>-outputlen = '0'.
      <fs_catalog>-col_opt = i_optimizar_columnas.
      <fs_catalog>-col_pos = index.
      <fs_catalog>-tabname = '1'.

      IF es_component-name = 'ICON'.
        <fs_catalog>-icon = abap_true.
      ELSE.
        <fs_catalog>-icon =  abap_false.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD crear_rango.

    FIELD-SYMBOLS: <fs_val>    TYPE any,
                   <fs_es_val> TYPE any.

    IF i_ti IS NOT INITIAL.
      LOOP AT i_ti ASSIGNING <fs_es_val>.

        UNASSIGN <fs_val>.

        IF i_nombre_columna IS NOT INITIAL.
          ASSIGN COMPONENT i_nombre_columna OF STRUCTURE <fs_es_val> TO <fs_val>.
        ELSE.
          ASSIGN <fs_es_val> TO <fs_val>.
        ENDIF.

        CHECK <fs_val> IS ASSIGNED.

        set_entrada_rango(
          EXPORTING
            i_sign                         = i_sign
            i_option                       = i_option
            i_low                          = <fs_val>
            i_convertir_in                 = i_convertir_in
            i_convertir_out                = i_convertir_out
            i_completar_cp                 = i_completar_cp
            i_caracter_divide_valor_x_fila = i_caracter_divide_valor_x_fila
            i_remover_espacios             = i_remover_espacios
          CHANGING
            c_ti_rango                     = c_ti_rango ).
      ENDLOOP.
    ELSEIF i_low IS NOT INITIAL OR i_high IS NOT INITIAL.
      set_entrada_rango(
        EXPORTING
          i_sign                         = i_sign
          i_option                       = i_option
          i_low                          = i_low
          i_high                         = i_high
          i_convertir_in                 = i_convertir_in
          i_convertir_out                = i_convertir_out
          i_completar_cp                 = i_completar_cp
          i_caracter_divide_valor_x_fila = i_caracter_divide_valor_x_fila
          i_remover_espacios             = i_remover_espacios
        CHANGING
          c_ti_rango                     = c_ti_rango ).

    ENDIF.
    "Omitir estas sentencias puede ayudar en el performance
    IF i_no_ordenar = abap_false.
      SORT c_ti_rango.
    ENDIF.
    IF i_no_eliminar_duplicados = abap_false.
      DELETE ADJACENT DUPLICATES FROM c_ti_rango COMPARING ALL FIELDS.
    ENDIF.

    IF i_eliminar_valores_iniciales = abap_true.
      DELETE c_ti_rango WHERE ('LOW = space and HIGH = space').
    ENDIF.

  ENDMETHOD.


  METHOD crear_rango_division.
    DATA: str     TYPE string,
          ti_data TYPE TABLE OF string.

    DATA: obj_it_desc TYPE REF TO cl_abap_tabledescr.

    FIELD-SYMBOLS: <fs_it_aux> TYPE ANY TABLE.

    ASSIGN: c_ti_rango TO <fs_it_aux>.

    SPLIT i_cadena AT i_separador INTO TABLE ti_data.

    obj_it_desc ?= cl_abap_tabledescr=>describe_by_data( <fs_it_aux> ).

    READ TABLE obj_it_desc->key TRANSPORTING NO FIELDS
                                WITH KEY name = gc_sign.

    IF sy-subrc IS INITIAL.
      LOOP AT ti_data INTO str.

        set_entrada_rango(
          EXPORTING
            i_low              = str
            i_convertir_in     = i_convertir_in
            i_convertir_out    = i_convertir_out
            i_remover_espacios = i_remover_espacios
          CHANGING
            c_ti_rango         = c_ti_rango ).

      ENDLOOP.
    ENDIF.
  ENDMETHOD.


  METHOD set_entrada_rango.

    DATA: lv_data TYPE REF TO data.

    FIELD-SYMBOLS: <fs_wa_st> TYPE any,
                   <fs_value> TYPE any.

    CREATE DATA lv_data LIKE LINE OF c_ti_rango.

    ASSIGN lv_data->* TO <fs_wa_st>.

    CHECK sy-subrc EQ 0.

    ASSIGN COMPONENT gc_sign OF STRUCTURE <fs_wa_st> TO <fs_value>.

    CHECK sy-subrc EQ 0.

    MOVE i_sign TO <fs_value>.

    ASSIGN COMPONENT gc_option OF STRUCTURE <fs_wa_st> TO <fs_value>.

    IF i_high IS NOT INITIAL AND i_low IS NOT INITIAL.
      <fs_value> = gc_bt.
    ELSE.
      <fs_value> = i_option.
    ENDIF.

    ASSIGN COMPONENT gc_low OF STRUCTURE <fs_wa_st> TO <fs_value>.
    MOVE i_low TO <fs_value>.

    IF i_remover_espacios = abap_true.
      CONDENSE <fs_value>.
    ENDIF.

    IF  i_convertir_in = abap_true.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = <fs_value>
        IMPORTING
          output = <fs_value>.
    ENDIF.

    IF  i_convertir_out = abap_true.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          input  = <fs_value>
        IMPORTING
          output = <fs_value>.
    ENDIF.

    IF i_completar_cp  = abap_true AND <fs_value> IS NOT INITIAL.
      CONCATENATE '*' <fs_value> '*'
      INTO <fs_value>.
    ENDIF.

    ASSIGN COMPONENT gc_high OF STRUCTURE <fs_wa_st> TO <fs_value>.
    MOVE i_high TO <fs_value>.

    IF i_remover_espacios = abap_true.
      CONDENSE <fs_value>.
    ENDIF.

    IF  i_convertir_in = abap_true.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = <fs_value>
        IMPORTING
          output = <fs_value>.
    ENDIF.

    IF  i_convertir_out = abap_true.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          input  = <fs_value>
        IMPORTING
          output = <fs_value>.
    ENDIF.

    IF i_completar_cp  = abap_true AND <fs_value> IS NOT INITIAL.
      CONCATENATE '*' <fs_value> '*'
      INTO <fs_value>.
    ENDIF.

    IF i_caracter_divide_valor_x_fila IS INITIAL.
      INSERT <fs_wa_st> INTO TABLE c_ti_rango.
    ELSE.
      "dividir un valor en varias filas
      SPLIT i_low AT i_caracter_divide_valor_x_fila INTO TABLE DATA(ti_valores_divididos).

      LOOP AT ti_valores_divididos ASSIGNING FIELD-SYMBOL(<fs_es_valor>).

        crear_rango(
          EXPORTING
            i_sign                       = i_sign
            i_option                     = i_option
            i_low                        = <fs_es_valor>
            i_convertir_in               = i_convertir_in
            i_convertir_out              = i_convertir_out
            i_eliminar_valores_iniciales = i_eliminar_valores_iniciales
            i_completar_cp               = i_completar_cp
          CHANGING
            c_ti_rango                   = c_ti_rango ).

      ENDLOOP.

    ENDIF.

  ENDMETHOD.


  METHOD crear_ti_dinamica.
    DATA :
      " declaración de RTTS
      o_struct_typ TYPE REF TO cl_abap_datadescr,
      o_dintbl_typ TYPE REF TO cl_abap_tabledescr,
      ti_component TYPE cl_abap_structdescr=>component_table.

    "recupera información de tipo de dato
    asignar_tipo_componente( EXPORTING i_omitir_conversion_tipo_p = i_omitir_conversion_tipo_p
                             CHANGING  c_ti_campos                = c_ti_campos ).

    ti_component = VALUE #( FOR es_campos IN c_ti_campos
                            ( name = es_campos-nombre
                              type = es_campos-o_descripcion_elemento ) ).

    o_struct_typ ?= cl_abap_structdescr=>create( p_components = ti_component ).
    o_dintbl_typ = cl_abap_tabledescr=>create( p_line_type  = o_struct_typ
                                               p_table_kind = i_tipo_tabla
                                               p_unique     = i_valores_unicos
                                               p_key        = i_ti_clave
                                               p_key_kind   = i_tipo_clave ).

    CREATE DATA: r_ti  TYPE HANDLE o_dintbl_typ.
  ENDMETHOD.


  METHOD asignar_tipo_componente.
    DATA: o_desc TYPE REF TO cl_abap_typedescr.

    LOOP AT c_ti_campos ASSIGNING FIELD-SYMBOL(<fs_es_campos>).
      "ajusta nombre de columna
      TRANSLATE <fs_es_campos>-nombre USING ' _'.
      "deriva el tipo de dato
      IF <fs_es_campos>-o_descripcion_elemento IS INITIAL.
        cl_abap_datadescr=>describe_by_name( EXPORTING  p_name         = COND #( WHEN <fs_es_campos>-campo EQ 'STRING' THEN
                                                                                  <fs_es_campos>-campo
                                                                                 WHEN <fs_es_campos>-estructura IS NOT INITIAL THEN
                                                                                  |{ <fs_es_campos>-estructura }-{ <fs_es_campos>-campo }|
                                                                               )
                                             RECEIVING  p_descr_ref    = o_desc
                                             EXCEPTIONS type_not_found = 1 ).
      ELSE.
        o_desc ?= <fs_es_campos>-o_descripcion_elemento.
      ENDIF.

      IF sy-subrc EQ 1.

        "si eltipo no es valido, crea la columna tipo String
        <fs_es_campos>-o_descripcion_elemento ?= cl_abap_datadescr=>describe_by_name( 'STRING' ).
      ELSE.

        <fs_es_campos>-o_descripcion_elemento ?= o_desc.

        "ajustar longitud de salida para tipos de dato P
        IF i_omitir_conversion_tipo_p = abap_false.
          CASE o_desc->type_kind.
            WHEN 'P'.
              <fs_es_campos>-o_descripcion_elemento ?=
                <fs_es_campos>-o_descripcion_elemento->get_p(
                p_length   = COND #( WHEN ( ( o_desc->length * 2 ) - 1 ) > <fs_es_campos>-o_descripcion_elemento->type_p_max_length THEN
                                         <fs_es_campos>-o_descripcion_elemento->type_p_max_length
                                     ELSE
                                         ( ( o_desc->length * 2 ) - 1 ) )
                p_decimals = o_desc->decimals
              ).
          ENDCASE.
        ENDIF.

      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD crear_archivo_zip.

    DATA: o_zip       TYPE REF TO cl_abap_zip,
          zip_content TYPE xstring.

    CREATE OBJECT o_zip.

    "agregar contenido a ZIP
    LOOP AT i_ti_contenido_zip INTO DATA(es_zip_data).

      o_zip->add( name = es_zip_data-nombre content = es_zip_data-contenido ).

    ENDLOOP.

    zip_content   = o_zip->save( ).

* convierte xstring a binary
    CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
      EXPORTING
        buffer        = zip_content
      IMPORTING
        output_length = e_longitud_salida
      TABLES
        binary_tab    = e_ti_binario.

  ENDMETHOD.


  METHOD get_nueva_referencia.
    FIELD-SYMBOLS <f_t_dyn> TYPE STANDARD TABLE.

    CREATE DATA r_ti_o LIKE i_ti.
    ASSIGN r_ti_o->* TO <f_t_dyn>.

    <f_t_dyn> = i_ti.
  ENDMETHOD.


  METHOD ti_a_string.

    DATA: str_line            TYPE string,
          o_stdescribe        TYPE REF TO cl_abap_structdescr,
          o_tabledescr        TYPE REF TO cl_abap_tabledescr,
          o_elm_des           TYPE REF TO cl_abap_elemdescr,
          ti_columnas_tabla_d TYPE cl_abap_structdescr=>component_table.

    FIELD-SYMBOLS: <fs_es_datos> TYPE any,
                   <fs_dato>     TYPE any,
                   <fs_ti_datos> TYPE ANY TABLE.

    TRY.

        o_tabledescr ?= cl_abap_structdescr=>describe_by_data( i_ti ).

        TRY.
            o_stdescribe ?= o_tabledescr->get_table_line_type( ).
            DATA(ti_columnas_tabla) = o_stdescribe->get_components( ).
          CATCH cx_sy_move_cast_error INTO DATA(o_cx_cast) ##NO_HANDLER.

            o_elm_des ?= o_tabledescr->get_table_line_type( ).

            APPEND VALUE cl_abap_structdescr=>component( name = 'TABLE_LINE'
                                                         type = o_tabledescr->get_table_line_type( )    )
            TO ti_columnas_tabla.

        ENDTRY.

        "busca estructuras anidadas
        LOOP AT ti_columnas_tabla INTO DATA(es_componente) WHERE name = space OR as_include EQ abap_true.
          o_stdescribe ?=  es_componente-type.
          APPEND LINES OF o_stdescribe->get_components( ) TO ti_columnas_tabla_d.
        ENDLOOP..

        DELETE ti_columnas_tabla_d WHERE name = space.
        "agrega componenes anidados
        APPEND LINES OF ti_columnas_tabla_d TO ti_columnas_tabla.

        DELETE ti_columnas_tabla WHERE name = space.

      CATCH cx_sy_move_cast_error ##NO_HANDLER.

    ENDTRY.

    LOOP AT i_ti ASSIGNING <fs_es_datos>.

      str_line = es_a_string( i_es                       = <fs_es_datos>
                              i_r_excluir_columnas       = i_r_excluir_columnas
                              i_caracter_exc_columna     = i_caracter_exc_columna
                              i_separador                = i_separador
                              i_incluir_encabezado       = abap_false
                              i_ti_componente_estructura = ti_columnas_tabla ).

      IF i_omitir_salto_linea = abap_true.
        r_str = r_str && str_line.
      ELSE.
        IF i_separador_como_salto_linea = abap_true.
          r_str = r_str && str_line && i_separador.
        ELSE.
          r_str = r_str && str_line && cl_abap_char_utilities=>cr_lf.
        ENDIF.
      ENDIF.

    ENDLOOP.
    "Eliminar ultimo caracter
    IF i_separador_como_salto_linea = abap_true.
      DATA(longitud_cadena) = strlen( r_str ) - 1.
      IF longitud_cadena > 1.
        r_str = r_str(longitud_cadena).
      ENDIF.
    ENDIF.

    """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
    "Funcionalidad para incluir el encabezado de la tabla
    IF i_incluir_encabezado = abap_true.
      CLEAR str_line.

      "Recorrer los campos de la tabla
      LOOP AT ti_columnas_tabla ASSIGNING FIELD-SYMBOL(<fs_es_componentes_tabla>).

        IF i_r_excluir_columnas IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name IN i_r_excluir_columnas.
          CONTINUE.
        ENDIF.
        "columnas que se excluyen
        IF i_caracter_exc_columna IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name(2) EQ i_caracter_exc_columna.
          CONTINUE.
        ENDIF.

        TRY.
            "Asigna la referencia del tipo del campo
            o_elm_des ?= <fs_es_componentes_tabla>-type.
          CATCH  cx_sy_move_cast_error cx_root INTO DATA(o_cx).
            CONTINUE.
        ENDTRY.

        CASE i_tam_txt_columna.
          WHEN 'L'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_l }|.
          WHEN 'M'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_m }|.
          WHEN 'S'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_s }|.
          WHEN OTHERS.
            str_line = |{ str_line }{ i_separador }{ <fs_es_componentes_tabla>-name }|.
        ENDCASE.

      ENDLOOP.

      REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

      IF i_omitir_salto_linea = abap_true.
        r_str = str_line && r_str.
      ELSE.
        r_str = str_line && cl_abap_char_utilities=>cr_lf && r_str.
      ENDIF.

    ENDIF.

  ENDMETHOD.


  METHOD enviar_correo.
*    CONSTANTS:
*      c_raw     TYPE char03 VALUE 'RAW'.

    DATA:
      v_mlrec            TYPE so_obj_nam,
      v_sent_to_all      TYPE os_boolean,
      cadena_255         TYPE xstring,
      longitud_xs        TYPE i,
      longitud_xs_actual TYPE i,
      offset_cadena      TYPE i,
      o_send_request     TYPE REF TO cl_bcs,
      o_bcs_exception    TYPE REF TO cx_bcs,
      o_recipient        TYPE REF TO if_recipient_bcs,
      o_sender           TYPE REF TO cl_sapuser_bcs,
      o_document         TYPE REF TO cl_document_bcs.

    TRY.
        "Create send request
        o_send_request = cl_bcs=>create_persistent( ).

        "Email FROM...
*        o_sender = cl_sapuser_bcs=>create( sy-uname ).
        o_sender = cl_sapuser_bcs=>create( i_from ).
        "Add sender to send request
        o_send_request->set_sender( i_sender = o_sender ).

        "Email TO...
        LOOP AT i_ti_destinatarios INTO DATA(s_email).

          o_recipient = cl_cam_address_bcs=>create_internet_address( s_email-smtp_addr ).
          "Add recipient to send request
          o_send_request->add_recipient( i_recipient = o_recipient i_express = abap_true ).

        ENDLOOP.

        "Email BODY
        o_document = cl_document_bcs=>create_document(
          i_type    = i_tipo_documento "c_raw
          i_text    = i_ti_texto_cuerpo_correo
          i_subject = i_asunto ).

        "Convert itab to line 255 positions
        IF i_contenido_binario_adjunto IS NOT INITIAL.

          CLEAR: c_ti_dato_binario.

          cadena_255 = i_contenido_binario_adjunto.
          longitud_xs = xstrlen( cadena_255 ).

          IF longitud_xs > 0.
            DO.
              longitud_xs_actual = offset_cadena + 255.
              IF longitud_xs_actual > longitud_xs.
                APPEND VALUE #( line = cadena_255+offset_cadena ) TO c_ti_dato_binario.
              ELSE.
                APPEND VALUE #( line = cadena_255+offset_cadena(255) ) TO c_ti_dato_binario.
              ENDIF.
              offset_cadena = longitud_xs_actual.
              IF offset_cadena >= longitud_xs.
                EXIT.
              ENDIF.
            ENDDO.
          ENDIF.
        ENDIF.

        "Email attach
        IF c_ti_dato_binario IS SUPPLIED.
          o_document->add_attachment(
            i_attachment_type    = i_tipo_adjunto    " Document Class for Attachment
            i_attachment_subject = i_titulo_adjunto  " Attachment Title
            i_att_content_hex    = c_ti_dato_binario
            i_attachment_header  = i_ti_attachment_header
            i_attachment_size    = i_dimension_adjunto ).
        ENDIF.

        "Add document to send request
        o_send_request->set_document( o_document ).

        "Send email
        v_sent_to_all = o_send_request->send( i_with_error_screen = abap_true ).

        "Commit to send email
        IF i_commit = abap_true.
          COMMIT WORK AND WAIT.
        ENDIF.

        "Exception handling
      CATCH cx_bcs INTO o_bcs_exception.

    ENDTRY.
  ENDMETHOD.


  METHOD enviar_correo_av.

    CONSTANTS:
      c_raw     TYPE char03 VALUE 'RAW'.

    DATA:
      v_mlrec         TYPE so_obj_nam,
      v_sent_to_all   TYPE os_boolean,
      o_send_request  TYPE REF TO cl_bcs,
      o_bcs_exception TYPE REF TO cx_bcs,
      o_recipient     TYPE REF TO if_recipient_bcs,
      o_sender        TYPE REF TO cl_sapuser_bcs,
      o_document      TYPE REF TO cl_document_bcs.


    CLEAR e_es_msg_error.

    "Verificar si las tabla de destinatario y listas de distribución
    "están vacias a la vez
    IF i_ti_destinatarios IS INITIAL AND
       i_ti_ld_emails IS INITIAL.
      "Imprime el mensaje
      MESSAGE ID 'ZCX01'
              TYPE 'E'
              NUMBER '059'
              INTO DATA(mensaje).

      "Asigna el mensaje de error
      e_es_msg_error = VALUE #(
                         id      = 'ZCX01'
                         type    = 'E'
                         number  = '059'
                         message = mensaje ).
      " Falta ingresar direcciones de email y/o listas de distribución.
      RETURN.
    ENDIF.

    "Recuperar los destinatarios de las listas de distribución
    consultar_listas_distribucion(
      EXPORTING
        i_ti_ld_emails     = i_ti_ld_emails
      IMPORTING
        e_ti_destinatarios = DATA(ti_destinatarios)
        e_es_msg_error     = e_es_msg_error
    ).
    IF NOT e_es_msg_error IS INITIAL.
      RETURN.
    ENDIF.

    "Unificar los destinatarios
    ti_destinatarios =
      VALUE #(
        BASE ti_destinatarios
        FOR <fs_es_destin> IN i_ti_destinatarios
        ( tipo_dest = COND #( WHEN <fs_es_destin>-tipo_dest = '' THEN gc_to
                              ELSE <fs_es_destin>-tipo_dest )
          ind_urge  = <fs_es_destin>-ind_urge
          nombre    = <fs_es_destin>-nombre
          email     = to_lower( <fs_es_destin>-email ) ) ).

    "Organiza la tabla
    SORT ti_destinatarios BY tipo_dest DESCENDING
                             ind_urge DESCENDING
                             nombre ASCENDING
                             email ASCENDING.

    TRY.
        "Create send request
        o_send_request = cl_bcs=>create_persistent( ).

        "Email FROM...
        o_sender = cl_sapuser_bcs=>create( COND #( WHEN i_remitente <> space
                                                     THEN i_remitente
                                                   ELSE sy-uname ) ).
        "Add sender to send request
        o_send_request->set_sender( i_sender = o_sender ).

        "Asigna los destinatarios
        LOOP AT ti_destinatarios ASSIGNING FIELD-SYMBOL(<fs_es_destinatarios>).
          "Arma la info del destinatario
          o_recipient = cl_cam_address_bcs=>create_internet_address(
            i_address_string = CONV #( <fs_es_destinatarios>-email )
            i_address_name   = <fs_es_destinatarios>-nombre ).

          "Verifica el tipo de destinatario
          CASE <fs_es_destinatarios>-tipo_dest.
            WHEN gc_to.     "Adiciona destinatario TO
              "Add recipient to send request
              o_send_request->add_recipient(
                EXPORTING
                  i_recipient  = o_recipient
                  i_express    = <fs_es_destinatarios>-ind_urge
                  i_copy       = abap_false
                  i_blind_copy = abap_false
                  i_no_forward = abap_false ).

            WHEN gc_cc.     "Adiciona destinatario CC
              "Add recipient to send request
              o_send_request->add_recipient(
                EXPORTING
                  i_recipient  = o_recipient
                  i_express    = <fs_es_destinatarios>-ind_urge
                  i_copy       = abap_true
                  i_blind_copy = abap_false
                  i_no_forward = abap_false ).

            WHEN gc_bcc.    "Adiciona destinatario BCC
              "Add recipient to send request
              o_send_request->add_recipient(
                EXPORTING
                  i_recipient  = o_recipient
                  i_express    = <fs_es_destinatarios>-ind_urge
                  i_copy       = abap_false
                  i_blind_copy = abap_true
                  i_no_forward = abap_false ).

          ENDCASE.
        ENDLOOP.

        "Email BODY
        o_document = cl_document_bcs=>create_document(
          i_type    = c_raw
          i_text    = i_ti_texto_cuerpo_correo
          i_subject = i_asunto ).

        "Recorre la tabla de adjuntos
        LOOP AT i_ti_lista_adjuntos ASSIGNING FIELD-SYMBOL(<fs_es_lista_adjuntos>).
          "Adjunta el dato
          o_document->add_attachment(
            i_attachment_type    = <fs_es_lista_adjuntos>-tipo
            i_attachment_subject = <fs_es_lista_adjuntos>-titulo
            i_att_content_hex    = <fs_es_lista_adjuntos>-dato ).
        ENDLOOP.

        "Add document to send request
        o_send_request->set_document( o_document ).

        "Send email
        v_sent_to_all = o_send_request->send( i_with_error_screen = abap_true ).

        "Verificar si requiere del commit explícito
        IF i_commit_work = abap_true.
          "Commit to send email
          COMMIT WORK AND WAIT.
        ENDIF.

        "Exception handling
      CATCH cx_bcs INTO o_bcs_exception.

        "Imprime el mensaje
        MESSAGE ID 'ZCX01'
                TYPE 'E'
                NUMBER '060'
                WITH o_bcs_exception->error_type
                     o_bcs_exception->error_text
                INTO mensaje.

        "Asigna el mensaje de error
        e_es_msg_error = VALUE #(
                           id         = 'ZCX01'
                           type       = 'E'
                           number     = '060'
                           message    = mensaje
                           message_v1 = o_bcs_exception->error_type
                           message_v2 = o_bcs_exception->error_text ).
        " Error al enviar el correo electrónico: &1 - &2

    ENDTRY.
  ENDMETHOD.


  METHOD consultar_listas_distribucion.

    DATA:
      ti_member  TYPE STANDARD TABLE OF sodm1,
      ti_objpara TYPE STANDARD TABLE OF selc,
      ti_objparb TYPE STANDARD TABLE OF soop1,
      excepcion  TYPE string.


    CLEAR:
      e_ti_destinatarios,
      e_es_msg_error.

    "Verificar si la tabla listas de distribución está vacía
    IF i_ti_ld_emails IS INITIAL.
      RETURN.
    ENDIF.

    "Recorrer las listas de distribución
    LOOP AT i_ti_ld_emails ASSIGNING FIELD-SYMBOL(<fs_es_ld_emails>).
      "Llamar el MF que recupera la lista
      CALL FUNCTION 'SO_DLI_READ'
        EXPORTING
          distributionlist           = <fs_es_ld_emails>-nombre_obj
*         dli_id                     = space
*         owner                      = space
          system_dli                 = gc_x
*        IMPORTING
*         object_fl_display          =
*         object_hd_display          =
*         object_id                  =
*         object_sd_display          =
        TABLES
          member                     = ti_member
          objpara                    = ti_objpara
          objparb                    = ti_objparb
        EXCEPTIONS
          active_user_not_exist      = 1
          communication_failure      = 2
          component_not_available    = 3
          dl_name_not_exist          = 4
          folder_not_exist           = 5
          folder_no_authorization    = 6
          forwarder_not_exist        = 7
          object_not_exist           = 8
          object_no_authorization    = 9
          operation_no_authorization = 10
          owner_not_exist            = 11
          parameter_error            = 12
          substitute_not_active      = 13
          substitute_not_defined     = 14
          system_failure             = 15
          user_not_exist             = 16
          x_error                    = 17
          OTHERS                     = 18.

      IF sy-subrc <> 0.
        "Asigna la excepción, no se dispara mensajes en la SY.
        CASE sy-subrc.
          WHEN 1.
            excepcion = 'ACTIVE_USER_NOT_EXIST'.
          WHEN 2.
            excepcion = 'COMMUNICATION_FAILURE'.
          WHEN 3.
            excepcion = 'COMPONENT_NOT_AVAILABLE'.
          WHEN 4.
            excepcion = 'DL_NAME_NOT_EXIST'.
          WHEN 5.
            excepcion = 'FOLDER_NOT_EXIST'.
          WHEN 6.
            excepcion = 'FOLDER_NO_AUTHORIZATION'.
          WHEN 7.
            excepcion = 'FORWARDER_NOT_EXIST'.
          WHEN 8.
            excepcion = 'OBJECT_NOT_EXIST'.
          WHEN 9.
            excepcion = 'OBJECT_NO_AUTHORIZATION'.
          WHEN 10.
            excepcion = 'OPERATION_NO_AUTHORIZATION'.
          WHEN 11.
            excepcion = 'OWNER_NOT_EXIST'.
          WHEN 12.
            excepcion = 'PARAMETER_ERROR'.
          WHEN 13.
            excepcion = 'SUBSTITUTE_NOT_ACTIVE'.
          WHEN 14.
            excepcion = 'SUBSTITUTE_NOT_DEFINED'.
          WHEN 15.
            excepcion = 'SYSTEM_FAILURE'.
          WHEN 16.
            excepcion = 'USER_NOT_EXIST'.
          WHEN 17.
            excepcion = 'X_ERROR'.
          WHEN OTHERS.
            excepcion = 'OTHERS'.
        ENDCASE.

        "Imprime el mensaje
        MESSAGE ID 'ZCX01'
                TYPE 'E'
                NUMBER '061'
                WITH excepcion
                INTO DATA(mensaje).

        "Asigna el mensaje de error
        e_es_msg_error = VALUE #(
                           id         = 'ZCX01'
                           type       = 'E'
                           number     = '061'
                           message    = mensaje
                           message_v1 = excepcion ).
        " Error al consultar las listas de distribución de correos: &1

        "Salir del loop
        EXIT.
      ENDIF.

      "Arma la tabla de salida con los destinatarios
      e_ti_destinatarios =
        VALUE #(
          BASE e_ti_destinatarios
          FOR <fs_es_member> IN ti_member
          ( tipo_dest = COND #( WHEN <fs_es_member>-sndcp = gc_x THEN gc_cc
                                WHEN <fs_es_member>-sndbc = gc_x THEN gc_bcc
                                ELSE gc_to )
            ind_urge  = <fs_es_member>-sndex
            nombre    = <fs_es_member>-memadrnam
            email     = <fs_es_member>-address )  ).

      CLEAR:
      ti_member,
      ti_objpara,
      ti_objparb.
    ENDLOOP.

    "Organiza la tabla
    SORT e_ti_destinatarios BY tipo_dest DESCENDING
                               ind_urge DESCENDING
                               nombre ASCENDING
                               email ASCENDING.

  ENDMETHOD.


  METHOD get_valores_dominio.

    CALL FUNCTION 'DDIF_DOMA_GET'
      EXPORTING
        name          = i_nombre_dominio                 " Name of the Domain to be Read
        langu         = sy-langu              " Language in which Texts are Read
      TABLES
        dd07v_tab     = r_ti_valores                " Fixed Domain Values
      EXCEPTIONS
        illegal_input = 1                " Value not Allowed for Parameter
        OTHERS        = 2.

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

  ENDMETHOD.


  METHOD get_tag_xml.

    DATA: begin TYPE string,
          end   TYPE string,
          first LIKE r_ti_tag.

    CONCATENATE '<' i_tag '>' INTO begin.
    CONCATENATE '</' i_tag '>' INTO end.

    SPLIT i_xml AT begin INTO TABLE first.

    DELETE first INDEX 1.

    IF sy-subrc EQ 0.

      LOOP AT first ASSIGNING FIELD-SYMBOL(<fs_r_it_tag>).
        SPLIT <fs_r_it_tag> AT end INTO DATA(s_text1) DATA(s_text2).
        APPEND s_text1 TO r_ti_tag.
      ENDLOOP.

    ENDIF.

  ENDMETHOD.


  METHOD f4_layout.
    "Este codigo aplica en los eventos del reporte
*    AT SELECTION-SCREEN ON VALUE-REQUEST FOR pa_layou.
*    lcl_controlador=>f4_layout( CHANGING c_layout = pa_layou ).
*    PARAMETERS: pa_layou TYPE disvariant-variant.

*    ls_key-report = i_report.
*    ls_layout = cl_salv_layout_service=>f4_layouts( s_key = ls_key
*                                                    restrict = if_salv_c_layout=>restrict_none ).

    DATA: ls_variante TYPE disvariant,
          lv_exit     TYPE char1.

    ls_variante-report = sy-repid.

    CALL FUNCTION 'LVC_VARIANT_F4'
      EXPORTING
        is_variant = VALUE disvariant( report = i_report )
*       i_save     = 'A'
      IMPORTING
        e_exit     = lv_exit
        es_variant = ls_variante
      EXCEPTIONS
        not_found  = 1
        OTHERS     = 2.

    IF sy-subrc NE 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ELSE.
      CHECK lv_exit EQ space.
      c_layout = ls_variante-variant.
    ENDIF.

  ENDMETHOD.


  METHOD asignar_marcado_estructura.
    DATA: o_es_dec                  TYPE REF TO cl_abap_structdescr,
          o_descripcion_es_destino  TYPE REF TO cl_abap_structdescr,
          nombre_componente_destino TYPE string.

    FIELD-SYMBOLS: <fs_vl_des> TYPE any,
                   <fs_vl_org> TYPE any.

    CLEAR: c_es_destino.

    o_es_dec ?= cl_abap_structdescr=>describe_by_data( i_es_origen ).
    o_descripcion_es_destino ?= cl_abap_structdescr=>describe_by_data( c_es_destino ).

    LOOP AT o_es_dec->components INTO DATA(es_component).
      UNASSIGN: <fs_vl_des>, <fs_vl_org>.

      nombre_componente_destino = COND #( WHEN i_prefijo_estructura_destino IS NOT INITIAL THEN
                                           |{ i_prefijo_estructura_destino }{ es_component-name }|
                                         ELSE
                                           es_component-name ).

      ASSIGN COMPONENT: nombre_componente_destino OF STRUCTURE c_es_destino TO <fs_vl_des>,
                        es_component-name OF STRUCTURE i_es_origen TO <fs_vl_org>.

      CHECK <fs_vl_des> IS ASSIGNED AND <fs_vl_org> IS ASSIGNED AND <fs_vl_org> IS NOT INITIAL.
      "...si son de tipo igual asigna el mismo valor
      IF o_descripcion_es_destino->components[ name = nombre_componente_destino ]-type_kind = es_component-type_kind AND
         o_descripcion_es_destino->components[ name = nombre_componente_destino ]-length = es_component-length.
        <fs_vl_des> =  <fs_vl_org>.
      ELSE.
        <fs_vl_des> = abap_true."para componentes detipo FLAG se lleva con abap_true indicando que el valor se modificara
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD completar_rango.

    FIELD-SYMBOLS: <fs_sign>   TYPE any,
                   <fs_option> TYPE any,
                   <fs_low>    TYPE any,
                   <fs_high>   TYPE any.

    LOOP AT c_ti_rango ASSIGNING FIELD-SYMBOL(<fs_es_val>).

      ASSIGN COMPONENT: gc_sign OF STRUCTURE <fs_es_val> TO <fs_sign>,
                        gc_option OF STRUCTURE <fs_es_val> TO <fs_option>,
                        gc_low OF STRUCTURE <fs_es_val> TO <fs_low>,
                        gc_high OF STRUCTURE <fs_es_val> TO <fs_high>.

      CHECK <fs_sign> IS ASSIGNED.

      IF <fs_high> IS NOT INITIAL AND <fs_low> IS NOT INITIAL.
        <fs_option> = gc_bt.
      ENDIF.

      IF  i_convertir_in = abap_true.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = <fs_low>
          IMPORTING
            output = <fs_low>.

        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
          EXPORTING
            input  = <fs_high>
          IMPORTING
            output = <fs_high>.

      ENDIF.

      IF  i_convertir_out = abap_true.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
          EXPORTING
            input  = <fs_low>
          IMPORTING
            output = <fs_low>.

        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
          EXPORTING
            input  = <fs_high>
          IMPORTING
            output = <fs_high>.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.


  METHOD asignar_porcentaje_br_progreso.
    CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
      EXPORTING
        percentage = i_porcentaje
        text       = i_texto.
  ENDMETHOD.


  METHOD aplicar_conversion_campo.
    DATA: ti_ptab      TYPE abap_func_parmbind_tab,
          es_ptab      TYPE abap_func_parmbind,
          es_mtdata_fm TYPE rsfbintfv,
          ti_excep     TYPE abap_func_excpbind_tab.

    CHECK i_exit IS NOT INITIAL.

    DATA(o_log) = zclcxr1002_log_aplicacion=>get_instancia( ).

    REPLACE '==' WITH space INTO i_exit.

    "nombre modulo de funcion
    DATA(fm_nm) = 'CONVERSION_EXIT_' && i_exit && '_INPUT'.

    CONDENSE fm_nm NO-GAPS.

    CHECK i_valor IS NOT INITIAL.

    " Exporting
    es_ptab-name = 'INPUT'.
    es_ptab-kind = abap_func_exporting.
    es_ptab-value = REF #( i_valor ).
    INSERT es_ptab INTO TABLE ti_ptab.

    " Importing
    es_ptab-name = 'OUTPUT'.
    es_ptab-kind = abap_func_importing.
    es_ptab-value = REF #( c_valor ).
    INSERT es_ptab INTO TABLE ti_ptab.
    "recupera lista de excepciones
    cl_fb_function_utility=>meth_get_interface(
      EXPORTING
        im_name             = CONV #( fm_nm )    " ABAP Workbench: LIMU Name
      IMPORTING
        ex_interface        = es_mtdata_fm    " Function Module Interface
      EXCEPTIONS
        error_occured       = 1
        object_not_existing = 2
        OTHERS              = 3 ).

    IF sy-subrc IS NOT INITIAL.
      o_log->set_es_log( i_es = VALUE #( row = i_fila id = sy-msgid type = sy-msgty number = sy-msgno message_v1 = sy-msgv1
                                              message_v2 = sy-msgv2 message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).
    ELSE.
      ti_excep = VALUE abap_func_excpbind_tab( BASE ti_excep FOR es_except IN es_mtdata_fm-except
                                               ( name = es_except-parameter value = sy-tabix )  ).
    ENDIF.

    CALL FUNCTION fm_nm
      PARAMETER-TABLE
      ti_ptab
      EXCEPTION-TABLE
      ti_excep.

    IF sy-subrc NE 0.
      "manejo de errores
      o_log->set_es_log( i_es = VALUE #( row = i_fila id = sy-msgid type = sy-msgty number = sy-msgno message_v1 = sy-msgv1
                                              message_v2 = sy-msgv2 message_v3 = sy-msgv3 message_v4 = sy-msgv4 ) ).
    ENDIF.

  ENDMETHOD.


  METHOD validar_dominio.
    DATA: es_dd01v   TYPE dd01v,
          cond_where TYPE string,
          r_val_dom  TYPE REF TO data,
          ti_fiels   TYPE STANDARD TABLE OF dfies.

    FIELD-SYMBOLS: <fs_es_valores> TYPE any.

    CHECK i_dominio IS NOT INITIAL.
    "valida valor para dominios con valores fijos
    CALL FUNCTION 'FM_DOMAINVALUE_CHECK'
      EXPORTING
        i_domname         = i_dominio
        i_domvalue        = CONV dd07d-domvalue( i_valor )
      EXCEPTIONS
        input_error       = 1
        value_not_allowed = 2
        OTHERS            = 3.


    CASE sy-subrc.

      WHEN 0.
        r_valor = i_valor.
      WHEN  2."valor no encontrado para dominio con valores fijos
        RAISE EXCEPTION TYPE cx_t100_msg EXPORTING textid = 'err_dom_val' t100_msgv1 = i_valor t100_msgv2 = CONV #( i_dominio ) .
      WHEN OTHERS."busca en dominio con tabla de valores
        "recupera tabla de valores de dominio
        CALL FUNCTION 'DDIF_DOMA_GET'
          EXPORTING
            name          = i_dominio    " Name of the Domain to be Read
            langu         = sy-langu    " Language in which Texts are Read
          IMPORTING
            dd01v_wa      = es_dd01v    " Header of the Domain
          EXCEPTIONS
            illegal_input = 1
            OTHERS        = 2.

        IF sy-subrc IS INITIAL AND es_dd01v-entitytab IS NOT INITIAL.

          "Crea estructuras segun tabla de consulta
          CREATE DATA r_val_dom TYPE (es_dd01v-entitytab).
          ASSIGN r_val_dom->* TO <fs_es_valores>.
          "recupera campo clave de tabla de valores
          CALL FUNCTION 'DDIF_FIELDINFO_GET'
            EXPORTING
              tabname        = es_dd01v-entitytab   " Name of the Table (of the Type) for which Information is Req
            TABLES
              dfies_tab      = ti_fiels   " Field List if Necessary
            EXCEPTIONS
              not_found      = 1
              internal_error = 2
              OTHERS         = 3.

          IF sy-subrc IS INITIAL.
            "crea condicion WHERE
            cond_where = |{ COND #( WHEN line_exists( ti_fiels[ fieldname = i_dominio ] )
                                    THEN i_dominio
                                    WHEN line_exists( ti_fiels[ domname = i_dominio ] )
                                    THEN ti_fiels[ domname = i_dominio ]-fieldname
                                    ELSE ti_fiels[ 2 ]-fieldname  ) } = '{ i_valor }'|.
            "valida valor de tabla de valores
            SELECT SINGLE *
            FROM  (es_dd01v-entitytab)
            INTO  <fs_es_valores>
            WHERE (cond_where).

            "si el valor es encontrado se asigna a la variable de retorno, de lo contrario lanta una excepcion
            r_valor = COND #( WHEN sy-subrc IS INITIAL THEN i_valor
                                ELSE  THROW  cx_t100_msg( textid = 'err_dom_val' t100_msgv1 = i_valor t100_msgv2 = CONV #( i_dominio ) ) ).

          ENDIF.
        ELSE."Dominio sin tabla de valores ni valores fijos
          r_valor = i_valor.
        ENDIF.

    ENDCASE.
  ENDMETHOD.


  METHOD formato_fecha_ddmmyyyy.
    CHECK strlen( c_fecha ) >= 8.
    SPLIT c_fecha AT '-' INTO TABLE DATA(ti_fecha).

    IF lines( ti_fecha ) = 1.
      c_fecha = ti_fecha[ 1 ].
    ELSE.
      c_fecha = ti_fecha[ 1 ] && ti_fecha[ 2 ] && ti_fecha[ 3 ].
    ENDIF.
  ENDMETHOD.


  METHOD totalizar_estructura.

    DATA: o_ttdescribe         TYPE REF TO cl_abap_tabledescr,
          o_stdescribe         TYPE REF TO cl_abap_structdescr,
          o_eldescribe         TYPE REF TO cl_abap_elemdescr,
          ti_component_d       TYPE abap_component_tab,
          es_dfies             TYPE dfies,
          index                TYPE i,
          ti_valores_numericos TYPE gtp_ti_estructura_tabla,
          r_es_datos_totalizar TYPE REF TO data.

    FIELD-SYMBOLS: <fs_ti_datos_totalizar> TYPE ANY TABLE,
                   <fs_es_componentes>     LIKE LINE OF gti_componentes_es,
                   <fs_es_datos_totalizar> TYPE any.

    IF gti_componentes_es IS INITIAL OR i_inicializar = abap_true.
      CLEAR: gti_componentes_es.

*      o_ttdescribe ?= cl_abap_structdescr=>describe_by_data( c_es ).
*      o_stdescribe ?= o_ttdescribe->get_table_line_type( ).
      o_stdescribe ?= cl_abap_structdescr=>describe_by_data( c_es ).

      gti_componentes_es = o_stdescribe->get_components( ).
      "busca estructuras anidadas
      LOOP AT gti_componentes_es ASSIGNING <fs_es_componentes> WHERE name = space OR as_include EQ abap_true.
        o_stdescribe ?=  <fs_es_componentes>-type.
        APPEND LINES OF o_stdescribe->get_components( ) TO ti_component_d.
      ENDLOOP.

      DELETE gti_componentes_es WHERE name = space.
      "agrega componenes anidados
      APPEND LINES OF ti_component_d TO gti_componentes_es.

      LOOP AT gti_componentes_es ASSIGNING <fs_es_componentes>.
        index = sy-tabix.
        CLEAR: es_dfies.

        IF i_r_excluir_campo IS NOT INITIAL AND
           <fs_es_componentes>-name IN i_r_excluir_campo.
          CONTINUE.
        ENDIF.

        "recupera descripcion del tipo
        TRY.
            o_eldescribe ?= <fs_es_componentes>-type.
          CATCH cx_root.
            CONTINUE.
        ENDTRY.

        IF o_eldescribe->is_ddic_type( ) EQ abap_true.
          es_dfies = o_eldescribe->get_ddic_field( ).
        ELSE.
          es_dfies-leng = o_eldescribe->length.
          es_dfies-decimals = o_eldescribe->decimals.
          es_dfies-datatype = es_dfies-inttype = es_dfies-comptype = o_eldescribe->type_kind.
        ENDIF.

        IF es_dfies-datatype = 'CURR' OR es_dfies-datatype = 'DEC' OR es_dfies-datatype = 'QUAN'
        OR es_dfies-datatype = 'P' OR es_dfies-datatype = 'I'
        OR ( line_exists( i_ti_campo_clave[ name = <fs_es_componentes>-name ] ) ).
          APPEND VALUE gtp_es_tabla( nombre = <fs_es_componentes>-name
                                     o_descripcion_elemento = o_eldescribe )
          TO ti_valores_numericos.
        ENDIF.

      ENDLOOP.
      TRY.
          gti_datos_totalizar = crear_ti_dinamica( EXPORTING i_ti_clave       = i_ti_campo_clave
                                                             i_tipo_clave     = cl_abap_tabledescr=>keydefkind_user
                                                             i_valores_unicos = abap_false
                                                   CHANGING  c_ti_campos      = ti_valores_numericos ).
        CATCH cx_sy_struct_creation.
        CATCH cx_dynamic_check INTO DATA(o_cx_d).
          DATA(tc) = o_cx_d->get_text( ).
        CATCH cx_static_check.
      ENDTRY.
    ENDIF.

    ASSIGN gti_datos_totalizar->* TO <fs_ti_datos_totalizar>.
    CREATE DATA r_es_datos_totalizar LIKE LINE OF <fs_ti_datos_totalizar>.
    ASSIGN r_es_datos_totalizar->* TO <fs_es_datos_totalizar>.

    <fs_es_datos_totalizar> = CORRESPONDING #( c_es ).

    COLLECT <fs_es_datos_totalizar> INTO <fs_ti_datos_totalizar>.

    LOOP AT <fs_ti_datos_totalizar> ASSIGNING <fs_es_datos_totalizar>.
    ENDLOOP.

    CHECK sy-subrc IS INITIAL.

    c_es = CORRESPONDING #( BASE ( c_es ) <fs_es_datos_totalizar> ).

  ENDMETHOD.


  METHOD inicializar_totalizacion_es.
    CLEAR: gti_componentes_es, gti_datos_totalizar.
    FREE: gti_datos_totalizar.
  ENDMETHOD.


  METHOD zfsh_api_get_stock_req_list.

**********************************************************************
*NOTA: Copia de la funcion FSH_API_GET_STOCK_REQ_LIST debido a que esta
*no brinda la opcion de filtrar por area de planificacion
**********************************************************************

    DATA : lo_fsh_stock_req_list TYPE REF TO cl_fsh_srl_service_provider,
           ls_srl                TYPE fsh_s_srl_dialog,
           lt_fsh_srl            TYPE fsh_tt_srl_alv,
           ls_fsh_srl            TYPE fsh_s_srl_alv,
           ls_add_info           TYPE fsh_s_mattb,
           ls_return             TYPE bapiret2,
           ls_stock_req_list     TYPE fsh_s_stock_req_list,
           v_article_long	       TYPE matnr40.

    v_article_long = article_long.
    cl_matnr_chk_mapper=>convert_on_input(
      EXPORTING
        iv_matnr18               = article         " Field length 18
        iv_matnr40               = v_article_long  " Material Number
      IMPORTING
        ev_matnr40               = v_article_long  " Material Number
      EXCEPTIONS
        excp_matnr_ne            = 1
        excp_matnr_invalid_input = 2
        OTHERS                   = 3
    ).

    IF sy-subrc <> 0.
      cl_matnr_chk_mapper=>bapi_get_last_error(
        IMPORTING
          ev_return = ls_return
      ).
      MESSAGE ID     ls_return-id
              TYPE   ls_return-type
              NUMBER ls_return-number
              WITH   ls_return-message_v1
                     ls_return-message_v2
                     ls_return-message_v3
                     ls_return-message_v4.
      RETURN.
    ENDIF.

    IF v_article_long IS INITIAL.
      RETURN.
    ENDIF.

***-- MOVE input PARAMETERS
    ls_srl-matnr          = v_article_long.
    ls_srl-werks          = plant.
    ls_srl-berid          = berid.
    ls_srl-stock_delkz    = stock_element.
    ls_srl-fsh_bsnr       = stock_number.
    ls_srl-fsh_hbsp       = stock_item.
    ls_srl-fsh_ebsp       = stock_schedule_line.
    ls_srl-req_delkz      = requirement_element.
    ls_srl-fsh_aufnr      = requirement_number.
    ls_srl-fsh_posnr      = requirement_item.
    ls_srl-fsh_etenr      = requirement_schedule_line.

**-- Get instance of cl_fsh_srl_service_provider class
    CALL METHOD cl_fsh_srl_service_provider=>get_instance
      IMPORTING
        eo_cl_fsh_srl_service_provider = lo_fsh_stock_req_list.

**-- Retrive Stock/Requirement list
    CALL METHOD lo_fsh_stock_req_list->retrieve_srl
      EXPORTING
        is_dialog_in        = ls_srl
        it_fsh_mrp_stat     = mrp_status
        iv_bypass_buffer    = abap_true
      IMPORTING
        et_fsh_srl          = lt_fsh_srl
        es_add_info         = ls_add_info
      EXCEPTIONS
        ex_material_problem = 1
        ex_hana_problem     = 2
        OTHERS              = 3.


    LOOP AT lt_fsh_srl INTO ls_fsh_srl .
      IF cl_mfle_matnr_mode=>get_instance( )->is_in_compatibility_mode( ) = abap_true.
        ls_stock_req_list-article                        = ls_fsh_srl-matnr.
      ENDIF.
      ls_stock_req_list-plant                          = ls_fsh_srl-werks.
      ls_stock_req_list-uom                            = ls_fsh_srl-meins.
      ls_stock_req_list-quantity                       = ls_fsh_srl-menge.
      ls_stock_req_list-fashion_mrp_status             = ls_fsh_srl-fsh_mrp_stat.
      ls_stock_req_list-rquirement_type                = ls_fsh_srl-bdart.
      ls_stock_req_list-requirement_element            = ls_fsh_srl-req_delkz.
      ls_stock_req_list-requirement_mrp_abbreviation   = ls_fsh_srl-req_delbo.
      ls_stock_req_list-requirement_no                 = ls_fsh_srl-delnr.
      ls_stock_req_list-requirement_element_item       = ls_fsh_srl-delps.
      ls_stock_req_list-requirement_schedule_line_no   = ls_fsh_srl-delet.
      ls_stock_req_list-delivery_date                  = ls_fsh_srl-del_date.
      ls_stock_req_list-stock_type                     = ls_fsh_srl-fsh_bskz.
      ls_stock_req_list-stock_element                  = ls_fsh_srl-stock_delkz.
      ls_stock_req_list-stock_mrp_abbreviation         = ls_fsh_srl-stock_delbo.
      ls_stock_req_list-stock_no                       = ls_fsh_srl-fsh_bsnr.
      ls_stock_req_list-stock_element_item             = ls_fsh_srl-fsh_hbsp.
      ls_stock_req_list-stock_schedule_line_no         = ls_fsh_srl-fsh_ebsp.
      ls_stock_req_list-purchase_requisition_fix_icon  = ls_fsh_srl-fixkz_icon.
      ls_stock_req_list-is_purchase_requisition_fixed  = ls_fsh_srl-fixkz.
      ls_stock_req_list-plan_date                      = ls_fsh_srl-plan_date.
      ls_stock_req_list-storage_location_req           = ls_fsh_srl-lgort_r.
      ls_stock_req_list-storage_location_stock         = ls_fsh_srl-lgort_s.
      ls_stock_req_list-customer_no                    =  ls_fsh_srl-kunnr.
      ls_stock_req_list-customer_name                  =  ls_fsh_srl-kuname.
      ls_stock_req_list-vendor_no                      =  ls_fsh_srl-lifnr.
      ls_stock_req_list-vendor_name                    =  ls_fsh_srl-liname.
      ls_stock_req_list-requirements_plan_number       =  ls_fsh_srl-pbdnr.
      ls_stock_req_list-external_requirements_plan_id  =  ls_fsh_srl-pbdnr_ext.
      ls_stock_req_list-pir_date                       =  ls_fsh_srl-pir_date.
      ls_stock_req_list-requirement_segment            =  ls_fsh_srl-sgt_rcat.
      ls_stock_req_list-segmentation_value             =  ls_fsh_srl-sgt_plrc.
      ls_stock_req_list-stock_segment                  =  ls_fsh_srl-sgt_scat.
      ls_stock_req_list-planning_type                  =  ls_fsh_srl-plart.
      ls_stock_req_list-characteristic_value1          =  ls_fsh_srl-dim1.
      ls_stock_req_list-characteristic_value2          =  ls_fsh_srl-dim2.
      ls_stock_req_list-characteristic_value3          =  ls_fsh_srl-dim3.
      ls_stock_req_list-fsh_sc_bezg                    =  ls_fsh_srl-fsh_sc_bezg.
      ls_stock_req_list-fashion_mrp_status_text        =  ls_fsh_srl-fsh_mrp_stat_txt.
      ls_stock_req_list-special_stock_indicator        =  ls_fsh_srl-sobkz.
      ls_stock_req_list-fashion_termn_date             =  ls_fsh_srl-termn.
      ls_stock_req_list-fashion_master_order           =  ls_fsh_srl-fsh_master_order.
      ls_stock_req_list-fashion_season_year_stock      =  ls_fsh_srl-fsh_season_year_s.
      ls_stock_req_list-fsh_season_stock               =  ls_fsh_srl-fsh_season_s.
      ls_stock_req_list-fsh_collection_stock           =  ls_fsh_srl-fsh_collection_s.
      ls_stock_req_list-fsh_theme_stock                =  ls_fsh_srl-fsh_theme_s.
      ls_stock_req_list-fsh_season_year_req            =  ls_fsh_srl-fsh_season_year_r.
      ls_stock_req_list-fsh_season_req                 =  ls_fsh_srl-fsh_season_r.
      ls_stock_req_list-fsh_collection_req             =  ls_fsh_srl-fsh_collection_r.
      ls_stock_req_list-fsh_theme_req                  =  ls_fsh_srl-fsh_theme_r.
      ls_stock_req_list-article_long                   =  ls_fsh_srl-matnr.

      APPEND ls_stock_req_list TO et_stock_requirement_list.
      CLEAR ls_stock_req_list.
    ENDLOOP.

  ENDMETHOD.


  METHOD es_a_string.

    DATA: str_line                 TYPE string,
          o_stdescribe             TYPE REF TO cl_abap_structdescr,
          o_tabledescr             TYPE REF TO cl_abap_tabledescr,
          o_elm_des                TYPE REF TO cl_abap_elemdescr,
          ti_columnas_tabla_d      TYPE cl_abap_structdescr=>component_table,
          indice_columna           TYPE i,
          r_tipo_no_dato_permitido TYPE RANGE OF c.

    FIELD-SYMBOLS: <fs_dato>     TYPE any,
                   <fs_ti_datos> TYPE ANY TABLE.

    r_tipo_no_dato_permitido = VALUE #( sign = 'I' option = 'EQ' ( low = 'h' )
                                                                 ( low = 'u' )
                                                                 ( low = 'v' ) ).

    IF i_ti_componente_estructura IS INITIAL.
      TRY.

          o_stdescribe ?= cl_abap_structdescr=>describe_by_data( i_es ).

          DATA(ti_componente_estructura) = o_stdescribe->get_components( ).

          "busca estructuras anidadas
          LOOP AT ti_componente_estructura INTO DATA(es_componente) WHERE name = space OR as_include EQ abap_true.
            o_stdescribe ?=  es_componente-type.
            APPEND LINES OF o_stdescribe->get_components( ) TO ti_columnas_tabla_d.
          ENDLOOP..

          DELETE ti_columnas_tabla_d WHERE name = space.
          "agrega componenes anidados
          APPEND LINES OF ti_columnas_tabla_d TO ti_componente_estructura.

          DELETE ti_componente_estructura WHERE name = space.

        CATCH cx_sy_move_cast_error ##NO_HANDLER.

      ENDTRY.

    ELSE.
      ti_componente_estructura = i_ti_componente_estructura.
    ENDIF.

    DO.

      indice_columna = sy-index.

      UNASSIGN <fs_dato>.

      ASSIGN COMPONENT indice_columna OF STRUCTURE i_es TO <fs_dato>.

      IF sy-subrc IS NOT INITIAL.
        IF lines( ti_componente_estructura ) = 1 AND i_es IS NOT INITIAL.
          ASSIGN i_es TO <fs_dato>.

          IF <fs_dato> IS NOT ASSIGNED OR indice_columna > lines( ti_componente_estructura ).
            EXIT.
          ENDIF.

        ELSE.
          EXIT.
        ENDIF.
      ENDIF.

      IF i_r_excluir_columnas IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name IN i_r_excluir_columnas.
        CONTINUE.
      ENDIF.
      "columnas que se excluyen
      IF i_caracter_exc_columna IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name(2) EQ i_caracter_exc_columna.
        CONTINUE.
      ENDIF.

      TRY.
          DESCRIBE FIELD <fs_dato> TYPE DATA(tp_componente).

          CHECK tp_componente NOT IN r_tipo_no_dato_permitido.

          str_line = |{ str_line }{ i_separador }{ <fs_dato> }|.
        CATCH cx_root.

      ENDTRY.

    ENDDO.

    REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

    r_str = str_line.

    """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
    "Funcionalidad para incluir el encabezado de la tabla
    IF i_incluir_encabezado = abap_true.
      CLEAR str_line.

      "Recorrer los campos de la tabla
      LOOP AT ti_componente_estructura ASSIGNING FIELD-SYMBOL(<fs_es_componentes_tabla>).

        IF i_r_excluir_columnas IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name IN i_r_excluir_columnas.
          CONTINUE.
        ENDIF.
        "columnas que se excluyen
        IF i_caracter_exc_columna IS NOT INITIAL AND
           <fs_es_componentes_tabla>-name(2) EQ i_caracter_exc_columna.
          CONTINUE.
        ENDIF.

        "Asigna la referencia del tipo del campo
        o_elm_des ?= <fs_es_componentes_tabla>-type.

        CASE i_longitud_texto_columna.
          WHEN 'L'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_l }|.
          WHEN 'M'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_m }|.
          WHEN 'S'.
            str_line = |{ str_line }{ i_separador }{ o_elm_des->get_ddic_field( )-scrtext_s }|.
          WHEN OTHERS.
            str_line = |{ str_line }{ i_separador }{ <fs_es_componentes_tabla>-name }|.
        ENDCASE.

      ENDLOOP.

      REPLACE FIRST OCCURRENCE OF i_separador IN str_line WITH space.

      r_str = str_line && cl_abap_char_utilities=>cr_lf && r_str.

    ENDIF.

  ENDMETHOD.


  METHOD ti_a_xstring.
    FIELD-SYMBOLS: <fs_data> TYPE ANY TABLE.

    CLEAR r_xstring.
    ASSIGN i_ti->* TO <fs_data>.

    TRY.
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(o_tabla)
                                CHANGING  t_table      = <fs_data> ).

        DATA(ti_catalogo) = cl_salv_controller_metadata=>get_lvc_fieldcatalog( r_columns      = o_tabla->get_columns( )
                                                                               r_aggregations = o_tabla->get_aggregations( ) ).

        LOOP AT ti_catalogo ASSIGNING FIELD-SYMBOL(<fs_es_catalogo>).

          <fs_es_catalogo>-reptext = <fs_es_catalogo>-fieldname.

        ENDLOOP.

        DATA(o_resultado) = cl_salv_ex_util=>factory_result_data_table( r_data         = i_ti
                                                                        t_fieldcatalog = ti_catalogo ).

        cl_salv_bs_tt_util=>if_salv_bs_tt_util~transform( EXPORTING
                                                            xml_type      = if_salv_bs_xml=>c_type_xlsx
                                                            xml_version   = cl_salv_bs_a_xml_base=>get_version( )
                                                            r_result_data = o_resultado
                                                            xml_flavour   = if_salv_bs_c_tt=>c_tt_xml_flavour_export
                                                            gui_type      = if_salv_bs_xml=>c_gui_type_gui
                                                          IMPORTING
                                                            xml           = r_xstring ).
      CATCH cx_root.
        CLEAR r_xstring.
    ENDTRY.
  ENDMETHOD.


  METHOD agregar_mensaje_respuestaodata.

    LOOP AT c_ti_mensajes ASSIGNING FIELD-SYMBOL(<fs_es_msg>).
      c_o_message_container->add_message(
        EXPORTING
          iv_msg_type               = <fs_es_msg>-type
          iv_msg_id                 = <fs_es_msg>-id
          iv_msg_number             = <fs_es_msg>-number
          iv_msg_v1                 = <fs_es_msg>-message_v1
          iv_msg_v2                 = <fs_es_msg>-message_v2
          iv_msg_v3                 = <fs_es_msg>-message_v3
          iv_msg_v4                 = <fs_es_msg>-message_v4
          iv_is_leading_message     = abap_true
          iv_add_to_response_header = abap_true ).
    ENDLOOP.

  ENDMETHOD.


  METHOD registrar_cdhdr_cdpos.

    DATA:
          ls_bapiret2 TYPE bapiret2.


    DATA:
      lv_message      TYPE sy-msgli,
      lv_objectid     TYPE cdhdr-objectid,
      lv_changenumber TYPE cdhdr-changenr.

*lv_OBJECTID = |{ ls_workarea_new-objek }{ ls_workarea_new-mafid }|.
    lv_objectid = i_objectid.

    "En primer lugar abrimos el documento de cambios, para esto utilizamos la siguiente función,
    "a la misma, le pasamos la clase y el ID del objeto:
    CALL FUNCTION 'CHANGEDOCUMENT_OPEN'
      EXPORTING
        objectclass      = i_objectclass "'MAT_FULL'
        objectid         = lv_objectid
      EXCEPTIONS
        sequence_invalid = 1.
    IF sy-subrc NE 0.
      CLEAR lv_message.
      MESSAGE ID sy-msgid
            TYPE sy-msgty
          NUMBER sy-msgno
            WITH sy-msgv1
                 sy-msgv2
                 sy-msgv3
                 sy-msgv4
            INTO lv_message.
      APPEND VALUE bapiret2(
      type        = sy-msgty
      id          = sy-msgid
      number      = sy-msgno
      message     = lv_message
      message_v1  = sy-msgv1
      message_v2  = sy-msgv2
      message_v3  = sy-msgv3
      message_v4  = sy-msgv4
      ) TO c_ti_bapiret2.
      RETURN.
    ENDIF.

*Luego, se llama a la función que identifica los campos modificados. Para esto se le tiene que pasar
*como parámetros el indicador de cambio, la tabla modificada, los valores
*modificados y los valores antes de la modificación:
    CALL FUNCTION 'CHANGEDOCUMENT_SINGLE_CASE'
      EXPORTING
        change_indicator       = i_change_indicator "'U'
        tablename              = i_reftablename     "'AUSP'
        workarea_new           = i_workarea_new
        workarea_old           = i_workarea_old
      EXCEPTIONS
        nametab_error          = 1
        open_missing           = 2
        position_insert_failed = 3.
    IF sy-subrc NE 0.
      CLEAR lv_message.
      MESSAGE ID sy-msgid
            TYPE sy-msgty
          NUMBER sy-msgno
            WITH sy-msgv1
                 sy-msgv2
                 sy-msgv3
                 sy-msgv4
            INTO lv_message.
      APPEND VALUE bapiret2(
      type        = sy-msgty
      id          = sy-msgid
      number      = sy-msgno
      message     = lv_message
      message_v1  = sy-msgv1
      message_v2  = sy-msgv2
      message_v3  = sy-msgv3
      message_v4  = sy-msgv4
      ) TO c_ti_bapiret2.
      RETURN.
    ENDIF.

*Por ultimo, se llama a la función para cerra el objeto de cambio:
    CALL FUNCTION 'CHANGEDOCUMENT_CLOSE'
      EXPORTING
        date_of_change          = sy-datum
        objectclass             = i_objectclass       "'MAT_FULL'
        objectid                = lv_objectid
        tcode                   = i_tcode
        time_of_change          = sy-uzeit
        username                = sy-uname
        object_change_indicator = i_change_indicator  "'U'
      IMPORTING
        changenumber            = lv_changenumber
      EXCEPTIONS
        header_insert_failed    = 1
        no_position_inserted    = 2
        object_invalid          = 3
        open_missing            = 4
        position_insert_failed  = 5.
    IF sy-subrc NE 0.
      CLEAR lv_message.
      MESSAGE ID sy-msgid
            TYPE sy-msgty
          NUMBER sy-msgno
            WITH sy-msgv1
                 sy-msgv2
                 sy-msgv3
                 sy-msgv4
            INTO lv_message.
      APPEND VALUE bapiret2(
      type        = sy-msgty
      id          = sy-msgid
      number      = sy-msgno
      message     = lv_message
      message_v1  = sy-msgv1
      message_v2  = sy-msgv2
      message_v3  = sy-msgv3
      message_v4  = sy-msgv4
      ) TO c_ti_bapiret2.
      RETURN.
    ENDIF.

    lv_changenumber = lv_changenumber.

  ENDMETHOD.


  METHOD get_componentes.
    DATA: o_ttdescribe              TYPE REF TO cl_abap_tabledescr,
          o_stdescribe              TYPE REF TO cl_abap_structdescr,
          o_eldescribe              TYPE REF TO cl_abap_elemdescr,
          ti_component_d            TYPE abap_component_tab,
          es_dfies                  TYPE dfies,
          indice_estructura_anidada TYPE i,
          ti_component              TYPE abap_component_tab,
          es_component              LIKE LINE OF ti_component.

    TRY.
        o_ttdescribe ?= cl_abap_structdescr=>describe_by_data( i_objeto ).
        o_stdescribe ?= o_ttdescribe->get_table_line_type( ).
      CATCH cx_sy_move_cast_error.
        o_stdescribe ?= cl_abap_structdescr=>describe_by_data( i_objeto ).
    ENDTRY.

    ti_component = o_stdescribe->get_components( ).
    "busca estructuras anidadas
    LOOP AT ti_component INTO es_component WHERE name = space OR as_include EQ abap_true.
      indice_estructura_anidada = sy-tabix.
      o_stdescribe ?=  es_component-type.
      APPEND LINES OF o_stdescribe->get_components( ) TO ti_component_d.

      "agrega componenes anidados
      INSERT LINES OF o_stdescribe->get_components( ) INTO ti_component INDEX indice_estructura_anidada.

    ENDLOOP.

    DELETE ti_component WHERE name = space.

    LOOP AT ti_component INTO es_component.

      " recupera descripcion del tipo
      TRY.
          o_eldescribe ?= es_component-type.
        CATCH cx_root.
          CONTINUE.
      ENDTRY.

      IF o_eldescribe->is_ddic_type( ) EQ abap_true.
        es_dfies = o_eldescribe->get_ddic_field( ).
      ELSE.
        es_dfies-leng = o_eldescribe->length.
        es_dfies-decimals = o_eldescribe->decimals.
        es_dfies-datatype = es_dfies-inttype = es_dfies-comptype = o_eldescribe->type_kind.
      ENDIF.

      APPEND VALUE #(  nombre  = es_component-name
                       estructura  = space
                       campo  = space
                       o_descripcion_elemento = o_eldescribe )
      TO r_ti_componentes.
    ENDLOOP.

  ENDMETHOD.


  METHOD convertir_a_texto_columna.
    r_texto_columna = to_mixed( replace( val = i_texto sub = i_separador with = ` ` occ = 0 ) ).
  ENDMETHOD.


  METHOD string_a_es.
    DATA: str_line                 TYPE string,
          o_stdescribe             TYPE REF TO cl_abap_structdescr,
          o_tabledescr             TYPE REF TO cl_abap_tabledescr,
          o_elm_des                TYPE REF TO cl_abap_elemdescr,
          ti_columnas_tabla_d      TYPE cl_abap_structdescr=>component_table,
          indice_columna           TYPE i,
          r_tipo_no_dato_permitido TYPE RANGE OF c.

    FIELD-SYMBOLS: <fs_dato>     TYPE any,
                   <fs_ti_datos> TYPE ANY TABLE.

    r_tipo_no_dato_permitido = VALUE #( sign = 'I' option = 'EQ' ( low = 'h' )
                                                                 ( low = 'u' )
                                                                 ( low = 'v' ) ).

    IF i_ti_componente_estructura IS INITIAL.
      TRY.

          o_stdescribe ?= cl_abap_structdescr=>describe_by_data( c_es_destino ).

          DATA(ti_componente_estructura) = o_stdescribe->get_components( ).

          "busca estructuras anidadas
          LOOP AT ti_componente_estructura INTO DATA(es_componente) WHERE name = space OR as_include EQ abap_true.
            o_stdescribe ?=  es_componente-type.
            APPEND LINES OF o_stdescribe->get_components( ) TO ti_columnas_tabla_d.
          ENDLOOP..

          DELETE ti_columnas_tabla_d WHERE name = space.
          "agrega componenes anidados
          APPEND LINES OF ti_columnas_tabla_d TO ti_componente_estructura.

          DELETE ti_componente_estructura WHERE name = space.

        CATCH cx_sy_move_cast_error ##NO_HANDLER.

      ENDTRY.

    ELSE.
      ti_componente_estructura = i_ti_componente_estructura.
    ENDIF.

    SPLIT i_str AT i_separador INTO TABLE DATA(ti_cadena_separada).

    DO.

      indice_columna = sy-index.

      UNASSIGN <fs_dato>.

      ASSIGN COMPONENT indice_columna OF STRUCTURE c_es_destino TO <fs_dato>.

      IF sy-subrc IS NOT INITIAL.
        IF lines( ti_componente_estructura ) = 1 AND c_es_destino IS NOT INITIAL.
          ASSIGN c_es_destino TO <fs_dato>.

          IF <fs_dato> IS NOT ASSIGNED OR indice_columna > lines( ti_componente_estructura ).
            EXIT.
          ENDIF.

        ELSE.
          EXIT.
        ENDIF.
      ENDIF.

      IF i_r_excluir_columnas IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name IN i_r_excluir_columnas.
        CONTINUE.
      ENDIF.
      "columnas que se excluyen
      IF i_caracter_exc_columna IS NOT INITIAL AND
         ti_componente_estructura[ indice_columna ]-name(2) EQ i_caracter_exc_columna.
        CONTINUE.
      ENDIF.

      TRY.
          DESCRIBE FIELD <fs_dato> TYPE DATA(tp_componente).

          CHECK tp_componente NOT IN r_tipo_no_dato_permitido.

          ASSIGN ti_cadena_separada[ indice_columna ] TO FIELD-SYMBOL(<fs_valor_fuente>).

          CHECK sy-subrc IS INITIAL AND <fs_valor_fuente> IS ASSIGNED.

          IF tp_componente = 'P' AND i_remover_separador_decimales = abap_true.
            REPLACE ALL OCCURRENCES OF '.' IN <fs_valor_fuente> WITH space.
          ENDIF.

          <fs_dato> = <fs_valor_fuente>.

        CATCH cx_root.

      ENDTRY.

    ENDDO.

  ENDMETHOD.


  METHOD string_a_ti.

    DATA: r_es_destino TYPE REF TO data.

    IF i_fila_final = 0.
      i_fila_final = lines( i_ti_str ).
    ENDIF.

    LOOP AT i_ti_str INTO DATA(cadena_de_texto)
                     FROM i_fila_de_inicio TO i_fila_final.

      CREATE DATA r_es_destino LIKE LINE OF c_ti_destino.

      ASSIGN r_es_destino->* TO FIELD-SYMBOL(<fs_es_destino>).

      string_a_es(
        EXPORTING
          i_str                         = cadena_de_texto
          i_r_excluir_columnas          = i_r_excluir_columnas
          i_caracter_exc_columna        = i_caracter_exc_columna
          i_separador                   = i_separador
          i_incluir_encabezado          = i_incluir_encabezado
          i_longitud_texto_columna      = i_longitud_texto_columna
          i_ti_componente_estructura    = i_ti_componente_estructura
          i_remover_separador_decimales = i_remover_separador_decimales
        CHANGING
          c_es_destino                  = <fs_es_destino> ).

      INSERT <fs_es_destino> INTO TABLE c_ti_destino.

      FREE: r_es_destino.

    ENDLOOP.

  ENDMETHOD.
ENDCLASS.