public section.

  types:
     TS_ORDEN type ZEPPI1049_1 .
  types:
TT_ORDEN type standard table of TS_ORDEN .
  types:
   begin of ts_text_element,
      artifact_name  type c length 40,       " technical name
      artifact_type  type c length 4,
      parent_artifact_name type c length 40, " technical name
      parent_artifact_type type c length 4,
      text_symbol    type textpoolky,
   end of ts_text_element .
  types:
         tt_text_elements type standard table of ts_text_element with key text_symbol .
  types:
  begin of TS_ORDENNOTIFICAR,
     AUFNR type C length 12,
  end of TS_ORDENNOTIFICAR .
  types:
TT_ORDENNOTIFICAR type standard table of TS_ORDENNOTIFICAR .

  constants GC_ORDEN type /IWBEP/IF_MGW_MED_ODATA_TYPES=>TY_E_MED_ENTITY_NAME value 'Orden' ##NO_TEXT.
  constants GC_ORDENNOTIFICAR type /IWBEP/IF_MGW_MED_ODATA_TYPES=>TY_E_MED_ENTITY_NAME value 'OrdenNotificar' ##NO_TEXT.

  methods LOAD_TEXT_ELEMENTS
  final
    returning
      value(RT_TEXT_ELEMENTS) type TT_TEXT_ELEMENTS
    raising
      /IWBEP/CX_MGW_MED_EXCEPTION .

  methods DEFINE
    redefinition .
  methods GET_LAST_MODIFIED
    redefinition .
protected section.
private section.

  constants GC_INCL_NAME type STRING value 'ZCLPPI1049_NOTIFICA_OP_MPC====CP' ##NO_TEXT.

