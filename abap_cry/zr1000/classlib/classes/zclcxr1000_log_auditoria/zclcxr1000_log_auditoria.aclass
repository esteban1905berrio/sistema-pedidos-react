CLASS zclcxr1000_log_auditoria DEFINITION ABSTRACT
  PUBLIC
  CREATE PUBLIC .
  PUBLIC SECTION.

    CLASS-DATA:
      gc_i TYPE char1 VALUE 'I', ".Insert
      gc_n TYPE char1 VALUE 'N', ".Nuevo
      gc_d TYPE char1 VALUE 'D'. ".Delete

    METHODS:
      "! Manejo de Log CDHDR-CDPOS
