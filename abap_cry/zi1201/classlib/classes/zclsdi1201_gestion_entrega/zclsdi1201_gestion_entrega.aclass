  METHOD modificar_segmento_z1edl20.

    DATA: es_e1adrm1       TYPE e1adrm1,
          multiplicador    TYPE i,
          suma_total       TYPE i,
          modulo           TYPE i,
          posicion_inicial TYPE i,
          dig_verificador  TYPE i.

    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa( i_ricefw = 'I1201' ) = abap_true.

    CHECK i_control_record_out-cimtyp = 'ZDELVRY03_1'
      AND line_exists( c_ti_datos_idoc[ segnam = 'E1ADRM1' ] )
      AND NOT line_exists( c_ti_datos_idoc[ segnam = 'Z1EDL20' ] ).

    LOOP AT c_ti_datos_idoc ASSIGNING FIELD-SYMBOL(<fs_es_idoc>) WHERE segnam = 'E1ADRM1'.
      es_e1adrm1 = <fs_es_idoc>-sdata.
      IF es_e1adrm1-partner_q CS 'WE'.
        EXIT.
      ELSE.
        CLEAR: es_e1adrm1.
      ENDIF.
    ENDLOOP.

    IF es_e1adrm1 IS NOT INITIAL.

*      DATA(bol) = CONV char16( |{ sy-datum+2 }{ condense( val = |{ es_e1adrm1-partner_id ALPHA = OUT }| ) }| ).
*      bol = |{ bol ALPHA = IN }|.
      es_e1adrm1-partner_id = |{ es_e1adrm1-partner_id ALPHA = IN }|.
      DATA(bol) = CONV char16( |0804303{ sy-datum+2 }{ es_e1adrm1-partner_id+14 }| ).

      DO 16 TIMES.
        modulo = sy-index MOD 2.
        IF modulo = 0.
          multiplicador = 3.
        ELSE.
          multiplicador = 1.
        ENDIF.
        posicion_inicial = sy-index - 1.
        suma_total = suma_total + ( bol+posicion_inicial(1) * multiplicador ).
      ENDDO.

      modulo = suma_total MOD 10.

      dig_verificador = 10 - modulo.

      DATA(es_datos_idoc) = VALUE edidd( segnam = 'Z1EDL20' sdata = VALUE z1edl20( bol = |{ bol }{ COND #( WHEN dig_verificador = 10 THEN 0 ELSE dig_verificador ) }| ) ).
      INSERT es_datos_idoc INTO c_ti_datos_idoc INDEX 2.
    ENDIF.

  ENDMETHOD.

ENDCLASS.