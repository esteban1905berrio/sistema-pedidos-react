        language         = sy-langu
      IMPORTING
        charactdetail    = es_charactdetail
      TABLES
        charactdescr     = ti_charactdescr
        charactvaluesnum = ti_charactvaluesnum
        return           = ti_return.

    SORT c_ti_instlavado BY codlavado posicion.
    DELETE ADJACENT DUPLICATES FROM c_ti_instlavado COMPARING codlavado.

    LOOP AT c_ti_instlavado ASSIGNING <lfs_es_instlavado>.

      READ TABLE ti_charactvaluesnum INTO es_charactvaluesnum
                                       WITH KEY value_from = <lfs_es_instlavado>-codlavado.

      IF sy-subrc IS NOT INITIAL.
        CLEAR: es_charactvaluesnum.
        es_charactvaluesnum-value_relation = '1'.
        es_charactvaluesnum-value_from = <lfs_es_instlavado>-codlavado.
        APPEND es_charactvaluesnum TO ti_charactvaluesnum.
      ELSE.
        DELETE TABLE ti_charactvaluesnum FROM es_charactvaluesnum.
      ENDIF.
    ENDLOOP.

    "actualizar caracteristicas
    CLEAR: ti_return.

    APPEND es_charactdetail TO ti_char_det.

    CALL FUNCTION 'BAPI_CHARACT_CHANGE'
      EXPORTING
        charactname         = lc_nombre_caracteristica
      TABLES
        charactdescrnew     = ti_charactdescr
        charactdetailnew    = ti_char_det
        charactvaluesnumnew = ti_charactvaluesnum
        return              = ti_return.

    READ TABLE ti_return
      TRANSPORTING NO FIELDS
      WITH KEY type = 'E'.

    IF sy-subrc NE 0.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = 'X'.
    ENDIF.

    LOOP AT ti_return INTO es_return.

      MOVE:
      es_return-type       TO es_balmsg-msgty,
      es_return-id         TO es_balmsg-msgid,
      es_return-number     TO es_balmsg-msgno,
      es_return-message_v1 TO es_balmsg-msgv1,
      es_return-message_v2 TO es_balmsg-msgv2,
      es_return-message_v3 TO es_balmsg-msgv3,
      es_return-message_v4 TO es_balmsg-msgv4.

      go_log->set_es_log( i_es = CORRESPONDING #( es_return ) ).

    ENDLOOP.

  ENDMETHOD.


  METHOD actualizar_instlavado.

    DATA: ti_instlavado TYPE gtp_ti_instlavado,
          es_instlavado LIKE LINE OF ti_instlavado,
          idioma        TYPE ztmmi1062_1-spras,
          es_input      LIKE LINE OF i_ti_px_instlavado.

    FIELD-SYMBOLS: <fs_es_instlavado> LIKE LINE OF ti_instlavado.

    "instanciar Log
    go_log = zclcxr1002_log_aplicacion=>get_instancia( i_es_cabecera_log = VALUE #( object = gc_nombre_objeto_log
                                                                                    subobject = gc_nombre_subobjeto_log
                                                                                    aldate_del = sy-datum + 5 ) ).

    IF i_ti_px_instlavado IS INITIAL.

      go_log->set_es_log( i_es = VALUE #( id = gc_clase_mensaje number = '096' type = 'W'  ) ).

    ELSE.

      LOOP AT i_ti_px_instlavado INTO es_input.

        CLEAR: es_instlavado.

        es_instlavado-codlavado     = es_input-co_lavado.
        es_instlavado-posicion      = es_input-posicion.
        es_instlavado-denlavado     = es_input-de_lavado.
        es_instlavado-lavadopccion  = es_input-de_lavado_produccion. "Adicion 09Sep2024 Sebastian Restrepo Villa

        CONCATENATE es_input-fe_creacion(4) es_input-fe_creacion+5(2) es_input-fe_creacion+8(2)
        INTO es_instlavado-fechacrea.

        CONCATENATE es_input-fe_creacion+11(2) es_input-fe_creacion+14(2) es_input-fe_creacion+17(2)
        INTO es_instlavado-horacrea.

