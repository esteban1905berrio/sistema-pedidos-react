class ZCLCXI1148_REP_AUDITORIA definition
  public
  final
  create public .

public section.

  class-methods SET_AUDIT_LIST
    importing
      !I_TI_AUDIT_LIST type RSAU_T_RESULT .
  class-methods ENH_SET_AUDIT_LIST
    importing
      !I_TI_AUDIT_LIST type RSAU_T_RESULT
    changing
      !C_V_LIST_MODE type SY-REPID .
  methods REPORTE_AUDITORIA
    importing
      !I_ES_PARAMETROS type ZEXCI1148_PARAMETROS
    exporting
      !E_TI_REPORTE type RSAU_T_RESULT .
  class-methods GET_ENH_INDICATOR
    returning
      value(R_V_ACTIVAR) type ABAP_BOOL .
protected section.
private section.

  data TI_BDCDATA type TAB_BDCDATA .
  data ES_PARAMETROS type ZEXCI1148_PARAMETROS .
  data TI_AUDIT_LIST type RSAU_T_RESULT .
  data TI_MESSTAB type TAB_BDCMSGCOLL .

  methods SET_ENH_INDICATOR
    importing
      !I_V_ACTIVAR type ABAP_BOOL .
  methods BATCH_INPUT_RSAU_READ_LOG .
  methods BDC_DYNPRO
    importing
      !I_V_PROGRAM type BDC_PROG
      !I_V_DYNPRO type BDC_DYNR .
  methods BDC_FIELD
    importing
      !I_V_FNAM type FNAM_____4
      !I_V_FVAL type BDC_FVAL .
  methods INICIALIZAR_PARAMETROS .
  methods CONVERSIONES .
  methods FINDER .
  methods GET_AUDIT_LIST
    exporting
      !E_TI_AUDIT_LIST type RSAU_T_RESULT .
ENDCLASS.



CLASS ZCLCXI1148_REP_AUDITORIA IMPLEMENTATION.


  METHOD batch_input_rsau_read_log.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Otener listado usando BI a la transacción RSAU_READ_LOG.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

*--------------------------------------------------------------------*
    DATA:
      ".Definición de variables.
      v_mode   TYPE char1 VALUE 'N',
      v_update TYPE char1 VALUE 'S'.
*--------------------------------------------------------------------*

*---*
    bdc_dynpro( EXPORTING i_v_program = 'RSAU_READ_LOG'
                          i_v_dynpro  = '1000' ).

    bdc_field(  EXPORTING i_v_fnam    = 'BDC_CURSOR'
                          i_v_fval    = 'RB_FILE' ).
    bdc_field(  EXPORTING i_v_fnam    = 'BDC_OKCODE'
                          i_v_fval    = '=GD_CMD' ).

    bdc_field(  EXPORTING i_v_fnam    = 'STRTDATE'
                          i_v_fval    = CONV #( es_parametros-fecha_inicial ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'ENDDATE'
                          i_v_fval    = CONV #( es_parametros-fecha_final ) ).

    bdc_field(  EXPORTING i_v_fnam    = 'STRTTIME'
                          i_v_fval    = CONV #( es_parametros-hora_inicial ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'ENDTIME'
                          i_v_fval    = CONV #( es_parametros-hora_final ) ).

    bdc_field(  EXPORTING i_v_fnam    = 'P_SELE'
                          i_v_fval    = '2' ).

    IF es_parametros-usuario IS NOT INITIAL.
      bdc_field(  EXPORTING i_v_fnam    = 'USER-LOW'
                            i_v_fval    = CONV #( es_parametros-usuario ) ).
    ENDIF.

    IF es_parametros-tcode IS NOT INITIAL.
      bdc_field(  EXPORTING i_v_fnam    = 'TCODE-LOW'
                            i_v_fval    = CONV #( es_parametros-tcode ) ).
    ENDIF.

    IF es_parametros-report IS NOT INITIAL.
      bdc_field(  EXPORTING i_v_fnam    = 'REPORT-LOW'
                            i_v_fval    = CONV #( es_parametros-report ) ).
    ENDIF.

    bdc_field(  EXPORTING i_v_fnam    = 'LOGON'
                          i_v_fval    = CONV #( es_parametros-logon ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'RLOGON'
                          i_v_fval    = CONV #( es_parametros-rlogon ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'RFCSTART'
                          i_v_fval    = CONV #( es_parametros-rfcstart ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'TASTART'
                          i_v_fval    = CONV #( es_parametros-tastart ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'REPSTART'
                          i_v_fval    = CONV #( es_parametros-repstart ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'USERMGM'
                          i_v_fval    = CONV #( es_parametros-usermgm ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'MISC'
                          i_v_fval    = CONV #( es_parametros-misc ) ).
    bdc_field(  EXPORTING i_v_fnam    = 'SYSTEM'
                          i_v_fval    = CONV #( es_parametros-sistema ) ).

    bdc_field(  EXPORTING i_v_fnam    = 'LOW'
                          i_v_fval    = 'X' ).

    bdc_field(  EXPORTING i_v_fnam    = 'RB_FILE'
                          i_v_fval    = '' ).
    bdc_field(  EXPORTING i_v_fnam    = 'RB_TBUF'
                          i_v_fval    = 'X' ).

    bdc_field(  EXPORTING i_v_fnam    = 'S_ALVGRD'
                          i_v_fval    = 'X' ).
    bdc_field(  EXPORTING i_v_fnam    = 'PONLYEOL'
                          i_v_fval    = 'X' ).

    bdc_field(  EXPORTING i_v_fnam    = 'BDC_CURSOR'
                          i_v_fval    = 'RB_FILE' ).
    bdc_field(  EXPORTING i_v_fnam    = 'BDC_OKCODE'
                          i_v_fval    = '=ONLI' ).

    bdc_dynpro( EXPORTING i_v_program = 'SAPMSSY0'
                          i_v_dynpro  = '0120' ).
    bdc_field(  EXPORTING i_v_fnam    = 'BDC_OKCODE'
                          i_v_fval    = '=&F03' ).

    bdc_dynpro( EXPORTING i_v_program = 'RSAU_READ_LOG'
                          i_v_dynpro  = '1000' ).
    bdc_field(  EXPORTING i_v_fnam    = 'BDC_OKCODE'
                          i_v_fval    = '/EE' ).
*---*
    ".Asignar indicador: Ampliación Activa.
    set_enh_indicator( i_v_activar = abap_true ).
*---*
    ".Llamar transacción estandar de Auditía.
    CALL TRANSACTION 'RSAU_READ_LOG'
      USING         ti_bdcdata
      MODE          v_mode        ".A = Ver Pant. / N = No ver pantallas.
      UPDATE        v_update      ".A = Asincrono / S = Sincrono
      MESSAGES INTO ti_messtab.
*---*
    ".Asignar indicador: Ampliación Inactiva.
    set_enh_indicator( i_v_activar = abap_false ).

  ENDMETHOD.


  METHOD bdc_dynpro.
*--------------------------------------------------------------------*
    DATA:
      ".Definición de estruturas.
      es_bdcdata TYPE bdcdata.
*--------------------------------------------------------------------*

    es_bdcdata-program   = i_v_program.
    es_bdcdata-dynpro    = i_v_dynpro.
    es_bdcdata-dynbegin  = 'X'.
    APPEND es_bdcdata TO ti_bdcdata.

  ENDMETHOD.


  METHOD bdc_field.
*--------------------------------------------------------------------*
    DATA:
      ".Definición de estruturas.
      es_bdcdata TYPE bdcdata.
*--------------------------------------------------------------------*

    "__Validar valor.
    IF i_v_fval IS NOT INITIAL.
      es_bdcdata-fnam = i_v_fnam.
      es_bdcdata-fval = i_v_fval.
      APPEND es_bdcdata TO ti_bdcdata.
    ENDIF.

  ENDMETHOD.


  METHOD conversiones.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Conversiones de datos.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

*--------------------------------------------------------------------*
    DATA:
      ".Definición de variables.
      v_fecha_ini TYPE sy-datum,
      v_fecha_fin TYPE sy-datum.
*--------------------------------------------------------------------*

    ".Convertir fecha incial.
    v_fecha_ini+4(4)  = es_parametros-fecha_inicial(4).
    v_fecha_ini+2(2)  = es_parametros-fecha_inicial+4(2).
    v_fecha_ini(2)    = es_parametros-fecha_inicial+6(2).
    es_parametros-fecha_inicial = v_fecha_ini.

    ".Convertir fecha final.
    v_fecha_fin+4(4)  = es_parametros-fecha_final(4).
    v_fecha_fin+2(2)  = es_parametros-fecha_final+4(2).
    v_fecha_fin(2)    = es_parametros-fecha_final+6(2).
    es_parametros-fecha_final = v_fecha_fin.

  ENDMETHOD.


  METHOD enh_set_audit_list.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Asignar reporte de auditoría desde ampliación implicita:
*                 Al FINAL del método MERGE_BUFFER_TO_OUTPUT_LIST de
*                 la clase CL_SAL_SM20.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

*--------------------------------------------------------------------*
    CONSTANTS:
      ".Nombre del ricefw
      c_ricefw TYPE ztcxr1000_3-ricefw   VALUE 'I1148',
      ".Nombre del método
      c_metodo TYPE ztcxr1000_3-metclase VALUE 'ENH_SET_AUDIT_LIST'.
*--------------------------------------------------------------------*

    "__Validar si la ampliación está activa.
    CHECK zclcxr1000_gestion_ampliacion=>ampliacion_activa(
            i_ricefw = c_ricefw
            i_metodo = c_metodo ) = abap_true.

    "__Validar tabla de log de auditoría.
    IF i_ti_audit_list IS NOT INITIAL.

      "__Validar indicador: Proceso ejecutado por esta clase.
      IF zclcxi1148_rep_auditoria=>get_enh_indicator( ) EQ abap_true.

        ".Asignar tabla a atributo estático de la clase.
        zclcxi1148_rep_auditoria=>set_audit_list(
          EXPORTING i_ti_audit_list = i_ti_audit_list ).

        ".Borrar variable para que no se ejecute el proceso de
        " visualización de ALV.
        CLEAR c_v_list_mode.
      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD finder.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Consulta de información.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

    ".Otener listado usando BI a la transacción RSAU_READ_LOG.
    batch_input_rsau_read_log( ).

    ".Obtener la información del reporte.
    get_audit_list( ).

  ENDMETHOD.


  METHOD get_audit_list.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Método para Obtener reporte de auditoría desde memoria.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

    ".Obtener tabla del atributo estático de la clase.
    IMPORT i_ti_audit_list = ti_audit_list FROM MEMORY ID 'ZAUDI'.

  ENDMETHOD.


  METHOD get_enh_indicator.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  :Obtener indicador: Proceso ejecutado por esta clase.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

    ".Obtener indicador de ampliación Activa.
    IMPORT i_v_enh_activ = r_v_activar FROM MEMORY ID 'ZI1148_ACT'.

  ENDMETHOD.


  METHOD inicializar_parametros.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Inicializar parametros.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

*---*
    "__Validar Fecha Incial.
    IF es_parametros-fecha_inicial IS INITIAL.
      ".Asignar el fecha de ejecución.
      es_parametros-fecha_inicial = sy-datum.
    ENDIF.

    "__Validar Fecha Final.
    IF es_parametros-fecha_final IS INITIAL.
      ".Asignar el fecha de ejecución.
      es_parametros-fecha_final = sy-datum.
    ENDIF.

*---*
    "__Validar Hora Final.
    IF es_parametros-hora_final IS INITIAL.
      ".Asignar el final del día.
      es_parametros-hora_final = '235959'.
    ENDIF.

*---*
    "__Validar Categorías de auditoría.
    IF es_parametros-logon    IS INITIAL AND
       es_parametros-rlogon   IS INITIAL AND
       es_parametros-rfcstart IS INITIAL AND
       es_parametros-tastart  IS INITIAL AND
       es_parametros-repstart IS INITIAL AND
       es_parametros-usermgm  IS INITIAL AND
       es_parametros-misc     IS INITIAL AND
       es_parametros-sistema  IS INITIAL .
      ".Asignar Categoria: Otros Eventos.
      es_parametros-misc = abap_true.
    ENDIF.

  ENDMETHOD.


  METHOD reporte_auditoria.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Método para obtener el reporte de auditoría SAP.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

    ".Asignar parametros.
    es_parametros = i_es_parametros.

*---*
    ".Inicialización de parametros.
    inicializar_parametros( ).
    ".Conversiones de datos.
    conversiones( ).
    ".Consulta de información.
    finder( ).

*---*
    ".Asignar reporte.
    e_ti_reporte = ti_audit_list.

  ENDMETHOD.


  METHOD set_audit_list.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Asignar tabla con el reporte de auditoría SAP, en memoria.
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

    ".Asignar tabla a atributo estático de la clase.
    EXPORT i_ti_audit_list = i_ti_audit_list TO MEMORY ID 'ZAUDI'.

  ENDMETHOD.


  METHOD set_enh_indicator.
*&---------------------------------------------------------------------*
*& Información General
*&---------------------------------------------------------------------*
* Identificador: I1148
* Programa     : CX-I1148
* Tipo Objeto  : Método / Clase
* Descripción  : Asignar/Desasignar indicador de ampliación
*                activa (El reporte fue lanzado por esta calse).
* Autor Prog.  : Juan Guillermo Valencia Delgado
* Fecha Creac. : 23.05.2022
*----------------------------------------------------------------------*
* Ordenes de Transporte
*----------------------------------------------------------------------*
* Fecha      | CR#        | Autor          | Modificación
*----------------------------------------------------------------------*
* 23.05.2022   S4DK909213   JGVALEND         Version Inicial: CX-I1148
*----------------------------------------------------------------------*

    ".Asignar/Desasignar indicador de ampliación Activa.
    EXPORT i_v_enh_activ = i_v_activar TO MEMORY ID 'ZI1148_ACT'.

  ENDMETHOD.
ENDCLASS.
